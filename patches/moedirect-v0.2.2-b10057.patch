+        j["read_pending_count"] = g_mod.read_pending_count.load(std::memory_order_relaxed);
+        j["acquire_call_count"] = ggml_moe_trace_acquire_call_count();
+        j["chunk_call_count"] = ggml_moe_trace_chunk_call_count();
