+    r.off_reason = ggml_moe_phaseb_prefetch_off_reason();
+    r.adapter    = ggml_moe_phaseb_adapter_id();
+    r.width      = ggml_moe_phaseb_capture_width();
+    r.pf_on      = ggml_moe_phaseb_prefetch_on();
+    uint64_t cq = 0, pend = 0, chan = 0, dstk = 0;
+    ggml_moe_direct_test_mem_echo(&cq, &pend, &chan, &dstk, &r.cap, &r.iq, &r.pw, &r.snap);
+    uint64_t a = 0, b = 0, c = 0, d = 0;
+    ggml_moe_phaseb_test_counts(&a, &b, &c, &d, &r.depth, &r.worker);
+    return r;
+}
