+    PbEnv env("4", "8", "2", "trace", wide_to_utf8(dir + L"\\pb").c_str(),
+              wide_to_utf8(dir + L"\\metrics.jsonl").c_str());
+    {
+        Fixture fx; fx.dir = dir;
+        fx.model.arch = "synth"; fx.model.n_expert = PB_TEST_N_EXPERT; fx.model.n_expert_used = 2;
+        fx.model.n_layer = 2; fx.model.n_embd = PB_TEST_N_EMBD; fx.model.f_norm_rms_eps = 1e-6f;
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_separate_layer(0, PB_TEST_N_EXPERT, "MXFP4", false),
+                            make_separate_layer(1, PB_TEST_N_EXPERT, "MXFP4", false) };
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+                   "P15a. seal 성공(PA timing + PB trace 병행)")) return;
+        check(ggml_moe_phaseb_boot_id() == ggml_moe_phasea_boot_id() && ggml_moe_phaseb_boot_id() != 0,
+              "P15b. ★★PB boot_id == PA boot_id(조인 키는 boot_id 축뿐 — t0_qpc 는 v4 확정 PB-local)");
