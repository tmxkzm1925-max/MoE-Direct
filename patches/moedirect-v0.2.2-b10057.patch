+// ── P14. ★pending entry 재사용 오염(R1 #1) ──
+static void test_pb_pending_reuse() {
+    section("P14. ★pending 풀 인덱스 재사용 — joined prefetch → 일반 prefetch → demand 순환 시 필드 누수 0(R1 #1)");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_reuse");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P14a. seal 성공")) return;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+    ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+    ggml_moe_direct_release(g1, pre.data(), 7);
+
+    // ① joined prefetch(ever_joined 래치 + join epoch 보존)
+    ggml_moe_direct_test_hold_retire(1);
+    std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+    ggml_moe_phaseb_test_push_intent(0, 0, 0, 0, 1, ids.data(), 8);
+    uint64_t issued = 0;
+    for (int i = 0; i < 800 && issued == 0; i++) { Sleep(1); issued = ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED); }
+    const uint64_t uj0 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN);
+    std::atomic<int> arc{-99};
+    int32_t e0 = 0;
+    std::thread th([&]() { arc.store(ggml_moe_direct_acquire(g1, &e0, 1, 1)); });
+    uint64_t uj1 = uj0;
+    for (int i = 0; i < 800 && uj1 == uj0; i++) { Sleep(1); uj1 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN); }
+    ggml_moe_direct_test_hold_retire(0);
+    th.join();
+    ggml_moe_direct_release(g1, &e0, 1);
+    ggml_moe_direct_test_pb_quiesce(3000);
+
+    // ② 같은 pending 인덱스가 재사용되도록 순수 demand 를 여러 건 돌린다.
+    for (int32_t e = 8; e < PB_TEST_N_EXPERT; e++) {
+        ggml_moe_direct_acquire(g0, &e, 1, 1);
+        ggml_moe_direct_release(g0, &e, 1);
+    }
+    ggml_moe_direct_test_pb_quiesce(3000);
+
+    // ③ 재사용 뒤의 demand op 들이 앞 joined prefetch 의 래치/상관자를 물려받지 않았는가.
+    const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+    uint64_t bad = 0, demand_n = 0, joined_n = 0;
+    for (const auto & r : ios) {
+        if (r.origin == 0) {
+            demand_n++;
+            // demand-origin: intent_ordinal/rank NA · ever_joined/ever_promoted/is_retry 누수 금지
+            if (r.intent_ordinal != GGML_MOE_PHASEB_NA_U64) bad++;
+            if (r.rank != GGML_MOE_PHASEB_NA_U16) bad++;
+            if (!(r.flags & 0x04) && (r.flags & 0x08)) bad++;   // retry 아닌 demand가 ever_joined
+            if (r.flags & 0x10) bad++;                          // demand가 ever_promoted
+            if (r.request_index == GGML_MOE_PHASEB_NA_U32 && r.graph_seq != GGML_MOE_PHASEB_NA_U32) bad++;
+        } else if (r.flags & 0x08) joined_n++;
+    }
+    check(arc.load() == 0 && joined_n == 1 && demand_n >= 8 && bad == 0,
+          "P14b. ★★pending 재사용 오염 0 — demand op " + std::to_string(demand_n) +
+          "건 전건이 intent_ordinal/rank NA · ever_joined/ever_promoted/is_retry 누수 없음"
+          "(joined prefetch " + std::to_string(joined_n) + "건 · 위반 " + std::to_string(bad) + ")");
+    // used/wasted 독립 재계산이 여전히 성립(누수가 있으면 여기서 깨진다).
+    uint64_t rj = 0, rp = 0, rw = 0;
+    for (const auto & r : ios) {
+        if (r.origin != 1) continue;
+        if (r.flags & 0x08) rj++; else if (r.flags & 0x10) rp++; else rw++;
+    }
+    const PbCtr c = pb_ctr();
+    check(rj == c.get(GGML_MOE_PB_C_USED_JOIN) && rp == c.get(GGML_MOE_PB_C_USED_PROMOTED) &&
+          rw == c.get(GGML_MOE_PB_C_ISSUED) - c.get(GGML_MOE_PB_C_USED_JOIN) - c.get(GGML_MOE_PB_C_USED_PROMOTED),
+          "P14c. ★재사용 이후에도 used/wasted 독립 재계산 일치(§9 게이트 7-b)");
+}
