+
+    FILETIME ft_create, ft_access, ft_write;
+    if (!GetFileTime(h, &ft_create, &ft_access, &ft_write)) return false;
+
+    ULARGE_INTEGER uli;
+    uli.LowPart  = ft_write.dwLowDateTime;
+    uli.HighPart = ft_write.dwHighDateTime;
+
+    // FILETIME = 1601-01-01 기준 100ns 틱. Unix epoch(1970-01-01)까지의 오프셋을 빼고
+    // 10,000,000으로 정수 나눗셈 — 대상 시각은 항상 1970년 이후이므로 C++ 정수 나눗셈의
