+// ── P13. ★worker가 바쁜 상태에서 graceful CUT — 후발 intent 미처분 잔존 0(R1 #3 ②) ──
+static void test_pb_cut_race() {
+    section("P13. ★CUT 경합 — worker 잔여 capture 보유 중 graceful 종료 · 잔여 0 검사(R1 #3 ②④)");
+    PbEnv env("4", "8", "2", "trace", nullptr, wide_to_utf8(make_case_dir("pb_cutrace_m") + L"\\m.jsonl").c_str());
+    Fixture fx; pb_setup_2layer(fx, "pb_cutrace");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P13a. seal 성공")) return;
+    std::vector<float> w0, w1, rt1, x((size_t)PB_TEST_N_EMBD);
+    pb_fill_snapshot(PB_TEST_N_EMBD, PB_TEST_N_EXPERT, 99, w0, w1, rt1);
+    std::mt19937 rng(11); std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (auto & v : x) v = ud(rng);
+
+    ggml_moe_phaseb_run_begin();
+    // 여러 graph 에 걸쳐 capture 를 몰아넣어 worker가 바쁜 채로 CUT 에 진입하게 한다.
+    //   ★graph 수는 유계(12) — (graph, layer) 키 기반 구조가 실 워크로드 규모를 넘지 않게 한다.
+    for (int gph = 0; gph < 12; gph++) {
+        ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+        ggml_moe_phaseb_capture(0, -1, x.data(), (int32_t)GGML_TYPE_F32, PB_TEST_N_EMBD, 1, 1, 1);
+        ggml_moe_phaseb_graph_end();
+    }
+    ggml_moe_phaseb_run_end();
+    ggml_moe_direct_finalize();   // ★CUT ①~⑧
+    const int32_t residual = ggml_moe_direct_test_cut_residual();
+    check(residual == 0,
+          "P13b. ★★CUT drain 후 전수 0 — intent depth·rank cursor·command·pending·channel 잔여 없음"
+          "(residual bitmask=" + std::to_string(residual) + " · predictor drain 전 exit면 !=0)");
+    check(ggml_moe_phaseb_complete(),
+          "P13c. ★잔여 0 이므로 complete latch 유지(잔여 있으면 complete=0 · §9 게이트 2)");
+    // 미처분 rank 0 = candidate/pre-* 합이 intent 수 × k 와 일치.
+    const PbCtr c = pb_ctr();
+    const uint64_t disposed = pb_disposed_total(c);
