+        Fixture fx; fx.dir = make_case_dir("lease_pin");
+        fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 2;
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_separate_layer(0, 8, "MXFP4", false), make_separate_layer(1, 8, "MXFP4", false) };
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64); // 8슬롯=n_expert
+        if (check(rc == 0, "I1. seal 성공(8슬롯)")) {
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+            int32_t l0e0 = 0; ggml_moe_direct_acquire(g0, &l0e0, 1, 1); // L0e0 leased(핀·미release)
+            for (int32_t e = 0; e < 7; e++) { ggml_moe_direct_acquire(g1, &e, 1, 1); ggml_moe_direct_release(g1, &e, 1); } // L1 e0..6 unleased 적재
+            int32_t l1e7 = 7; int arc = ggml_moe_direct_acquire(g1, &l1e7, 1, 1); // MISS → unleased LRU 축출(L0e0 비축출)
+            bool pinned = (arc == 0) && verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 0); // L0e0 여전히 상주
+            int32_t leased = 0; int64_t total = 0; ggml_moe_direct_test_lease_stats(&leased, &total);
+            check(pinned && leased == 2, "I2. ★leased 슬롯(L0e0) 비축출 — L1e7 acquire가 unleased만 축출(leased=2)");
+            ggml_moe_direct_release(g1, &l1e7, 1);
+            ggml_moe_direct_release(g0, &l0e0, 1);
+        }
+    }
+    // ② 전 슬롯 leased 시 신규 acquire 실패
+    {
+        Fixture fx; fx.dir = make_case_dir("lease_exhaust");
+        fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 2;
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_separate_layer(0, 8, "MXFP4", false), make_separate_layer(1, 8, "MXFP4", false) };
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        if (check(rc == 0, "I3. seal 성공(8슬롯)")) {
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+            std::vector<int32_t> all8 = {0,1,2,3,4,5,6,7};
+            int arc = ggml_moe_direct_acquire(g0, all8.data(), 8, 1); // 8슬롯 전부 leased
+            int32_t l1e0 = 0; int arc2 = ggml_moe_direct_acquire(g1, &l1e0, 1, 1); // 축출 가능 슬롯 없음 → 실패
