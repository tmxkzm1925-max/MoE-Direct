+static void test_pb_cut_latch_race() {
+    section("P20. ★CUT straddler 봉인(R4) — 결정적 2-arm(CUT 선승 = mutation 0 / capture 선승 = 전건 포함)");
+
+    // ── arm A : CUT 가 등록보다 선승 ──────────────────────────────────────
+    {
+        PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+        Fixture * fx = new Fixture();
+        pb_setup_2layer(*fx, "pb_straddle_a");
+        if (!check(fx->seal((uint64_t)PB_TEST_N_EXPERT * fx->comp.slot_stride_max, 64) == 0,
+                   "P20a. arm A seal 성공")) { delete fx; return; }
+        std::vector<float> w0, w1, rt1, x((size_t)PB_TEST_N_EMBD);
+        pb_fill_snapshot(PB_TEST_N_EMBD, PB_TEST_N_EXPERT, 20260726, w0, w1, rt1);
+        std::mt19937 rng(1); std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+        for (auto & v : x) v = ud(rng);
+        ggml_moe_phaseb_run_begin();
+        ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+
+        // capture 를 cap_mu **획득 전**에 세운다 → CUT 가 먼저 래치를 닫는다.
+        check(ggml_moe_phaseb_test_cap_barrier_arm(1) == 0, "P20b. arm A barrier(mode 1) 무장");
+        std::atomic<int> rc{-99};
+        std::thread cap_th([&]() {
+            rc.store(ggml_moe_phaseb_capture(0, -1, x.data(), (int32_t)GGML_TYPE_F32,
+                                             PB_TEST_N_EMBD, 1, 1, 1));
+        });
+        const bool hit = (ggml_moe_phaseb_test_cap_barrier_wait(5000) == 0);
+        check(hit, "P20c. arm A — capture 가 cap_mu 진입 전에 정지(창 도달)");
+        ggml_moe_direct_finalize();                 // ★CUT 선승(cap_mu 비어 있으므로 즉시 통과)
+        const PbObs before = pb_obs();              // flush 직후 관측 스냅샷
+        ggml_moe_phaseb_test_cap_barrier_release(); // capture 재개 → 래치를 보고 무동작이어야 한다
+        cap_th.join();
+        const PbObs after = pb_obs();
+        // ★★R8 — sticky 안전 타임아웃을 **join 뒤·reset 전에 최종 재조회**해 PASS 조건에 결속한다.
+        //   release 전 1회 표본만 쓰면, 출력/flush 지연으로 barrier 가 timeout 진행한 런에서도
+        //   저장된 옛 true 로 통과하는 거짓 PASS 가 성립한다(REACHABLE).
+        const bool safe_a = (ggml_moe_phaseb_test_cap_barrier_safety_fired() == 0);
+        check(rc.load() == 0 && (before == after) && safe_a,
+              "P20d. ★★arm A — CUT 선승 시 그 capture 의 관측 mutation 0(rc=" + std::to_string(rc.load()) +
+              " · C3 카운터·elig_skip·digest 전건 불변) · 안전 타임아웃 미발동(최종 재조회)=" +
+              std::string(safe_a ? "yes" : "NO"));
+        delete fx;
+    }
+
+    // ── arm B : capture 등록이 선승 ───────────────────────────────────────
+    {
+        Fixture * fx = new Fixture();
+        pb_setup_2layer(*fx, "pb_straddle_b");
+        const std::wstring metrics = fx->dir + L"\\metrics.jsonl";
+        PbEnv env("4", "8", "2", "trace", wide_to_utf8(fx->dir + L"\\pb").c_str(),
+                  wide_to_utf8(metrics).c_str());
+        if (!check(fx->seal((uint64_t)PB_TEST_N_EXPERT * fx->comp.slot_stride_max, 64) == 0,
+                   "P20e. arm B seal 성공(metrics+사이드카)")) { delete fx; return; }
+        std::vector<float> w0, w1, rt1, x((size_t)PB_TEST_N_EMBD);
+        pb_fill_snapshot(PB_TEST_N_EMBD, PB_TEST_N_EXPERT, 777, w0, w1, rt1);
+        std::mt19937 rng(2); std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+        for (auto & v : x) v = ud(rng);
+        ggml_moe_phaseb_run_begin();
+        ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+
+        const uint64_t cap0 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_INTENT_CAPTURED);
+        // 등록 **직후**(cap_mu 보유)에 세운다 → CUT 는 cap_mu 에서 대기해야 한다.
+        check(ggml_moe_phaseb_test_cap_barrier_arm(2) == 0, "P20f. arm B barrier(mode 2) 무장");
+        check(ggml_moe_phaseb_test_cut_rendezvous_arm() == 0, "P20f2. arm B CUT rendezvous 무장");
+        std::atomic<int> rc{-99};
