+uint16_t ggml_moe_trace_next_run_index(void) {
+    if (!trace_active_and_ready()) return 0;
+    uint32_t idx = g_run_index_next.fetch_add(1, std::memory_order_relaxed);
+    g_current_run_index.store(idx, std::memory_order_release);
