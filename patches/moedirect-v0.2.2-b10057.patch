+            r.rows_ok = true;
+            for (const auto & s : pb_read_samples()) {   // 행은 모듈 리셋(픽스처 파괴) 전에 회수
+                if (s.layer != 1) continue;
+                r.rows++;
+                if (s.elig_skip_reason != GGML_MOE_PB_SKIP_NONFINITE || (s.flags & 0x01)) r.rows_ok = false;
+            }
+        }
+        auto read_pb = [](const std::wstring & p, std::vector<uint8_t> & pay, uint64_t & recs) {
+            std::ifstream f(p, std::ios::binary | std::ios::ate);
+            if (!f.good()) return false;
+            const size_t n = (size_t)f.tellg();
+            if (n < 128) return false;
+            f.seekg(0);
+            std::vector<uint8_t> all(n);
+            f.read((char *)all.data(), (std::streamsize)n);
+            std::memcpy(&recs, all.data() + 24, 8);      // 헤더 off 24 = record_count
+            pay.assign(all.begin() + 128, all.end());
+            return true;
+        };
+        if (read_pb(dir + L"\\pb_sample.pb", r.smp, r.smp_recs)) {
+            const size_t RB  = sizeof(ggml_moe_phaseb_sample);
+            const size_t VOL = offsetof(ggml_moe_phaseb_sample, capture_qpc);   // [VOL, RB) = 벽시계 계열
+            for (size_t o = 0; o + RB <= r.smp.size(); o += RB) std::memset(r.smp.data() + o + VOL, 0, RB - VOL);
+        }
+        if (eq) read_pb(dir + L"\\pb_a0equiv.pb", r.eqv, r.eqv_recs);   // ★80B 전량 timing-free = 무마스킹
+        const json s = pb_read_metrics_line(dir + L"\\m.jsonl", "summary");
+        if (s.contains("pb_elig_skip")) r.skip = s["pb_elig_skip"];
+        r.nonfinite = r.skip.value("NONFINITE", (uint64_t)0);
+        {
+            std::ifstream ifs(dir + L"\\m.jsonl", std::ios::binary);
+            std::string line;
+            while (std::getline(ifs, line)) {
+                json j = json::parse(line, nullptr, false);
+                if (j.is_object() && j.value("type", "") == "phase_b_run" && j.contains("counts"))
+                    r.counts.push_back(j["counts"]);
+            }
+        }
+        // ★산출 지문 — 사이드카 payload(마스킹 적용) · 5종 digest · 처분 enum 분포 · 요청별 counts
+        //   를 하나로 접는다. 아래 frozen 기준선과 대조하므로 wire 의 어느 축이 움직여도 걸린다.
+        uint64_t h = 0xcbf29ce484222325ull;
+        h = pb_fnv(h, r.smp.data(), r.smp.size());
+        h = pb_fnv(h, r.eqv.data(), r.eqv.size());
+        const uint64_t dgv[7] = { r.dg.intent, r.dg.disposition, r.dg.transition, r.dg.cache_class,
+                                  r.dg.readfile, r.dg.readfile_ops, r.dg.intent_count };
+        h = pb_fnv(h, dgv, sizeof(dgv));
+        const std::string sk = r.skip.dump();
+        h = pb_fnv(h, sk.data(), sk.size());
+        for (const auto & c : r.counts) { const std::string cd = c.dump(); h = pb_fnv(h, cd.data(), cd.size()); }
+        r.fp = h;
+        r.ok = true;
+        return r;
+    };
+    // ★frozen 기준선(품목② 시공 시점 박제) — 이 픽스처의 trace/equiv 산출 지문. 델타가 두 모드의
+    //   산출 바이트를 바꾸지 않았음을 **A/B 자기대조가 아니라 고정값 대조**로 잠근다(자기대조는
+    //   "바뀌었지만 결정론적"인 변화를 통과시킨다 — 실측: fanout 을 trace 로 유출시키는 변이에서
+    //   A==B 는 계속 성립했고 이 고정값만 움직였다).
+    static const uint64_t kTrFp[2] = { 0x80b59166587d6a7full, 0x9f98480d1e77c197ull };
+    for (int mi = 0; mi < 2; mi++) {
+        const char * mode = mi == 0 ? "trace" : "equiv";
+        const std::string base = mi == 0 ? "pb_mask_tr" : "pb_mask_eq";
+        const TrRun a = tr_arm(mode, base + "1");
+        const TrRun b = tr_arm(mode, base + "2");
+        if (!check(a.ok && b.ok && a.smp_recs > 0,
+                   std::string("P34j. seal·산출 2회 성립(positive control · ") + mode + " · sample 레코드 " +
+                   std::to_string(a.smp_recs) + "건)")) continue;
+        check(a.rows == (uint64_t)TR_GRAPH && a.rows_ok && a.nonfinite == (uint64_t)TR_GRAPH,
+              std::string("P34k. ★★사양 기준선(") + mode + ") — target 행 " + std::to_string(a.rows) +
+              "/" + std::to_string(TR_GRAPH) + " 전건 elig_skip_reason=NONFINITE · pb_elig_skip.NONFINITE=" +
+              std::to_string(a.nonfinite) + " (status fanout 이 살아 있어야만 성립 — 차단이 이 모드로 "
+              "샜다면 사유가 행에 닿지 못해 SOURCE_RANGE·0 이 된다)");
+        const bool byte_same = a.smp == b.smp && a.smp_recs == b.smp_recs &&
+                               a.eqv == b.eqv && a.eqv_recs == b.eqv_recs;
+        check(byte_same && a.dg == b.dg && a.skip == b.skip && a.counts == b.counts && !a.counts.empty(),
+              std::string("P34k2. ★★산출 wire 2회 전건 동일(") + mode + ") — 사이드카 payload byte " +
+              std::to_string(a.smp.size()) + "B(sample·qpc 마스킹)" +
+              (mi ? " + " + std::to_string(a.eqv.size()) + "B(a0equiv·무마스킹)" : "") +
+              " · 5종 digest · summary 처분 enum 분포 · 요청별 counts " + std::to_string(a.counts.size()) +
+              "건 전부 일치");
+        check(a.fp == kTrFp[mi] && b.fp == kTrFp[mi],
+              std::string("P34k3. ★★frozen 기준선 대조(") + mode + ") — 산출 지문 " + hx64(a.fp) +
+              " == 박제값 " + hx64(kTrFp[mi]) +
+              " (payload byte·5종 digest·처분 enum 분포·요청별 counts 를 접은 값 — 델타가 이 모드의 "
+              "산출을 바꾸지 않았음의 고정 기준선. 자기대조와 달리 build 수준 변화를 잡는다)");
+    }
