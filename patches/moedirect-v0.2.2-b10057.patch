+
+struct QuantTrait { const char * type; uint32_t block_values; uint32_t block_bytes; ggml_type gt; };
+
+constexpr QuantTrait QUANT_TRAITS[] = {
+    { "F32",   1,   4,   GGML_TYPE_F32   },
+    { "F16",   1,   2,   GGML_TYPE_F16   },
+    { "MXFP4", 32,  17,  GGML_TYPE_MXFP4 },
+    { "Q3_K",  256, 110, GGML_TYPE_Q3_K  },
+    { "Q4_K",  256, 144, GGML_TYPE_Q4_K  },
+    { "Q5_K",  256, 176, GGML_TYPE_Q5_K  },
+    { "Q6_K",  256, 210, GGML_TYPE_Q6_K  },
+    { "Q8_0",  32,  34,  GGML_TYPE_Q8_0  },
+};
+
+bool lookup_quant_trait(const std::string & type, uint32_t & bv, uint32_t & bb) {
+    for (const auto & t : QUANT_TRAITS) {
+        if (type == t.type) { bv = t.block_values; bb = t.block_bytes; return true; }
+    }
+    return false;
+}
+
+// ggml_type enum -> frozen upper-case wire type spelling ("F32"/"MXFP4"/"Q3_K"...).
+// NOTE: ggml_type_name() must NOT be used for wire work: it returns the lower-case ggml spellings
+// ("f32", "mxfp4", "q3_K"), so feeding it into the frozen MOE-INVENTORY-V1 rows would silently
+// change the digest input. The mapping above is the single source of truth (OPENARCH_B_SPEC §1).
+// Returns nullptr when the live type is outside the frozen table.
+const char * wire_type_name(ggml_type gt) {
+    for (const auto & t : QUANT_TRAITS) {
