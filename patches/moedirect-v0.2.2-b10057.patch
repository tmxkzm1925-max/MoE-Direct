+            const uint64_t lu_e5 = qd_record_last_used(/*L0e5*/ 5, f5);
+            check(f0 && f5 && lu_e5 > lu_e0,
+                  "M3c. ★논리 요청 순서 tick — 뒤 요청(hit e5) last_used(" + std::to_string(lu_e5) +
+                  ") > 앞 요청(miss e0) last_used(" + std::to_string(lu_e0) + ")");
+
+            // 캐시 압력: 미상주 7개를 순차 적재 → 6개가 L1e1..e6 슬롯을, 7번째가 tick 최소 슬롯을
+            // 축출한다. 논리 순서가 맞으면 그 최소 슬롯은 e0(앞), 뒤집혔으면 e5(뒤)다.
+            struct Pr { ggml_tensor * t; int32_t e; };
+            const Pr pressure[7] = { {g1,7},{g0,1},{g0,2},{g0,3},{g0,4},{g0,6},{g0,7} };
+            for (const auto & p : pressure) {
+                int32_t e = p.e;
+                ggml_moe_direct_acquire(p.t, &e, 1, 1);
+                ggml_moe_direct_release(p.t, &e, 1);
+            }
+            const uint64_t r1 = qd_reads_total();
+            int32_t probe5 = 5; ggml_moe_direct_acquire(g0, &probe5, 1, 1);
+            const uint64_t dr5 = qd_reads_total() - r1;   // 논리 순서 정상이면 e5 상주 → 0
+            ggml_moe_direct_release(g0, &probe5, 1);
+            const uint64_t r2 = qd_reads_total();
+            int32_t probe0 = 0; ggml_moe_direct_acquire(g0, &probe0, 1, 1);
+            const uint64_t dr0 = qd_reads_total() - r2;   // 논리 순서 정상이면 e0 축출됨 → 1
+            ggml_moe_direct_release(g0, &probe0, 1);
+            check(dr5 == 0 && dr0 == 1,
+                  "M3d. ★캐시 압력 후 축출 순서 — 뒤 요청(e5)이 앞 요청(e0)보다 나중 축출(e5 재접근 read=" +
+                  std::to_string(dr5) + " e0 재접근 read=" + std::to_string(dr0) + " · tick 뒤집히면 0/1이 역전)");
+        }
+    }
+
+    // ── M4. slot 0 정상 처리 — 첫 배치의 victim은 slot 0(전 슬롯 last_used 0 → 최소 인덱스)이며
+    //    publish된 slot_index 0이 -1(미상주) 센티널과 혼동되지 않는다(재요청이 hit로 흡수).
