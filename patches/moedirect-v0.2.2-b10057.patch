+            bool ok = (arc == 0) && (dr1 == 1) && verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 2);
+            ggml_moe_direct_release(g0, &id, 1);
+            const uint64_t r1 = qd_reads_total();
+            int arc2 = ggml_moe_direct_acquire(g0, &id, 1, 1); // 재요청 = hit(추가 read 0)
+            const uint64_t dr2 = qd_reads_total() - r1;
+            ok = ok && (arc2 == 0) && (dr2 == 0) && verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 2);
+            check(ok, "M4b. ★slot 0 적재·publish·재-hit 정상(첫 read=" + std::to_string(dr1) +
+                      " 재요청 read=" + std::to_string(dr2) + ")");
+            ggml_moe_direct_release(g0, &id, 1);
+        }
+    }
+
+    // ── M5. ★capacity preflight — 수용 불가 배치는 어떤 mutation도 없이 -1.
+    //    8슬롯 중 7개를 leased로 고정(가용 1) → 유니크 miss 2개 배치는 실패해야 하며, 그 시점에
+    //    부분 적재(publish)·lease 변경·generation 증가가 전혀 없어야 한다.
+    {
+        Fixture fx; qd_setup_2layer(fx, "qd_preflight");
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        if (check(rc == 0, "M5a. seal 성공(8슬롯)")) {
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+            std::vector<int32_t> pin = {0,1,2,3,4,5,6};
+            int arc0 = ggml_moe_direct_acquire(g0, pin.data(), 7, 8); // 7슬롯 leased(미release) → 가용 1
+            int32_t leased_b = -1; int64_t total_b = -1; ggml_moe_direct_test_lease_stats(&leased_b, &total_b);
+            const QdStateSnap before = qd_snapshot(16); // ★slot generation·매핑·LRU 전량 스냅샷
+            const uint64_t r0 = qd_reads_total();
+            int32_t two[2] = { 0, 1 };
+            int arc1 = ggml_moe_direct_acquire(g1, two, 2, 8); // 유니크 miss 2 > 가용 1 → preflight 실패
+            const uint64_t dr = qd_reads_total() - r0;
+            const QdStateSnap after = qd_snapshot(16);
+            int32_t leased_a = -1; int64_t total_a = -1; ggml_moe_direct_test_lease_stats(&leased_a, &total_a);
+            bool no_publish = (ggml_moe_direct_ptr(g1, 0) == nullptr) && (ggml_moe_direct_ptr(g1, 1) == nullptr);
+            bool table_intact = true;
+            for (int32_t e = 0; e <= 6; e++)
+                if (!verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, e)) table_intact = false;
+            const bool gen_intact = (before.slot_gen == after.slot_gen) && (before.rec_gen == after.rec_gen);
+            check(arc0 == 0 && arc1 < 0 && dr == 0 && leased_a == leased_b && total_a == total_b &&
+                  no_publish && table_intact && gen_intact && (before == after),
+                  "M5b. ★preflight 실패 배치는 mutation 0 — read=" + std::to_string(dr) +
+                  " lease(" + std::to_string(total_b) + "→" + std::to_string(total_a) +
+                  ") · slot generation 불변=" + (gen_intact ? "yes" : "NO") +
+                  " · 내부 상태 스냅샷 전량 동일=" + ((before == after) ? "yes" : "NO"));
+            // 가용 1개는 그대로 남아 있어야 한다(유니크 miss 1개 배치는 성공).
+            int32_t one = 0;
+            int arc2 = ggml_moe_direct_acquire(g1, &one, 1, 1);
+            check(arc2 == 0 && verify_ptr_bytes(fx, "blk.1.ffn_gate_exps.weight", 1, 0, 0),
+                  "M5c. 실패 배치 이후에도 가용 슬롯 1개 정상 사용(적재 성공)");
+            ggml_moe_direct_release(g1, &one, 1);
+            ggml_moe_direct_release(g0, pin.data(), 7);
+        }
+    }
+
+    // ── M6. n_unique_miss > QD sliding pump(QD=2 강제) — 전량 로드 완료.
+    {
+        set_env("MOE_DIRECT_QD", "2");
+        Fixture fx; qd_setup_2layer(fx, "qd_pump2");
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        clear_env("MOE_DIRECT_QD");
+        if (check(rc == 0, "M6a. seal 성공(MOE_DIRECT_QD=2)")) {
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            std::vector<int32_t> ids = {0,1,2,3,4,5,6,7}; // 유니크 miss 8 > QD 2
+            const uint64_t r0 = qd_reads_total();
+            int arc = ggml_moe_direct_acquire(g0, ids.data(), 8, 8);
+            const uint64_t dr = qd_reads_total() - r0;
+            bool ok = (arc == 0) && (dr == 8);
+            for (int32_t e = 0; e < 8; e++) ok = ok && verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, e);
+            int32_t leased = -1; int64_t total = -1; ggml_moe_direct_test_lease_stats(&leased, &total);
+            ok = ok && leased == 8 && total == 8;
+            check(ok, "M6b. ★n_unique_miss(8) > QD(2) sliding pump — 전량 적재·데이터 정합(reads=" +
+                      std::to_string(dr) + " leased=" + std::to_string(leased) + ")");
+            ggml_moe_direct_release(g0, ids.data(), 8);
+        }
+    }
+
+    // ── M7. ERROR_IO_PENDING 실발생 ≥2건(QD=8 · 대형 레코드 · FILE_FLAG_NO_BUFFERING).
+    //    ★동결 사양 D-5가 "적어도 두 operation이 실제 ERROR_IO_PENDING"을 요구하므로 대체-PASS
+    //    경로 없이 dpend >= 2를 정식 판정으로 둔다(미충족 = FAIL로 드러나야 한다 — 비동기 경로가
+    //    실제로 pending을 타지 않으면 QD 레버의 전제 자체가 무너지기 때문).
+    {
+        set_env("MOE_DIRECT_QD", "8");
+        Fixture fx; fx.dir = make_case_dir("qd_pending");
+        fx.model.arch = "synth"; fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 1;
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_fused_layer(0, 8, "Q6_K", 256) }; // 레코드 ≈108KB
