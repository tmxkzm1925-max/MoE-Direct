+// J. metrics lifecycle + fallback (v1 승계 복원 — 권고)
+// ===========================================================================
+static void test_metrics_lifecycle() {
+    section("J. metrics lifecycle(exclusive-create·header·seq 단조·summary) + fallback 계수");
+    std::wstring dir = make_case_dir("metrics");
+    std::wstring mpath = dir + L"\\metrics.jsonl";
+    set_env("MOE_DIRECT_METRICS", wide_to_utf8(mpath));
+    // 1차: seal → acquire → finalize
+    {
+        Fixture fx; fx.dir = dir;
+        fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 1;
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_separate_layer(0, 8, "MXFP4", false) };
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        if (check(rc == 0, "J1. seal 성공(metrics enabled)")) {
+            int32_t ids[3] = {0,1,2}; ggml_moe_direct_acquire(fx.find("blk.0.ffn_gate_exps.weight"), ids, 3, 1);
+            ggml_moe_direct_release(fx.find("blk.0.ffn_gate_exps.weight"), ids, 3);
+            ggml_moe_direct_finalize();
+        }
+        // Fixture 소멸 시 reset → metrics 파일 close
+    }
+    // metrics 파일 판독: header 1개 + summary + seq 단조
+    {
+        std::ifstream ifs(mpath, std::ios::binary);
+        std::vector<json> recs; std::string line;
+        while (std::getline(ifs, line)) { while (!line.empty() && (line.back()=='\r'||line.back()=='\n')) line.pop_back(); if (!line.empty()) { try { recs.push_back(json::parse(line)); } catch (...) {} } }
+        bool has_header = !recs.empty() && recs.front().value("type", "") == "header";
+        bool has_summary = false; for (auto & r : recs) if (r.value("type","") == "summary") has_summary = true;
+        bool seq_mono = true; long prev = -1;
+        for (auto & r : recs) { long s = r.value("seq", (long)-999); if (s <= prev) seq_mono = false; prev = s; }
+        check(has_header && has_summary && seq_mono && recs.size() >= 2,
+              "J2. ★header 1 + terminal summary + seq 단조 증가(records=" + std::to_string(recs.size()) + ")");
+    }
+    // 2차: 같은 경로 존재 → exclusive-create 실패로 seal 중단
+    {
+        Fixture fx; fx.dir = make_case_dir("metrics2");
+        fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 1;
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_separate_layer(0, 8, "MXFP4", false) };
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64); // MOE_DIRECT_METRICS 여전히 기존 파일
+        check(rc < 0, "J3. ★기존 metrics 파일 존재 → exclusive-create 실패로 seal 중단");
+    }
+    clear_env("MOE_DIRECT_METRICS");
+    // fallback 계수 증가 검출
+    {
+        ggml_moe_direct_reset_for_test();
+        uint64_t before = ggml_moe_direct_fallback_count();
+        ggml_moe_direct_fallback_hit("selftest-J");
+        ggml_moe_direct_fallback_hit("selftest-J");
+        check(ggml_moe_direct_fallback_count() == before + 2, "J4. fallback counter 증가 검출(+2)");
+    }
