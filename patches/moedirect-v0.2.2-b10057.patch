+// ── P5. prefetch 오류/부분 read unpublish + joined retry 이전(§5) ─────────────────────────
+static void test_pb_error_and_retry() {
+    section("P5. ★prefetch 오류/부분 read — speculative fail-soft unpublish · joined 단일 새 generation retry(구 슬롯 lease 0)");
+    // (a) speculative(waiter 無) 오류 = unpublish + 계수, retry 0건
+    {
+        PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+        Fixture fx; pb_setup_2layer(fx, "pb_err_spec");
+        if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P5a. seal 성공")) return;
+        ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+        std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+        ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+        ggml_moe_direct_release(g1, pre.data(), 7);
+        ggml_moe_direct_test_pb_fault_next(1);
+        pb_push_and_settle(0, 0, 0, 0, 1, {0,1,2,3,4,5,6,7});
+        const uint64_t eu = ggml_moe_phaseb_counter(GGML_MOE_PB_C_PREFETCH_ERROR_UNPUBLISH);
+        const uint64_t rt = ggml_moe_phaseb_counter(GGML_MOE_PB_C_PREFETCH_RETRY);
+        int32_t slot = -1; uint64_t gen = 0;
+        ggml_moe_direct_test_record_slot((int64_t)1 * PB_TEST_N_EXPERT + 0, &slot, &gen);
+        const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+        bool st_ok = false;
+        for (const auto & r : ios)
+            if (r.origin == 1 && r.terminal_status == GGML_MOE_PB_T_ERROR_UNPUBLISHED && r.publish_seq == 0 &&
+                (r.flags & 0x20) == 0) st_ok = true;
+        check(eu == 1 && rt == 0 && slot < 0 && st_ok,
+              "P5b. ★speculative 오류 = fail-soft unpublish(미publish·retry 0건·terminal_status=2·publish_seq=0)");
+    }
+    // (b) joined 오류 = 단 하나의 새 generation retry(origin=demand·is_retry·retry_of 유효·구 슬롯 lease 0)
+    {
+        PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+        Fixture fx; pb_setup_2layer(fx, "pb_err_join");
+        if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P5c. seal 성공")) return;
+        ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+        std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+        ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+        ggml_moe_direct_release(g1, pre.data(), 7);
+
+        ggml_moe_direct_test_hold_retire(1);
+        std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+        ggml_moe_phaseb_test_push_intent(0, 0, 0, 0, 1, ids.data(), 8);
+        uint64_t issued = 0;
+        for (int i = 0; i < 400 && issued == 0; i++) {
+            int32_t l = 0; int64_t t = 0; ggml_moe_direct_test_lease_stats(&l, &t);
+            issued = ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED);
+            if (issued == 0) Sleep(1);
+        }
+        const uint64_t uj0 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN);
+        std::atomic<int> arc{-99};
+        int32_t e0 = 0;
+        std::thread th([&]() { arc.store(ggml_moe_direct_acquire(g1, &e0, 1, 1)); });
+        uint64_t uj1 = uj0;
+        for (int i = 0; i < 400 && uj1 == uj0; i++) { Sleep(1); uj1 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN); }
+        ggml_moe_direct_test_pb_fault_next(1);      // 이 op의 terminal을 오류로 강등
+        ggml_moe_direct_test_hold_retire(0);
+        th.join();
+
+        const uint64_t rt = ggml_moe_phaseb_counter(GGML_MOE_PB_C_PREFETCH_RETRY);
+        int32_t slot = -1; uint64_t gen = 0;
+        ggml_moe_direct_test_record_slot((int64_t)1 * PB_TEST_N_EXPERT + 0, &slot, &gen);
+        const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+        // 원 op(origin=prefetch·status=2·had_waiter=1) ↔ retry(origin=demand·is_retry·새 generation) 1:1
+        uint64_t orig_gen = 0, retry_gen = 0, retry_of = 0, orig_submit = 0;
+        int32_t orig_slot = -1, retry_slot = -1;
+        uint64_t n_retry = 0, n_joined_err = 0;
+        for (const auto & r : ios) {
+            if (r.origin == 1 && r.terminal_status == GGML_MOE_PB_T_ERROR_UNPUBLISHED && (r.flags & 0x20)) {
+                n_joined_err++; orig_gen = r.generation; orig_slot = r.slot; orig_submit = r.submit_event_seq;
+            }
+            if (r.flags & 0x04) { n_retry++; retry_gen = r.generation; retry_slot = r.slot; retry_of = r.retry_of_submit_event_seq; }
+        }
+        bool retry_demand_origin = true;
+        for (const auto & r : ios) if ((r.flags & 0x04) && r.origin != 0) retry_demand_origin = false;
+        check(arc.load() == 0 && rt == 1 && n_joined_err == 1 && n_retry == 1 && retry_demand_origin &&
+              retry_of == orig_submit && !(retry_slot == orig_slot && retry_gen == orig_gen),
+              "P5d. ★joined 오류 → 단일 새 generation retry(origin=demand·is_retry·retry_of=원 submit_event_seq·"
+              "full triple 상이) · 최종 성공(rc=" + std::to_string(arc.load()) + ")");
+        check(slot >= 0 && gen == retry_gen,
+              "P5e. ★retry 성공 publish — record→slot이 retry generation(" + std::to_string(retry_gen) + ")으로 확정");
+        int64_t owner = -1; uint64_t lu = 0, sg = 0; int32_t lease = 0;
+        if (slot >= 0) ggml_moe_direct_test_slot_state(slot, &owner, &lu, &sg, &lease);
+        check(lease == 1, "P5f. ★구 슬롯 lease 0 유지 — lease는 성공 terminal에서 1회만 반영(lease=" +
+                          std::to_string(lease) + ")");
+        ggml_moe_direct_release(g1, &e0, 1);
+    }
+}
