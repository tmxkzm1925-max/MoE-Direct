+// gpt-oss: 전 층(0..n_layer-1) separate 3 weight + 3 bias.
+static void tpl_setup_gptoss(Fixture & fx, const char * tag, int32_t n_layer = 3, int32_t n_managed = -1) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "gpt-oss";
+    fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = n_layer;
+    fx.model.sources = { default_source() };
+    fx.model.layers.clear();
+    const int32_t managed = (n_managed < 0) ? n_layer : n_managed;
+    for (int32_t l = 0; l < managed; l++) fx.model.layers.push_back(make_separate_layer(l, 8, "MXFP4", true));
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.tpl_mode = true; fx.tpl_template_id = "gpt-oss";
+}
+// qwen35moe(nextn=1·execution): manifest/관리 층 {0,1,2} + live-only 층 3(NextN 제외 대상).
+static void tpl_setup_qwen_exec(Fixture & fx, const char * tag) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "qwen35moe";
+    fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 4; fx.model.n_layer_nextn = 1;
+    fx.model.sources = { default_source() };
+    fx.model.layers = { make_separate_layer(0, 8, "MXFP4", false), make_separate_layer(1, 8, "MXFP4", false),
+                        make_separate_layer(2, 8, "MXFP4", false) };
+    fx.extra_live_layers = { make_separate_layer(3, 8, "MXFP4", false) };
+    fx.routed_scope = "execution";
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.tpl_mode = true; fx.tpl_template_id = "qwen35moe";
+}
+// deepseek2(leading_dense=1): 층집합 공식 = 1..n_layer-1(선두 dense 블록 제외).
+static void tpl_setup_deepseek(Fixture & fx, const char * tag, bool include_dense_layer0 = false) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "deepseek2";
+    fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 4; fx.model.n_layer_dense_lead = 1;
+    fx.model.sources = { default_source() };
+    fx.model.layers.clear();
+    for (int32_t l = (include_dense_layer0 ? 0 : 1); l < 4; l++)
+        fx.model.layers.push_back(make_separate_layer(l, 8, "MXFP4", false));
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.tpl_mode = true; fx.tpl_template_id = "deepseek2";
+}
