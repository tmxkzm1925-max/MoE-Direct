+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+               "P26a. seal 성공(프리페치 ON · descriptor 선언 상태)")) return;
+
+    const int32_t ne = PB_TEST_N_EMBD, nx = PB_TEST_N_EXPERT;
+    check(ggml_moe_phaseb_adapter_id() == GGML_MOE_PHASEB_ADAPTER_QWEN35MOE &&
+          std::string(ggml_moe_phaseb_adapter_name()) == "qwen35moe_v1" &&
+          std::string(ggml_moe_phaseb_adapter_reason()).empty() &&
+          ggml_moe_phaseb_norm_tensor_kind() == GGML_MOE_PHASEB_NORM_ATTN_POST &&
+          ggml_moe_phaseb_selection_fn()     == GGML_MOE_PHASEB_SEL_TOPK_RAW &&
+          ggml_moe_phaseb_bias_kind()        == GGML_MOE_PHASEB_BIAS_NONE &&
+          ggml_moe_phaseb_prefetch_on(),
+          "P26b. ★닫힌 매핑 해소 = qwen35moe_v1(norm=attn_post_norm · sel=topk_raw · bias=none) · 프리페치 ON 유지");
+
+    uint64_t slot_b = 0, pool_b = 0, rt_b = 0, nm_b = 0, irec = 0, iq_b = 0, pstk = 0, covf = 0, iovf = 0;
+    uint32_t pth = 0;
+    ggml_moe_phaseb_mem_echo(&slot_b, &pool_b, &rt_b, &nm_b, &irec, &iq_b, &pth, &pstk, &covf, &iovf);
+    check(ggml_moe_phaseb_capture_width() == ne &&
+          pool_b == slot_b * 48 && slot_b > (uint64_t)ne * sizeof(float) &&
+          rt_b == (uint64_t)(2 - 1) * ne * nx * sizeof(float) &&
+          nm_b == (uint64_t)2 * ne * sizeof(float),
+          "P26c. ★capture 폭 = descriptor n_embd(" + std::to_string(ggml_moe_phaseb_capture_width()) +
+          ") · pool=48×slot(" + std::to_string(slot_b) + "B) · 스냅샷 회계 불변(router " +
+          std::to_string(rt_b) + "B · norm " + std::to_string(nm_b) + "B)");
+
+    std::vector<float> w0, w1, rt1;
+    pb_fill_snapshot(ne, nx, 20260729u, w0, w1, rt1);
+
+    // dispatcher 정지 → intent 를 소비 전에 결정론적으로 회수(peek+pop).
+    ggml_moe_direct_test_dispatcher_pause(1);
+    ggml_moe_phaseb_run_begin();
+    std::mt19937 rng(20260729u);
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    int matched = 0, produced = 0;
+    for (int t = 0; t < 8; t++) {
+        std::vector<float> x((size_t)ne);
+        for (auto & v : x) v = ud(rng);
+        ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);
+        const int rc = ggml_moe_phaseb_capture(/*src_layer=*/0, /*src_mlpos=*/-1, x.data(),
+                                               (int32_t)GGML_TYPE_F32, ne, 1, 1, 1);
+        const int idle = ggml_moe_phaseb_test_wait_idle(5000);
+        ggml_moe_phaseb_intent it{};
+        const int got = ggml_moe_phaseb_intent_peek(&it);
+        if (got == 1) ggml_moe_phaseb_intent_pop();
+        ggml_moe_phaseb_graph_end();
