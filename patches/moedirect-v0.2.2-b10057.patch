+// ── P2. admission·publish 상태기계 + probation → promotion(§4) ────────────────────────────
+static void test_pb_admission_promotion() {
+    section("P2. ★admission 순서(①QD ②N ③reserve ④claim) · READY_PROBATION publish · demand hit promotion");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_admit");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P2a. seal 성공(16슬롯·QD4·K8·N2)")) return;
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+
+    // 층 1의 expert 1..7을 미리 상주시킨다 → 그 rank는 PRE_RESIDENT(결정론), 0만 candidate.
+    std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+    ggml_moe_direct_acquire(g1, pre.data(), (int32_t)pre.size(), 1);
+    ggml_moe_direct_release(g1, pre.data(), (int32_t)pre.size());
+
+    const PbCtr c0 = pb_ctr();
+    const bool settled = pb_push_and_settle(0, 0, 0, /*src=*/0, /*tgt=*/1, {0,1,2,3,4,5,6,7});
+    const PbCtr c1 = pb_ctr();
+    const uint64_t d_res = c1.get(GGML_MOE_PB_C_PRE_SKIPPED_RESIDENT) - c0.get(GGML_MOE_PB_C_PRE_SKIPPED_RESIDENT);
+    const uint64_t d_cand = c1.get(GGML_MOE_PB_C_CANDIDATE) - c0.get(GGML_MOE_PB_C_CANDIDATE);
+    const uint64_t d_adm = c1.get(GGML_MOE_PB_C_ADMITTED) - c0.get(GGML_MOE_PB_C_ADMITTED);
+    const uint64_t d_iss = c1.get(GGML_MOE_PB_C_ISSUED) - c0.get(GGML_MOE_PB_C_ISSUED);
+    check(settled && d_res == 7 && d_cand == 1 && d_adm == 1 && d_iss == 1,
+          "P2b. ★사전 처분 우선순서 — 상주 7건 PRE_RESIDENT · 후보 1건 admitted/issued (resident=" +
+          std::to_string(d_res) + " candidate=" + std::to_string(d_cand) + " issued=" + std::to_string(d_iss) + ")");
+
+    // publish 후 slot class = READY_PROBATION(waiter 無 publish · §4 상태기계).
+    int32_t slot = -1; uint64_t gen = 0;
+    ggml_moe_direct_test_record_slot(/*L1 e0*/ (int64_t)1 * PB_TEST_N_EXPERT + 0, &slot, &gen);
+    int32_t cls = -1; uint64_t ord = 0;
+    if (slot >= 0) ggml_moe_direct_test_slot_class(slot, &cls, &ord, nullptr);
+    check(slot >= 0 && cls == GGML_MOE_PB_CLASS_PROBATION && ord == 0,
+          "P2c. ★waiter 無 publish → READY_PROBATION(cache_class=2·prefetch_intent_ordinal=" + std::to_string(ord) + ")");
+
+    // demand hit → promotion(class 전환 · used_promoted 1회 · ever_promoted 래치).
+    const uint64_t up0 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_PROMOTED);
+    const uint64_t r0 = qd_reads_total();
+    int32_t e0 = 0;
+    const int arc = ggml_moe_direct_acquire(g1, &e0, 1, 1);
+    const uint64_t dr = qd_reads_total() - r0;
+    ggml_moe_direct_test_slot_class(slot, &cls, &ord, nullptr);
+    const uint64_t up1 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_PROMOTED);
+    check(arc == 0 && dr == 0 && up1 == up0 + 1 && cls == GGML_MOE_PB_CLASS_DEMAND &&
+          ord == GGML_MOE_PHASEB_NA_U64,
+          "P2d. ★probation demand hit — demand read 0(프리페치 적중)·used_promoted +1·class→READY_DEMAND");
+    ggml_moe_direct_release(g1, &e0, 1);
+
+    // 두 번째 hit은 재계상 불가(승격이 class를 바꾸므로).
+    ggml_moe_direct_acquire(g1, &e0, 1, 1);
+    ggml_moe_direct_release(g1, &e0, 1);
+    check(ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_PROMOTED) == up0 + 1,
+          "P2e. ★promotion은 원 op당 최대 1회(재hit 비계상)");
+
+    // pb_io 독립 재계산(§9 게이트 7-b) — ever_promoted 래치.
+    const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+    uint64_t n_pf = 0, n_ev_pro = 0, n_both = 0;
+    for (const auto & r : ios) {
+        if (r.origin != 1) continue;
+        n_pf++;
+        if (r.flags & 0x10) n_ev_pro++;
+        if ((r.flags & 0x08) && (r.flags & 0x10)) n_both++;
+    }
+    check(n_pf == 1 && n_ev_pro == 1 && n_both == 0,
+          "P2f. ★pb_io 독립 재계산 — origin=prefetch 1건·ever_promoted 1건·(ever_joined ∧ ever_promoted) 공존 0");
+}
