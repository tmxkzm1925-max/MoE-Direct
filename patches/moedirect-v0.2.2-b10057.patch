+// ===========================================================================
+// §1. wire 구조체 (SPEC_PHASEA_WIRE.md §2~§6 — 리틀엔디언·고정폭)
+// ===========================================================================
+
+#pragma pack(push, 1)
+
+struct PaHeader {
+    char     magic[8];          // "MOEPA1\0\0"
+    uint32_t layout_version;
+    uint32_t file_kind;         // 1=events 2=ops 3=ledger 4=sets
+    uint32_t record_bytes;
+    uint32_t phasea_mode;
+    uint64_t record_count;
+    uint64_t payload_digest;
+    uint64_t qpc_frequency;
+    uint64_t t0_qpc;
+    uint32_t pid;
+    uint32_t complete;
+    uint32_t n_expert;
+    uint32_t n_moe_layers;
+    uint32_t n_slots;
+    uint32_t n_expert_used;
+    uint64_t boot_id;
+    uint64_t total_requests;
+    uint64_t dropped_records;
+    uint8_t  reserved[24];
+};
+
+struct PaEvent {
+    uint32_t graph_seq;
+    uint16_t layer;
+    uint8_t  flags;             // b0 phase(1=prefill) b1 had_miss
+    uint8_t  part;
+    uint64_t d_qpc;
+    uint64_t r_qpc;
+    uint64_t s_qpc;
+    uint64_t c_qpc;
+    uint64_t q_busy_qpc;
+    uint32_t q_epochs;
+    uint32_t n_ids;
+    uint32_t n_miss;
+    uint32_t n_hit;
+    uint64_t miss_bytes;
+    uint32_t request_index;
+    uint32_t reserved;
+};
+
+struct PaOp {
+    uint64_t record_id;
+    uint64_t file_offset;
+    uint32_t bytes;
+    uint16_t expert;
+    uint16_t layer;
+    uint32_t graph_seq;
+    uint32_t batch_order;
+    uint64_t submit_seq;
+    uint64_t submit_qpc;
+    uint64_t retire_seq;
+    uint64_t retire_qpc;
+    int32_t  slot;
+    uint8_t  flags;             // b0 pending b1 phase(prefill)
+    uint8_t  part;
+    uint16_t reserved;
+};
+
+struct PaLedger {
+    uint8_t  kind;              // 1 ACQ_CALL 2 ACQ_EXPERT 3 EVICT 4 REL_CALL 5 REL_EXPERT 6 SLOT_INIT
+    uint8_t  flags;             // b0 hit b1 canonical b2 phase(prefill)
+    uint16_t expert;
+    uint16_t layer;
+    uint16_t part;
+    int32_t  slot;
+    uint32_t c32;               // graph_seq (SLOT_INIT: owner_record)
+    uint64_t t_qpc;
+    uint64_t val;
+};
+
+struct PaSet {
+    uint32_t graph_seq;
+    uint16_t layer;
+    uint8_t  flags;             // b0 phase b1 pred_a0_valid b2 pred_b_valid b3 actual_truncated
+    uint8_t  n_actual;
+    uint8_t  n_miss;
+    uint8_t  n_pred;
+    uint16_t reserved;
+    uint32_t request_index;
+    uint16_t actual [16];
+    uint16_t miss   [16];
+    uint16_t pred_a0[16];
+    uint16_t pred_b [16];
+};
+
+#pragma pack(pop)
