+// ── P0. env 해소 규약(§1) — K·N 둘 다 유효일 때만 ON·무효는 OFF+off_reason ────────────────
+static void test_pb_env_resolution() {
+    section("P0. ★프리페치 env 해소(§1) — K/N 둘 다 유효일 때만 ON · 무효는 OFF+off_reason");
+    struct Case { const char * k; const char * n; const char * qd; bool on; const char * reason; const char * tag; };
+    const Case cases[] = {
+        { nullptr, nullptr, "4", false, "unset",         "pb_env_unset" },
+        { "8",     nullptr, "4", false, "unset",         "pb_env_konly" },
+        { "7",     "2",     "4", false, "invalid_range", "pb_env_klow"  },
+        { "17",    "2",     "4", false, "invalid_range", "pb_env_khigh" },
+        { "8",     "4",     "4", false, "invalid_range", "pb_env_nqd"   },
+        { "8",     "0",     "4", false, "invalid_range", "pb_env_nzero" },
+        { "8",     "x",     "4", false, "invalid_n",     "pb_env_nbad"  },
+        { "8",     "2",     "4", true,  "",              "pb_env_ok"    },
+    };
+    for (const auto & c : cases) {
+        PbEnv env(c.qd, c.k, c.n, "off", nullptr, nullptr);
+        Fixture fx; pb_setup_2layer(fx, c.tag);
+        const int rc = fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64);
+        int32_t on = -1, k = -1, n = -1; uint64_t a = 0, b = 0, cc = 0, d = 0;
+        ggml_moe_direct_test_pb_counts(&a, &b, &cc, &d, &on, &k, &n);
+        const std::string reason = ggml_moe_phaseb_prefetch_off_reason();
+        const bool ok = (rc == 0) && (on == (c.on ? 1 : 0)) &&
+                        (c.on ? (k == 8 && n == 2 && reason.empty())
+                              : (k == 0 && n == 0 && reason == c.reason));
+        check(ok, std::string("P0. ") + c.tag + " → prefetch_on=" + std::to_string(on) +
+                  " k=" + std::to_string(k) + " n=" + std::to_string(n) +
+                  " reason=\"" + reason + "\"(기대 \"" + c.reason + "\")");
+    }
+}
+
+// ── P1. A′ ordered 동등성(§3) — capture→worker→보정→GEMV→top-k 산출을 독립 재계산과 대조 ──
+static void test_pb_signal_equivalence() {
+    section("P1. ★A′ 신호(§3) — capture→worker→보정(a0_norm=src1×w_{l+1}/w_l)→GEMV→TopK16 ordered 동등성");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_signal");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P1a. seal 성공(프리페치 ON)")) return;
+
+    const int32_t ne = PB_TEST_N_EMBD, nx = PB_TEST_N_EXPERT;
+    // ★R1 #5 ② — 형상은 seal 에서 확정됐다(header phaseb_mem 실값). 여기는 데이터 채움만.
+    if (!check(ggml_moe_phaseb_router_snapshot_bytes() == (uint64_t)(2 - 1) * ne * nx * sizeof(float) &&
+               ggml_moe_phaseb_norm_snapshot_bytes()   == (uint64_t)2 * ne * sizeof(float),
+               "P1b. ★스냅샷 형상이 seal 시점에 확정(router " +
+               std::to_string(ggml_moe_phaseb_router_snapshot_bytes()) + "B · norm " +
+               std::to_string(ggml_moe_phaseb_norm_snapshot_bytes()) + "B)")) return;
+    std::vector<float> w0((size_t)ne), w1((size_t)ne), rt1((size_t)ne * (size_t)nx), x((size_t)ne);
+    std::mt19937 rng(20260726);
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (auto & v : w0) v = 0.5f + std::fabs(ud(rng));   // 0 나눗셈 회피
+    for (auto & v : w1) v = ud(rng);
+    for (auto & v : rt1) v = ud(rng);
+    for (auto & v : x)   v = ud(rng);
+    ggml_moe_phaseb_test_snapshot_raw(0, nullptr, w0.data());
+    ggml_moe_phaseb_test_snapshot_raw(1, rt1.data(), w1.data());
+    if (!check(ggml_moe_phaseb_snapshot_seal() == 0, "P1c. 스냅샷 seal(router 1..n-1 + post-norm 0..n-1)")) return;
+
+    // 테스트 독립 재계산(모듈과 같은 산술 순서).
+    std::vector<float> y((size_t)ne), lg((size_t)nx);
+    for (int32_t i = 0; i < ne; i++) y[(size_t)i] = (x[(size_t)i] * w1[(size_t)i]) / w0[(size_t)i];
+    for (int32_t e = 0; e < nx; e++) {
+        float acc = 0.0f;
+        for (int32_t i = 0; i < ne; i++) acc += rt1[(size_t)e * (size_t)ne + (size_t)i] * y[(size_t)i];
+        lg[(size_t)e] = acc;
+    }
+    std::vector<char> used((size_t)nx, 0);
+    std::vector<uint16_t> ref(16, 0xFFFF);
+    for (int r = 0; r < 16 && r < nx; r++) {
+        int best = -1; float bv = 0.0f;
+        for (int32_t e = 0; e < nx; e++) {
+            if (used[(size_t)e]) continue;
+            if (best < 0 || lg[(size_t)e] > bv) { best = e; bv = lg[(size_t)e]; }
+        }
+        used[(size_t)best] = 1; ref[(size_t)r] = (uint16_t)best;
+    }
+
+    // dispatcher를 정지시켜 intent를 소비되기 전에 관측한다(결정론).
+    ggml_moe_direct_test_dispatcher_pause(1);
+    ggml_moe_phaseb_run_begin();
+    ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);
+    const int cap_rc = ggml_moe_phaseb_capture(/*src_layer=*/0, /*src_mlpos=*/-1, x.data(),
+                                               (int32_t)GGML_TYPE_F32, ne, /*n_rows=*/1,
+                                               /*n_tokens=*/1, /*contiguous=*/1);
+    const int idle = ggml_moe_phaseb_test_wait_idle(5000);
+    ggml_moe_phaseb_intent intent{};
+    const int got = ggml_moe_phaseb_intent_peek(&intent);
+    ggml_moe_direct_test_dispatcher_pause(0);
+
+    bool same = (got == 1);
+    for (int i = 0; i < 16 && same; i++) same = (intent.ids[i] == ref[(size_t)i]);
+    check(cap_rc == 1 && idle == 1 && got == 1 && same,
+          "P1d. ★capture 1건 → intent 1건 · ordered top-16 배열 byte-equal(독립 재계산 대조)");
+    check(got == 1 && intent.source_layer == 0 && intent.target_layer == 1 && intent.k == 8 &&
+          intent.intent_ordinal == 0 && intent.capture_qpc != 0 && intent.predict_end_qpc >= intent.capture_qpc,
+          "P1e. intent 키 = (request_epoch, graph_epoch, source=0, target=1, rank) · ordinal 0-based · 시각 단조");
+
+    // eligibility skip 계수(§4.1) — prefill / 비singleton / 비F32 / non-contiguous.
+    const uint64_t s_prefill0 = ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_PREFILL);
+    const uint64_t s_multi0   = ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_MULTI_TOKEN);
+    const uint64_t s_type0    = ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_SRC1_TYPE);
+    const uint64_t s_nc0      = ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_NONCONTIG);
+    const uint64_t s_src0     = ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_SOURCE_RANGE);
+    // ★R1 #10 ① — canonical dedupe가 eligibility 검사 **앞**에 있으므로 (graph, 층)당 1회만
+    //   계수된다. 각 사유는 별도 graph 에서 행사해야 하며, 이것이 곧 "part별 3배 금지"의 회귀다.
+    struct SkipCase { int32_t layer, type, rows, tokens, contig; };
+    const SkipCase scases[5] = {
+        { 0, (int32_t)GGML_TYPE_F32, 1, 16, 1 },   // PREFILL
+        { 0, (int32_t)GGML_TYPE_F32, 4, 1,  1 },   // MULTI_TOKEN
+        { 0, (int32_t)GGML_TYPE_F16, 1, 1,  1 },   // SRC1_TYPE
+        { 0, (int32_t)GGML_TYPE_F32, 1, 1,  0 },   // NONCONTIG
+        { 1, (int32_t)GGML_TYPE_F32, 1, 1,  1 },   // SOURCE_RANGE(최종층 = trunk 밖)
+    };
+    for (const auto & sc : scases) {
+        ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);
+        ggml_moe_phaseb_capture(sc.layer, -1, x.data(), sc.type, ne, sc.rows, sc.tokens, sc.contig);
+        // ★같은 (graph, 층) 재호출(등록 part 3개 중 2·3번째 상당)은 dedupe로 **무계수**여야 한다.
+        ggml_moe_phaseb_capture(sc.layer, -1, x.data(), sc.type, ne, sc.rows, sc.tokens, sc.contig);
+        ggml_moe_phaseb_capture(sc.layer, -1, x.data(), sc.type, ne, sc.rows, sc.tokens, sc.contig);
+        ggml_moe_phaseb_graph_end();
+    }
+    check(ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_PREFILL)     == s_prefill0 + 1 &&
+          ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_MULTI_TOKEN) == s_multi0 + 1 &&
+          ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_SRC1_TYPE)   == s_type0 + 1 &&
+          ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_NONCONTIG)   == s_nc0 + 1 &&
+          ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_SOURCE_RANGE) == s_src0 + 1,
+          "P1f. ★eligibility reason별 skip 계수 1:1 · ★canonical dedupe가 검사 앞(part 3회 호출→계수 1회 "
+          "— R1 #10 ①): PREFILL/MULTI_TOKEN/SRC1_TYPE/NONCONTIG/SOURCE_RANGE 각 +1");
+
+    ggml_moe_direct_test_pb_quiesce(3000);
+    ggml_moe_phaseb_graph_end();
+    ggml_moe_phaseb_run_end();
+}
+
+// 지금까지 처분(§4.2 enum 1~9)된 rank 총수 — closure 진행 관측용.
+static uint64_t pb_disposed_total(const PbCtr & c) {
+    return c.get(GGML_MOE_PB_C_PRE_DROPPED_TOO_LATE) + c.get(GGML_MOE_PB_C_PRE_DROPPED_STALE) +
+           c.get(GGML_MOE_PB_C_PRE_SKIPPED_RESIDENT) + c.get(GGML_MOE_PB_C_PRE_SKIPPED_PENDING) +
+           c.get(GGML_MOE_PB_C_DROPPED_NO_SLOT_QD) + c.get(GGML_MOE_PB_C_DROPPED_PREFETCH_CAP) +
+           c.get(GGML_MOE_PB_C_DROPPED_RESERVE) + c.get(GGML_MOE_PB_C_ISSUED) +
+           c.get(GGML_MOE_PB_C_SUBMIT_FAILED);
+}
+
+// intent 1건을 밀어넣고 rank 전건이 처분될 때까지 dispatcher turn을 유발한다.
+// ★admission drop은 "턴당 1건" 규약상 progressed 를 세우지 않으므로(다음 사건까지 대기),
+//   테스트는 가벼운 query command 왕복으로 turn을 강제해 결정론적으로 소진시킨다.
+static bool pb_push_and_settle(uint32_t req, uint32_t gepoch, uint32_t gseq,
+                               int32_t src_mlpos, int32_t tgt_mlpos, const std::vector<int32_t> & ids) {
+    const uint64_t base = pb_disposed_total(pb_ctr());
+    if (ggml_moe_phaseb_test_push_intent(req, gepoch, gseq, src_mlpos, tgt_mlpos, ids.data(), (int32_t)ids.size()) != 0)
+        return false;
+    const uint64_t want = (uint64_t)ggml_moe_phaseb_prefetch_k();
+    bool done = false;
+    for (int i = 0; i < 4000 && !done; i++) {
+        int32_t leased = 0; int64_t total = 0;
+        ggml_moe_direct_test_lease_stats(&leased, &total);   // dispatcher turn 유발
+        if (pb_disposed_total(pb_ctr()) - base >= want) { done = true; break; }
+        Sleep(1);
+    }
+    ggml_moe_direct_test_pb_quiesce(3000);
+    return done;
+}
