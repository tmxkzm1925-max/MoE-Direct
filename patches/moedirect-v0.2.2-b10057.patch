+// DSV4 인벤토리 주입 훅(0 = 정상 deepseek4 프로필).
+struct PbDsv4Opt {
+    // hparams 축(표의 요구값과 대조되는 선언값)
+    int32_t hash_layer_count = DSV4_HASH;
+    int32_t hc_mult          = DSV4_HC_MULT;
+    int32_t groups           = 0;
+    int32_t n_expert_shared  = DSV4_SHARED;
+    int32_t weights_norm     = 1;
+    float   weights_scale    = DSV4_W_SCALE;
+    int32_t gating           = DSV4_GATING;
+    int32_t n_expert_used    = DSV4_N_USED;
+    // 텐서 파티션 오염 훅(-1 = 무동작)
