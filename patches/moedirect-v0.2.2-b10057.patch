+// ── P24. ★결정적 교착 재현 — "stopping 스냅샷 직후" 창에 stop 을 강제 삽입(보완 ②) ──────────
+//    P23 은 확률 회귀(단일 검출력 ~5%)라 수리 1의 잠금이 통계적이었다. 여기서는 barrier 훅으로
+//    창을 **강제**하므로 수리 제거 사본에서 100% 교착, 수리본에서 100% 통과가 된다.
+static void test_pb_stop_race_deterministic() {
+    section("P24. ★결정적 stop-race — stopping 스냅샷 직후 창에 stop 삽입 시 join 이 유한 완료");
+    PbEnv env("4", nullptr, nullptr, "off", nullptr, nullptr);
+    Fixture * fx = new Fixture();
+    pb_setup_2layer(*fx, "pb_stoprace");
+    if (!check(fx->seal((uint64_t)PB_TEST_N_EXPERT * fx->comp.slot_stride_max, 64) == 0,
+               "P24a. seal 성공(persistent dispatcher 기동)")) { delete fx; return; }
+    ggml_tensor * g0 = fx->find("blk.0.ffn_gate_exps.weight");
+    std::vector<int32_t> ids = {0,1};
+    ggml_moe_direct_acquire(g0, ids.data(), 2, 1);
+    ggml_moe_direct_release(g0, ids.data(), 2);
+
+    if (!check(ggml_moe_direct_test_stop_race_arm(5000) == 0,
+               "P24b. dispatcher 가 stopping 스냅샷 직후 barrier 에 정지(창 도달)")) { delete fx; return; }
+
+    // ★창 안에서 stop 을 삽입 — 이 pass 는 stale stopping=false 로 진행하므로, 수리 전 코드라면
+    //   disp_peek 이 stop 의 SetEvent(1회)를 지워 INFINITE 대기 → 영구 교착이 된다.
+    std::atomic<bool> done{false};
+    std::thread th([&]() { ggml_moe_direct_test_shutdown(/*abort=*/0); done.store(true, std::memory_order_release); });
+    Sleep(50);                                   // q_stopping + SetEvent 가 확실히 창 안에 들어가게
+    ggml_moe_direct_test_stop_race_release();    // dispatcher 재개(= stale stopping=false 로 pass 진행)
+    for (int w = 0; w < 5000 && !done.load(std::memory_order_acquire); w++) Sleep(1);
+    const bool ok = done.load(std::memory_order_acquire);
+    check(ok, "P24c. ★★신호 소실 창에 stop 삽입 — stop_and_join 유한 완료"
+              "(수리 1 제거 사본에서는 100% 교착·5s 타임아웃)");
+    if (ok) { th.join(); delete fx; } else { th.detach(); }   // 교착 시 회수 불가 — 누수 감수하고 종결
+}
