+// ── P8. ★C4′ 실체 검사(Codex R3 재정의안 형상) ───────────────────────────────────────────
+//    ⓒOFF·QD=1 직렬 형상 = digest 7종 **완전일치**(물리 완료 순서가 제출 순서와 같아 결정론)
+//    ⓓON 형상(QD>1) = **논리 축만** 비교(intent count/digest + eligibility skip vector).
+//       물리 6종(transition/publish 순서 의존)은 arm-local 진단이라 비교 대상에서 제외한다 —
+//       QD>1에서는 PUBLISH 가 I/O 완료 순서로 투입돼 런마다 갈리는 것이 정상이기 때문.
+//    ⓐquiesce 성공 필수 ⓑ**finalize 이후** 판독(cache-class digest 는 terminal summary 에서만 산출)
+//    ⓔtrace-ON 사이드카 재계산 게이트 ⓕpaired 앵커(동일 워크로드 증명 = 캐시 최종 상태·hit/miss)
+struct PbC4Arm {
+    bool     ok = false, quiesced = false;
+    bool     all_off = false;               // ★정정 7호 — PB off ∧ prefetch off predicate(R1 #12 fast-gate)
+    PbDigests dg;
+    uint64_t readfile_digest = 0, readfile_ops = 0, lru_digest = 0, tick_final = 0;
+    PbCtr    ctr;
+    uint64_t skip[GGML_MOE_PB_SKIP_COUNT] = {0};
+    QdStateSnap snap;                       // ⓕ paired 앵커(캐시 최종 상태 = required/actual 등가물)
+    uint64_t hit[2] = {0,0}, miss[2] = {0,0}, rb[2] = {0,0};
+    uint64_t sc_records = 0, sc_digest = 0; // ⓔ trace-ON 사이드카
+    bool     sidecar_ok = true;
+};
+
+// ★정정 7호 — demand graph 안의 **layer 0(= source 층이 없는 층) acquire 횟수**. NO_SOURCE
+//   기대값의 단일 출처다(아래 루프와 P8h assert 가 이 상수를 공유). 2 이상이어야 canonical
+//   비대칭이 실측된다 — 실 graph 는 층당 gate/up/down 3회 acquire 라 이 형상이 정상이다.
+static const uint64_t PB_C4_L0_ACQUIRES = 2;
+
+// 두 arm 이 **완전히 같은 워크로드**를 돌도록 한 함수로 고정한다.
+static PbC4Arm pb_c4_arm(const char * tag, const char * pb_mode, const char * qd,
+                         const char * k, const char * n) {
+    PbC4Arm st;
+    Fixture fx; pb_setup_2layer(fx, tag);
+    PbEnv env(qd, k, n, pb_mode, wide_to_utf8(fx.dir + L"\\pb").c_str(),
+              wide_to_utf8(fx.dir + L"\\metrics.jsonl").c_str());
+    if (fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) != 0) return st;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    const bool pf = (k != nullptr);
+    st.all_off = ggml_moe_phaseb_all_off();   // seal 이후 확정(pb_refresh_all_off)
+
+    ggml_moe_phaseb_run_begin();
+    ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+    std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+    ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+    ggml_moe_direct_release(g1, pre.data(), 7);
+    if (pf) {
+        uint32_t req = 0, gep = 0, gseq = 0; uint8_t ph = 0;
+        ggml_moe_phaseb_current_epoch(&req, &gep, &gseq, &ph);
+        pb_push_and_settle(req, gep, gseq, 0, 1, {0,1,2,3,4,5,6,7});
+    }
+    int32_t e = 0;
+    ggml_moe_direct_acquire(g1, &e, 1, 1);
+    ggml_moe_direct_release(g1, &e, 1);
+    // ★정정 7호 — **같은 graph 안에서 layer 0 을 PB_C4_L0_ACQUIRES 회 acquire** 한다(실 graph 의
+    //   층당 gate/up/down 3회 호출 등가). all_off arm 은 graph epoch 이 열리지 않아 graph_seq=NA →
+    //   canonical 판정(pb_mark_served_locked)이 매 호출을 신규 사건으로 처리하므로 NO_SOURCE 가
+    //   acquire 횟수대로 계수되고, trace-ON arm 은 dedupe 로 graph 당 1회다(P8h 가 이 비대칭을 잠근다).
+    std::vector<int32_t> tail = {10,11};
+    for (uint64_t i = 0; i < PB_C4_L0_ACQUIRES; i++) {
+        ggml_moe_direct_acquire(g0, tail.data(), 2, 1);
+        ggml_moe_direct_release(g0, tail.data(), 2);
+    }
+    ggml_moe_phaseb_graph_end();
+
+    // ★정정 7호 픽스처 보강 — capture 훅을 **실호출**하는 graph 2개(prefill 1 + singleton decode 1).
+    //   구 픽스처는 baseline arm 에서 capture 를 한 번도 부르지 않아 skip vector 가 양 arm 모두
+    //   공허하게 0이었다(= all_off 형상을 못 잡음). 여기서 실호출하면:
+    //     · all_off arm(PB off ∧ prefetch off) = fast-gate 로 훅 자체가 조기 반환 → 계수 0(구조적 N/A)
+    //     · 그 외 arm                          = PREFILL / PREFETCH_OFF 를 실제로 계수
+    //   두 capture 는 eligibility 첫 두 관문에서 반환되므로 skip 카운터·status 링만 건드린다
+    //   (digest 7종·C3·캐시 최종 상태·hit/miss 앵커에는 무영향 — cross-arm 비교 보장 유지).
+    //   ★demand graph 가 끝난 **뒤**에 두어 demand 경로의 graph_seq 배치를 바꾸지 않는다.
+    std::vector<float> cap_x((size_t)PB_TEST_N_EMBD, 0.25f);
+    ggml_moe_phaseb_graph_begin(/*phase=*/1, /*n_tokens=*/16, /*n_outputs=*/1);   // prefill graph(llama-context.cpp:1521 규약)
+    ggml_moe_phaseb_capture(/*src_layer=*/0, /*src_mlpos=*/-1, cap_x.data(),
+                            (int32_t)GGML_TYPE_F32, PB_TEST_N_EMBD, /*n_rows=*/16,
+                            /*n_tokens=*/16, /*contiguous=*/1);
+    ggml_moe_phaseb_graph_end();
+    ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);    // singleton decode graph
+    ggml_moe_phaseb_capture(/*src_layer=*/0, /*src_mlpos=*/-1, cap_x.data(),
+                            (int32_t)GGML_TYPE_F32, PB_TEST_N_EMBD, /*n_rows=*/1,
+                            /*n_tokens=*/1, /*contiguous=*/1);
+    ggml_moe_phaseb_graph_end();
+
+    ggml_moe_phaseb_run_end();
+
+    st.quiesced = (ggml_moe_direct_test_pb_quiesce(5000) == 1);   // ⓐ 반환값 필수 검사
+    st.snap = qd_snapshot(2 * PB_TEST_N_EXPERT);                  // ⓕ finalize 전 캐시 최종 상태
+    for (int ph2 = 0; ph2 < 2; ph2++)
+        ggml_moe_direct_phase_read_bytes_hit_miss(ph2, &st.rb[ph2], &st.hit[ph2], &st.miss[ph2]);
+
+    ggml_moe_direct_finalize();                                   // ⓑ 판독 **전에** finalize
+    st.dg  = pb_digests();
+    st.ctr = pb_ctr();
+    for (int i = 0; i < GGML_MOE_PB_SKIP_COUNT; i++) st.skip[i] = ggml_moe_phaseb_skip_counter(i);
+    ggml_moe_direct_test_digests(&st.readfile_digest, &st.readfile_ops, &st.lru_digest, &st.tick_final);
+
+    // ⓔ trace-ON 사이드카 재계산 게이트(파일 헤더 ↔ payload 재해시).
+    if (std::strcmp(pb_mode, "trace") == 0) {
+        std::ifstream ifs(fx.dir + L"\\pb_sample.pb", std::ios::binary);
+        std::vector<uint8_t> all((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
+        if (all.size() >= 128) {
+            ggml_moe_phaseb_header h{};
+            std::memcpy(&h, all.data(), 128);
+            st.sc_records = h.record_count;
+            st.sc_digest  = h.payload_digest;
+            st.sidecar_ok = (std::memcmp(h.magic, "MOEPB1\0\0", 8) == 0) && h.complete == 1 &&
+                            all.size() == 128 + (size_t)h.record_count * h.record_bytes &&
+                            pb_fnv(0xcbf29ce484222325ull, all.data() + 128, all.size() - 128) == h.payload_digest;
+        } else {
+            st.sidecar_ok = false;
+        }
+    }
+    st.ok = true;
+    return st;
+}
