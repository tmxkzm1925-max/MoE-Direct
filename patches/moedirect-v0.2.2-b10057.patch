+// ── O8. shutdown/abort cancel-terminal drain ──
+static void test_b1_shutdown_drain() {
+    section("O8. ★종료 시퀀스 — CancelIoEx 후 terminal 회수(ERROR_OPERATION_ABORTED drain)·"
+            "success-after-cancel 미publish·waiter 명시 error·slot 재사용 안전");
+
+    EnvGuard eg_q("MOE_DIRECT_QUALIFY", nullptr);
+    EnvGuard eg_p("MOE_DIRECT_IO_PATH", nullptr);
+    EnvGuard eg_qd("MOE_DIRECT_QD", "8");
+    Fixture fx; fx.dir = make_case_dir("b1_abort");
+    fx.model.arch = "synth"; fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 1;
+    fx.model.sources = { default_source() };
+    fx.model.layers = { make_fused_layer(0, 8, "Q6_K", 1024) }; // 레코드 ≈430KB(비동기 pending 유도)
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.build();
+    int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+    if (!check(rc == 0, "O8a. seal 성공(QD=8 · stride=" + std::to_string(fx.comp.slot_stride_max) + "B)")) return;
+
+    ggml_tensor * gu = fx.find("blk.0.ffn_gate_up_exps.weight");
+    ggml_moe_direct_test_abort_after_submit(1); // 제출 in-flight 1건 이상이면 그 자리에서 취소 drain
+    std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+    const int arc = ggml_moe_direct_acquire(gu, ids.data(), 8, 8);
+    const B1Stats s = b1_stats();
+
+    int published = 0;
+    for (int32_t e = 0; e < 8; e++) if (ggml_moe_direct_ptr(gu, e) != nullptr) published++;
+    int32_t leased = -1; int64_t total = -1;
+    ggml_moe_direct_test_lease_stats(&leased, &total);
+    printf("    (참고) arc=%d cancel=%llu abort_terminal=%llu published=%d lease_total=%lld\n",
+           arc, (unsigned long long)s.cancel, (unsigned long long)s.abort_terminal, published, (long long)total);
+    fflush(stdout);
+    check(arc < 0, "O8b. ★abort 중 waiter는 명시 error로 기상(acquire rc=" + std::to_string(arc) + ")");
+    check(s.cancel >= 1 && s.abort_terminal >= 1,
+          "O8c. ★CancelIoEx 실행 + terminal 회수(cancel=" + std::to_string(s.cancel) +
+          " abort_terminal=" + std::to_string(s.abort_terminal) + ")");
+    check((uint64_t)published + s.abort_terminal == 8,
+          "O8d. ★배타 closure — publish(" + std::to_string(published) + ") + abort terminal(" +
+          std::to_string(s.abort_terminal) + ") == 유니크 miss 8 (success-after-cancel 미publish)");
+    check((int64_t)published == total,
+          "O8e. ★abort terminal은 lease 미반영(C2) — lease 총합(" + std::to_string(total) +
+          ") == publish 수(" + std::to_string(published) + ")");
+
+    // cancel 완료 확인 뒤이므로 같은 슬롯을 안전하게 재사용할 수 있어야 한다.
+    const int arc2 = ggml_moe_direct_acquire(gu, ids.data(), 8, 8);
+    bool bytes_ok = (arc2 == 0);
+    for (int32_t e = 0; e < 8; e++) bytes_ok = bytes_ok && verify_ptr_bytes(fx, "blk.0.ffn_gate_up_exps.weight", 0, 0, e);
+    check(bytes_ok, "O8f. ★취소 drain 이후 전 슬롯 정상 재사용(재적재 8건 데이터 정합)");
+    ggml_moe_direct_release(gu, ids.data(), 8);
+
+    // graceful shutdown → 신규 command fail-close.
+    ggml_moe_direct_test_shutdown(0);
+    const int arc3 = ggml_moe_direct_acquire(gu, ids.data(), 8, 8);
+    check(arc3 < 0, "O8g. ★graceful shutdown 후 신규 command 거절(fail-close · rc=" + std::to_string(arc3) + ")");
+    ggml_moe_direct_test_shutdown(0); // 멱등
+    check(true, "O8h. shutdown 멱등(2회 호출 무해)");
+}
