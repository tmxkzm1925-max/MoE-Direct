+// selftest 전용 — 상태 링 잔여 이벤트 수(observe fanout 차단 게이트의 관측 창구).
+uint32_t ggml_moe_phaseb_test_status_depth(void) {
+    std::lock_guard<std::mutex> lk(g_pb.tm_mu);
+    return (uint32_t)g_pb.status_count;
+}
