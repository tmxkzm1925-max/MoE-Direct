+// 오힌트 ON/OFF 공통 — 결정론 capture 1건을 밀어 intent 를 **소비 전에** 관측한다.
+//   반환 1 = capture 성사 + worker idle + intent 존재. graph/run 은 호출자가 닫는다.
+static int pb_hint_capture_peek(const std::vector<float> & x, ggml_moe_phaseb_intent & out,
+                                uint32_t * out_req, uint32_t * out_gep, uint32_t * out_gseq) {
+    ggml_moe_direct_test_dispatcher_pause(1);
+    ggml_moe_phaseb_run_begin();
+    ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);
+    uint8_t ph = 0;
+    ggml_moe_phaseb_current_epoch(out_req, out_gep, out_gseq, &ph);
+    const int cap_rc = ggml_moe_phaseb_capture(0, -1, x.data(), (int32_t)GGML_TYPE_F32,
+                                               PB_TEST_N_EMBD, 1, 1, 1);
+    const int idle = ggml_moe_phaseb_test_wait_idle(5000);
+    const int got  = ggml_moe_phaseb_intent_peek(&out);
+    ggml_moe_direct_test_dispatcher_pause(0);
+    return (cap_rc == 1 && idle == 1 && got == 1) ? 1 : 0;
+}
