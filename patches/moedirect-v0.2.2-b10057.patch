+static void test_pb_adapter_equivalence() {
+    section("P26. ★계열 adapter(§1) — qwen35moe_v1 해소 echo · capture 폭=n_embd · 스냅샷 회계 불변 · "
+            "8입력 ordered top-16 동등성(동결 산식 독립 재계산 대조 — §5 잠금 1)");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
