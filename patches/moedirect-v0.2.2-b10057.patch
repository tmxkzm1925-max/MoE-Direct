+// ── P21. ★joined demand 를 기다리는 prefetch 는 CUT 이 취소하지 않는다(R2 #2) ────────────
+static void test_pb_cut_joined_demand() {
+    section("P21. ★CUT 이 joined demand 의 prefetch 를 취소하지 않는다(R2 #2) — demand 정상 완료 후 CUT 진행");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_cutjoin");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P21a. seal 성공")) return;
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+    ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+    ggml_moe_direct_release(g1, pre.data(), 7);
+
+    // in-flight prefetch 고정 → demand 가 join 해 대기하는 상태를 만든다.
+    ggml_moe_direct_test_hold_retire(1);
+    std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+    ggml_moe_phaseb_test_push_intent(0, 0, 0, 0, 1, ids.data(), 8);
+    uint64_t issued = 0;
+    for (int i = 0; i < 800 && issued == 0; i++) {
+        int32_t l = 0; int64_t t = 0; ggml_moe_direct_test_lease_stats(&l, &t);
+        issued = ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED);
+        if (issued == 0) Sleep(1);
+    }
+    const uint64_t uj0 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN);
+    std::atomic<int> arc{-99};
+    int32_t e0 = 0;
+    std::thread th([&]() { arc.store(ggml_moe_direct_acquire(g1, &e0, 1, 1)); });
+    uint64_t uj1 = uj0;
+    for (int i = 0; i < 800 && uj1 == uj0; i++) { Sleep(1); uj1 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN); }
+
+    // ★joined demand 가 대기 중인 상태에서 finalize(그레이스풀 CUT) 진입.
+    std::thread fin_th([&]() { ggml_moe_direct_finalize(); });
+    Sleep(20);
+    ggml_moe_direct_test_hold_retire(0);   // I/O 회수 재개 → joined op 가 정상 완료돼야 한다
+    th.join();
+    fin_th.join();
+
+    const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+    uint64_t cancelled_joined = 0, published_joined = 0;
+    for (const auto & r : ios) {
+        if (r.origin != 1 || !(r.flags & 0x08)) continue;   // ever_joined 인 prefetch op
+        if (r.terminal_status == GGML_MOE_PB_T_CANCELLED_UNPUBLISHED ||
+            r.terminal_status == GGML_MOE_PB_T_CANCEL_SUCCESS_UNPUB) cancelled_joined++;
+        if (r.terminal_status == GGML_MOE_PB_T_SUCCESS_PUBLISHED && r.publish_seq >= 1) published_joined++;
+    }
+    check(uj1 == uj0 + 1 && arc.load() == 0 && cancelled_joined == 0 && published_joined == 1,
+          "P21b. ★★joined demand 정상 완료(rc=" + std::to_string(arc.load()) + ") · 그 prefetch op 취소 0건 · "
+          "정상 publish 1건(취소되면 demand 가 -1 로 실패한다)");
+    check(ggml_moe_direct_test_cut_residual() == 0,
+          "P21c. joined demand 완료 후 CUT 정상 진행 — 잔여 0");
+}
