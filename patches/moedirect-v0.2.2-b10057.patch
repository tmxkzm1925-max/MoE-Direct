+// ★R1 #12 — fast-gate 재계산(env/prefetch 해소·seal 시점마다).
+void pb_refresh_all_off() {
+    g_pb.all_off.store(g_pb.mode == GGML_MOE_PHASEB_OFF && !g_pb.pf_on, std::memory_order_relaxed);
+}
