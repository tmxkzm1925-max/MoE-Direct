+// ★OPEN_ARCH B축 — 동결 inventory digest(§1 wire 사실):
+//   sha256( b"MOE-INVENTORY-V1\n" + "".join(sorted(rows)) )
+//   row = "<tensor-name>\t<type>\t<d0>,<d1>,..\t<layer>\t<scope>\n"  (utf-8)
+// 프로듀서(repack_experts.py:836)는 Python str 정렬 후 UTF-8 인코딩한다. 공식이 생성하는 이름·
+// 타입·scope 토큰은 전부 ASCII 이므로 아래의 바이트 사전순 정렬은 그것과 동치다(이 동치 조건이
+// 깨지려면 비-ASCII tensor 이름이 등장해야 하며, 그때는 정렬 규약부터 재심의 대상이다).
+bool inventory_digest_hex(std::vector<std::string> & rows, std::string & out_hex) {
+    std::sort(rows.begin(), rows.end());
+    std::string payload = "MOE-INVENTORY-V1\n";
+    for (const auto & r : rows) payload += r;
+    return sha256_bytes((const uint8_t *)payload.data(), payload.size(), out_hex);
+}
