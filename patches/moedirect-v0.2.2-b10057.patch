+// ── P6. cancel/abort — slot 재사용 금지 + success-after-cancel 미publish(§2·§5.2) ─────────
+static void test_pb_cancel_drain() {
+    section("P6. ★abort 취소 drain — cancel 완료 확인 전 slot 재사용 금지 · success-after-cancel 미publish");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_cancel");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P6a. seal 성공")) return;
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+    ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+    ggml_moe_direct_release(g1, pre.data(), 7);
+
+    ggml_moe_direct_test_hold_retire(1);
+    std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+    ggml_moe_phaseb_test_push_intent(0, 0, 0, 0, 1, ids.data(), 8);
+    uint64_t issued = 0;
+    for (int i = 0; i < 400 && issued == 0; i++) {
+        int32_t l = 0; int64_t t = 0; ggml_moe_direct_test_lease_stats(&l, &t);
+        issued = ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED);
+        if (issued == 0) Sleep(1);
+    }
+    // ★회수 보류를 **유지한 채** abort 종료를 행사한다 — 해제 후면 이미 publish 되어
+    //   in-flight가 없다. abort 경로의 CancelIoEx→GetOverlappedResult drain은 회수 보류와
+    //   무관하게 동작하며, 완료된 읽기는 success-after-cancel(status 4)로 종결돼야 한다.
+    ggml_moe_direct_test_shutdown(/*abort_mode=*/1);   // 취소 drain 경로 행사
+    ggml_moe_direct_test_hold_retire(0);
+
+    int32_t slot = -1; uint64_t gen = 0;
+    ggml_moe_direct_test_record_slot((int64_t)1 * PB_TEST_N_EXPERT + 0, &slot, &gen);
+    const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+    uint64_t n_cancel = 0, n_pub_after_cancel = 0;
+    for (const auto & r : ios) {
+        if (r.terminal_status == GGML_MOE_PB_T_CANCELLED_UNPUBLISHED ||
+            r.terminal_status == GGML_MOE_PB_T_CANCEL_SUCCESS_UNPUB) {
+            n_cancel++;
+            if (r.publish_seq != 0) n_pub_after_cancel++;
+        }
+    }
+    check(issued == 1 && n_cancel >= 1 && n_pub_after_cancel == 0 && slot < 0,
+          "P6b. ★취소 terminal(status 3/4) " + std::to_string(n_cancel) +
+          "건 · publish_seq 전건 0(success-after-cancel 미publish) · record 미상주");
+    check(ggml_moe_phaseb_counter(GGML_MOE_PB_C_CAPACITY_CANCEL_ATTEMPT) == 0,
+          "P6c. ★pb_capacity_cancel_attempt = 0(v1 정책상 capacity 확보용 prefetch cancel 코드 부재 — §5.2 ⓕ)");
+}
