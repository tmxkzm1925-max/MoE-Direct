+static void test_qd_lever() {
+    section("M. ★QD 레버 배치 플래너 — dedupe/multiplicity·혼재·뒤쪽 hit 보호·slot0·preflight·pump·PENDING·QD 동등성");
+
+    // ── M1. 중복 ID multiplicity — 같은 expert 2회 요청 → 로드 1회 · lease 2회 · release 후 잔량 0
+    {
+        Fixture fx; qd_setup_2layer(fx, "qd_dup");
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
