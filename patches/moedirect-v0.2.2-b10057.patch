+// ===========================================================================
+// §10.5 ★B1 영속 I/O dispatcher (PHASEB_DESIGN §2 — FROZEN)
+//
+//   CPU acquire/release ── control_q ──> dispatcher ── IoChannel[QD]
+//             │                              │
+//             └──── per-command CV <──────────┘
+//
+//   ★단독 writer = dispatcher: slots.{owner,generation,last_used,lease,state}·record_table·
+//     demand_tick·pending·channel·ReadFile submit/retire·digest. 예외 reader는
+//     ggml_moe_direct_ptr()뿐(release-store publish된 (slot,generation)만).
+//   ★락 순서: g_mod.mutex → q_mutex (역방향 금지). 생산자는 q_mutex 대기 구간에서
+//     g_mod.mutex를 절대 보유하지 않는다(§2 핸드셰이크 ②).
+//   ★lost-wake 방지: enqueue+SetEvent는 q_mutex 아래에서 한 묶음으로 하고, dispatcher는
+//     큐 공백을 같은 q_mutex 아래에서 확인한 뒤에만 ResetEvent 한다.
+// ===========================================================================
+
+// ── control_q(생산자 측) ───────────────────────────────────────────────────
+// 자유 슬롯 1개 확보. STOPPING이면 -1(신규 command 거절). 만석이면 대기(무손실 — drop 없음).
+int32_t cq_alloc() {
+    // ★R1 #3 ① / R2 #1 — capture 훅과 **동일한 단일 원자 래치**를 확인한다(둘이 같은 순간에 닫힘).
+    if (ggml_moe_phaseb_capture_closed()) return -1;
+    std::unique_lock<std::mutex> lk(g_mod.q_mutex);
+    if (g_mod.q_stopping) return -1;
+    if (g_mod.q_free_top == 0) {
+        g_mod.stat_q_full_waits.fetch_add(1, std::memory_order_relaxed);
+        g_mod.q_free_cv.wait(lk, [] { return g_mod.q_free_top > 0 || g_mod.q_stopping; });
+    }
+    if (g_mod.q_stopping) return -1;
+    const int32_t ci = g_mod.q_free[--g_mod.q_free_top];
+    ControlCmd & c = g_mod.cmds[(size_t)ci];
+    c.in_use = true;
+    c.done   = false;
+    c.result = 0;
+    c.deps   = 0;
+    c.pa_open = false;
+    c.seq    = g_mod.q_seq_next++;
+    return ci;
+}
+
+// enqueue + per-command CV 대기(구간 중 g_mod.mutex 무보유). 반환 = command 결과.
+int cq_submit_and_wait(int32_t ci) {
+    std::unique_lock<std::mutex> lk(g_mod.q_mutex);
+    ControlCmd & c = g_mod.cmds[(size_t)ci];
+    if (g_mod.q_stopping) { c.done = true; return -1; }
+    g_mod.q_ring[(size_t)((g_mod.q_head + g_mod.q_count) % MOE_DIRECT_CONTROL_Q_CAP)] = ci;
+    g_mod.q_count++;
+    if ((uint64_t)g_mod.q_count > g_mod.stat_q_max_depth.load(std::memory_order_relaxed))
+        g_mod.stat_q_max_depth.store((uint64_t)g_mod.q_count, std::memory_order_relaxed);
+    SetEvent(g_mod.command_event); // ★enqueue와 같은 mutex 아래(lost-wake 방지)
+    c.cv.wait(lk, [&c] { return c.done; });
+    return c.result;
+}
+
+void cq_free(int32_t ci) {
+    std::lock_guard<std::mutex> lk(g_mod.q_mutex);
+    g_mod.cmds[(size_t)ci].in_use = false;
+    g_mod.q_free[g_mod.q_free_top++] = ci;
+    g_mod.q_free_cv.notify_one();
+}
+
+// ── control_q(dispatcher 측) ───────────────────────────────────────────────
+// 다음 command 1건 조회(pop 아님). 큐가 비면 같은 mutex 아래에서 ResetEvent 후 -1.
+int32_t disp_peek() {
+    std::lock_guard<std::mutex> lk(g_mod.q_mutex);
+    if (g_mod.q_count == 0) {
+        // ★R1 #2 ① lost-wake — command_event 는 intent enqueue(worker)도 신호한다. 그래서
+        //   command 큐가 비었더라도 **intent_q 공백까지 같은 임계 구간에서 확인**한 뒤에만
+        //   내린다(락 순서 q_mutex → int_mu 단방향 — PB는 q_mutex를 잡지 않는다).
+        // ★★정지 신호 보존(R2 후속 근인 수리) — `dispatcher_stop_and_join`은 q_stopping을 세우고
+        //   SetEvent(command_event)를 **단 1회** 보낸 뒤 무한 join 한다. 그 신호가 이 자리에서
+        //   지워지면(디스패처가 pass 진입 시 읽은 stopping 은 아직 false) 그 pass 는 graceful 평가를
+        //   건너뛴 채 INFINITE 대기로 들어가고, 깨울 신호원이 영영 없어 **전 스레드 idle 교착**이
+        //   된다(실측 16% 간헐·정지 지점 무작위). manual-reset 이벤트를 서 있는 채로 두면 다음
+        //   pass 가 즉시 재개돼 stopping 을 재평가한다.
+        // ★★보완 ①(Codex R1-후속 CONFIRMED) — intent 생산자 lost-wake. `intent_depth()==0`
+        //   확인과 `ResetEvent`가 **int_mu 단일 임계구간이 아니다**: 그 사이에 worker 가
+        //   enqueue+SetEvent 하면 여기서 신호를 지워버리고, admission 은 pass 0 에서만 돌므로
+        //   dispatcher 가 정상 운전 INFINITE 대기로 들어가 intent 가 다음 demand command 까지
+        //   정체된다(프리페치 ON 실기동 liveness). reset 직후 **재확인해 재무장**하면 창이 닫힌다:
+        //     · reset 이전 enqueue  → 재확인이 depth!=0 을 보고 SetEvent 로 복구
+        //     · 재확인 이후 enqueue → worker 자신의 SetEvent 가 살아 있다
+        if (!g_mod.q_stopping && ggml_moe_phaseb_intent_depth() == 0) {
+            ResetEvent(g_mod.command_event);
+            if (ggml_moe_phaseb_intent_depth() != 0) SetEvent(g_mod.command_event);
+        }
+        return -1;
+    }
+    return g_mod.q_ring[(size_t)g_mod.q_head];
+}
+
+void disp_pop() {
+    std::lock_guard<std::mutex> lk(g_mod.q_mutex);
+    g_mod.q_head = (g_mod.q_head + 1) % MOE_DIRECT_CONTROL_Q_CAP;
+    g_mod.q_count--;
+}
+
+// command terminal — 결과 확정 + 대기 생산자 기상(dispatcher가 g_mod.mutex 보유 상태로 호출).
+void disp_complete(int32_t ci, int rc) {
+    std::lock_guard<std::mutex> lk(g_mod.q_mutex);
+    ControlCmd & c = g_mod.cmds[(size_t)ci];
+    if (c.done) return;
+    c.result = rc;
+    c.done   = true;
+    c.cv.notify_one();
+}
+
+// ── pending 풀 ─────────────────────────────────────────────────────────────
+void pio_reset(PendingIo & op) {
+    op.m = BatchMiss();
+    op.mlpos = -1;
+    op.phase = Phase::DECODE;
+    op.origin = PIO_ORIGIN_DEMAND;
+    op.state = PIO_CLAIMED;
+    op.channel = -1;
+    op.request_identity = 0;
+    op.intent_seq = GGML_MOE_PHASEB_NA_U64;
+    op.retry_of = -1;
+    op.in_use = false;
+    op.waiters.clear(); // capacity 유지(정상 운전 중 재할당 0)
+    // ★R1 #1 — B2 확장 필드 전건 초기화. pending 풀은 고정 인덱스 재사용이므로 하나라도
+    //   남으면 앞 op(joined prefetch·retry)의 래치·epoch·io 인덱스가 다음 op으로 새어
+    //   pb_io/digest/used 삼분할이 오염된다(같은 index를 joined→prefetch→retry→demand 순으로
+    //   돌리면 즉시 재현 — 픽스처 P12).
+    op.pb_request_epoch      = GGML_MOE_PHASEB_NA_U32;
+    op.pb_graph_epoch        = GGML_MOE_PHASEB_NA_U32;
+    op.pb_graph_seq          = GGML_MOE_PHASEB_NA_U32;
+    op.pb_join_request_epoch = GGML_MOE_PHASEB_NA_U32;
+    op.pb_join_graph_epoch   = GGML_MOE_PHASEB_NA_U32;
+    op.pb_join_graph_seq     = GGML_MOE_PHASEB_NA_U32;
+    op.pb_join_cmd           = -1;
+    op.pb_rank               = GGML_MOE_PHASEB_NA_U16;
+    op.pb_io_index           = -1;
+    op.pb_submit_event_seq   = GGML_MOE_PHASEB_NA_U64;
+    op.pb_retry_of_event_seq = GGML_MOE_PHASEB_NA_U64;
+    op.pb_is_retry           = false;
+    op.pb_ever_joined        = false;
+    op.pb_blocked_start      = 0;
+}
+
+int32_t pio_alloc_locked() {
+    if (g_mod.pending_free.empty()) return -1;
+    const int32_t i = g_mod.pending_free.back();
+    g_mod.pending_free.pop_back();
+    pio_reset(g_mod.pending_ops[(size_t)i]);
+    g_mod.pending_ops[(size_t)i].in_use = true;
+    return i;
+}
+
+void pio_release_locked(int32_t i) {
+    pio_reset(g_mod.pending_ops[(size_t)i]);
+    g_mod.pending_free.push_back(i);
+}
+
+// terminal 1건(SPEC_PHASEB_WIRE §5.2 닫힌 enum).
+//   1 SUCCESS_PUBLISHED   = lease 반영→publish→dependency 감소→signal
+//   2 ERROR_UNPUBLISHED   = 오류/부분 read(§5 — speculative=fail-soft unpublish / joined=단일 retry)
+//   3 CANCELLED_UNPUBLISHED / 4 CANCEL_SUCCESS_UNPUBLISHED = shutdown·abort 경로(★publish 금지)
+void disp_op_terminal_locked(int32_t oi, DWORD bytes, bool was_pending, uint8_t status) {
+    PendingIo & op = g_mod.pending_ops[(size_t)oi];
+    op.state = PIO_TERMINAL;
+    // ★테스트 전용 one-shot — prefetch 성공 terminal 1건을 부분 read/오류로 강등(§5 픽스처 ④).
+    if (g_mod.test_pb_error_next && op.origin == PIO_ORIGIN_PREFETCH &&
+        status == GGML_MOE_PB_T_SUCCESS_PUBLISHED) {
+        g_mod.test_pb_error_next = 0;
+        status = GGML_MOE_PB_T_ERROR_UNPUBLISHED;
+    }
+    const bool ok         = (status == GGML_MOE_PB_T_SUCCESS_PUBLISHED);
+    const bool had_waiter = !op.waiters.empty();
+    const bool prefetch   = (op.origin == PIO_ORIGIN_PREFETCH);
+    const bool submitted  = (op.pb_submit_event_seq != GGML_MOE_PHASEB_NA_U64);
+
+    // ── in-flight 회계 + terminal 사건 순번(§5.1 공용 namespace) ──
+    //   ★publish_seq 는 성공 terminal에서만 발급되므로 여기서 미리 정한다(core에 전달).
+    const uint64_t pseq = ok ? (++g_mod.pb_publish_seq) : (uint64_t)0;
+    if (submitted) {
+        pb_note_terminal_locked(op.pb_io_index, op.origin, status, had_waiter,
+                                op.pb_ever_joined, pseq);
+    }
+
+    if (ok) {
+        io_finish_locked(op.m, bytes, was_pending, op.mlpos, op.phase, op.origin);
+        Slot & s = g_mod.slots[(size_t)op.m.slot];
+        // ★R1 (a) 선행 의무(HANDOFF durable) — persistent join이 갱신한 op tick을 슬롯에 재반영한다.
+        //   join은 C2에 따라 slot lease/last_used를 건드리지 않으므로, 여기서 반영하지 않으면
+        //   join된 record의 LRU가 claim 시점 tick에 고정돼 victim 순서가 뒤집힌다.
+        s.last_used = op.m.logical_last_tick;
+        if (had_waiter) {
+            // waiter 有 publish → READY_DEMAND(io_finish_locked 기본값 그대로).
+            pb_transition_locked(GGML_MOE_PB_EV_PUBLISH_DEMAND, op.m.record_idx, op.m.slot,
+                                 op.m.generation, op.intent_seq);
+        } else {
+            // waiter 無 publish → READY_PROBATION(§4 상태기계).
+            s.cache_class       = GGML_MOE_PB_CLASS_PROBATION;
+            s.pf_intent_ordinal = op.intent_seq;
+            s.pf_rank           = op.pb_rank;              // ★R1 #7 비교 키 rank 성분
+            s.pf_io_index       = op.pb_io_index;
+            pb_transition_locked(GGML_MOE_PB_EV_PUBLISH_PROBATION, op.m.record_idx, op.m.slot,
+                                 op.m.generation, op.intent_seq);
+        }
+    } else {
+        if (status != GGML_MOE_PB_T_ERROR_UNPUBLISHED) g_mod.stat_abort_terminal++;
+        if (op.origin == PIO_ORIGIN_DEMAND && ggml_moe_trace_enabled()) {
+            ggml_moe_trace_io_complete(op.m.trace_op_id, MOE_TRACE_IO_STATUS_ERROR, (uint32_t)bytes,
+                                       was_pending, (uint32_t)op.m.slot);
+            ggml_moe_trace_data_wait_end(op.m.trace_wait_episode);
+        }
+        // ★joined(waiter 있음) 오류/부분 read = **단 하나의 새 generation retry**(§5·C2).
+        //   waiter·multiplicity·마지막 demand_tick을 이전하고 구 슬롯 lease는 0을 유지한다
+        //   (lease는 성공 terminal에서만 반영되므로 구조적으로 0이다). retry의 retry는 없다.
+        if (status == GGML_MOE_PB_T_ERROR_UNPUBLISHED && had_waiter && !op.pb_is_retry) {
+            const int32_t ri = pio_alloc_locked();
+            // ★R1 #9 ① — retry 슬롯 확보 실패는 fail-soft가 아니다(§5 "retry 실패 시에만 기존
+            //   fail-stop"): waiter가 붙은 오류를 조용히 error 종결하면 계약 위반이다.
+            if (ri < 0) fatal_abort("cannot reserve a pending slot to retry a joined error (fail-stop) record=%lld",
+                                    (long long)op.m.record_idx);
+            {
+                Slot & sr = g_mod.slots[(size_t)op.m.slot];
+                PendingIo & r = g_mod.pending_ops[(size_t)ri];
+                r.m       = op.m;
+                r.m.generation = sr.generation.fetch_add(1, std::memory_order_relaxed) + 1;
+                r.mlpos   = op.mlpos;
+                r.phase   = op.phase;
+                r.origin  = PIO_ORIGIN_DEMAND;   // ★최종 3분할상 demand-read(R1 #7)
+                r.state   = PIO_CLAIMED;
+                r.channel = -1;
+                r.request_identity = op.request_identity;
+                // ★R1 #9 ③ — retry는 demand-origin 사건이므로 intent 상관자는 NA다.
+                r.intent_seq       = GGML_MOE_PHASEB_NA_U64;
+                r.retry_of         = oi;
+                r.waiters          = op.waiters;
+                // ★R1 #9 ② — owner epoch = **첫 waiter의 demand epoch**(원 prefetch 값 복사 금지).
+                r.pb_request_epoch = op.pb_join_request_epoch != GGML_MOE_PHASEB_NA_U32
+                                     ? op.pb_join_request_epoch : op.pb_request_epoch;
+                r.pb_graph_epoch   = op.pb_join_graph_epoch != GGML_MOE_PHASEB_NA_U32
+                                     ? op.pb_join_graph_epoch : op.pb_graph_epoch;
+                r.pb_graph_seq     = op.pb_join_graph_seq != GGML_MOE_PHASEB_NA_U32
+                                     ? op.pb_join_graph_seq : op.pb_graph_seq;
+                r.pb_rank          = GGML_MOE_PHASEB_NA_U16;
+                r.pb_is_retry      = true;
+                r.pb_retry_of_event_seq = op.pb_submit_event_seq;
+                r.pb_ever_joined   = op.pb_ever_joined;
+                sr.cache_class = GGML_MOE_PB_CLASS_NONE;
+                sr.pf_intent_ordinal = GGML_MOE_PHASEB_NA_U64;
+                sr.pf_rank = GGML_MOE_PHASEB_NA_U16;
+                sr.pf_io_index = -1;
+                g_mod.pending_by_record[(size_t)op.m.record_idx] = ri;
+                g_mod.submit_q.push_back(ri);
+                // 3분할 최종 처분 이동: join 실패 후 retry = demand_read(§6.1).
+                for (int32_t ci : op.waiters) {
+                    ControlCmd & c = g_mod.cmds[(size_t)ci];
+                    uint32_t moved = 0;
+                    for (size_t k = 0; k < c.req_join_op.size(); k++)
+                        if (c.req_join_op[k] == oi) { c.req_join_op[k] = -1; moved++; }
+                    if (moved > c.sp_join) moved = c.sp_join;
+                    c.sp_join -= moved;
+                    c.sp_demand_read += moved;
+                }
+                // ★R1 #9 ④ — PA batch_order 는 첫 waiter command 의 별도 순번(원 op 값 재사용 금지).
+                if (op.pb_join_cmd >= 0 && op.pb_join_cmd < MOE_DIRECT_CONTROL_Q_CAP) {
+                    ControlCmd & jc = g_mod.cmds[(size_t)op.pb_join_cmd];
+                    r.m.pa_batch_order = jc.pa_batch_next++;
+                    // ★R1 #9 ⑤ — PA events 의 n_miss/miss_bytes 는 "이 acquire 가 유발한 demand
+                    //   read op 수"여야 PA ops 레코드와 1:1이 유지된다(SPEC_PHASEB_WIRE §11-a가
+                    //   retry 포함 전건 1:1을 요구하고, retry 는 io_finish 에서 PA ops 를 낸다).
+                    //   따라서 retry 1건을 n_miss/bytes 에 가산한다.
+                    // ★PA n_miss 의미(R2 권고 2): "이 acquire 가 유발한 demand read op 수".
+                    //   joined-success = 0 가산(물리 제출이 없다) · 첫 waiter 소유 retry = 1 가산.
+                    jc.pa_n_miss += 1;
+                    jc.pa_bytes  += g_mod.layers[(size_t)op.mlpos].stride_bytes;
+                }
+                ggml_moe_phaseb_count(GGML_MOE_PB_C_PREFETCH_RETRY, r.pb_request_epoch, 1);
+                pb_transition_locked(GGML_MOE_PB_EV_RETRY_ISSUE, r.m.record_idx, r.m.slot,
+                                     r.m.generation, GGML_MOE_PHASEB_NA_U64);
+                pio_release_locked(oi);
+                return;   // ★waiter는 깨우지 않는다(retry가 결과를 공유)
+            }
+        }
+        // 슬롯을 ABSENT로 되돌린다(구 owner는 claim에서 이미 unpublish·새 record는 미publish).
+        Slot & s = g_mod.slots[(size_t)op.m.slot];
+        if (s.owner_record == op.m.record_idx) s.owner_record = -1;
+        s.cache_class       = GGML_MOE_PB_CLASS_NONE;
+        s.pf_intent_ordinal = GGML_MOE_PHASEB_NA_U64;
+        s.pf_rank           = GGML_MOE_PHASEB_NA_U16;
+        s.pf_io_index       = -1;
+        if (status == GGML_MOE_PB_T_ERROR_UNPUBLISHED) {
+            if (prefetch) ggml_moe_phaseb_count(GGML_MOE_PB_C_PREFETCH_ERROR_UNPUBLISH, op.pb_request_epoch, 1);
+            pb_transition_locked(GGML_MOE_PB_EV_UNPUBLISH_ERROR, op.m.record_idx, op.m.slot,
+                                 op.m.generation, op.intent_seq);
+        } else {
+            pb_transition_locked(GGML_MOE_PB_EV_CANCEL, op.m.record_idx, op.m.slot,
+                                 op.m.generation, op.intent_seq);
+        }
+    }
+    // ★cancel 완료 확인 후에만 pin 해제(slot 재사용 금지 구간의 끝).
+    if (op.m.slot >= 0 && op.m.slot < (int32_t)g_mod.slot_pending.size()) g_mod.slot_pending[(size_t)op.m.slot] = 0;
+    if (op.m.record_idx >= 0 && op.m.record_idx < (int64_t)g_mod.pending_by_record.size() &&
+        g_mod.pending_by_record[(size_t)op.m.record_idx] == oi) {
+        g_mod.pending_by_record[(size_t)op.m.record_idx] = -1;
+    }
+    // dependency 감소 → 전 required가 준비된 command만 signal.
+    for (int32_t ci : op.waiters) {
+        ControlCmd & c = g_mod.cmds[(size_t)ci];
+        if (!ok) {
+            if (c.deps == 0) continue; // 이미 종결된 command(다른 op의 abort로 error 처리됨)
+            if (c.pa_open) { ggml_moe_phasea_acquire_exit(c.pa_n_miss, c.pa_bytes, ggml_moe_phasea_now_qpc()); c.pa_open = false; }
+            c.deps = 0;
+            pb_finish_demand_command_locked(c);
+            g_mod.demand_outstanding--;
+            disp_complete(ci, -1);
+            continue;
+        }
+        if (--c.deps == 0) {
+            // ★Phase A R_j — demand record 전부 host 가용.
+            if (c.pa_open) { ggml_moe_phasea_acquire_exit(c.pa_n_miss, c.pa_bytes, ggml_moe_phasea_now_qpc()); c.pa_open = false; }
+            // ★§7.5 predictor 노출 조인 재료 — 이 층의 demand R 시각.
+            ggml_moe_phaseb_note_demand_ready(c.pb_graph_seq,
+                                              c.mlpos >= 0 && c.mlpos < (int32_t)g_mod.moe_layers.size()
+                                                  ? g_mod.moe_layers[(size_t)c.mlpos] : -1,
+                                              ggml_moe_phaseb_now_qpc());
+            pb_finish_demand_command_locked(c);
+            g_mod.demand_outstanding--;
+            metrics_maybe_periodic_locked();
+            disp_complete(ci, 0);
+        }
+    }
+    pio_release_locked(oi);
+}
+
+// ★B2 — 성공 제출 1건의 계측(§5·§5.1·§6·§8). io_submit_locked가 성공(pending/sync 무관)한
+//   직후에만 호출된다. SUBMIT_FAILED는 여기 오지 않는다(pb_io 미기록 계약).
+void pb_on_submit_locked(PendingIo & op) {
+    // ★R1 #6 ① — 계측 본문은 공용 core(pb_note_submit_locked) 하나뿐이다.
+    op.pb_io_index = pb_note_submit_locked(
+        op.m.record_idx, op.mlpos, op.m.file_offset, op.m.slot, op.m.generation, op.origin,
+        op.pb_rank, op.intent_seq, op.pb_request_epoch, op.pb_graph_seq,
+        op.phase == Phase::PREFILL, op.pb_is_retry, op.pb_retry_of_event_seq,
+        &op.pb_submit_event_seq);
+}
+
+// rank 처분 기록(§4.2 · §8 disposition digest · §6 카운터) — 사전 처분/admission/issued 공통.
+void pb_dispose_rank_locked(int32_t row, uint64_t intent_ordinal, uint16_t rank, uint8_t disp,
+                            uint32_t request_epoch) {
+    if (row >= 0 && row < (int32_t)g_mod.pb_samples.size() && rank < GGML_MOE_PHASEB_TOPK)
+        g_mod.pb_samples[(size_t)row].rank_disposition[rank] = disp;
+    ggml_moe_phaseb_digest_disposition(intent_ordinal, rank, disp);
+    static const int32_t kCtr[10] = {
+        -1,
+        GGML_MOE_PB_C_PRE_DROPPED_TOO_LATE, GGML_MOE_PB_C_PRE_DROPPED_STALE,
+        GGML_MOE_PB_C_PRE_SKIPPED_RESIDENT, GGML_MOE_PB_C_PRE_SKIPPED_PENDING,
+        GGML_MOE_PB_C_DROPPED_NO_SLOT_QD,   GGML_MOE_PB_C_DROPPED_PREFETCH_CAP,
+        GGML_MOE_PB_C_DROPPED_RESERVE,      GGML_MOE_PB_C_ISSUED, GGML_MOE_PB_C_SUBMIT_FAILED,
+    };
+    if (disp >= 1 && disp <= 9 && kCtr[disp] >= 0)
+        ggml_moe_phaseb_count(kCtr[disp], request_epoch, 1);
+}
+
+// 제출 pump — 자유 채널이 있는 동안 submit_q FIFO 순으로 제출(= 유니크 miss 첫 출현 순).
+// 반환 true = 이 pass에서 제출/회수 활동이 있었다.
+bool disp_pump_locked() {
+    bool progressed = false;
+    const bool pa_on = g_mod.phasea_on;
+
+    while (g_mod.submit_head < g_mod.submit_q.size()) {
+        int32_t ci_free = -1;
+        for (size_t i = 0; i < g_mod.channels.size(); i++) if (!g_mod.channels[i].busy) { ci_free = (int32_t)i; break; }
+        if (ci_free < 0) {
+            // ★demand_blocked_by_prefetch(§6) — "총 QD 만석 ∧ prefetch_inflight>0"으로 대기 시작.
+            const int32_t oi_head = g_mod.submit_q[g_mod.submit_head];
+            PendingIo & head = g_mod.pending_ops[(size_t)oi_head];
+            if (head.origin == PIO_ORIGIN_DEMAND && g_mod.pb_inflight_prefetch > 0 &&
+                head.pb_blocked_start == 0) {
+                head.pb_blocked_start = ggml_moe_phaseb_now_qpc();
+            }
+            break;
+        }
+        const int32_t oi = g_mod.submit_q[g_mod.submit_head++];
+        PendingIo & op = g_mod.pending_ops[(size_t)oi];
+        const bool prefetch = (op.origin == PIO_ORIGIN_PREFETCH);
+        IoChannel & ch = g_mod.channels[(size_t)ci_free];
+        ch.op_index = oi;
+        op.channel  = ci_free;
+        op.state    = PIO_SUBMITTED;
+        progressed  = true;
+        // ★blocked 구간 마감 — 이 demand op이 대기했다면 그 µs를 자기 행에 귀속한다.
+        if (op.pb_blocked_start != 0) {
+            const uint64_t d = ggml_moe_phaseb_now_qpc() - op.pb_blocked_start;
+            const uint64_t us = pb_qpc_to_us(d);
+            const uint64_t key = pb_row_key(op.pb_graph_seq,
+                                            (uint16_t)g_mod.moe_layers[(size_t)op.mlpos]);
+            auto it = g_mod.pb_sample_index.find(key);
+            if (it != g_mod.pb_sample_index.end()) {
+                ggml_moe_phaseb_sample & s = g_mod.pb_samples[(size_t)it->second];
+                s.blocked_us += (uint32_t)us;
+                s.blocked_count++;
+            }
+            ggml_moe_phaseb_count_blocked(op.pb_request_epoch, us, 1);
+            op.pb_blocked_start = 0;
+        }
+        const int rc = io_submit_locked(op.m, ch, op.mlpos, op.m.pa_batch_order, op.origin,
+                                        /*fail_soft=*/prefetch);
+        if (rc < 0) {
+            // ★prefetch fail-soft(§5·§6 pb_submit_failed) — slot 원복·unclaim·pb_io 미기록.
+            ch.op_index = -1;
+            op.channel  = -1;
+            Slot & s = g_mod.slots[(size_t)op.m.slot];
+            if (s.owner_record == op.m.record_idx) s.owner_record = -1;
+            s.cache_class = GGML_MOE_PB_CLASS_NONE;
+            s.pf_intent_ordinal = GGML_MOE_PHASEB_NA_U64;
+            s.pf_rank = GGML_MOE_PHASEB_NA_U16;
+            s.pf_io_index = -1;
+            g_mod.slot_pending[(size_t)op.m.slot] = 0;
+            if (op.m.record_idx >= 0 && g_mod.pending_by_record[(size_t)op.m.record_idx] == oi)
+                g_mod.pending_by_record[(size_t)op.m.record_idx] = -1;
+            pb_dispose_rank_locked(pb_find_row_locked(op.pb_graph_seq, op.mlpos), op.intent_seq,
+                                   op.pb_rank, GGML_MOE_PB_D_SUBMIT_FAILED, op.pb_request_epoch);
+            pio_release_locked(oi);
+            continue;
+        }
+        pb_on_submit_locked(op);
+        if (rc == 0 && op.pb_io_index >= 0) g_mod.pb_ios[(size_t)op.pb_io_index].flags |= 0x01; // pending
+        if (prefetch)
+            pb_dispose_rank_locked(pb_find_row_locked(op.pb_graph_seq, op.mlpos), op.intent_seq,
+                                   op.pb_rank, GGML_MOE_PB_D_ISSUED, op.pb_request_epoch);
+        bool sync_done = (rc == 1);
+        // ★selftest 전용 one-shot 강제 경로 — ReadFile TRUE(즉시 완료)는 ReadFile API 계약상
+        //   실도달 경로지만 저장 구성에 따라 재현되지 않는다(이 기기: NVMe+NO_BUFFERING에서
+        //   immediate=0). armed면 완료를 그 자리에서 기다린 뒤 **아래 sync_done 분기 코드를
+        //   그대로** 통과시켜 그 분기의 이벤트 규율을 회귀로 잠근다. 프로덕션은 항상 OFF.
+        if (!sync_done && g_mod.test_force_sync_next) {
+            g_mod.test_force_sync_next = 0; // one-shot
+            WaitForSingleObject(ch.ev, INFINITE);
+            sync_done = true;
+        }
+        if (sync_done) {
+            // ★동기 완료도 submit→terminal 계측 전량(§2) — 그 자리에서 회수.
+            DWORD n = 0;
+            if (!GetOverlappedResult(g_mod.data_file, &ch.ov, &n, TRUE))
+                fatal_abort("GetOverlappedResult failed err=%lu offset=%llu",
+                            (unsigned long)GetLastError(), (unsigned long long)op.m.file_offset);
+            // ★동기 완료도 커널이 event를 signaled로 올린다. idle 채널의 ev도 고정 wait 배열
+            //   (handle 1..QD)에 있으므로 여기서 내리지 않으면 WaitForMultipleObjects가 즉시
+            //   반환하는 무한 hot-loop가 된다 — async retire와 대칭으로 idle 전환 전에 내린다.
+            ResetEvent(ch.ev);
+            ch.busy = false;
+            ch.op_index = -1;
+            g_mod.stat_sync_terminal++;
+            const bool bytes_ok = (n == (DWORD)g_mod.layers[(size_t)op.mlpos].stride_bytes);
+            disp_op_terminal_locked(oi, n, /*was_pending=*/false,
+                                    (bytes_ok || !prefetch) ? GGML_MOE_PB_T_SUCCESS_PUBLISHED
+                                                            : GGML_MOE_PB_T_ERROR_UNPUBLISHED);
+        }
+    }
+    if (g_mod.submit_head >= g_mod.submit_q.size() && !g_mod.submit_q.empty()) {
+        g_mod.submit_q.clear();
+        g_mod.submit_head = 0;
+    }
+    // ★PA io_qd 피드는 demand-origin outstanding만 계수한다(§2.3 스코프 보존).
+    if (progressed && pa_on) ggml_moe_phasea_io_qd(g_mod.pb_inflight_demand, ggml_moe_phasea_now_qpc());
+    return progressed;
+}
+
+// signaled 채널을 **channel index 순**으로 회수(완료 순서 무관 — 최종 상태 결정론 보존).
+bool disp_retire_signaled_locked() {
+    bool progressed = false;
+    const bool pa_on = g_mod.phasea_on;
+    if (g_mod.test_hold_retire) return false;   // ★테스트 전용 — in-flight 고정(픽스처 창구)
+    for (size_t i = 0; i < g_mod.channels.size(); i++) {
+        IoChannel & ch = g_mod.channels[i];
+        if (!ch.busy) continue;
+        if (WaitForSingleObject(ch.ev, 0) != WAIT_OBJECT_0) continue;
+        const int32_t oi = ch.op_index;
+        PendingIo & op = g_mod.pending_ops[(size_t)oi];
+        const bool prefetch = (op.origin == PIO_ORIGIN_PREFETCH);
+        DWORD n = 0;
+        const BOOL gok = GetOverlappedResult(g_mod.data_file, &ch.ov, &n, TRUE);
+        if (!gok && !prefetch)
+            fatal_abort("GetOverlappedResult failed err=%lu", (unsigned long)GetLastError());
+        // ★prefetch 오류/부분 read = fail-soft(§5) — terminal 판정은 GetOverlappedResult 결과로만.
+        const bool bytes_ok = gok && (n == (DWORD)g_mod.layers[(size_t)op.mlpos].stride_bytes);
+        ch.busy = false;
+        ch.op_index = -1;
+        ResetEvent(ch.ev);
+        disp_op_terminal_locked(oi, n, /*was_pending=*/true,
+                                (prefetch && !bytes_ok) ? GGML_MOE_PB_T_ERROR_UNPUBLISHED
+                                                        : GGML_MOE_PB_T_SUCCESS_PUBLISHED);
+        progressed = true;
+        // ★PA io_qd 피드 = demand-origin outstanding만(§2.3).
+        if (pa_on) ggml_moe_phasea_io_qd(g_mod.pb_inflight_demand, ggml_moe_phasea_now_qpc());
+    }
+    return progressed;
+}
+
+// ★R1 #3 ③ — graceful 경로: demand drain 완료 후 잔여 **prefetch-origin** in-flight만
+//   CancelIoEx → terminal 회수한다(§0.1 CUT ⑤ "잔여 speculative CancelIoEx → 전 채널 terminal
+//   회수"). demand는 여기 오지 않는다(③에서 이미 종결).
+bool disp_cancel_prefetch_inflight_locked() {
+    bool any = false;
+    // ★R2 #2 — waiter(joined demand) 가 붙은 op 은 **취소 금지**다: 그 demand 는 이 op 의
+    //   결과를 기다리는 정상 요청이므로 완료까지 대기해야 한다(speculative = waiter 無 만 취소 대상).
+    auto cancelable = [](const IoChannel & ch) {
+        if (!ch.busy || ch.op_index < 0) return false;
+        const PendingIo & op = g_mod.pending_ops[(size_t)ch.op_index];
+        return op.origin == PIO_ORIGIN_PREFETCH && op.waiters.empty();
+    };
+    for (auto & ch : g_mod.channels) {
+        if (!cancelable(ch)) continue;
+        g_mod.stat_cancel++;
+        CancelIoEx(g_mod.data_file, &ch.ov);
+        any = true;
+    }
+    if (!any) return false;
+    for (auto & ch : g_mod.channels) {
+        if (!cancelable(ch)) continue;
+        DWORD n = 0;
+        const BOOL ok = GetOverlappedResult(g_mod.data_file, &ch.ov, &n, TRUE);
+        const DWORD e = ok ? 0 : GetLastError();
+        if (!ok && e != ERROR_OPERATION_ABORTED)
+            fatal_abort("prefetch cancel drain GetOverlappedResult failed err=%lu", (unsigned long)e);
+        const int32_t oi = ch.op_index;
+        ch.busy = false;
+        ch.op_index = -1;
+        ResetEvent(ch.ev);
+        // ★success-after-cancel 도 publish 금지(§2 종료 시퀀스).
+        disp_op_terminal_locked(oi, n, /*was_pending=*/true,
+                                ok ? GGML_MOE_PB_T_CANCEL_SUCCESS_UNPUB
+                                   : GGML_MOE_PB_T_CANCELLED_UNPUBLISHED);
+    }
+    return true;
+}
+
+// abort 종료 — 잔여 in-flight를 CancelIoEx하고 **terminal까지 회수**한 뒤(CancelIoEx 성공 반환
+// ≠ terminal — GetOverlappedResult의 ERROR_OPERATION_ABORTED까지 drain) 전 waiter를 error로 깨운다.
+// ★shutdown/abort 중 success-after-cancel도 publish하지 않고 ABSENT로 종결한다(§2).
+void disp_abort_inflight_locked() {
+    for (auto & ch : g_mod.channels) {
+        if (!ch.busy) continue;
+        g_mod.stat_cancel++;
+        CancelIoEx(g_mod.data_file, &ch.ov);
+    }
+    for (auto & ch : g_mod.channels) {
+        if (!ch.busy) continue;
+        DWORD n = 0;
+        const BOOL ok = GetOverlappedResult(g_mod.data_file, &ch.ov, &n, TRUE);
+        const DWORD e = ok ? 0 : GetLastError();
+        if (!ok && e != ERROR_OPERATION_ABORTED)
+            fatal_abort("cancel drain GetOverlappedResult failed err=%lu", (unsigned long)e);
+        const int32_t oi = ch.op_index;
+        ch.busy = false;
+        ch.op_index = -1;
+        ResetEvent(ch.ev);
+        // ★success-after-cancel도 publish 금지(§2 종료 시퀀스) — status 4로 구분 기록한다.
+        disp_op_terminal_locked(oi, n, /*was_pending=*/true,
+                                ok ? GGML_MOE_PB_T_CANCEL_SUCCESS_UNPUB
+                                   : GGML_MOE_PB_T_CANCELLED_UNPUBLISHED);
+    }
+    // 미제출(claimed) op도 전부 abort terminal로 종결.
+    while (g_mod.submit_head < g_mod.submit_q.size()) {
+        const int32_t oi = g_mod.submit_q[g_mod.submit_head++];
+        disp_op_terminal_locked(oi, 0, /*was_pending=*/false, GGML_MOE_PB_T_CANCELLED_UNPUBLISHED);
+    }
+    g_mod.submit_q.clear();
+    g_mod.submit_head = 0;
+}
+
+// demand 계획 가능 여부 — ★PA on일 때는 acquire_enter/exit 문맥이 1개뿐이라(ggml-moe-phasea.h
+// 동시성 계약) 동시 계획을 금지한다. pending 풀이 모자라도 다음 terminal까지 미룬다.
+bool disp_can_plan_demand(int32_t n_ids) {
+    if (g_mod.phasea_on && g_mod.demand_outstanding > 0) return false;
+    if ((int32_t)g_mod.pending_free.size() < n_ids)      return false;
+    return true;
+}
+
+void disp_handle_demand_locked(int32_t ci) {
+    ControlCmd & c = g_mod.cmds[(size_t)ci];
+    g_mod.stat_demand_cmd++;
+    const bool pa_on = g_mod.phasea_on;
+    // ★B2 — dispatcher가 인지하는 "현재 epoch"(사전 처분 stale/too_late 판정 기준).
+    g_mod.pb_cur_graph_seq = c.pb_graph_seq;
+    DemandPlan & p = g_mod.disp_plan;
+    const int rc = plan_demand_locked(p, c.mlpos, c.part_idx, c.ids.data(), c.n_ids, c.phase,
+                                      pa_on, c.pa_t_enter, /*persistent=*/true,
+                                      c.pb_request_epoch, c.pb_graph_epoch, c.pb_graph_seq, ci);
+    if (rc != 0) {
+        // ★admission reserve ③이 지키는 불변식 — 이 값은 0이어야 한다(§6 pb_demand_preflight_reject).
+        ggml_moe_phaseb_count(GGML_MOE_PB_C_DEMAND_PREFLIGHT_REJECT, c.pb_request_epoch, 1);
+        disp_complete(ci, -1);
+        return;
+    }
+
+    const LayerInfo & L = g_mod.layers[(size_t)c.mlpos];
+    c.pa_n_miss = (int32_t)p.miss.size();
+    c.pa_bytes  = (uint64_t)p.miss.size() * L.stride_bytes;
+    c.pa_batch_next = (uint32_t)p.miss.size();   // ★R1 #9 ④ retry 순번은 여기서 이어진다
+    c.pa_open   = pa_on;
+    c.deps      = 0;
+    g_mod.demand_outstanding++;
+
+    // ── ★B2 배타 3분할(§4·§6.1) — 요청 인덱스별로 ready|join|demand_read 중 정확히 하나 ──
+    c.sp_ready = c.sp_join = c.sp_demand_read = c.sp_join_attempt = 0;
+    c.req_join_op.assign((size_t)c.n_ids, -1);
+    for (int32_t i = 0; i < c.n_ids; i++) {
+        if (p.hit_slot[(size_t)i] >= 0)        c.sp_ready++;
+        else if (p.req_join[(size_t)i] >= 0) { c.sp_join++; c.sp_join_attempt++;
+                                               c.req_join_op[(size_t)i] = p.req_join[(size_t)i]; }
+        else                                   c.sp_demand_read++;
+    }
+    // pb_sample 행(§4) — per (graph, layer) 1개. 이 (graph,layer)의 **첫**(canonical) acquire만
+    // 3분할을 채운다(PA ledger canonical ACQ_CALL과 1:1 — §9 게이트 9-b).
+    // ★canonical 판정(= too_late 표식)은 **PB 모드와 무관**하게 먼저 확정한다(C4′).
+    c.pb_canonical = pb_mark_served_locked(c.pb_graph_seq, c.mlpos);
+    c.pb_row = -1;
+    if (c.pb_canonical) {
+        // ★NO_SOURCE(layer 0 demand 행)는 capture 훅이 낼 수 없는 사유라 여기서 계수한다.
+        if (c.phase != Phase::PREFILL && c.mlpos == 0)
+            ggml_moe_phaseb_count_skip(GGML_MOE_PB_SKIP_NO_SOURCE, c.pb_request_epoch);
+        const int32_t row = pb_row_locked(c.pb_graph_seq, c.pb_request_epoch, c.pb_graph_epoch,
+                                          c.mlpos, c.phase == Phase::PREFILL ? 1 : 0);
+        if (row >= 0) {
+            ggml_moe_phaseb_sample & s = g_mod.pb_samples[(size_t)row];
+            s.n_required     = (uint16_t)c.n_ids;
+            s.n_ready        = (uint16_t)c.sp_ready;
+            s.n_join         = (uint16_t)c.sp_join;
+            s.n_demand_read  = (uint16_t)c.sp_demand_read;
+            s.n_join_attempt = (uint16_t)c.sp_join_attempt;
+            c.pb_row = row;
+        }
+    }
+
+    // 새 유니크 miss → PendingIo 생성(첫 출현 순 = 제출 순 = ordered ReadFile digest 순).
+    for (size_t k = 0; k < p.miss.size(); k++) {
+        const int32_t oi = pio_alloc_locked();
+        if (oi < 0) fatal_abort("pending pool exhausted (disp_can_plan_demand invariant violated)");
+        PendingIo & op = g_mod.pending_ops[(size_t)oi];
+        op.m = p.miss[k];
+        op.m.pa_batch_order = (uint32_t)k;
+        op.mlpos  = c.mlpos;
+        op.phase  = c.phase;
+        op.origin = PIO_ORIGIN_DEMAND;
+        op.state  = PIO_CLAIMED;
+        op.request_identity = c.seq;
+        op.intent_seq = GGML_MOE_PHASEB_NA_U64;   // demand-origin = intent NA
+        op.retry_of   = -1;
+        op.pb_request_epoch = c.pb_request_epoch;
+        op.pb_graph_epoch   = c.pb_graph_epoch;
+        op.pb_graph_seq     = c.pb_graph_seq;
+        op.pb_rank          = GGML_MOE_PHASEB_NA_U16;
+        op.waiters.push_back(ci);
+        g_mod.pending_by_record[(size_t)op.m.record_idx] = oi;
+        g_mod.slot_pending[(size_t)op.m.slot] = 1;
+        g_mod.submit_q.push_back(oi);
+        c.deps++;
+    }
+    // in-flight join(C2) — 새 물리 제출 없음.
+    for (int32_t oi : p.join_ops) {
+        g_mod.pending_ops[(size_t)oi].waiters.push_back(ci);
+        g_mod.stat_join++;
+        c.deps++;
+    }
+
+    if (c.deps == 0) {
+        // 전건 hit — 반환 직후 ptr() 전건 유효(lease는 ④에서 이미 반영됨).
+        if (c.pa_open) { ggml_moe_phasea_acquire_exit(c.pa_n_miss, c.pa_bytes, ggml_moe_phasea_now_qpc()); c.pa_open = false; }
+        ggml_moe_phaseb_note_demand_ready(c.pb_graph_seq,
+                                          c.mlpos >= 0 && c.mlpos < (int32_t)g_mod.moe_layers.size()
+                                              ? g_mod.moe_layers[(size_t)c.mlpos] : -1,
+                                          ggml_moe_phaseb_now_qpc());
+        pb_finish_demand_command_locked(c);
+        g_mod.demand_outstanding--;
+        metrics_maybe_periodic_locked();
+        disp_complete(ci, 0);
+    }
+}
+
+void disp_handle_release_locked(int32_t ci) {
+    ControlCmd & c = g_mod.cmds[(size_t)ci];
+    g_mod.stat_release_cmd++;
+    const bool pa_on = g_mod.phasea_on;
+    if (pa_on) ggml_moe_phasea_release_enter(c.mlpos, c.part_idx, c.n_ids, ggml_moe_phasea_now_qpc());
+    for (int32_t i = 0; i < c.n_ids; i++) {
+        const int32_t eid = c.ids[(size_t)i];
+        if (eid < 0 || eid >= g_mod.n_expert) continue;
+        const int64_t record_idx = (int64_t)c.mlpos * g_mod.n_expert + eid;
+        RecordEntry & re = g_mod.record_table[(size_t)record_idx];
+        const int32_t si = re.slot_index.load(std::memory_order_relaxed);
+        if (si < 0) continue;
+        const int32_t prev = g_mod.slots[(size_t)si].lease.fetch_sub(1, std::memory_order_relaxed);
+        if (prev <= 0) g_mod.slots[(size_t)si].lease.fetch_add(1, std::memory_order_relaxed);
+        if (pa_on) ggml_moe_phasea_release_expert(eid, si, prev, prev > 0 ? prev - 1 : prev);
+    }
+    disp_complete(ci, 0); // ★동기 ack — 반환 전 lease 감소 완결
+}
+
+void disp_handle_query_locked(int32_t ci) {
+    ControlCmd & c = g_mod.cmds[(size_t)ci];
+    g_mod.stat_query_cmd++;
+    switch (c.qkind) {
+        case QK_ABSENT_COUNT: {
+            int32_t absent = 0;
+            if (g_mod.sealed && c.mlpos >= 0 && c.mlpos < (int32_t)g_mod.moe_layers.size()) {
+                for (int32_t i = 0; i < c.n_ids; i++) {
+                    const int32_t eid = c.ids[(size_t)i];
+                    if (eid < 0 || eid >= g_mod.n_expert) continue;
+                    const int64_t record_idx = (int64_t)c.mlpos * g_mod.n_expert + eid;
+                    const RecordEntry & re = g_mod.record_table[(size_t)record_idx];
+                    const int32_t si = re.slot_index.load(std::memory_order_relaxed);
+                    bool resident = false;
+                    if (si >= 0) {
+                        const Slot & s = g_mod.slots[(size_t)si];
+                        resident = s.generation.load(std::memory_order_relaxed) == re.slot_generation.load(std::memory_order_relaxed)
+                                && s.owner_record == record_idx;
+                    }
+                    if (!resident) absent++;
+                }
+            }
+            c.q_out_i32_a = absent;
+            break;
+        }
+        case QK_RECORD_SLOT: {
+            int32_t slot = -1; uint64_t gen = 0;
+            if (g_mod.sealed && c.q_arg_i64 >= 0 && c.q_arg_i64 < (int64_t)g_mod.record_table.size()) {
+                const RecordEntry & re = g_mod.record_table[(size_t)c.q_arg_i64];
+                slot = re.slot_index.load(std::memory_order_relaxed);
+                gen  = re.slot_generation.load(std::memory_order_relaxed);
+            }
+            c.q_out_i32_a = slot;
+            c.q_out_u64_a = gen;
+            break;
+        }
+        case QK_SLOT_STATE: {
+            int64_t owner = -1; uint64_t last_used = 0, gen = 0; int32_t lease = 0;
+            if (g_mod.sealed && c.q_arg_i32 >= 0 && c.q_arg_i32 < g_mod.n_slots) {
+                const Slot & s = g_mod.slots[(size_t)c.q_arg_i32];
+                owner = s.owner_record;
+                last_used = s.last_used;
+                gen = s.generation.load(std::memory_order_relaxed);
+                lease = s.lease.load(std::memory_order_relaxed);
+            }
+            c.q_out_i64   = owner;
+            c.q_out_u64_a = last_used;
+            c.q_out_u64_b = gen;
+            c.q_out_i32_a = lease;
+            break;
+        }
+        case QK_LEASE_STATS: {
+            int32_t leased = 0; int64_t total = 0;
+            for (const auto & s : g_mod.slots) {
+                const int32_t l = s.lease.load(std::memory_order_relaxed);
+                if (l > 0) { leased++; total += l; }
+            }
+            c.q_out_i32_a = leased;
+            c.q_out_i64   = total;
+            break;
+        }
+    }
+    disp_complete(ci, 0);
+}
+
+// ===========================================================================
+// §10.6 ★B2 프리페치 admission (PHASEB_DESIGN §4 · SPEC_PHASEB_WIRE §4.2·§6)
+// ===========================================================================
+
+// intent 결속 — 헤드 intent의 pb_sample 행(target 층)을 확보하고 intent 필드를 채운다(§4 ⓐ).
+int32_t pb_bind_intent_row_locked(const ggml_moe_phaseb_intent & it) {
+    const int32_t row = pb_row_locked(it.graph_seq, it.request_epoch, it.graph_epoch,
+                                      it.target_mlpos, /*is_prefill=*/0);
+    if (row < 0) return -1;
+    ggml_moe_phaseb_sample & s = g_mod.pb_samples[(size_t)row];
+    s.flags |= 0x01;                                   // intent_present
+    s.elig_skip_reason = GGML_MOE_PB_SKIP_NONE;
+    s.source_layer     = it.source_layer;
+    s.k_effective      = (uint8_t)it.k;
+    s.intent_ordinal   = it.intent_ordinal;
+    for (int i = 0; i < GGML_MOE_PHASEB_TOPK; i++) s.intent_ids[i] = it.ids[i];
+    s.capture_qpc      = it.capture_qpc;
+    s.predict_end_qpc  = it.predict_end_qpc;
+    return row;
+}
+
+// ★프리페치 admission — dispatcher **턴당 후보 1건**(§4 "턴당 1건"). 호출 위치가 demand pump
+//   뒤이므로 demand 절대 우선이 구조로 보장된다. ★v1은 capacity 확보용 prefetch cancel 금지
+//   (§5.2 ⓕ) — 그런 코드는 이 파일에 존재하지 않는다(pb_capacity_cancel_attempt는 상수 0).
+//   cut_mode=true(PB_FINALIZE_CUT ④)에서는 신규 제출을 허가하지 않으므로 후보는 capacity
+//   없음으로 처분된다(잔여 rank<k 전건 소비 완결).
+// ★R1 #2 ② 반환값: 0=EMPTY(소비할 rank 없음) / 1=DISPOSED(사전 처분·admission drop —
+//   progress로 인정해 남은 rank가 같은 turn 흐름에서 계속 소비된다) / 2=ISSUED(claim+제출 대기).
+enum PbAdmitResult : int { PB_ADMIT_EMPTY = 0, PB_ADMIT_DISPOSED = 1, PB_ADMIT_ISSUED = 2 };
+
+int pb_admit_locked(bool cut_mode) {
+    if (!g_mod.pb_prefetch_on) return PB_ADMIT_EMPTY;
+    for (;;) {
+        if (!g_mod.pb_cur_active) {
+            if (!ggml_moe_phaseb_intent_peek(&g_mod.pb_cur_intent)) return PB_ADMIT_EMPTY;
+            ggml_moe_phaseb_intent_pop();
+            g_mod.pb_cur_active = true;
+            g_mod.pb_cur_rank   = 0;
+            g_mod.pb_cur_row    = pb_bind_intent_row_locked(g_mod.pb_cur_intent);
+        }
+        const ggml_moe_phaseb_intent it = g_mod.pb_cur_intent;
+        const int32_t row = g_mod.pb_cur_row;
+        const uint32_t req = it.request_epoch;
+        if (g_mod.pb_cur_rank >= (int32_t)it.k) { g_mod.pb_cur_active = false; continue; }
+        const uint16_t rank = (uint16_t)g_mod.pb_cur_rank++;
+        const uint16_t eid  = it.ids[rank];
+        auto dispose = [&](uint8_t d) { pb_dispose_rank_locked(row, it.intent_ordinal, rank, d, req); };
+        // n_expert < k 방어 — seal에서 프리페치를 끄므로 정상 운전에서는 도달하지 않는다.
+        if (eid == GGML_MOE_PHASEB_NA_U16 || (int32_t)eid >= g_mod.n_expert) { dispose(GGML_MOE_PB_D_PRE_STALE); return PB_ADMIT_DISPOSED; }
+
+        const int64_t record = (int64_t)it.target_mlpos * g_mod.n_expert + eid;
+
+        // ── 사전 처분(§4.2 우선순서: too_late → stale → resident/pending) ──
+        if (pb_is_served_locked(it.graph_seq, it.target_mlpos)) { dispose(GGML_MOE_PB_D_PRE_TOO_LATE); return PB_ADMIT_DISPOSED; }
+        if (g_mod.pb_cur_graph_seq != GGML_MOE_PHASEB_NA_U32 && it.graph_seq != g_mod.pb_cur_graph_seq) {
+            dispose(GGML_MOE_PB_D_PRE_STALE); return PB_ADMIT_DISPOSED;
+        }
+        {
+            const RecordEntry & re = g_mod.record_table[(size_t)record];
+            const int32_t si = re.slot_index.load(std::memory_order_relaxed);
+            bool resident = false;
+            if (si >= 0) {
+                const Slot & s = g_mod.slots[(size_t)si];
+                resident = s.generation.load(std::memory_order_relaxed) == re.slot_generation.load(std::memory_order_relaxed)
+                        && s.owner_record == record;
+            }
+            if (resident) { dispose(GGML_MOE_PB_D_PRE_RESIDENT); return PB_ADMIT_DISPOSED; }
+        }
+        if (g_mod.pending_by_record[(size_t)record] >= 0) { dispose(GGML_MOE_PB_D_PRE_PENDING); return PB_ADMIT_DISPOSED; }
+
+        // ── admission ①②③(순서 고정 — 먼저 걸린 사유 1개만) ──
+        ggml_moe_phaseb_count(GGML_MOE_PB_C_CANDIDATE, req, 1);
+        const int32_t total_inflight = g_mod.pb_inflight_demand + g_mod.pb_inflight_prefetch;
+        const int32_t cap_total = cut_mode ? 0 : g_mod.qd_effective;
+        if (total_inflight >= cap_total)                 { dispose(GGML_MOE_PB_D_DROP_NO_SLOT_QD);   return PB_ADMIT_DISPOSED; }
+        if (g_mod.pb_inflight_prefetch >= g_mod.pb_n)    { dispose(GGML_MOE_PB_D_DROP_PREFETCH_CAP); return PB_ADMIT_DISPOSED; }
+        // ③ mutation **전에** 투영: E − 1 ≥ n_expert_used (claim 전 reserve).
+        int64_t E = 0;
+        for (int32_t i = 0; i < g_mod.n_slots; i++) {
+            if (g_mod.slot_pending[(size_t)i]) continue;
+            if (g_mod.slots[(size_t)i].lease.load(std::memory_order_relaxed) != 0) continue;
+            E++;
+        }
+        if (E - 1 < (int64_t)g_mod.n_expert_used)        { dispose(GGML_MOE_PB_D_DROP_RESERVE);      return PB_ADMIT_DISPOSED; }
+        ggml_moe_phaseb_count(GGML_MOE_PB_C_ADMITTED, req, 1);
+
+        // ── ④ 통과 시에만 claim ──
+        int32_t victim = -1;
+        for (int32_t i = 0; i < g_mod.n_slots; i++) {
+            if (g_mod.slot_pending[(size_t)i]) continue;
+            if (g_mod.slots[(size_t)i].lease.load(std::memory_order_relaxed) != 0) continue;
+            if (victim_better_locked(i, victim)) victim = i;
+        }
+        const int32_t oi = victim >= 0 ? pio_alloc_locked() : -1;
+        if (oi < 0) {   // 방어(E>=1 보장·pending 풀은 n_slots) — 계상은 이미 admitted라 issued/failed로 닫는다
+            pb_dispose_rank_locked(row, it.intent_ordinal, rank, GGML_MOE_PB_D_SUBMIT_FAILED, req);
+            return PB_ADMIT_DISPOSED;
+        }
+        Slot & s = g_mod.slots[(size_t)victim];
+        if (s.owner_record >= 0) {
+            // ★prefetch 축출은 PA ledger(demand 스코프)에 먹이지 않는다(§2.3).
+            pb_transition_locked(GGML_MOE_PB_EV_EVICT, s.owner_record, victim,
+                                 s.generation.load(std::memory_order_relaxed), s.pf_intent_ordinal);
+            g_mod.record_table[(size_t)s.owner_record].slot_index.store(-1, std::memory_order_release);
+        }
+        const LayerInfo & L = g_mod.layers[(size_t)it.target_mlpos];
+        PendingIo & op = g_mod.pending_ops[(size_t)oi];
+        op.m = BatchMiss();
+        op.m.record_idx        = record;
+        op.m.multiplicity      = 0;                                   // waiter 없음(speculative)
+        op.m.generation        = s.generation.fetch_add(1, std::memory_order_relaxed) + 1;
+        op.m.slot              = victim;
+        op.m.file_offset       = L.record_base + (uint64_t)eid * L.stride_bytes;
+        op.m.logical_last_tick = g_mod.tick;   // ★demand LRU tick을 소비하지 않는다(§4)
+        op.m.pa_batch_order    = 0;
+        s.owner_record       = record;
+        s.last_used          = g_mod.tick;
+        s.cache_class        = GGML_MOE_PB_CLASS_NONE;   // publish 전까지 READY_* 아님
+        s.pf_intent_ordinal  = GGML_MOE_PHASEB_NA_U64;
+        s.pf_rank            = GGML_MOE_PHASEB_NA_U16;
+        s.pf_io_index        = -1;
+        op.mlpos  = it.target_mlpos;
+        op.phase  = Phase::DECODE;
+        op.origin = PIO_ORIGIN_PREFETCH;
+        op.state  = PIO_CLAIMED;
+        op.request_identity = 0;
+        op.intent_seq       = it.intent_ordinal;
+        op.retry_of         = -1;
+        op.pb_request_epoch = it.request_epoch;
+        op.pb_graph_epoch   = it.graph_epoch;
+        op.pb_graph_seq     = it.graph_seq;
+        op.pb_rank          = rank;
+        g_mod.pending_by_record[(size_t)record] = oi;
+        g_mod.slot_pending[(size_t)victim] = 1;
+        g_mod.submit_q.push_back(oi);
+        return PB_ADMIT_ISSUED;    // 턴당 1건
+    }
+}
+
+// dispatcher 1 pass — command 수집/처리 → signaled 채널 회수 → demand 제출(B2 자리) → command 재검사.
+// 반환: progressed(무언가 진행됨) / out_deferred(demand 계획을 미뤘음 = command_event 무시하고 대기).
+bool disp_pass_locked(bool & out_deferred) {
+    bool progressed = false;
+    out_deferred = false;
+
+    for (int pass = 0; pass < 2; pass++) { // ★"command 재검사"(B2 admission 자리 뒤 재확인)
+        for (;;) {
+            const int32_t ci = disp_peek();
+            if (ci < 0) break;
+            ControlCmd & c = g_mod.cmds[(size_t)ci];
+            if (c.kind == CMD_DEMAND_ACQUIRE && !disp_can_plan_demand(c.n_ids)) { out_deferred = true; break; }
+            disp_pop();
+            progressed = true;
+            switch (c.kind) {
+                case CMD_DEMAND_ACQUIRE: disp_handle_demand_locked(ci); break;
+                case CMD_RELEASE:        disp_handle_release_locked(ci); break;
+                case CMD_TEST_QUERY:     disp_handle_query_locked(ci); break;
+                case CMD_STOP:
+                    g_mod.stat_stop_cmd++;
+                    disp_complete(ci, 0);
+                    break;
+                default: disp_complete(ci, -1); break;
+            }
+        }
+        if (pass == 0) {
+            pb_drain_status_locked();   // ★R2 #5 — 비동기 사유의 행 사후 갱신
+            if (disp_retire_signaled_locked()) progressed = true;
+            if (disp_pump_locked())            progressed = true;
+            // ── ★B2 prefetch admission 턴당 1건(§4) — demand pump 뒤이므로 demand 절대 우선. ──
+            //   ★R1 #2 ② — DISPOSED(사전 처분·drop)도 progress로 인정한다. 그래야 남은 rank가
+            //   같은 turn 흐름에서 계속 소비돼 미처분 잔존(complete=0)이 나지 않는다.
+            const int adm = pb_admit_locked(/*cut_mode=*/false);
+            if (adm != PB_ADMIT_EMPTY) {
+                progressed = true;
+                if (adm == PB_ADMIT_ISSUED) disp_pump_locked(); // claim한 speculative op를 같은 턴에 제출
+            }
+            // ★테스트 전용 abort 훅 — 제출된 op가 임계 이상이면 그 자리에서 취소 drain을 행사.
+            if (g_mod.test_abort_after_submit > 0) {
+                int32_t n_sub = 0;
+                for (auto & ch : g_mod.channels) if (ch.busy) n_sub++;
+                if (n_sub >= g_mod.test_abort_after_submit) {
+                    g_mod.test_abort_after_submit = 0;
+                    disp_abort_inflight_locked();
+                    progressed = true;
+                }
+            }
+        }
+        if (out_deferred) break;
+    }
+    return progressed;
+}
+
+unsigned __stdcall dispatcher_main(void *) {
+    // handle 0 = command_event, 1..QD = channel.ev → 1+QD <= 64(MAXIMUM_WAIT_OBJECTS).
+    HANDLE handles[MOE_DIRECT_QD_MAX + 1];
+    DWORD  n_handles = 0;
+    {
+        std::lock_guard<std::mutex> lock(g_mod.mutex);
+        handles[n_handles++] = g_mod.command_event;
+        for (auto & ch : g_mod.channels) handles[n_handles++] = ch.ev;
+    }
+    for (;;) {
+        // ── 테스트 전용 pause(만석 큐 픽스처) — g_mod.mutex 무보유 상태로 정지한다. ──
+        {
+            std::unique_lock<std::mutex> lk(g_mod.q_mutex);
+            if (g_mod.q_pause_req && !g_mod.q_stopping) {
+                g_mod.q_paused = true;
+                g_mod.q_pause_cv.notify_all();
+                lk.unlock();
+                WaitForSingleObject(g_mod.resume_event, INFINITE);
+                ResetEvent(g_mod.resume_event);
+                lk.lock();
+                g_mod.q_paused = false;
+                g_mod.q_pause_cv.notify_all();
+                continue;
+            }
+        }
+        bool deferred = false;
+        bool progressed = false;
+        bool exit_now = false;
+        {
+            std::lock_guard<std::mutex> lock(g_mod.mutex);
+            bool stopping, abort_mode;
+            {
+                std::lock_guard<std::mutex> lk(g_mod.q_mutex);
+                stopping   = g_mod.q_stopping;
+                abort_mode = g_mod.q_abort;
+            }
+            // ★보완 ② barrier — stopping 스냅샷 **직후**. 여기서 멈춘 동안 테스트가 q_stopping 을
+            //   세우면, 이 pass 는 stale stopping=false 로 진행해 신호 소실 창을 정확히 재현한다.
+            //   대기는 유한(5s)이라 픽스처가 실패해도 스레드가 영구 정지하지 않는다.
+            if (g_mod.test_stop_race && !stopping) {
+                g_mod.test_stop_race = 0;   // one-shot
+                if (g_mod.stop_race_hit) SetEvent(g_mod.stop_race_hit);
+                if (g_mod.stop_race_go)  WaitForSingleObject(g_mod.stop_race_go, 5000);
+            }
+            if (stopping && abort_mode) {
+                // abort/test — 잔여 in-flight 취소 drain 후 대기 command 전부 error 종결.
+                disp_abort_inflight_locked();
+                for (;;) {
+                    const int32_t ci = disp_peek();
+                    if (ci < 0) break;
+                    disp_pop();
+                    disp_complete(ci, -1);
+                }
+                exit_now = true;
+            } else {
+                progressed = disp_pass_locked(deferred);
+                if (stopping) {
+                    // ★R1 #3 ② — CUT ② (predictor drain/stop join)가 끝나기 전에는 exit 금지.
+                    //   조기 exit하면 worker가 뒤늦게 발행한 intent가 미처분으로 남는다.
+                    const bool pred_done = ggml_moe_phaseb_predictor_drained();
+                    // ★CUT ④ — pre-cut command drain(③) 뒤 잔여 intent 전건을 닫힌 enum으로 처분.
+                    while (pb_admit_locked(/*cut_mode=*/true) != PB_ADMIT_EMPTY) { progressed = true; }
+                    // graceful — 신규 command는 이미 거절(cq_alloc/cut 래치), 잔여를 drain.
+                    int32_t q_left = 0;
+                    { std::lock_guard<std::mutex> lk(g_mod.q_mutex); q_left = g_mod.q_count; }
+                    // ★R2 #2 — demand 완료 판정에 **수령된 demand command 잔여**를 포함한다.
+                    //   `pb_inflight_demand`(물리 demand op)만 보면, demand 가 join 해 기다리는
+                    //   prefetch-origin op 가 남은 상태를 "demand 없음"으로 오판해 그 op 를
+                    //   CancelIoEx 하고 정상 요청을 실패시킨다(R2 적발).
+                    const bool cmd_done = (q_left == 0) && (g_mod.submit_head >= g_mod.submit_q.size())
+                                       && (g_mod.pb_inflight_demand == 0)
+                                       && (g_mod.demand_outstanding == 0);
+                    // ★CUT ⑤ — demand drain 완료 후 잔여 prefetch in-flight를 실제 취소 회수.
+                    if (pred_done && cmd_done && g_mod.pb_inflight_prefetch > 0) {
+                        if (disp_cancel_prefetch_inflight_locked()) progressed = true;
+                    }
+                    size_t n_busy = 0;
+                    for (auto & ch : g_mod.channels) if (ch.busy) n_busy++;
+                    if (pred_done && cmd_done && n_busy == 0 &&
+                        ggml_moe_phaseb_intent_depth() == 0 && !g_mod.pb_cur_active) {
+                        disp_abort_inflight_locked(); // 잔여 0 확인용(no-op) — 방어적 drain
+                        // ★CUT ⑥ — intent depth·rank cursor·command·pending·channel 전수 0 검사.
+                        int32_t residual = 0;
+                        if (ggml_moe_phaseb_intent_depth() != 0) residual |= 1;
+                        if (g_mod.pb_cur_active)                 residual |= 2;
+                        { std::lock_guard<std::mutex> lk(g_mod.q_mutex); if (g_mod.q_count != 0) residual |= 4; }
+                        if ((int32_t)g_mod.pending_free.size() != g_mod.n_slots) residual |= 8;
+                        for (auto & ch : g_mod.channels) if (ch.busy) residual |= 16;
+                        if (g_mod.pb_inflight_demand != 0 || g_mod.pb_inflight_prefetch != 0) residual |= 32;
+                        // ★selftest 전용 잔여 주입(FROZEN_INCOMPLETE_REASON_MASK §9-1·§9-7) —
+                        //   자연 발생 잔여는 결정론적으로 만들 수 없으므로 세부 비트를 주입해
+                        //   echo·마스크 결속 등식을 행사한다. 프로덕션 경로는 항상 0.
+                        residual |= g_mod.test_cut_residual_force;
+                        g_mod.pb_cut_residual = residual;
+                        if (residual != 0) ggml_moe_phaseb_mark_incomplete(GGML_MOE_PB_INC_CUT_RESIDUAL);
+                        exit_now = true;
+                    }
+                }
+            }
+        }
+        if (exit_now) break;
+        if (progressed) continue;
+        if (deferred) {
+            // command_event가 signaled인 채로 미룬 상태 — 채널 완료만 기다린다(busy-spin 방지).
+            if (n_handles > 1) WaitForMultipleObjects(n_handles - 1, handles + 1, FALSE, 50);
+            else               Sleep(1);
+        } else {
+            // ★★정지 중에는 무한 대기 금지(방어 심층) — graceful exit 조건에는 채널/커맨드
+            //   이벤트를 동반하지 않고 변할 수 있는 항(demand_outstanding·intent_depth·
+            //   pb_cur_active·pred_done)이 섞여 있다. 정지 국면에서만 유한 대기로 바꿔 조건을
+            //   주기적으로 재평가한다(정상 국면은 기존대로 INFINITE — 공회전 0 유지).
+            bool stopping_now = false;
+            { std::lock_guard<std::mutex> lk(g_mod.q_mutex); stopping_now = g_mod.q_stopping; }
+            WaitForMultipleObjects(n_handles, handles, FALSE, stopping_now ? 20 : INFINITE);
+        }
+        g_mod.stat_wait_wakeups.fetch_add(1, std::memory_order_relaxed);
+    }
+    return 0;
+}
+
+// dispatcher 자원 해제(스레드는 이미 종료/미기동 상태여야 한다). 호출자는 g_mod.mutex 보유.
+void dispatcher_cleanup_locked() {
+    ggml_moe_phaseb_set_wake_event(nullptr);   // ★R1 #2 ① — 해제 전 등록 해지(dangling 금지)
+    for (auto & ch : g_mod.channels) if (ch.ev) CloseHandle(ch.ev);
+    g_mod.channels.clear();
+    if (g_mod.command_event) { CloseHandle(g_mod.command_event); g_mod.command_event = nullptr; }
+    if (g_mod.resume_event)  { CloseHandle(g_mod.resume_event);  g_mod.resume_event  = nullptr; }
+    if (g_mod.stop_race_hit) { CloseHandle(g_mod.stop_race_hit); g_mod.stop_race_hit = nullptr; }
+    if (g_mod.stop_race_go)  { CloseHandle(g_mod.stop_race_go);  g_mod.stop_race_go  = nullptr; }
+    g_mod.pending_ops.clear();
+    g_mod.pending_free.clear();
+    g_mod.pending_by_record.clear();
+    g_mod.slot_pending.clear();
+    g_mod.submit_q.clear();
+    g_mod.submit_head = 0;
+    g_mod.demand_outstanding = 0;
+}
+
+// seal 말미(g_mod.mutex 보유)에서 1회 기동. 채널·이벤트·pending 표는 여기서 확정되고 주소가 고정된다.
+bool dispatcher_start_locked(std::string & err) {
+    g_mod.command_event = CreateEventW(nullptr, TRUE, FALSE, nullptr);  // manual reset
+    g_mod.resume_event  = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    g_mod.stop_race_hit = CreateEventW(nullptr, TRUE, FALSE, nullptr);  // ★보완 ② 테스트 barrier
+    g_mod.stop_race_go  = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    if (!g_mod.command_event || !g_mod.resume_event || !g_mod.stop_race_hit || !g_mod.stop_race_go) {
+        err = "CreateEventW(dispatcher) failed"; dispatcher_cleanup_locked(); return false;
+    }
+    g_mod.channels = std::vector<IoChannel>((size_t)g_mod.qd_effective);
+    for (auto & ch : g_mod.channels) {
+        ch.ev = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+        if (!ch.ev) { err = "CreateEventW(channel) failed"; dispatcher_cleanup_locked(); return false; }
+    }
+    g_mod.pending_ops = std::vector<PendingIo>((size_t)g_mod.n_slots);
+    g_mod.pending_free.clear();
+    g_mod.pending_free.reserve((size_t)g_mod.n_slots);
+    for (int32_t i = g_mod.n_slots - 1; i >= 0; i--) g_mod.pending_free.push_back(i);
+    g_mod.pending_by_record.assign(g_mod.record_table.size(), -1);
+    g_mod.slot_pending.assign((size_t)g_mod.n_slots, 0);
+    g_mod.submit_q.clear();
+    g_mod.submit_q.reserve((size_t)g_mod.n_slots);
+    g_mod.submit_head = 0;
+    g_mod.demand_outstanding = 0;
+    {
+        std::lock_guard<std::mutex> lk(g_mod.q_mutex);
+        g_mod.q_free_top = 0;
+        for (int32_t i = MOE_DIRECT_CONTROL_Q_CAP - 1; i >= 0; i--) {
+            g_mod.cmds[(size_t)i].ids.reserve(cq_ids_capacity()); // capacity 확정 → 정상 운전 무할당
+            g_mod.cmds[(size_t)i].req_join_op.reserve(cq_ids_capacity());
+            g_mod.cmds[(size_t)i].in_use = false;
+            g_mod.cmds[(size_t)i].done   = false;
+            g_mod.q_free[g_mod.q_free_top++] = i;
+        }
+        g_mod.q_head = 0; g_mod.q_count = 0;
+        g_mod.q_stopping = false; g_mod.q_abort = false;
+        g_mod.q_pause_req = false; g_mod.q_paused = false;
+    }
+    unsigned tid = 0;
+    // ★STACK_SIZE_PARAM_IS_A_RESERVATION — 없으면 stack_size가 초기 commit로 해석되고 실제
+    //   reserve는 PE 헤더 기본값(1MiB)이 되어 mem echo(dispatcher_stack_reserve_bytes)가 거짓이 된다.
+    g_mod.disp_thread = _beginthreadex(nullptr, MOE_DIRECT_DISP_STACK, dispatcher_main, nullptr,
+                                       STACK_SIZE_PARAM_IS_A_RESERVATION, &tid);
+    if (g_mod.disp_thread == 0) { err = "cannot create dispatcher thread"; dispatcher_cleanup_locked(); return false; }
+    // ★R1 #2 ① — worker의 intent enqueue가 이 이벤트로 dispatcher를 깨운다.
+    ggml_moe_phaseb_set_wake_event(g_mod.command_event);
+    g_mod.disp_running.store(true, std::memory_order_release);
+    return true;
+}
+
+// 종료 시퀀스(§2): STOPPING → 신규 command 거절 → active demand/release drain → 잔여 CancelIoEx →
+// 전 채널 terminal 회수 → dispatcher exit/join → event 해제. ★호출자는 g_mod.mutex 미보유.
+void dispatcher_stop_and_join(bool abort_mode) {
+    if (!g_mod.disp_running.load(std::memory_order_acquire)) return;
+    // ★R1 #3 ② — dispatcher 정지 전에 intent 생산자(predictor)를 먼저 닫고 drain 한다
+    //   (§2 graceful 종료 시퀀스: "신규 capture/command 거절 → predictor stop/join → drain").
+    //   이 래치가 서기 전에는 dispatcher graceful exit이 금지되므로 여기서 멱등으로 보장한다.
+    ggml_moe_phaseb_cut_close_capture();
+    ggml_moe_phaseb_cut_drain_predictor();
+    {
+        std::lock_guard<std::mutex> lk(g_mod.q_mutex);
+        g_mod.q_stopping = true;
+        g_mod.q_abort    = abort_mode;
+        g_mod.q_pause_req = false;
+        g_mod.q_free_cv.notify_all();   // 만석 대기 생산자 해제(신규 command는 거절된다)
+        SetEvent(g_mod.command_event);
+        SetEvent(g_mod.resume_event);
+    }
+    WaitForSingleObject((HANDLE)g_mod.disp_thread, INFINITE);
+    CloseHandle((HANDLE)g_mod.disp_thread);
+    g_mod.disp_thread = 0;
+    g_mod.disp_running.store(false, std::memory_order_release);
+
+    std::lock_guard<std::mutex> lock(g_mod.mutex);
+    dispatcher_cleanup_locked();
+}
+
+// 영속 경로가 선택돼 있는가(selector는 seal 후 immutable — sealed는 release-store로 publish된다).
+inline bool persistent_selected() {
+    return g_mod.sealed.load(std::memory_order_acquire) && g_mod.io_path_persistent;
+}
+// 영속 경로 활성 여부(= command 수용 가능).
+inline bool persistent_active() {
+    return persistent_selected() && g_mod.disp_running.load(std::memory_order_acquire);
+}
+// ★영속 경로가 선택됐는데 dispatcher가 정지(STOPPING/종료)한 상태 = 신규 command 거절(§2 ⑤).
+//   여기서 legacy 배치 pump로 조용히 우회하면 "종료 후에도 I/O가 계속되는" 계약 위반이 된다.
+inline bool persistent_fail_closed() {
+    return persistent_selected() && !g_mod.disp_running.load(std::memory_order_acquire);
+}
+
+// ===========================================================================
+// §11-0. ★OPEN_ARCH B축 template seal 승인 분기(OPENARCH_B_SPEC_DRAFT v0.2 §2-2·§2-3a/b).
+//        model-pin 경로의 expect 승인부를 **대체**하는 분기다. 공통 F1 후반부(partial 마커·
+//        verify_report PASS 게이트·manifest cache-key 결속)와 그 이후의 기존 seal 전부는
+//        분기하지 않고 그대로 합류한다(§2-3c/d — 우회 금지).
+//        호출자는 g_mod.mutex 보유. 반환 0=성공, <0=실패(err에 사유).
+// ===========================================================================
+
+int arch_template_gate_locked(const std::wstring & dir_w,
+                              const ggml_moe_direct_model & model,
+                              const ParsedManifest & pm,
+                              std::string & out_inventory_sha,
+                              std::string & err) {
+    // ---- §2-2: lock 접두 파싱 + 카탈로그 승인(미등록/버전 불일치는 사유 문자열로 구분) ----
+    const std::string suffix = pm.ref_profile_id.substr(std::strlen(ARCH_TEMPLATE_LOCK_PREFIX));
+    const size_t at = suffix.find('@');
+    if (at == std::string::npos || at == 0 || at + 1 >= suffix.size() || suffix.rfind('@') != at) {
+        err = "arch-template reference_lock.profile_id is malformed (expected "
+              "arch-template:<template_id>@<version>): " + pm.ref_profile_id;
+        return -1;
+    }
+    const std::string tpl_id  = suffix.substr(0, at);
+    const std::string tpl_ver = suffix.substr(at + 1);
+
+    const ArchTemplateEntry * tpl = nullptr;
+    bool id_registered = false;
+    for (const auto & e : ARCH_TEMPLATE_CATALOG) {
+        if (tpl_id == e.template_id) {
+            id_registered = true;
+            if (tpl_ver == e.template_version) tpl = &e;
+            break;
+        }
+    }
+    if (!id_registered) {
+        err = "arch template is not registered in the frozen ARCH_TEMPLATE_CATALOG: " + tpl_id; return -1;
+    }
+    if (!tpl) {
+        err = "arch template version is not approved: " + tpl_id + "@" + tpl_ver; return -1;
+    }
+
+    // ---- §2-3a: derived expect 승인. 경로는 **재팩 출력 디렉토리 고정**이다
+    //      (repack_experts.py:1074 — 번들 expects_dir 는 template 분기에서 일절 쓰지 않는다). ----
+    const std::wstring expect_path = dir_w + L"\\derived.expect.json";
+    {
+        std::string file_sha, sherr;
+        if (!sha256_file(expect_path, file_sha, sherr)) {
+            err = "cannot read derived.expect.json in the repack output directory: " + sherr; return -1;
+        }
+        if (to_lower_hex(file_sha) != to_lower_hex(pm.ref_expect_sha256)) {
+            err = "re-hashed derived.expect.json != manifest.reference_lock.expect_sha256 "
+                  "(tampered or misplaced derived expect)"; return -1;
+        }
+    }
+    json ex;
+    {
+        std::ifstream ifs(expect_path, std::ios::binary);
+        if (!ifs.is_open()) { err = "cannot open derived.expect.json"; return -1; }
+        try {
+            ifs >> ex;
+        } catch (const std::exception & e) {
+            err = std::string("derived.expect.json JSON parse failed: ") + e.what(); return -1;
+        }
+    }
+    if (!ex.is_object()) { err = "the top level of derived.expect.json is not a JSON object"; return -1; }
+
+    // 정확히 13키(§1 스키마 — 등록 expect 와 달리 template 전용 parser 만 이 강제를 건다: D3).
+    static const char * const EXPECT_KEYS[] = {
+        "expect_schema_version", "derived_from", "template_id", "template_version",
+        "inventory_sha256", "routed_scope", "arch", "n_layer", "n_expert",
+        "n_expert_used", "routed_tensors", "expert_bytes_total", "sources",
+    };
+    if (ex.size() != 13) {
+        err = "derived.expect.json key count(" + std::to_string(ex.size()) + ") != 13 (frozen schema)"; return -1;
+    }
+    for (const char * k : EXPECT_KEYS) {
+        if (!ex.contains(k)) { err = std::string("derived.expect.json is missing the key: ") + k; return -1; }
+    }
+    for (const char * k : { "expect_schema_version", "derived_from", "template_id", "template_version",
+                            "inventory_sha256", "routed_scope", "arch" }) {
+        if (!ex[k].is_string()) { err = std::string("derived.expect.json.") + k + " is not a string"; return -1; }
+    }
+    for (const char * k : { "n_layer", "n_expert", "n_expert_used", "routed_tensors" }) {
+        if (!json_is_int(ex[k])) { err = std::string("derived.expect.json.") + k + " is not an integer"; return -1; }
+    }
+    if (!json_is_uint(ex["expert_bytes_total"])) {
+        err = "derived.expect.json.expert_bytes_total is not an unsigned integer"; return -1;
+    }
+    if (!ex["sources"].is_array()) { err = "derived.expect.json.sources is not an array"; return -1; }
+
+    // D3: template 전용 parser 에서만 "1.0" 을 정확 강제(등록 경로는 파일 해시만 보는 현행 불변).
+    if (ex["expect_schema_version"].get<std::string>() != "1.0") {
+        err = "derived.expect.json.expect_schema_version != \"1.0\" (got: " +
+              ex["expect_schema_version"].get<std::string>() + ")"; return -1;
+    }
+    // derived_from == lock 의 <template_id>@<version> 3자 일치(template_id·template_version 필드와도 상호 대조).
+    const std::string want_from = tpl_id + "@" + tpl_ver;
+    if (ex["derived_from"].get<std::string>() != want_from) {
+        err = "derived.expect.json.derived_from(" + ex["derived_from"].get<std::string>() +
+              ") != reference_lock(" + want_from + ")"; return -1;
+    }
+    if (ex["template_id"].get<std::string>() != tpl_id) {
+        err = "derived.expect.json.template_id(" + ex["template_id"].get<std::string>() +
+              ") != reference_lock template_id(" + tpl_id + ")"; return -1;
+    }
+    if (ex["template_version"].get<std::string>() != tpl_ver) {
+        err = "derived.expect.json.template_version(" + ex["template_version"].get<std::string>() +
+              ") != reference_lock template_version(" + tpl_ver + ")"; return -1;
+    }
+    // manifest routed_scope == expect routed_scope.
+    const std::string ex_scope = ex["routed_scope"].get<std::string>();
+    if (ex_scope != pm.routed_scope) {
+        err = "derived.expect.json.routed_scope(" + ex_scope + ") != manifest routed_scope(" +
+              pm.routed_scope + ")"; return -1;
+    }
+    const std::string ex_inv = to_lower_hex(ex["inventory_sha256"].get<std::string>());
+    if (ex_inv.size() != 64) { err = "derived.expect.json.inventory_sha256 length != 64"; return -1; }
+    for (char c : ex_inv) {
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+            err = "derived.expect.json.inventory_sha256 is not hexadecimal"; return -1;
+        }
+    }
+
+    // ---- §2-3b: 독립 inventory 폐합.
+    //      expected 이름 집합을 arch 공식으로 **생성**한다(리패커의 "정규식 발견" 재사용 금지).
+    //      型/dims/layer/scope 는 등록된 canonical routed tensor 의 **live 값**에서 취한다. ----
+    int32_t first_layer = 0;
+    if (tpl->layer_rule == TplLayerRule::LEADING_DENSE) {
+        if (model.n_layer_dense_lead < 0 || model.n_layer_dense_lead >= model.n_layer) {
+            err = "n_layer_dense_lead(" + std::to_string(model.n_layer_dense_lead) +
+                  ") is out of range (0 <= x < n_layer(" + std::to_string(model.n_layer) + "))"; return -1;
+        }
+        first_layer = model.n_layer_dense_lead;
+    }
+    const bool is_exec = (pm.routed_scope == "execution");
+    if (is_exec && tpl->nextn != TplNextn::EXECUTION_DEFAULT) {
+        err = "routed_scope=execution but the " + tpl_id + " arch template has no NextN clause"; return -1;
+    }
+    // n_layer_nextn 의 정의역(0 <= x < n_layer)과 "execution 인데 nextn==0" 은 validate_manifest_v2 가
+    // 이미 거부했다 — 여기서는 그 결과만 쓴다.
+    const int32_t last_excl = model.n_layer - (is_exec ? model.n_layer_nextn : 0);
+    if (first_layer >= last_excl) {
+        err = "the arch template layer set is empty (first=" + std::to_string(first_layer) +
+              ", end_exclusive=" + std::to_string(last_excl) + ", n_layer=" + std::to_string(model.n_layer) +
+              ", scope=" + pm.routed_scope + ")"; return -1;
+    }
+
+    std::vector<std::string> want_suffixes;
+    for (const char * k : ARCH_TEMPLATE_WEIGHT_KINDS) want_suffixes.push_back(std::string("ffn_") + k + "_exps.weight");
+    if (tpl->bias == TplBias::REQUIRED) {
+        for (const char * k : ARCH_TEMPLATE_WEIGHT_KINDS) want_suffixes.push_back(std::string("ffn_") + k + "_exps.bias");
+    }
+    std::vector<std::string> want_names;
+    want_names.reserve((size_t)(last_excl - first_layer) * want_suffixes.size());
+    for (int32_t l = first_layer; l < last_excl; l++) {
+        for (const auto & s : want_suffixes) want_names.push_back("blk." + std::to_string(l) + "." + s);
+    }
+    std::unordered_map<std::string, int> want_index;
+    for (size_t i = 0; i < want_names.size(); i++) want_index[want_names[i]] = 1;
+
+    // live 등록분(scope 적용). execution 은 NextN 꼬리층을 관리 대상에서 뺀다 — 아래 §11 본체의
+    // pending_kept 와 동일 경계(layer < n_layer - n_layer_nextn)다.
+    std::unordered_map<std::string, const PendingReg *> live;
+    for (const auto & pr : g_mod.pending) {
+        int32_t player = -1; std::string kind, suf;
+        if (!parse_routed_tensor_name(pr.name, player, kind, suf)) {
+            err = "arch template: a registered tensor name is not a canonical routed name: " + pr.name; return -1;
+        }
+        if (is_exec && player >= last_excl) continue;   // NextN 제외분(등록 유지·관리 대상 아님)
+        if (!live.emplace(pr.name, &pr).second) {
+            err = "arch template: duplicate routed registration: " + pr.name; return -1;
+        }
+    }
+    // 공식 이름이 live 등록분에 없으면 fail.
+    for (const auto & n : want_names) {
+        if (!live.count(n)) {
+            err = "the " + tpl_id + " arch template formula expects routed tensor " + n +
+                  " but it is not registered (live inventory diverged from the formula)"; return -1;
+        }
+    }
+    // 등록된 canonical routed tensor 중 공식 밖 이름이 있으면 fail(★r1 F5 축소 범위 — 비정규
+    // expert-like 텐서는 애초에 로더가 등록하지 않으므로 여기 대상이 아니다).
+    for (const auto & kv : live) {
+        if (!want_index.count(kv.first)) {
+            err = "registered routed tensor " + kv.first + " is outside the " + tpl_id +
+                  " arch template formula (layers " + std::to_string(first_layer) + ".." +
+                  std::to_string(last_excl - 1) + ", scope=" + pm.routed_scope + ")"; return -1;
+        }
+    }
+
+    // row 조립 — §1 wire 사실 그대로. D4: 型은 enum→동결 wire명 매핑, dims 는 **전체 축**을 싣는다
+    // (그 결속이 곧 type/shape 검증의 본체다).
+    std::vector<std::string> rows;
+    rows.reserve(want_names.size());
+    for (const auto & n : want_names) {
+        const PendingReg * pr = live[n];
+        const ggml_tensor * t = pr->tensor;
+        if (!t) { err = "arch template: registered routed tensor has no live handle: " + n; return -1; }
+        const char * wt = wire_type_name(t->type);
+        if (!wt) {
+            err = "arch template: the live type of " + n + " is not in the frozen type-trait table"; return -1;
+        }
+        const int nd = ggml_n_dims(t);
+        if (nd < 2) {
+            err = "arch template: live tensor " + n + " has too few axes (an expert axis is required)"; return -1;
+        }
+        int32_t layer = -1; std::string kind, suf;
+        parse_routed_tensor_name(n, layer, kind, suf);   // want_names 는 공식 생성물이라 항상 성공
+        std::string row = n;
+        row += '\t'; row += wt;
+        row += '\t';
+        for (int d = 0; d < nd; d++) {
+            if (d) row += ',';
+            row += std::to_string((long long)t->ne[d]);
+        }
+        row += '\t'; row += std::to_string(layer);
+        row += '\t'; row += pm.routed_scope;
+        row += '\n';
+        rows.push_back(std::move(row));
+    }
+    std::string got;
+    if (!inventory_digest_hex(rows, got)) { err = "arch template: inventory digest computation failed"; return -1; }
+    if (got != ex_inv) {
+        err = "independently recomputed inventory_sha256(" + got + ") != derived.expect.json inventory_sha256(" +
+              ex_inv + ") - the engine's arch-formula closure disagrees with the producer's derivation"; return -1;
+    }
+    out_inventory_sha = got;
+    return 0;
+}
+
+// ===========================================================================
+// §11. seal 공통 로직 (v2 — 프로덕션/테스트 공유). 호출자는 g_mod.mutex 보유.
+//      반환 0=성공, <0=실패(err에 사유).
+// ===========================================================================
+
+int seal_common_locked_v2(const std::wstring & dir_w,
+                          const ggml_moe_direct_model & model,
+                          const ggml_moe_direct_source * srcs, int32_t n_srcs,
+                          bool allow_sector_fallback,
+                          uint64_t budget_bytes, uint32_t touch_abort,
+                          const std::wstring & expects_dir_w,
+                          const char * override_profile_id, const char * override_digest,
+                          const char * override_scope,
+                          std::string & err) {
+    if (g_mod.sealed) { err = "already sealed"; return -1; }
+
+    // ---- manifest 로드+검증(§4-1 전항 + 불변식 8) ----
+    std::wstring manifest_path = dir_w + L"\\manifest.json";
+    std::wstring bin_path = dir_w + L"\\experts.bin";
+
+    // ★trace fail-closed 게이트(§4-5·배선 S12 v4) — 모든 uint8 cast(kernel trace 경로)보다 선행.
+    // wire expert 필드는 v4에서도 uint8(0xFF=NA)로 불변이므로 n_expert>255 && trace 활성이면 기동
+    // 중단(ID 255=NA 센티널과 충돌 → 불완전 트레이스 방지). model.n_expert를 쓰며(manifest 검증
+    // 전이라도 안전 — 값 불일치는 아래 validate가 별도로 잡는다), 이 게이트가 seal 전체에서 가장 이르다.
+    if (model.n_expert > 255 && ggml_moe_trace_enabled()) {
+        err = "trace enabled and n_expert(" + std::to_string(model.n_expert) +
+              ") > 255 - exceeds the wire v4 uint8 expert limit (fail-closed, startup aborted)";
+        return -1;
+    }
+
+    json j;
+    if (!load_manifest_json(manifest_path, j, err)) return -1;
+    ParsedManifest pm;
+    if (!validate_manifest_v2(j, model, srcs, n_srcs, pm, err)) return -1;
+
+    // ---- ★F1 reference_lock 소비자 결속(설계 §3 불변식 8 — 소비자 기동 검증이 독립 재확인) ----
+    // ① profile_id 카탈로그 등재 ② manifest.expect_sha256 == 승인 digest ③ expect 파일 재해시
+    // == 승인 digest ④ 재팩 미완료 표식(experts.bin.partial) 부재 ⑤ verify_report.json 마지막
+    // 레코드가 **verify 게이트 통과**(pass==true·pairs 등식·결함 배열 3종 공집합) + reference_lock
+    // == manifest ⑥ ★report.manifest_sha256 == manifest.json 실제 바이트 해시(cache key 결속 —
+    // 타 산출물 report 재사용/verify 이후 manifest 변경 차단). 하나라도 실패/미설정 = seal 중단(fail-closed).
+    // ★R4 — 게이트 ⑦이 계산한 manifest 실SHA 를 seal 밖으로 보존한다(구: 대조 후 폐기).
+    std::string repack_manifest_sha;
+    std::string template_inventory_sha;
+    {
+        // ★OPEN_ARCH B축(§2-2): reference_lock.profile_id 의 "arch-template:" 접두 = template 분기.
+        //   접두가 없으면 아래 model-pin 경로는 무변경이다(분기는 expect 승인부에만·additive).
+        const size_t tpl_pre_len = std::strlen(ARCH_TEMPLATE_LOCK_PREFIX);
+        const bool is_arch_template =
+            pm.ref_profile_id.size() > tpl_pre_len &&
+            pm.ref_profile_id.compare(0, tpl_pre_len, ARCH_TEMPLATE_LOCK_PREFIX) == 0;
+        if (is_arch_template) {
+            if (arch_template_gate_locked(dir_w, model, pm, template_inventory_sha, err) != 0) return -1;
+        } else {
+        if (expects_dir_w.empty()) { err = "MOE_DIRECT_EXPECTS_DIR is not set (reference_lock cannot be bound; fail-closed)"; return -1; }
+        std::string approved, approved_scope;
+        if (!catalog_lookup(pm.ref_profile_id, override_profile_id, override_digest, override_scope, approved, approved_scope)) {
+            err = "reference_lock.profile_id is not registered (not in the catalog): " + pm.ref_profile_id; return -1;
+        }
+        if (to_lower_hex(pm.ref_expect_sha256) != to_lower_hex(approved)) {
+            err = "manifest.reference_lock.expect_sha256 != approved catalog digest"; return -1;
+        }
+        // ★부록A: 카탈로그 scope == manifest routed_scope(정규화 후) 4자 일치의 소비자 몫 — 불일치=fail-closed.
+        if (approved_scope != pm.routed_scope) {
+            err = "catalog scope(" + approved_scope + ") != manifest routed_scope(" + pm.routed_scope + ")"; return -1;
+        }
+        std::wstring expect_path = expects_dir_w + L"\\" + utf8_to_wide(pm.ref_profile_id) + L".expect.json";
+        std::string file_sha, sherr;
+        if (!sha256_file(expect_path, file_sha, sherr)) { err = "cannot re-hash the expect file: " + sherr; return -1; }
+        if (to_lower_hex(file_sha) != to_lower_hex(approved)) {
+            err = "re-hashed expect file != approved digest (tampered or misplaced)"; return -1;
+        }
+        }   // ★§2-3c: 아래 후반부(partial 마커·verify_report PASS 게이트·manifest cache-key 결속)는
+            //   template 분기도 **동일 코드로** 통과한다 — 분기는 expect 승인부에서 끝난다.
+        // ★재팩 미완료 표식 — 프로듀서는 experts.bin 쓰기 직전에 <dir>\experts.bin.partial 을 만들고
+        // verify pass 일 때만 제거한다(repack_experts.py:1002·1027·1099·1100). 잔존 = 중단된 재팩
+        // 또는 verify 미통과 산출물 → seal 거부. ★INVALID_FILE_ATTRIBUTES는 "부재"만이 아니라
+        // 모든 조회 실패(ACL·경로·파일시스템 오류)에서 반환된다 — ERROR_FILE_NOT_FOUND만 부재로
+        // 인정하고 그 외 오류는 부재 확증 불가로 seal 거부(fail-closed·Codex 교차 정정 반영).
+        std::wstring partial_path = dir_w + L"\\experts.bin.partial";
+        if (GetFileAttributesW(partial_path.c_str()) != INVALID_FILE_ATTRIBUTES) {
+            err = "incomplete-repack marker present (experts.bin.partial) - aborted or unverified artifact (fail-closed)"; return -1;
+        }
+        {
+            const DWORD gle = GetLastError();
+            if (gle != ERROR_FILE_NOT_FOUND) {
+                err = "cannot query the incomplete-repack marker (experts.bin.partial) (GetLastError=" + std::to_string((unsigned long)gle) +
+                      ") - cannot confirm its absence (fail-closed)"; return -1;
+            }
+        }
+        std::string vr_pid, vr_sha, vr_manifest_sha, vrerr;
+        std::wstring vr_path = dir_w + L"\\verify_report.json";
+        if (!read_verify_report_gate(vr_path, vr_pid, vr_sha, vr_manifest_sha, vrerr)) { err = "verify_report gate failed: " + vrerr; return -1; }
+        if (vr_pid != pm.ref_profile_id || to_lower_hex(vr_sha) != to_lower_hex(pm.ref_expect_sha256)) {
+            err = "verify_report.reference_lock != manifest.reference_lock"; return -1;
+        }
+        // ★⑦ cache key 결속: report 가 검증했다고 주장하는 manifest 바이트 == 지금 로드한 manifest.json.
+        // 불일치 = 타 재팩물의 report 를 옮겨왔거나 verify 이후 manifest 가 바뀐 것 → seal 거부.
+        // (한계: verify 이후의 experts.bin bit-rot 은 이 키로 검출되지 않는다 — 신뢰 입력 모델·
+        //  reviews/codex_verify_gate_xcheck.md §3 명시. bin 전량 재읽기는 기각안.)
+        {
+            std::string mf_sha, mferr;
+            if (!sha256_file(manifest_path, mf_sha, mferr)) { err = "cannot re-hash manifest.json: " + mferr; return -1; }
+            repack_manifest_sha = to_lower_hex(mf_sha);   // ★R4 — identity echo 원천(추가 I/O 0)
+            if (to_lower_hex(mf_sha) != to_lower_hex(vr_manifest_sha)) {
+                err = "verify_report.manifest_sha256 != actual manifest.json hash - this report did not "
+                      "verify this manifest (report reused from another artifact, or manifest changed after verify; fail-closed)"; return -1;
+            }
+        }
+    }
+
+    // ---- 이름→(mlpos,part_idx) 해소 맵 + M_all ----
+    std::unordered_map<std::string, std::pair<int32_t,int32_t>> name_to_lp;
+    for (size_t mlpos = 0; mlpos < pm.layers.size(); mlpos++) {
+        for (size_t pidx = 0; pidx < pm.layers[mlpos].parts.size(); pidx++) {
+            const std::string & nm = pm.layers[mlpos].parts[pidx].source_tensor;
+            if (name_to_lp.count(nm)) { err = "M_all duplicate source_tensor: " + nm; return -1; }
+            name_to_lp[nm] = { (int32_t)mlpos, (int32_t)pidx };
+        }
+    }
+
+    // ---- ★부록A dual-scope: 집합 선택(등록은 전수 유지·seal 내에서 scope 집합만 관리 대상).
+    //      L_raw = pending 전수 / L_exec = layer < (n_layer - n_layer_nextn) 인 pending.
+    //      all → M == L_raw / execution → M == L_exec. 제외분(execution)은 등록 해제(일반 mmap 잔류). ----
+    const bool is_execution = (pm.routed_scope == "execution");
+    const int32_t exec_threshold = model.n_layer - model.n_layer_nextn;
+    std::vector<char> pending_kept(g_mod.pending.size(), 1);
+    if (is_execution) {
+        for (size_t i = 0; i < g_mod.pending.size(); i++) {
+            int32_t player = -1;
+            if (!parse_blk_layer(g_mod.pending[i].name, player)) {
+                err = "execution scope: cannot parse the layer from a pending tensor name: " + g_mod.pending[i].name; return -1;
+            }
+            pending_kept[i] = (player < exec_threshold) ? 1 : 0;
+        }
+    }
+
+    // ---- 등록 3집합 대조: M_all == L_scope 양방향(§4-2① · 부록A scope 적용) ----
+    // L_scope = pending 중 관리 대상(all=전수·execution=layer<threshold). M_all = manifest parts flatten.
+    {
+        std::unordered_map<std::string, int> l_seen; // scope 집합(kept)만
+        int32_t l_kept = 0;
+        for (size_t i = 0; i < g_mod.pending.size(); i++) {
+            if (!pending_kept[i]) continue; // execution 제외분 — M 대조에서 빠짐(등록 해제 대상)
+            const std::string & nm = g_mod.pending[i].name;
+            if (l_seen.count(nm)) { err = "L_scope duplicate registration: " + nm; return -1; }
+            l_seen[nm] = 1;
+            l_kept++;
+            if (!name_to_lp.count(nm)) { err = "L_scope overflow (tensor absent from the manifest): " + nm; return -1; }
+        }
+        if (l_kept != (int32_t)name_to_lp.size()) {
+            err = "L_scope(" + std::to_string(l_kept) + ") != M_all(" + std::to_string(name_to_lp.size()) + ")";
+            return -1;
+        }
+        for (const auto & kv : name_to_lp) {
+            if (!l_seen.count(kv.first)) { err = "M_all missing (tensor absent from the scope set): " + kv.first; return -1; }
+        }
+    }
+
+    // ---- experts.bin 실물 크기 대조 ----
+    HANDLE probe = CreateFileW(bin_path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr,
+                                OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (probe == INVALID_HANDLE_VALUE) { err = "cannot open experts.bin (size query) err=" + std::to_string(GetLastError()); return -1; }
+    LARGE_INTEGER file_size{};
+    BOOL got_size = GetFileSizeEx(probe, &file_size);
+    CloseHandle(probe);
+    if (!got_size) { err = "experts.bin GetFileSizeEx failed"; return -1; }
+    if ((uint64_t)file_size.QuadPart != pm.bin_file_bytes) {
+        err = "experts.bin actual size mismatch: " + std::to_string(file_size.QuadPart) + " != " + std::to_string(pm.bin_file_bytes);
+        return -1;
+    }
+
+    // ---- 섹터 재질의 ----
+    uint64_t a_runtime = 0;
+    if (!query_a_runtime(bin_path, allow_sector_fallback, a_runtime, err)) return -1;
+    if (pm.align_bytes % a_runtime != 0) { err = "align_bytes % A_runtime != 0 (A_runtime=" + std::to_string(a_runtime) + ")"; return -1; }
+    // slot_stride_max 도 A_runtime 배수(모든 stride가 align_bytes 배수·align_bytes%A_runtime==0)
+    if (pm.slot_stride_max % a_runtime != 0) { err = "slot_stride_max % A_runtime != 0"; return -1; }
+
+    // ---- 데이터 파일 오픈(NO_BUFFERING|OVERLAPPED) ----
+    HANDLE data_file = CreateFileW(bin_path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr,
+                                    OPEN_EXISTING, FILE_FLAG_NO_BUFFERING | FILE_FLAG_OVERLAPPED, nullptr);
+    if (data_file == INVALID_HANDLE_VALUE) { err = "cannot open experts.bin err=" + std::to_string(GetLastError()); return -1; }
+
+    // ---- 슬롯 용량 불변식(§4-7): n_slots >= n_expert ----
+    if (pm.slot_stride_max == 0) { CloseHandle(data_file); err = "slot_stride_max==0"; return -1; }
+    int32_t n_slots = (int32_t)(budget_bytes / pm.slot_stride_max);
+    if (n_slots < pm.n_expert) {
+        CloseHandle(data_file);
+        err = "slot capacity invariant violated: n_slots(" + std::to_string(n_slots) + ") < n_expert(" +
+              std::to_string(pm.n_expert) + ") - budget_bytes(" + std::to_string(budget_bytes) +
+              ") < n_expert*slot_stride_max(" + std::to_string((uint64_t)pm.n_expert * pm.slot_stride_max) + ")";
+        return -1;
+    }
+    size_t pool_bytes = (size_t)n_slots * (size_t)pm.slot_stride_max;
+    void * pool_base = VirtualAlloc(nullptr, pool_bytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!pool_base) { CloseHandle(data_file); err = "VirtualAlloc(slot pool) failed err=" + std::to_string(GetLastError()); return -1; }
+
+    // ---- 상태 확정(레이아웃) ----
+    g_mod.arch = pm.arch;
+    g_mod.n_layer = pm.n_layer;
+    g_mod.n_expert = pm.n_expert;
+    g_mod.n_expert_used = pm.n_expert_used;
+    g_mod.moe_layers = pm.moe_layers;
+    g_mod.layer_to_mlpos.clear();
+    for (size_t i = 0; i < pm.moe_layers.size(); i++) g_mod.layer_to_mlpos[pm.moe_layers[i]] = (int32_t)i;
+    g_mod.layers = std::move(pm.layers);
+    g_mod.sources = std::move(pm.sources);
+    g_mod.align_bytes = pm.align_bytes;
+    g_mod.slot_stride_max = pm.slot_stride_max;
+    g_mod.bin_file_bytes = pm.bin_file_bytes;
+    g_mod.ref_profile_id = pm.ref_profile_id;
+    g_mod.ref_expect_sha256 = pm.ref_expect_sha256;
+    g_mod.repack_manifest_sha256 = repack_manifest_sha;   // ★R4 — 재팩물 단위 identity 축
+    g_mod.template_inventory_sha256 = template_inventory_sha; // ★OPEN_ARCH B축(template 분기에서만 비어있지 않음)
+    g_mod.routed_scope = pm.routed_scope;
+    g_mod.data_file = data_file;
+    g_mod.pool_base = pool_base;
+    g_mod.pool_bytes = pool_bytes;
+    g_mod.n_slots = n_slots;
+    g_mod.touch_abort_threshold = touch_abort;
+
+    g_mod.slots = std::vector<Slot>((size_t)n_slots);
+    for (int32_t i = 0; i < n_slots; i++) g_mod.slots[(size_t)i].base = (char *)pool_base + (size_t)i * (size_t)pm.slot_stride_max;
+    g_mod.record_table = std::vector<RecordEntry>((size_t)g_mod.moe_layers.size() * (size_t)pm.n_expert);
+
+    // ---- registry 확정(R_host만) + 텐서별 대조 + attestation(★부록A: raw/managed/excluded) ----
+    // execution 제외분(pending_kept[i]==0)은 registry/보호/슬롯 대상에서 제외 — 등록 해제(일반 mmap 잔류).
+    int32_t att_raw = 0, att_managed = 0, att_host = 0, att_nonhost = 0;
+    g_mod.registry.clear();
+    for (size_t i = 0; i < g_mod.pending.size(); i++) {
+        const PendingReg & pr = g_mod.pending[i];
+        att_raw++;
+        if (!pending_kept[i]) continue; // 제외분 — direct 등록·보호·슬롯 대상 아님(일반 mmap 잔류)
+        att_managed++;
+        auto lp = name_to_lp[pr.name];
+        int32_t mlpos = lp.first, pidx = lp.second;
+        const PartInfo & part = g_mod.layers[(size_t)mlpos].parts[(size_t)pidx];
+        // 텐서별 대조(§4-2): live ne[expert_axis]==n_expert · ggml_nbytes==part_bytes*n_expert
+        // (per-expert slice==part_bytes 는 manifest 검증에서 이미 표 재계산으로 확인). part.expert_axis
+        // 는 dims.size()-1 로 검증됨.
+        const ggml_tensor * t = pr.tensor;
+        if (t) {
+            if ((int32_t)t->ne[part.expert_axis] != pm.n_expert) {
+                err = "tensor " + pr.name + " ne[expert_axis]=" + std::to_string(t->ne[part.expert_axis]) +
+                      " != n_expert=" + std::to_string(pm.n_expert);
+                VirtualFree(pool_base, 0, MEM_RELEASE); CloseHandle(data_file); return -1;
+            }
+            uint64_t tbytes = (uint64_t)ggml_nbytes(t);
+            if (tbytes != part.part_bytes * (uint64_t)pm.n_expert) {
+                err = "tensor " + pr.name + " ggml_nbytes(" + std::to_string(tbytes) + ") != part_bytes*n_expert(" +
+                      std::to_string(part.part_bytes * (uint64_t)pm.n_expert) + ")";
+                VirtualFree(pool_base, 0, MEM_RELEASE); CloseHandle(data_file); return -1;
+            }
+        }
+        if (pr.is_host) {
+            att_host++;
+            g_mod.registry[pr.tensor] = RegEntry{ mlpos, pidx };
+        } else {
+            att_nonhost++;
+        }
+    }
+    g_mod.att_raw = att_raw;
+    g_mod.att_managed = att_managed;
+    g_mod.att_excluded_nextn = att_raw - att_managed;
+    g_mod.att_all = att_managed; // ★부록A: 기존 att_all 의미=managed로 자연 수렴(all이면 raw==managed·excluded 0)
+    g_mod.att_host = att_host;
+    g_mod.att_nonhost = att_nonhost;
+    g_mod.att_n_slots = n_slots;
+    g_mod.att_n_slots_required = pm.n_expert;
+
+    // ---- 등록 텐서 보호(PAGE_NOACCESS) + interval 표(R_host만) ----
+    g_mod.reg_tensor_info.clear();
+    g_mod.reg_tensor_info.reserve(g_mod.registry.size());
+    std::vector<ProtInterval> raw_intervals;
+    raw_intervals.reserve(g_mod.registry.size());
+
+    for (auto & kv : g_mod.registry) {
+        const ggml_tensor * t = kv.first;
+        const RegEntry & re = kv.second;
+        int32_t tidx = (int32_t)g_mod.reg_tensor_info.size();
+        RegisteredTensorInfo info{};
+        info.layer = g_mod.moe_layers[(size_t)re.mlpos];
+        info.part = re.part_idx;
+        info.addr_start = (uintptr_t)t->data;
+        info.nbytes = ggml_nbytes(t);
+        g_mod.reg_tensor_info.push_back(info);
+
+        uintptr_t byte_start = info.addr_start;
+        uintptr_t byte_end = byte_start + info.nbytes;
+        uintptr_t astart = (uintptr_t)align_up(byte_start, 4096);
+        uintptr_t aend   = (uintptr_t)align_down(byte_end, 4096);
+        if (aend <= astart) continue;
+        DWORD old_protect = 0;
+        if (!VirtualProtect((LPVOID)astart, aend - astart, PAGE_NOACCESS, &old_protect)) {
+            VirtualFree(pool_base, 0, MEM_RELEASE);
+            CloseHandle(data_file);
+            err = "VirtualProtect(PAGE_NOACCESS) failed err=" + std::to_string(GetLastError());
+            return -1;
+        }
+        ProtInterval iv{};
+        iv.start = astart; iv.end = aend; iv.tensor_idx = tidx; iv.page_base_index = 0;
+        raw_intervals.push_back(iv);
+    }
+
+    std::sort(raw_intervals.begin(), raw_intervals.end(),
+              [](const ProtInterval & a, const ProtInterval & b) { return a.start < b.start; });
+    uint32_t total_pages = 0;
+    for (auto & iv : raw_intervals) { iv.page_base_index = total_pages; total_pages += (uint32_t)((iv.end - iv.start) / 4096); }
+    g_mod.prot_intervals = std::move(raw_intervals);
+
+    g_mod.page_touched = std::vector<std::atomic<uint8_t>>(total_pages);
+    for (auto & a : g_mod.page_touched) a.store(0, std::memory_order_relaxed);
+    g_mod.touch_ring = std::vector<TouchLogEntry>(256);
+    g_mod.touch_ring_next.store(0, std::memory_order_relaxed);
+    g_mod.touch_events.store(0, std::memory_order_relaxed);
+    g_mod.touch_pages.store(0, std::memory_order_relaxed);
+
+    // ---- ★QD 레버 상한 해소(reviews/codex_qd_u6_design_xcheck.md 심의 3 D-2) ----
+    // MOE_DIRECT_QD = 한 배치 acquire의 최대 outstanding read 수. 양의 정수만 수용하고 그 외
+    // (비정수·0·음수)는 경고 로그 후 기본값. 상한 63으로 clamp(회수가 WaitForMultipleObjects
+    // 한도 안이어야 함). ★metrics header 기록(바로 아래)보다 앞서야 하므로 이 위치.
+    {
+        int32_t qd = MOE_DIRECT_QD_DEFAULT;
+        const char * qd_src = "default";
+        const std::string qs = getenv_str("MOE_DIRECT_QD");
+        if (!qs.empty()) {
+            char * endp = nullptr;
+            long v = strtol(qs.c_str(), &endp, 10);
+            if (endp && *endp == '\0' && v > 0) {
+                qd = (v > (long)MOE_DIRECT_QD_MAX) ? MOE_DIRECT_QD_MAX : (int32_t)v;
+                qd_src = "env";
+            } else {
+                log_err("MOE_DIRECT_QD=\"%s\" is invalid (positive integers only) - using the default %d",
+                        qs.c_str(), (int)MOE_DIRECT_QD_DEFAULT);
+            }
+        }
+        g_mod.qd_effective = qd;
+        g_mod.qd_source = qd_src;
+    }
+
+    // ---- ★B1 selector 해소(PHASEB_DESIGN §2 하드 구속 — seal 전 1회·이후 immutable) ----
+    // ①qualification/test mode에서만 선택자가 존재 ②seal 전 1회 해소 ③미지정 production 기본값
+    // = persistent ④test mode 밖 legacy 요청 = fail-close ⑤선택값 header echo
+    // ⑥같은 commit/binary/config에서 selector만 바꿔도 Phase A v1 wire·ordered digest 불변.
+    // ★metrics header 기록보다 앞서야 하므로 이 위치(QD 해소 바로 뒤).
+    {
+        // ★"명시적" qualification mode = env MOE_DIRECT_QUALIFY=1 뿐이다(seal_for_test 라는 사실
+        //   만으로 암묵 허용하지 않는다 — 그래야 ④ fail-close가 실제로 행사 가능한 규약이 된다).
+        const bool qualify = getenv_flag_is_1("MOE_DIRECT_QUALIFY");
+        bool        persistent = true;
+        const char * src = "default";
+        const std::string want = getenv_str("MOE_DIRECT_IO_PATH");
+        if (!want.empty()) {
+            if (want == "persistent") {
+                persistent = true;
+                src = qualify ? "qualify" : "env";
+            } else if (want == "legacy") {
+                if (!qualify) {
+                    CloseHandle(data_file);
+                    VirtualFree(pool_base, 0, MEM_RELEASE);
+                    err = "MOE_DIRECT_IO_PATH=legacy is allowed only in qualification/test mode "
+                          "(MOE_DIRECT_QUALIFY=1) - fail-close";
+                    return -1;
+                }
+                persistent = false;
+                src = "qualify";
+            } else {
+                CloseHandle(data_file);
+                VirtualFree(pool_base, 0, MEM_RELEASE);
+                err = "MOE_DIRECT_IO_PATH unknown value (persistent|legacy only): " + want;
+                return -1;
+            }
+        }
+        g_mod.io_path_persistent = persistent;
+        g_mod.io_path_source     = src;
+        g_mod.io_path_qualified  = qualify;
+    }
+
+    // ---- ★정정 6호 — 오힌트 test 표면 게이팅(SPEC_PHASEB_TEST_HINT §1) ----
+    //   MOE_DIRECT_PHASEB_TEST_HINT 는 qualification 전용 표면이다. ①qualifier 부재 ②무효값
+    //   ③MOE_DIRECT_PHASEB=equiv 동시 설정 = init fail-close(명시 stderr + seal 거부).
+    //   ★위치 구속: 바로 아래 B2 블록의 note_seal 이 capture 풀·intent_q·predictor worker 를
+    //   기동하므로, 이 검사는 **그보다 앞**이어야 "resource/worker 기동 전 거부"가 성립한다.
+    //   qualifier 판정은 위에서 해소된 기존 latch(g_mod.io_path_qualified)를 그대로 쓴다.
+    {
+        const char * th_reason = nullptr;
+        if (ggml_moe_phaseb_test_hint_precheck(g_mod.io_path_qualified, &th_reason) != 0) {
+            CloseHandle(data_file);
+            VirtualFree(pool_base, 0, MEM_RELEASE);
+            err = std::string("MOE_DIRECT_PHASEB_TEST_HINT fail-close: ") + (th_reason ? th_reason : "");
+            return -1;
+        }
+    }
+
+    // ---- ★B2 프리페치 k/N 해소(SPEC_PHASEB_WIRE §1 — 기동 1회·이후 immutable·echo) ----
+    //      K·N 둘 다 설정·둘 다 유효일 때만 ON. 하나라도 미설정/무효 = OFF + off_reason echo.
+    //      ★metrics header 기록보다 앞서야 하므로 이 위치(selector 해소 바로 뒤).
+    {
+        ggml_moe_phaseb_resolve_prefetch(g_mod.qd_effective);
+        std::vector<uint64_t> pb_strides;
+        pb_strides.reserve(g_mod.layers.size());
+        for (const auto & L : g_mod.layers) pb_strides.push_back(L.stride_bytes);
+        // note_seal에서 모델 상수 확정 + (프리페치 ON이면) capture 풀/intent_q/worker 기동.
+        ggml_moe_phaseb_note_seal(g_mod.n_expert, g_mod.n_expert_used,
+                                  (int32_t)g_mod.moe_layers.size(), n_slots, g_mod.qd_effective,
+                                  g_mod.moe_layers.data(), pb_strides.data(),
+                                  // ★R1 #5 ② — 스냅샷 형상 확정(header phaseb_mem 실값)
+                                  model.n_layer - model.n_layer_nextn, model.n_embd,
+                                  model.f_norm_rms_eps > 0.0f ? model.f_norm_rms_eps : 1e-6f);
+        // ★정정 6호 — 오힌트 표면 기동 로그 1줄(SPEC_PHASEB_TEST_HINT §3). offset 은 seal 에서
+        //   확정되므로 note_seal 뒤에 찍는다(단일 출처 — direct 가 n_expert 를 재계산하지 않음).
+        if (ggml_moe_phaseb_test_hint_rule() != GGML_MOE_PHASEB_TEST_HINT_NONE) {
+            fprintf(stderr, "[moe-direct][phaseb-test-hint] rule=%s offset=%d n_expert=%d\n",
+                    ggml_moe_phaseb_test_hint_rule_name(),
+                    (int)ggml_moe_phaseb_test_hint_offset(), (int)g_mod.n_expert);
+            fflush(stderr);
+        }
+        g_mod.pb_served_graph.assign(g_mod.moe_layers.size(), GGML_MOE_PHASEB_NA_U32);
+        g_mod.pb_prefetch_on = ggml_moe_phaseb_prefetch_on();
+        g_mod.pb_k = ggml_moe_phaseb_prefetch_k();
+        g_mod.pb_n = ggml_moe_phaseb_prefetch_n();
+        // ★R1 #6 ② — 프리페치는 영속 dispatcher만 소비한다. legacy selector와의 조합은
+        //   소비자 없는 intent_q(무한 적재·처분 불가)를 만들므로 명시 fail-close.
+        if (g_mod.pb_prefetch_on && !g_mod.io_path_persistent) {
+            CloseHandle(data_file);
+            VirtualFree(pool_base, 0, MEM_RELEASE);
+            err = "valid MOE_DIRECT_PREFETCH_K/N combined with MOE_DIRECT_IO_PATH=legacy is not allowed - "
+                  "prefetch admission requires the persistent dispatcher (fail-close)";
+            return -1;
+        }
+        // equiv 모드 fail-close(§1 ★R1 #5): PA accuracy + 유효 K/N **둘 다** 필수.
+        const char * eq_reason = nullptr;
+        if (ggml_moe_phaseb_equiv_precheck(ggml_moe_phasea_mode() == GGML_MOE_PHASEA_ACCURACY,
+                                           &eq_reason) != 0) {
+            CloseHandle(data_file);
+            VirtualFree(pool_base, 0, MEM_RELEASE);
+            err = std::string("MOE_DIRECT_PHASEB=equiv fail-close: ") + (eq_reason ? eq_reason : "");
+            return -1;
+        }
+        // ★observe 모드 seal 전제 fail-close(SPEC_FAMILY_SIGNAL §2.1 · SPEC_PHASEB_WIRE §13):
+        //   supported adapter · PHASEA=timing · TEST_HINT 부재 · PREFETCH_K/N raw key 둘 다 부재.
+        //   판정은 note_seal 이 **자원 할당 전에** 끝냈고 여기서는 그 결과만 소비한다.
+        const char * ob_reason = nullptr;
+        if (ggml_moe_phaseb_observe_precheck(&ob_reason) != 0) {
+            CloseHandle(data_file);
+            VirtualFree(pool_base, 0, MEM_RELEASE);
+            err = std::string("MOE_DIRECT_PHASEB=observe fail-close: ") + (ob_reason ? ob_reason : "");
+            return -1;
+        }
+    }
+
+    // ---- 계측 JSONL ----
+    std::string metrics_err;
+    if (!metrics_open_if_requested_locked(metrics_err)) {
+        VirtualFree(pool_base, 0, MEM_RELEASE);
+        CloseHandle(data_file);
+        err = metrics_err;
+        return -1;
+    }
+
+    // ---- VEH 등록 ----
+    g_mod.veh_handle = AddVectoredExceptionHandler(1, moe_direct_veh_handler);
+    if (!g_mod.veh_handle) {
+        VirtualFree(pool_base, 0, MEM_RELEASE);
+        CloseHandle(data_file);
+        err = "AddVectoredExceptionHandler failed";
+        return -1;
+    }
+
+    // ---- ★프리페치 Phase A 통지(관측 전용 — off면 note_seal 자체가 즉시 반환) ----
+    //      모델 상수 + arm 시작 슬롯 상태(ledger SLOT_INIT)를 여기서 확정한다.
+    g_mod.phasea_on = ggml_moe_phasea_enabled();
+    if (g_mod.phasea_on) {
+        std::vector<uint64_t> strides;
+        strides.reserve(g_mod.layers.size());
+        for (const auto & L : g_mod.layers) strides.push_back(L.stride_bytes);
+        ggml_moe_phasea_note_seal(g_mod.n_expert, g_mod.n_expert_used,
+                                  (int32_t)g_mod.moe_layers.size(), g_mod.n_slots,
+                                  g_mod.moe_layers.data(), strides.data());
+    }
+
+    // ---- ★B1 영속 dispatcher 기동(persistent 경로에서만 — legacy는 배치 pump 그대로) ----
+    if (g_mod.io_path_persistent) {
+        std::string disp_err;
+        if (!dispatcher_start_locked(disp_err)) {
+            RemoveVectoredExceptionHandler(g_mod.veh_handle);
+            g_mod.veh_handle = nullptr;
+            VirtualFree(pool_base, 0, MEM_RELEASE);
+            CloseHandle(data_file);
+            g_mod.pool_base = nullptr; g_mod.pool_bytes = 0;
+            g_mod.data_file = INVALID_HANDLE_VALUE; // reset_for_test 이중 해제 방지
+            err = disp_err;
+            return -1;
+        }
+    }
+
+    g_mod.sealed.store(true, std::memory_order_release);
+    return 0;
+}
