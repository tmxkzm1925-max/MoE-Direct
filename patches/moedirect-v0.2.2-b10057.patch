+    constexpr uint64_t FILETIME_UNIX_EPOCH_DIFF_100NS = 116444736000000000ULL;
+    if (uli.QuadPart < FILETIME_UNIX_EPOCH_DIFF_100NS) return false;
+    mtime_epoch = (int64_t)((uli.QuadPart - FILETIME_UNIX_EPOCH_DIFF_100NS) / 10000000ULL);
+    return true;
+}
