+// ── P20. ★CUT straddler 봉인(R4) — barrier 로 CUT↔capture 승패를 **결정론적으로** 통제한다 ──
+//    arm A: CUT 가 등록보다 선승 → 그 capture 의 관측 mutation **0**(counter·skip·digest 전건 불변)
+//    arm B: capture 등록이 선승 → CUT 가 완료를 대기하고, **저장된 summary 에 그 capture 분이 포함**
+//           (메모리 불변만이 아니라 wire ↔ 최종 상태 일치까지 확인)
+struct PbObs {
+    PbCtr    ctr;
+    PbDigests dg;
+    uint64_t skip[GGML_MOE_PB_SKIP_COUNT] = {0};
+    bool operator==(const PbObs & o) const {
+        for (int i = 0; i < GGML_MOE_PB_C_COUNT; i++)    if (ctr.v[i] != o.ctr.v[i]) return false;
+        for (int i = 0; i < GGML_MOE_PB_SKIP_COUNT; i++) if (skip[i]  != o.skip[i])  return false;
+        return dg == o.dg;
+    }
+};
+static PbObs pb_obs() {
+    PbObs o; o.ctr = pb_ctr(); o.dg = pb_digests();
+    for (int i = 0; i < GGML_MOE_PB_SKIP_COUNT; i++) o.skip[i] = ggml_moe_phaseb_skip_counter(i);
+    return o;
+}
+// metrics summary 한 줄에서 pb_* 카운터를 뽑는다(wire ↔ 최종 상태 대조용).
+static uint64_t pb_summary_u64(const std::wstring & metrics, const char * key) {
+    std::ifstream ifs(metrics, std::ios::binary);
+    std::string line; uint64_t v = (uint64_t)-1;
+    while (std::getline(ifs, line)) {
+        while (!line.empty() && (line.back()=='\r'||line.back()=='\n')) line.pop_back();
+        if (line.empty()) continue;
+        json j = json::parse(line, nullptr, false);
+        if (j.is_object() && j.value("type","") == "summary" && j.contains(key)) v = j[key].get<uint64_t>();
+    }
+    return v;
+}
