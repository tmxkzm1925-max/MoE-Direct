+    int32_t tid_drop_layer   = -1;   // hash 층의 tid2eid 제거
+    int32_t ep_extra_layer   = -1;   // hash 층에 exp_probs_b 부착
+    int32_t ep_drop_layer    = -1;   // 학습 라우팅 층의 exp_probs_b 제거
+    bool    tid_type_bad     = false;
+    bool    tid_shape_bad    = false;
