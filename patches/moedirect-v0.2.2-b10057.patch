+// ===========================================================================
+// O. ★B1 영속 I/O dispatcher (PHASEB_DESIGN §2 · §7 착지 관문)
+//    selector 규약(test 밖 legacy=fail-close·echo) / legacy↔persistent 8단계 동형(ABBA) /
+//    control_q 만석 대기 무손실 + in-flight join(C2) / lost-wake / 재진입 /
+//    shutdown·abort cancel-terminal drain / 256E u16 / reset drain / mem echo(B2 자원 0).
+// ===========================================================================
+
+// ★환경변수 임시 설정/복원. O 픽스처는 selector/QD를 스스로 통제해야 하지만, 외부에서
+// selector를 강제해 전 구간 회귀를 돌리는 실행(예: MOE_DIRECT_IO_PATH=legacy)에서 주변 환경을
+// 파괴하면 그 뒤 섹션들이 의도와 다른 경로로 돈다 — 반드시 원복한다.
+struct EnvGuard {
+    std::string name, prev;
+    bool had = false;
+    EnvGuard(const char * n, const char * v) : name(n) {
+        const char * p = std::getenv(n);
+        had = (p != nullptr && p[0] != '\0');
+        if (had) prev = p;
+        if (v) set_env(n, v); else clear_env(n);
+    }
+    ~EnvGuard() { if (had) set_env(name.c_str(), prev); else clear_env(name.c_str()); }
+};
+
+struct B1Stats {
+    uint64_t demand = 0, release = 0, query = 0, join = 0, cancel = 0, abort_terminal = 0;
+    uint64_t q_full_waits = 0, q_max_depth = 0;
+    int32_t  persistent = -1;
+};
+static B1Stats b1_stats() {
+    B1Stats s;
+    ggml_moe_direct_test_dispatcher_stats(&s.demand, &s.release, &s.query, &s.join, &s.cancel,
+                                          &s.abort_terminal, &s.q_full_waits, &s.q_max_depth, &s.persistent);
+    return s;
+}
+
+// selector/QD를 지정해 M8과 동일한 요청 시퀀스를 완주한 뒤의 최종 상태 + digest.
+// ★metrics를 켜야 ordered ReadFile digest가 갱신된다(기존 게이트 불변) — case 디렉토리에 기록.
+struct B1RunState {
+    bool ok = false, bytes_ok = true;
+    QdStateSnap snap;
+    uint64_t rb[2] = {0,0}, hit[2] = {0,0}, miss[2] = {0,0};
+    uint64_t readfile_digest = 0, readfile_ops = 0, lru_digest = 0, tick_final = 0;
+    int32_t  persistent = -1;
+    uint64_t demand_cmd = 0;
+};
+static B1RunState b1_run_sequence(const char * tag, const char * qd_value, const char * io_path) {
+    B1RunState st;
+    EnvGuard eg_qd("MOE_DIRECT_QD", qd_value);
+    EnvGuard eg_q("MOE_DIRECT_QUALIFY", io_path ? "1" : nullptr);
+    EnvGuard eg_p("MOE_DIRECT_IO_PATH", io_path);
+    Fixture fx; qd_setup_2layer(fx, tag);
+    EnvGuard eg_m("MOE_DIRECT_METRICS", wide_to_utf8(fx.dir + L"\\metrics.jsonl").c_str());
+    int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+    if (rc != 0) return st;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    struct Step { ggml_tensor * t; int32_t mlpos; std::vector<int32_t> ids; };
+    std::vector<Step> steps = {
+        { g0, 0, {0,1,2} }, { g1, 1, {0,1} }, { g0, 0, {2,3,4,5} },
+        { g1, 1, {2,3,4,5,6,7} }, { g0, 0, {0,0,7} }, { g1, 1, {7,7} }, { g0, 0, {1,6,6} },
+    };
+    for (auto & s : steps) {
+        const int32_t n = (int32_t)s.ids.size();
+        if (ggml_moe_direct_acquire(s.t, s.ids.data(), n, n) != 0) { st.bytes_ok = false; break; }
+        for (int32_t e : s.ids) {
+            const char * nm = s.mlpos == 0 ? "blk.0.ffn_gate_exps.weight" : "blk.1.ffn_gate_exps.weight";
+            if (!verify_ptr_bytes(fx, nm, s.mlpos, 0, e)) st.bytes_ok = false;
+        }
+        ggml_moe_direct_release(s.t, s.ids.data(), n);
+    }
+    st.snap = qd_snapshot(16);
+    for (int p = 0; p < 2; p++) ggml_moe_direct_phase_read_bytes_hit_miss(p, &st.rb[p], &st.hit[p], &st.miss[p]);
+    ggml_moe_direct_test_digests(&st.readfile_digest, &st.readfile_ops, &st.lru_digest, &st.tick_final);
+    const B1Stats bs = b1_stats();
+    st.persistent = bs.persistent;
+    st.demand_cmd = bs.demand;
+    st.ok = true;
+    return st;
+}
+
+static bool b1_same_run(const B1RunState & a, const B1RunState & b) {
+    bool same = a.ok && b.ok && a.bytes_ok && b.bytes_ok && (a.snap == b.snap) &&
+                a.readfile_digest == b.readfile_digest && a.readfile_ops == b.readfile_ops &&
+                a.lru_digest == b.lru_digest && a.tick_final == b.tick_final;
+    for (int p = 0; p < 2; p++) same = same && a.rb[p] == b.rb[p] && a.hit[p] == b.hit[p] && a.miss[p] == b.miss[p];
+    return same;
+}
