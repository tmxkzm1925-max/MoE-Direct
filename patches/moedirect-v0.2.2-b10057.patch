+    check(cap_rc == 1 && dg.intent_count == 1 && dg.intent == ref_post && dg.intent != ref_nat,
+          "P25-③b. ★intent digest = **post-transform** ids 기반(자연 ids digest 와 불일치 확인)");
+
+    const std::vector<ggml_moe_phaseb_sample> smp = pb_read_samples();
+    bool row_ok = false;
+    for (const auto & s : smp) {
+        if (s.layer != 1 || !(s.flags & 0x01)) continue;
+        row_ok = true;
+        for (int i = 0; i < 16 && row_ok; i++) row_ok = (s.intent_ids[i] == expect[i]);
+        if (row_ok) row_ok = (s.source_layer == 0 && s.k_effective == 8 &&
+                              s.intent_ordinal != GGML_MOE_PHASEB_NA_U64);
+    }
+    check(row_ok, "P25-③c. ★pb_sample.intent_ids = post-transform(§4 정정 6호 의미 분기) — 행 ids = [64,65,...]");
+
+    const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+    int n_pf = 0; bool all_rot = true, none_nat = true;
+    for (const auto & r : ios) {
+        if (r.origin != 1) continue;
+        n_pf++;
+        if (!(r.expert >= 64 && r.expert <= 71)) all_rot  = false;   // rank<k(8) = 64..71
+        if (r.expert <= 7)                       none_nat = false;   // 자연 집합 유입 0건
+    }
+    check(iss1 > iss0 && n_pf > 0 && all_rot && none_nat,
+          "P25-③d. ★★dispatcher 제출 expert 전건이 변형 집합 {64..71} · 자연 집합 {0..7} 0건"
+          "(issued +" + std::to_string((long long)(iss1 - iss0)) + " · pb_io prefetch " +
+          std::to_string(n_pf) + "건)");
+
+    ggml_moe_phaseb_graph_end();
+    ggml_moe_phaseb_run_end();
+}
