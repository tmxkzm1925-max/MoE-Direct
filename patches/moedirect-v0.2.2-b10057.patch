+        std::atomic<bool> fin_done{false};
+        std::thread fin_th([&]() { ggml_moe_direct_finalize(); fin_done.store(true, std::memory_order_release); });
+        // ★R6 rendezvous — `attempted`(시도 직전)만으로는 "막혔다"의 양성 증거가 못 된다
