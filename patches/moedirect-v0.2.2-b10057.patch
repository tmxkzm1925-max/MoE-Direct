+// ── P9. wire 게이트 코드 재계산(§9) — closure·dense event seq·QD 재생·publish_seq·digest 대조 ──
+static void test_pb_wire_gates() {
+    section("P9. ★wire 게이트 재계산(§9) — C3 closure · 공용 event seq dense · QD 재생 · publish_seq · readfile digest");
+    Fixture fx; pb_setup_2layer(fx, "pb_wire");
+    PbEnv env("4", "8", "2", "trace", wide_to_utf8(fx.dir + L"\\pb").c_str(),
+              wide_to_utf8(fx.dir + L"\\metrics.jsonl").c_str());
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P9a. seal 성공(trace+사이드카)")) return;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    ggml_moe_phaseb_run_begin();
+    // graph A — 층 1의 expert 1..7을 상주시킨다(다음 graph의 사전 처분을 결정론화).
+    ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+    std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+    ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+    ggml_moe_direct_release(g1, pre.data(), 7);
+    ggml_moe_phaseb_graph_end();
+    // graph B — ★층 1 demand **이전에** intent를 밀어넣어야 too_late가 아니다(§4.2 우선순서).
+    ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+    uint32_t req = 0, gep = 0, gseq = 0; uint8_t ph = 0;
+    ggml_moe_phaseb_current_epoch(&req, &gep, &gseq, &ph);
+    int32_t l0 = 3;
+    ggml_moe_direct_acquire(g0, &l0, 1, 1);      // source 층 demand(= 이 graph의 층 0 행)
+    ggml_moe_direct_release(g0, &l0, 1);
+    pb_push_and_settle(req, gep, gseq, 0, 1, {0,1,2,3,4,5,6,7});
+    int32_t e0 = 0;
+    ggml_moe_direct_acquire(g1, &e0, 1, 1);      // 프리페치 적중 → promotion
+    ggml_moe_direct_release(g1, &e0, 1);
+    std::vector<int32_t> more = {9,10,11};
+    ggml_moe_direct_acquire(g0, more.data(), 3, 1);
+    ggml_moe_direct_release(g0, more.data(), 3);
+    ggml_moe_phaseb_graph_end();
+    ggml_moe_phaseb_run_end();
+    ggml_moe_direct_test_pb_quiesce(3000);
+
+    const PbCtr c = pb_ctr();
+    const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+    const std::vector<ggml_moe_phaseb_sample> smp = pb_read_samples();
+
+    // (1) C3 closure(§6)
+    const uint64_t candidate = c.get(GGML_MOE_PB_C_CANDIDATE);
+    const uint64_t admitted  = c.get(GGML_MOE_PB_C_ADMITTED);
+    const uint64_t issued    = c.get(GGML_MOE_PB_C_ISSUED);
+    const uint64_t failed    = c.get(GGML_MOE_PB_C_SUBMIT_FAILED);
+    const uint64_t drops     = c.get(GGML_MOE_PB_C_DROPPED_NO_SLOT_QD) + c.get(GGML_MOE_PB_C_DROPPED_PREFETCH_CAP) +
+                               c.get(GGML_MOE_PB_C_DROPPED_RESERVE);
+    const uint64_t used_join = c.get(GGML_MOE_PB_C_USED_JOIN);
+    const uint64_t used_prom = c.get(GGML_MOE_PB_C_USED_PROMOTED);
+    const uint64_t wasted    = issued - used_join - used_prom;
+    check(candidate >= 1 && candidate == admitted + drops && admitted == issued + failed &&
+          issued >= used_join + used_prom && issued >= 1,
+          "P9b. ★C3 closure — candidate(" + std::to_string(candidate) + ")=admitted+Σdrop · admitted=issued+submit_failed · "
+          "issued=used_join+used_promoted+wasted(wasted=" + std::to_string(wasted) + ")");
+
+    // (2) 공용 io event namespace(§5.1) — {submit} ∪ {terminal} 이 0..2N-1 조밀·무중복
+    std::vector<uint8_t> seen(ios.size() * 2, 0);
+    bool dense = !ios.empty();
+    for (const auto & r : ios) {
+        for (uint64_t s : { r.submit_event_seq, r.terminal_event_seq }) {
+            if (s >= seen.size() || seen[(size_t)s]) { dense = false; break; }
+            seen[(size_t)s] = 1;
+        }
+    }
+    for (uint8_t v : seen) if (!v) dense = false;
+    check(dense, "P9c. ★공용 event seq — {submit}∪{terminal} = 0..2×record_count−1 조밀·무중복(records=" +
+                 std::to_string(ios.size()) + ")");
+
+    // (3) 사건 순 재생(+1/−1)이 QD snapshot 6필드와 전건 일치 + qpc 정합
+    struct Ev { uint64_t seq; int delta; int origin; const ggml_moe_phaseb_io * r; bool is_submit; };
+    std::vector<Ev> evs;
+    for (const auto & r : ios) {
+        evs.push_back({ r.submit_event_seq,   +1, r.origin, &r, true  });
+        evs.push_back({ r.terminal_event_seq, -1, r.origin, &r, false });
+    }
+    std::sort(evs.begin(), evs.end(), [](const Ev & a, const Ev & b) { return a.seq < b.seq; });
+    int qd_d = 0, qd_p = 0;
+    bool qd_ok = true, qpc_ok = true;
+    uint64_t prev_qpc = 0;
+    for (const auto & ev : evs) {
+        if (ev.origin == 0) qd_d += ev.delta; else qd_p += ev.delta;
+        const uint8_t ed = (uint8_t)qd_d, ep = (uint8_t)qd_p, et = (uint8_t)(qd_d + qd_p);
+        if (ev.is_submit) {
+            if (ev.r->qd_demand_at_submit != ed || ev.r->qd_prefetch_at_submit != ep || ev.r->qd_total_at_submit != et) qd_ok = false;
+        } else {
+            if (ev.r->qd_demand_at_terminal != ed || ev.r->qd_prefetch_at_terminal != ep || ev.r->qd_total_at_terminal != et) qd_ok = false;
+        }
+        const uint64_t q = ev.is_submit ? ev.r->submit_qpc : ev.r->terminal_qpc;
+        if (q < prev_qpc) qpc_ok = false;
+        prev_qpc = q;
+    }
+    for (const auto & r : ios) {
+        if (r.terminal_qpc < r.submit_qpc) qpc_ok = false;
+        if (r.qd_total_at_submit != (uint8_t)(r.qd_demand_at_submit + r.qd_prefetch_at_submit)) qd_ok = false;
+        if (r.qd_total_at_terminal != (uint8_t)(r.qd_demand_at_terminal + r.qd_prefetch_at_terminal)) qd_ok = false;
+        if (r.qd_total_at_submit > 4) qd_ok = false;             // <= qd_effective
+        if (r.origin == 1 && r.qd_prefetch_at_submit > 2) qd_ok = false; // <= prefetch_n
+    }
+    check(qd_ok && qpc_ok && qd_d == 0 && qd_p == 0,
+          "P9d. ★사건 순 재생(+1/−1) = QD snapshot 6필드 전건 일치 · qd_total=demand+prefetch · "
+          "qd_total≤QD · qd_prefetch≤N · QPC 비감소 · run-end outstanding 0");
+
+    // (4) publish_seq 1..P 조밀·무중복 + terminal_status=1 ⟺ publish_seq>=1
+    std::vector<uint64_t> pubs;
+    bool status_eq = true;
+    for (const auto & r : ios) {
+        if (r.publish_seq) pubs.push_back(r.publish_seq);
+        const bool pub = r.publish_seq >= 1;
+        if ((r.terminal_status == GGML_MOE_PB_T_SUCCESS_PUBLISHED) != pub) status_eq = false;
+        if (r.reserved != 0) status_eq = false;
+        if (r.terminal_status < 1 || r.terminal_status > 4) status_eq = false;
+    }
+    std::sort(pubs.begin(), pubs.end());
+    bool pub_dense = true;
+    for (size_t i = 0; i < pubs.size(); i++) if (pubs[i] != (uint64_t)(i + 1)) pub_dense = false;
+    check(pub_dense && status_eq,
+          "P9e. ★publish_seq 1..P 조밀·무중복 · terminal_status=1 ⟺ publish_seq≥1 · reserved=0 · enum 범위");
+
+    // (5) pb_io로부터 all-origin 17B / demand-only 16B digest 재계산 대조(§8 교차 게이트)
+    std::vector<const ggml_moe_phaseb_io *> by_submit;
+    for (const auto & r : ios) by_submit.push_back(&r);
+    std::sort(by_submit.begin(), by_submit.end(),
+              [](const ggml_moe_phaseb_io * a, const ggml_moe_phaseb_io * b) { return a->submit_event_seq < b->submit_event_seq; });
+    uint64_t h_all = 0xcbf29ce484222325ull, h_dem = 0xcbf29ce484222325ull;
+    uint64_t n_all = 0, n_dem = 0;
+    for (const auto * r : by_submit) {
+        h_all = pb_fnv(h_all, &r->layer, sizeof(r->layer));
+        h_all = pb_fnv(h_all, &r->expert, sizeof(r->expert));
+        h_all = pb_fnv(h_all, &r->file_offset, sizeof(r->file_offset));
+        h_all = pb_fnv(h_all, &r->bytes, sizeof(r->bytes));
+        h_all = pb_fnv(h_all, &r->origin, sizeof(r->origin));
+        n_all++;
+        if (r->origin == 0) {
+            h_dem = pb_fnv(h_dem, &r->layer, sizeof(r->layer));
+            h_dem = pb_fnv(h_dem, &r->expert, sizeof(r->expert));
+            h_dem = pb_fnv(h_dem, &r->file_offset, sizeof(r->file_offset));
+            h_dem = pb_fnv(h_dem, &r->bytes, sizeof(r->bytes));
+            n_dem++;
+        }
+    }
+    const PbDigests dg = pb_digests();
+    uint64_t rf = 0, rf_ops = 0, lru = 0, tick = 0;
+    ggml_moe_direct_test_digests(&rf, &rf_ops, &lru, &tick);
+    check(h_all == dg.readfile && n_all == dg.readfile_ops && h_dem == rf && n_dem == rf_ops,
+          "P9f. ★readfile digest 재계산 대조 — all-origin 17B == moe_pb_readfile_digest(ops=" +
+          std::to_string(n_all) + ") · demand-only 16B == moe_readfile_digest(ops=" + std::to_string(n_dem) +
+          ") ⇒ §2.3 origin 가드 성립");
+
+    // (6) pb_sample 행 closure + rank_disposition 합 == 카운터 + reserved 0
+    bool row_ok = !smp.empty(), rsv_ok = true;
+    uint64_t disp_hist[10] = {0};
+    for (const auto & s : smp) {
+        if ((uint32_t)s.n_ready + s.n_join + s.n_demand_read != s.n_required) row_ok = false;
+        if (s.n_join > s.n_join_attempt) row_ok = false;
+        if (s.reserved0 != 0 || s.reserved1 != 0 || s.reserved2 != 0) rsv_ok = false;
+        if (s.elig_skip_reason >= GGML_MOE_PB_SKIP_COUNT) rsv_ok = false;
+        for (int r = 0; r < 16; r++) {
+            const uint8_t d = s.rank_disposition[r];
+            if (d > 9) rsv_ok = false; else disp_hist[d]++;
+            if ((s.flags & 0x01) && r < s.k_effective && d == GGML_MOE_PB_D_RANK_NA) row_ok = false;
+            if ((s.flags & 0x01) && r >= s.k_effective && d != GGML_MOE_PB_D_RANK_NA) row_ok = false;
+        }
+    }
+    const bool hist_ok =
+        disp_hist[GGML_MOE_PB_D_PRE_TOO_LATE]      == c.get(GGML_MOE_PB_C_PRE_DROPPED_TOO_LATE) &&
+        disp_hist[GGML_MOE_PB_D_PRE_STALE]         == c.get(GGML_MOE_PB_C_PRE_DROPPED_STALE) &&
+        disp_hist[GGML_MOE_PB_D_PRE_RESIDENT]      == c.get(GGML_MOE_PB_C_PRE_SKIPPED_RESIDENT) &&
+        disp_hist[GGML_MOE_PB_D_PRE_PENDING]       == c.get(GGML_MOE_PB_C_PRE_SKIPPED_PENDING) &&
+        disp_hist[GGML_MOE_PB_D_DROP_NO_SLOT_QD]   == c.get(GGML_MOE_PB_C_DROPPED_NO_SLOT_QD) &&
+        disp_hist[GGML_MOE_PB_D_DROP_PREFETCH_CAP] == c.get(GGML_MOE_PB_C_DROPPED_PREFETCH_CAP) &&
+        disp_hist[GGML_MOE_PB_D_DROP_RESERVE]      == c.get(GGML_MOE_PB_C_DROPPED_RESERVE) &&
+        disp_hist[GGML_MOE_PB_D_ISSUED]            == c.get(GGML_MOE_PB_C_ISSUED) &&
+        disp_hist[GGML_MOE_PB_D_SUBMIT_FAILED]     == c.get(GGML_MOE_PB_C_SUBMIT_FAILED);
+    check(row_ok && rsv_ok && hist_ok,
+          "P9g. ★pb_sample 행 closure(n_ready+n_join+n_demand_read=n_required) · rank<k 전건 enum 1~9 · "
+          "rank≥k 전건 RANK_NA · Σrank_disposition == 대응 카운터 · reserved 0(rows=" + std::to_string(smp.size()) + ")");
+
+    // (7) finalize CUT — 잔여 0 · 사이드카 파일 4중 잠금
+    ggml_moe_direct_finalize();
+    const std::wstring sp = fx.dir + L"\\pb_sample.pb";
+    const std::wstring ip = fx.dir + L"\\pb_io.pb";
+    const std::wstring ap = fx.dir + L"\\pb_a0equiv.pb";
+    auto read_all = [](const std::wstring & p) {
+        std::ifstream ifs(p, std::ios::binary);
+        return std::vector<uint8_t>((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
+    };
+    const std::vector<uint8_t> sb = read_all(sp), ib = read_all(ip), ab = read_all(ap);
+    bool file_ok = sb.size() >= 128 && ib.size() >= 128 && ab.empty();  // trace 모드 = sample+io 2종 정확히
+    if (file_ok) {
+        ggml_moe_phaseb_header hs{}, hi{};
+        std::memcpy(&hs, sb.data(), 128);
+        std::memcpy(&hi, ib.data(), 128);
+        file_ok = std::memcmp(hs.magic, "MOEPB1\0\0", 8) == 0 && hs.layout_version == 1 &&
+                  hs.file_kind == 2 && hs.record_bytes == sizeof(ggml_moe_phaseb_sample) &&
+                  std::memcmp(hs.kind_tag, "PB_SAMPLE_V1", 12) == 0 &&
+                  sb.size() == 128 + (size_t)hs.record_count * hs.record_bytes &&
+                  pb_fnv(0xcbf29ce484222325ull, sb.data() + 128, sb.size() - 128) == hs.payload_digest &&
+                  hs.complete == 1 && hs.dropped_records == 0 &&
+                  hs.prefetch_on == 1 && hs.prefetch_k == 8 && hs.prefetch_n == 2 && hs.qd_effective == 4 &&
+                  hi.file_kind == 3 && hi.record_bytes == sizeof(ggml_moe_phaseb_io) &&
+                  std::memcmp(hi.kind_tag, "PB_IO_V1\0\0\0\0", 12) == 0 &&
+                  ib.size() == 128 + (size_t)hi.record_count * hi.record_bytes &&
+                  pb_fnv(0xcbf29ce484222325ull, ib.data() + 128, ib.size() - 128) == hi.payload_digest &&
+                  hi.boot_id == hs.boot_id && hs.boot_id == ggml_moe_phaseb_boot_id();
+    }
+    check(file_ok,
+          "P9h. ★사이드카 4중 잠금(파일명↔file_kind↔kind_tag↔record_bytes) · 크기·payload 재해시 · "
+          "complete=1 · prefetch/qd echo · boot_id 일치 · trace 모드 = sample+io 2종 정확히");
+}
