+[[noreturn]] void fatal_abort(const char * fmt, ...) {
+    char buf[1024];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    GGML_ABORT("[moe-direct] FATAL: %s", buf);
+}
