+              std::to_string(w_cap) + " == 메모리 " + std::to_string(cap1) + " · predicted=" +
+              std::to_string(w_pred) + " — 드레인 전에 flush 하면 어긋난다)");
+        if (fin_ok) delete fx;
+    }
