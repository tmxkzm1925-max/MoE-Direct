+        ggml_moe_phaseb_test_cap_barrier_release();
+        const bool cut_got = (ggml_moe_phaseb_test_cut_wait_acquired(5000) == 0);
+        cap_th.join();
+        for (int w = 0; w < 5000 && !fin_done.load(std::memory_order_acquire); w++) Sleep(1);
+        const bool fin_ok = fin_done.load(std::memory_order_acquire) && cut_got;
+        if (fin_done.load(std::memory_order_acquire)) fin_th.join(); else fin_th.detach();
+        ggml_moe_phaseb_test_cut_rendezvous_disarm();
+        // ★★R8 — 안전 판정만 join 뒤·reset 전 **최종값**으로(거짓 PASS 창 폐쇄).
+        const bool bar_safe = (ggml_moe_phaseb_test_cap_barrier_safety_fired() == 0);
+        // ★권고 ⓐ — 실패 성분(경합)을 같은 줄에 직접 노출한다.
+        check(cut_block && bar_held && bar_safe,
