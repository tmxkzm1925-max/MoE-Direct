+    }
+    wchar_t buf[64];
+    swprintf(buf, 64, L"moe-direct-selftest-%lu", (unsigned long)GetCurrentProcessId());
+    g_scratch_root = std::wstring(tmp) + buf;
+    if (!CreateDirectoryW(g_scratch_root.c_str(), nullptr)) {
+        DWORD err = GetLastError();
+        if (err != ERROR_ALREADY_EXISTS) {
+            fprintf(stderr, "FATAL: 스크래치 루트 생성 실패 err=%lu\n", (unsigned long)err); fflush(stderr); exit(2);
+        }
+    }
+    printf("scratch root: (temp)\\%ls\n", buf);
+}
