+        bool same = true;
+        for (int i = 0; i < 16; i++) if (it.ids[i] != ref[(size_t)i]) { same = false; break; }
+        if (same) matched++;
+    }
+    ggml_moe_direct_test_dispatcher_pause(0);
+    ggml_moe_direct_test_pb_quiesce(3000);
+    ggml_moe_phaseb_run_end();
+    check(produced == 8 && matched == 8,
+          "P26d. ★★adapter 경로 산출 = 동결 경로 산출 — 8/8 입력에서 ordered top-16 배열 byte-equal(" +
+          std::to_string(matched) + "/" + std::to_string(produced) + " 일치)");
+}
