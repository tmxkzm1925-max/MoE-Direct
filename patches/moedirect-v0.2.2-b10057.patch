+// ── P15. ★PA+PB 병행 boot_id/t0 identity(R1 #4) ──
+static void test_pb_identity() {
+    section("P15. ★PA 병행 **boot_id** 3자 일치(§9 게이트 6) — t0_qpc 는 v4 확정대로 PB-local 기준시각(공유 대상 아님)");
+    ggml_moe_phasea_reset_for_test();
+    std::wstring dir = make_case_dir("pb_ident");
+    EnvGuard pa("MOE_DIRECT_PHASEA", "timing");
