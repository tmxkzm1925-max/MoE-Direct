+void pb_log(const char * fmt, ...) {
+    va_list ap; va_start(ap, fmt);
+    fprintf(stderr, "[moe-phaseb] ");
+    vfprintf(stderr, fmt, ap);
+    fprintf(stderr, "\n");
+    va_end(ap);
+    fflush(stderr);
+}
