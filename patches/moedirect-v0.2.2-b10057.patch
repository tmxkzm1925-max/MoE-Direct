+static const int32_t  PB_HINT_N_EXPERT = 128;                  // 사다리 ③ ⓪gpt-oss 형상(128E·offset 64)
+static const uint64_t PB_FNV_INIT      = 0xcbf29ce484222325ull;
+
+// 오힌트 env 는 **항상 qualifier 와 세트**로 다룬다(§1 qualification-only 결속).
+struct PbHintEnv {
+    EnvGuard hint, qualify;
