+    check(predicted > 0 && disposed == predicted * (uint64_t)ggml_moe_phaseb_prefetch_k(),
+          "P13d. ★CUT ④ 미처분 rank 0 — 처분 총수(" + std::to_string(disposed) + ") == intent(" +
+          std::to_string(predicted) + ") × k(" + std::to_string(ggml_moe_phaseb_prefetch_k()) + ")");
