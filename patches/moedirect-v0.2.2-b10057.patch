+// ── O5. control_q 만석 대기(무손실) + in-flight join(C2) ──
+static void test_b1_queue_and_join() {
+    section("O5. ★control_q 만석 대기 무손실(64 ring) + in-flight join(C2 — lease는 성공 terminal에서만)");
+
+    EnvGuard eg_q("MOE_DIRECT_QUALIFY", nullptr);
+    EnvGuard eg_p("MOE_DIRECT_IO_PATH", nullptr);
+    Fixture fx; qd_setup_2layer(fx, "b1_queue");
+    int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+    if (!check(rc == 0, "O5a. seal 성공(8슬롯)")) return;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+
+    const int NT = 70; // > ring 64 → 최소 6건이 만석 대기를 탄다
+    const uint64_t r0 = qd_reads_total();
+    ggml_moe_direct_test_dispatcher_pause(1); // dispatcher 정지 → command 적재만 진행
+
+    std::atomic<int> ok_count(0), fail_count(0);
+    std::vector<std::thread> th;
+    th.reserve(NT);
+    for (int i = 0; i < NT; i++) {
+        th.emplace_back([&]() {
+            int32_t id = 3; // ★전원 같은 record → 1건 claim + 나머지 전부 join
+            if (ggml_moe_direct_acquire(g0, &id, 1, 1) == 0) ok_count.fetch_add(1);
+            else                                             fail_count.fetch_add(1);
+        });
+    }
+    // 64건이 ring을 채우고 나머지가 만석 대기에 들어갈 때까지(최대 10초).
+    uint64_t fw = 0, depth = 0;
+    for (int i = 0; i < 1000; i++) {
+        const B1Stats s = b1_stats();
+        fw = s.q_full_waits; depth = s.q_max_depth;
+        if (fw >= (uint64_t)(NT - 64) && depth >= 64) break;
+        Sleep(10);
+    }
+    ggml_moe_direct_test_dispatcher_pause(0);
+    for (auto & t : th) t.join();
+
+    const uint64_t dr = qd_reads_total() - r0;
+    int32_t leased = -1; int64_t total = -1;
+    ggml_moe_direct_test_lease_stats(&leased, &total);
+    const B1Stats s = b1_stats();
+    printf("    (참고) q_max_depth=%llu q_full_waits=%llu join=%llu reads=%llu leased=%d total_lease=%lld\n",
+           (unsigned long long)s.q_max_depth, (unsigned long long)s.q_full_waits,
+           (unsigned long long)s.join, (unsigned long long)dr, leased, (long long)total);
+    fflush(stdout);
+    check(depth >= 64 && fw >= (uint64_t)(NT - 64),
+          "O5b. ★ring 64 만석 도달 + 초과 생산자 대기 발생(depth=" + std::to_string(depth) +
+          " full_waits=" + std::to_string(fw) + ")");
+    check(ok_count.load() == NT && fail_count.load() == 0,
+          "O5c. ★만석에서도 command 무손실 — 전건 성공(" + std::to_string(ok_count.load()) + "/" +
+          std::to_string(NT) + ")");
+    check(dr == 1 && s.join > 0 && leased == 1 && total == NT,
+          "O5d. ★in-flight join — 물리 read 1회(triple당 submit<=1) · lease는 성공 terminal에서 "
+          "aggregate 반영(total_lease=" + std::to_string(total) + " join=" + std::to_string(s.join) + ")");
+    check(verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 3),
+          "O5e. join한 전건이 같은 (slot,generation)을 공유(데이터 정합)");
+
+    std::vector<std::thread> th2;
+    th2.reserve(NT);
+    for (int i = 0; i < NT; i++) th2.emplace_back([&]() { int32_t id = 3; ggml_moe_direct_release(g0, &id, 1); });
+    for (auto & t : th2) t.join();
+    ggml_moe_direct_test_lease_stats(&leased, &total);
+    check(leased == 0 && total == 0, "O5f. release " + std::to_string(NT) + "건 후 lease 잔량 0(누수/underflow 없음)");
+}
