+// 배선 R1(사양 §6) — file header의 overwrite_count/prefill_overflow_count(uint32_t) 포화 변환.
+uint32_t saturate_u64_to_u32(uint64_t v) {
+    return v > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)v;
+}
