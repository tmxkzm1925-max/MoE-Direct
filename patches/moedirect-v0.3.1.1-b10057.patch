+GGML_API void ggml_moe_direct_test_pbv_admit_skip_witness(int32_t * out_rec_active,
+                                                          int32_t * out_intent_depth,
+                                                          int32_t * out_valid_left,
+                                                          int32_t * out_ncap_room,
+                                                          int32_t * out_credit_ok);
