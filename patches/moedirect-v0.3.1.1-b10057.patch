+//
+// [MoE-Direct 레버 A 단계 1 / S1] memplan capture API
+//
+
+llama_kv_cache::memplan_state_t llama_kv_cache::memplan_capture() const {
+    memplan_state_t st;
+
+    st.v_cells = v_cells;   // llama_kv_cells 는 값 복사 가능 — shift/used/seq_pos 까지 포함
+    st.v_heads = v_heads;
+
+    return st;
+}
+
+void llama_kv_cache::memplan_restore(const memplan_state_t & st) {
+    if (st.v_cells.size() != v_cells.size() || st.v_heads.size() != v_heads.size()) {
+        LLAMA_LOG_ERROR("%s: memplan snapshot shape mismatch (%zu/%zu cells, %zu/%zu heads)\n",
+                __func__, st.v_cells.size(), v_cells.size(), st.v_heads.size(), v_heads.size());
+        return;
+    }
+
+    v_cells = st.v_cells;
+    v_heads = st.v_heads;
+}
+
+uint64_t llama_kv_cache::memplan_digest() const {
+    // FNV-1a 64
+    uint64_t h = 0xcbf29ce484222325ull;
+
+    const auto mix = [&h](uint64_t v) {
+        for (int b = 0; b < 8; ++b) {
+            h ^= (uint64_t) ((v >> (8*b)) & 0xff);
+            h *= 0x100000001b3ull;
+        }
+    };
+
+    mix(v_cells.size());
+
+    for (size_t s = 0; s < v_cells.size(); ++s) {
+        const auto & cells = v_cells[s];
+
+        mix(s);
+        mix(cells.size());
+        mix(cells.get_used());
+
+        for (uint32_t i = 0; i < cells.size(); ++i) {
+            if (cells.is_empty(i)) {
+                mix((uint64_t) 0xffffffffull);
+                continue;
+            }
+
+            mix((uint64_t) (uint32_t) cells.pos_get(i));
+
+            const auto & ext = cells.ext_get(i);
+            mix((uint64_t) (uint32_t) ext.x);
+            mix((uint64_t) (uint32_t) ext.y);
+
+            for (uint32_t sq = 0; sq < LLAMA_MAX_SEQ; ++sq) {
+                if (cells.seq_has(i, sq)) {
+                    mix(0x5e000000ull + sq);
+                }
+            }
+        }
+    }
+
+    for (size_t s = 0; s < v_heads.size(); ++s) {
+        mix(v_heads[s]);
+    }
+
+    return h;
+}
