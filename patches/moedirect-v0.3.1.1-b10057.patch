+// ── P28. ★openai_moe_v1 — bias 가산 선택식 동등성 + "bias 미가산" 부정 컨트롤 ──────────────
+static void test_pb_openai_adapter() {
+    section("P28. ★openai_moe_v1(§1) — gpt-oss 닫힌 매핑 해소 · bias 스냅샷 회계 · "
+            "TopK(Wx+gate_b) 8입력 동등성(독립 재계산) + bias 미가산 산출과의 상이 실증");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_openai_eq", PB_TEST_N_EXPERT, "gpt-oss", /*bias_gi=*/true);
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+               "P28a. seal 성공(gpt-oss descriptor · 프리페치 ON)")) return;
+
+    const int32_t ne = PB_TEST_N_EMBD, nx = PB_TEST_N_EXPERT;
+    check(ggml_moe_phaseb_adapter_id() == GGML_MOE_PHASEB_ADAPTER_OPENAI_MOE &&
+          std::string(ggml_moe_phaseb_adapter_name()) == "openai_moe_v1" &&
+          std::string(ggml_moe_phaseb_adapter_reason()).empty() &&
+          ggml_moe_phaseb_norm_tensor_kind() == GGML_MOE_PHASEB_NORM_ATTN_POST &&
+          ggml_moe_phaseb_selection_fn()     == GGML_MOE_PHASEB_SEL_TOPK_BIAS &&
+          ggml_moe_phaseb_bias_kind()        == GGML_MOE_PHASEB_BIAS_GATE_INP_B &&
+          std::string(ggml_moe_phaseb_selection_fn_name()) == "topk_bias" &&
+          std::string(ggml_moe_phaseb_bias_snapshot_name()) == "ffn_gate_inp_b[]" &&
+          ggml_moe_phaseb_prefetch_on(),
+          "P28b. ★닫힌 매핑 해소 = openai_moe_v1(norm=attn_post_norm · sel=topk_bias · bias=ffn_gate_inp_b[])");
+
+    std::vector<float> w0, w1, rt1, bias;
