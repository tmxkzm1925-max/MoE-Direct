+// ===========================================================================
+// XPART. E-2b-0 - the acquire batch part, and the handle table's lifetime.
+//   authority: E2_DESIGN_CONTRACT.md v0.5 FROZEN section 1 and section 5 (E-2b-0 row)
+//   spec     : bench/techdev/repack_space/E2B0_ATOM_SPEC.md section C
+//
+// Two holes this group closes, both found by the E-2b-1 department while it was still on
+// paper. (1) acquire had no `part`, so every new-surface acquire stamped a literal 0 onto the
+// Phase A ledger and the lead-time B stream while the trace stream carried the consumer's
+// real part - the (layer, part) join key collapsed on one side only. (2) view took the module
+// mutex, which the consumer transition would have turned into a per-op storm of global lock
+// acquisitions. Nothing here touches a consumer source; that is E-2b-1.
+//
+// Block map: A the new argument . B failure atomicity of it . C Phase A ledger pass-through .
+// D lead-time B pass-through . E the fixed table . F lock-free reads and quiescence.
+// ===========================================================================
+
+// One reader thread's verdict for the multi-reader arm. Deliberately plain data: the thread
+// records what it saw and the main thread judges after every join, so nothing is decided
+// while a reader is still running.
+struct XpartReadOut {
+    int  windows   = 0;
+    bool all_match = true;
+};
+
+// ===========================================================================
+// XCPU - E-2b-1: the two CPU consumers move onto the logical-key surface.
+//   Authority: E2B1_ATOM_SPEC.md v2.6 (construction-frozen) sections C, C-1, C-2.
+//   Exact delta = +14 (XCPU01..XCPU14, no gaps, no duplicates). The group registers between
+//   XPART and XSTORE for the reason XPART does: it needs a LIVE dispatcher, and XSTORE's
+//   DRAINING arm stops one.
+//   Three child arms (--xcpu-graph-test {hold, mmid, addid}) exist because MOE_P1_TRACE is
+//   fixed for the life of a process by std::call_once and the parent asserts trace OFF. They
+//   exit NORMALLY (like the XSTORE budget arms), so the isolated-fatal mode set stays at 9;
+//   the parent reads their stdout in three top-level check() calls, so check() stays at 14.
+// ===========================================================================
+
+// ---- fixture shapes -------------------------------------------------------------------
+// One layer, two parts, so that BOTH consumer stride forms are present in a single seal: a
+// 3-D weight (mul_mat_id strides by nb[2]) and a 2-D bias (add_id strides by nb[1]).
+static const int32_t XCPU_S_NEXPERT = 8;
+static const int32_t XCPU_S_NUSED   = 2;
+static const int64_t XCPU_S_K       = 32;
+static const int64_t XCPU_S_M       = 8;
+static const int64_t XCPU_S_NEMBD   = 64;
+static const int32_t XCPU_G_NTOKEN  = 4;      // the parent's real graph only has to be real
+
+// Multi-worker / hold fixtures. The values are section C-2's constant table and the D7
+// discipline table. `wall >= 100 ms` is still a measured GATE for the HOLD arm (XCPU12
+// stage 1, section C-2's protocol needs a window to hold open). For XCPU13/14 it is not:
+// round 11 replaced their polled witness with a single post-join reading, so neither a
+// sample floor nor a wall floor gates them any more - see xcpu_thread_count and the post
+// field on XcpuSampler. Those two now only have to run the graph.
+//
+// K and M were raised once (512 -> 1024), but that raise ALONE did not settle the hold arm:
+// with n_token still 256 the hold warm-up measured 82 / 96 / 108 ms and missed its own 100 ms
+// gate in two runs out of three. The shape that settles it is K*M 1024^2 AND n_token 2048,
+// measured at 162 / 163 / 173 ms over three runs with the child peaking at 1423 MiB (mmid on
+// the same shape: 172-184 ms, 1422 MiB).
+//
+// Round 11 also tried to buy XCPU13/14's sample floor with size and could not - by stages,
+// not in one step: at 79-85 ms the sampler took 0 samples; the count first reached 21 at
+// 688 ms; from there the wall grew to 1051 ms and the count FELL to 20, because a bigger
+// fixture makes each reading MORE expensive. add_id's wall is proportional to the bytes it
+// writes, so 40 samples would have cost ~10.7 GiB. Disposition (D) retired the floor instead,
+// and the dimensions came back down with it. n_token is NOT shared any more (see
+// xcpu_child_mw): mul_mat_id buys length with tokens, add_id with R_node nodes.
+static const int32_t XCPU_MW_NEXPERT  = 64;    // A - every expert active
+static const int64_t XCPU_MW_K        = 1024;  // was 512 - see the measured raise above
+static const int64_t XCPU_MW_M        = 1024;  // was 512
+static const int64_t XCPU_MW_NEMBD    = 1024;
+static const int32_t XCPU_MW_NTOKEN     = 2048; // mul_mat_id / hold ONLY (round 11)
+static const int32_t XCPU_MW_ADD_NTOKEN = 64;   // add_id ONLY (round 11) - split, see below
+static const int32_t XCPU_MW_NUSED    = 8;
+static const int32_t XCPU_MW_NTHREADS = 8;     // N: a REQUEST. nth is derived from O5.
+static const int32_t XCPU_ADDID_RNODE = 256;  // round 11: was 256. O8 fires once per (graph,layer,part,expert)
+                                               // so repeating a node cannot buy O8; O5 IS
+                                               // re-issued per node, so add_id buys its wall
+                                               // with nodes and mul_mat_id with per-expert
+                                               // work.
+// The touch-abort threshold every seal in this group passes. The OFF arm needs it as a NUMBER
+// (it asserts the touched-page count stays under it), so it stops being a bare literal.
+static const uint32_t XCPU_SEAL_TOUCH_ABORT = 64;
+// The OFF arm's own shape. seal protects only the 4 KiB pages lying WHOLLY INSIDE a registered
+// tensor - it aligns the start up, the end down, and skips the tensor when nothing is left
+// (ggml-moe-direct.cpp:10513-10540). The small XCPU_S_* shape leaves the bias with 2 KiB, which
+// can protect ZERO pages depending on where the allocator put it, and then "the tripwire fired"
+// would be a question about alignment luck. At >= 16 KiB per registered tensor there are at
+// least three interior pages whatever the offset:
+//   weight = 64*32*8*4 = 65,536 B (>= 15 interior pages)   bias = 1024*8*4 = 32,768 B (>= 7)
+// Even if every interior page is touched the total is <= 24, well under the abort threshold.
+static const int64_t XCPU_OFF_K      = 64;
+static const int64_t XCPU_OFF_M      = 32;
+static const int64_t XCPU_OFF_NEMBD  = 1024;
+static const int32_t XCPU_OFF_NTOKEN = 4;
+static const int32_t XCPU_HOLD_T_QUIET_MS    = 200;
+static const int32_t XCPU_HOLD_POLL_MS       = 1;
+// The polled sampler's target period. It is a BEST-EFFORT record, not a cadence anything is
+// gated on: round 11 measured one reading at 20-60 ms on this host (see xcpu_thread_count),
+// so a 5 ms period is not achievable here by any pacing and the observed sample counts are
+// single digits. The witness does not depend on it - that is the post field's job.
+static const int32_t XCPU_SAMPLER_CADENCE_MS = 5;   // target only; the real period is the read
+static const int32_t XCPU_MIN_GRAPH_WALL_MS  = 100;
+// Warm-up, the empty window-advance pairs and the target each get their own monotone
+// graph_seq, and G belongs to the target alone: first_arith_claim keys its dedup on
+// graph_seq, so reusing one would silently swallow the target's O8.
+static const uint32_t XCPU_GSEQ_WARM        = 1u;
+static const uint32_t XCPU_GSEQ_PAIR0       = 2u;
+static const uint32_t XCPU_GSEQ_TARGET      = 9001u;
+static const uint32_t XCPU_DECODE_WIN_BEGIN = 128u;   // mirrors ggml-moe-trace.cpp
+
+// ---- the store directory a real-graph arm seals ---------------------------------------
+struct XcpuStore {
+    SynthModel   model;
+    Computed     comp;
+    std::wstring dir;
+    std::string  sha;
+    int32_t      n_expert = 0;
+    std::vector<std::vector<uint8_t>> wpe, bpe;   // per-expert payloads; the STOCK arm gets
+                                                  // the same bytes the store will serve
+};
+
+// Builds <dir>/{synth.expect.json, manifest.json, verify_report.json, experts.bin} the way
+// section F's parity harness does - the fixture comes out of the REAL production path
+// (compute_layout -> manifest -> bin), never from hand-laid bytes (G-3 (f)).
+static bool xcpu_make_store(XcpuStore & st, const char * tag, int32_t n_expert, int32_t n_used,
+                            int64_t k, int64_t mdim, int64_t nembd, uint32_t seed) {
+    st.n_expert = n_expert;
+    st.model.arch = "synth";
+    st.model.n_expert = n_expert; st.model.n_expert_used = n_used; st.model.n_layer = 1;
+    st.model.sources = { default_source() };
+    SynthLayer L; L.layer = 0;
+    SynthPart w; w.name = "gate.weight"; w.source_tensor = "blk.0.ffn_gate_exps.weight";
+    w.source_index = 0; w.type = "F32"; w.dims = { k, mdim, n_expert }; w.is_host = true;
+    SynthPart b; b.name = "gate.bias";   b.source_tensor = "blk.0.ffn_gate_exps.bias";
+    b.source_index = 0; b.type = "F32"; b.dims = { nembd, n_expert }; b.is_host = true;
+    L.parts = { w, b };
+    st.model.layers = { L };
+    st.comp = compute_layout(st.model, 4096);
+    st.dir = make_case_dir(tag);
+
+    const size_t wf = (size_t)(k * mdim), bf = (size_t) nembd;
+    std::mt19937 rng(seed);
+    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+    st.wpe.resize((size_t) n_expert); st.bpe.resize((size_t) n_expert);
+    for (int e = 0; e < n_expert; e++) {
+        st.wpe[(size_t) e].resize(wf * 4); st.bpe[(size_t) e].resize(bf * 4);
+        float * fw = (float *) st.wpe[(size_t) e].data();
+        float * fb = (float *) st.bpe[(size_t) e].data();
+        for (size_t i = 0; i < wf; i++) fw[i] = dist(rng);
+        for (size_t i = 0; i < bf; i++) fb[i] = dist(rng);
+    }
+    const std::string expect_body = synth_expect_body("synth", n_expert);
+    st.sha = sha256_hex(expect_body);
+    { std::ofstream ofs(st.dir + L"\\synth.expect.json", std::ios::binary | std::ios::trunc);
+      ofs << expect_body; }
+    write_manifest(st.dir + L"\\manifest.json",
+                   build_manifest_json(st.model, st.comp, "synth", st.sha));
+    write_verify_report(st.dir + L"\\verify_report.json", "synth", st.sha,
+                        sha256_file_hex(st.dir + L"\\manifest.json"));
+    HANDLE h = CreateFileW((st.dir + L"\\experts.bin").c_str(), GENERIC_WRITE, 0, nullptr,
+                           CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (h == INVALID_HANDLE_VALUE) return false;
+    std::vector<uint8_t> rec((size_t) st.comp.layers[0].stride, 0);
+    bool ok = true;
+    for (int e = 0; e < n_expert; e++) {
+        std::fill(rec.begin(), rec.end(), 0);
+        std::memcpy(rec.data() + st.comp.layers[0].parts[0].part_offset,
+                    st.wpe[(size_t) e].data(), wf * 4);
+        std::memcpy(rec.data() + st.comp.layers[0].parts[1].part_offset,
+                    st.bpe[(size_t) e].data(), bf * 4);
+        DWORD wr = 0;
+        if (!WriteFile(h, rec.data(), (DWORD) rec.size(), &wr, nullptr)
+            || wr != (DWORD) rec.size()) ok = false;
+    }
+    CloseHandle(h);
+    return ok;
+}
