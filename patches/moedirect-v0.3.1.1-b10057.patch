+            ggml_tensor * gate1 = fx.find("blk.1.ffn_gate_exps.weight");
+            int32_t all_ids[8] = { 0, 1, 2, 3, 4, 5, 6, 7 };
+            // ① 층 0 전체 적재 → record 6 의 (slot, generation) 확보
+            ggml_moe_direct_acquire(gate0, all_ids, 8, 1);
+            int32_t slot0 = -1; uint64_t gen0 = 0;
+            ggml_moe_direct_test_record_slot(/*record_idx=*/6, &slot0, &gen0);
+            uint64_t slot_gen0 = 0;
+            if (slot0 >= 0) ggml_moe_direct_test_slot_state(slot0, nullptr, nullptr, &slot_gen0, nullptr);
+            ggml_moe_direct_release(gate0, all_ids, 8);
+            // ② 층 1 전체 적재 → 8슬롯 전량 축출·재사용(= record 6 의 슬롯도 새 주인이 쓴다)
+            ggml_moe_direct_acquire(gate1, all_ids, 8, 1);
+            ggml_moe_direct_release(gate1, all_ids, 8);
+            // ③ 재사용된 그 슬롯의 generation 은 **엄격히 증가**해야 한다(동일 허용 금지).
+            uint64_t slot_gen1 = 0;
+            int64_t owner1 = -1;
+            if (slot0 >= 0) ggml_moe_direct_test_slot_state(slot0, &owner1, nullptr, &slot_gen1, nullptr);
+            // ④ 구 record 는 더 이상 상주하지 않는다 — ptr() 이 (slot,generation) 재검증으로 막는다.
+            int32_t slot_after = -1; uint64_t gen_after = 0;
+            ggml_moe_direct_test_record_slot(/*record_idx=*/6, &slot_after, &gen_after);
+            const void * pv = ggml_moe_direct_ptr(gate0, 6);
+            const bool evicted   = (slot_after < 0) || (owner1 != 6);
+            const bool gen_bumped = (slot0 >= 0) && (slot_gen1 > slot_gen0);
+            check(gen_bumped && evicted && pv == nullptr,
+                  "V3e6. ★⑩ stale generation — 층 교체로 슬롯 " + std::to_string(slot0) +
+                  " 재사용 **강제** · generation " + std::to_string((unsigned long long)slot_gen0) +
+                  " -> " + std::to_string((unsigned long long)slot_gen1) + "(엄격 증가) · 구 record 6 은"
+                  " 비상주(ptr=NULL) — 구 세대 포인터가 노출되지 않는다");
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ⑩-e shutdown/abort: success-after-cancel publish 0 ----
+    //   ★in-flight child 를 실제로 만들어놓고 취소 drain 을 친다. 이 경로가 A3 에서 새로 위험해진
+    //   지점이다: bin 은 채널 1개 = op 1개라 채널마다 op terminal 을 불러도 됐지만, virtual 은
+    //   한 op 이 N 채널을 물어 그렇게 하면 같은 op 을 N 번 종결한다(pending 이중 반납).
+    {
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a3_abort", /*n_shards=*/1, "8");
+        if (check(lv.ok, "V3e7a. abort drain 픽스처 seal [" + lv.why + "]")) {
+            uint64_t sub0 = 0, ret0 = 0, term0 = 0, pub0 = 0;
+            ggml_moe_direct_test_v3_child_stats(&sub0, &ret0, &term0, &pub0);
+            // 채널이 1개라도 busy 해지는 순간 dispatcher 가 취소 drain 을 그 자리에서 행사한다.
+            ggml_moe_direct_test_abort_after_submit(1);
+            ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+            int32_t ids[1] = { 2 };
+            const int arc = ggml_moe_direct_acquire(gate0, ids, 1, 1);
+            uint64_t sub1 = 0, ret1 = 0, term1 = 0, pub1 = 0;
+            ggml_moe_direct_test_v3_child_stats(&sub1, &ret1, &term1, &pub1);
+            const void * pv = ggml_moe_direct_ptr(gate0, 2);
+            int32_t slot = -1; uint64_t gen = 0;
+            ggml_moe_direct_test_record_slot(/*record_idx=*/2, &slot, &gen);
+            const int32_t np = (int32_t)fx.model.layers[0].parts.size();
+            // ★핵심 3항: ①publish 0(성공 child 가 있어도) ②child 회수 = 제출과 같은 수(전 drain)
+            //   ③op terminal 이 op 당 1회(= 채널 수만큼 부풀지 않았다).
+            check(pub1 - pub0 == 0 && pv == nullptr && slot < 0 &&
+                  (ret1 - ret0) == (sub1 - sub0) &&
+                  (term1 - term0) * np == (ret1 - ret0),
+                  "V3e7. ★★⑩ 취소 drain — success-after-cancel publish 0 · child 제출 " +
+                  std::to_string(sub1 - sub0) + " = 회수 " + std::to_string(ret1 - ret0) +
+                  "(전 drain) · op terminal " + std::to_string(term1 - term0) +
+                  "회(채널 수만큼 중복 종결 없음) · record 미상주(slot=" + std::to_string(slot) +
+                  ") [acquire rc=" + std::to_string(arc) + "]");
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    ggml_moe_direct_reset_for_test();
+}
+
+// ===========================================================================
+// V3f — 원자 A4: 바운스 경로(비4K part · SPEC_REPACK_V3 §3-5 옵션 B)
+//
+// A3 까지는 전 part 가 A 배수라 브라켓 read 가 슬롯에 바로 앉았다. 비4K part 는 시작이 A
+// 정렬이 아니라 그렇게 못 하므로 **전용 staging 으로 읽고 → 채널 즉시 반환 → bounded copy
+// queue 가 `staging + src_head(e)` 에서 `slice_bytes` 만 슬롯으로 옮긴다**.
+// 관문(§6-4): 양성 ②(비4K 바운스 일치)·⑤(ptr parity) + 네거티브 ⑪ 중 **바운스 축**
+// (copy error·backpressure·staging 조기 재사용 금지).
+// ★⑪ 의 prefetch 축(waiterless fail-soft·joined 1회 retry)은 virtual 이 아직 prefetch 를
+//   거부하므로 발화 불가 — A5 이월(§H-7)이고 여기서 공허 단언을 만들지 않는다.
+// ===========================================================================
+
+// ★A4 — 바운스 **copy 실패** death-test(자식 프로세스).
+//   copy 실패는 그 record 의 실패이고, direct demand 이므로 §3-4ⓐ 에 따라 fail-closed(fatal)다.
+//   ★도달성 주기: memcpy 자체는 실패하지 않는다 — 이 경로는 "staging/슬롯이 유효하지 않게 된
+//   상황"의 일반화된 실패 처리이고, 자연 발생 입력이 아니라 **주입으로만** 행사된다. 그래도
+//   ⑪ 이 요구하는 계약(copy error → publish 0)이 실제로 그렇게 닫히는지는 잠가야 한다.
+static int run_v3_copy_fatal_child() {
+    init_scratch_root();
+    V3Fixture * fx = new V3Fixture();   // 죽으므로 해제 불요
+    V3Live lv = v3_seal_live(*fx, "v3_copy_fatal", /*n_shards=*/1, "8", /*bounce=*/true);
+    if (!lv.ok) { fprintf(stderr, "v3-copy-fatal-child: seal 실패 (%s)\n", lv.why.c_str()); return 77; }
+    ggml_tensor * gate0 = fx->find("blk.0.ffn_gate_exps.weight");
+    if (!gate0) { fprintf(stderr, "v3-copy-fatal-child: 텐서 조회 실패\n"); return 77; }
+    ggml_moe_direct_test_v3_arm_copy(/*pause=*/-1, /*fail_copy_part=*/1);   // 바운스 part 의 copy 실패
+    int32_t ids[1] = { 2 };
+    const int arc = ggml_moe_direct_acquire(gate0, ids, 1, 1);
+    fprintf(stderr, "v3-copy-fatal-child: fatal 미발생 — acquire rc=%d (계약 위반: copy 실패가 "
+                    "publish 되거나 조용히 종결됐다)\n", arc);
+    return 66;
+}
+
+static void test_v3_bounce() {
+    section("V3f. mode=virtual 원자 A4 — 바운스 경로(비4K part·staging·copy queue)");
+
+    // ---- 양성: 비4K part 가 섞인 프로파일이 seal 되고 **바이트가 정확**하다 ----
+    {
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a4_bounce", /*n_shards=*/1, "8", /*bounce=*/true);
+        if (!check(lv.ok, "V3f1. ★비4K part 포함 프로파일 seal 성립(A3 의 거부 게이트 철거) [" + lv.why + "]")) {
+            ggml_moe_direct_reset_for_test();
+        } else {
+            // 픽스처 자체 계약 먼저 — 이 part 가 정말 비4K 인가(아니면 이 그룹 전체가 공허다).
+            const V3Part & pb = fx.model.layers[0].parts[1];
+            const V3Part & pa = fx.model.layers[0].parts[0];
+            check(!pb.aligned && (pb.slice_bytes % fx.A) != 0 && pa.aligned,
+                  "V3f2. 픽스처 형상 — part1 slice=" + std::to_string(pb.slice_bytes) +
+                  "(A 배수 아님 = 바운스) · part0 slice=" + std::to_string(pa.slice_bytes) + "(aligned)");
+
+            int32_t stg_busy = 0, stg_count = 0;
+            uint64_t cd0 = 0, cf0 = 0, bp0 = 0;
+            ggml_moe_direct_test_v3_bounce_stats(&cd0, &cf0, &bp0, &stg_busy, &stg_count);
+            check(stg_count > 0 && stg_busy == 0,
+                  "V3f3. staging 풀 확보 " + std::to_string(stg_count) + "칸 · 유휴 상태 시작");
+
+            ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+            int32_t ids[3] = { 0, 3, 7 };
+            const int arc = ggml_moe_direct_acquire(gate0, ids, 3, 1);
+
+            uint64_t cd1 = 0, cf1 = 0, bp1 = 0;
+            int32_t busy1 = 0;
+            ggml_moe_direct_test_v3_bounce_stats(&cd1, &cf1, &bp1, &busy1, nullptr);
+            // record 3건 × 바운스 part 1개 = copy 3건. staging 은 copy terminal 에서 전부 반납.
+            check(arc == 0 && (cd1 - cd0) == 3 && (cf1 - cf0) == 0 && busy1 == 0,
+                  "V3f4. ★바운스 copy 회계 — record 3건에 copy " + std::to_string(cd1 - cd0) +
+                  "건 완료·실패 " + std::to_string(cf1 - cf0) + " · staging 전량 반납(busy=" +
+                  std::to_string(busy1) + ")");
+
+            // ★★핵심 — 바운스 part 의 바이트가 원본 슬라이스와 정확히 일치하는가(§6-4 양성 ②⑤).
+            //   src_head(e) 를 잘못 잡으면 여기서 어긋난다(expert 마다 head 가 다르다).
+            bool parity_bounce = true, parity_aligned = true;
+            for (int32_t e : { 0, 3, 7 }) {
+                parity_aligned = parity_aligned && v3_verify_ptr_bytes(fx, 0, 0, e);
+                parity_bounce  = parity_bounce  && v3_verify_ptr_bytes(fx, 0, 1, e);
+            }
+            check(parity_bounce,
+                  "V3f5. ★★비4K 바운스 바이트 일치 — `ptr(t,e)` 부터 slice_bytes 가 원본 GGUF 슬라이스와 "
+                  "정확 일치(3 expert · 앞·뒤 각 64B · src_head(e) 가 expert 마다 다른 경로)");
+            check(parity_aligned,
+                  "V3f6. 같은 record 의 aligned part 도 동시에 정확(혼합 층에서 두 경로가 함께 선다)");
+            ggml_moe_direct_release(gate0, ids, 3);
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ★★F1 — 바운스 copy obligation 행이 **채워지는가**(emitter 배선) ----
+    //   구 판은 제출부가 `out_copy_row` 를 안 받아 채널에 copies 행을 걸지 않았다. 그래서 행은
+    //   정확한 개수로 남는데(§5-5 의무는 submit 이 만든다) 회수 측이 -1 을 집어 enqueue/start/
+    //   done·worker·status 가 한 줄도 안 찍혔다 — status 는 초기값 CANCELLED, worker 는 0xFF 로
+    //   남아 **자기일관**하므로 §5-6 조인·시각 규약(worker==0xFF ⟺ start==0)을 통과해버린다.
+    //   ⇒ 관문은 "행이 있는가"가 아니라 **"실행된 copy 가 실행된 것으로 기록됐는가"** 여야 한다.
+    //   ★in-memory 창구로 보는 이유: finalize 없이 그 자리에서 행 내용을 집을 수 있다.
+    {
+        EnvGuard e1("MOE_DIRECT_IO3", "on");   // OUT 미설정 = 파일 미기록(행은 메모리에 남는다)
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a4_io3_copies", /*n_shards=*/1, "8", /*bounce=*/true);
+        if (check(lv.ok, "V3f13a. IO3 on + 바운스 픽스처 seal [" + lv.why + "]")) {
+            ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+            int32_t ids[3] = { 0, 3, 7 };
+            const int arc = ggml_moe_direct_acquire(gate0, ids, 3, 1);
+            uint64_t enq[8] = { 0 }, sta[8] = { 0 }, don[8] = { 0 };
+            uint8_t  wrk[8], sts[8];
+            for (int k = 0; k < 8; k++) { wrk[k] = 0xFF; sts[k] = 0; }
+            const int32_t n = ggml_moe_direct_test_io3_copies(8, enq, sta, don, wrk, sts);
+            // record 3건 × 바운스 part 1개 = copies 3행. acquire 가 0 으로 돌아왔다는 것은
+            // 그 3건이 **전부 실행돼 publish 까지 갔다**는 뜻이므로, 3행 모두 착수 기록이 있어야 한다.
+            int32_t n_ok = 0, n_stamped = 0, n_ordered = 0;
+            for (int32_t k = 0; k < n && k < 8; k++) {
+                if (sts[k] == 1) n_ok++;                                     // IO3_C_OK
+                if (wrk[k] != 0xFF && enq[k] > 0 && sta[k] > 0 && don[k] > 0) n_stamped++;
+                if (enq[k] <= sta[k] && sta[k] <= don[k]) n_ordered++;
+            }
+            check(arc == 0 && n == 3 && n_ok == 3 && n_stamped == 3 && n_ordered == 3,
+                  "V3f13. ★★copies emitter 배선 — 완주한 바운스 copy " + std::to_string(n) +
+                  "행 전건이 status=OK(" + std::to_string(n_ok) + ") · worker/enqueue/start/done "
+                  "실기록(" + std::to_string(n_stamped) + ") · enqueue≤start≤done(" +
+                  std::to_string(n_ordered) + ") [acquire rc=" + std::to_string(arc) + "]");
+            ggml_moe_direct_release(gate0, ids, 3);
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ★★R11(교차 r5 Y1/Y2) — **`read_len > region` 분기**를 실제로 밟는다 ----
+    //   비4K 제출 길이 = `align_up(src_head + slice, A)` · region = `align_up(slice, A)`.
+    //   둘이 갈리는 조건은 `src_head > region − slice` 이고, 구 V3f 픽스처는 그 여유가
+    //   3840B 나 돼 한 번도 안 갈렸다. 여기서는 slice=4080·region=4096 으로 여유를 16B 로
+    //   좁혀 거의 모든 expert 에서 갈리게 한다. ★수리 전이면 정상 read 가 실패 latch 로
+    //   가 demand 는 fail-closed(자식 사망)로 끝난다 — 즉 이 검사가 그 결함의 관문이다.
+    {
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a4_srchead", /*n_shards=*/1, "8",
+                                 /*bounce=*/true, /*head_model=*/true);
+        if (check(lv.ok, "V3f11a. src_head>region−slice 픽스처 seal [" + lv.why + "]")) {
+            const V3Part & pb = fx.model.layers[0].parts[1];
+            const uint64_t A = fx.A;
+            const uint64_t region = ceil_to(pb.slice_bytes, A);
+            // 이 형상이 정말 분기를 만드는지 **먼저 픽스처 자체를 검증**한다.
+            int32_t n_div = 0;
+            std::string sample;
+            for (int32_t e = 0; e < fx.model.n_expert; e++) {
+                const uint64_t srch = (pb.abs_offset + (uint64_t)e * pb.slice_bytes) % A;
+                const uint64_t rlen = ceil_to(srch + pb.slice_bytes, A);
+                if (rlen != region) {
+                    n_div++;
+                    if (sample.empty())
+                        sample = "e" + std::to_string(e) + " src_head=" + std::to_string(srch) +
+                                 " read_len=" + std::to_string(rlen) + " region=" + std::to_string(region);
+                }
+            }
+            if (!check(n_div > 0,
+                       "V3f11b. ★픽스처가 분기를 실제로 만든다 — slice=" +
+                       std::to_string(pb.slice_bytes) + " region=" + std::to_string(region) +
+                       " 여유=" + std::to_string(region - pb.slice_bytes) + "B · read_len≠region 인 expert " +
+                       std::to_string(n_div) + "/" + std::to_string(fx.model.n_expert) + " [" + sample + "]")) {
+                ggml_moe_direct_reset_for_test();
+            } else {
+                ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+                std::vector<int32_t> ids;
+                for (int32_t e = 0; e < fx.model.n_expert; e++) ids.push_back(e);
+                const int arc = ggml_moe_direct_acquire(gate0, ids.data(), (int32_t)ids.size(), 1);
+                bool parity = true;
+                for (int32_t e : ids) parity = parity && v3_verify_ptr_bytes(fx, 0, 1, e);
+                check(arc == 0 && parity,
+                      "V3f11. ★★Y1 관문 — `read_len(align_up(src_head+slice,A)) ≠ region` 인 정상 read 가 "
+                      "실패로 오판되지 않는다(전 " + std::to_string(fx.model.n_expert) +
+                      " expert 슬라이스 **전장** 바이트 일치) [acquire rc=" + std::to_string(arc) + "]");
+                ggml_moe_direct_release(gate0, ids.data(), (int32_t)ids.size());
+            }
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ★R11 — 승인 gpt-oss-120b 산술 재현(실도달성 문서화 · I/O 없는 순수 산술) ----
+    {
+        const uint64_t A = 4096, abs = 1838905376ull, slice = 4406400ull;
+        const uint64_t src_head = abs % A;
+        const uint64_t region   = ceil_to(slice, A);
+        const uint64_t read_len = ceil_to(src_head + slice, A);
+        check(src_head == 2080 && region == 4407296ull && read_len == 4411392ull && read_len != region,
+              "V3f12. ★승인 gpt-oss-120b 형상(216/216 비4K)이 분기를 만든다 — src_head=" +
+              std::to_string(src_head) + " region=" + std::to_string(region) + " read_len=" +
+              std::to_string(read_len) + " ⇒ 구 판정(got==region)이었으면 **첫 수요부터 fail-closed**"
+              "(교차 r5 Y1 실도달 근거)");
+    }
+
+    // ---- ⑪ staging 조기 재사용 금지 + backpressure ----
+    //   copy worker 를 세워 staging 을 붙들면 ①점유가 유지되고 ②신규 제출이 막힌다(backpressure).
+    //   재개하면 전부 풀려 정상 완료한다. 세 국면을 한 픽스처에서 본다.
+    {
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a4_backpressure", /*n_shards=*/1, "8", /*bounce=*/true);
+        if (check(lv.ok, "V3f7a. backpressure 픽스처 seal [" + lv.why + "]")) {
+            int32_t stg_count = 0;
+            ggml_moe_direct_test_v3_bounce_stats(nullptr, nullptr, nullptr, nullptr, &stg_count);
+            uint64_t bp0 = 0;
+            ggml_moe_direct_test_v3_bounce_stats(nullptr, nullptr, &bp0, nullptr, nullptr);
+            ggml_moe_direct_test_v3_arm_copy(/*pause=*/1, /*fail_copy_part=*/-2);   // copy 정지
+            ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+            // staging 칸 수보다 많은 record 를 요구한다 → 앞쪽은 staging 을 물고 멈추고,
+            // 뒤쪽은 제출 자체가 막힌다(= backpressure).
+            std::vector<int32_t> many;
+            for (int32_t e = 0; e < 8; e++) many.push_back(e);
+            // acquire 는 완료까지 블록하므로 **별도 스레드**에서 건다(copy 를 세워둔 상태라 대기한다).
+            std::thread th([&]{ ggml_moe_direct_acquire(gate0, many.data(), (int32_t)many.size(), 1); });
+            // staging 이 점유될 때까지 잠깐 준다.
+            int32_t busy_peak = 0;
+            for (int i = 0; i < 300; i++) {
+                int32_t b = 0;
+                ggml_moe_direct_test_v3_bounce_stats(nullptr, nullptr, nullptr, &b, nullptr);
+                if (b > busy_peak) busy_peak = b;
+                if (busy_peak >= stg_count) break;
+                Sleep(2);
+            }
+            uint64_t bp1 = 0;
+            ggml_moe_direct_test_v3_bounce_stats(nullptr, nullptr, &bp1, nullptr, nullptr);
+            check(busy_peak > 0,
+                  "V3f7. ★staging 조기 재사용 금지 — copy 정지 중 staging 이 **점유된 채 유지**된다"
+                  "(peak busy " + std::to_string(busy_peak) + "/" + std::to_string(stg_count) +
+                  " · copy terminal 전까지 반납 없음)");
+            check(bp1 > bp0,
+                  "V3f8. ★backpressure — staging 고갈 시 신규 제출을 **미룬다**(stall " +
+                  std::to_string(bp1 - bp0) + "회 · 억지 제출로 staging 을 덮어쓰지 않는다)");
+            // 재개 → 전부 풀리고 정상 종료
+            ggml_moe_direct_test_v3_arm_copy(/*pause=*/0, /*fail_copy_part=*/-2);
+            th.join();
+            int32_t busy_end = 0;
+            uint64_t cd_end = 0;
+            ggml_moe_direct_test_v3_bounce_stats(&cd_end, nullptr, nullptr, &busy_end, nullptr);
+            bool parity = true;
+            for (int32_t e : { 0, 5, 7 }) parity = parity && v3_verify_ptr_bytes(fx, 0, 1, e);
+            check(busy_end == 0 && cd_end >= 8 && parity,
+                  "V3f9. 재개 후 전량 완주 — staging 전량 반납(busy=" + std::to_string(busy_end) +
+                  ") · copy " + std::to_string(cd_end) + "건 · 바이트 정확");
+            ggml_moe_direct_release(gate0, many.data(), (int32_t)many.size());
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ⑪ copy error → publish 0 (direct demand 이므로 §3-4ⓐ 대로 fatal · 자식 death-test) ----
+    {
+        wchar_t exe[MAX_PATH]; DWORD n = GetModuleFileNameW(nullptr, exe, MAX_PATH);
+        if (check(n > 0 && n < MAX_PATH, "V3f10a. exe 경로 조회")) {
+            std::wstring cmd = L"\"" + std::wstring(exe) + L"\" --v3-copy-fatal-test";
+            std::vector<wchar_t> cb(cmd.begin(), cmd.end()); cb.push_back(L'\0');
+            STARTUPINFOW si; ZeroMemory(&si, sizeof(si)); si.cb = sizeof(si);
+            PROCESS_INFORMATION pi; ZeroMemory(&pi, sizeof(pi));
+            const BOOL ok = CreateProcessW(exe, cb.data(), nullptr, nullptr, FALSE, 0, nullptr, nullptr, &si, &pi);
+            if (check(ok, "V3f10b. copy-fatal 자식 기동")) {
+                const DWORD wr = WaitForSingleObject(pi.hProcess, INFINITE);
+                DWORD ec = 0;
+                const BOOL got = GetExitCodeProcess(pi.hProcess, &ec);
+                CloseHandle(pi.hProcess); CloseHandle(pi.hThread);
+                char ecbuf[16]; snprintf(ecbuf, sizeof(ecbuf), "%08lX", (unsigned long)ec);
+                check(wr == WAIT_OBJECT_0 && got && ec == 0xC0000409u,
+                      "V3f10. ★★⑪ copy error = publish 0 — 바운스 copy 실패가 record 실패로 합류해 "
+                      "direct demand 계약대로 fail-closed(0xC0000409)로 닫힌다 [exit=0x" +
+                      std::string(ecbuf) + "]");
+            }
+        }
+    }
+}
+
+// ★SPEC_IO_METRICS_V3 §3 거부 조합 ④ — `MOE_P1_TRACE=1`. trace 활성은 call_once 캡셔라 부모
+//   프로세스에선 되돌릴 수 없고(부모는 trace off 고정), 그래서 이 조합만 trace-on 자식
+//   프로세스에서 행사한다. 나머지 3종(①②③)은 V3c47~49.
+// ===========================================================================
+// V3g — 원자 A5: IO3 사이드카 wire (`MOEIO3` · SPEC_IO_METRICS_V3 §5·§8)
+//
+// virtual 은 "record 1건 = 물리 read 1건"이 깨져 PA/PB 채널로는 물리 행을 낼 수 없다.
+// IO3 는 **부모 논리 행(records) / 자식 물리 행(children) / copy 의무(copies)** 3채널로
+// 그 구조를 그대로 낸다. 이 그룹은 wire 를 **되읽어** §5-6 완전성·§8 게이트를 판정한다.
+// ===========================================================================
+
+#pragma pack(push, 1)
+struct T_Io3Header {
+    char     magic[8];
+    uint32_t layout_version, file_kind, record_bytes, engine_mode;
+    uint64_t record_count, payload_digest, qpc_frequency, t0_qpc;
+    uint32_t pid, complete, n_expert, n_moe_layers, n_slots, n_expert_used;
+    uint64_t boot_id, total_requests, dropped_records;
+    uint8_t  io_params[6], io_param_src[6], reserved[12];
+};
+struct T_Io3Record {
+    uint64_t record_seq, record_id;
+    uint32_t graph_seq, request_index;
+    uint16_t layer, expert;
+    uint8_t  origin, flags, terminal_status, attempt;
+    uint32_t n_children;
+    int32_t  slot;
+    uint64_t legacy_bytes, generation, first_submit_qpc, terminal_qpc, publish_seq;
+};
+struct T_Io3Child {
+    uint64_t record_seq, read_offset;
+    uint32_t read_len;
+    uint16_t layer, expert;
+    uint8_t  part, source_index, origin, flags;
+    uint32_t coalesce_group;
+    uint64_t generation, submit_event_seq, submit_qpc, terminal_event_seq, terminal_qpc;
+    uint8_t  terminal_status, qd_at_submit[3], qd_at_terminal[3], reserved;
+    uint32_t graph_seq, request_index;
+};
+struct T_Io3Copy {
+    uint64_t record_seq, src_child_submit_event_seq;
+    uint32_t bytes;
+    uint16_t layer, expert;
+    uint8_t  part, worker, status, flags;
+    uint32_t coalesce_group;
+    uint64_t enqueue_qpc, start_qpc, done_qpc, generation;
+};
+#pragma pack(pop)
+static_assert(sizeof(T_Io3Header) == 128, "reader header must mirror the engine layout");
+static_assert(sizeof(T_Io3Record) ==  80, "reader records row must mirror the engine layout");
+static_assert(sizeof(T_Io3Child)  ==  88, "reader children row must mirror the engine layout");
+static_assert(sizeof(T_Io3Copy)   ==  64, "reader copies row must mirror the engine layout");
+
+template <typename R>
+static bool io3_read(const std::wstring & path, T_Io3Header & hd, std::vector<R> & rows, std::string & why) {
+    std::ifstream f(path, std::ios::binary);
+    if (!f.is_open()) { why = "cannot open " + wide_to_utf8(path); return false; }
+    f.read((char *)&hd, sizeof(hd));
+    if ((size_t)f.gcount() != sizeof(hd)) { why = "short header"; return false; }
+    if (std::memcmp(hd.magic, "MOEIO3", 6) != 0) { why = "bad magic"; return false; }
+    if (hd.layout_version != 1)                  { why = "bad layout_version"; return false; }
+    if (hd.record_bytes != sizeof(R))            { why = "record_bytes != reader struct"; return false; }
+    rows.assign((size_t)hd.record_count, R{});
+    if (hd.record_count) {
+        f.read((char *)rows.data(), (std::streamsize)(sizeof(R) * (size_t)hd.record_count));
+        if ((uint64_t)f.gcount() != sizeof(R) * hd.record_count) { why = "short payload"; return false; }
+    }
+    // 파일 크기 일치(§5-6 fail-close) — 남는 바이트가 있으면 거부.
+    char extra = 0;
+    f.read(&extra, 1);
+    if (f.gcount() != 0) { why = "trailing bytes after payload"; return false; }
+    // payload 재해시(§5-6) — 헤더 digest 와 일치해야 한다.
+    uint64_t dg = 0xcbf29ce484222325ull;
+    if (hd.record_count) {
+        const uint8_t * p = (const uint8_t *)rows.data();
+        const size_t n = sizeof(R) * (size_t)hd.record_count;
+        for (size_t i = 0; i < n; i++) { dg ^= p[i]; dg *= 0x100000001b3ull; }
+    }
+    if (dg != hd.payload_digest) { why = "payload digest mismatch"; return false; }
+    return true;
+}
+
+struct Io3Arm {
+    T_Io3Header hr{}, hc{}, hp{};
+    std::vector<T_Io3Record> recs;
+    std::vector<T_Io3Child>  kids;
+    std::vector<T_Io3Copy>   cps;
+    bool load(const std::wstring & prefix, std::string & why) {
+        return io3_read(prefix + L"_records.io3",  hr, recs, why)
+            && io3_read(prefix + L"_children.io3", hc, kids, why)
+            && io3_read(prefix + L"_copies.io3",   hp, cps,  why);
+    }
+};
+
+// 한 arm 을 §5-6 완전성 규칙으로 검사한다. 반환=첫 위반 사유("" = 통과).
+static std::string io3_verify(const Io3Arm & a) {
+    auto U = [](uint64_t v) { return std::to_string((unsigned long long)v); };
+    // ① 3파일 boot_id·complete 일치
+    if (a.hr.boot_id != a.hc.boot_id || a.hr.boot_id != a.hp.boot_id) return "boot_id mismatch across kinds";
+    if (!a.hr.complete || !a.hc.complete || !a.hp.complete)           return "complete != 1";
+    if (a.hr.dropped_records || a.hc.dropped_records || a.hp.dropped_records) return "dropped_records != 0";
+    if (a.hr.file_kind != 1 || a.hc.file_kind != 2 || a.hp.file_kind != 3)    return "file_kind mismatch";
+    if (a.hr.engine_mode != 2) return "engine_mode != virtual";
+    // ② ★event namespace 조밀·무중복 — {submit} ∪ {terminal} = 0..2N-1
+    std::vector<uint8_t> seen(a.kids.size() * 2, 0);
+    for (const auto & k : a.kids) {
+        if (k.submit_event_seq >= seen.size())   return "submit_event_seq out of range " + U(k.submit_event_seq);
+        if (seen[(size_t)k.submit_event_seq])    return "duplicate event seq " + U(k.submit_event_seq);
+        seen[(size_t)k.submit_event_seq] = 1;
+        if (k.terminal_event_seq >= seen.size()) return "terminal_event_seq out of range " + U(k.terminal_event_seq);
+        if (seen[(size_t)k.terminal_event_seq])  return "duplicate event seq " + U(k.terminal_event_seq);
+        seen[(size_t)k.terminal_event_seq] = 1;
+    }
+    for (size_t i = 0; i < seen.size(); i++) if (!seen[i]) return "event namespace has a hole at " + U(i);
+    // ③ cardinality(§5-6 전식) — `n_children(R) = |단독 children| + |copies: src_kind=coalesce|`.
+    //   ★A6 — 구 판은 앞 항만 셌다. coalescing 이 한 번도 안 돌던 동안은 뒷 항이 항상 0 이라
+    //   같은 값이었지만, 그 판으로는 합쳐진 런의 귀속을 전혀 검사하지 못한다(대구간 child 의
+    //   record_seq 는 NA 이고 귀속은 copies 가 권위이므로, 뒷 항이 곧 그 record 의 물리 read 몫이다).
+    for (const auto & r : a.recs) {
+        size_t n = 0;
+        for (const auto & k : a.kids) if (k.record_seq == r.record_seq && !(k.flags & 0x10)) n++;
+        for (const auto & c : a.cps)  if (c.record_seq == r.record_seq && (c.flags & 0x02))   n++;
+        if (n != (size_t)r.n_children)
+            return "cardinality: record_seq " + U(r.record_seq) + " n_children=" + U(r.n_children) +
+                   " but children rows + coalesce copies=" + U(n);
+    }
+    // ④ ★bounce obligation — bounce child 1건당 copies 행 정확 1건(상태 불문)
+    for (const auto & k : a.kids) {
+        if (!(k.flags & 0x08)) continue;                       // b3 = bounce
+        size_t n = 0;
+        for (const auto & c : a.cps) if (c.src_child_submit_event_seq == k.submit_event_seq) n++;
+        if (n != 1) return "bounce obligation: child submit_seq " + U(k.submit_event_seq) +
+                           " has " + U(n) + " copies rows (want exactly 1)";
+    }
+    // ④′ ★A6 coalesce obligation — 대구간 child 1건당 **participant record 마다 1행**이고,
+    //   그 행들의 expert 집합이 `[child.expert, child.expert + n)` 연속열이어야 한다. 이것이
+    //   §3-6 ②(완전 연속 run)·③④(대구간 안에 다 들어간다)·⑥(exact slice)를 **wire 에서**
+    //   재확인하는 지점이다. 단독/대구간의 열 규약도 여기서 함께 잠근다.
+    for (const auto & k : a.kids) {
+        const bool coal = (k.flags & 0x10) != 0;
+        if (!coal) {
+            if (k.coalesce_group != 0xFFFFFFFFu)
+                return "standalone child carries a coalesce_group " + U(k.coalesce_group);
+            if (k.record_seq == ~(uint64_t)0)
+                return "standalone child has record_seq=NA (attribution lost)";
+            continue;
+        }
+        if (k.coalesce_group == 0xFFFFFFFFu) return "coalesced child has coalesce_group=NA";
+        if (k.record_seq != ~(uint64_t)0)    return "coalesced child must carry record_seq=NA (section 5-4)";
+        if (k.generation != ~(uint64_t)0)    return "coalesced child must carry generation=NA (section 5-4)";
+        if (k.flags & 0x08)                  return "coalesced child must not also be flagged bounce";
+        std::vector<uint64_t> ex;
+        uint32_t slice = 0;
+        for (const auto & c : a.cps) {
+            if (c.src_child_submit_event_seq != k.submit_event_seq) continue;
+            if (slice == 0) slice = c.bytes;
+            else if (c.bytes != slice)
+                return "coalesce obligation: copies of one run disagree on the slice size";
+            ex.push_back(c.expert);
+        }
+        if (ex.size() < 2)
+            return "coalesce obligation: child submit_seq " + U(k.submit_event_seq) + " has " +
+                   U(ex.size()) + " copies rows (a run is at least 2 records)";
+        std::sort(ex.begin(), ex.end());
+        for (size_t i = 0; i < ex.size(); i++) {
+            if (ex[i] != (uint64_t)k.expert + i)
+                return "coalesce obligation: experts are not the contiguous run [" + U(k.expert) + ", " +
+                       U((uint64_t)k.expert + ex.size()) + ") - saw " + U(ex[i]) + " at index " + U(i);
+        }
+        if ((uint64_t)slice * ex.size() > (uint64_t)k.read_len)
+            return "coalesce obligation: run bytes " + U((uint64_t)slice * ex.size()) +
+                   " exceed the physical read_len " + U(k.read_len);
+    }
+    // ⑤ copies 조인 + §5-5 상태·시각 규약
+    //   ★R18(교차 r6 G7) — 구 판은 "참조 child 실재 + 일부 시각"만 봤다. 사양 §5-6 은
+    //   `record_seq / src_kind ↔ child flags / coalesce_group / part / source / status /
+    //   generation` **전수 정합**을 요구한다 — 조인 키만 맞고 나머지 열이 어긋나도 통과하면
+    //   그 wire 로 세운 회계는 전부 거짓이 된다.
+    for (const auto & c : a.cps) {
+        const T_Io3Child * kid = nullptr;
+        for (const auto & k : a.kids) if (k.submit_event_seq == c.src_child_submit_event_seq) { kid = &k; break; }
+        if (!kid) return "copies row references a missing child " + U(c.src_child_submit_event_seq);
+        const bool kid_coalesced = ((kid->flags & 0x10) != 0);
+        // ── 전수 정합(§5-6 조인 검사)
+        // ★A6 — 대구간 child 의 `record_seq` 는 NA 이고 귀속은 copies 가 권위다(§5-4). 그래서
+        //   동치 비교는 **단독 child 에서만** 성립한다. 대구간 쪽 귀속은 위 ④′ 가 잠근다.
+        if (!kid_coalesced && c.record_seq != kid->record_seq)
+            return "copies join: record_seq " + U(c.record_seq) + " != child " + U(kid->record_seq);
+        if (kid_coalesced) {
+            // ★★S3(교차 r8 Z3) — 구 판은 "NA 가 아니다"만 봤다. 대구간의 귀속은 이 행이 **권위**
+            //   이므로 실제 records 행과 `layer/expert/generation` 까지 맞아야 한다(child 의
+            //   generation 이 NA 라 위의 generation 동치 검사는 대구간에서 스킵된다 — §5-5·§5-6).
+            if (c.record_seq == ~(uint64_t)0)
+                return "copies join: a coalesce copy must carry a real record_seq (it owns the attribution)";
+            const T_Io3Record * rec = nullptr;
+            for (const auto & r : a.recs) if (r.record_seq == c.record_seq) { rec = &r; break; }
+            if (!rec) return "copies join: coalesce copy references a missing records row " + U(c.record_seq);
+            if (rec->layer != c.layer || rec->expert != c.expert)
+                return "copies join: coalesce copy (layer,expert)=(" + U(c.layer) + "," + U(c.expert) +
+                       ") != its records row (" + U(rec->layer) + "," + U(rec->expert) + ")";
+            if (rec->generation != c.generation)
+                return "copies join: coalesce copy generation " + U(c.generation) +
+                       " != its records row " + U(rec->generation);
+        }
+        // src_kind(flags b1) 0=bounce 1=coalesce staging ↔ child flags b3(bounce)·b4(coalesced)
+        {
+            const bool cp_bounce   = ((c.flags & 0x02) == 0);
+            const bool kid_bounce  = ((kid->flags & 0x08) != 0);
+            const bool kid_coal    = ((kid->flags & 0x10) != 0);
+            if (cp_bounce != kid_bounce || (!cp_bounce && !kid_coal))
+                return "copies join: src_kind does not match the child flags (copy b1=" +
+                       U((uint64_t)((c.flags >> 1) & 1)) + " child bounce=" + U((uint64_t)kid_bounce) +
+                       " coalesced=" + U((uint64_t)kid_coal) + ")";
+        }
+        if (c.coalesce_group != kid->coalesce_group)
+            return "copies join: coalesce_group " + U(c.coalesce_group) + " != child " + U(kid->coalesce_group);
+        if (c.part != kid->part)
+            return "copies join: part " + U(c.part) + " != child " + U(kid->part);
+        // ★A6 — 대구간 child 의 `expert` 는 **run 시작 expert** 라 참가 record 마다 다르다(§5-4).
+        //   층은 그대로 같아야 하고, expert 는 run 안이어야 한다(연속열 자체는 ④′ 가 잠근다).
+        if (c.layer != kid->layer) return "copies join: layer != child";
+        if (!kid_coalesced) {
+            if (c.expert != kid->expert) return "copies join: expert != child";
+        } else if (c.expert < kid->expert) {
+            return "copies join: coalesce copy expert " + U(c.expert) + " is below the run start " +
+                   U(kid->expert);
+        }
+        // generation — 단독 child 는 records 와 같은 값을 갖고 copies 는 그 dest slot 확정값이다.
+        if (kid->generation != ~(uint64_t)0 && c.generation != kid->generation)
+            return "copies join: generation " + U(c.generation) + " != child " + U(kid->generation);
+        // status 정합 — 읽기가 실패/취소된 child 아래에서 copy 가 OK 로 설 수 없다.
+        if (c.status == 1 && kid->terminal_status != 1)
+            return "copies join: copy OK under a non-OK child (status " + U(kid->terminal_status) + ")";
+        // bytes 는 slice(브라켓 미포함)라 물리 read 길이를 넘을 수 없다.
+        if (c.bytes == 0 || (uint64_t)c.bytes > (uint64_t)kid->read_len)
+            return "copies join: bytes " + U(c.bytes) + " out of range vs child read_len " + U(kid->read_len);
+        // ── §5-5 상태·시각 규약
+        if (c.enqueue_qpc > 0 && c.done_qpc == 0) return "copies: enqueue>0 with done=0 (forbidden)";
+        const bool no_worker = (c.worker == 0xFF);
+        const bool no_start  = (c.start_qpc == 0);
+        if (no_worker != no_start) return "copies: worker==0xFF must be equivalent to start_qpc==0";
+        if (c.start_qpc > 0 && c.done_qpc < c.start_qpc) return "copies: done_qpc < start_qpc";
+        if (c.start_qpc > 0 && c.enqueue_qpc > 0 && c.start_qpc < c.enqueue_qpc)
+            return "copies: start_qpc < enqueue_qpc";
+    }
+    // ⑦ ★QD 재생 검증(§5-6) — 사건 seq 순으로 origin 별 submit=+1 / terminal=−1 을
+    //   재생해 각 행의 QD snapshot 6필드와 전건 일치해야 한다. 실값이 아니면(전부 0)
+    //   여기서 즉시 깨진다 — 그게 이 관문이 공허하지 않은 이유다.
+    {
+        struct Ev { uint64_t seq; int origin; int delta; size_t row; bool is_submit; };
+        std::vector<Ev> evs;
+        for (size_t i = 0; i < a.kids.size(); i++) {
+            evs.push_back(Ev{ a.kids[i].submit_event_seq,   a.kids[i].origin, +1, i, true  });
+            evs.push_back(Ev{ a.kids[i].terminal_event_seq, a.kids[i].origin, -1, i, false });
+        }
+        std::sort(evs.begin(), evs.end(), [](const Ev & x, const Ev & y) { return x.seq < y.seq; });
+        int d = 0, p = 0;
+        for (const auto & e : evs) {
+            if (e.origin) p += e.delta; else d += e.delta;
+            const T_Io3Child & k = a.kids[e.row];
+            const uint8_t want_d = (uint8_t)(d > 255 ? 255 : d);
+            const uint8_t want_p = (uint8_t)(p > 255 ? 255 : p);
+            const uint8_t want_t = (uint8_t)((d + p) > 255 ? 255 : (d + p));
+            const uint8_t * got = e.is_submit ? k.qd_at_submit : k.qd_at_terminal;
+            if (got[0] != want_d || got[1] != want_p || got[2] != want_t)
+                return std::string("QD replay mismatch at event ") + U(e.seq) + (e.is_submit ? " (submit)" : " (terminal)") +
+                       " got " + U(got[0]) + "/" + U(got[1]) + "/" + U(got[2]) +
+                       " want " + U(want_d) + "/" + U(want_p) + "/" + U(want_t);
+        }
+        if (d != 0 || p != 0) return "QD replay does not return to zero";
+    }
+    // ⑧ ★★cap 준수 검산 **6항**(§5-6 · R13). 구 판은 1항(qd_total)뿐이었고 나머지 5항이
+    //   없는 채로 "§5-6 전체"라 이름 붙어 있었다(교차 r5 Y4·Y7).
+    //   ★bin 분기(§5-6): off 104..115 가 전부 0 인지만 확인하고 virtual cap 비교는 N/A 다.
+    if (a.hc.engine_mode != 2) {
+        for (int i = 0; i < 6; i++)
+            if (a.hc.io_params[i] != 0 || a.hc.io_param_src[i] != 0)
+                return "bin header must keep the resolved IO parameter area zero (section 5-2)";
+    } else {
+        const int cap_total   = (int)a.hc.io_params[0];
+        const int reserve     = (int)a.hc.io_params[1];
+        const int cap_pf      = (int)a.hc.io_params[2];
+        const int cap_part    = (int)a.hc.io_params[3];
+        const int cap_workers = (int)a.hc.io_params[4];
+        const int cap_copyq   = (int)a.hc.io_params[5];
+        if (cap_total <= 0) return "virtual header must carry a resolved io_qd_total";
+        // ── ①~④: 사건 seq 순 재생(같은 카운터라 전 구간을 원자 순서로 훑는다)
+        // ★★S3(교차 r8 Z3) — 구 판은 `record_seq=NA` 인 대구간 child 를 그냥 건너뛰어서 ON 열의
+        //   **record 별 part cap 이 아예 검사되지 않았다**. 대구간의 귀속은 copies 가 권위이므로,
+        //   그 child 의 [submit, terminal) 구간을 **참가 record 각각에** 계상한다.
+        struct Ev2 { uint64_t seq; int origin; int delta; std::vector<uint64_t> recs; };
+        std::vector<Ev2> ev;
+        for (const auto & k : a.kids) {
+            std::vector<uint64_t> owners;
+            if (k.record_seq != ~(uint64_t)0) {
+                owners.push_back(k.record_seq);
+            } else {
+                for (const auto & c : a.cps)
+                    if (c.src_child_submit_event_seq == k.submit_event_seq) owners.push_back(c.record_seq);
+                if (owners.empty()) return "cap: a coalesced child has no copies row to attribute it to";
+            }
+            ev.push_back(Ev2{ k.submit_event_seq,   k.origin, +1, owners });
+            ev.push_back(Ev2{ k.terminal_event_seq, k.origin, -1, owners });
+        }
+        std::sort(ev.begin(), ev.end(), [](const Ev2 & x, const Ev2 & y) { return x.seq < y.seq; });
+        int d = 0, p = 0;
+        std::map<uint64_t, int> per_rec;
+        const int pf_room = (cap_total > reserve) ? (cap_total - reserve) : 0;
+        for (const auto & e : ev) {
+            if (e.origin) p += e.delta; else d += e.delta;
+            for (uint64_t r : e.recs) per_rec[r] += e.delta;
+            if (d + p > cap_total)
+                return "cap: qd_total " + U((uint64_t)(d + p)) + " > io_qd_total " + U((uint64_t)cap_total);
+            if (p > pf_room)
+                return "cap: prefetch depth " + U((uint64_t)p) + " breaks the demand reserve room " + U((uint64_t)pf_room);
+            if (p > cap_pf)
+                return "cap: prefetch child " + U((uint64_t)p) + " > io_qd_prefetch_child_max " + U((uint64_t)cap_pf);
+            for (uint64_t r : e.recs) {
+                if (per_rec[r] > cap_part)
+                    return "cap: record " + U(r) + " concurrent child membership " + U((uint64_t)per_rec[r]) +
+                           " > io_part_parallelism " + U((uint64_t)cap_part);
+            }
+        }
+        // ── ⑤⑥: copy 축 2계열 구간 겹침(§6 행 조건 — 미enqueue/미착수 행은 자동 제외)
+        auto max_overlap = [](const std::vector<std::pair<uint64_t, uint64_t>> & iv) {
+            std::vector<std::pair<uint64_t, int>> pts;
+            for (const auto & s : iv) { pts.push_back({ s.first, +1 }); pts.push_back({ s.second, -1 }); }
+            // 같은 시각이면 **종료 먼저**(반개구간 [start, done) — 맞닿은 두 구간은 겹침이 아니다)
+            std::sort(pts.begin(), pts.end(), [](const std::pair<uint64_t, int> & x,
+                                                 const std::pair<uint64_t, int> & y) {
+                return x.first != y.first ? x.first < y.first : x.second < y.second;
+            });
+            int cur = 0, mx = 0;
+            for (const auto & q : pts) { cur += q.second; if (cur > mx) mx = cur; }
+            return mx;
+        };
+        std::vector<std::pair<uint64_t, uint64_t>> qiv, wiv;
+        for (const auto & c : a.cps) {
+            if (c.enqueue_qpc > 0 && c.done_qpc > c.enqueue_qpc) qiv.push_back({ c.enqueue_qpc, c.done_qpc });
+            if (c.start_qpc   > 0 && c.done_qpc > c.start_qpc)   wiv.push_back({ c.start_qpc,   c.done_qpc });
+        }
+        const int q_peak = max_overlap(qiv), w_peak = max_overlap(wiv);
+        if (q_peak > cap_copyq)
+            return "cap: copy queue depth " + U((uint64_t)q_peak) + " > io_bounce_copy_qd " + U((uint64_t)cap_copyq);
+        if (w_peak > cap_workers)
+            return "cap: copy worker busy " + U((uint64_t)w_peak) + " > io_bounce_copy_workers " + U((uint64_t)cap_workers);
+    }
+    // ⑥ copy 의무를 지는 child 는 **바운스(b3) 또는 대구간(b4)** 뿐이다. 슬롯에 직착지한
+    //   단독 aligned child 는 copy 가 없다 — 있으면 그 행은 어디에서도 실행되지 않는 의무다.
+    //   ★A6 전에는 b3 단독 조건이었다(대구간이 존재하지 않았으므로 같은 뜻이었다).
+    for (const auto & c : a.cps) {
+        for (const auto & k : a.kids) {
+            if (k.submit_event_seq != c.src_child_submit_event_seq) continue;
+            if (!(k.flags & 0x08) && !(k.flags & 0x10))
+                return "copies row bound to a child that is neither bounce nor coalesced";
+        }
+    }
+    return "";
+}
