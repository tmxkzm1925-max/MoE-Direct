+
+    // ---- ★★S1(교차 r8 Z2-2) 공용 copy credit — **수리 전이면 여기서 fatal 이 난다** ----
+    //   그룹 하나의 `copy_qd/parts` 상한은 필요조건일 뿐이다. 두 그룹이 공존하면 회수 시점에
+    //   의무가 한꺼번에 큐로 몰려 용량을 넘고, 구 판은 그 자리에서 `fatal_abort` 했다.
+    //   형상: copy_qd=8 · parts=2 ⇒ run 상한 4 · max_bytes 로 run 을 4 로 잘라 두 묶음을 만든다.
+    //   copy worker 를 세워 첫 묶음의 의무가 큐에 남아 있는 상태에서 두 번째 묶음을 만나게 한다.
+    {
+        V3CoalEnv env("prefill", "0", "40960", "8");
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a6_credit", /*n_shards=*/1, "8");
+        if (check(lv.ok, "V3i17a. 공용 copy credit 픽스처 seal [" + lv.why + "]")) {
+            ggml_moe_direct_test_v3_arm_copy(/*pause=*/1, /*fail_copy_part=*/-2);   // scatter 정지
+            ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+            std::vector<int32_t> ids;
+            for (int32_t e = 0; e < 8; e++) ids.push_back(e);
+            std::thread th([&]{ ggml_moe_direct_acquire(gate0, ids.data(), 8, /*n_tokens_hint=*/8); });
+            // 첫 묶음이 회수돼 의무를 큐에 채우고, 두 번째 묶음이 크레딧을 못 받는 순간까지 기다린다.
+            V3CoalStat mid;
+            for (int i = 0; i < 500; i++) {
+                mid.snap();
+                if (mid.credit_stalls > 0) break;
+                Sleep(2);
+            }
+            check(mid.credit_stalls > 0 && mid.copy_outstanding <= 8,
+                  "V3i17. ★★S1 — 공용 copy 크레딧이 **제출 전에** 막는다: 예약량 " +
+                  std::to_string(mid.copy_outstanding) + " ≤ io_bounce_copy_qd(8) 이고 크레딧 부족 "
+                  "미제출 " + std::to_string((unsigned long long)mid.credit_stalls) +
+                  "회(수리 전이면 두 번째 묶음이 그대로 제출돼 회수 시점에 큐가 넘치고 fatal_abort "
+                  "했다 — 유효한 opt-in 설정에서 도달하는 경로다) [" + mid.tag() + "]");
+            ggml_moe_direct_test_v3_arm_copy(/*pause=*/0, /*fail_copy_part=*/-2);
+            th.join();
+            V3CoalStat done; done.snap();
+            bool parity = true;
+            for (int32_t e = 0; e < 8; e++) {
+                parity = parity && v3_verify_ptr_bytes(fx, 0, 0, e);
+                parity = parity && v3_verify_ptr_bytes(fx, 0, 1, e);
+            }
+            check(parity && done.copy_outstanding == 0,
+                  "V3i18. 재개 후 8 expert × 2 part 바이트 전건 일치 · 크레딧 **전량 반납**(잔여 " +
+                  std::to_string(done.copy_outstanding) + " — 예약~완료 회계가 새지 않는다) [" +
+                  done.tag() + "]");
+            ggml_moe_direct_release(gate0, ids.data(), 8);
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ★⑦ record READY = 그 record 의 **모든 part** scatter 완료 후 ----
+    //   copy worker 를 세우면 대구간 read 는 끝나도 scatter 가 안 끝난다 ⇒ 그 사이 publish 0.
+    {
+        V3CoalEnv env("prefill", "0", "67108864", "16");
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a6_ready", /*n_shards=*/1, "8");
+        if (check(lv.ok, "V3i15a. READY 픽스처 seal [" + lv.why + "]")) {
+            uint64_t pub0 = 0;
+            ggml_moe_direct_test_v3_child_stats(nullptr, nullptr, nullptr, &pub0);
+            ggml_moe_direct_test_v3_arm_copy(/*pause=*/1, /*fail_copy_part=*/-2);
+            ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+            std::vector<int32_t> ids;
+            for (int32_t e = 0; e < 4; e++) ids.push_back(e);
+            std::thread th([&]{ ggml_moe_direct_acquire(gate0, ids.data(), 4, /*n_tokens_hint=*/4); });
+            // ★★S3(교차 r8 Z1-2) — 관측점은 **회수 완료**여야 한다. 구 판은 `v3_coal_groups`
+            //   를 기다렸는데 그 카운터는 `ReadFile` **전에** 오르므로 "대구간 회수 완료 · scatter
+            //   미완" 상태를 보장하지 못했다(제출 직후를 보고 publish 0 이라 해도 당연한 값이다).
+            uint64_t reads_retired = 0, pub_mid = 0;
+            for (int i = 0; i < 500; i++) {
+                V3CoalStat s; s.snap();
+                reads_retired = s.reads_retired;
+                if (reads_retired >= 2) break;
+                Sleep(2);
+            }
+            ggml_moe_direct_test_v3_child_stats(nullptr, nullptr, nullptr, &pub_mid);
+            // 대구간 read 는 제출·회수됐는데 scatter 가 멈춰 있다 ⇒ 아직 아무 record 도 READY 가 아니다.
+            check(reads_retired >= 2 && pub_mid == pub0,
+                  "V3i15. ★§3-6 ⑦ — 대구간 " + std::to_string((unsigned long long)reads_retired) +
+                  "건이 **회수 완료**됐는데도 scatter 가 멈춰 있는 동안 publish 는 " +
+                  std::to_string((unsigned long long)(pub_mid - pub0)) + "건(record READY 는 그 record 의 "
+                  "**모든 part** scatter 완료 후에만 선다 · 관측점=read terminal)");
+            ggml_moe_direct_test_v3_arm_copy(/*pause=*/0, /*fail_copy_part=*/-2);
+            th.join();
+            uint64_t pub1 = 0;
+            ggml_moe_direct_test_v3_child_stats(nullptr, nullptr, nullptr, &pub1);
+            V3CoalStat s2; s2.snap();
+            bool parity = true;
+            for (int32_t e = 0; e < 4; e++) {
+                parity = parity && v3_verify_ptr_bytes(fx, 0, 0, e);
+                parity = parity && v3_verify_ptr_bytes(fx, 0, 1, e);
+            }
+            check((pub1 - pub0) == 4 && s2.scatters == 8 && parity,
+                  "V3i16. 재개하면 4 record 전건 publish · scatter " +
+                  std::to_string((unsigned long long)s2.scatters) + "건 완료 · 바이트 일치");
+            ggml_moe_direct_release(gate0, ids.data(), 4);
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+}
