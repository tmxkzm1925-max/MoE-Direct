+#define GGML_MOE_PHASEB_NORM_NONE      0
+#define GGML_MOE_PHASEB_NORM_ATTN_POST 1   // blk.%d.post_attention_norm.weight
+#define GGML_MOE_PHASEB_NORM_FFN       2   // blk.%d.ffn_norm.weight
