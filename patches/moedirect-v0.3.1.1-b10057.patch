+// ── P17. ★동일 intent 다중 rank probation victim 순서(R1 #7) ──
+static void test_pb_multi_rank_victim() {
+    section("P17. ★동일 intent 다중 rank probation — victim 키 (intent_ordinal, rank, slot) 순서");
+    PbEnv env("8", "8", "6", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_rank");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P17a. seal 성공(QD8·N6)")) return;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    // 캐시 포화(빈 슬롯 제거) → probation 이 최우선 victim 이 되도록.
+    std::vector<int32_t> fill((size_t)PB_TEST_N_EXPERT);
+    for (int32_t i = 0; i < PB_TEST_N_EXPERT; i++) fill[(size_t)i] = i;
+    ggml_moe_direct_acquire(g0, fill.data(), PB_TEST_N_EXPERT, PB_TEST_N_EXPERT);
+    ggml_moe_direct_release(g0, fill.data(), PB_TEST_N_EXPERT);
+    pb_push_and_settle(0, 0, 0, 0, 1, {0,1,2,3,4,5,6,7});
+
+    // 살아남은 probation 슬롯들 중 최소 (ordinal, rank, slot) 를 테스트가 독립 계산한다.
+    int32_t best = -1; uint64_t best_ord = 0; int32_t best_rank = 0;
+    int32_t n_prob = 0;
+    for (int32_t i = 0; i < PB_TEST_N_EXPERT; i++) {
+        int32_t c = -1, rk = -1; uint64_t o = 0;
+        ggml_moe_direct_test_slot_class(i, &c, &o, &rk);
+        if (c != GGML_MOE_PB_CLASS_PROBATION) continue;
+        n_prob++;
+        if (best < 0 || o < best_ord || (o == best_ord && rk < best_rank)) { best = i; best_ord = o; best_rank = rk; }
+    }
+    if (!check(n_prob >= 2 && best >= 0,
+               "P17b. 동일 intent 의 probation 슬롯 " + std::to_string(n_prob) + "건 확보(최소 키 slot=" +
+               std::to_string(best) + " rank=" + std::to_string(best_rank) + ")")) return;
+    int32_t fresh = PB_TEST_N_EXPERT - 1;
+    ggml_moe_direct_acquire(g1, &fresh, 1, 1);
+    int32_t vslot = -1; uint64_t vgen = 0;
+    ggml_moe_direct_test_record_slot((int64_t)1 * PB_TEST_N_EXPERT + fresh, &vslot, &vgen);
+    check(vslot == best,
+          "P17c. ★★victim = 최소 (intent_ordinal, rank, slot) probation 슬롯 — 기대 " +
+          std::to_string(best) + "(rank " + std::to_string(best_rank) + ") · 실제 " + std::to_string(vslot) +
+          " · rank 성분이 없으면 slot index 순으로 뒤집힌다");
+    ggml_moe_direct_release(g1, &fresh, 1);
+}
