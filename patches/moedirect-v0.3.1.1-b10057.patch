+// ===========================================================================
+// XSTORE - E-2a new boundary surface (E2_DESIGN_CONTRACT.md v0.4 FROZEN)
+//
+// What this group locks, and why each item needs a gate of its own:
+//   * the token is now the ONLY thing pairing an acquire with a release, so a stale or
+//     doubly-returned handle has to be fatal rather than quietly ignored (section 6 E2-U1).
+//     A fatal cannot be observed in-process, so those arms run as child processes.
+//   * the view has six ordered checks and NONE of them may write a partial result: a
+//     half-filled view hands the caller a pointer next to a byte count that describes
+//     something else. Every soft-failure arm below poisons `out` first and asserts it is
+//     untouched afterwards.
+//   * the byte count now comes FROM the store. Until E-2c the consumers still compute it
+//     themselves from nb02/nb11, so the two are compared here while both still exist
+//     (contract section 0 item 2 - the cross-check is the no-regression evidence).
+//   * DRAINING is the hole E-1 G-1-7 named: the old graceful drain never inspected the
+//     inference total at all. The gate has to show all three behaviours - new acquires
+//     refused, releases of BOTH surfaces still accepted, and the residual fatal.
+//   * the drain's deadline is ONE budget anchored at drain_begin. A stage that starts its
+//     own clock turns a 30 s drain into 30 s per stage, and "check once" silently becoming
+//     the 30 s default is the same bug wearing a different hat. Both are measured, not
+//     asserted: the gates burn a known slice of wall clock and ask what is left.
+//   * admission and the zero-confirm have to sit on one boundary. An acquire that has read
+//     RUNNING owes a lease unit the ledger cannot see yet, so a ledger-only zero-confirm can
+//     stop the store underneath it. Pausing the dispatcher parks a REAL acquire in exactly
+//     that window, which is why that gate needs no injection hook.
+//   * the residual inventory is a LEASE inventory, not a token list (r3). The legacy-only
+//     child proves that: it leaves an old-surface lease, mints no token, and the captured
+//     abort output must still name the slot while reporting zero tokens.
+//
+// Block map: A seal/epoch/adapter . B acquire/token/view/release . C the view's soft-failure
+// arms . D failure atomicity . E DRAINING and the single deadline . F admission vs the
+// zero-confirm . G the epoch counter across seals . H the fatal arms, one child each .
+// I the stop chain's ONE budget - E drives the anchor, I drives the chain BELOW drain_finish.
+// ===========================================================================
+
+// Two MoE layers x 3 parts, 8 experts, 8 slots - the same shape the C/I groups use, so a
+// leased slot is a real eviction blocker rather than a formality.
+static int xstore_seal_basic(Fixture & fx, const char * tag) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "synth";
+    fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 2;
+    fx.model.sources = { default_source() };
+    fx.model.layers = { make_separate_layer(0, 8, "MXFP4", false),
+                        make_separate_layer(1, 8, "MXFP4", false) };
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.build();
+    return fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+}
+
+// part_idx -> tensor for one MoE layer, read back from the engine rather than assumed from
+// the fixture's construction order. If the two ever disagree the map comes out short and
+// every dependent check fails, which is the intended coupling.
+static void xstore_part_tensors(Fixture & fx, int32_t layer, ggml_tensor * out[3]) {
+    out[0] = out[1] = out[2] = nullptr;
+    const char * suf[3] = { "gate", "up", "down" };
+    for (int i = 0; i < 3; i++) {
+        ggml_tensor * t = fx.find("blk." + std::to_string(layer) + ".ffn_" + suf[i] +
+                                  "_exps.weight");
+        if (!t) continue;
+        int32_t lay = -1, part = -1;
+        if (ggml_moe_direct_registered_layer_part(t, &lay, &part) != 0) continue;
+        if (part >= 0 && part < 3) out[part] = t;
+    }
+}
+
+// A view struct pre-poisoned with a sentinel, so "out untouched" is checkable rather than
+// merely plausible.
+static const void * const XSTORE_POISON_PTR   = (const void *)(uintptr_t)0xDEADBEEFDEADBEEFull;
+static const uint64_t     XSTORE_POISON_BYTES = 0xA5A5A5A5A5A5A5A5ull;
+
+static ggml_moe_buffer_view xstore_poisoned_view() {
+    ggml_moe_buffer_view v;
+    v.ptr   = XSTORE_POISON_PTR;
+    v.bytes = XSTORE_POISON_BYTES;
+    return v;
+}
+static bool xstore_view_untouched(const ggml_moe_buffer_view & v) {
+    return v.ptr == XSTORE_POISON_PTR && v.bytes == XSTORE_POISON_BYTES;
+}
+
+// Child modes. A fatal takes the process with it, so there is one mode per fatal.
+//   exit 0xC0000409 = the contract fired (what the parent expects)
+//   exit 0          = the contract did NOT fire - a real gate failure
+//   exit 77         = the fixture itself failed
+//   exit 78         = the child's own precondition did not hold, so the fatal it went on to
+//                     provoke would not have meant what the gate reads it as
+// Lines the parent parses out of the capture are printed to stderr and flushed before the
+// call that aborts, because an abort does not run atexit handlers. XGEN03 parses one line the
+// child itself never prints - the fatal_abort message, emitted on the abort path where nothing
+// of ours runs afterwards - which is why this function unbuffers stderr before touching it.
+static int run_xstore_fatal_child(const char * mode) {
+    // XGEN03 reads a message that fatal_abort prints on the way out, and the way out is
+    // __fastfail: nothing after ggml_abort's fprintf gets to flush anything. log_err flushes
+    // itself, so every capture assertion before this atom was covered; the abort line is not.
+    // Unbuffer stderr HERE, before this process has touched the stream at all, so what the
+    // parent reads does not depend on how the CRT decided to buffer a redirected handle.
+    (void)setvbuf(stderr, nullptr, _IONBF, 0);
+    init_scratch_root();
+    Fixture * fx = new Fixture();   // the process is about to die; nothing to free
+    if (xstore_seal_basic(*fx, "xstore_fatal") != 0) {
+        fprintf(stderr, "xstore-fatal-child(%s): seal failed\n", mode);
+        return 77;
+    }
+    ggml_tensor * g0 = fx->find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx->find("blk.1.ffn_gate_exps.weight");
+    if (!g0 || !g1) {
+        fprintf(stderr, "xstore-fatal-child(%s): tensor lookup failed\n", mode); return 77;
+    }
+    static int32_t ids[2] = { 0, 3 };
+
+    if (std::strcmp(mode, "stale") == 0) {
+        // A handle that never named anything: index 1, generation 1, against an empty table.
+        ggml_moe_store_release(0x0000000000010001ull);
+        fprintf(stderr, "xstore-fatal-child(stale): no fatal - a fabricated handle was accepted\n");
+        return 0;
+    }
+
+    if (std::strcmp(mode, "viewstale") == 0) {
+        // view step 1, the handle half. The header splits the view's failures in two - steps
+        // 2..5 are soft refusals, step 1 is fatal - and only a separate process can show the
+        // fatal half, so the split is asserted rather than assumed.
+        ggml_moe_buffer_view v = xstore_poisoned_view();
+        (void)ggml_moe_store_view(0x0000000000010001ull, 0, 0, &v);   // <- the fatal
+        fprintf(stderr, "xstore-fatal-child(viewstale): no fatal - the view accepted a "
+                        "fabricated handle\n");
+        return 0;
+    }
+
+    if (std::strcmp(mode, "genlast") == 0) {
+        // The boundary from BELOW. With the counter armed to the last generation the handle
+        // encoding can carry, a whole acquire/view/release still goes through and the process
+        // exits 0. Without this arm the atom would only show the guard firing, and nothing
+        // would separate "refuses past the boundary" from "refuses one mint early".
+        ggml_moe_direct_test_xstore_arm_last_generation();
+        uint64_t t = 0;
+        if (ggml_moe_store_acquire(0, 0, ids, 2, 1, &t) != 0 || t == 0) {
+            fprintf(stderr, "xstore-fatal-child(genlast): the LAST usable generation was "
+                            "refused at acquire - the guard fires one mint early\n");
+            return 78;
+        }
+        ggml_moe_buffer_view v = xstore_poisoned_view();
+        const int vr = ggml_moe_store_view(t, ids[0], 0, &v);
+        if (vr != 0 || xstore_view_untouched(v)) {
+            fprintf(stderr, "xstore-fatal-child(genlast): the view through a last-generation "
+                            "handle did not resolve [rc=%d untouched=%d]\n",
+                    vr, xstore_view_untouched(v) ? 1 : 0);
+            return 78;
+        }
+        ggml_moe_store_release(t);
+        return 0;
+    }
+
+    if (std::strcmp(mode, "genexh") == 0) {
+        // The boundary from ABOVE. Spend the last generation the encoding can carry, hand the
+        // token back so the table is quiescent again, and mint once more: that mint is the
+        // fatal. It happens AT THE MINT, which is the whole point - before this atom the same
+        // state died at whichever consumer first touched the truncated handle, with a message
+        // that named a stale handle instead of an exhausted counter.
+        ggml_moe_direct_test_xstore_arm_last_generation();
+        uint64_t t = 0;
+        if (ggml_moe_store_acquire(0, 0, ids, 2, 1, &t) != 0 || t == 0) {
+            fprintf(stderr, "xstore-fatal-child(genexh): the LAST usable generation was "
+                            "refused, so the mint after it is not the boundary\n");
+            return 78;
+        }
+        ggml_moe_store_release(t);
+        uint64_t t2 = 0;
+        (void)ggml_moe_store_acquire(0, 0, ids, 2, 1, &t2);   // <- the fatal, at the mint
+        fprintf(stderr, "xstore-fatal-child(genexh): no fatal - a handle was minted past the "
+                        "generation space the encoding carries\n");
+        return 0;
+    }
+
+    uint64_t tok = 0;
+    if (ggml_moe_store_acquire(0, 0, ids, 2, 1, &tok) != 0 || tok == 0) {
+        fprintf(stderr, "xstore-fatal-child(%s): store_acquire failed\n", mode);
+        return 77;
+    }
+
+    if (std::strcmp(mode, "dblrel") == 0) {
+        ggml_moe_store_release(tok);
+        ggml_moe_store_release(tok);          // <- the fatal
+        fprintf(stderr, "xstore-fatal-child(dblrel): no fatal - the handle was returned twice\n");
+        return 0;
+    }
+
+    if (std::strcmp(mode, "epoch") == 0 || std::strcmp(mode, "viewepoch") == 0) {
+        // Hand the lease units back through the OLD surface so the drain can reach zero while
+        // the token is still live. That mixed-surface window is what E-2b opens as consumers
+        // migrate one at a time, which is what makes "used outside its epoch" reachable here
+        // without any injection hook. `epoch` then RETURNS the token, `viewepoch` VIEWS
+        // through it - step 1 of the view is the same fatal class as release.
+        ggml_moe_direct_release(g0, ids, 2);
+        if (ggml_moe_store_drain_begin() != 0) {
+            fprintf(stderr, "xstore-fatal-child(%s): drain_begin refused\n", mode); return 77;
+        }
+        if (ggml_moe_store_drain_finish(MOE_DRAIN_DEADLINE_MS) != 0) {
+            fprintf(stderr, "xstore-fatal-child(%s): drain_finish did not complete\n", mode);
+            return 77;
+        }
+        if (ggml_moe_store_epoch() != 0) {
+            fprintf(stderr, "xstore-fatal-child(%s): the epoch survived the drain\n", mode);
+            return 77;
+        }
+        if (std::strcmp(mode, "viewepoch") == 0) {
+            ggml_moe_buffer_view v = xstore_poisoned_view();
+            (void)ggml_moe_store_view(tok, ids[0], 0, &v);   // <- the fatal
+            fprintf(stderr, "xstore-fatal-child(viewepoch): no fatal - a view went through a "
+                            "token that outlived its epoch\n");
+            return 0;
+        }
+        ggml_moe_store_release(tok);          // <- the fatal
+        fprintf(stderr, "xstore-fatal-child(epoch): no fatal - a token outlived its epoch\n");
+        return 0;
+    }
+
+    if (std::strcmp(mode, "view5") == 0) {
+        // view step 5 AND the release capture comparison, in one child, because they are two
+        // halves of one state: the OLD surface hands the lease back while the token is still
+        // live, the slot stops being pinned, the eviction below actually takes it, and from
+        // there the token describes a slot that now belongs to someone else. The view must
+        // REFUSE softly (printed for the parent, `out` untouched), and returning the token
+        // must be FATAL - a quiet return would decrement the new owner's lease.
+        ggml_moe_direct_release(g0, ids, 2);
+        for (int32_t e = 0; e < 8; e++) {
+            ggml_moe_direct_acquire(g1, &e, 1, 1);
+            ggml_moe_direct_release(g1, &e, 1);
+        }
+        ggml_moe_buffer_view v = xstore_poisoned_view();
+        const int vr = ggml_moe_store_view(tok, ids[0], 0, &v);
+        fprintf(stderr, "xstore-view5: step5 rc=%d out_untouched=%d\n",
+                vr, xstore_view_untouched(v) ? 1 : 0);
+        fflush(stderr);
+        if (vr >= 0 || !xstore_view_untouched(v)) {
+            fprintf(stderr, "xstore-view5: the stale capture was not refused softly - the "
+                            "fatal below would not be evidence for step 5\n");
+            return 78;
+        }
+        ggml_moe_store_release(tok);          // <- the fatal: the capture no longer matches
+        fprintf(stderr, "xstore-view5: no fatal - a token with a stale capture was returned "
+                        "quietly\n");
+        return 0;
+    }
+
+    if (std::strcmp(mode, "drain") == 0) {
