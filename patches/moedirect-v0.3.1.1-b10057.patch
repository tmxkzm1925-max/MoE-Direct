+static void test_s2_range() {
+    section("P42. ★레버 A 단계 1 S2 — range graph + boundary: admission·bank·reuse key·실패 처분표·"
+            "실패 정리 순서(반환값·예외 unwind)·동결 뷰·lmtrace range 태그(하위 호환)");
+
+    // ★자립 적재 — 이 그룹의 ⓑ bank 픽스처는 CPU device 를 **조회만** 하므로(엔진측
+    //   llama-context.cpp 의 `P42b0. 픽스처용 buft 확보(CPU device)`), backend 가 이미
+    //   등록돼 있지 않으면 조회가 nullptr 을 돌려준다. 전량 런에서는 앞선 그룹(F 등)이
+    //   부른 덕에 가려졌지만 `--filter P42` 단독 런은 그 선행 호출이 없어 붉어졌다.
+    //   ⇒ 그룹이 자기 전제를 직접 세운다. 중복 호출은 무해하다 —
+    //   ggml-backend-reg.cpp 의 register_backend() 가 같은 reg 포인터를 이미 담고 있으면
+    //   그대로 반환하므로(중복 등록 가드), 전량 런에서 이 호출은 no-op 이다.
+    ggml_backend_load_all();
+
+    // --- ⓐ 엔진 내부 픽스처(llama_s2_selfcheck) — 회계 일치까지 확인 ---
+    const int before_total  = g_total;
+    const int before_failed = g_failed;
+
+    const int engine_failed = llama_s2_selfcheck(s2_engine_cb, nullptr);
+
+    const int harness_total  = g_total  - before_total;
+    const int harness_failed = g_failed - before_failed;
+
+    check(harness_total > 0 && engine_failed == harness_failed,
+          "P42z. ★회계 일치 — llama_s2_selfcheck 가 돌려준 실패 수와 하네스가 센 FAIL 수가 같다"
+          "(콜백 누락·이중 계수 0)");
+
+    // --- ⓑ lmtrace range 태그 layout 왕복 + 하위 호환 ---
+    const std::wstring dir = make_case_dir("p42_s2_lmtrace");
+
+    std::vector<uint8_t> rec_plain;
+    std::vector<uint8_t> rec_tagged;
+
+    {
+        EnvGuard g1("MOE_DIRECT_LMTRACE", "1");
+        EnvGuard g2("MOE_DIRECT_LMTRACE_OUT", wide_to_utf8(dir + L"\\plain").c_str());
+        ggml_moe_lmtrace_test_reset();
+
+        // 태그 무장 없이 1건 — 구 레이아웃과 바이트 동일이어야 한다.
+        ggml_moe_lmtrace_graph_boundary(1, 512);
+        lm_s0::GraphFix fx; lm_s0::build_graph(fx, 8, "s2_plain");
+        lm_s0::capture(fx);
+        ggml_moe_lmtrace_request_finish();
+
+        rec_plain = lm_s2::first_record(lm_s0::read_all(dir + L"\\plain.lmt"));
+    }
+
+    check(!rec_plain.empty() &&
+          lm_s0::rd_u32le(rec_plain, lm_s2::OFF_LAYOUT)    == MOE_LMTRACE_LAYOUT_VERSION &&
+          lm_s0::rd_u32le(rec_plain, lm_s2::OFF_TAG_FLAGS) == MOE_LMTRACE_TAG_FLAG_NONE,
+          "P42t1. ★하위 호환 — 태그 무장 없이 캡처하면 layout_version=1 유지 + tag_flags(구 reserved)=0. "
+          "S0 baseline 파일과 같은 레이아웃이라 기존 판독이 그대로 성립한다");
+
+    {
+        EnvGuard g1("MOE_DIRECT_LMTRACE", "1");
+        EnvGuard g2("MOE_DIRECT_LMTRACE_OUT", wide_to_utf8(dir + L"\\tagged").c_str());
+        ggml_moe_lmtrace_test_reset();
+
+        ggml_moe_lmtrace_request_prefill_enter(2048);
+
+        ggml_moe_lmtrace_range_tag_set(/*decode_call=*/7, /*range_idx=*/3, /*n_ranges=*/48,
+                                       /*ub_idx=*/2, /*n_ubatch=*/4,
+                                       /*il_start=*/3, /*il_end=*/4,
+                                       /*boundary_role=*/GGML_MOE_LMTRACE_BOUNDARY_ROLE_IN |
+                                                          GGML_MOE_LMTRACE_BOUNDARY_ROLE_OUT);
+        ggml_moe_lmtrace_range_segment();
+
+        lm_s0::GraphFix fx; lm_s0::build_graph(fx, 8, "s2_plain");
+        lm_s0::capture(fx);
+
+        ggml_moe_lmtrace_range_tag_clear();
+
+        rec_tagged = lm_s2::first_record(lm_s0::read_all(dir + L"\\tagged.lmt"));
+
+        // 태그 해제 뒤의 캡처는 다시 무태그여야 한다(태그가 새지 않는다).
+        lm_s0::GraphFix fx2; lm_s0::build_graph(fx2, 8, "s2_plain");
+        lm_s0::capture(fx2);
+        ggml_moe_lmtrace_range_segment();
+
+        ggml_moe_lmtrace_boundary_copy_note(6u*1024u*1024u, 1);
+        ggml_moe_lmtrace_boundary_copy_note(6u*1024u*1024u, 1);
+
+        ggml_moe_lmtrace_graph_boundary(0, 1);   // decode graph → 요청 폐합
+
+        const std::vector<uint8_t> all = lm_s0::read_all(dir + L"\\tagged.lmt");
+        const std::vector<uint8_t> r2  = lm_s2::first_record(
+            std::vector<uint8_t>(all.begin() + (long) rec_tagged.size(), all.end()));
+
+        check(!r2.empty() && lm_s0::rd_u32le(r2, lm_s2::OFF_TAG_FLAGS) == MOE_LMTRACE_TAG_FLAG_NONE,
+              "P42t2. ★range_tag_clear 후 캡처는 다시 무태그(tag_flags=0) — 태그가 다음 레코드로 새지 않는다");
+
+        const std::vector<std::string> req = lm_s0::read_lines(dir + L"\\tagged.lmtreq");
+
+        check(req.size() == 1 &&
+              lm_s2::req_field(req[0], "segments")            == "2" &&
+              lm_s2::req_field(req[0], "prefill_tokens")      == "2048" &&
+              lm_s2::req_field(req[0], "graph_records")       == "2" &&
+              lm_s2::req_field(req[0], "boundary_copy_count") == "2" &&
+              lm_s2::req_field(req[0], "boundary_copy_bytes") == "12582912",
+              "P42t3. ★§5 ⓑ 신호 정비 — prefill_enter 1회로 tokens 는 2048 **한 번만** 적산되고"
+              "(range 48개로 증폭되지 않는다), segment 는 range compute 마다 증가하며, 경계 CPY "
+              "bytes/count 가 요청 레코드로 나간다");
+    }
+
+    const bool tag_ok = !rec_tagged.empty() &&
+                        lm_s0::rd_u32le(rec_tagged, lm_s2::OFF_TAG_FLAGS) == MOE_LMTRACE_TAG_FLAG_RANGE;
+
+    check(tag_ok, "P42t4. 태그 무장 시 tag_flags=1");
+
+    if (tag_ok) {
+        const size_t T = lm_s2::OFF_TAG_BLOCK;
+
+        check(lm_s0::rd_u32le(rec_tagged, T + 0) == MOE_LMTRACE_TAG_BYTES &&
+              lm_s0::rd_u32le(rec_tagged, T + 4) == MOE_LMTRACE_TAG_VERSION,
+              "P42t5. 태그 블록 머리 = tag_bytes(48) · tag_version(1)");
+
+        check(lm_s2::rd_u64le(rec_tagged, T +  8) == 7  &&
+              lm_s0::rd_u32le(rec_tagged, T + 16) == 3  &&
+              lm_s0::rd_u32le(rec_tagged, T + 20) == 48 &&
+              lm_s0::rd_u32le(rec_tagged, T + 24) == 2  &&
+              lm_s0::rd_u32le(rec_tagged, T + 28) == 4  &&
+              lm_s2::rd_i32le(rec_tagged, T + 32) == 3  &&
+              lm_s2::rd_i32le(rec_tagged, T + 36) == 4  &&
+              lm_s0::rd_u32le(rec_tagged, T + 40) == (uint32_t) (GGML_MOE_LMTRACE_BOUNDARY_ROLE_IN |
+                                                                 GGML_MOE_LMTRACE_BOUNDARY_ROLE_OUT) &&
+              lm_s0::rd_u32le(rec_tagged, T + 44) == (uint32_t) GGML_MOE_LMTRACE_MODE_RANGE,
+              "P42t6. ★태그 왕복 — decode_call/range_idx/n_ranges/ub_idx/n_ubatch/il_start/il_end/"
+              "boundary_role/mode 가 설정값 그대로 직렬화된다(판독기 계약과 1:1)");
+
+        // ★하위 호환의 **바이트 수준** 증명: 태그 블록만큼만 커지고, 그 앞뒤는 동일하다.
+        bool head_same = rec_plain.size() + MOE_LMTRACE_TAG_BYTES == rec_tagged.size();
+        for (size_t i = 0; head_same && i < lm_s2::OFF_TAG_BLOCK; ++i) {
+            // rec_bytes(8..11)·tag_flags(20..23)·capture_seq(24..31) 은 당연히 다르다 — 제외.
+            if (i >= lm_s2::OFF_REC_BYTES && i < lm_s2::OFF_REC_BYTES + 4) continue;
+            if (i >= lm_s2::OFF_TAG_FLAGS && i < lm_s2::OFF_TAG_FLAGS + 4) continue;
+            if (i >= lm_s2::OFF_SEQ       && i < lm_s2::OFF_SEQ + 8)       continue;
+            head_same = (rec_plain[i] == rec_tagged[i]);
