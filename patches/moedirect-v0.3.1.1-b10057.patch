+// ===========================================================================
+// P48. ★5c-A1 identity·adapt 축 어서션 (그룹 태그 `P48` · A4-prime)
+//
+// 권위 = `SPEC_PREFETCH_5CA.md`(A0 FROZEN) §1-6(view)·§1-6-1(VW-10 12키 문법)·
+//        §3-2(4조합 × 7산출물 존재표)·§6-3(grant verifier 단 0~4 · PF-1~PF-8)
+//        + 계획서 `A5C_ACTUATION_EXEC_PLAN_DRAFT.md` §4-1 **어서션 부분집합 표**.
+//
+// ★이 그룹이 세우는 것 = 그 표의 A4-prime 열 **11항**:
+//   A-1 · A-2 · A-3a · A-4 · A-14 · A-16 · A-17 · A-18(음성 전건) · A-19a · A-21 · A-22.
+// ★세우지 않는 것 = 같은 표의 5c-A2 열이다. 사유는 **값 producer 가 이 트리에 없다**는
+//   것 하나다 — adapt 축은 존재만 배선됐고 grant 발급자가 없어 verifier 가 단 1 에서
+//   멈춘다. 그 열을 여기서 합성으로 세우면 이 트리가 만들 수 없는 형상을 계약으로 박제한다.
+// ★양성 grant(유효 grant 수용)도 같은 이유로 여기서 만들지 않는다 — 아래 payload 조립기는
+//   유효 grant 를 **조립할 수는 있지만 env 로 주입하지 않는다**(PF-8 대조용 preimage 뿐).
+// ★두 축의 단위가 다르다: 이 파일이 내는 것은 **런타임 축**(전량 총계·allocation 실측)이고,
+//   소스 텍스트 축(어서션 호출 발생 수·어서션 id 실재)은 `a5c/a5c_a4p_static_gate.py` 가
+//   따로 판정한다. 한쪽을 재고 다른 쪽을 추론하면 관측하지 않은 수를 보고하게 된다.
+// ===========================================================================
+
+// §1-6-1 VW-3 — 값 쌍 구분자는 1바이트 unit separator 다.
+static const char PB5CA_SEP = '\x1f';
+
+// ★검증 벡터 자리표시값(PF-8 — 부서 장부에 독립 구현(python)으로 산출한 fnv 가 박혀 있고
+//   아래 A-21·A-18 이 그 값과 대조한다). hex 자리표시라 SHA-256 산출물이 아니며, 그래서
+//   `prefetch_identity_digest` 에 이 바이트가 그대로 나오는 것이 **전달**의 증거가 된다.
+static const std::string PB5CA_SCOPE(64, 'a');        // scope_id
+static const std::string PB5CA_PAYLOAD(64, 'b');      // payload_hash
+static const std::string PB5CA_DIGEST(64, 'c');       // identity_digest — echo 공급점
+static const std::string PB5CA_ATTEMPT(32, 'd');      // grant attempt
+static const std::string PB5CA_ALT_SCOPE(64, 'e');    // 불일치 주입용
+static const std::string PB5CA_ALT_PAYLOAD(64, 'f');
+
+static std::string pb5ca_join(const std::vector<std::string> & kv) {
+    std::string s;
+    for (size_t i = 0; i < kv.size(); i++) { if (i) s += PB5CA_SEP; s += kv[i]; }
+    return s;
+}
+
+// VW-9 — preimage 의 fnv1a64 를 16자리 소문자 hex(선행 0 유지)로. 엔진과 같은 원시 알고리즘을
+//   이 파일 자신의 `pb_fnv` 로 독립 계산한다(엔진 함수를 빌려 오면 자기대조가 된다).
+static std::string pb5ca_fnv_hex(const std::string & pre) {
+    char buf[17];
+    snprintf(buf, sizeof(buf), "%016llx",
+             (unsigned long long)pb_fnv(PB_FNV_INIT, pre.data(), pre.size()));
+    return std::string(buf);
+}
+
+// PF-1 — 마지막 `fnv` 쌍을 붙여 payload 를 닫는다(preimage = 그 앞 바이트열 그대로).
+static std::string pb5ca_sealed(const std::vector<std::string> & kv) {
+    const std::string pre = pb5ca_join(kv);
+    return pre + PB5CA_SEP + "fnv=" + pb5ca_fnv_hex(pre);
+}
+
+static std::vector<std::string> pb5ca_view_pairs(const std::string & asv, const std::string & acv,
+                                                 const std::string & ascope,
+                                                 const std::string & aph) {
+    return { "v=1", "esv=1", "ecv=1.0",
+             "escope=" + PB5CA_SCOPE, "eph=" + PB5CA_PAYLOAD,
+             "asv=" + asv, "acv=" + acv, "ascope=" + ascope, "aph=" + aph,
+             "kn=6:4,6:5", "digest=" + PB5CA_DIGEST };
+}
+static std::string pb5ca_view(const std::string & asv, const std::string & acv,
+                              const std::string & ascope, const std::string & aph) {
+    return pb5ca_sealed(pb5ca_view_pairs(asv, acv, ascope, aph));
+}
+
+static std::vector<std::string> pb5ca_grant_pairs(const std::string & mode, const std::string & sv,
+                                                  const std::string & cv, const std::string & scope,
+                                                  const std::string & ph) {
+    return { "v=1", "mode=" + mode, "attempt=" + PB5CA_ATTEMPT,
+             "sv=" + sv, "cv=" + cv, "scope=" + scope, "ph=" + ph };
+}
+static std::string pb5ca_grant(const std::string & mode, const std::string & sv,
+                               const std::string & cv, const std::string & scope,
+                               const std::string & ph) {
+    return pb5ca_sealed(pb5ca_grant_pairs(mode, sv, cv, scope, ph));
+}
+
+static bool pb5ca_null_at(const json & j, const char * k) {
+    return j.is_object() && j.contains(k) && j[k].is_null();
+}
+static std::set<std::string> pb5ca_keys(const json & j) {
+    std::set<std::string> s;
+    if (j.is_object()) for (auto it = j.begin(); it != j.end(); ++it) s.insert(it.key());
+    return s;
+}
+
+// ★env 해소 + seal 1회만 행사하는 경량 프로브. 실 생산 경로(`note_seal`)를 그대로 부르고
+//   스냅샷 복사도 그 안에서 일어난다 — 픽스처를 손으로 흉내내지 않는다(V3R3 선례 형상).
+//   프리페치 env 를 주지 않으므로 pf_on=false 이고 B2 자원을 잡지 않는다.
+struct Pb5caProbe {
+    bool        view_accepted = false;
+    bool        adapt_on      = false;
+    uint64_t    alloc         = 0;
+    std::string refusal;
+};
+static Pb5caProbe pb5ca_probe(const char * view_env, const char * grant_env) {
+    ggml_moe_direct_reset_for_test();
+    ggml_moe_phaseb_reset_for_test();
+    EnvGuard gv("MOE_DIRECT_PREFETCH_BUNDLE_VIEW", view_env);
+    EnvGuard gg("MOE_DIRECT_PREFETCH_ACTIVATION_GRANT", grant_env);
+    PbInvFix F; PbInvOpt o;
+    pb_build_inventory(F, /*n_expert=*/8, PB_TEST_N_EMBD, /*n_layer_exec=*/2, /*n_expert_used=*/2, o);
+    ggml_moe_phaseb_note_family(&F.fam);
+    ggml_moe_phaseb_resolve_prefetch(/*qd_effective=*/8);
+    const int32_t  ml[2] = { 0, 1 };
+    const uint64_t sb[2] = { 4096, 4096 };
+    ggml_moe_phaseb_note_seal(/*n_expert=*/8, /*n_expert_used=*/2, /*n_moe_layers=*/2,
+                              /*n_slots=*/8, /*qd_effective=*/8, ml, sb,
+                              /*n_layer_exec=*/2, PB_TEST_N_EMBD, 1e-6f);
+    Pb5caProbe p;
+    p.view_accepted = ggml_moe_phaseb_bundle_view_accepted();
+    p.adapt_on      = ggml_moe_phaseb_adapt_on();
+    p.alloc         = ggml_moe_phaseb_controller_alloc_count();
+    p.refusal       = ggml_moe_phaseb_activation_grant_refusal();
+    ggml_moe_phaseb_reset_for_test();
+    ggml_moe_direct_reset_for_test();
+    return p;
+}
+
+// ★wire arm — P44 의 5c-T arm 과 **같은 시나리오**(pb5ct_scenario)를 돌리고 identity 축 env 만
+//   바꾼다. 그래야 A-17(회귀 앵커)의 두 arm 이 시나리오 축에서 동일 operand 가 된다.
+struct Pb5caArm {
+    Pb5ctBase         base;
+    json              hdr, sum, run;
+    std::vector<json> runs;
+    bool              sealed = false, settled = false;
+    bool              view_accepted = false, adapt_on = false;
+    uint64_t          alloc = 0, ledger_recs = 0;
+    bool              ledger_file = false;
+    std::string       refusal;
+};
+static Pb5caArm pb5ca_arm(const char * tag, const char * fx_tag, const char * collect,
+                          const char * view_env, const char * grant_env) {
+    Pb5caArm a;
+    const std::wstring md = make_case_dir(tag);
+    PbCollectEnv ce(collect);
+    EnvGuard gv("MOE_DIRECT_PREFETCH_BUNDLE_VIEW", view_env);
+    EnvGuard gg("MOE_DIRECT_PREFETCH_ACTIVATION_GRANT", grant_env);
+    PbEnv env("4", "8", "2", "trace", wide_to_utf8(md + L"\\pb").c_str(),
+              wide_to_utf8(md + L"\\m.jsonl").c_str());
+    Fixture fx; pb_setup_2layer(fx, fx_tag);
+    a.sealed = (fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0);
+    if (!a.sealed) return a;
+    a.settled       = pb5ct_scenario(fx, /*promote=*/true);
+    ggml_moe_direct_finalize();
+    a.base          = pb5ct_capture();
+    a.view_accepted = ggml_moe_phaseb_bundle_view_accepted();
+    a.adapt_on      = ggml_moe_phaseb_adapt_on();
+    a.alloc         = ggml_moe_phaseb_controller_alloc_count();
+    a.refusal       = ggml_moe_phaseb_activation_grant_refusal();
+    a.ledger_recs   = ggml_moe_phaseb_ledger_records();
+    a.ledger_file   = std::ifstream(md + L"\\pb_ledger.pb", std::ios::binary).good();
+    a.hdr           = pb_read_metrics_line(md + L"\\m.jsonl", "header");
+    a.sum           = pb_read_metrics_line(md + L"\\m.jsonl", "summary");
+    a.run           = pb5ct_first_run_record(md + L"\\m.jsonl");
+    a.runs          = pb_hint_read_records(md + L"\\m.jsonl", "phase_b_run");
+    return a;
+}
+
+static void test_pb_5ca_a4p() {
+    section("P48. ★5c-A1 identity·adapt 축(SPEC_PREFETCH_5CA §1-6·§1-6-1·§3-2·§6-3) — "
+            "A4-prime 11항: 기본 state 0 · view/grant verifier 음성 · 4조합 존재표 adapt OFF 2행 · "
+            "digest echo 는 계산이 아니라 전달");
+
+    // ── 공용 payload. 유효 view 1 + 4필드 불일치 4 + grant 음성 3(양성 grant 는 만들지 않는다) ──
+    const std::string v_ok      = pb5ca_view("1", "1.0", PB5CA_SCOPE, PB5CA_PAYLOAD);
+    const std::string v_asv     = pb5ca_view("2", "1.0", PB5CA_SCOPE, PB5CA_PAYLOAD);
+    const std::string v_acv     = pb5ca_view("1", "1.1", PB5CA_SCOPE, PB5CA_PAYLOAD);
+    const std::string v_ascope  = pb5ca_view("1", "1.0", PB5CA_ALT_SCOPE, PB5CA_PAYLOAD);
+    const std::string v_aph     = pb5ca_view("1", "1.0", PB5CA_SCOPE, PB5CA_ALT_PAYLOAD);
+    const std::string g_named   = pb5ca_grant("verification", "1", "1.0",
+                                              PB5CA_SCOPE, PB5CA_PAYLOAD);   // 단 3 — mode 명명
+    const std::string g_wrongid = pb5ca_grant("product", "1", "1.0",
+                                              PB5CA_ALT_SCOPE, PB5CA_PAYLOAD); // 단 4 — scope 불일치
+    const std::string g_short   = "v=1";                                       // 단 1 — 8키 결손
+
+    // ── wire arm 5(전건 adapt OFF — 5c-A1 에는 grant 발급자가 없다) ──
+    const Pb5caArm a_off    = pb5ca_arm("pb5ca_off",    "pb5ca_off_fx",    nullptr,
+                                        nullptr,      nullptr);
+    const Pb5caArm a_noview = pb5ca_arm("pb5ca_noview", "pb5ca_noview_fx", "on",
+                                        nullptr,      nullptr);
+    const Pb5caArm a_on     = pb5ca_arm("pb5ca_on",     "pb5ca_on_fx",     "on",
+                                        v_ok.c_str(), nullptr);
+    const Pb5caArm a_bad    = pb5ca_arm("pb5ca_bad",    "pb5ca_bad_fx",    "on",
+                                        v_asv.c_str(), nullptr);
+    const Pb5caArm a_named  = pb5ca_arm("pb5ca_named",  "pb5ca_named_fx",  "on",
+                                        v_ok.c_str(), g_named.c_str());
+
+    // ── A-1. adapt OFF 기본 state 0 ──────────────────────────────────────────────────────
+    const Pb5caProbe p_bare = pb5ca_probe(nullptr, nullptr);
+    const bool a1_arms = !a_off.adapt_on    && a_off.alloc    == 0 &&
+                         !a_noview.adapt_on && a_noview.alloc == 0 &&
+                         !a_on.adapt_on     && a_on.alloc     == 0 &&
+                         !a_bad.adapt_on    && a_bad.alloc    == 0 &&
+                         !a_named.adapt_on  && a_named.alloc  == 0;
+    check(a_off.sealed && a_noview.sealed && a_on.sealed && a_bad.sealed && a_named.sealed &&
+          !p_bare.adapt_on && !p_bare.view_accepted && p_bare.alloc == 0 && a1_arms,
+          "A-1. ★adapt OFF 기본 state 0 — 축이 배선된 뒤에도 기본값에서 adapt 실효값이 false 이고 "
+          "controller allocation 계수가 0 이다(seal 1회 해소 뒤 관측 · 5c-A1 의 5 arm 전건). "
+          "5c-A1 은 정확히 이 상태이며 원인은 발급자 부재다 [bare alloc=" +
+          std::to_string((unsigned long long)p_bare.alloc) + " · on alloc=" +
+          std::to_string((unsigned long long)a_on.alloc) + "]");
+
+    // ── A-2. view expected != actual 4필드 각각 → V-3 거부 · digest null · allocation 0 ───
+    bool a2_fields = true;
+    std::string a2_trace;
+    const std::string * v4[4] = { &v_asv, &v_acv, &v_ascope, &v_aph };
+    static const char * kV4Name[4] = { "asv", "acv", "ascope", "aph" };
+    for (int i = 0; i < 4; i++) {
