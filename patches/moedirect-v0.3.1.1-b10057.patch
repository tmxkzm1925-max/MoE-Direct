+// P27 공용 — 인벤토리 판정 결과를 관측하고 "신호 전면 비활성"을 전건 확인한다.
+//   ★arm 은 **실 텐서 인벤토리**를 만들어 생산 경로를 그대로 행사한다(합성 count 주입 없음).
+struct PbAdObs {
+    int rc = -1;
+    std::string reason, off_reason;
+    uint64_t cap = 0, iq = 0, pw = 0, snap = 0;
+    int32_t depth = 0, worker = 0, adapter = -1, width = -1;
+    bool pf_on = false;
+};
+static PbAdObs pb_ad_seal_observe(Fixture & fx) {
+    PbAdObs r;
+    r.rc = fx.seal((uint64_t)fx.model.n_expert * fx.comp.slot_stride_max, 64);
+    r.reason     = ggml_moe_phaseb_adapter_reason();
+    r.off_reason = ggml_moe_phaseb_prefetch_off_reason();
+    r.adapter    = ggml_moe_phaseb_adapter_id();
+    r.width      = ggml_moe_phaseb_capture_width();
+    r.pf_on      = ggml_moe_phaseb_prefetch_on();
+    uint64_t cq = 0, pend = 0, chan = 0, dstk = 0;
+    ggml_moe_direct_test_mem_echo(&cq, &pend, &chan, &dstk, &r.cap, &r.iq, &r.pw, &r.snap);
+    uint64_t a = 0, b = 0, c = 0, d = 0;
+    ggml_moe_phaseb_test_counts(&a, &b, &c, &d, &r.depth, &r.worker);
+    return r;
+}
