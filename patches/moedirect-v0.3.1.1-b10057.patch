+        PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+        Fixture fx;
+        pb_setup_2layer(fx, "xstore_budget_ok");
+        const int rc = fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64);
+        int32_t worker_running = 0;
+        ggml_moe_phaseb_test_counts(nullptr, nullptr, nullptr, nullptr, nullptr, &worker_running);
+        const int32_t budget = 4000;
+        const int64_t t0  = xstore_now_ms();
+        const int     db  = (rc == 0) ? ggml_moe_store_drain_begin() : -1;
+        const int     fin = (db == 0) ? ggml_moe_store_drain_finish(budget) : -1;
+        const int64_t total = xstore_now_ms() - t0;
+
+        int64_t pdl[2]   = { -1, -1 };
+        int32_t pleft[2] = { -1, -1 };
+        const int pn = ggml_moe_phaseb_test_drain_stages(pdl, pleft, 2);
+        int64_t ddl   = -1;
+        int32_t dleft = -1;
+        const int dn = ggml_moe_direct_test_stop_join_stage(&ddl, &dleft);
+        const long long rel0 = (pn > 0) ? (long long)(pdl[0] - t0) : -1;
+        const long long rel1 = (pn > 1) ? (long long)(pdl[1] - t0) : -1;
+        const long long rel2 = (dn > 0) ? (long long)(ddl    - t0) : -1;
+
+        check(rc == 0 && worker_running == 1 && db == 0 && fin == 0 && pn == 2 && dn == 1,
+              "XSTORE47. the stop chain is WALKED, not assumed: with the predictor worker and "
+              "the dispatcher both running, drain_finish enters all three budget-spending "
+              "stages - the capture-idle wait, the predictor worker join, the dispatcher join "
+              "- and completes in order. Every check above this one left that chain untouched "
+              "[worker=" + std::to_string(worker_running) + " begin=" + std::to_string(db) +
+              " finish=" + std::to_string(fin) + " predictor_stages=" + std::to_string(pn) +
+              " join_stages=" + std::to_string(dn) + " total_ms=" + std::to_string(total) + "]");
+        // t0 was read HERE, before the anchor was taken, and 4000 is this case's own constant:
+        // the instant being compared against is derived by the caller, not echoed back. Three
+        // stages naming one instant IS the single-budget claim; a budget re-derived per stage
+        // names three instants, each later than the one before it.
+        const bool one_deadline = (pn == 2 && dn == 1) && (pdl[0] == pdl[1]) && (pdl[1] == ddl);
+        const bool anchored     = (rel2 >= (long long)budget) &&
+                                  (rel2 <= (long long)budget + 250);
+        check(one_deadline && anchored,
+              "XSTORE48. and all three of them measured against the SAME instant, the one the "
+              "drain_begin anchor fixes: the deadlines are identical to each other and land on "
+              "the caller's own t0 + 4000. Re-deriving the budget at each stage would put them "
+              "further and further apart [rel0=" + std::to_string(rel0) + " rel1=" +
+              std::to_string(rel1) + " rel2=" + std::to_string(rel2) + " identical=" +
+              std::to_string((int)one_deadline) + " anchored=" +
+              std::to_string((int)anchored) + "]");
+    }
+    {
+        // Arm 1, isolated: the worker stays parked, so the capture-idle wait spends the whole
+        // budget and the worker join gets what is left - nothing. One budget is about 700 ms
+        // end to end with the join handed 0; a budget per stage is about 1400 with the join
+        // handed a fresh 700, and that is the state every check above this one called green.
+        DWORD ec = 0;
+        std::string cap;
+        const bool ran = xstore_run_child("predictor", &ec, &cap, "--xstore-budget-test");
+        const long long total = xstore_scrape_int(cap, "xsb_total=", -1);
+        const long long rc    = xstore_scrape_int(cap, "xsb_rc=", 99);
+        const long long pn    = xstore_scrape_int(cap, "xsb_pn=", -1);
+        const long long dn    = xstore_scrape_int(cap, "xsb_dn=", -1);
+        const long long safe  = xstore_scrape_int(cap, "xsb_safety=", -1);
+        const long long rel0  = xstore_scrape_int(cap, "xsb_rel0=", -1);
+        const long long rel1  = xstore_scrape_int(cap, "xsb_rel1=", -1);
+        const long long left1 = xstore_scrape_int(cap, "xsb_left1=", -1);
+        const bool spent_once = (total >= 580 && total <= 1000);
+        const bool one_budget = (rel0 == rel1) && (rel1 >= 700 && rel1 <= 950) && (left1 == 0);
+        check(ran && ec == 0 && rc == -1 && pn == 2 && dn == 0 && safe == 0 &&
+              spent_once && one_budget,
+              "XSTORE49. a stop whose PREDICTOR stages both block spends ONE budget across "
+              "them: with the worker parked in its real busy window, 700 ms of budget covers "
+              "the capture-idle wait AND the join that follows it, which is handed 0 rather "
+              "than a second 700. Two independent readings say so - the child's own wall clock "
+              "(~700 ms, not ~1400) and the deadline each stage measured against, which is the "
+              "same instant for both [exit=" + std::to_string((unsigned long)ec) + " rc=" +
+              std::to_string(rc) + " total_ms=" + std::to_string(total) + " stages=" +
+              std::to_string(pn) + "/" + std::to_string(dn) + " rel0=" + std::to_string(rel0) +
+              " rel1=" + std::to_string(rel1) + " left1=" + std::to_string(left1) +
+              " safety=" + std::to_string(safe) + "]");
+    }
+    {
+        // Arm 2, isolated: the worker is freed 700 ms in, so the predictor drain SUCCEEDS
+        // having spent that much, and the dispatcher join - parked in the stop-race window -
+        // runs on the 500 ms remainder. One budget is about 1200 ms end to end; a budget per
+        // stage hands that join a fresh 1200 and lands near 1900.
+        DWORD ec = 0;
+        std::string cap;
+        const bool ran = xstore_run_child("dispatcher", &ec, &cap, "--xstore-budget-test");
+        const long long total = xstore_scrape_int(cap, "xsb_total=", -1);
+        const long long rc    = xstore_scrape_int(cap, "xsb_rc=", 99);
+        const long long pn    = xstore_scrape_int(cap, "xsb_pn=", -1);
+        const long long dn    = xstore_scrape_int(cap, "xsb_dn=", -1);
+        const long long safe  = xstore_scrape_int(cap, "xsb_safety=", -1);
+        const long long rel0  = xstore_scrape_int(cap, "xsb_rel0=", -1);
+        const long long rel2  = xstore_scrape_int(cap, "xsb_rel2=", -1);
+        const long long left2 = xstore_scrape_int(cap, "xsb_left2=", -1);
+        const bool spent_once = (total >= 1050 && total <= 1500);
+        const bool one_budget = (rel0 == rel2) && (rel2 >= 1200 && rel2 <= 1450) &&
+                                (left2 > 100 && left2 < 700);
+        check(ran && ec == 0 && rc == -1 && pn == 2 && dn == 1 && safe == 0 &&
+              spent_once && one_budget,
+              "XSTORE50. and the handoff from the predictor drain into the dispatcher join "
+              "spends the SAME budget: after the predictor stages used 700 ms of 1200, the "
+              "join is handed the remainder rather than a fresh 1200, so the whole stop lands "
+              "near 1200 ms instead of near 1900. The join's deadline is the same instant the "
+              "predictor's first stage named, measured against the child's own t0 [exit=" +
+              std::to_string((unsigned long)ec) + " rc=" + std::to_string(rc) + " total_ms=" +
+              std::to_string(total) + " stages=" + std::to_string(pn) + "/" +
+              std::to_string(dn) + " rel0=" + std::to_string(rel0) + " rel2=" +
+              std::to_string(rel2) + " join_left=" + std::to_string(left2) + " safety=" +
+              std::to_string(safe) + "]");
+    }
+}
