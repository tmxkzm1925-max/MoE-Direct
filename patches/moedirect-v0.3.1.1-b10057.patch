+static int run_veh_death_child() {
+    // 큰 host 텐서 하나(내부 페이지 다수) seal → 보호 페이지를 touch_abort 이상 터치 → kill(113)
+    init_scratch_root();
+    Fixture * fx = new Fixture(); // 죽으므로 해제 불요
+    fx->dir = make_case_dir("veh_death");
+    fx->model.n_expert = 8; fx->model.n_expert_used = 2; fx->model.n_layer = 1;
+    fx->model.sources = { default_source() };
+    SynthLayer L; L.layer = 0;
+    SynthPart w; w.name = "gate.weight"; w.source_tensor = "blk.0.ffn_gate_exps.weight"; w.source_index = 0; w.type = "Q6_K"; w.dims = { 256, 16, 8 }; w.is_host = true; // slice 3360*... 큰 텐서
+    L.parts = { w };
+    fx->model.layers = { L };
+    fx->comp = compute_layout(fx->model, 4096);
+    fx->build();
+    int rc = fx->seal((uint64_t)8 * fx->comp.slot_stride_max, /*touch_abort=*/4);
+    if (rc != 0) { fprintf(stderr, "veh-death-child: seal 실패\n"); return 77; }
+    // 보호 텐서 backing 의 내부 4K 페이지들을 순차 터치 → 4번째 unique 페이지에서 kill 기대
+    ggml_tensor * t = fx->find("blk.0.ffn_gate_exps.weight");
+    uintptr_t start = (uintptr_t)t->data;
+    uintptr_t astart = (start + 4095) & ~(uintptr_t)4095;
+    for (int pg = 0; pg < 32; pg++) {
+        volatile unsigned char v = *(volatile unsigned char *)(astart + (uintptr_t)pg * 4096);
+        (void)v;
+    }
+    fprintf(stderr, "veh-death-child: 32페이지 터치 후에도 생존 — kill 미작동(FAIL)\n");
+    return 66;
+}
+static void test_veh_death() {
+    section("G. VEH kill 경로 death-test(자식 프로세스, touch_abort 도달 → exit 113)");
+    wchar_t exe[MAX_PATH]; DWORD n = GetModuleFileNameW(nullptr, exe, MAX_PATH);
+    if (!check(n > 0 && n < MAX_PATH, "G1. exe 경로 조회")) return;
+    std::wstring cmd = L"\"" + std::wstring(exe) + L"\" --veh-death-test";
+    std::vector<wchar_t> cb(cmd.begin(), cmd.end()); cb.push_back(L'\0');
+    STARTUPINFOW si; ZeroMemory(&si, sizeof(si)); si.cb = sizeof(si);
+    PROCESS_INFORMATION pi; ZeroMemory(&pi, sizeof(pi));
+    BOOL ok = CreateProcessW(exe, cb.data(), nullptr, nullptr, FALSE, 0, nullptr, nullptr, &si, &pi);
+    if (!check(ok, "G2. 자식 프로세스 기동")) return;
+    WaitForSingleObject(pi.hProcess, INFINITE);
+    DWORD ec = 0xFFFFFFFF; GetExitCodeProcess(pi.hProcess, &ec);
+    CloseHandle(pi.hProcess); CloseHandle(pi.hThread);
+    printf("    (참고) veh-death 자식 exit code = %lu (기대 %d)\n", (unsigned long)ec, MOE_DIRECT_VEH_KILL_EXIT_CODE);
+    check(ec == (DWORD)MOE_DIRECT_VEH_KILL_EXIT_CODE, "G3. ★자식이 touch_abort 도달로 exit 113(VEH kill 경로)");
+}
