+            int arc2 = ggml_moe_direct_acquire(g1, &one, 1, 1);
+            check(arc2 == 0 && verify_ptr_bytes(fx, "blk.1.ffn_gate_exps.weight", 1, 0, 0),
+                  "M5c. 실패 배치 이후에도 가용 슬롯 1개 정상 사용(적재 성공)");
+            ggml_moe_direct_release(g1, &one, 1);
+            ggml_moe_direct_release(g0, pin.data(), 7);
+        }
+    }
+
+    // ── M6. n_unique_miss > QD sliding pump(QD=2 강제) — 전량 로드 완료.
+    {
+        set_env("MOE_DIRECT_QD", "2");
+        Fixture fx; qd_setup_2layer(fx, "qd_pump2");
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        clear_env("MOE_DIRECT_QD");
+        if (check(rc == 0, "M6a. seal 성공(MOE_DIRECT_QD=2)")) {
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            std::vector<int32_t> ids = {0,1,2,3,4,5,6,7}; // 유니크 miss 8 > QD 2
+            const uint64_t r0 = qd_reads_total();
+            int arc = ggml_moe_direct_acquire(g0, ids.data(), 8, 8);
+            const uint64_t dr = qd_reads_total() - r0;
+            bool ok = (arc == 0) && (dr == 8);
+            for (int32_t e = 0; e < 8; e++) ok = ok && verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, e);
+            int32_t leased = -1; int64_t total = -1; ggml_moe_direct_test_lease_stats(&leased, &total);
+            ok = ok && leased == 8 && total == 8;
+            check(ok, "M6b. ★n_unique_miss(8) > QD(2) sliding pump — 전량 적재·데이터 정합(reads=" +
+                      std::to_string(dr) + " leased=" + std::to_string(leased) + ")");
+            ggml_moe_direct_release(g0, ids.data(), 8);
+        }
+    }
+
+    // ── M7. ERROR_IO_PENDING 실발생 ≥2건(QD=8 · 대형 레코드 · FILE_FLAG_NO_BUFFERING).
+    //    ★동결 사양 D-5가 "적어도 두 operation이 실제 ERROR_IO_PENDING"을 요구하므로 대체-PASS
+    //    경로 없이 dpend >= 2를 정식 판정으로 둔다(미충족 = FAIL로 드러나야 한다 — 비동기 경로가
+    //    실제로 pending을 타지 않으면 QD 레버의 전제 자체가 무너지기 때문).
+    {
+        set_env("MOE_DIRECT_QD", "8");
+        Fixture fx; fx.dir = make_case_dir("qd_pending");
+        fx.model.arch = "synth"; fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 1;
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_fused_layer(0, 8, "Q6_K", 256) }; // 레코드 ≈108KB
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        clear_env("MOE_DIRECT_QD");
+        if (check(rc == 0, "M7a. seal 성공(MOE_DIRECT_QD=8 · stride=" + std::to_string(fx.comp.slot_stride_max) + "B)")) {
+            ggml_tensor * gu = fx.find("blk.0.ffn_gate_up_exps.weight");
+            uint64_t i0 = 0, p0 = 0; ggml_moe_direct_test_read_stats(&i0, &p0);
+            std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+            int arc = ggml_moe_direct_acquire(gu, ids.data(), 8, 8);
+            uint64_t i1 = 0, p1 = 0; ggml_moe_direct_test_read_stats(&i1, &p1);
+            const uint64_t dimm = i1 - i0, dpend = p1 - p0;
+            printf("    (참고) 이 배치의 완료 분기: immediate=%llu pending=%llu\n",
+                   (unsigned long long)dimm, (unsigned long long)dpend);
+            fflush(stdout);
+            bool ok = (arc == 0) && (dimm + dpend == 8);
+            for (int32_t e = 0; e < 8; e++) ok = ok && verify_ptr_bytes(fx, "blk.0.ffn_gate_up_exps.weight", 0, 0, e);
+            check(ok, "M7b. 대형 레코드 8건 동시 제출(QD=8) — 완료 분기 카운터 합 == 미스 수 8 · 전건 데이터 정합");
+            check(dpend >= 2, "M7c. ★ERROR_IO_PENDING 실발생 >= 2건(동결 사양 D-5) — pending=" +
+                              std::to_string(dpend) + " immediate=" + std::to_string(dimm));
+            ggml_moe_direct_release(gu, ids.data(), 8);
+        }
+    }
+
+    // ── M8. ★QD=1 ↔ QD=8 동등성 — 동일 요청 시퀀스 후 최종 상태가 동일해야 한다(claim 전량이
+    //    submit보다 앞서고 LRU tick이 논리 요청 순서로 예약되므로 slot 배정·LRU가 QD 값과 완료
+    //    순서에 무관하다). ★비교 대상 = record→slot 매핑 16건 + record slot_generation +
+    //    슬롯별 owner/last_used/generation/lease 전량 + hit/miss 카운터 + read bytes/횟수.
+    //    (상주 여부만 비교하면 LRU tick 순서 결함이 그대로 통과한다 — M3c/M3d와 세트로 방어.)
+    {
+        QdRunState a = qd_run_sequence("qd_eq_qd1", "1");
+        QdRunState b = qd_run_sequence("qd_eq_qd8", "8");
+        bool same = a.ok && b.ok && a.bytes_ok && b.bytes_ok &&
+                    (a.snap == b.snap) && a.reads_total == b.reads_total;
+        for (int p = 0; p < 2; p++)
+            same = same && a.rb[p] == b.rb[p] && a.hit[p] == b.hit[p] && a.miss[p] == b.miss[p];
+        auto dump = [](const char * tag, const QdRunState & s) {
+            printf("    (참고) %s reads=%llu decode(h/m)=%llu/%llu prefill(h/m)=%llu/%llu rb=%llu/%llu\n",
+                   tag, (unsigned long long)s.reads_total, (unsigned long long)s.hit[0], (unsigned long long)s.miss[0],
+                   (unsigned long long)s.hit[1], (unsigned long long)s.miss[1],
+                   (unsigned long long)s.rb[0], (unsigned long long)s.rb[1]);
+            printf("    (참고) %s rec->slot =", tag);
+            for (size_t i = 0; i < s.snap.rec_slot.size(); i++) printf(" %d", s.snap.rec_slot[i]);
+            printf("\n    (참고) %s slot last_used =", tag);
+            for (size_t i = 0; i < s.snap.slot_last_used.size(); i++) printf(" %llu", (unsigned long long)s.snap.slot_last_used[i]);
+            printf("\n");
+        };
+        dump("QD1", a); dump("QD8", b);
+        fflush(stdout);
+        check(same, "M8. ★QD=1 ↔ QD=8 동일 시퀀스 최종 상태 동등(record→slot 매핑·slot generation·"
+                    "슬롯 LRU(last_used)/lease·hit/miss·read bytes/횟수 전량)");
+    }
+}
