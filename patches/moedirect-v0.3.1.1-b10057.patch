+            //   동기화됐으며, 아직 다음 decode batch 에 들어가지 않았다.
+            //   ★PA identity 는 `phase=decode ∧ n_tokens=1 ∧ n_outputs=1` graph 종료 시에만
+            //     갱신되므로 prompt/prefill sampling 에서는 valid=0 이라 발화하지 않는다.
+            //   ★같은 decode graph 로 여러 슬롯이 샘플링해도 graph 당 1회만 돈다.
+            //     (관측 런 형상은 SPEC §4 ⓓ 가 `-np 1` 로 못박는다 — 다중 슬롯은 스코프 밖)
+            //   ★섀도 오류는 사이드카를 incomplete 로 latch 할 뿐 메인 토큰 송신·회계를
+            //     멈추지 않는다(반환값을 흘려보내는 것이 계약이다).
+            if (ggml_moe_shadow_enabled()) {
+                struct ggml_moe_phasea_ident sh_id;
+                ggml_moe_phasea_identity(&sh_id);
+                static uint32_t s_shadow_last_gs = 0xFFFFFFFFu;
+                if (sh_id.valid && sh_id.graph_seq != s_shadow_last_gs) {
+                    s_shadow_last_gs = sh_id.graph_seq;
+                    llama_shadow_draft_run_private(slot.ctx_tgt, slot.id, id,
+                                                   sh_id.request_index, sh_id.graph_seq,
+                                                   sh_id.decode_ordinal);
+                }
+            }
+
             // here we have synchronized the llama_context (due to the sampling above), so we can do time measurement
             const int64_t t_now = ggml_time_us();
 
