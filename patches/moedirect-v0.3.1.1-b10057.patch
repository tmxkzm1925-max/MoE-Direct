+                    off != part.data_offset || nb != part.slice_bytes) {
+                    if (addr_ok) addr_first_bad = " 첫 불일치 flat=" + std::to_string(flat) + " " + part.source_tensor +
+                                                  " off=" + std::to_string(off) + "/" + std::to_string(part.data_offset) +
+                                                  " bytes=" + std::to_string(nb) + "/" + std::to_string(part.slice_bytes);
+                    addr_ok = false;
+                }
+                flat++;
+            }
+        }
+        check(addr_ok && np == flat,
+              "V3d4. ★주소 계약 전항 = (data_offset, slice_bytes) — " + std::to_string(flat) +
+              " part 전건 일치(bin 좌표 part_offset/part_bytes 아님)" + addr_first_bad);
+
+        // ④ registry/attestation(§3-7 승계) — 픽스처는 전 part 가 host 다.
+        int32_t want_parts = 0, want_host = 0;
+        for (auto & L : fx.model.layers)
+            for (auto & part : L.parts) { want_parts++; if (part.is_host) want_host++; }
+        check(am == want_parts && ah == want_host && npi == want_host,
+              "V3d5. registry·attestation·보호 구간 = managed " + std::to_string(am) + "/" +
+              std::to_string(want_parts) + " · host " + std::to_string(ah) + "/" + std::to_string(want_host) +
+              " · prot_intervals " + std::to_string(npi));
+
+        // ⑤ seal 이 성립한 뒤에는 보호가 **걸려 있어야** 한다(직독 tripwire 의 상태).
+        //    A2 시점엔 경계가 여기라 "원복"이 계약이었고, A3 가 경계를 앞으로 밀면서 성공 경로의
+        //    계약은 "유지"로 바뀐다 — 반납 총체성 쪽은 아래 V3d6b 가 늦은 실패로 따로 잠근다.
+        bool prot_held = true; std::string prot_bad;
+        for (auto & L : fx.model.layers) {
+            for (auto & part : L.parts) {
+                ggml_tensor * t = fx.find(part.source_tensor);
+                if (!t || !t->data) continue;
+                MEMORY_BASIC_INFORMATION mbi{};
+                if (VirtualQuery(t->data, &mbi, sizeof(mbi)) == 0 || mbi.Protect != PAGE_NOACCESS) {
+                    if (prot_held) prot_bad = " 첫 미보호 " + part.source_tensor + " protect=0x" +
+                                              [&]{ char b[16]; snprintf(b, sizeof(b), "%lx", (unsigned long)mbi.Protect); return std::string(b); }();
+                    prot_held = false;
+                }
+            }
+        }
+        check(prot_held,
+              "V3d6. seal 성립 후 등록 텐서 보호 유지(PAGE_NOACCESS — 직독 tripwire 가 선 상태)" + prot_bad);
+
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ★V3d6b 반납 총체성(늦은 실패) — 자원 확보 **이후**에 seal 이 실패하면 잡은 것을
+    //      전량 되돌리는가. A2 에선 경계가 그 자리라 자동으로 증명됐지만, A3 가 경계를 앞으로
+    //      밀면서 이 경로는 실환경에서 CreateEvent/VEH 등록 실패로만 도달한다(재현 불가).
+    //      그래서 one-shot 주입으로 결정론적으로 친다 — 규율이 조용히 썩는 것을 막는 잠금이다. ----
+    {
+        V3Fixture fx;
+        fx.dir   = make_case_dir("v3_a3_late_fail");
+        fx.model = default_v3_model(/*n_shards=*/2);
+        std::string why;
+        if (check(fx.build(why), "V3d6a. 늦은 실패 픽스처 생성 [" + why + "]")) {
+            std::vector<int32_t> ml;
+            ggml_moe_direct_model md = fx.model_desc(ml);
+            std::vector<ggml_moe_direct_source> sd = fx.source_descs();
+            const std::string dir_utf8 = wide_to_utf8(fx.dir);
+            DWORD hc_before = 0; GetProcessHandleCount(GetCurrentProcess(), &hc_before);
+            ggml_moe_direct_test_v3_arm(/*reverse=*/-1, /*fail_child=*/-2, /*fail_after_acquire=*/1);
+            const int rc = ggml_moe_direct_seal_for_test(dir_utf8.c_str(), &md, sd.data(), (int32_t)sd.size(),
+                                                         fx.budget(), 64, fx.expects_u8.c_str(),
+                                                         fx.ref_profile_id.c_str(), fx.ref_expect_sha256.c_str(), nullptr);
+            const int32_t stage = ggml_moe_direct_test_v3_stage();
+            DWORD hc_after = 0; GetProcessHandleCount(GetCurrentProcess(), &hc_after);
+            bool prot_restored = true; std::string prot_bad;
+            for (auto & L : fx.model.layers) {
+                for (auto & part : L.parts) {
+                    ggml_tensor * t = fx.find(part.source_tensor);
+                    if (!t || !t->data) continue;
+                    MEMORY_BASIC_INFORMATION mbi{};
+                    if (VirtualQuery(t->data, &mbi, sizeof(mbi)) == 0 || mbi.Protect != PAGE_READWRITE) {
+                        if (prot_restored) prot_bad = " 첫 잔여 " + part.source_tensor + " protect=0x" +
+                                                      [&]{ char b[16]; snprintf(b, sizeof(b), "%lx", (unsigned long)mbi.Protect); return std::string(b); }();
+                        prot_restored = false;
+                    }
+                }
+            }
+            check(rc != 0 && stage == 11 && prot_restored && hc_after <= hc_before + 1,
+                  "V3d6b. ★자원 확보 후 실패 = 전량 반납 — 보호 PAGE_READWRITE 원복 · 핸들 " +
+                  std::to_string((unsigned long)hc_before) + " -> " + std::to_string((unsigned long)hc_after) +
+                  " [rc=" + std::to_string(rc) + " stage=" + std::to_string(stage) + "/11]" + prot_bad);
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ★핸들 누수 0 — 같은 seal 시도를 반복해도 프로세스 핸들 수가 자라지 않는다.
+    //      A3 경계가 매번 N개 핸들을 잡았다 놓으므로, 놓지 않으면 이 검사가 선형으로 자란다. ----
+    {
+        auto handle_count = []() -> uint32_t {
+            DWORD n = 0;
+            return GetProcessHandleCount(GetCurrentProcess(), &n) ? (uint32_t)n : 0u;
+        };
+        // 계수 자체가 안정될 때까지 1회 워밍(첫 시도는 CRT/픽스처 부수 핸들을 만든다).
+        { V3Run w = run_v3_seal("v3_a2_leak_warm", 2, nullptr); (void)w; ggml_moe_direct_reset_for_test(); }
+        const uint32_t before = handle_count();
+        int32_t reached = 0;
+        for (int i = 0; i < 4; i++) {
+            V3Run r = run_v3_seal("v3_a2_leak_" + std::to_string(i), 2, nullptr);
+            if (r.stage == 12) reached++;   // ★A3 부터는 seal 이 성립한다 — 반납은 reset 이 한다
+            ggml_moe_direct_reset_for_test();
+        }
+        const uint32_t after = handle_count();
+        // 4회 × (2 shard + dispatcher 이벤트·채널)이 새면 즉시 드러난다. 여유 2는 부수 변동폭.
+        check(reached == 4 && after <= before + 2,
+              "V3d7. ★핸들 누수 0 — seal 성립·해제 4회 반복(각 2 shard, stage=12 " + std::to_string(reached) +
+              "/4) 전후 프로세스 핸들 " + std::to_string(before) + " -> " + std::to_string(after));
+    }
+
+    // ---- 네거티브: 슬롯 용량 불변식(§4-7) — 예산이 1 모자라면 핸들 확보 뒤(stage 9) 거부 ----
+    {
+        V3Fixture fx;
+        fx.dir   = make_case_dir("v3_a2_budget_short");
+        fx.model = default_v3_model(/*n_shards=*/1);
+        std::string why;
+        if (check(fx.build(why), "V3d8a. 예산 부족 픽스처 생성 [" + why + "]")) {
+            std::vector<int32_t> ml;
+            ggml_moe_direct_model md = fx.model_desc(ml);
+            std::vector<ggml_moe_direct_source> sd = fx.source_descs();
+            const std::string dir_utf8 = wide_to_utf8(fx.dir);
+            const int rc = ggml_moe_direct_seal_for_test(dir_utf8.c_str(), &md, sd.data(), (int32_t)sd.size(),
+                                                         fx.budget() - 1, 64, fx.expects_u8.c_str(),
+                                                         fx.ref_profile_id.c_str(), fx.ref_expect_sha256.c_str(), nullptr);
+            const int32_t stage = ggml_moe_direct_test_v3_stage();
+            // stage 9 = 핸들까지는 섰고 슬롯 풀 관문에서 멈췄다는 뜻. 스냅샷은 A2 미완주라 없다.
+            check(rc != 0 && stage == 9 && ggml_moe_direct_test_v3_probe(nullptr, nullptr, nullptr, nullptr,
+                                                                        nullptr, nullptr, nullptr, nullptr, nullptr) != 0,
+                  "V3d8. ★n_slots < n_expert(예산 1 부족) = 기동 중단 · 핸들 관문 통과 후 슬롯 관문에서 정지"
+                  " [rc=" + std::to_string(rc) + " stage=" + std::to_string(stage) + "/9]");
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ★bin 경로 주소 계약 불변(리드 B4 판정의 직접 증명) ----
+    //      `part_info()` 는 A2 에서 mode 분기를 얻었다. bin manifest 로 seal 하면 종전대로
+    //      (part_offset, part_bytes) 를 반환해야 한다 — 분기가 bin 의미를 건드렸으면 여기서 깨진다.
+    {
+        Fixture fx;
+        fx.dir = make_case_dir("v3_a2_bin_partinfo");
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_separate_layer(0, fx.model.n_expert, "MXFP4", true),
+                            make_separate_layer(1, fx.model.n_expert, "MXFP4", true) };
+        fx.model.n_layer = 4;
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        const int rc = fx.seal((uint64_t)fx.model.n_expert * fx.comp.slot_stride_max, 64);
+        bool bin_ok = (rc == 0);
+        int32_t checked = 0; std::string bin_bad;
+        for (size_t li = 0; li < fx.model.layers.size() && bin_ok; li++) {
+            for (size_t pi = 0; pi < fx.model.layers[li].parts.size(); pi++) {
+                ggml_tensor * t = fx.find(fx.model.layers[li].parts[pi].source_tensor);
+                if (!t) continue;
+                uint64_t off = 0, nb = 0;
+                const CompPart & cp = fx.comp.layers[li].parts[pi];
+                if (ggml_moe_direct_part_info(t, &off, &nb) != 0 || off != cp.part_offset || nb != cp.part_bytes) {
+                    bin_bad = " 첫 불일치 " + fx.model.layers[li].parts[pi].source_tensor +
+                              " off=" + std::to_string(off) + "/" + std::to_string(cp.part_offset) +
+                              " bytes=" + std::to_string(nb) + "/" + std::to_string(cp.part_bytes);
+                    bin_ok = false; break;
+                }
+                checked++;
+            }
+        }
+        check(bin_ok && checked > 0,
+              "V3d9. ★bin 경로 무접촉 — v2 seal 후 part_info() 가 종전 (part_offset, part_bytes) 반환("
+              + std::to_string(checked) + " part 전건)" + bin_bad);
+        ggml_moe_direct_reset_for_test();
+    }
+
+    ggml_moe_direct_reset_for_test();
+}
