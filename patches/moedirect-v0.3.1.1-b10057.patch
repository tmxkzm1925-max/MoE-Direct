+// mode=virtual + 프리페치 ON 으로 실 seal 을 세운다. 호출자가 K/N·노브 EnvGuard 를 쥔다.
+static bool v3_pf_arm(V3Fixture & fx, PbInvFix & inv, const char * tag, const char * qd,
+                      std::string & why) {
+    fx.dir   = make_case_dir(tag);
+    fx.model = default_v3_model(1);
+    // ★snapshot 형상 확정(note_seal 이 `n_layer_exec>=2 ∧ n_embd>0` 을 요구한다).
+    fx.model.n_embd = PB_TEST_N_EMBD;
+    fx.model.f_norm_rms_eps = 1e-6f;
+    if (!fx.build(why)) return false;
+    // ★seal 이전 descriptor 선언 — 실 텐서 인벤토리로 계열 adapter 를 해소한다. 빼면 adapter 가
+    //   none 으로 내려가 `pf_on` 이 false 가 되고, 관문이 "프리페치 OFF" 를 통과로 오독한다.
+    PbInvOpt o;
+    pb_build_inventory(inv, fx.model.n_expert, PB_TEST_N_EMBD,
+                       /*n_layer_exec=*/fx.model.n_layer, /*n_expert_used=*/fx.model.n_expert_used, o);
+    ggml_moe_phaseb_note_family(&inv.fam);
+    if (qd) set_env("MOE_DIRECT_QD", qd);
+    std::vector<int32_t> ml;
+    ggml_moe_direct_model md = fx.model_desc(ml);
+    std::vector<ggml_moe_direct_source> sd = fx.source_descs();
+    const std::string dir_utf8 = wide_to_utf8(fx.dir);
+    const int rc = ggml_moe_direct_seal_for_test(dir_utf8.c_str(), &md, sd.data(), (int32_t)sd.size(),
+                                                 fx.budget(), 64, fx.expects_u8.c_str(),
+                                                 fx.ref_profile_id.c_str(),
+                                                 fx.ref_expect_sha256.c_str(), nullptr);
+    if (qd) clear_env("MOE_DIRECT_QD");
+    if (rc != 0) {
+        why = "seal rc=" + std::to_string(rc) + " stage=" +
+              std::to_string(ggml_moe_direct_test_v3_stage());
+        return false;
+    }
+    return true;
+}
