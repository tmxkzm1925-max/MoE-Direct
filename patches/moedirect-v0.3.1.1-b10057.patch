+// ===========================================================================
+// P35. ★3차 사이클 품목① A — NO_OUTPUT 태깅
+//      (FROZEN_PB_OBSV_V2 §1.5·§4·§5·§7·§8 · FROZEN_AUTHORITY_V3 §3.2.1)
+// ===========================================================================
+
+// ★V2 wire ABI 판정기(§4 flags 규약 · §4.1 완전 동치 · §6 게이트 ③⑧) — selftest 자체 판독기다.
+//   양성/음성 **양방향**으로 행사해야 공허 통과가 막힌다(a0_equiv 선례 · §8-2/§8-10).
+static bool pb_obsv_abi_accept(const char * kind_tag, const ggml_moe_phaseb_observe & r) {
+    const bool v2 = (std::strcmp(kind_tag, "PB_OBSV_V2") == 0);
+    const bool v1 = (std::strcmp(kind_tag, "PB_OBSV_V1") == 0);
+    if (!v1 && !v2) return false;                       // sentinel 4중 잠금 — 미지 세대는 거부
+    const uint8_t f = r.flags;
+    if (v1 && (f & 0xFE) != 0) return false;            // ★V1 예약비트 b1~b7 = 전부 0(묵시 재사용 금지)
+    if (v2 && (f & 0xFC) != 0) return false;            // ★V2 reserved b2~b7 = 전부 0(게이트 ⑧)
+    const bool valid = (f & GGML_MOE_PB_OBS_FLAG_VALID) != 0;
+    const bool nout  = (f & GGML_MOE_PB_OBS_FLAG_NO_OUTPUT) != 0;
+    if (valid != (r.invalid_reason == GGML_MOE_PB_OBS_NONE)) return false;              // V1 승계 동치
+    if (v1 && r.invalid_reason == GGML_MOE_PB_OBS_NO_OUTPUT) return false;              // V1 에 6은 없다
+    if (v2 && nout != (r.invalid_reason == GGML_MOE_PB_OBS_NO_OUTPUT)) return false;    // §4.1 완전 동치
+    if (valid && nout) return false;                                                    // 불법 조합(§4.1)
+    if (!valid) {                                                                       // NA 규약(게이트 ③)
+        for (int i = 0; i < 16; i++) if (r.pred[i] != 0xFFFF) return false;
+        if (r.predict_end_qpc != 0) return false;
+    }
+    for (int i = 0; i < 8; i++) if (r.reserved[i] != 0) return false;
+    return true;
+}
