+    llm_shadow_moe_ud ud{};
+    ud.gate_exps     = merged ? nullptr : &tw_gate;
+    ud.up_exps       = (has_gate && !merged) ? &tw_up : nullptr;
+    ud.down_exps     = &tw_down;
+    ud.gate_up_exps  = merged ? &tw_gate : nullptr;
+    ud.layer_id      = -1;
+    ud.mlpos         = -1;
+    ud.n_expert_used = n_pred;
+    ud.type_op       = type_op;
+    ud.arch_ds4      = 0;
+    ud.swiglu_limit  = 0.0f;
+    ud.scratch       = &sc;
+    ud.test_bases[0] = gate_w;                                  // gate(merged 면 gate_up)
+    ud.test_bases[1] = (has_gate && !merged) ? up_w : nullptr;   // merged 는 pg 를 재사용
+    ud.test_bases[2] = down_w;
+
+    std::memset(out, 0, (size_t) n_embd * sizeof(float));
+
+    llm_shadow_token_stat st;
+    shadow_moe_token_body(ud, sc,
+                          &tw_gate,
+                          (has_gate && !merged) ? &tw_up : nullptr,
+                          &tw_down,
+                          merged, has_gate,
+                          n_embd, n_ff,
+                          (const char *) x, sizeof(float),
+                          pred, wt, n_pred, mask, n_present,
+                          out, st);
+
+    return st.failed ? -5 : 0;
+}
