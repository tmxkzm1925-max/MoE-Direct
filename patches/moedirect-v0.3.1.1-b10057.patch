+// 전량 런 보고에 함께 적는 환경 충족 여부(리드 규율 — 수치만으로는 무엇이 붉은지 알 수 없다).
+static std::string sh_p43_env_line() {
+    if (g_py_env_state == 1) return "P43 env: SATISFIED (" + g_py_interp_src + ")";
+    if (g_py_env_state == 2) return "P43 env: UNMET (" + g_py_env_diag + ")";
+    return "P43 env: NOT PROBED (no P43 group ran)";
+}
+
+// 실 판독기를 임의 인자로 돌린다(인터프리터는 위에서 이미 확정됐다).
+static ShProc sh_run_reader_args(const std::wstring & args, const std::wstring & log_path) {
+    const std::wstring script = sh_reader_script();
+    ShProc r;
+    if (!sh_file_exists(script)) return r;               // launched=false → 검사 FAIL(정직)
+    sh_resolve_interp(log_path);
+    if (g_py_env_state != 1) return r;                   // 환경 미충족 — 배너가 사유를 남겼다
+    return sh_exec(g_py_interp + sh_q(script) + L" " + args, log_path);
+}
+
+// 실 판독기를 --run-dir 모드로 돌린다.
+static ShProc sh_run_reader(const std::wstring & run_dir, const std::wstring & log_path) {
+    return sh_run_reader_args(L"--run-dir " + sh_q(run_dir) + L" --model dsv4", log_path);
+}
+
+// ★음성 대조 전용 — 사이드카 payload 를 바꿔 다시 쓴다(record_count·payload_digest 재계산).
+//   digest 를 다시 맞추지 않으면 판독기가 ABI 게이트에서 먼저 죽어 **의도한 계약**을 못 태운다.
+static bool sh_rewrite(const std::wstring & path, const std::vector<uint8_t> & payload,
+                       uint64_t record_count) {
+    std::vector<uint8_t> blob;
+    {
+        std::ifstream in(path, std::ios::binary);
+        if (!in) return false;
+        blob.assign((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    }
+    if (blob.size() < 128) return false;
+    std::vector<uint8_t> out(blob.begin(), blob.begin() + 128);
+    const uint64_t dg = sh_fnv1a64(payload.data(), payload.size());
+    std::memcpy(out.data() + 24, &record_count, 8);
+    std::memcpy(out.data() + 32, &dg,           8);
+    out.insert(out.end(), payload.begin(), payload.end());
+    std::ofstream o(path, std::ios::binary | std::ios::trunc);
+    if (!o) return false;
+    o.write((const char *) out.data(), (std::streamsize) out.size());
+    o.flush();
+    return (bool) o;
+}
+
+static bool sh_out_has(const ShProc & p, const char * needle) {
+    return p.out.find(needle) != std::string::npos;
+}
