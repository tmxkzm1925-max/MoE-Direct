+// ── O6. lost-wake 방지(연속 enqueue↔dispatcher 수면 전이 반복) ──
+static void test_b1_lost_wake() {
+    section("O6. ★lost-wake 방지 — dispatcher 수면/기상 전이를 반복 유발해도 진행이 멈추지 않는다");
+
+    EnvGuard eg_q("MOE_DIRECT_QUALIFY", nullptr);
+    EnvGuard eg_p("MOE_DIRECT_IO_PATH", nullptr);
+    Fixture fx; qd_setup_2layer(fx, "b1_lostwake");
+    int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+    if (!check(rc == 0, "O6a. seal 성공")) return;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+
+    const int NT = 6, ITER = 400;
+    std::atomic<uint64_t> done(0);
+    std::atomic<int> errs(0);
+    std::vector<std::thread> th;
+    th.reserve(NT);
+    for (int t = 0; t < NT; t++) {
+        th.emplace_back([&, t]() {
+            for (int i = 0; i < ITER; i++) {
+                ggml_tensor * tensor = ((i + t) & 1) ? g1 : g0;
+                int32_t id = (int32_t)((i + t) % 8);
+                if (ggml_moe_direct_acquire(tensor, &id, 1, 1) != 0) errs.fetch_add(1);
+                else ggml_moe_direct_release(tensor, &id, 1);
+                done.fetch_add(1);
+                if ((i & 15) == 0) Sleep(0); // dispatcher가 wait 상태로 내려갈 틈을 준다
+            }
+        });
+    }
+    const uint64_t want = (uint64_t)NT * ITER;
+    bool completed = false;
+    for (int i = 0; i < 6000; i++) { // 최대 60초 워치독
+        if (done.load() >= want) { completed = true; break; }
+        Sleep(10);
+    }
+    if (!completed) {
+        check(false, "O6b. ★lost-wake 워치독 — 60초 내 미완료(진행 " + std::to_string(done.load()) + "/" +
+                     std::to_string(want) + ") = lost wake 의심");
+        printf("\n==== 총계 ====\n%d/%d PASS (%d FAIL) — 진행 정지로 즉시 종료\n", g_total - g_failed, g_total, g_failed);
+        fflush(stdout);
+        _exit(1);
+    }
+    for (auto & t : th) t.join();
+    check(errs.load() == 0, "O6b. ★" + std::to_string(want) + "회 acquire/release 전건 성공(lost-wake 0 · 실패 " +
+                            std::to_string(errs.load()) + "건)");
+    int32_t leased = -1; int64_t total = -1;
+    ggml_moe_direct_test_lease_stats(&leased, &total);
+    check(leased == 0 && total == 0, "O6c. 종료 시 lease 잔량 0");
+}
