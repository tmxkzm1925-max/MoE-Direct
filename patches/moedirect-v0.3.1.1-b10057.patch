+
+// phase_b_run 레코드를 request_index 로 골라 읽는다(중복 방출 시 첫 건).
+static json pb5ct_run_record_of(const std::wstring & path, uint64_t request_index) {
+    std::ifstream ifs(path, std::ios::binary);
+    std::string line;
+    while (std::getline(ifs, line)) {
+        json j = json::parse(line, nullptr, false);
+        if (!j.is_object() || j.value("type", "") != "phase_b_run") continue;
+        if (j.value("request_index", (uint64_t)0xFFFFFFFFull) == request_index) return j;
+    }
+    return json::object();
+}
+static uint64_t pb5ct_run_c3(const json & run, const char * key) {
+    if (!run.is_object() || !run.contains("counts") || !run["counts"].contains("c3")) return 0;
+    return run["counts"]["c3"].value(key, (uint64_t)0);
+}
