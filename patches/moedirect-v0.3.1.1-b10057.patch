+// ── ★버퍼 스텁(게이트 ⑦) ───────────────────────────────────────────────────────────────
+//   `is_host` 를 **제공하지 않는** buffer type = 비-host(ggml-backend.cpp:74-80 의 기본값 false).
+//   host 팔용으로는 `is_host` 가 true 를 돌려주는 짝을 따로 둔다. 데이터 접근은 두 팔 모두
+//   `iface.get_tensor` 를 거치며, 그 구현은 실 backend 와 동일한 계약(offset/size 바이트를 dst 로
+//   복사)의 정직한 memcpy 다. CPU 전용 빌드에는 비-host 버퍼를 내는 실 backend 가 없다.
+static void nh_get_tensor(ggml_backend_buffer_t, const ggml_tensor * t, void * data,
+                          size_t offset, size_t size) {
+    std::memcpy(data, (const char *)t->data + offset, size);
+}
+static void nh_set_tensor(ggml_backend_buffer_t, ggml_tensor * t, const void * data,
+                          size_t offset, size_t size) {
+    std::memcpy((char *)t->data + offset, data, size);
+}
+static void * nh_get_base(ggml_backend_buffer_t buf) { return buf->context; }
+static void   nh_clear(ggml_backend_buffer_t, uint8_t) {}
+static const char * nh_buft_name(ggml_backend_buffer_type_t) { return "moe-selftest-nonhost"; }
+static const char * nh_buft_name_h(ggml_backend_buffer_type_t) { return "moe-selftest-host"; }
+static size_t       nh_buft_align(ggml_backend_buffer_type_t) { return 64; }
+static bool         nh_buft_is_host(ggml_backend_buffer_type_t) { return true; }
+
+static ggml_backend_buffer_type * nh_buft(bool host) {
+    static ggml_backend_buffer_type b[2] = {};
+    static bool init = false;
+    if (!init) {
+        b[0].iface.get_name      = nh_buft_name;
+        b[0].iface.get_alignment = nh_buft_align;
+        b[0].iface.is_host       = nullptr;          // ★핵심 — 미제공 = 비-host
+        b[1].iface.get_name      = nh_buft_name_h;
+        b[1].iface.get_alignment = nh_buft_align;
+        b[1].iface.is_host       = nh_buft_is_host;  // host 팔(모듈은 직독 분기를 탄다)
+        init = true;
+    }
+    return &b[host ? 1 : 0];
+}
+static ggml_backend_buffer_t nh_buffer_new(size_t size, bool host) {
+    ggml_backend_buffer_i iface{};
+    iface.get_base   = nh_get_base;
+    iface.set_tensor = nh_set_tensor;
+    iface.get_tensor = nh_get_tensor;
+    iface.clear      = nh_clear;
+    return ggml_backend_buffer_init(nh_buft(host), iface, nullptr, size);
+}
+
+// BF16 비트 → F32(★독립 구현 — ggml 헬퍼를 부르지 않는다. 참조 계산 독립성의 근거).
+static float dsv4_bf16_to_f32(uint16_t bits) {
+    uint32_t u = (uint32_t)bits << 16;
+    float f; std::memcpy(&f, &u, sizeof(f)); return f;
+}
+// F32 → BF16 비트(상위 16비트 절단). 절단값을 그대로 참조에도 쓰므로 반올림 규칙과 무관하게
+// "엔진이 본 값 = 참조가 본 값"이 성립한다(무손실 승격의 시험 조건).
+static uint16_t dsv4_f32_to_bf16(float f) {
+    uint32_t u; std::memcpy(&u, &f, sizeof(u)); return (uint16_t)(u >> 16);
+}
+
+// ★실 텐서 인벤토리를 만들어 **프로덕션과 동일한 판정 경로**를 행사한다(합성 count 주입 없음).
+//   1차 소스 대조: src/models/deepseek4.cpp:132~135 — 전 층 ffn_gate_inp/ffn_norm,
+//   il < hash_layer_count 는 ffn_gate_tid2eid(I32 {n_expert_used, n_vocab}), 그 외는 exp_probs_b.
+static void pb_build_dsv4_inventory(PbInvFix & F, const PbDsv4Opt & o) {
+    const int32_t NL = DSV4_N_LAYER, NX = DSV4_N_EXPERT, NE = DSV4_N_EMBD, NU = DSV4_N_USED;
+    ggml_init_params p{};
+    p.mem_size = (size_t)(NL * 4 + 8) * ggml_tensor_overhead() + 4096;
+    p.no_alloc = true;
+    F.ctx = ggml_init(p);
+    // fill=false 는 calloc 0 을 그대로 둔다(유한값이라 인벤토리 판정 결과가 같다). router 는
+    // 4MB×43 이라 패턴 기입만 생략해 픽스처 비용을 줄인다 — 예측 스냅샷은 별도로 주입한다.
+    auto mk = [&](ggml_type ty, int64_t e0, int64_t e1, const std::string & name, bool fill) -> ggml_tensor * {
+        int64_t ne[GGML_MAX_DIMS] = { e0, e1, 1, 1 };
+        ggml_tensor * t = ggml_new_tensor(F.ctx, ty, (e1 > 1 ? 2 : 1), ne);
+        ggml_set_name(t, name.c_str());
+        const size_t nb = ggml_nbytes(t);
+        void * blk = calloc(1, nb + 64);
+        F.blocks.push_back(blk);
+        t->data = blk;                       // buffer 는 nullptr — 모듈의 host 직독 분기를 탄다
+        // ★게이트 ⑦ — 버퍼 팔 선택. 비-host 면 모듈이 backend get_tensor 로만 읽는다.
+        if (o.buffer_mode != 0) {
+            ggml_backend_buffer_t buf = nh_buffer_new(nb, /*host=*/o.buffer_mode == 1);
+            F.bufs.push_back(buf);
+            t->buffer = buf;
+        }
+        if (fill && ty == GGML_TYPE_F32) {
+            float * f = (float *)blk;
+            const size_t n = nb / sizeof(float);
+            for (size_t i = 0; i < n; i++) f[i] = 0.25f + 0.01f * (float)(i % 7);
+        }
+        if (fill && ty == GGML_TYPE_BF16) {
+            uint16_t * h = (uint16_t *)blk;
+            const size_t n = nb / sizeof(uint16_t);
+            for (size_t i = 0; i < n; i++) h[i] = dsv4_f32_to_bf16(0.25f + 0.01f * (float)(i % 7));
+        }
+        return t;
+    };
+    // router dtype(§1.6) — deepseek4_v1 행만 {F32, BF16} 이고 F16/Q8_0 은 계속 거부 대상이다.
+    const ggml_type rty = (o.router_type == 1) ? GGML_TYPE_BF16
+                        : (o.router_type == 2) ? GGML_TYPE_F16
+                        : (o.router_type == 3) ? GGML_TYPE_Q8_0 : GGML_TYPE_F32;
+    F.lin.assign((size_t)NL, ggml_moe_phaseb_layer_in{});
+    for (int32_t il = 0; il < NL; il++) {
+        const std::string b = "blk." + std::to_string(il) + ".";
+        // ★ffn_norm 은 exact-zero 인벤토리의 분모 축이므로 반드시 **비-0** 으로 채운다.
+        F.lin[(size_t)il].ffn_norm     = mk(o.norm_bf16 ? GGML_TYPE_BF16 : GGML_TYPE_F32,
+                                            NE, 1,  b + "ffn_norm.weight",     true);
+        if (il != o.router_drop_layer) {
+            const int64_t re0 = (il == 1 && o.router_shape_bad) ? NE + 1 : NE;
+            const std::string rnm = (il == 1 && o.router_misname) ? (b + "ffn_gate_inp_WRONG.weight")
+                                                                  : (b + "ffn_gate_inp.weight");
+            ggml_tensor * rt = mk(rty, re0, NX, rnm, o.router_fill);
+            if (il == 1 && o.router_noncontig) rt->nb[1] += 64;    // 형상은 맞고 stride 만 어긋난다
+            if (il == 1 && o.router_unalloc)   rt->data = nullptr; // 블록 소유는 F.blocks 가 유지
+            // ★비유한 주입 — dtype 에 맞는 비트패턴으로 넣는다(BF16 NaN=0x7FC0 · ±Inf=0x7F80/0xFF80).
+            if (il == o.router_bad_layer && o.router_bad_kind > 0 && rt->data) {
+                if (rty == GGML_TYPE_BF16) {
+                    const uint16_t bits = (o.router_bad_kind == 1) ? 0x7FC0
+                                        : (o.router_bad_kind == 2) ? 0x7F80 : 0xFF80;
+                    ((uint16_t *)rt->data)[1] = bits;
+                } else if (rty == GGML_TYPE_F32) {
+                    ((float *)rt->data)[1] = (o.router_bad_kind == 1)
+                        ? std::numeric_limits<float>::quiet_NaN()
+                        : (o.router_bad_kind == 2 ? std::numeric_limits<float>::infinity()
+                                                  : -std::numeric_limits<float>::infinity());
+                }
+            }
+            F.lin[(size_t)il].ffn_gate_inp = rt;
+        }
+        bool want_tid = (il < DSV4_HASH);
+        if (il == o.tid_drop_layer)  want_tid = false;
+        if (il == o.tid_extra_layer) want_tid = true;
+        bool want_ep = (il >= DSV4_HASH);
+        if (il == o.ep_drop_layer)   want_ep = false;
+        if (il == o.ep_extra_layer)  want_ep = true;
+        if (want_tid) {
+            const ggml_type ty = o.tid_type_bad ? GGML_TYPE_F32 : GGML_TYPE_I32;
+            const int64_t   e0 = o.tid_shape_bad ? NU + 1 : NU;
+            const std::string nm = o.tid_misname ? (b + "ffn_gate_tid2eid_WRONG.weight")
+                                                 : (b + "ffn_gate_tid2eid.weight");
+            ggml_tensor * t = mk(ty, e0, DSV4_VOCAB, nm, false);   // I32 calloc 0 = expert id 0
+            if (o.tid_range_bad && ty == GGML_TYPE_I32) ((int32_t *)t->data)[0] = NX;   // 공간 밖
+            F.lin[(size_t)il].ffn_gate_tid2eid = t;
+        }
+        if (want_ep) F.lin[(size_t)il].ffn_exp_probs_b =
+            mk(o.bias_bf16 ? GGML_TYPE_BF16 : GGML_TYPE_F32, NX, 1, b + "exp_probs_b.bias", true);
+    }
+    F.ml.clear();
+    for (int32_t l = 0; l < NL; l++) F.ml.push_back(l);   // 전 층 MoE(leading_dense=0)
+    F.fam = ggml_moe_phaseb_family_in{};
+    F.fam.arch                 = "deepseek4";
+    F.fam.expert_gating_func   = o.gating;
+    F.fam.n_expert_groups      = o.groups;
+    F.fam.n_embd               = NE;
+    F.fam.n_expert             = NX;
+    F.fam.n_expert_used        = o.n_expert_used;
+    F.fam.n_layer_exec         = NL;
+    F.fam.n_moe_layers         = (int32_t)F.ml.size();
+    F.fam.moe_layers           = F.ml.data();
+    F.fam.layers               = F.lin.data();
+    F.fam.hash_layer_count     = o.hash_layer_count;
+    F.fam.n_expert_shared      = o.n_expert_shared;
+    F.fam.hc_mult              = o.hc_mult;
+    F.fam.expert_weights_norm  = o.weights_norm;
+    F.fam.expert_weights_scale = o.weights_scale;
+}
+
+// 43층 × 256E 합성 모델(카탈로그/bin) + 인벤토리 텐서까지. **`note_family` 는 호출부 몫**이다 —
+// 값 주입이 필요한 픽스처(BF16 동등성)는 주입을 마친 뒤 선언해야 인벤토리 주사가 최종 값을 본다.
+static void pb_setup_dsv4_tensors(Fixture & fx, const char * tag, const PbDsv4Opt & o, PbInvFix & F) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "synth";
+    fx.model.n_expert = DSV4_N_EXPERT; fx.model.n_expert_used = DSV4_N_USED;
+    fx.model.n_layer  = DSV4_N_LAYER;  fx.model.n_embd = DSV4_N_EMBD;
+    fx.model.f_norm_rms_eps = 1e-6f;
+    fx.model.sources = { default_source() };
+    fx.model.layers.clear();
+    for (int32_t il = 0; il < DSV4_N_LAYER; il++)
+        fx.model.layers.push_back(make_separate_layer(il, DSV4_N_EXPERT, "MXFP4", false));
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.build();
+    pb_build_dsv4_inventory(F, o);
+}
+
+static void pb_setup_dsv4(Fixture & fx, const char * tag, const PbDsv4Opt & o) {
+    PbInvFix F;
+    pb_setup_dsv4_tensors(fx, tag, o, F);
+    ggml_moe_phaseb_note_family(&F.fam);   // 즉시 판정·복사 — F 는 여기서 파괴돼도 안전
+}
+
+static int dsv4_seal(Fixture & fx) {
+    return fx.seal((uint64_t)DSV4_N_EXPERT * fx.comp.slot_stride_max, 64);
+}
+
+// 합성 스냅샷 주입 — 마스크 안(3..42)의 router/bias 와 전 층 norm 을 채운다.
+//   bias 는 **변환 뒤 스케일과 같은 자릿수**(±2)로 실어 4산식이 실제로 갈리게 한다:
+//   sqrt(softplus(·)) 는 단조증가라 "bias 누락"·"가산 시점 오류" 산식은 raw 순서로 붕괴하고,
+//   계약 산식만 압축된 점수에 bias 가 유효하게 작용한다.
+static void pb_gen_snapshot_dsv4(uint32_t seed, std::vector<float> & w0, std::vector<float> & w1,
+                                 std::vector<float> & rt, std::vector<float> & bias) {
+    const int32_t ne = DSV4_N_EMBD, nx = DSV4_N_EXPERT;
+    w0.assign((size_t)ne, 0.0f); w1.assign((size_t)ne, 0.0f);
+    rt.assign((size_t)ne * (size_t)nx, 0.0f);
+    bias.assign((size_t)nx, 0.0f);
+    std::mt19937 rng(seed);
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (auto & v : w0) v = 0.5f + std::fabs(ud(rng));
+    for (auto & v : w1) v = ud(rng);
+    for (auto & v : rt) v = ud(rng);
+    for (int32_t e = 0; e < nx; e++) bias[(size_t)e] = ((e % 2) ? 2.0f : -2.0f) + 0.25f * ud(rng);
+}
+
+static void pb_fill_snapshot_dsv4(int32_t src_layer, int32_t tgt_layer, uint32_t seed,
+                                  std::vector<float> & w0, std::vector<float> & w1,
+                                  std::vector<float> & rt, std::vector<float> & bias) {
+    const int32_t ne = DSV4_N_EMBD;
+    pb_gen_snapshot_dsv4(seed, w0, w1, rt, bias);
+    std::vector<float> filler((size_t)ne, 1.0f);
+    for (int32_t l = 0; l < DSV4_N_LAYER; l++) {
+        const float * nm = (l == src_layer) ? w0.data() : ((l == tgt_layer) ? w1.data() : filler.data());
+        const float * r  = (l >= DSV4_HASH) ? rt.data() : nullptr;   // ★마스크 밖은 주입 자체를 안 한다
+        ggml_moe_phaseb_test_snapshot_raw(l, r, nm);
+        if (l >= DSV4_HASH) ggml_moe_phaseb_test_snapshot_bias_raw(l, bias.data());
+    }
+}
+
+static void test_pb_dsv4_selection() {
+    section("P36. ★deepseek4_v1(DSV4_ADAPTER_DESIGN §1.5) — 닫힌 매핑 해소 · 층 마스크(learned target 3..42) · "
+            "TopK(sqrt(softplus(Wx))+exp_probs_b) 8입력 동등성(scalar F32 독립 재계산) + "
+            "★음성 컨트롤 3오산식(raw+bias / sqrt∘softplus(bias 누락) / sqrt∘softplus(raw+bias)) 전건 상이");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; PbDsv4Opt o;
+    pb_setup_dsv4(fx, "pb_dsv4_eq", o);
+    if (!check(dsv4_seal(fx) == 0, "P36a. seal 성공(deepseek4 descriptor · 43L×256E×4096 · 프리페치 ON)")) return;
+
+    const int32_t ne = DSV4_N_EMBD, nx = DSV4_N_EXPERT;
+    check(ggml_moe_phaseb_adapter_id() == GGML_MOE_PHASEB_ADAPTER_DEEPSEEK4 &&
+          std::string(ggml_moe_phaseb_adapter_name()) == "deepseek4_v1" &&
+          std::string(ggml_moe_phaseb_adapter_reason()).empty() &&
+          ggml_moe_phaseb_norm_tensor_kind() == GGML_MOE_PHASEB_NORM_FFN &&
+          ggml_moe_phaseb_selection_fn()     == GGML_MOE_PHASEB_SEL_TOPK_SQRT_SOFTPLUS_BIAS &&
+          ggml_moe_phaseb_bias_kind()        == GGML_MOE_PHASEB_BIAS_EXP_PROBS_B &&
+          std::string(ggml_moe_phaseb_selection_fn_name()) == "topk_sqrt_softplus_bias" &&
+          std::string(ggml_moe_phaseb_norm_tensor_name()) == "ffn_norm" &&
+          std::string(ggml_moe_phaseb_bias_snapshot_name()) == "ffn_exp_probs_b[]" &&
+          ggml_moe_phaseb_capture_width() == ne && ggml_moe_phaseb_prefetch_on(),
+          "P36b. ★닫힌 매핑 해소 = deepseek4_v1(norm=ffn_norm · sel=topk_sqrt_softplus_bias · "
+          "bias=ffn_exp_probs_b[]) · capture_width=" + std::to_string(ggml_moe_phaseb_capture_width()));
+    check(ggml_moe_phaseb_signal_first_target_layer() == DSV4_HASH &&
+          ggml_moe_phaseb_signal_layer_mask_active() &&
+          !ggml_moe_phaseb_signal_target_eligible(0) &&
+          !ggml_moe_phaseb_signal_target_eligible(1) &&
+          !ggml_moe_phaseb_signal_target_eligible(2) &&
+          ggml_moe_phaseb_signal_target_eligible(3) &&
+          ggml_moe_phaseb_signal_target_eligible(DSV4_N_LAYER - 1) &&
+          ggml_moe_phaseb_output_crop_before_last_moe() == false,
+          "P36c. ★층 마스크 = first_target_layer 3(정적 제외 target 1·2) · capability echo "
+          "output_crop_before_last_moe=false(후행 crop 계열)");
+
+    std::vector<float> w0, w1, rt, bias;
+    pb_fill_snapshot_dsv4(/*src_layer=*/DSV4_HASH - 1, /*tgt_layer=*/DSV4_HASH, 20260802u, w0, w1, rt, bias);
+    check(ggml_moe_phaseb_snapshot_seal() == 0 &&
+          ggml_moe_phaseb_bias_snapshot_bytes() == (uint64_t)(DSV4_N_LAYER - 1) * nx * sizeof(float),
+          "P36d. ★마스크 seal — router/bias 를 3..42 만 채워도 seal 성립(1·2층 미채움이 결손이 아님) · "
+          "bias 회계 " + std::to_string(ggml_moe_phaseb_bias_snapshot_bytes()) + "B");
+
+    ggml_moe_direct_test_dispatcher_pause(1);
+    ggml_moe_phaseb_run_begin();
+    std::mt19937 rng(90210u);
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    int produced = 0, matched = 0, tie_free = 0;
+    int differ[3] = {0, 0, 0};
+    int masked_reject = 0;
+    // ★첫 표본의 실측 배열(증거 인용용) — 계수만이 아니라 "무엇이 어떻게 갈렸는가"를 남긴다.
+    std::string head_engine, head_bad[3];
+    for (int t = 0; t < 8; t++) {
+        std::vector<float> x((size_t)ne);
+        for (auto & v : x) v = ud(rng);
+        ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);
+        // ★층 마스크 실행 표면 — source 1(target 2)은 capture 자체가 거절돼야 한다.
+        if (ggml_moe_phaseb_capture(/*src_layer=*/1, -1, x.data(), (int32_t)GGML_TYPE_F32, ne, 1, 1, 1) == 0)
+            masked_reject++;
+        const int rc = ggml_moe_phaseb_capture(/*src_layer=*/DSV4_HASH - 1, -1, x.data(),
+                                               (int32_t)GGML_TYPE_F32, ne, 1, 1, 1);
+        const int idle = ggml_moe_phaseb_test_wait_idle(15000);
+        ggml_moe_phaseb_intent it{};
+        const int got = ggml_moe_phaseb_intent_peek(&it);
+        if (got == 1) ggml_moe_phaseb_intent_pop();
+        ggml_moe_phaseb_graph_end();
+        if (rc != 1 || idle != 1 || got != 1) continue;
+        produced++;
+        if (it.target_layer != (uint16_t)DSV4_HASH) continue;
+        bool tf = false;
+        const std::vector<uint16_t> ref = pb_ref_topk16_dsv4(x, w0, w1, rt, bias, ne, nx, DSV4_F_CORRECT, &tf);
+        if (tf) tie_free++;
+        bool same = true;
+        for (int i = 0; i < 16; i++) if (it.ids[i] != ref[(size_t)i]) { same = false; break; }
+        if (same) matched++;
+        if (head_engine.empty()) head_engine = pb_ids_head(it.ids, 4);
+        for (int f = 0; f < 3; f++) {
+            const std::vector<uint16_t> bad = pb_ref_topk16_dsv4(x, w0, w1, rt, bias, ne, nx, f + 1);
+            bool eq = true;
+            for (int i = 0; i < 16; i++) if (it.ids[i] != bad[(size_t)i]) { eq = false; break; }
+            if (!eq) differ[f]++;
+            if (head_bad[f].empty()) head_bad[f] = pb_ids_head(bad.data(), 4);
+        }
+    }
+    ggml_moe_direct_test_dispatcher_pause(0);
+    ggml_moe_direct_test_pb_quiesce(3000);
+    ggml_moe_phaseb_run_end();
+    check(produced == 8 && matched == 8 && tie_free == 8,
+          "P36e. ★★TopK(sqrt(softplus(Wx)) + exp_probs_b) 동등성 — 8/8 입력에서 ordered top-16 배열 "
+          "byte-equal(" + std::to_string(matched) + "/" + std::to_string(produced) +
+          ") · 비동률 픽스처 확인(16위>17위 엄격 부등 " + std::to_string(tie_free) + "/8)");
+    check(produced == 8 && differ[0] == 8 && differ[1] == 8 && differ[2] == 8,
+          "P36f. ★★음성 컨트롤 3오산식 — ⓐraw+bias(" + std::to_string(differ[0]) +
+          "/8 상이) · ⓑsqrt∘softplus(bias 누락)(" + std::to_string(differ[1]) +
+          "/8) · ⓒsqrt∘softplus(raw+bias)(" + std::to_string(differ[2]) +
+          "/8) 전건 상이 = 변환·가산 시점이 실제 선택 경로에 도달했음의 실증. "
+          "표본0 실측: engine=" + head_engine + " vs ⓐ" + head_bad[0] + " ⓑ" + head_bad[1] +
+          " ⓒ" + head_bad[2]);
+    check(masked_reject == 8,
+          "P36g. ★층 마스크 실행 표면 — 정적 제외 target(2) 의 capture 는 전건 거절(" +
+          std::to_string(masked_reject) + "/8) · intent 미발행");
+}
