+// ===========================================================================
+// P42. ★레버 A 단계 1 S2 — range graph + boundary (층-우선 프리필)
+//   SPEC_S2_RANGEGRAPH.md v1.0 §1~§5.
+//
+//   ★검증 경계(보고서와 세트 — "검증한 척" 금지):
+//     여기서 닫는 것은 ①admission 판별 ②bank 수명주기 ③reuse 전환 key ④실패 처분표
+//     ⑤동결 뷰 접근자 ⑥range/boundary 역할 파생 (이상 엔진 내부 — llama_s2_selfcheck)
+//     + ⑦lmtrace range 태그 layout 왕복·하위 호환 ⑧prefill 신호 1회화·segment 회계
+//     ⑨경계 CPY bytes/count 회계 (이상 이 하네스에서 직접)
+//     + ⑩실패 정리 **순서**(device sync → abort → bank free — r31 차단 1 수리 · 엔진 내부)
+//     + ⑪APPLIED 구간 **예외 unwind** 정리(가드가 plan 소멸 전에 같은 순서로 정리하고 예외는
+//       흡수되지 않는다 — r32 차단 1 수리 · 엔진 내부).
+//     **실 그래프 빌드/compute 와 잠금 형상 회계**(tokens=8194·segments=723·boundary CPY=705·
+//     range_build=720/reuse=0)는 모델 로드가 필요하므로 **라이브 게이트 런** 소관이다.
+// ===========================================================================
+
+// ★S2 selfcheck 진입점 — 내부 C++ 타입(llama_context 등)이 DLL 밖으로 나오지 않으므로
+//   픽스처는 llama-context.cpp 안에서 돌고 이 하네스는 PASS/FAIL 회계만 소유한다(P41 관행).
+extern "C" LLAMA_API int llama_s2_selfcheck(void (*cb)(void * ud, int ok, const char * name), void * ud);
+
+static void s2_engine_cb(void * ud, int ok, const char * name) {
+    (void) ud;
+    check(ok != 0, name ? name : "(unnamed S2 check)");
+}
