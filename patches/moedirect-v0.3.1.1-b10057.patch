+// 3층 gpt-oss observe 형상의 스냅샷 주입(층 0·1·2 norm · 층 1·2 router/bias).
+//   2층 헬퍼(pb_fill_snapshot_bias)로는 "마지막 관리 MoE 행 1개만 전환"과 "다른 행 무변경"을
+//   구분할 수 없다(행이 1개뿐) — 그래서 행이 2개인 형상을 별도로 만든다.
+static void pb_fill_snapshot3(int32_t ne, int32_t nx, uint32_t seed,
+                              std::vector<float> w[3], std::vector<float> rt[3],
+                              std::vector<float> bs[3]) {
+    std::mt19937 rng(seed);
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (int l = 0; l < 3; l++) {
