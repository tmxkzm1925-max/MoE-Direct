+static void test_xpart_e2b0() {
+    section("XPART. E-2b-0 batch part capture / handle-table lifetime / lock-free view");
+
+    // ---- A. the new argument ------------------------------------------------------------
+    {
+        Fixture fx;
+        const int rc = xstore_seal_basic(fx, "xpart_core");
+        check(rc == 0 && ggml_moe_store_epoch() != 0,
+              "XPART01. seal succeeds and publishes a non-zero epoch (2 layers x 3 parts, "
+              "8 experts) [rc=" + std::to_string(rc) + "]");
+
+        ggml_tensor * p0[3]; xstore_part_tensors(fx, 0, p0);
+
+        // The value under test is chosen HERE and never read back from the engine, so every
+        // assertion below compares the engine against the harness rather than against itself.
+        const int32_t want_part = 2;
+        int32_t ids3[3] = { 0, 3, 7 };
+        uint64_t tokP = 0;
+        const int arcP = ggml_moe_store_acquire(0, want_part, ids3, 3, 1, &tokP);
+        check(arcP == 0 && tokP != 0,
+              "XPART02. store_acquire takes the batch part as an argument and still hands "
+              "back a non-zero handle [rc=" + std::to_string(arcP) + "]");
+
+        int32_t capP = -7;
+        const int cpr = ggml_moe_direct_test_xstore_token_part(tokP, &capP);
+        check(cpr == 0 && capP == want_part,
+              "XPART03. the token CAPTURED that part - the comparison is against the value "
+              "this harness passed in, not against anything the engine computed [captured=" +
+              std::to_string(capP) + " passed=" + std::to_string(want_part) + "]");
+
+        int32_t ids2b[2] = { 1, 4 };
+        uint64_t tokZ = 0;
+        const int arcZ = ggml_moe_store_acquire(0, 0, ids2b, 2, 1, &tokZ);
+        int32_t capZ = -7;
+        const int czr = (tokZ != 0) ? ggml_moe_direct_test_xstore_token_part(tokZ, &capZ) : -1;
+        check(arcZ == 0 && czr == 0 && capZ == 0 && capP == want_part && capZ != capP,
+              "XPART04. a second batch on the same layer taken with part 0 captures 0 while "
+              "the first still reads " + std::to_string(want_part) + " - the field is "
+              "per-batch, not a constant [second=" + std::to_string(capZ) + "]");
+
+        // The view's part is a projection key and is NOT required to equal the batch part.
+        bool indep_ok = (tokP != 0);
+        for (int e = 0; tokP != 0 && e < 3; e++) {
+            ggml_moe_buffer_view v = xstore_poisoned_view();
+            const int vr = ggml_moe_store_view(tokP, ids3[e], 0, &v);
+            const void * old_ptr = (p0[0] != nullptr)
+                                 ? ggml_moe_direct_ptr(p0[0], ids3[e]) : nullptr;
+            if (vr != 0 || old_ptr == nullptr || v.ptr != old_ptr) indep_ok = false;
+        }
+        check(indep_ok,
+              "XPART05. a token that captured part " + std::to_string(want_part) + " still "
+              "views part 0 and lands exactly where the old ptr() lands - the view's part "
+              "stays an INDEPENDENT projection key (contract section 1)");
+
+        if (tokZ != 0) ggml_moe_store_release(tokZ);
+        if (tokP != 0) ggml_moe_store_release(tokP);
+
+        // ---- B. failure atomicity of the new argument -----------------------------------
+        // Poison out_token the same way the view arms poison their out: a refusal that wrote
+        // a handle anyway would pass a return-value-only check.
+        const uint64_t TOKEN_POISON = 0x5A5A5A5A5A5A5A5Aull;
+        int64_t hN = -1, uN = -1, sN = -1;
+
+        uint64_t tokNeg = TOKEN_POISON;
+        const int arcNeg = ggml_moe_store_acquire(0, -1, ids3, 3, 1, &tokNeg);
+        ggml_moe_store_outstanding(&hN, &uN, &sN);
+        check(arcNeg < 0 && tokNeg == TOKEN_POISON && hN == 0 && uN == 0 && sN == 0,
+              "XPART06. a negative part is refused with NOTHING written to out_token and no "
+              "lease taken - all three counts stay at zero [rc=" + std::to_string(arcNeg) +
+              " h=" + std::to_string(hN) + " u=" + std::to_string(uN) + " slots=" +
+              std::to_string(sN) + "]");
+
+        uint64_t tokBig = TOKEN_POISON;
+        const int arcBig = ggml_moe_store_acquire(0, 3, ids3, 3, 1, &tokBig);
+        ggml_moe_store_outstanding(&hN, &uN, &sN);
+        check(arcBig < 0 && tokBig == TOKEN_POISON && hN == 0 && uN == 0 && sN == 0,
+              "XPART07. a part at or past this layer's parts vector is refused the same way; "
+              "a part ordinal is seal-scoped, so 3 is out of range for a 3-part layer [rc=" +
+              std::to_string(arcBig) + " h=" + std::to_string(hN) + " u=" +
+              std::to_string(uN) + " slots=" + std::to_string(sN) + "]");
+
+        int32_t one = 5;
+        uint64_t tokOk = 0;
+        const int arcOk = ggml_moe_store_acquire(1, 2, &one, 1, 1, &tokOk);
+        check(arcOk == 0 && tokOk != 0,
+              "XPART08. control - the SAME part value succeeds on layer 1, so the two "
+              "refusals above are about the part ordinal and not a blanket failure [rc=" +
+              std::to_string(arcOk) + "]");
+        if (tokOk != 0) ggml_moe_store_release(tokOk);
+    }
+    ggml_moe_direct_reset_for_test();
+
+    // ---- C. pass-through to the Phase A ledger -------------------------------------------
+    // The ledger is written by the real flush to the real sidecar; this reads those bytes back
+    // with the same mirror and reader P16g uses. What is asserted is that the parts this
+    // harness passed at the boundary come out the other end of the demand path.
+    {
+        ggml_moe_phasea_reset_for_test();
+        const std::wstring d = make_case_dir("xpart_pa");
+        EnvGuard pa("MOE_DIRECT_PHASEA", "timing");
+        EnvGuard pao("MOE_DIRECT_PHASEA_OUT", wide_to_utf8(d + L"\\pa").c_str());
+        Fixture fx;
