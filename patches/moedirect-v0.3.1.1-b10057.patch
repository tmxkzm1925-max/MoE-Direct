+// ===========================================================================
+// ★P47 — GPU측 조기 전달 계측 v2(PROBE_GPU_EARLY_SPEC_R1 ★FROZEN v1.0).
+//
+//   이 그룹이 검사하는 것 = **ggml-base 쪽 계약 전량**: env 게이트 3상 · OFF 무흔적 · 전량
+//   선할당 · C wire 물리 ABI(§4) · 층별 서수 규칙(§4 occurrence) · ms→ns 변환(§3) · 물리층
+//   결산의 분류 우선순위와 파생식(§3) · replay pending 회계(§2) · publication 계약.
+//
+//   ★이 그룹이 검사하지 **못하는** 것(숨기지 않고 명시): CUDA 이벤트 생성·`cudaEventRecordWithFlags`
+//     (external)·`cudaEventElapsedTime`·graph capture/replay/eviction 의 실발화. 합성 픽스처로
+//     CUDA graph 를 세울 수 없기 때문이며(lead-time 라운드의 A1/A2 미검사와 같은 성격),
+//     그 층은 사용자 실측 런에서만 확인된다. P47g9 가 그 사실을 0 으로 명시 기록한다.
+// ===========================================================================
+
+#pragma pack(push, 1)
+// 판독기가 하드코딩할 바이트 배치의 **하네스측 사본**(사양 §4 표). 모듈의 wire 구조체와 폭·
+// 오프셋이 어긋나면 아래 static_assert + 왕복 memcmp 가 잡는다(사본 드리프트 방지).
+struct GeHdrMirror {
+    char     magic[8];                  // @0   "MOEGPUC1"
+    uint32_t version;                   // @8
+    uint32_t record_size;               // @12
+    uint32_t header_size;               // @16
+    uint32_t pid;                       // @20
+    uint64_t qpc_frequency;             // @24
+    uint64_t boot_id;                   // @32
+    uint64_t t0_qpc;                    // @40
+    uint64_t record_count;              // @48
+    uint32_t dropped;                   // @56
+    uint8_t  complete;                  // @60
+    uint8_t  reserved_a[3];             // @61
+    uint64_t digest;                    // @64
+    uint64_t excluded_direct_count;     // @72
+    uint64_t excluded_warmup_count;     // @80
+    uint64_t pending_unconsumed_count;  // @88
+    uint64_t invalid_count;             // @96
+    uint8_t  reserved_b[24];            // @104
+};
+struct GeRecMirror {
+    uint64_t boundary_seq;        // @0
+    uint16_t layer;               // @8
+    uint8_t  router_path;         // @10
+    uint8_t  flags;               // @11
+    uint32_t occurrence;          // @12
+    uint64_t delta_tail_gpu_ns;   // @16
+    uint64_t sync_return_qpc;     // @24
+    uint64_t a1_qpc;              // @32
+    uint64_t graph_uid;           // @40
+    uint8_t  reserved[16];        // @48
+};
+#pragma pack(pop)
+static_assert(sizeof(GeHdrMirror) == GGML_MOE_GPUEARLY_HDR_BYTES, "gpuearly 헤더는 128B 고정");
+static_assert(sizeof(GeRecMirror) == GGML_MOE_GPUEARLY_REC_BYTES, "gpuearly 레코드는 64B 고정");
+static_assert(offsetof(GeHdrMirror, qpc_frequency)            ==  24, "GeHdrMirror.qpc_frequency @24");
+static_assert(offsetof(GeHdrMirror, boot_id)                  ==  32, "GeHdrMirror.boot_id @32");
+static_assert(offsetof(GeHdrMirror, record_count)             ==  48, "GeHdrMirror.record_count @48");
+static_assert(offsetof(GeHdrMirror, dropped)                  ==  56, "GeHdrMirror.dropped @56");
+static_assert(offsetof(GeHdrMirror, complete)                 ==  60, "GeHdrMirror.complete @60");
+static_assert(offsetof(GeHdrMirror, digest)                   ==  64, "GeHdrMirror.digest @64");
+static_assert(offsetof(GeHdrMirror, excluded_direct_count)    ==  72, "GeHdrMirror.excluded_direct @72");
+static_assert(offsetof(GeHdrMirror, excluded_warmup_count)    ==  80, "GeHdrMirror.excluded_warmup @80");
+static_assert(offsetof(GeHdrMirror, pending_unconsumed_count) ==  88, "GeHdrMirror.pending_unconsumed @88");
+static_assert(offsetof(GeHdrMirror, invalid_count)            ==  96, "GeHdrMirror.invalid_count @96");
+static_assert(offsetof(GeRecMirror, layer)             ==  8, "GeRecMirror.layer @8");
+static_assert(offsetof(GeRecMirror, router_path)       == 10, "GeRecMirror.router_path @10");
+static_assert(offsetof(GeRecMirror, flags)             == 11, "GeRecMirror.flags @11");
+static_assert(offsetof(GeRecMirror, occurrence)        == 12, "GeRecMirror.occurrence @12");
+static_assert(offsetof(GeRecMirror, delta_tail_gpu_ns) == 16, "GeRecMirror.delta_tail_gpu_ns @16");
+static_assert(offsetof(GeRecMirror, sync_return_qpc)   == 24, "GeRecMirror.sync_return_qpc @24");
+static_assert(offsetof(GeRecMirror, a1_qpc)            == 32, "GeRecMirror.a1_qpc @32");
+static_assert(offsetof(GeRecMirror, graph_uid)         == 40, "GeRecMirror.graph_uid @40");
+static_assert(offsetof(GeRecMirror, reserved)          == 48, "GeRecMirror.reserved @48");
+
+struct GeFile {
+    bool        ok = false;
+    std::string why;
+    GeHdrMirror h{};
+    std::vector<uint8_t> payload;
+};
+
+// 사이드카를 읽고 magic·크기등식·payload digest 를 검증한다(lt_read 관례와 동형).
+static GeFile ge_read(const std::wstring & path) {
+    GeFile f;
+    std::ifstream in(path, std::ios::binary);
+    if (!in) { f.why = "open failed"; return f; }
+    std::vector<uint8_t> blob((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    if (blob.size() < sizeof(GeHdrMirror)) { f.why = "shorter than header"; return f; }
+    if (std::memcmp(blob.data(), "MOEGPUC1", 8) != 0) { f.why = "magic"; return f; }
+    std::memcpy(&f.h, blob.data(), sizeof(f.h));
+    if (f.h.header_size != sizeof(GeHdrMirror) || f.h.record_size != sizeof(GeRecMirror)) {
+        f.why = "declared sizes"; return f;
+    }
+    if (blob.size() != sizeof(GeHdrMirror) + f.h.record_count * f.h.record_size) {
+        f.why = "size equation"; return f;
+    }
+    f.payload.assign(blob.begin() + (std::ptrdiff_t) sizeof(GeHdrMirror), blob.end());
+    if (sh_fnv1a64(f.payload.data(), f.payload.size()) != f.h.digest) {
+        f.why = "payload digest"; return f;
+    }
+    f.ok = true;
+    return f;
+}
+
+// 물리층 결산 파생식(사양 §3): eligible = record_count − invalid − direct − warmup.
+// ★헤더에 필드를 두지 않는 것이 계약이므로(파생값 수기 금지) 판독기와 이 하네스가 **같은 식**을
+//   각자 계산해 대조한다. 헤더에 있었다면 이 검사는 그저 사본 대조가 되어 의미가 약해진다.
+static uint64_t ge_eligible(const GeHdrMirror & h) {
+    const uint64_t excluded = h.invalid_count + h.excluded_direct_count + h.excluded_warmup_count;
+    return h.record_count >= excluded ? (h.record_count - excluded) : UINT64_MAX;
+}
