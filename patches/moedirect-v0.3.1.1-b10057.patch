+// ===========================================================================
+// V3PRODM — ★원자 B: `v3prod_seal` 다중 shard·형상 소비자 확장의 관문
+//
+// ★무엇이 공백이었나: `v3prod_seal()` 은 요약의 `shards[0]` **단일 shard 만** 읽고 source 1개를
+//   고정 전달해서, 생산 경로로 **n_shards≥2 형상을 세울 수 없었다**. 확장된 생성기가 내는
+//   `--shards/--shard-by-layer/--quant/--tail-tensor` 도 소비자가 안 썼다.
+//
+// ★이 그룹의 주장 5(에코만 보지 않는다):
+//   ①seal rc=0 + stage==12(V3_STAGE_SEALED) ②산출 **manifest 직독**으로 `source_index` 실집합=={0,1}
+//   ③각 shard 에서 routed tensor ≥1(등록 루프가 "몇 번 shard 에서 찾았는가"를 집계) ④비4K arm 의
+//   실제 layout 에 `aligned=false` 존재 ⑤**바이트 parity = 원본 GGUF 직독 대조**.
+//   ★⑤의 oracle 은 신설이다 — 기존 `v3_verify_ptr_bytes()` 는 리시버가 `V3Fixture` 이고 기대값을
+//   C++ `bin_hash` 로 **재생성**하는데, 생산 GGUF 내용은 생성기(Python)가 채운 것이라 그 기대값이
+//   서지 않는다. 기대값을 짓지 말고 **원본 파일의 그 자리를 읽어** 비교한다.
+// ===========================================================================
+
+// 원본 shard GGUF 의 `abs_offset + expert*slice_bytes` 를 직접 읽어 live 포인터 전장과 대조한다.
+// ★초안 C 의 선행 조건 2(payload oracle)와 **같은 물건**이라 arm 안에 묻지 않고 함수로 뗀다 —
+//   C1 이 이걸 재사용한다(두 벌로 만들지 않는다).
+static bool v3prod_parity_vs_source(const std::string & shard_u8, uint64_t abs_offset,
+                                    uint64_t slice_bytes, int32_t expert,
+                                    const uint8_t * live, std::string & why) {
+    if (!live) { why = "ptr null"; return false; }
+    const std::wstring w = utf8_to_wide(shard_u8);
+    HANDLE h = CreateFileW(w.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+                           FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (h == INVALID_HANDLE_VALUE) { why = "source open failed"; return false; }
+    std::vector<uint8_t> buf((size_t)slice_bytes);
+    LARGE_INTEGER li{};
+    li.QuadPart = (LONGLONG)(abs_offset + (uint64_t)expert * slice_bytes);
+    bool ok = SetFilePointerEx(h, li, nullptr, FILE_BEGIN) != 0;
+    DWORD got = 0;
+    if (ok) ok = (ReadFile(h, buf.data(), (DWORD)slice_bytes, &got, nullptr) != 0) &&
+                 (uint64_t)got == slice_bytes;
+    CloseHandle(h);
+    if (!ok) { why = "source read failed"; return false; }
+    for (uint64_t j = 0; j < slice_bytes; j++) {
+        if (buf[(size_t)j] != live[j]) {
+            why = "byte mismatch at +" + std::to_string(j);
+            return false;
+        }
+    }
+    return true;
+}
+
+// 산출 manifest 의 part 1건(직독 결과 — 하네스가 산술을 재구현하지 않는다).
+struct V3ProdPart {
+    int32_t     source_index = -1;
+    uint64_t    abs_offset = 0, slice_bytes = 0;
+    bool        aligned = false;
+    int32_t     layer = -1;
+    std::string source_tensor;
+};
+
+// ★요약 echo 가 아니라 **생산된 manifest.json 자체**를 읽는다.
+static bool v3prodm_read_parts(const V3ProdArm & a, std::vector<V3ProdPart> & out, std::string & why) {
+    json mf;
+    {
+        std::ifstream ifs(a.out + L"\\manifest.json", std::ios::binary);
+        if (!ifs.good()) { why = "manifest missing"; return false; }
+        try { ifs >> mf; } catch (...) { why = "manifest parse"; return false; }
+    }
+    if (!mf.contains("layout") || !mf["layout"].contains("layers")) { why = "layout absent"; return false; }
+    for (const auto & L : mf["layout"]["layers"]) {
+        for (const auto & p : L["parts"]) {
+            V3ProdPart v;
+            v.layer         = L["layer"].get<int32_t>();
+            v.source_index  = p["source_index"].get<int32_t>();
+            v.abs_offset    = p["abs_offset"].get<uint64_t>();
+            v.slice_bytes   = p["slice_bytes"].get<uint64_t>();
+            v.aligned       = p["aligned"].get<bool>();
+            v.source_tensor = p["source_tensor"].get<std::string>();
+            out.push_back(v);
+        }
+    }
+    if (out.empty()) { why = "no parts"; return false; }
+    return true;
+}
+
+// 지정 part 1건을 acquire → ptr → 원본 직독 대조 → release.
+static bool v3prodm_parity_one(V3ProdArm & a, const V3ProdPart & p, int32_t expert, std::string & why) {
+    if (p.source_index < 0 || (size_t)p.source_index >= a.gctxs.size()) { why = "source_index 범위 밖"; return false; }
+    ggml_tensor * t = ggml_get_tensor(a.gctxs[(size_t)p.source_index], p.source_tensor.c_str());
+    if (!t) { why = "tensor 미발견: " + p.source_tensor; return false; }
+    int32_t ids[1] = { expert };
+    const int arc = ggml_moe_direct_acquire(t, ids, 1, /*n_tokens_hint=*/1);
+    if (arc != 0) { why = "acquire rc=" + std::to_string(arc); return false; }
+    const uint8_t * live = (const uint8_t *)ggml_moe_direct_ptr(t, expert);
+    const bool ok = v3prod_parity_vs_source(a.shard_paths[(size_t)p.source_index],
+                                            p.abs_offset, p.slice_bytes, expert, live, why);
+    ggml_moe_direct_release(t, ids, 1);
+    return ok;
+}
