+// ── P3. join·multiplicity + used_join + ★join last_used LRU 회귀(R1 (a) 선행 의무) ────────
+static void test_pb_join_last_used() {
+    section("P3. ★in-flight join(C2) — multiplicity·used_join·ever_joined + ★join last_used 슬롯 재반영(R1 (a))");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_join");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P3a. seal 성공")) return;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+
+    // 층 1의 expert 1..7 상주(결정론적 사전 처분) → rank0(expert 0)만 후보.
+    std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+    ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+    ggml_moe_direct_release(g1, pre.data(), 7);
+
+    // ★논리 tick을 먼저 올려 둔다(= join tick이 claim tick보다 확실히 커지도록).
+    //   ★회수 보류 중에는 demand가 완료될 수 없으므로 반드시 hold 이전에 수행한다.
+    int32_t bump[2] = { 0, 1 };
+    ggml_moe_direct_acquire(g0, bump, 2, 1);
+    ggml_moe_direct_release(g0, bump, 2);
+
+    // ★in-flight 고정 — 회수를 보류해 "완료 전 창"을 결정론적으로 확보한다.
+    ggml_moe_direct_test_hold_retire(1);
+    std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+    ggml_moe_phaseb_test_push_intent(0, 0, 0, /*src=*/0, /*tgt=*/1, ids.data(), (int32_t)ids.size());
+    // dispatcher가 admission을 돌도록 command 왕복 몇 번.
+    uint64_t issued = 0;
+    for (int i = 0; i < 400 && issued == 0; i++) {
+        int32_t leased = 0; int64_t total = 0;
+        ggml_moe_direct_test_lease_stats(&leased, &total);
+        issued = ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED);
+        if (issued == 0) Sleep(1);
+    }
+    check(issued == 1, "P3b. prefetch 1건 제출(in-flight 고정 · issued=" + std::to_string(issued) + ")");
+
+    // ★in-flight prefetch에 demand join(중복 id 2회 = multiplicity 2). 별도 스레드에서 블록.
+    const uint64_t uj0 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN);
+    std::atomic<int> arc{-99};
+    int32_t join_ids[2] = { 0, 0 };
+    std::thread th([&]() { arc.store(ggml_moe_direct_acquire(g1, join_ids, 2, 1)); });
+    // join이 성립할 때까지(used_join 래치) 기다린 뒤 회수를 재개한다.
+    uint64_t uj1 = uj0;
+    for (int i = 0; i < 400 && uj1 == uj0; i++) { Sleep(1); uj1 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN); }
+    ggml_moe_direct_test_hold_retire(0);
+    th.join();
+
+    const uint64_t rec = (uint64_t)1 * PB_TEST_N_EXPERT + 0;
+    int32_t slot = -1; uint64_t gen = 0;
+    ggml_moe_direct_test_record_slot((int64_t)rec, &slot, &gen);
+    int64_t owner = -1; uint64_t last_used = 0, sgen = 0; int32_t lease = 0;
+    if (slot >= 0) ggml_moe_direct_test_slot_state(slot, &owner, &last_used, &sgen, &lease);
+    // 층 0 bump의 tick(2건)보다 join tick이 커야 한다 — bump 슬롯의 last_used와 비교.
+    int32_t bslot = -1; uint64_t bgen = 0;
+    ggml_moe_direct_test_record_slot(1, &bslot, &bgen);   // L0 e1
+    int64_t bowner = -1; uint64_t blast = 0, bsg = 0; int32_t blease = 0;
+    if (bslot >= 0) ggml_moe_direct_test_slot_state(bslot, &bowner, &blast, &bsg, &blease);
+
+    check(arc.load() == 0 && uj1 == uj0 + 1 && lease == 2,
+          "P3c. ★join — multiplicity 2가 성공 terminal에서 1회 반영(lease=" + std::to_string(lease) +
+          ") · used_join +1(첫 join mutation 래치)");
+    check(slot >= 0 && last_used > blast,
+          "P3d. ★★join last_used 슬롯 재반영(R1 (a)) — join이 갱신한 op tick이 슬롯에 반영됨(joined last_used=" +
+          std::to_string(last_used) + " > 직전 demand last_used=" + std::to_string(blast) +
+          ") · 미반영이면 claim 시점 tick에 고정돼 victim 순서가 뒤집힌다");
+
+    const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+    uint64_t n_joined = 0;
+    for (const auto & r : ios) if (r.origin == 1 && (r.flags & 0x08)) n_joined++;
+    check(n_joined == 1, "P3e. ★pb_io ever_joined 래치 1건 = summary pb_used_join(독립 재계산 §9 게이트 7-b)");
+
+    ggml_moe_direct_release(g1, join_ids, 2);
+}
