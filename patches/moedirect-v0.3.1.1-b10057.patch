+// The harness's own clock, in the same units and epoch the engine's deadlines use but read
+// through this translation unit. Every number the budget arms below assert on is measured with
+// this, not reported by the thing under test.
+static int64_t xstore_now_ms() {
+    return (int64_t)std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// E-2a (Codex r2 blocker 2) - the two arms that catch a stop spending its budget more than
+// once. Codex's finding was that XSTORE24/25/44 only ever check the ANCHOR arithmetic: they
+// never drive drain_finish into dispatcher_stop_and_join, which has three waits of its own
+// (the predictor's capture-idle wait, the predictor worker join, the dispatcher join), so the
+// suite stayed green while each of those spent a fresh full copy of the budget.
+//
+// Catching that needs stages that actually block, and a stop whose stages block ends in a
+// timeout - which latches disp_stop_timed_out and g_pb.stop_timed_out, both deliberately
+// process-sticky. So each arm is its own process. Neither aborts: they print what an
+// independent clock measured and exit 0, and the parent asserts on the printed numbers.
+//
+//   predictor  : the worker stays parked for the whole run. The capture-idle wait spends the
+//                budget and the worker join gets what is left, which is nothing.
+//                ONE budget    -> total ~= B, and both stages name the deadline B after t0.
+//                budget/stage  -> total ~= 2B, and the join names a deadline ~2B after t0.
+//   dispatcher : the worker is released D ms in, so the predictor drain SUCCEEDS having spent
+//                D, and the dispatcher join runs with B - D left. The dispatcher is parked in
+//                the stop-race window so that join spends all of it.
+//                ONE budget    -> total ~= B, all three stages name B after t0.
+//                budget/stage  -> total ~= D + B, and the join names ~D + B after t0.
+//
+// Two independent discriminators per arm, then: the elapsed total, and the deadline each stage
+// measured against expressed relative to the caller's own t0. Neither is echoed back from the
+// engine's own arithmetic - t0 is read here, and B is the contract constant this child chose.
+static int run_xstore_budget_child(const char * mode) {
+    // Named explicitly, both of them, like the fatal arms: an unrecognised mode must be an
+    // error rather than "whichever branch the ternary falls through to", or a typo in the
+    // parent quietly runs the wrong arm and the gate reports on a measurement nobody asked for.
+    const bool is_disp = (std::strcmp(mode, "dispatcher") == 0);
+    const bool is_pred = (std::strcmp(mode, "predictor")  == 0);
+    if (!is_disp && !is_pred) {
+        fprintf(stderr, "xstore-budget-child: unknown mode %s\n", mode);
+        return 77;
+    }
+    const int32_t budget_ms  = is_disp ? 1200 : 700;
+    const int32_t release_ms = 700;                       // `dispatcher` arm only
+
+    init_scratch_root();
+    // Prefetch ON is what starts the predictor worker at seal; persistent is what starts the
+    // dispatcher. Both are leaked on purpose - the process is about to end.
+    PbEnv * pbenv = new PbEnv("4", "8", "2", "trace", nullptr, nullptr);
+    (void)pbenv;
+    Fixture * fx = new Fixture();
+    const std::string tag = std::string("xstore_budget_") + mode;
+    pb_setup_2layer(*fx, tag.c_str());
+    if (fx->seal((uint64_t)PB_TEST_N_EXPERT * fx->comp.slot_stride_max, 64) != 0) {
+        fprintf(stderr, "xstore-budget-child(%s): seal failed\n", mode);
+        return 77;
+    }
+    int32_t worker_running = 0;
+    ggml_moe_phaseb_test_counts(nullptr, nullptr, nullptr, nullptr, nullptr, &worker_running);
+    if (!worker_running) {
+        fprintf(stderr, "xstore-budget-child(%s): the predictor worker did not start, so the "
+                        "drain would skip both of its stages and the timing below would mean "
+                        "nothing\n", mode);
+        return 78;
+    }
+    // Warm the dispatcher the way P24 does before arming its barrier, and leave the ledger at
+    // zero: this pair grants and returns the same units, so the drain still sees nothing out.
+    ggml_tensor * g0 = fx->find("blk.0.ffn_gate_exps.weight");
+    if (!g0) { fprintf(stderr, "xstore-budget-child(%s): tensor lookup failed\n", mode); return 77; }
+    int32_t warm[2] = { 0, 1 };
+    if (ggml_moe_direct_acquire(g0, warm, 2, 1) == 0) ggml_moe_direct_release(g0, warm, 2);
+
+    std::vector<float> w0, w1, rt1, x((size_t)PB_TEST_N_EMBD);
+    pb_fill_snapshot(PB_TEST_N_EMBD, PB_TEST_N_EXPERT, 20260822, w0, w1, rt1);
+    std::mt19937 rng(7);
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (auto & v : x) v = ud(rng);
+
+    // Arm first, then let one REAL capture carry the worker into the park. From here the
+    // drain's idle wait sees a genuinely busy worker and its join sees a thread that will not
+    // exit - the state a stop is supposed to spend its budget on.
+    if (ggml_moe_phaseb_test_worker_hold_arm() != 0) {
+        fprintf(stderr, "xstore-budget-child(%s): worker hold arm failed\n", mode); return 77;
+    }
+    ggml_moe_phaseb_run_begin();
+    ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);
+    if (ggml_moe_phaseb_capture(0, -1, x.data(), (int32_t)GGML_TYPE_F32,
+                                PB_TEST_N_EMBD, 1, 1, 1) != 1) {
+        fprintf(stderr, "xstore-budget-child(%s): the capture was not enqueued\n", mode);
+        return 78;
+    }
+    if (ggml_moe_phaseb_test_worker_hold_wait(5000) != 0) {
+        fprintf(stderr, "xstore-budget-child(%s): the worker never reached the park, so no "
+                        "stage would block and the measurement would be vacuous\n", mode);
+        return 78;
+    }
+    if (is_disp) {
+        // Park the dispatcher too, so the LAST stage of the chain also spends its whole
+        // allowance. Without it that join returns at once and the handoff from the predictor
+        // drain into it is never measured - which is the half XSTORE44 could not reach.
+        if (ggml_moe_direct_test_stop_race_arm(5000) != 0) {
+            fprintf(stderr, "xstore-budget-child(dispatcher): the dispatcher never reached the "
+                            "stop-race window\n");
+            ggml_moe_phaseb_test_worker_hold_release();
+            return 78;
+        }
+    }
+    // t0 is read HERE, by the caller, one line before the anchor is taken. Everything the
+    // parent asserts on is expressed against it, so no number below comes from the arithmetic
+    // under test.
+    const int64_t t0 = xstore_now_ms();
+    if (ggml_moe_store_drain_begin() != 0) {
+        fprintf(stderr, "xstore-budget-child(%s): drain_begin refused\n", mode);
+        ggml_moe_phaseb_test_worker_hold_release();
+        return 77;
+    }
+    int64_t adm = -1, units = -1;
+    (void)ggml_moe_direct_test_xstore_drain_zero_ready(&adm, &units);
+    if (adm != 0 || units != 0) {
+        fprintf(stderr, "xstore-budget-child(%s): leases were still out at drain_begin "
+                        "(admissions=%lld units=%lld), so the drain would fatal on the residue "
+                        "before it ever reached the stop\n",
+                mode, (long long)adm, (long long)units);
+        ggml_moe_phaseb_test_worker_hold_release();
+        return 78;
+    }
+    if (is_disp) {
+        // Free the worker part-way in, so the predictor drain SUCCEEDS having spent
+        // release_ms, and the dispatcher join below runs on the remainder.
+        std::thread rel([release_ms]() {
+            Sleep((DWORD)release_ms);
+            ggml_moe_phaseb_test_worker_hold_release();
+        });
+        rel.detach();
+    }
+    const int     rc = ggml_moe_store_drain_finish(budget_ms);
+    const int64_t total = xstore_now_ms() - t0;
+
+    int64_t pdl[2]   = { -1, -1 };
+    int32_t pleft[2] = { -1, -1 };
+    const int pn = ggml_moe_phaseb_test_drain_stages(pdl, pleft, 2);
+    int64_t ddl   = -1;
+    int32_t dleft = -1;
+    const int dn = ggml_moe_direct_test_stop_join_stage(&ddl, &dleft);
+    const int safety = ggml_moe_phaseb_test_worker_hold_safety_fired();
+
+    // Deadlines are printed RELATIVE to the caller's t0. One budget means all entered stages
+    // report about `budget_ms`; a budget re-derived per stage reports budget + however long
+    // the stages before it ran.
+    // The keys carry an `xsb_` prefix so the parent's scraper cannot land on some other line
+    // of engine logging that happens to contain the same word.
+    fprintf(stderr, "xstore-budget-child: mode=%s xsb_budget=%d xsb_total=%lld xsb_rc=%d "
+                    "xsb_pn=%d xsb_dn=%d xsb_safety=%d\n",
+            mode, (int)budget_ms, (long long)total, rc, pn, dn, safety);
+    fprintf(stderr, "xstore-budget-child: xsb_rel0=%lld xsb_rel1=%lld xsb_rel2=%lld "
+                    "xsb_left0=%d xsb_left1=%d xsb_left2=%d\n",
+            (long long)(pn > 0 ? pdl[0] - t0 : -1),
+            (long long)(pn > 1 ? pdl[1] - t0 : -1),
+            (long long)(dn > 0 ? ddl    - t0 : -1),
+            (int)(pn > 0 ? pleft[0] : -1), (int)(pn > 1 ? pleft[1] : -1),
+            (int)(dn > 0 ? dleft : -1));
+    fflush(stderr);
+    // XSTORE49 adjudication r1 (Codex, 26-08-26): the measurements above are complete and
+    // flushed, and the budget-exhausted arm deliberately leaves the predictor worker (and on
+    // the dispatcher arm, the dispatcher) parked/alive - the old tail released the park and
+    // walked the normal C++ shutdown, racing those live engine threads against process
+    // teardown (ExitProcess stops the other threads mid-instruction, then runs DLL detach),
+    // which is the 0xC0000005 this child intermittently died with AFTER printing correct
+    // numbers (occurrence 1 = main issue 6, occurrence 2 = companion M-P; two-strike rule).
+    // So: wake NOTHING, and skip executable/CRT/DLL cleanup entirely. TerminateProcess on the
+    // own process does not return on success and stops every thread where it stands; a parked
+    // thread is quiescent, which is the safest state to be stopped in.
+    TerminateProcess(GetCurrentProcess(), 0);
+    // Not reached on success. If the call itself failed, exiting 0 here would forge the very
+    // signal the parent asserts on (measurements then exit 0) - so fail loudly instead.
+    fprintf(stderr, "xstore-budget-child(%s): TerminateProcess returned unexpectedly\n", mode);
+    fflush(stderr);
+    return 79;
+}
+
+// Spawn one child mode. `capture`, when given, receives the child's stdout+stderr, which is
+// how the drain gate reads the inventory the abort printed on its way out. `flag` selects the
+// child family: the fatal arms take the default, and the E-2a budget arms take
+// --xstore-budget-test, which exits normally and prints measurements instead of aborting.
+static bool xstore_run_child(const char * mode, DWORD * out_exit, std::string * capture,
+                             const char * flag = "--xstore-fatal-test") {
+    wchar_t exe[MAX_PATH];
+    const DWORD n = GetModuleFileNameW(nullptr, exe, MAX_PATH);
+    if (n == 0 || n >= MAX_PATH) return false;
+    std::wstring cmd = L"\"" + std::wstring(exe) + L"\" " + utf8_to_wide(flag) + L" " +
+                       utf8_to_wide(mode);
+    std::vector<wchar_t> cb(cmd.begin(), cmd.end()); cb.push_back(L'\0');
+    STARTUPINFOW si; ZeroMemory(&si, sizeof(si)); si.cb = sizeof(si);
+    PROCESS_INFORMATION pi; ZeroMemory(&pi, sizeof(pi));
+    HANDLE hcap = INVALID_HANDLE_VALUE;
+    std::wstring cap_path;
+    if (capture) {
+        cap_path = make_case_dir(std::string("xstore_cap_") + mode) + L"\\child.txt";
+        SECURITY_ATTRIBUTES sa; ZeroMemory(&sa, sizeof(sa));
+        sa.nLength = sizeof(sa); sa.bInheritHandle = TRUE;
+        hcap = CreateFileW(cap_path.c_str(), GENERIC_WRITE,
+                           FILE_SHARE_READ | FILE_SHARE_WRITE, &sa,
+                           CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (hcap == INVALID_HANDLE_VALUE) return false;
+        si.dwFlags   |= STARTF_USESTDHANDLES;
+        si.hStdInput  = nullptr;
+        si.hStdOutput = hcap;
+        si.hStdError  = hcap;
+    }
+    const BOOL ok = CreateProcessW(exe, cb.data(), nullptr, nullptr,
+                                   capture ? TRUE : FALSE, 0, nullptr, nullptr, &si, &pi);
+    if (!ok) {
+        if (hcap != INVALID_HANDLE_VALUE) CloseHandle(hcap);
+        return false;
+    }
+    const DWORD wr = WaitForSingleObject(pi.hProcess, 120000);
+    // E-2b-1: a child that did NOT signal has to be reclaimed here. The states this timeout
+    // reports are exactly the states where a child is wedged - a hold that never released, a
+    // graph thread that never joined - so returning while it still runs would leave an orphan
+    // holding scratch, CPU and (for the graph arms) a whole thread pool, and the run's
+    // "every join closed" claim would be about the parent only. Terminate, then wait a bounded
+    // time for the kernel to finish tearing it down, and only then drop the handles.
+    bool reclaimed = true;
+    if (wr != WAIT_OBJECT_0) {
+        // Both calls are checked. Neither result PROVES the child is gone - TerminateProcess
+        // is asynchronous and a wait can time out on a process stuck in a kernel transition -
+        // but a failure here is the difference between "reclaimed" and "we asked and never
+        // looked", and the caller reports the weaker of the two.
+        const BOOL killed = TerminateProcess(pi.hProcess, 0xDEAD0001u);
+        const DWORD wr2   = WaitForSingleObject(pi.hProcess, 15000);
+        reclaimed = (killed != 0) && (wr2 == WAIT_OBJECT_0);
+    }
+    DWORD ec = 0;
+    const BOOL got = GetExitCodeProcess(pi.hProcess, &ec);
+    CloseHandle(pi.hProcess); CloseHandle(pi.hThread);
+    if (hcap != INVALID_HANDLE_VALUE) CloseHandle(hcap);
+    if (capture) {
+        std::ifstream ifs(cap_path, std::ios::binary);
+        std::string line;
+        capture->clear();
+        while (std::getline(ifs, line)) { *capture += line; *capture += "\n"; }
+    }
+    if (out_exit) *out_exit = ec;
+    return wr == WAIT_OBJECT_0 && got != 0 && reclaimed;
+}
+
+// GGML_ABORT lands on the MSVC fail-fast path, so the abort exit code is
+// STATUS_STACK_BUFFER_OVERRUN. The V3e5 death test already pins this exact value; the same
+// exactness matters here, because "died somehow" would also pass for an access violation.
+static const DWORD kXstoreAbortExit = 0xC0000409u;
+
+// Pull the integer that follows `key` out of a captured child log, or `missing` when the key
+// is not there at all. strtoll rather than the scanf family: MSVC deprecates scanf and the
+// standing build gate is warning 0.
+static long long xstore_scrape_int(const std::string & hay, const char * key,
+                                   long long missing) {
+    const size_t at = hay.find(key);
+    if (at == std::string::npos) return missing;
+    const char * p   = hay.c_str() + at + std::strlen(key);
+    char *       end = nullptr;
+    const long long v = std::strtoll(p, &end, 10);
+    if (end == p) return missing;
+    return v;
+}
