+constexpr uint16_t PA_NA_U16  = 0xFFFFu;
+constexpr uint32_t PA_NA_U32  = 0xFFFFFFFFu;
+constexpr int32_t  PA_PRED_K  = 16;     // top-16 저장(앞 8 = @8)
