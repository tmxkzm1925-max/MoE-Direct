+// ===========================================================================
+// XGEN - the generation-space exhaustion guard (GENGUARD atom).
+//   spec: bench/techdev/repack_space/GENGUARD_ATOM_SPEC.md v0.4 sections B, C-5.
+//   Exact delta = +3 (XGEN01..XGEN03, no gaps, no duplicates).
+//
+// handle = (gen << 16) | (index + 1), so a mint keeps only the low 48 bits of a generation the
+// entry stores whole. Past 2^48 every handle this module hands out fails its own lookup. The
+// guard refuses at the mint, where the cause is, and this group is its runtime witness: the
+// counter cannot be walked to the boundary (2^48 acquires), so a test-only seam arms it to the
+// last usable generation and the two halves of the claim are put in fresh child processes.
+//
+// Children, not in-process arms: gen_next is process-monotone ON PURPOSE - reset_for_test does
+// not roll it back - so spending the last generation inside the suite would take every group
+// registered after this one down with it.
+//
+// This parent asserts only what a parent can see: that the child was reclaimed, its exit code,
+// and its captured output. Whether the acquire/view/release inside the child succeeded is the
+// child's own verdict, spoken as exit 0.
+// ===========================================================================
+static void test_xgen_genguard() {
+    section("XGEN. gen == 2^48 - the mint refuses at the boundary and names the cause, instead "
+            "of returning handles that cannot be looked up");
+    {
+        DWORD ec = 0;
+        const bool ran = xstore_run_child("genlast", &ec, nullptr);
+        char b[16]; snprintf(b, sizeof(b), "%08lX", (unsigned long)ec);
+        check(ran && ec == 0,
+              "XGEN01. the guard is not over-broad: with the counter armed to the LAST "
+              "generation the encoding can carry, a full acquire/view/release still goes "
+              "through and the child exits 0. A guard that refused here would be one mint "
+              "early, and no exhaustion test would notice [ran=" + std::to_string((int)ran) +
+              " exit=0x" + std::string(b) + "]");
+    }
+    {
+        DWORD ec = 0;
+        std::string cap;
+        const bool ran = xstore_run_child("genexh", &ec, &cap);
+        char b[16]; snprintf(b, sizeof(b), "%08lX", (unsigned long)ec);
+        check(ran && ec == kXstoreAbortExit,
+              "XGEN02. and it does fire at the boundary: once the last generation has been "
+              "spent, the next mint aborts on the GGML_ABORT path (0xC0000409) rather than "
+              "returning a handle whose generation the encoding has already truncated [ran=" +
+              std::to_string((int)ran) + " exit=0x" + std::string(b) + "]");
+        // The atom's actual value is the DIAGNOSIS, so it is asserted rather than assumed:
+        // the capture has to carry the mint's own sentence and not the consumer's, which is
+        // where this state used to land.
+        const bool named    = cap.find("generation space exhausted") != std::string::npos;
+        const bool consumer = cap.find("stale, released or fabricated handle") !=
+                              std::string::npos;
+        check(named && !consumer,
+              "XGEN03. and it says why: the captured output names the exhausted generation "
+              "space at the mint, and does NOT carry the consumer's \"stale, released or "
+              "fabricated handle\" - the message this failure used to die with, one call "
+              "later and with the cause missing [named=" + std::to_string((int)named) +
+              " consumer_msg=" + std::to_string((int)consumer) + " bytes=" +
+              std::to_string((int)cap.size()) + "]");
+    }
+}
