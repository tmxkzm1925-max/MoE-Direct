+// ---- a bin fixture (no graph) carrying both stride forms in one layer ------------------
+static int xcpu_seal_shapes(Fixture & fx, const char * tag) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "synth";
+    fx.model.n_expert = XCPU_S_NEXPERT; fx.model.n_expert_used = XCPU_S_NUSED;
+    fx.model.n_layer = 1;
+    fx.model.sources = { default_source() };
+    SynthLayer L; L.layer = 0;
+    SynthPart w; w.name = "gate.weight"; w.source_tensor = "blk.0.ffn_gate_exps.weight";
+    w.source_index = 0; w.type = "F32";
+    w.dims = { XCPU_S_K, XCPU_S_M, XCPU_S_NEXPERT }; w.is_host = true;
+    SynthPart b; b.name = "gate.bias";   b.source_tensor = "blk.0.ffn_gate_exps.bias";
+    b.source_index = 0; b.type = "F32";
+    b.dims = { XCPU_S_NEMBD, XCPU_S_NEXPERT }; b.is_host = true;
+    L.parts = { w, b };
+    fx.model.layers = { L };
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.build();
+    return fx.seal((uint64_t) XCPU_S_NEXPERT * fx.comp.slot_stride_max, 64);
+}
+
+static bool xcpu_axes_zero() {
+    int64_t h = -1, u = -1, s = -1;
+    ggml_moe_store_outstanding(&h, &u, &s);
+    return h == 0 && u == 0 && s == 0;
+}
+
+static std::string xcpu_axes_text() {
+    int64_t h = -1, u = -1, s = -1;
+    ggml_moe_store_outstanding(&h, &u, &s);
+    return "h=" + std::to_string(h) + " u=" + std::to_string(u) + " slots=" + std::to_string(s);
+}
+
+// ===========================================================================
+// backend / graph helpers shared by the parent block and the three child arms
+// ===========================================================================
+typedef struct ggml_threadpool * (*xcpu_threadpool_new_t)(struct ggml_threadpool_params *);
+typedef void (*xcpu_cpu_set_threadpool_t)(ggml_backend_t, struct ggml_threadpool *);
+
+// The three proc addresses D7 (i) requires. selftest does NOT link the CPU backend (this is a
+// GGML_BACKEND_DL build - section G-M item 3), so a threadpool is reachable only this way and
+// a missing one is RED rather than a skip.
+struct XcpuBackend {
+    ggml_backend_t               backend = nullptr;
+    ggml_backend_set_n_threads_t set_n   = nullptr;
+    xcpu_threadpool_new_t        tp_new  = nullptr;
+    xcpu_cpu_set_threadpool_t    tp_set  = nullptr;
+    struct ggml_threadpool *     pool    = nullptr;
+    bool                         ok      = false;
+};
+
+static void xcpu_open_backend(XcpuBackend & be, int32_t n_threads) {
+    ggml_backend_load_all();
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (!dev) return;
+    be.backend = ggml_backend_dev_init(dev, nullptr);
+    if (!be.backend) return;
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    be.set_n  = (ggml_backend_set_n_threads_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+    be.tp_new = (xcpu_threadpool_new_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_threadpool_new");
+    be.tp_set = (xcpu_cpu_set_threadpool_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool");
+    if (!be.set_n || !be.tp_new || !be.tp_set) return;
+    struct ggml_threadpool_params tpp = ggml_threadpool_params_default((int) n_threads);
+    be.pool = be.tp_new(&tpp);
+    if (!be.pool) return;
+    be.tp_set(be.backend, be.pool);
+    be.set_n(be.backend, (int) n_threads);
+    be.ok = true;
+}
+
+// The threads this process owns. The OS witness is the SECOND opinion (D7 (3)); the first is
+// nth_observed, derived from O5.
+// Our own live thread count. The quantity is the same one the thread-walk produced - the
+// number of threads the OS currently attributes to THIS process - but it is read from the
+// process snapshot's cntThreads instead of by enumerating every thread on the system.
+//
+// Why it moved (round 11, measured - this is the second time an assumed cost here was wrong):
+// TH32CS_SNAPTHREAD captures every thread on the machine (~4,500 here) before the walk even
+// starts, and the capture is the cost. Measured on this host with a ctypes probe, median of
+// 15 calls:
+//                       idle          under 8-way CPU load
+//   TH32CS_SNAPTHREAD   59.4 ms       46.4 ms
+//   TH32CS_SNAPPROCESS  30.6 ms       21.9 ms
+// and the in-process sampler measured its own THREAD-snapshot calls at 74-92 ms during a
+// live window. A sampler whose single reading costs tens of milliseconds cannot hold a 5 ms
+// cadence no matter how it is paced, which is why round 11's first two attempts (deadline
+// pacing, then a priority raise) both left samples at 0-3. Round 11 then tried to buy the
+// sample count with window length and could not either - a bigger fixture makes each read
+// MORE expensive, so mmid went 688 ms/21 samples -> 1051 ms/20. That is what retired the
+// sample floor for XCPU13/14 in favour of the single post-join reading; this function is
+// still the cheaper of the two snapshots and still supplies both the polled record and
+// that one reading.
+static int32_t xcpu_thread_count() {
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (snap == INVALID_HANDLE_VALUE) return -1;
+    PROCESSENTRY32 pe; ZeroMemory(&pe, sizeof(pe)); pe.dwSize = sizeof(pe);
+    const DWORD me = GetCurrentProcessId();
+    int32_t n = -1;
+    // A failed Process32First is a FAILED reading, not a reading of zero, and so is a walk
+    // that never finds our own pid. Returning 0 would let a snapshot that never walked
+    // anything sit in the sample set and drag the peak nowhere, which is the quiet kind of
+    // green this gate exists to avoid.
+    if (!Process32First(snap, &pe)) { CloseHandle(snap); return -1; }
+    do {
+        if (pe.dwSize >= FIELD_OFFSET(PROCESSENTRY32, cntThreads) + sizeof(DWORD)
+            && pe.th32ProcessID == me) {
+            n = (int32_t) pe.cntThreads;
+            break;
+        }
+        pe.dwSize = sizeof(pe);
+    } while (Process32Next(snap, &pe));
+    CloseHandle(snap);
+    return n;
+}
+
+// steady_clock, not GetTickCount64. The tick counter advances in 15.6 ms steps on this host,
+// which is coarser than several of the things measured with it: run #2 reported the mul_mat_id
+// wall as "16" and "32" and the add_id wall as "47" and "62" - all of them single ticks apart,
+// none of them a reading. A gate that compares such a value against 100 ms is comparing
+// against a number that cannot distinguish 1 ms from 15. steady_clock is monotonic (so the
+// deadline arithmetic below is unaffected) and resolves to the QPC period.
+static int64_t xcpu_now_ms() {
+    return (int64_t) std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// Walk the ring AFTER every join. write_record_bytes publishes a slot with fetch_add BEFORE
+// it memcpys into it and there is no per-slot commit flag, so a live copy is a partial
+// record (section C-2 A(1)).
+struct XcpuTraceTally {
+    int64_t enter = 0;        // COMPUTE_ENTER with graph_seq == G
+    int64_t o8_all = 0;       // FIRST_ARITH_CONSUME with graph_seq == G
+    int64_t o8_window = 0;    // ... and logical index in [lo, hi)
+};
+
+static XcpuTraceTally xcpu_tally(uint32_t gseq, uint64_t lo, uint64_t hi) {
+    XcpuTraceTally t;
+    const uint64_t n = ggml_moe_trace_event_count();
+    uint8_t buf[64];
+    for (uint64_t i = 0; i < n; i++) {
+        if (!ggml_moe_trace_debug_copy_record(i, buf)) continue;
+        ggml_moe_trace_fixed_record r;
+        std::memcpy(&r, buf, sizeof(r));
+        if (r.type != MOE_TRACE_RT_FIXED) continue;
+        if (r.graph_seq != gseq) continue;
+        if (r.event_kind == MOE_TRACE_EV_COMPUTE_ENTER) {
+            t.enter++;
+        } else if (r.event_kind == MOE_TRACE_EV_FIRST_ARITH_CONSUME) {
+            t.o8_all++;
+            if (i >= lo && i < hi) t.o8_window++;
+        }
+    }
+    return t;
+}
+
+// Advance g_run_decode_graph_idx into the DECODE ring window with EMPTY graph_begin/end
+// pairs. Each pair carries its own graph_seq, so nothing it does collides with the target's
+// dedup state.
+static void xcpu_enter_window(uint16_t run_index, uint32_t already_spent) {
+    for (uint32_t i = already_spent; i < XCPU_DECODE_WIN_BEGIN; i++) {
+        const uint32_t g = XCPU_GSEQ_PAIR0 + i;
+        const uint64_t id = ggml_moe_trace_graph_begin(run_index, g, MOE_TRACE_PHASE_DECODE, 1);
+        ggml_moe_trace_graph_end(id, run_index, g, MOE_TRACE_PHASE_DECODE);
+    }
+}
+
+// mul_mat_id + add_id over one layer's two parts - the shape section F uses, sized by the
+// caller. `direct` decides whether the two weight tensors are named and registered; a STOCK
+// arm gets the payload bytes written into the tensors instead.
+struct XcpuPairGraph {
+    ggml_context * ctx = nullptr;
+    ggml_tensor *  w = nullptr, * b = nullptr;
+    ggml_tensor *  mm_act = nullptr, * ids = nullptr, * mm_out = nullptr;
+    ggml_tensor *  add_act = nullptr, * add_out = nullptr;
+    ggml_cgraph *  graph = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+};
+
+static bool xcpu_build_pair_graph(XcpuPairGraph & g, ggml_backend_t backend, bool direct,
+                                  const XcpuStore & st, int64_t k, int64_t mdim, int64_t nembd,
+                                  int32_t n_token, int32_t n_used,
+                                  const std::vector<int32_t> & ids_vals,
+                                  const std::vector<float> & mm_act,
+                                  const std::vector<float> & add_act) {
+    ggml_init_params p{};
+    p.mem_size = ggml_tensor_overhead() * 24 + ggml_graph_overhead_custom(32, false);
+    p.no_alloc = true;
+    g.ctx = ggml_init(p);
+    if (!g.ctx) return false;
+    g.w       = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, k, mdim, st.n_expert);
+    g.b       = ggml_new_tensor_2d(g.ctx, GGML_TYPE_F32, nembd, st.n_expert);
+    g.mm_act  = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, k, n_used, n_token);
+    g.add_act = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, nembd, n_used, n_token);
+    g.ids     = ggml_new_tensor_2d(g.ctx, GGML_TYPE_I32, n_used, n_token);
+    if (direct) {
+        ggml_set_name(g.w, "blk.0.ffn_gate_exps.weight");
+        ggml_set_name(g.b, "blk.0.ffn_gate_exps.bias");
+    }
+    g.mm_out  = ggml_mul_mat_id(g.ctx, g.w, g.mm_act, g.ids);
+    g.add_out = ggml_add_id(g.ctx, g.add_act, g.b, g.ids);
+    if (direct) {
+        // registration precedes allocation, the order section F's harness uses
+        ggml_moe_direct_register(g.w, "blk.0.ffn_gate_exps.weight", 1);
+        ggml_moe_direct_register(g.b, "blk.0.ffn_gate_exps.bias", 1);
+    }
+    g.buf = ggml_backend_alloc_ctx_tensors(g.ctx, backend);
+    if (!g.buf) return false;
+    if (!direct) {
+        for (int e = 0; e < st.n_expert; e++) {
+            ggml_backend_tensor_set(g.w, st.wpe[(size_t) e].data(), (size_t) e * g.w->nb[2],
+                                    st.wpe[(size_t) e].size());
+            ggml_backend_tensor_set(g.b, st.bpe[(size_t) e].data(), (size_t) e * g.b->nb[1],
+                                    st.bpe[(size_t) e].size());
+        }
+    }
+    ggml_backend_tensor_set(g.ids, ids_vals.data(), 0, ids_vals.size() * 4);
+    ggml_backend_tensor_set(g.mm_act, mm_act.data(), 0, mm_act.size() * 4);
+    ggml_backend_tensor_set(g.add_act, add_act.data(), 0, add_act.size() * 4);
+    g.graph = ggml_new_graph_custom(g.ctx, 32, false);
+    ggml_build_forward_expand(g.graph, g.mm_out);
+    ggml_build_forward_expand(g.graph, g.add_out);
+    return true;
+}
+
+// mul_mat_id alone, one node - the hold and mmid arms (section C-2's fixture table forbids a
+// node repeat there: O8 is claimed once per (graph, layer, part, expert), so repeating the
+// node buys length without buying O8).
+struct XcpuMmGraph {
+    ggml_context * ctx = nullptr;
+    ggml_tensor *  w = nullptr, * act = nullptr, * ids = nullptr, * out = nullptr;
+    // The manifest's OTHER part. It is registered and sealed but never read: see
+    // xcpu_build_mm_graph for why leaving it out makes the seal refuse the whole arm.
+    ggml_tensor *  reg_other = nullptr;
+    ggml_cgraph *  graph = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+};
+
+static bool xcpu_build_mm_graph(XcpuMmGraph & g, ggml_backend_t backend, bool direct,
+                                const XcpuStore & st, int64_t k, int64_t mdim,
+                                int32_t n_token, int32_t n_used,
+                                const std::vector<int32_t> & ids_vals,
+                                const std::vector<float> & act) {
+    ggml_init_params p{};
+    p.mem_size = ggml_tensor_overhead() * 16 + ggml_graph_overhead_custom(16, false);
+    p.no_alloc = true;
+    g.ctx = ggml_init(p);
+    if (!g.ctx) return false;
+    g.w   = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, k, mdim, st.n_expert);
+    g.act = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, k, n_used, n_token);
+    g.ids = ggml_new_tensor_2d(g.ctx, GGML_TYPE_I32, n_used, n_token);
+    if (direct) ggml_set_name(g.w, "blk.0.ffn_gate_exps.weight");
+    g.out = ggml_mul_mat_id(g.ctx, g.w, g.act, g.ids);
+    if (direct) ggml_moe_direct_register(g.w, "blk.0.ffn_gate_exps.weight", 1);
+    // The registration set has to equal the MANIFEST, not the graph. xcpu_make_store always
+    // writes both parts of the layer (gate.weight and gate.bias), and the seal compares the
+    // two sets BOTH ways - L_scope == M_all, ggml-moe-direct.cpp:10380-10400 - so a graph
+    // that consumes only mul_mat_id still owes the bias a registration. Omit it and the seal
+    // returns "L_scope(1) != M_all(2)" and every arm behind it reports stage 94 without ever
+    // running. The shape is read back from the store's own model rather than restated here,
+    // so the tensor the seal size-checks (ne[expert_axis] == n_expert and
+    // ggml_nbytes == part_bytes * n_expert, :10485-10493) cannot drift from the manifest.
+    // The tensor is not in the graph, and it does not need to be: registration is an
+    // obligation to the MANIFEST and has nothing to do with graph membership.
+    // ggml_moe_direct_register only appends to the pending registry
+    // (ggml-moe-direct.cpp:11320); it never inspects a graph. Fixture::build (:468) is the
+    // standing precedent for the resulting state - it creates and registers every manifest
+    // part and the fixture then seals, with no compute graph built at all, which is exactly
+    // what XCPU01-XCPU07 run on.
+    if (direct) {
+        const SynthPart & other = st.model.layers[0].parts[1];
+        g.reg_other = ggml_new_tensor_2d(g.ctx, GGML_TYPE_F32, other.dims[0], other.dims[1]);
+        ggml_set_name(g.reg_other, other.source_tensor.c_str());
+        ggml_moe_direct_register(g.reg_other, other.source_tensor.c_str(), 1);
+    }
+    g.buf = ggml_backend_alloc_ctx_tensors(g.ctx, backend);
+    if (!g.buf) return false;
+    if (!direct) {
+        for (int e = 0; e < st.n_expert; e++) {
+            ggml_backend_tensor_set(g.w, st.wpe[(size_t) e].data(), (size_t) e * g.w->nb[2],
+                                    st.wpe[(size_t) e].size());
+        }
+    }
+    ggml_backend_tensor_set(g.ids, ids_vals.data(), 0, ids_vals.size() * 4);
+    ggml_backend_tensor_set(g.act, act.data(), 0, act.size() * 4);
+    g.graph = ggml_new_graph_custom(g.ctx, 16, false);
+    ggml_build_forward_expand(g.graph, g.out);
+    return true;
+}
+
+// add_id alone, R_node INDEPENDENT nodes over identical inputs. Every output must equal the
+// single-node stock result, which is what keeps the repeat free of meaning drift, and O5 is
+// re-issued per node, which is what buys the wall.
+struct XcpuAddGraph {
+    ggml_context * ctx = nullptr;
+    ggml_tensor *  bias = nullptr, * act = nullptr, * ids = nullptr;
+    // The manifest's OTHER part - same obligation as XcpuMmGraph::reg_other.
+    ggml_tensor *  reg_other = nullptr;
+    std::vector<ggml_tensor *> outs;
+    ggml_cgraph *  graph = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+};
+
+static bool xcpu_build_add_graph(XcpuAddGraph & g, ggml_backend_t backend, bool direct,
+                                 const XcpuStore & st, int64_t nembd,
+                                 int32_t n_token, int32_t n_used, int32_t r_node,
+                                 const std::vector<int32_t> & ids_vals,
+                                 const std::vector<float> & act) {
+    ggml_init_params p{};
+    p.mem_size = ggml_tensor_overhead() * (size_t)(r_node + 16)
+               + ggml_graph_overhead_custom((size_t)(r_node + 16), false);
+    p.no_alloc = true;
+    g.ctx = ggml_init(p);
+    if (!g.ctx) return false;
+    g.bias = ggml_new_tensor_2d(g.ctx, GGML_TYPE_F32, nembd, st.n_expert);
+    g.act  = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, nembd, n_used, n_token);
+    g.ids  = ggml_new_tensor_2d(g.ctx, GGML_TYPE_I32, n_used, n_token);
+    if (direct) ggml_set_name(g.bias, "blk.0.ffn_gate_exps.bias");
+    for (int32_t i = 0; i < r_node; i++) g.outs.push_back(ggml_add_id(g.ctx, g.act, g.bias, g.ids));
+    if (direct) ggml_moe_direct_register(g.bias, "blk.0.ffn_gate_exps.bias", 1);
+    // The weight half of the same manifest - see xcpu_build_mm_graph for the seal's bothway
+    // set comparison. This one is 3-D because the weight part carries the expert axis last.
+    // Registering it here is also what keeps the bias at part index 1: the manifest ordering
+    // {weight, bias} is what XCPU14 asserts against when it claims its captured part differs
+    // from XCPU13's, so the fix must add the missing registration rather than shrink the
+    // manifest to one part.
+    if (direct) {
+        const SynthPart & other = st.model.layers[0].parts[0];
+        g.reg_other = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, other.dims[0], other.dims[1],
+                                         other.dims[2]);
+        ggml_set_name(g.reg_other, other.source_tensor.c_str());
+        ggml_moe_direct_register(g.reg_other, other.source_tensor.c_str(), 1);
+    }
+    g.buf = ggml_backend_alloc_ctx_tensors(g.ctx, backend);
+    if (!g.buf) return false;
+    if (!direct) {
+        for (int e = 0; e < st.n_expert; e++) {
+            ggml_backend_tensor_set(g.bias, st.bpe[(size_t) e].data(), (size_t) e * g.bias->nb[1],
+                                    st.bpe[(size_t) e].size());
+        }
+    }
+    ggml_backend_tensor_set(g.ids, ids_vals.data(), 0, ids_vals.size() * 4);
+    ggml_backend_tensor_set(g.act, act.data(), 0, act.size() * 4);
+    g.graph = ggml_new_graph_custom(g.ctx, (size_t)(r_node + 16), false);
+    for (size_t i = 0; i < g.outs.size(); i++) ggml_build_forward_expand(g.graph, g.outs[i]);
+    return true;
+}
+
+// The Phase A ledger witness for the part the KERNEL passed down (XCPU13/14 (b)).
+static void xcpu_ledger_parts(const std::wstring & path, uint8_t kind, int32_t want,
+                              int64_t * out_match, int64_t * out_other) {
+    int64_t match = 0, other = 0;
+    const PaFile led = pa_read(path);
+    if (led.ok) {
+        const size_t n = (size_t) led.h.record_count;
+        for (size_t i = 0; i < n; i++) {
+            PaLed r{};
+            std::memcpy(&r, led.payload.data() + i * sizeof(PaLed), sizeof(PaLed));
+            if (r.kind != kind) continue;
+            if ((int32_t) r.part == want) match++; else other++;
+        }
+    }
+    if (out_match) *out_match = match;
+    if (out_other) *out_other = other;
+}
+
+// ===========================================================================
+// arm 1: `hold` - section C-2's ten-step protocol
+// ===========================================================================
+static int xcpu_child_hold() {
+    // step 0 - trace PREPARATION only. init() returns 0 even with trace OFF ("off - a no-op
+    // success", ggml-moe-trace.cpp:824-826), so readiness is asserted separately.
+    if (ggml_moe_trace_init() != 0 || !ggml_moe_trace_ready_for_test()) {
+        printf("xcpu_hold_ok=0 xcpu_hold_stage=0\n"); fflush(stdout); return 0;
+    }
+    XcpuStore st;
+    if (!xcpu_make_store(st, "xcpu_hold", XCPU_MW_NEXPERT, XCPU_MW_NUSED,
+                         XCPU_MW_K, XCPU_MW_M, XCPU_MW_NEMBD, 20260823u)) {
+        printf("xcpu_hold_ok=0 xcpu_hold_stage=90\n"); fflush(stdout); return 0;
+    }
+    XcpuBackend be; xcpu_open_backend(be, XCPU_MW_NTHREADS);
+    if (!be.ok) { printf("xcpu_hold_ok=0 xcpu_hold_stage=91\n"); fflush(stdout); return 0; }
+
+    std::vector<int32_t> idv((size_t) XCPU_MW_NUSED * XCPU_MW_NTOKEN);
+    for (size_t i = 0; i < idv.size(); i++) idv[i] = (int32_t)(i % (size_t) XCPU_MW_NEXPERT);
+    std::mt19937 rng(4242u); std::uniform_real_distribution<float> dd(-1.0f, 1.0f);
+    std::vector<float> act((size_t)(XCPU_MW_K * XCPU_MW_NUSED * XCPU_MW_NTOKEN));
+    for (size_t i = 0; i < act.size(); i++) act[i] = dd(rng);
+
+    // STOCK first, while nothing is registered: the byte oracle for step 10.
+    XcpuMmGraph gs;
+    if (!xcpu_build_mm_graph(gs, be.backend, false, st, XCPU_MW_K, XCPU_MW_M,
+                             XCPU_MW_NTOKEN, XCPU_MW_NUSED, idv, act)) {
+        printf("xcpu_hold_ok=0 xcpu_hold_stage=92\n"); fflush(stdout); return 0;
+    }
+    ggml_backend_graph_compute(be.backend, gs.graph);
+    std::vector<uint8_t> ref(ggml_nbytes(gs.out));
+    ggml_backend_tensor_get(gs.out, ref.data(), 0, ref.size());
+
+    XcpuMmGraph gd;
+    if (!xcpu_build_mm_graph(gd, be.backend, true, st, XCPU_MW_K, XCPU_MW_M,
+                             XCPU_MW_NTOKEN, XCPU_MW_NUSED, idv, act)) {
+        printf("xcpu_hold_ok=0 xcpu_hold_stage=93\n"); fflush(stdout); return 0;
+    }
+    if (xcpu_seal_store(st) != 0) {
+        printf("xcpu_hold_ok=0 xcpu_hold_stage=94\n"); fflush(stdout); return 0;
+    }
+
+    const uint16_t run_index = 0;
+    const uint64_t run_id = ggml_moe_trace_run_begin(run_index);
+
+    // step 1 - warm-up EXACTLY ONCE, outside the window (window_mode 0, so the gated O5/O6/O8
+    // records are 0), measure its wall, THEN advance into the window with empty pairs.
+    const int64_t t_warm0 = xcpu_now_ms();
+    {
+        const uint64_t gid = ggml_moe_trace_graph_begin(run_index, XCPU_GSEQ_WARM,
+                                                        MOE_TRACE_PHASE_DECODE,
+                                                        (uint32_t) XCPU_MW_NTOKEN);
+        ggml_backend_graph_compute(be.backend, gd.graph);
+        ggml_moe_trace_graph_end(gid, run_index, XCPU_GSEQ_WARM, MOE_TRACE_PHASE_DECODE);
+    }
+    const int64_t wall_warm = xcpu_now_ms() - t_warm0;
+    if (wall_warm < XCPU_MIN_GRAPH_WALL_MS) {
+        // A measured gate, not a prediction: on this host the fixture is too small to hold a
+        // window open, and that is a FAILURE the construction round answers by raising the
+        // dimensions - never a quiet pass.
+        ggml_moe_trace_run_end(run_id, run_index, 0, 0);
+        printf("xcpu_hold_ok=0 xcpu_hold_stage=1 xcpu_hold_wall=%lld\n", (long long) wall_warm);
+        fflush(stdout); return 0;
+    }
+    xcpu_enter_window(run_index, 1);
+
+    // step 2 - the target graph runs on its own thread.
+    const uint64_t base_chunk = ggml_moe_trace_chunk_call_count();
+    std::atomic<int> gstat(0);
+    std::thread gth([&]() {
+        const uint64_t gid = ggml_moe_trace_graph_begin(run_index, XCPU_GSEQ_TARGET,
+                                                         MOE_TRACE_PHASE_DECODE,
+                                                         (uint32_t) XCPU_MW_NTOKEN);
+        const ggml_status s = ggml_backend_graph_compute(be.backend, gd.graph);
+        ggml_moe_trace_graph_end(gid, run_index, XCPU_GSEQ_TARGET, MOE_TRACE_PHASE_DECODE);
+        gstat.store(s == GGML_STATUS_SUCCESS ? 1 : 2);
+    });
+
+    // step 3 - the progress signal. chunk_call_count is an ATOMIC counter, not a ring slot,
+    // and note_chunk_call sits inside the cur_a chunk loop, which is reached only after the
+    // start barrier - so one increment means every worker cleared is_registered() and
+    // ith==0's acquire has returned. Arming the hold before that would park the workers in
+    // is_registered() itself and produce a false FAIL.
+    const int64_t t_prog = (2 * wall_warm > 2000) ? 2 * wall_warm : 2000;
+    const int64_t prog_deadline = xcpu_now_ms() + t_prog;
+    bool progressed = false;
+    while (xcpu_now_ms() < prog_deadline) {
+        if (ggml_moe_trace_chunk_call_count() > base_chunk) { progressed = true; break; }
+        std::this_thread::sleep_for(std::chrono::milliseconds(XCPU_HOLD_POLL_MS));
+    }
+    if (!progressed) {
+        gth.join();
+        ggml_moe_trace_run_end(run_id, run_index, 0, 0);
+        printf("xcpu_hold_ok=0 xcpu_hold_stage=3 xcpu_hold_wall=%lld\n", (long long) wall_warm);
+        fflush(stdout); return 0;
+    }
+
+    // step 4 - the holder. arm() BLOCKS while it owns the lock, so it runs on its own thread,
+    // and every path from here releases the hold and joins both threads: without that a
+    // failure would leave the graph parked in store_release for good.
+    const int64_t t_hold_max = (4 * wall_warm > 5000) ? 4 * wall_warm : 5000;
+    const int32_t safety_ms = (int32_t)(t_hold_max + 2000);
+    std::thread hth([&]() { ggml_moe_direct_test_mutex_hold_arm(safety_ms); });
+    const int32_t armed = ggml_moe_direct_test_mutex_hold_wait(/*timeout_ms=*/5000);
+
+    int64_t o8_held = 0, nth_observed = -1, drop = -1;
+    int32_t safety = -1;
+    bool eq = false, axes = false;
+    if (armed == 1) {
+        const uint64_t lo = ggml_moe_trace_event_count();                       // step 5
+        // step 6 - hold until the op PARKS in store_release. A 200 ms plateau on the chunk
+        // counter says no chunk is left to run; the ceiling keeps the run from hanging if the
+        // plateau never settles. NO verdict is taken here.
+        const int64_t hold_deadline = xcpu_now_ms() + t_hold_max;
+        uint64_t last = ggml_moe_trace_chunk_call_count();
+        int64_t last_change = xcpu_now_ms();
+        for (;;) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(XCPU_HOLD_POLL_MS));
+            const uint64_t now = ggml_moe_trace_chunk_call_count();
+            const int64_t t = xcpu_now_ms();
+            if (now != last) { last = now; last_change = t; }
+            if (t - last_change >= XCPU_HOLD_T_QUIET_MS) break;
+            if (t >= hold_deadline) break;
+        }
+        const uint64_t hi = ggml_moe_trace_event_count();                       // step 7
+        ggml_moe_direct_test_mutex_hold_release();
+        hth.join();                                                             // step 8
+        gth.join();
+        const XcpuTraceTally tally = xcpu_tally(XCPU_GSEQ_TARGET, lo, hi);      // step 9
+        drop = (int64_t) ggml_moe_trace_timeline_drop_count();
+        nth_observed = (tally.enter > 0 && tally.enter % XCPU_MW_NEXPERT == 0)
+                     ? tally.enter / XCPU_MW_NEXPERT : -1;
+        o8_held = tally.o8_window;
+        safety = ggml_moe_direct_test_mutex_hold_safety_fired();
+        std::vector<uint8_t> got(ggml_nbytes(gd.out));                          // step 10
+        ggml_backend_tensor_get(gd.out, got.data(), 0, got.size());
+        eq = got.size() == ref.size() && std::memcmp(got.data(), ref.data(), got.size()) == 0;
+        axes = xcpu_axes_zero() && ggml_moe_direct_touch_events() == 0
+                                && ggml_moe_direct_fallback_count() == 0;
+    } else {
+        ggml_moe_direct_test_mutex_hold_release();
+        hth.join();
+        gth.join();
+        safety = ggml_moe_direct_test_mutex_hold_safety_fired();
+    }
+    ggml_moe_trace_run_end(run_id, run_index, 0, 0);
+
+    const bool ok = (armed == 1) && (gstat.load() == 1) && (nth_observed >= 2)
+                 && (o8_held > nth_observed) && (drop == 0) && eq && axes && (safety == 0);
+    printf("xcpu_hold_ok=%d xcpu_hold_stage=10 xcpu_hold_wall=%lld xcpu_hold_nth=%lld "
+           "xcpu_hold_o8=%lld xcpu_hold_drop=%lld xcpu_hold_eq=%d xcpu_hold_axes=%d "
+           "xcpu_hold_safety=%d xcpu_hold_armed=%d xcpu_hold_gstat=%d\n",
+           ok ? 1 : 0, (long long) wall_warm, (long long) nth_observed, (long long) o8_held,
+           (long long) drop, eq ? 1 : 0, axes ? 1 : 0, (int) safety, (int) armed,
+           (int) gstat.load());
+    fflush(stdout);
+    return 0;
+}
+
+// ===========================================================================
+// arms 2 and 3: the real multi-worker witnesses
+// ===========================================================================
+// A sampler thread polls the OS thread count while the FIRST graph of a fresh process runs.
+// The pool is created lazily by OpenMP inside graph compute (GGML_OPENMP:BOOL=ON), so this
+// has to be the first graph and DIRECT has to go first - on the runtime measured here a
+// preceding graph leaves the pool standing and the delta collapses to zero.
+//
+// SCOPE (authority: spec section C, D7 discipline (3)). That the team outlives the graph
+// which created it is NOT an OpenMP guarantee: the standard leaves native thread lifetime
+// to the implementation. MSVC's /openmp documentation describes pool reuse, and this arm
+// depends on the property only for the IMMEDIATE post-join instant, where the current
+// VCOMP140 runtime was measured 6/6. A runtime that tore the pool down earlier would make
+// the delta too SMALL, i.e. a false RED - it cannot manufacture a false green.
+struct XcpuSampler {
+    std::atomic<int> ready{0};
+    std::atomic<int> stop{0};
+    std::atomic<int> active{0};       // set while the TIMED graph is computing
+    std::atomic<int> peak{0};
+    std::atomic<int> samples{0};      // VALID readings taken wholly inside the window
+    std::atomic<int> failed{0};       // snapshots that did not walk, inside the window
+    std::atomic<int> attempts{0};     // loop iterations that BEGAN inside the window
+    std::atomic<long long> snap_us_sum{0};  // cost of the snapshot call itself
+    std::atomic<long long> snap_us_max{0};
+    std::atomic<int> post{-1};        // ONE reading taken after the graph joined
+    int32_t baseline = -1;
+};
+
+static void xcpu_sampler_main(XcpuSampler * s) {
+    // The handshake: the baseline is taken AFTER this thread exists (so it counts itself) and
+    // BEFORE the main thread starts computing. Without it the baseline either misses the
+    // sampler or includes workers it meant to exclude.
+    s->baseline = xcpu_thread_count();
+    s->peak.store((int) s->baseline);
+    s->ready.store(1);
+    // The pacer. next_tick is advanced by exactly one cadence per iteration and the wait is a
+    // yield-spin on steady_clock, so the period does not depend on the timer resolution at all.
+    // A snapshot that overruns the cadence must not accumulate debt - if we are already past
+    // the next tick, the deadline is re-anchored to now instead of firing a burst of catch-up
+    // iterations that would all read the same instant.
+    auto next_tick = std::chrono::steady_clock::now();
+    const auto cadence = std::chrono::milliseconds(XCPU_SAMPLER_CADENCE_MS);
+    auto pace = [&next_tick, &cadence]() {
+        next_tick += cadence;
+        const auto now = std::chrono::steady_clock::now();
+        if (next_tick <= now) { next_tick = now; return; }
+        while (std::chrono::steady_clock::now() < next_tick) std::this_thread::yield();
+    };
+    while (s->stop.load() == 0) {
+        // The sample window is the TIMED graph and nothing else. A snapshot is counted only
+        // when the graph was active when it STARTED and still active when it FINISHED - a
+        // reading that straddles the boundary describes a process that was partly idle, and
+        // a sample would otherwise include readings from before the pool existed or after it
+        // was joined. The peak is likewise only moved from inside the window.
+        const int a0 = s->active.load();
+        const auto snap_t0 = std::chrono::steady_clock::now();
+        const int32_t n = xcpu_thread_count();
+        const auto snap_t1 = std::chrono::steady_clock::now();
+        const int a1 = s->active.load();
+        if (a0 == 1) {
+            s->attempts.fetch_add(1);
+            const long long us = (long long) std::chrono::duration_cast<
+                std::chrono::microseconds>(snap_t1 - snap_t0).count();
+            s->snap_us_sum.fetch_add(us);
+            long long prev = s->snap_us_max.load();
+            while (us > prev && !s->snap_us_max.compare_exchange_weak(prev, us)) {}
+        }
+        if (a0 != 1 || a1 != 1) {
+            pace();
+            continue;
+        }
+        if (n < 0) {
+            // fail-closed: a failed snapshot is recorded as a failure and is NOT a sample.
+            // The parent turns any failure into a red check rather than reading around it.
+            s->failed.fetch_add(1);
+        } else {
+            if ((int) n > s->peak.load()) s->peak.store((int) n);
+            s->samples.fetch_add(1);
+        }
+        // pace() waits out whatever is left of the target period on steady_clock. On this host
+        // the read itself overruns that period every time, so this mostly returns immediately
+        // and the loop runs as fast as the reads allow - which is the honest behaviour, and why
+        // the samples it produces are a record rather than a gate (section C, D7 discipline 3).
+        pace();
+    }
+    // The witness itself (lead disposition D, round 11). The polled peak above is a
+    // best-effort record: one reading costs 20-60 ms on this host, so a short window holds
+    // two or three of them and no amount of pacing changes that. What does NOT need polling
+    // is the thing D7 (3) states - the team the first graph created is still standing at the
+    // instant that graph joins, so ONE reading taken here carries the whole claim. It is
+    // also why the target graph has to be the child's first compute: a preceding graph would
+    // leave the pool standing and collapse the delta to zero.
+    //
+    // SCOPE (authority: spec section C, D7 discipline (3)). That persistence is NOT an
+    // OpenMP guarantee - the standard leaves native thread lifetime to the implementation.
+    // MSVC's /openmp documentation describes pool reuse, and the claim here is bounded to
+    // the IMMEDIATE post-join instant on the current VCOMP140 runtime, measured 6/6. An
+    // earlier teardown shrinks the delta, i.e. produces a false RED, never a false green;
+    // a failed snapshot is fail-closed to -1 for the same reason.
+    //
+    // The reading is taken by the sampler thread, not the caller, so both readings come from
+    // the same thread and the sampler is counted on both sides. Note the limit of what that
+    // establishes: xcpu_thread_count reads PROCESSENTRY32.cntThreads, which is a COUNT of the
+    // threads the OS attributes to this process. Equal or larger counts do not prove the two
+    // readings saw the same thread IDs, and the witness does not claim they did.
+    s->post.store(xcpu_thread_count());
+}
+
+static int xcpu_child_mw(bool is_mmid) {
+    const char * pfx = is_mmid ? "mmid" : "addid";
+    if (ggml_moe_trace_init() != 0 || !ggml_moe_trace_ready_for_test()) {
+        printf("xcpu_%s_ok=0 xcpu_%s_stage=0\n", pfx, pfx); fflush(stdout); return 0;
+    }
+    // Phase A resolves its env ONCE and latches it, so the reset comes first and the guards
+    // after - and the out prefix is derived from a case directory that has to exist by then.
+    ggml_moe_phasea_reset_for_test();
+    XcpuStore st;
+    const int64_t k    = is_mmid ? XCPU_MW_K : 32;
+    const int64_t mdim = is_mmid ? XCPU_MW_M : 8;
+    // Round 11 split. The two arms no longer share a token count: mul_mat_id buys its
+    // wall with tokens (cheap - the activation and the one output scale linearly), while
+    // add_id buys its wall with NODES (R_node), because a token raise there multiplies
+    // R_node outputs at once. Sharing the constant meant one arm's wall could only be
+    // bought at the other arm's memory: at n_token 2048 a shared constant would have put
+    // the addid child at R_node * (nembd * n_used * 2048 * 4) = tens of GiB.
+    const int32_t n_token = is_mmid ? XCPU_MW_NTOKEN : XCPU_MW_ADD_NTOKEN;
+    if (!xcpu_make_store(st, is_mmid ? "xcpu_mmid" : "xcpu_addid", XCPU_MW_NEXPERT,
+                         XCPU_MW_NUSED, k, mdim, XCPU_MW_NEMBD,
+                         is_mmid ? 20260824u : 20260825u)) {
+        printf("xcpu_%s_ok=0 xcpu_%s_stage=90\n", pfx, pfx); fflush(stdout); return 0;
+    }
+    const std::string pa_prefix = wide_to_utf8(st.dir + L"\\pa");
+    EnvGuard pa_mode("MOE_DIRECT_PHASEA", "timing");
+    EnvGuard pa_out("MOE_DIRECT_PHASEA_OUT", pa_prefix.c_str());
+
+    XcpuBackend be; xcpu_open_backend(be, XCPU_MW_NTHREADS);
+    if (!be.ok) { printf("xcpu_%s_ok=0 xcpu_%s_stage=91\n", pfx, pfx); fflush(stdout); return 0; }
+
+    std::vector<int32_t> idv((size_t) XCPU_MW_NUSED * n_token);
+    for (size_t i = 0; i < idv.size(); i++) idv[i] = (int32_t)(i % (size_t) XCPU_MW_NEXPERT);
+    std::mt19937 rng(is_mmid ? 515u : 616u);
+    std::uniform_real_distribution<float> dd(-1.0f, 1.0f);
+    const size_t act_n = is_mmid
+        ? (size_t)(k * XCPU_MW_NUSED * n_token)
+        : (size_t)(XCPU_MW_NEMBD * XCPU_MW_NUSED * n_token);
+    std::vector<float> act(act_n);
+    for (size_t i = 0; i < act.size(); i++) act[i] = dd(rng);
+
+    // ---- both graphs are BUILT here, and NEITHER is computed yet -------------------------
+    // DIRECT has to be the FIRST graph this process computes. This build is OPENMP=ON, so the
+    // worker pool is created lazily inside graph compute and, on the runtime measured here,
+    // is still standing when that graph joins - a preceding compute of any kind would leave
+    // it standing and collapse the OS thread delta to zero, which is the second of the two
+    // witnesses. That persistence is SCOPED, not guaranteed: see the SCOPE note on
+    // xcpu_sampler_main (spec section C, D7 discipline (3) - current VCOMP140, immediate
+    // post-join instant, measured 6/6; an earlier teardown is a false RED). Building
+    // allocates and fills tensors; it computes nothing (section C-2, DIRECT-first).
+    std::vector<uint8_t> ref;
+    XcpuMmGraph  s_mm;
+    XcpuAddGraph s_ad;
+    if (is_mmid) {
+        if (!xcpu_build_mm_graph(s_mm, be.backend, false, st, k, mdim,
+                                 n_token, XCPU_MW_NUSED, idv, act)) {
+            printf("xcpu_%s_ok=0 xcpu_%s_stage=92\n", pfx, pfx); fflush(stdout); return 0;
+        }
+    } else {
+        if (!xcpu_build_add_graph(s_ad, be.backend, false, st, XCPU_MW_NEMBD,
+                                  n_token, XCPU_MW_NUSED, 1, idv, act)) {
+            printf("xcpu_%s_ok=0 xcpu_%s_stage=92\n", pfx, pfx); fflush(stdout); return 0;
+        }
+    }
+
+    XcpuMmGraph  d_mm;
+    XcpuAddGraph d_ad;
+    if (is_mmid) {
+        if (!xcpu_build_mm_graph(d_mm, be.backend, true, st, k, mdim,
+                                 n_token, XCPU_MW_NUSED, idv, act)) {
+            printf("xcpu_%s_ok=0 xcpu_%s_stage=93\n", pfx, pfx); fflush(stdout); return 0;
+        }
+    } else {
+        if (!xcpu_build_add_graph(d_ad, be.backend, true, st, XCPU_MW_NEMBD,
+                                  n_token, XCPU_MW_NUSED, XCPU_ADDID_RNODE, idv, act)) {
+            printf("xcpu_%s_ok=0 xcpu_%s_stage=93\n", pfx, pfx); fflush(stdout); return 0;
+        }
+    }
+    if (xcpu_seal_store(st) != 0) {
+        printf("xcpu_%s_ok=0 xcpu_%s_stage=94\n", pfx, pfx); fflush(stdout); return 0;
+    }
+    // The part this harness reads INDEPENDENTLY, before the graph runs. It is the value the
+    // ledger comparison below is against, so it never comes from the ledger itself.
+    int32_t want_mlpos = -1, want_part = -1;
+    if (ggml_moe_adapter_resolve(is_mmid ? d_mm.w : d_ad.bias, &want_mlpos, &want_part) != 0) {
+        printf("xcpu_%s_ok=0 xcpu_%s_stage=95\n", pfx, pfx); fflush(stdout); return 0;
+    }
+
+    // ---- the witnessed run ---------------------------------------------------------------
+    const uint16_t run_index = 0;
+    ggml_moe_phasea_run_begin();
+    const uint64_t run_id = ggml_moe_trace_run_begin(run_index);
+    xcpu_enter_window(run_index, 0);          // DIRECT is the FIRST graph that computes
+
+    XcpuSampler smp;
+    std::thread sth(xcpu_sampler_main, &smp);
+    while (smp.ready.load() == 0) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+
+    ggml_moe_phasea_graph_begin(0, (int32_t) n_token);
+    const uint64_t gid = ggml_moe_trace_graph_begin(run_index, XCPU_GSEQ_TARGET,
+                                                    MOE_TRACE_PHASE_DECODE,
+                                                    (uint32_t) n_token);
+    const int64_t t0 = xcpu_now_ms();
+    smp.active.store(1);              // opens the sampler's window (R15)
+    const ggml_status gstatus = ggml_backend_graph_compute(be.backend,
+                                                           is_mmid ? d_mm.graph : d_ad.graph);
+    smp.active.store(0);              // closes it before anything else runs
+    const int64_t wall = xcpu_now_ms() - t0;
+    ggml_moe_trace_graph_end(gid, run_index, XCPU_GSEQ_TARGET, MOE_TRACE_PHASE_DECODE);
+    ggml_moe_phasea_graph_end(10, 2);
+    smp.stop.store(1);
+    sth.join();
+    ggml_moe_phasea_run_end(1, 1);
+    ggml_moe_trace_run_end(run_id, run_index, 0, 0);
+
+    // ---- the byte oracle, computed SECOND -------------------------------------------------
+    // The STOCK graph runs only now, with the sampler joined and the trace window closed, so
+    // it cannot touch either witness. Its tensors were never registered, so it takes the
+    // original path and its output is the reference the DIRECT run has to match.
+    if (is_mmid) {
+        ggml_backend_graph_compute(be.backend, s_mm.graph);
+        ref.resize(ggml_nbytes(s_mm.out));
+        ggml_backend_tensor_get(s_mm.out, ref.data(), 0, ref.size());
+    } else {
+        ggml_backend_graph_compute(be.backend, s_ad.graph);
+        ref.resize(ggml_nbytes(s_ad.outs[0]));
+        ggml_backend_tensor_get(s_ad.outs[0], ref.data(), 0, ref.size());
+    }
+
+    // ---- read back -----------------------------------------------------------------------
+    const XcpuTraceTally tally = xcpu_tally(XCPU_GSEQ_TARGET, 0, 0);
+    // ADD_ID issues its op-by-worker record once per worker per NODE (the ir0 < ir1 gate);
+    // MUL_MAT_ID issues it once per worker per ACTIVE EXPERT (the enter sits in the cur_a
+    // loop). A total that does not divide evenly is a FAILURE, not a rounded answer.
+    const int64_t divisor = is_mmid ? (int64_t) XCPU_MW_NEXPERT : (int64_t) XCPU_ADDID_RNODE;
+    const int64_t nth_observed = (tally.enter > 0 && tally.enter % divisor == 0)
+                               ? tally.enter / divisor : -1;
+    bool eq = false;
+    if (is_mmid) {
+        std::vector<uint8_t> got(ggml_nbytes(d_mm.out));
+        ggml_backend_tensor_get(d_mm.out, got.data(), 0, got.size());
+        eq = got.size() == ref.size() && std::memcmp(got.data(), ref.data(), got.size()) == 0;
+    } else {
+        eq = true;
+        std::vector<uint8_t> got(ggml_nbytes(d_ad.outs[0]));
+        for (size_t i = 0; i < d_ad.outs.size(); i++) {
+            ggml_backend_tensor_get(d_ad.outs[i], got.data(), 0, got.size());
+            if (got.size() != ref.size()
+                || std::memcmp(got.data(), ref.data(), got.size()) != 0) { eq = false; break; }
+        }
+    }
+    const bool axes    = xcpu_axes_zero();
+    const int64_t touch = (int64_t) ggml_moe_direct_touch_events();
+    const int64_t fbk   = (int64_t) ggml_moe_direct_fallback_count();
+
+    // finalize is the ONLY thing that flushes the Phase A sidecar - run_end is not.
+    ggml_moe_direct_finalize();
+    int64_t acq_m = 0, acq_o = 0, rel_m = 0, rel_o = 0;
+    xcpu_ledger_parts(st.dir + L"\\pa_ledger.pa", /*LED_ACQ_CALL=*/1, want_part, &acq_m, &acq_o);
+    xcpu_ledger_parts(st.dir + L"\\pa_ledger.pa", /*LED_REL_CALL=*/4, want_part, &rel_m, &rel_o);
+
+    const int base = (int) smp.baseline, peak = smp.peak.load(), samples = smp.samples.load();
+    const int post = smp.post.load();
+    const int sfail = smp.failed.load();
+    const int sattempts = smp.attempts.load();
+    const long long snap_us_max = smp.snap_us_max.load();
+    const long long snap_us_avg = sattempts > 0 ? (smp.snap_us_sum.load() / sattempts) : -1;
+    // The OS witness is only as good as its readings: a failed snapshot is fail-closed, and
+    // the requested thread count N is printed beside the observed one so the two are read
+    // together. nth CAN be below N (OpenMP is allowed to shrink a team) but never above it -
+    // an observed count larger than the request would mean the derivation, not the engine,
+    // is wrong.
+    // peak is the polled record; post is the post-join reading. Either one carrying the
+    // delta proves the threads appeared, so the witness takes the better of the two rather
+    // than depending on a poll having landed inside the window at all.
+    const int os_seen = (post > peak) ? post : peak;
+    const bool os_ok = (base >= 0) && (post >= 0) && (sfail == 0) && (nth_observed >= 2)
+                    && (nth_observed <= (int64_t) XCPU_MW_NTHREADS)
+                    && ((int64_t)(os_seen - base) >= nth_observed - 1);
+    const bool ok = (gstatus == GGML_STATUS_SUCCESS) && eq && axes
+                 && (nth_observed >= 2) && os_ok
+                 && (touch == 0) && (fbk == 0)
+                 && (acq_m > 0) && (acq_o == 0) && (rel_m > 0) && (rel_o == 0);
+    printf("xcpu_%s_ok=%d xcpu_%s_stage=10 xcpu_%s_nth=%lld xcpu_%s_n=%d xcpu_%s_enter=%lld "
+           "xcpu_%s_base=%d xcpu_%s_peak=%d xcpu_%s_post=%d xcpu_%s_samples=%d xcpu_%s_sfail=%d "
+           "xcpu_%s_attempts=%d xcpu_%s_snapusmax=%lld xcpu_%s_snapusavg=%lld "
+           "xcpu_%s_wall=%lld xcpu_%s_eq=%d xcpu_%s_axes=%d xcpu_%s_touch=%lld "
+           "xcpu_%s_fbk=%lld xcpu_%s_part=%d xcpu_%s_acqm=%lld xcpu_%s_acqo=%lld "
+           "xcpu_%s_relm=%lld xcpu_%s_relo=%lld\n",
+           pfx, ok ? 1 : 0, pfx, pfx, (long long) nth_observed, pfx, (int) XCPU_MW_NTHREADS,
+           pfx, (long long) tally.enter,
+           pfx, base, pfx, peak, pfx, post, pfx, samples, pfx, sfail,
+           pfx, sattempts, pfx, snap_us_max, pfx, snap_us_avg,
+           pfx, (long long) wall, pfx, eq ? 1 : 0, pfx, axes ? 1 : 0, pfx, (long long) touch,
+           pfx, (long long) fbk, pfx, (int) want_part, pfx, (long long) acq_m,
+           pfx, (long long) acq_o, pfx, (long long) rel_m, pfx, (long long) rel_o);
+    fflush(stdout);
+    return 0;
+}
