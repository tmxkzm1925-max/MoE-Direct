+        const uint64_t ptab = hdr_off.contains("phaseb_mem")
+                              ? hdr_off["phaseb_mem"].value("pending_table_bytes", (uint64_t)0) : 0;
+        const uint64_t nslot = hdr_off.value("slot_count", (uint64_t)0);
+        check(irec == 88 && nslot > 0 && ptab == nslot * 232,
+              "P44c. ★구조체 폭 echo 불변 — intent_record_bytes=88 · pending_table_bytes="
+              + std::to_string(ptab) + "(=slot_count×232). 스탬프 N 은 기존 정렬 패딩을 채웠고 "
+              "op 스탬프는 병렬 side table 이라 PendingIo 폭이 그대로다");
