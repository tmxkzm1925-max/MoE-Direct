+static_assert(offsetof(ShStep,  resident_gemv_bytes)   == 40, "ShStep.resident_gemv_bytes @40");
+static_assert(offsetof(ShStep,  origin_graph_seq)      == 48, "ShStep.origin_graph_seq @48");
