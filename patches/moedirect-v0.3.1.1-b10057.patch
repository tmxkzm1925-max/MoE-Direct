+GGML_API int32_t ggml_moe_direct_test_mutex_hold_wait(int32_t timeout_ms);
+GGML_API void ggml_moe_direct_test_mutex_hold_release(void);
+GGML_API int32_t ggml_moe_direct_test_mutex_hold_safety_fired(void);
