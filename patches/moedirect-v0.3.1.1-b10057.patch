+// ★★R-5/R-4 공용 — **생산 경로 픽스처로 seal + 프리페치 무장**까지 한 번에 세운다.
+//   V3PROD 가 "생산 산물로 seal 이 선다"를 증명했으므로, 그 위에 PhaseB 인벤토리(adapter 해소)
+//   와 K/N 을 얹으면 **손수 재작성 0 인 프리페치 arm** 이 된다. V3P7 처럼 기존 `V3Fixture`
+//   (P=2 고정)로는 만들 수 없는 형상(P=3)을 요구하는 관문이 이 창구를 쓴다.
+//   ★호출자가 K/N·노브 EnvGuard 를 쥔다(기존 `v3_pf_arm` 규약과 동형).
+struct V3ProdArm {
+    bool          ok = false;
+    std::string   why;
+    std::wstring  out;
+    std::string   arch, lock_id, lock_sha, expects_u8;
+    // ★다중 shard: 경로·gguf 핸들을 shard 수만큼 보유한다. `shard_u8`/`gc`/`gctx` 단수 필드는
+    //   `shard_u8()`/`gc0()` 접근자로 대체했다(기존 호출자 문면 보존용).
+    std::vector<std::string>     shard_paths;
+    std::vector<ggml_context *>  gctxs;
+    std::vector<gguf_context *>  gcs;
+    std::vector<ggml_moe_direct_source> srcs;   // seal 에 그대로 넘길 배열
+    // ★등록 루프가 "이 텐서를 몇 번 shard 에서 찾았는가"를 집계한 결과(신설 arm 주장 3의 창구).
+    //   분산이 **실제로 일어났는지**는 요약 echo 가 아니라 이 계수로만 주장할 수 있다.
+    std::vector<int32_t> routed_per_shard;
+    int32_t  n_expert = 0, n_expert_used = 0, n_layer = 0, hidden = 0;
+    int32_t  parts_per_layer = 0;
+    uint64_t slot_stride_max = 0;
+    std::vector<int32_t> ml;
+    // ★수명 계약(패치 B §2-6-3): ①`shard_paths` 의 **개별 string 내용도** seal 반환까지 변경
+    //   금지(`sd.path` 가 그 버퍼를 가리킨다 — 벡터 재할당만 위험한 게 아니다) ②`V3ProdArm`
+    //   이동·복사·재사용 금지 ③`gcs`/`gctxs` 는 seal 뿐 아니라 **arm 실행 전체 +
+    //   `ggml_moe_direct_reset_for_test()` 완료까지** 생존(등록 텐서 데이터가 그 ggml_context
+    //   아레나에 있다) ④소멸은 **reset 이 보호를 원복한 뒤에만**(그 전에 죽으면 PAGE_NOACCESS 인
+    //   채 아레나가 할당자로 돌아간다 = V3HEAP 실사고와 같은 얼굴).
+    //   ★③④는 shard 수만큼 배가된다 — 어느 하나라도 먼저 죽으면 그 shard 의 등록 텐서만 조용히 무효다.
+    const std::string & shard_u8() const { return shard_paths.at(0); }
+    gguf_context * gc0() const { return gcs.at(0); }
+    ~V3ProdArm() {
+        for (gguf_context * g : gcs)  if (g) gguf_free(g);
+        for (ggml_context * c : gctxs) if (c) ggml_free(c);
+    }
+};
