+static void test_v3_pbvirt() {
+    section("V3P. ★★PB virtual 프리페치 런타임 배선(SPEC_PB_VIRTUAL_RUNTIME_R1 §2-0 · §3 16게이트)");
+
+    // ── ① Q4 OFF 무오염 — 프리페치 OFF virtual 런은 새 축을 하나도 건드리지 않는다 ──
+    {
+        EnvGuard k("MOE_DIRECT_PREFETCH_K", nullptr), n("MOE_DIRECT_PREFETCH_N", nullptr);
+        V3Fixture fx; PbInvFix inv; std::string why;
+        if (check(v3_pf_arm(fx, inv, "v3p_off", "8", why), "V3P1a. 프리페치 OFF virtual seal (" + why + ")")) {
+            int32_t on = -1, kk = -1, nn = -1; uint64_t a = 0, b = 0, c = 0, d = 0;
+            ggml_moe_direct_test_pb_counts(&a, &b, &c, &d, &on, &kk, &nn);
+            PbvStat s; s.snap();
+            check(on == 0 && s.rec_active == 0 && s.rec_inflight == 0 && s.child_reserved == 0 &&
+                  s.defer_attempts == 0 && s.drain_turns == 0 && s.parked == 0 &&
+                  ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_NCAP_ZERO) == 0,
+                  "V3P1. ★게이트 Q4(OFF 무오염) — K/N 미설정 virtual 런에서 ①record 운영축·"
+                  "②예약분·진단 2종·park 래치·`skip_ncap_zero` 가 **전부 0**(새 축이 OFF 런의 "
+                  "회계를 오염시키지 않는다) [" + s.tag() + "]");
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ── ② seal 배선(A5) — R13 해제 후 K/N 이 실제로 기능을 켠다 ──
+    {
+        EnvGuard k("MOE_DIRECT_PREFETCH_K", "8"), n("MOE_DIRECT_PREFETCH_N", "2");
+        V3Fixture fx; PbInvFix inv; std::string why;
+        if (check(v3_pf_arm(fx, inv, "v3p_on", "8", why),
+                  "V3P2a. ★A8 — `MOE_DIRECT_PREFETCH_K/N` + mode=virtual seal 성립(구 R13 재-fail-close "
+                  "철거 · 근거는 A5 가 `resolve_prefetch`/`note_seal` 을 실제로 배선했다는 사실이다) (" + why + ")")) {
+            int32_t on = -1, kk = -1, nn = -1; uint64_t a = 0, b = 0, c = 0, d = 0;
+            ggml_moe_direct_test_pb_counts(&a, &b, &c, &d, &on, &kk, &nn);
+            int32_t wr = -1, idep = -1; uint64_t cap = 0, pred = 0, iov = 0, cov = 0;
+            ggml_moe_phaseb_test_counts(&cap, &pred, &iov, &cov, &idep, &wr);
+            // ★K 는 1..16 이다(`ggml_moe_phaseb_resolve_prefetch` — `kv<1||kv>16`=invalid_range ·
+            //   §4-① 개방 26-08-27). 이 픽스처의 `n_expert=8` 은 note_seal 의 `n_expert < pf_k`
+            //   게이트 상한이라 K=8 이 최대 유효값이다.
+            check(on == 1 && kk == 8 && nn == 2 && wr == 1,
+                  "V3P2. ★게이트 seal 배선 — `prefetch_on=1 k=8 n=2` echo + **predictor worker 기동**"
+                  "(worker 없이 ON 이면 조용한 no-op 이다 — §2-2 가 금지하는 형상) [on=" +
+                  std::to_string(on) + " k=" + std::to_string(kk) + " n=" + std::to_string(nn) +
+                  " worker=" + std::to_string(wr) + "]");
+
+            // ── ③ N_cap 등식·wave 폭(A0-5·A0-2) ──
+            int32_t wave = -1;
+            const int32_t ncap = ggml_moe_direct_test_pbv_ncap(/*mlpos=*/1, /*n_stamp=*/2, &wave);
+            //   손계산: W=min(P_l=2, part_parallelism>=2)=2 · N_cap=min(2, 4/2, (8-4)/2)=2
+            check(wave == 2 && ncap == 2,
+                  "V3P3. ★게이트 A0-5 등식 — `W_l=min(P_l, io_part_parallelism)`=2 · "
+                  "`N_cap=min(N, child_max/W, (qd_total-reserve)/W)`=min(2,2,2)=2 [wave=" +
+                  std::to_string(wave) + " ncap=" + std::to_string(ncap) + "]");
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ── ④ N_cap(l)=0 = 그 층 프리페치 OFF → eligibility skip(C3 불변) ──
+    {
+        EnvGuard k("MOE_DIRECT_PREFETCH_K", "8"), n("MOE_DIRECT_PREFETCH_N", "2");
+        //   child_max=1 · W=2 ⇒ floor(1/2)=0 ⇒ N_cap=0(전 층).
+        EnvGuard cm("MOE_DIRECT_IO_QD_PREFETCH_CHILD_MAX", "1");
+        V3Fixture fx; PbInvFix inv; std::string why;
+        if (check(v3_pf_arm(fx, inv, "v3p_ncap0", "8", why), "V3P4a. N_cap=0 형상 seal (" + why + ")")) {
+            int32_t wave = -1;
+            const int32_t ncap = ggml_moe_direct_test_pbv_ncap(1, 2, &wave);
+            const PbCtr c0 = pb_ctr();
+            const uint64_t sk0 = ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_NCAP_ZERO);
+            std::vector<int32_t> ids = {0, 1, 2, 3};
+            ggml_moe_phaseb_test_push_intent(0, 0, 0, /*src=*/0, /*tgt=*/1, ids.data(), (int32_t)ids.size());
+            pbv_pump_turns(200);
+            const PbCtr c1 = pb_ctr();
+            const uint64_t sk1 = ggml_moe_phaseb_skip_counter(GGML_MOE_PB_SKIP_NCAP_ZERO);
+            check(ncap == 0 && sk1 > sk0 &&
+                  c1.get(GGML_MOE_PB_C_CANDIDATE) == c0.get(GGML_MOE_PB_C_CANDIDATE) &&
+                  c1.get(GGML_MOE_PB_C_ADMITTED) == c0.get(GGML_MOE_PB_C_ADMITTED),
+                  "V3P4. ★게이트 A0-5 — `N_cap(l)=0` 층의 intent 는 **eligibility skip**"
+                  "(`skip_ncap_zero`)으로 소비되고 C3(candidate·admitted)는 불변이다"
+                  " [ncap=" + std::to_string(ncap) + " skip Δ=" +
+                  std::to_string((unsigned long long)(sk1 - sk0)) + " candidate Δ=" +
+                  std::to_string((unsigned long long)(c1.get(GGML_MOE_PB_C_CANDIDATE) -
+                                                     c0.get(GGML_MOE_PB_C_CANDIDATE))) + "]");
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ── ⑤⑥⑬⑭⑯ admission commit → wave 개시 → 단일 terminal · credit exactly-once ──
+    {
+        EnvGuard k("MOE_DIRECT_PREFETCH_K", "8"), n("MOE_DIRECT_PREFETCH_N", "2");
+        V3Fixture fx; PbInvFix inv; std::string why;
+        if (check(v3_pf_arm(fx, inv, "v3p_admit", "8", why), "V3P5a. seal (" + why + ")")) {
+            // 회수를 보류해 **admission commit ~ 첫 submit** 구간을 결정론적으로 잡는다.
+            ggml_moe_direct_test_hold_retire(1);
+            const PbCtr c0 = pb_ctr();
+            std::vector<int32_t> ids = {0, 1, 2, 3};
+            ggml_moe_phaseb_test_push_intent(0, 0, 0, /*src=*/0, /*tgt=*/1, ids.data(), (int32_t)ids.size());
+            PbvStat s1;
+            for (int i = 0; i < 600; i++) {
+                pbv_pump_turns(1);
+                s1.snap();
+                if (s1.rec_inflight > 0) break;
+                Sleep(1);
+            }
+            uint64_t sub = 0, ret = 0, term = 0, pub = 0;
+            ggml_moe_direct_test_v3_child_stats(&sub, &ret, &term, &pub);
+            check(s1.rec_active >= 1 && s1.rec_inflight >= 1 && s1.child_reserved == 0 &&
+                  s1.cin_prefetch == 2 * s1.rec_inflight,
+                  "V3P5. ★게이트 A0-3 — admission commit(①record gauge +1 · ②credit `W_l` 선점) → "
+                  "**첫 child submit 에서 reservation→inflight 전환**(reserved=0 · child_inflight_prefetch "
+                  "= W×record) [" + s1.tag() + "]");
+            // ⑭ wave/부분 제출 — record 1건이 `W_l` child 를 **한 wave 로** 낸다.
+            check(sub >= 2 && (sub % 2) == 0,
+                  "V3P6. ★게이트 ⑭ wave/부분 제출 — 제출된 child 수가 `W_l`(=2)의 배수다"
+                  "(record 의 전 child 가 한 wave 로 나간다 — 부분 제출 없음) [children_submitted=" +
+                  std::to_string((unsigned long long)sub) + "]");
+            // ⑬ credit exactly-once(과승인 0) — reserved 가시성 하에서 N_cap 상한을 넘지 않는다.
+            check(s1.rec_active <= 2 && (s1.cin_prefetch + s1.child_reserved) <= 4,
+                  "V3P7. ★게이트 ⑬ credit exactly-once(과승인 0) — 동시 active prefetch record ≤ "
+                  "`N_cap`(2) · prefetch child post-state(inflight+reserved) ≤ "
+                  "min(child_max, qd_total−reserve)=4 [" + s1.tag() + "]");
+            // ⑯ ③축 disposition 과 ④PB physical 축의 분리 — PB 사이드카는 **한 줄도** 안 는다.
+            uint64_t ns = 0, ni = 0, ps = 0, es = 0; int32_t on2 = 0, k2 = 0, n2 = 0;
+            ggml_moe_direct_test_pb_counts(&ns, &ni, &ps, &es, &on2, &k2, &n2);
+            ggml_moe_direct_test_hold_retire(0);
+            pbv_pump_turns(400);
+            const PbCtr c1 = pb_ctr();
+            const uint64_t iss = c1.get(GGML_MOE_PB_C_ISSUED) - c0.get(GGML_MOE_PB_C_ISSUED);
+            const uint64_t sf  = c1.get(GGML_MOE_PB_C_SUBMIT_FAILED) - c0.get(GGML_MOE_PB_C_SUBMIT_FAILED);
+            const uint64_t adm = c1.get(GGML_MOE_PB_C_ADMITTED) - c0.get(GGML_MOE_PB_C_ADMITTED);
+            check(ni == 0 && es == 0,
+                  "V3P8. ★게이트 §3-5 — virtual child 는 `pb_note_submit/terminal` 을 **둘 다 호출하지 "
+                  "않는다**: PB physical 축(`pb_io` 행·event seq)이 프리페치 제출 뒤에도 0 이다 "
+                  "[pb_ios=" + std::to_string((unsigned long long)ni) + " event_seq=" +
+                  std::to_string((unsigned long long)es) + "]");
+            // ★`iss > 0` 을 함께 요구한다: 배타 등식만 보면 latch 가 **죽어 있어도**(전건
+            //   submit_failed) 통과한다(0 + adm == adm). ③축이 실제로 서는지가 이 게이트의 본질이다.
+            check(adm > 0 && iss > 0 && (iss + sf) == adm,
+                  "V3P9. ★게이트 A0-3 ③축 — `admitted = issued + submit_failed` 배타 **∧ issued>0**"
