+// ===========================================================================
+// M. ★QD 레버(비동기 다중 outstanding — reviews/codex_qd_u6_design_xcheck.md 심의 3)
+//    배치 플래너 계약 행사: ①중복 ID multiplicity ②hit+miss 혼재 ③뒤쪽 hit victim 보호
+//    ④slot 0 ⑤capacity preflight 무-mutation ⑥n_unique_miss>QD sliding pump
+//    ⑦ERROR_IO_PENDING 실발생 ⑧QD1↔QD8 결정론 동등성.
+// ===========================================================================
+static uint64_t qd_reads_total() { uint64_t i = 0, p = 0; ggml_moe_direct_test_read_stats(&i, &p); return i + p; }
+
+// ★모듈 내부 상태 전량 스냅샷(테스트 전용 export 경유) — record→slot 매핑·slot generation·
+// LRU(last_used)·lease까지 본다. ptr!=null 같은 간접 관측만으로는 LRU tick 순서 결함이 통과한다.
+struct QdStateSnap {
+    std::vector<int32_t>  rec_slot;
+    std::vector<uint64_t> rec_gen;
+    std::vector<int64_t>  slot_owner;
+    std::vector<uint64_t> slot_last_used;
+    std::vector<uint64_t> slot_gen;
+    std::vector<int32_t>  slot_lease;
+    bool operator==(const QdStateSnap & o) const {
+        return rec_slot == o.rec_slot && rec_gen == o.rec_gen && slot_owner == o.slot_owner &&
+               slot_last_used == o.slot_last_used && slot_gen == o.slot_gen && slot_lease == o.slot_lease;
+    }
+};
+static QdStateSnap qd_snapshot(int64_t n_records) {
+    QdStateSnap s;
+    int all = 0, host = 0, nh = 0, ns = 0, nsr = 0;
+    ggml_moe_direct_attestation(&all, &host, &nh, &ns, &nsr);
+    for (int64_t r = 0; r < n_records; r++) {
+        int32_t sl = -2; uint64_t g = 0;
+        ggml_moe_direct_test_record_slot(r, &sl, &g);
+        s.rec_slot.push_back(sl); s.rec_gen.push_back(g);
+    }
+    for (int32_t i = 0; i < ns; i++) {
+        int64_t o = -2; uint64_t lu = 0, g = 0; int32_t le = -1;
+        ggml_moe_direct_test_slot_state(i, &o, &lu, &g, &le);
+        s.slot_owner.push_back(o); s.slot_last_used.push_back(lu);
+        s.slot_gen.push_back(g);   s.slot_lease.push_back(le);
+    }
+    return s;
+}
+// record_idx가 올라가 있는 슬롯의 last_used(미상주면 found=false).
+static uint64_t qd_record_last_used(int64_t record_idx, bool & found) {
+    int32_t sl = -1; uint64_t g = 0;
+    ggml_moe_direct_test_record_slot(record_idx, &sl, &g);
+    found = (sl >= 0);
+    if (!found) return 0;
+    int64_t o = -1; uint64_t lu = 0, sg = 0; int32_t le = 0;
+    ggml_moe_direct_test_slot_state(sl, &o, &lu, &sg, &le);
+    return lu;
+}
+
+// 2층 × n_expert MXFP4 합성 모델(슬롯 정확히 n_expert개 → 층 간 축출이 강제된다).
+static void qd_setup_2layer(Fixture & fx, const char * tag, int32_t n_expert = 8) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "synth"; fx.model.n_expert = n_expert; fx.model.n_expert_used = 2; fx.model.n_layer = 2;
+    fx.model.sources = { default_source() };
+    fx.model.layers = { make_separate_layer(0, n_expert, "MXFP4", false),
+                        make_separate_layer(1, n_expert, "MXFP4", false) };
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.build();
+}
+
+// M8용: 동일 요청 시퀀스를 지정 QD로 완주한 뒤의 최종 상태 스냅샷.
+// ★상주 여부(ptr!=null) 16개만으로는 LRU tick 순서 결함이 통과하므로, record→slot 매핑과
+//   슬롯별 last_used/generation/lease까지 전부 담아 QD1↔QD8을 비교한다.
+struct QdRunState {
+    bool ok = false;
+    bool bytes_ok = true;
+    QdStateSnap snap;                                 // record→slot 매핑 + 슬롯 LRU 상태 전량
+    uint64_t rb[2] = {0,0}, hit[2] = {0,0}, miss[2] = {0,0}; // phase 0=decode 1=prefill
+    uint64_t reads_total = 0;
+};
+static QdRunState qd_run_sequence(const char * tag, const char * qd_value) {
+    QdRunState st;
+    set_env("MOE_DIRECT_QD", qd_value);
+    Fixture fx; qd_setup_2layer(fx, tag);
+    int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64); // QD는 seal에서 env 해소
+    clear_env("MOE_DIRECT_QD");
+    if (rc != 0) return st;
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    struct Step { ggml_tensor * t; int32_t mlpos; std::vector<int32_t> ids; };
+    std::vector<Step> steps = {
+        { g0, 0, {0,1,2} }, { g1, 1, {0,1} }, { g0, 0, {2,3,4,5} },
+        { g1, 1, {2,3,4,5,6,7} }, { g0, 0, {0,0,7} }, { g1, 1, {7,7} }, { g0, 0, {1,6,6} },
+    };
+    for (auto & s : steps) {
+        const int32_t n = (int32_t)s.ids.size();
+        if (ggml_moe_direct_acquire(s.t, s.ids.data(), n, n) != 0) { st.bytes_ok = false; break; }
+        for (int32_t e : s.ids) {
+            const char * nm = s.mlpos == 0 ? "blk.0.ffn_gate_exps.weight" : "blk.1.ffn_gate_exps.weight";
+            if (!verify_ptr_bytes(fx, nm, s.mlpos, 0, e)) st.bytes_ok = false;
+        }
+        ggml_moe_direct_release(s.t, s.ids.data(), n);
+    }
+    st.snap = qd_snapshot(16); // 2층×8expert = 16 record
+    for (int p = 0; p < 2; p++) ggml_moe_direct_phase_read_bytes_hit_miss(p, &st.rb[p], &st.hit[p], &st.miss[p]);
+    st.reads_total = qd_reads_total();
+    st.ok = true;
+    return st;
+}
+
+static void test_qd_lever() {
+    section("M. ★QD 레버 배치 플래너 — dedupe/multiplicity·혼재·뒤쪽 hit 보호·slot0·preflight·pump·PENDING·QD 동등성");
+
+    // ── M1. 중복 ID multiplicity — 같은 expert 2회 요청 → 로드 1회 · lease 2회 · release 후 잔량 0
+    {
+        Fixture fx; qd_setup_2layer(fx, "qd_dup");
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        if (check(rc == 0, "M1a. seal 성공(8슬롯·QD 기본값 1)")) {
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            const uint64_t r0 = qd_reads_total();
+            int32_t ids[2] = { 3, 3 };
+            int arc = ggml_moe_direct_acquire(g0, ids, 2, 1);
+            const uint64_t dr = qd_reads_total() - r0;
+            int32_t leased = -1; int64_t total = -1; ggml_moe_direct_test_lease_stats(&leased, &total);
+            bool ok = (arc == 0) && (dr == 1) && (leased == 1) && (total == 2) &&
+                      verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 3);
+            check(ok, "M1b. ★중복 ID dedupe — 로드 1회·lease 2 (reads=" + std::to_string(dr) +
+                      " leased=" + std::to_string(leased) + " total_lease=" + std::to_string(total) + ")");
+            ggml_moe_direct_release(g0, ids, 2);
+            ggml_moe_direct_test_lease_stats(&leased, &total);
+            check(leased == 0 && total == 0, "M1c. ★release 2회 후 lease 잔량 0(underflow/누수 없음)");
+        }
+    }
+
+    // ── M2. hit+miss 혼재 배치 — hit lease와 miss 로드가 한 배치에서 정합
+    {
+        Fixture fx; qd_setup_2layer(fx, "qd_mixed");
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        if (check(rc == 0, "M2a. seal 성공(8슬롯)")) {
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            int32_t pre[2] = { 0, 1 };
+            ggml_moe_direct_acquire(g0, pre, 2, 1); ggml_moe_direct_release(g0, pre, 2);
+            const uint64_t r0 = qd_reads_total();
+            uint64_t rb0 = 0, h0 = 0, m0 = 0; ggml_moe_direct_phase_read_bytes_hit_miss(0, &rb0, &h0, &m0);
+            int32_t mix[2] = { 1, 2 }; // 1=hit(상주) · 2=miss
+            int arc = ggml_moe_direct_acquire(g0, mix, 2, 1);
+            const uint64_t dr = qd_reads_total() - r0;
+            uint64_t rb1 = 0, h1 = 0, m1 = 0; ggml_moe_direct_phase_read_bytes_hit_miss(0, &rb1, &h1, &m1);
+            int32_t leased = -1; int64_t total = -1; ggml_moe_direct_test_lease_stats(&leased, &total);
+            bool ok = (arc == 0) && (dr == 1) && (h1 - h0 == 1) && (m1 - m0 == 1) &&
+                      (leased == 2) && (total == 2) &&
+                      verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 1) &&
+                      verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 2);
+            check(ok, "M2b. ★hit+miss 혼재 — hit 1·miss 1·read 1·lease 2 (dhit=" + std::to_string(h1 - h0) +
+                      " dmiss=" + std::to_string(m1 - m0) + " reads=" + std::to_string(dr) + ")");
+            ggml_moe_direct_release(g0, mix, 2);
+        }
+    }
+
+    // ── M3. ★뒤쪽 hit victim 보호 — 앞 miss의 victim 선정이 같은 배치 뒤 id가 hit할 슬롯을 축출하지 않음.
+    //    배치: L0e5를 가장 오래된 슬롯에 두고 L1e0..e6로 나머지 7슬롯을 채운 뒤 acquire(L0, {0,5}).
+    //    구 순차 구현이면 e0가 최오래(=L0e5) 슬롯을 축출 → e5도 miss가 되어 read 2회.
+    {
+        Fixture fx; qd_setup_2layer(fx, "qd_backhit");
+        int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        if (check(rc == 0, "M3a. seal 성공(8슬롯=n_expert)")) {
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+            int32_t e5 = 5; ggml_moe_direct_acquire(g0, &e5, 1, 1); ggml_moe_direct_release(g0, &e5, 1); // 최오래 슬롯
+            for (int32_t e = 0; e <= 6; e++) { ggml_moe_direct_acquire(g1, &e, 1, 1); ggml_moe_direct_release(g1, &e, 1); }
+            const uint64_t r0 = qd_reads_total();
+            int32_t ids[2] = { 0, 5 }; // 0=miss(앞) · 5=hit(뒤·최오래 슬롯)
+            int arc = ggml_moe_direct_acquire(g0, ids, 2, 1);
+            const uint64_t dr = qd_reads_total() - r0;
+            bool ok = (arc == 0) && (dr == 1) &&
+                      verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 5) &&
+                      verify_ptr_bytes(fx, "blk.0.ffn_gate_exps.weight", 0, 0, 0);
+            check(ok, "M3b. ★뒤쪽 hit 슬롯 비축출(resolve-all 선보호) — read 1회로 완료(reads=" +
+                      std::to_string(dr) + ", 구 순차라면 2)");
+            ggml_moe_direct_release(g0, ids, 2);
+
+            // ── M3c/M3d: ★LRU tick 논리 요청 순서 회귀(수리 1).
+            //   방금 배치 {0=miss(앞), 5=hit(뒤)}는 논리 순서상 5가 더 최신이어야 한다. tick을
+            //   "hit 전량 → miss 전량"으로 나눠 배정하면 뒤인 5가 더 오래된 tick을 받아 캐시
+            //   압력 하에서 5가 0보다 먼저 축출된다. 직접 관측(last_used 대소)과 행동 관측
+            //   (축출 순서 → read 발생 여부) 둘 다로 잡는다. record_idx = mlpos*8 + expert.
+            bool f0 = false, f5 = false;
+            const uint64_t lu_e0 = qd_record_last_used(/*L0e0*/ 0, f0);
+            const uint64_t lu_e5 = qd_record_last_used(/*L0e5*/ 5, f5);
+            check(f0 && f5 && lu_e5 > lu_e0,
+                  "M3c. ★논리 요청 순서 tick — 뒤 요청(hit e5) last_used(" + std::to_string(lu_e5) +
+                  ") > 앞 요청(miss e0) last_used(" + std::to_string(lu_e0) + ")");
+
+            // 캐시 압력: 미상주 7개를 순차 적재 → 6개가 L1e1..e6 슬롯을, 7번째가 tick 최소 슬롯을
+            // 축출한다. 논리 순서가 맞으면 그 최소 슬롯은 e0(앞), 뒤집혔으면 e5(뒤)다.
+            struct Pr { ggml_tensor * t; int32_t e; };
+            const Pr pressure[7] = { {g1,7},{g0,1},{g0,2},{g0,3},{g0,4},{g0,6},{g0,7} };
+            for (const auto & p : pressure) {
+                int32_t e = p.e;
+                ggml_moe_direct_acquire(p.t, &e, 1, 1);
+                ggml_moe_direct_release(p.t, &e, 1);
