+static int xcpu_seal_store(const XcpuStore & st) {
+    int32_t moe_layers[1] = { 0 };
+    ggml_moe_direct_model md{};
+    md.arch = "synth"; md.n_layer = 1;
+    md.n_expert = st.model.n_expert; md.n_expert_used = st.model.n_expert_used;
+    md.moe_layers = moe_layers; md.n_moe_layers = 1;
+    const std::string sp = st.model.sources[0].path;
+    ggml_moe_direct_source src{};
+    src.path = sp.c_str(); src.bytes = st.model.sources[0].bytes;
+    src.mtime_epoch = st.model.sources[0].mtime;
+    src.data_start = st.model.sources[0].data_start;
+    src.gguf_version = st.model.sources[0].gguf_version;
+    src.alignment = st.model.sources[0].alignment;
+    const std::string dir8 = wide_to_utf8(st.dir);
+    return ggml_moe_direct_seal_for_test(dir8.c_str(), &md, &src, 1,
+                                         (uint64_t) st.n_expert * st.comp.slot_stride_max,
+                                         XCPU_SEAL_TOUCH_ABORT,
+                                         dir8.c_str(), "synth", st.sha.c_str(), "all");
+}
