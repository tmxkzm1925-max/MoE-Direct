+// ★DSV4 단계 — deepseek4_v1 adapter(DSV4_ADAPTER_DESIGN v0.2 §1.5 · §2 단계 3)
+//   P36 = 선택식 동등성(scalar F32 독립 재계산) + ★음성 컨트롤 3오산식
+//   P37 = capability/텐서 파티션 배타 fail-close 픽스처군
+//   P38 = 층 마스크 실행 표면(1·2층 target = not_eligible 행 존재) + 후행 crop(NO_OUTPUT 0)
+//         + descriptor 조건부 필드 `signal_target_layer_ids`
+//   ★픽스처 형상 = **실 모델 형상**이다(capability 가 정확 값으로 잠그므로 축소 불가).
+// ═══════════════════════════════════════════════════════════════════════════
+
+static const int32_t DSV4_N_LAYER  = 43;
+static const int32_t DSV4_N_EXPERT = 256;
+static const int32_t DSV4_N_USED   = 6;
+static const int32_t DSV4_N_EMBD   = 4096;
+static const int32_t DSV4_HASH     = 3;      // = first_target_layer
+static const int32_t DSV4_HC_MULT  = 4;
+static const int32_t DSV4_SHARED   = 1;
+static const int32_t DSV4_GATING   = 4;      // LLAMA_EXPERT_GATING_FUNC_TYPE_SQRT_SOFTPLUS
+static const float   DSV4_W_SCALE  = 1.5f;
+static const int32_t DSV4_VOCAB    = 64;     // tid2eid ne[1] — 신호 축 상수가 아니라 봉인 대상 아님
+
+// ★엔진 CPU 커널과 **바이트 동일** 정의(ggml/src/ggml-cpu/unary-ops.cpp:79 op_softplus).
+static float dsv4_softplus(float x) { return (x > 20.0f) ? x : logf(1.0f + expf(x)); }
+
+// 산식 선택자 — 0 = 계약 산식 · 1~3 = ★음성 컨트롤 3오산식(§1.5).
+enum {
+    DSV4_F_CORRECT = 0,       // TopK(sqrt(softplus(Wx)) + b)
+    DSV4_F_RAW_BIAS,          // ⓐ TopK(Wx + b)                — 변환 누락
+    DSV4_F_SQRTSP_NOBIAS,     // ⓑ TopK(sqrt(softplus(Wx)))    — bias 누락
+    DSV4_F_SQRTSP_OF_SUM,     // ⓒ TopK(sqrt(softplus(Wx + b)))— 가산 시점 오류
+};
+
+// 독립 재계산(모듈 코드 미사용 · scalar F32) — a0_norm[i]=x[i]*w1[i]/w0[i] → GEMV → 산식 → TopK16.
+//   `out_tie_free` = 16위와 17위 점수가 **엄격 부등**인가(= ordered Top16 이 잘 정의된 비동률 픽스처).
+static std::vector<uint16_t> pb_ref_topk16_dsv4(const std::vector<float> & x, const std::vector<float> & w0,
+                                                const std::vector<float> & w1, const std::vector<float> & rt,
+                                                const std::vector<float> & bias, int32_t ne, int32_t nx,
+                                                int formula, bool * out_tie_free = nullptr) {
+    std::vector<float> y((size_t)ne), lg((size_t)nx);
+    for (int32_t i = 0; i < ne; i++) y[(size_t)i] = (x[(size_t)i] * w1[(size_t)i]) / w0[(size_t)i];
+    for (int32_t e = 0; e < nx; e++) {
+        float acc = 0.0f;
+        for (int32_t i = 0; i < ne; i++) acc += rt[(size_t)e * (size_t)ne + (size_t)i] * y[(size_t)i];
+        const float b = bias[(size_t)e];
+        switch (formula) {
+            case DSV4_F_RAW_BIAS:      lg[(size_t)e] = acc + b;                             break;
+            case DSV4_F_SQRTSP_NOBIAS: lg[(size_t)e] = sqrtf(dsv4_softplus(acc));           break;
+            case DSV4_F_SQRTSP_OF_SUM: lg[(size_t)e] = sqrtf(dsv4_softplus(acc + b));       break;
+            default:                   lg[(size_t)e] = sqrtf(dsv4_softplus(acc)) + b;       break;
+        }
+    }
+    std::vector<char> used((size_t)nx, 0);
+    std::vector<uint16_t> ref(16, 0xFFFF);
+    float last = 0.0f, next = 0.0f;
+    const int k = (int)std::min<int32_t>(16, nx);
+    for (int r = 0; r <= k; r++) {                      // k+1 회 = 17위까지 뽑아 동률 여부를 본다
+        int best = -1; float bv = 0.0f;
+        for (int32_t e = 0; e < nx; e++) {
+            if (used[(size_t)e]) continue;
+            if (best < 0 || lg[(size_t)e] > bv) { best = e; bv = lg[(size_t)e]; }
+        }
+        if (best < 0) break;
+        used[(size_t)best] = 1;
+        if (r < k) { ref[(size_t)r] = (uint16_t)best; last = bv; } else { next = bv; }
+    }
+    if (out_tie_free) *out_tie_free = (nx > k) ? (last > next) : true;
+    return ref;
+}
