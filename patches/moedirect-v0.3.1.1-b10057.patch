+// ★인자 추가는 **전부 기본값**이라 기존 호출자(V3P7b)는 한 글자도 안 바뀐다.
+//   shards>1 이면 생성기에 `--shard-by-layer` 를, quant 가 비4K 를 만들면 `--tail-tensor` 를
+//   **자동 동반**한다 — 그 둘은 생성기 계약상 필수 동반이라(장부 A-2-2) 호출자가 잊으면
+//   fail-close 로 죽는다. 잊을 수 있는 것을 호출자에게 맡기지 않는다.
+static bool v3prod_seal(V3ProdArm & a, PbInvFix & inv, const char * tag,
+                        const char * schema, int hidden, const char * qd,
+                        int shards = 1, const char * quant = nullptr,
+                        const char * layer_quant = nullptr) {
+    const std::wstring dir = make_case_dir(tag);
+    const std::wstring log = dir + L"\\gen.log";
+    const std::wstring script = v3prod_script();
+    if (!sh_file_exists(script)) { a.why = "generator script missing"; return false; }
+    sh_resolve_interp(log);
+    if (g_py_env_state != 1) { a.why = "python env unavailable"; return false; }
+
+    a.out = dir + L"\\prod";
+    const std::wstring cl = g_py_interp + sh_q(script) + L" --out " + sh_q(a.out) +
+                            L" --schema " + utf8_to_wide(schema) +
+                            L" --hidden " + utf8_to_wide(std::to_string(hidden)) +
+                            (shards > 1
+                                 ? L" --shards " + utf8_to_wide(std::to_string(shards)) +
+                                       L" --shard-by-layer"
+                                 : std::wstring()) +
+                            (quant ? L" --quant " + utf8_to_wide(quant) : std::wstring()) +
+                            (layer_quant ? L" --layer-quant " + utf8_to_wide(layer_quant)
+                                         : std::wstring()) +
+                            // ★비4K slice 형상은 꼬리 없이는 생산자가 bracket EOF 로 거부한다
+                            //   (장부 A-2-2). 기본 F32/hidden=32 는 불요라 조건부로 붙인다.
+                            ((quant || layer_quant) ? L" --tail-tensor" : std::wstring());
+    const ShProc p = sh_exec(cl, log);
+    if (!p.launched || p.code != 0) {
+        a.why = "generator exit=" + std::to_string((unsigned long)p.code);
+        return false;
+    }
+    json sum;
+    {
+        std::ifstream ifs(a.out + L"\\_fixture_summary.json", std::ios::binary);
+        if (!ifs.good()) { a.why = "summary missing"; return false; }
+        try { ifs >> sum; } catch (...) { a.why = "summary parse"; return false; }
+    }
+    // ★재할당 축 차단(보조 방어 — 1차 안전 근거는 §2-6 의 fill→freeze→포인터 취득 순서다).
+    a.shard_paths.reserve(sum["shards"].size());
+    for (const auto & sp : sum["shards"]) a.shard_paths.push_back(sp.get<std::string>());
+    // ★요청 형상 ↔ 산출 형상 기계 대조(요약이 echo 하는 값을 그대로 믿지 않는다).
+    if ((int)a.shard_paths.size() != shards) {
+        a.why = "shard count mismatch: requested " + std::to_string(shards) +
+                " produced " + std::to_string((int)a.shard_paths.size());
+        return false;
+    }
+    if (sum["schema"].get<std::string>() != std::string(schema)) {
+        a.why = "schema echo mismatch: " + sum["schema"].get<std::string>();
+        return false;
+    }
+    a.arch     = sum["arch"].get<std::string>();
+    a.lock_id  = sum["reference_lock"]["profile_id"].get<std::string>();
+    a.lock_sha = sum["reference_lock"]["expect_sha256"].get<std::string>();
+    a.expects_u8 = sum["expects_dir"].get<std::string>();
+    a.n_expert      = sum["n_expert"].get<int32_t>();
+    a.n_expert_used = sum["n_expert_used"].get<int32_t>();
+    a.n_layer       = sum["n_layer"].get<int32_t>();
+    a.hidden        = sum["hidden"].get<int32_t>();
+    a.slot_stride_max = sum["slot_stride_max"].get<uint64_t>();
+    a.parts_per_layer = sum["parts_per_layer"][0].get<int32_t>();
+    for (const auto & l : sum["moe_layers"]) a.ml.push_back(l.get<int32_t>());
+
+    a.gctxs.assign(a.shard_paths.size(), nullptr);
+    a.gcs.assign(a.shard_paths.size(), nullptr);
+    for (size_t s = 0; s < a.shard_paths.size(); s++) {
+        gguf_init_params gp{};
+        gp.no_alloc = false;
+        gp.ctx      = &a.gctxs[s];
+        a.gcs[s] = gguf_init_from_file(a.shard_paths[s].c_str(), gp);
+        if (!a.gcs[s] || !a.gctxs[s]) {
+            a.why = "gguf reparse: " + a.shard_paths[s];
+            return false;
+        }
+    }
+    // ★등록은 텐서가 **실제로 들어 있는 shard** 에서 찾는다(분산 규칙을 여기서 재현하지 않고
+    //   전 shard 를 훑는다 — 분산 규칙 사본을 소비자에 두지 않기 위해서다).
+    a.routed_per_shard.assign(a.shard_paths.size(), 0);
+    for (const auto & t : sum["source_tensors"]) {
+        const std::string nm = t.get<std::string>();
+        ggml_tensor * tt = nullptr;
+        for (size_t s = 0; s < a.gctxs.size(); s++) {
+            if ((tt = ggml_get_tensor(a.gctxs[s], nm.c_str())) != nullptr) {
+                a.routed_per_shard[s]++;   // ★"몇 번 shard 에서 찾았는가" 집계(신설 arm 주장 3)
+                break;
+            }
+        }
+        if (!tt) { a.why = "tensor missing in every shard: " + nm; return false; }
+        ggml_moe_direct_register(tt, nm.c_str(), /*is_host=*/1);
+    }
+    // ★PhaseB 계열 신호 adapter 해소 — 빼면 `pf_on` 이 false 로 내려가 관문이 "프리페치 OFF"
+    //   를 통과로 오독한다(`v3_pf_arm` 과 같은 이유·같은 순서).
+    PbInvOpt o;
+    pb_build_inventory(inv, a.n_expert, a.hidden, /*n_layer_exec=*/a.n_layer,
+                       /*n_expert_used=*/a.n_expert_used, o);
+    ggml_moe_phaseb_note_family(&inv.fam);
+    if (qd) set_env("MOE_DIRECT_QD", qd);
+
+    ggml_moe_direct_model md{};
+    md.arch          = a.arch.c_str();
+    md.n_layer       = a.n_layer;
+    md.n_expert      = a.n_expert;
+    md.n_expert_used = a.n_expert_used;
+    md.moe_layers    = a.ml.data();
+    md.n_moe_layers  = (int32_t)a.ml.size();
+    md.n_layer_nextn = 0;
+    md.n_embd        = a.hidden;
+    md.f_norm_rms_eps= 1e-6f;
+    a.srcs.clear();
+    a.srcs.reserve(a.shard_paths.size());
+    for (size_t s = 0; s < a.shard_paths.size(); s++) {
+        const std::wstring shard_w = utf8_to_wide(a.shard_paths[s]);
+        ggml_moe_direct_source sd{};
+        sd.path         = a.shard_paths[s].c_str();   // ★수명 계약=§2-6(문자열 내용까지 동결)
+        sd.bytes        = v3_file_size(shard_w);
+        sd.mtime_epoch  = v3_file_mtime_epoch(shard_w);
+        sd.data_start   = (uint64_t)gguf_get_data_offset(a.gcs[s]);
+        sd.gguf_version = (uint32_t)gguf_get_version(a.gcs[s]);
+        sd.alignment    = (uint32_t)gguf_get_alignment(a.gcs[s]);
+        a.srcs.push_back(sd);
+    }
+    const std::string out_u8 = wide_to_utf8(a.out);
+    const int rc = ggml_moe_direct_seal_for_test(out_u8.c_str(), &md,
+                                                 a.srcs.data(), (int32_t)a.srcs.size(),
+                                                 a.slot_stride_max * (uint64_t)a.n_expert, 64,
+                                                 a.expects_u8.c_str(), a.lock_id.c_str(),
+                                                 a.lock_sha.c_str(), nullptr);
+    if (qd) clear_env("MOE_DIRECT_QD");
+    if (rc != 0) {
+        a.why = "seal rc=" + std::to_string(rc) + " stage=" +
+                std::to_string(ggml_moe_direct_test_v3_stage());
+        return false;
+    }
+    a.ok = true;
+    return true;
+}
