+// ===========================================================================
+// 실그래프 parity — 커널 동적 배열(ggml-cpu.c/ops.cpp acquire/release/seen) 경계 실증.
+//   구 128 고정 배열이면 n_as=384에서 GGML_ASSERT abort. ★F3: 결정적 ID로 단일 커널 고유
+//   demand 129/384개(release 배열 변종 회귀) + ID 383 포함 + release lease 0 복귀 assert.
+// ===========================================================================
+static const int64_t GP_K = 32, GP_M = 64, GP_NEMBD = 1024;
+static const int32_t GP_NEXPERT = 384, GP_NUSED = 8;
+
+// n_token·ids_vals(길이 = NUSED*n_token, 값 0..383) 로 stock↔direct parity + release 검증.
+static void run_graph_parity_config(ggml_backend_t backend, int32_t n_token,
+                                     const std::vector<int32_t> & ids_vals, const std::string & tag) {
+    const uint64_t W_BYTES = (uint64_t)GP_K * GP_M * 4;
+    const uint64_t B_BYTES = (uint64_t)GP_NEMBD * 4;
+    SynthModel model; model.arch = "synth"; model.n_expert = GP_NEXPERT; model.n_expert_used = GP_NUSED; model.n_layer = 1;
+    model.sources = { default_source() };
+    SynthLayer L; L.layer = 0;
+    SynthPart w; w.name = "gate.weight"; w.source_tensor = "blk.0.ffn_gate_exps.weight"; w.source_index = 0; w.type = "F32"; w.dims = { GP_K, GP_M, GP_NEXPERT }; w.is_host = true;
+    SynthPart b; b.name = "gate.bias"; b.source_tensor = "blk.0.ffn_gate_exps.bias"; b.source_index = 0; b.type = "F32"; b.dims = { GP_NEMBD, GP_NEXPERT }; b.is_host = true;
+    L.parts = { w, b }; model.layers = { L };
+    Computed comp = compute_layout(model, 4096);
+
+    // 고유 demand 수 계수
+    std::set<int32_t> uniq(ids_vals.begin(), ids_vals.end());
+    int n_uniq = (int)uniq.size();
+
+    std::mt19937 rng(20260724u + (uint32_t)n_token);
+    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+    auto rnd = [&](size_t nf) { std::vector<uint8_t> v(nf * 4); float * fp = (float *)v.data(); for (size_t i = 0; i < nf; i++) fp[i] = dist(rng); return v; };
+    std::vector<std::vector<uint8_t>> wpe(GP_NEXPERT), bpe(GP_NEXPERT);
+    for (int e = 0; e < GP_NEXPERT; e++) { wpe[e] = rnd(GP_K * GP_M); bpe[e] = rnd(GP_NEMBD); }
+
+    std::wstring dir = make_case_dir(tag);
+    // reference_lock 결속 파일들
+    std::string expect_body = synth_expect_body("synth", GP_NEXPERT);
+    std::string sha = sha256_hex(expect_body);
+    { std::ofstream ofs(dir + L"\\synth.expect.json", std::ios::binary | std::ios::trunc); ofs << expect_body; }
+    write_manifest(dir + L"\\manifest.json", build_manifest_json(model, comp, "synth", sha));
+    write_verify_report(dir + L"\\verify_report.json", "synth", sha, sha256_file_hex(dir + L"\\manifest.json"));
+    { // bin = [weight_slice | bias_slice] per expert
+        HANDLE h = CreateFileW((dir + L"\\experts.bin").c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        std::vector<uint8_t> rec((size_t)comp.layers[0].stride, 0);
+        for (int e = 0; e < GP_NEXPERT; e++) {
+            std::fill(rec.begin(), rec.end(), 0);
+            std::memcpy(rec.data() + comp.layers[0].parts[0].part_offset, wpe[e].data(), (size_t)W_BYTES);
+            std::memcpy(rec.data() + comp.layers[0].parts[1].part_offset, bpe[e].data(), (size_t)B_BYTES);
+            DWORD wr = 0; WriteFile(h, rec.data(), (DWORD)rec.size(), &wr, nullptr);
+        }
+        CloseHandle(h);
+    }
+
+    std::vector<float> act_mm((size_t)(GP_K * GP_NUSED * n_token)); for (auto & v : act_mm) v = dist(rng);
+    std::vector<float> act_add((size_t)(GP_NEMBD * GP_NUSED * n_token)); for (auto & v : act_add) v = dist(rng);
+    const size_t gsz = 64;
+    auto make_ctx = []() { ggml_init_params p{}; p.mem_size = ggml_tensor_overhead() * 16 + ggml_graph_overhead_custom(64, false); p.no_alloc = true; return ggml_init(p); };
+
+    // STOCK
+    ggml_context * ctxs = make_ctx();
+    ggml_tensor * ws = ggml_new_tensor_3d(ctxs, GGML_TYPE_F32, GP_K, GP_M, GP_NEXPERT);
+    ggml_tensor * mmb_s = ggml_new_tensor_3d(ctxs, GGML_TYPE_F32, GP_K, GP_NUSED, n_token);
+    ggml_tensor * mmid_s = ggml_new_tensor_2d(ctxs, GGML_TYPE_I32, GP_NUSED, n_token);
+    ggml_tensor * mmo_s = ggml_mul_mat_id(ctxs, ws, mmb_s, mmid_s);
+    ggml_tensor * bs = ggml_new_tensor_2d(ctxs, GGML_TYPE_F32, GP_NEMBD, GP_NEXPERT);
+    ggml_tensor * adda_s = ggml_new_tensor_3d(ctxs, GGML_TYPE_F32, GP_NEMBD, GP_NUSED, n_token);
+    ggml_tensor * addid_s = ggml_new_tensor_2d(ctxs, GGML_TYPE_I32, GP_NUSED, n_token);
+    ggml_tensor * addo_s = ggml_add_id(ctxs, adda_s, bs, addid_s);
+    ggml_backend_buffer_ptr bufs(ggml_backend_alloc_ctx_tensors(ctxs, backend));
+    if (!check(bufs != nullptr, tag + ": stock 버퍼 할당")) { ggml_free(ctxs); return; }
+    for (int e = 0; e < GP_NEXPERT; e++) { ggml_backend_tensor_set(ws, wpe[e].data(), (size_t)e * ws->nb[2], (size_t)W_BYTES); ggml_backend_tensor_set(bs, bpe[e].data(), (size_t)e * bs->nb[1], (size_t)B_BYTES); }
+    ggml_backend_tensor_set(mmb_s, act_mm.data(), 0, act_mm.size() * 4);
+    ggml_backend_tensor_set(mmid_s, ids_vals.data(), 0, ids_vals.size() * 4);
+    ggml_backend_tensor_set(adda_s, act_add.data(), 0, act_add.size() * 4);
+    ggml_backend_tensor_set(addid_s, ids_vals.data(), 0, ids_vals.size() * 4);
+    ggml_cgraph * gs = ggml_new_graph_custom(ctxs, gsz, false);
+    ggml_build_forward_expand(gs, mmo_s); ggml_build_forward_expand(gs, addo_s);
+    ggml_backend_graph_compute(backend, gs);
+    std::vector<uint8_t> mmo_sb(ggml_nbytes(mmo_s)); ggml_backend_tensor_get(mmo_s, mmo_sb.data(), 0, mmo_sb.size());
+    std::vector<uint8_t> addo_sb(ggml_nbytes(addo_s)); ggml_backend_tensor_get(addo_s, addo_sb.data(), 0, addo_sb.size());
+
+    // DIRECT
+    ggml_context * ctxd = make_ctx();
+    ggml_tensor * wd = ggml_new_tensor_3d(ctxd, GGML_TYPE_F32, GP_K, GP_M, GP_NEXPERT); ggml_set_name(wd, "blk.0.ffn_gate_exps.weight");
+    ggml_tensor * bd = ggml_new_tensor_2d(ctxd, GGML_TYPE_F32, GP_NEMBD, GP_NEXPERT); ggml_set_name(bd, "blk.0.ffn_gate_exps.bias");
+    ggml_tensor * mmb_d = ggml_new_tensor_3d(ctxd, GGML_TYPE_F32, GP_K, GP_NUSED, n_token);
+    ggml_tensor * mmid_d = ggml_new_tensor_2d(ctxd, GGML_TYPE_I32, GP_NUSED, n_token);
+    ggml_tensor * mmo_d = ggml_mul_mat_id(ctxd, wd, mmb_d, mmid_d);
+    ggml_tensor * adda_d = ggml_new_tensor_3d(ctxd, GGML_TYPE_F32, GP_NEMBD, GP_NUSED, n_token);
+    ggml_tensor * addid_d = ggml_new_tensor_2d(ctxd, GGML_TYPE_I32, GP_NUSED, n_token);
+    ggml_tensor * addo_d = ggml_add_id(ctxd, adda_d, bd, addid_d);
+    ggml_moe_direct_register(wd, "blk.0.ffn_gate_exps.weight", 1);
+    ggml_moe_direct_register(bd, "blk.0.ffn_gate_exps.bias", 1);
+    ggml_backend_buffer_t bufd = ggml_backend_alloc_ctx_tensors(ctxd, backend); // 보호되므로 미해제(의도)
+    if (!check(bufd != nullptr, tag + ": direct 버퍼 할당")) { ggml_moe_direct_reset_for_test(); ggml_free(ctxs); ggml_free(ctxd); return; }
+    ggml_backend_tensor_set(mmb_d, act_mm.data(), 0, act_mm.size() * 4);
+    ggml_backend_tensor_set(mmid_d, ids_vals.data(), 0, ids_vals.size() * 4);
+    ggml_backend_tensor_set(adda_d, act_add.data(), 0, act_add.size() * 4);
+    ggml_backend_tensor_set(addid_d, ids_vals.data(), 0, ids_vals.size() * 4);
+
+    int32_t moe_layers[1] = { 0 };
+    ggml_moe_direct_model md{}; md.arch = "synth"; md.n_layer = 1; md.n_expert = GP_NEXPERT; md.n_expert_used = GP_NUSED; md.moe_layers = moe_layers; md.n_moe_layers = 1;
+    std::string sp = model.sources[0].path;
+    ggml_moe_direct_source src{}; src.path = sp.c_str(); src.bytes = model.sources[0].bytes; src.mtime_epoch = model.sources[0].mtime; src.data_start = model.sources[0].data_start; src.gguf_version = model.sources[0].gguf_version; src.alignment = model.sources[0].alignment;
+    int rc_seal = ggml_moe_direct_seal_for_test(wide_to_utf8(dir).c_str(), &md, &src, 1,
+                                                (uint64_t)GP_NEXPERT * comp.slot_stride_max, 64,
+                                                wide_to_utf8(dir).c_str(), "synth", sha.c_str(), "all");
+    if (!check(rc_seal == 0, tag + ": seal 성공(n_slots=384)")) { ggml_moe_direct_reset_for_test(); ggml_free(ctxs); ggml_free(ctxd); return; }
+
+    ggml_cgraph * gd = ggml_new_graph_custom(ctxd, gsz, false);
+    ggml_build_forward_expand(gd, mmo_d); ggml_build_forward_expand(gd, addo_d);
+    ggml_status std_ = ggml_backend_graph_compute(backend, gd);
+    bool cok = (std_ == GGML_STATUS_SUCCESS);
+    std::vector<uint8_t> mmo_db(ggml_nbytes(mmo_d)); ggml_backend_tensor_get(mmo_d, mmo_db.data(), 0, mmo_db.size());
+    std::vector<uint8_t> addo_db(ggml_nbytes(addo_d)); ggml_backend_tensor_get(addo_d, addo_db.data(), 0, addo_db.size());
+    bool mmeq = mmo_sb.size() == mmo_db.size() && std::memcmp(mmo_sb.data(), mmo_db.data(), mmo_sb.size()) == 0;
+    bool addeq = addo_sb.size() == addo_db.size() && std::memcmp(addo_sb.data(), addo_db.data(), addo_sb.size()) == 0;
+    bool touch0 = (ggml_moe_direct_touch_events() == 0 && ggml_moe_direct_fallback_count() == 0);
+    // ★release lease 0 복귀(커널 moe_release_ids 동적 배열이 전 demand 해제했는지)
+    int32_t leased = -1; int64_t total = -1; ggml_moe_direct_test_lease_stats(&leased, &total);
+    bool relok = (leased == 0 && total == 0);
+    check(cok && mmeq && addeq && touch0 && relok,
+          tag + ": ★고유 demand " + std::to_string(n_uniq) + "개(" + std::to_string(n_token) +
+          "토큰) 실커널 parity(MUL_MAT_ID+ADD_ID memcmp) + touch/fallback 0 + release lease 0 복귀");
+
+    ggml_moe_direct_reset_for_test();
+    ggml_free(ctxs); ggml_free(ctxd);
+}
