+        static const char * kD[] = { "adapter","arch","norm_tensor","selection_fn","bias_snapshot",
+                                     "capture_width","n_expert","n_expert_used","n_moe_layers","moe_layer_ids",
+                                     "output_crop_before_last_moe","signal_target_layer_ids" };
+        for (const char * k : kD) if (!d.contains(k)) desc_ok = false;
+        if (d.size() != 12) desc_ok = false;
+        desc_ok = desc_ok && d.value("adapter","") == "deepseek4_v1" && d.value("arch","") == "deepseek4" &&
+                  d.value("norm_tensor","") == "ffn_norm" &&
+                  d.value("selection_fn","") == "topk_sqrt_softplus_bias" &&
+                  d.value("bias_snapshot","") == "ffn_exp_probs_b[]" &&
+                  d.value("capture_width", 0) == DSV4_N_EMBD && d.value("n_expert", 0) == DSV4_N_EXPERT &&
+                  d.value("n_expert_used", 0) == DSV4_N_USED &&
+                  d.value("n_moe_layers", 0) == DSV4_N_LAYER &&
+                  d.value("output_crop_before_last_moe", true) == false &&
+                  d["signal_target_layer_ids"].is_array() &&
+                  d["signal_target_layer_ids"].size() == (size_t)(DSV4_N_LAYER - DSV4_HASH);
+        if (desc_ok) {
+            for (size_t i = 0; i < d["signal_target_layer_ids"].size(); i++)
+                if (d["signal_target_layer_ids"][i].get<int>() != (int)(DSV4_HASH + i)) desc_ok = false;
+        }
