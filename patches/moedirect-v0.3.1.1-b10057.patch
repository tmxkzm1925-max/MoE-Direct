+// ===========================================================================
+// V3i — 원자 A6: 프리필 coalescing (SPEC_REPACK_V3 §3-6 7조건 + §5 파라미터)
+//
+// 관문(§6-4): [양성 ④] coalesced run scatter 일치 — 합쳐 읽고 흩뿌린 바이트가 원본 슬라이스와
+// 정확히 같다. [네거티브] **7조건 각각을 위반시켰을 때 합쳐지지 않는다** — "안 합쳐졌다"만
+// 보면 어느 조건이 막았는지 알 수 없으므로, 계획 판정 코드(`last_reject`)로 **거부 지점을
+// 지목**한다(A1 의 stage 래치와 같은 규율).
+//
+// ★이 그룹이 R18 의 V3g3 를 **발화**시킨다: §5-6 의 cardinality 식·copies 조인은 coalesce 열을
+//   이미 담고 있었지만, 합침이 한 번도 안 돌아 그 항이 늘 0 이었다. 여기서 처음으로 값이 선다.
+// ===========================================================================
+
+// 합침이 도는 조합: prefill + min 하한 해제 + copy 큐를 run 길이만큼(§5-6 copy queue cap 이
+// 대조하는 값이 곧 run 상한이다 — `run_max = io_bounce_copy_qd / parts`).
+struct V3CoalEnv {
+    EnvGuard phase, min_b, max_b, copy_qd;
+    V3CoalEnv(const char * ph, const char * mn, const char * mx, const char * qd)
+        : phase("MOE_DIRECT_IO_COALESCE_PHASE", ph),
+          min_b("MOE_DIRECT_IO_COALESCE_MIN_BYTES", mn),
+          max_b("MOE_DIRECT_IO_COALESCE_MAX_BYTES", mx),
+          copy_qd("MOE_DIRECT_IO_BOUNCE_COPY_QD", qd) {}
+};
+
+struct V3CoalStat {
+    int32_t  phase = 0, buffers = 0, slots = 0, reject = 0, copy_outstanding = 0;
+    uint32_t mask = 0;
+    uint64_t min_b = 0, max_b = 0, groups = 0, records = 0, scatters = 0;
+    uint64_t reads_retired = 0, credit_stalls = 0;
+    void snap() {
+        ggml_moe_direct_test_v3_coalesce_stats(&phase, &min_b, &max_b, &buffers, &slots,
+                                               &groups, &records, &scatters, &reject, &mask,
+                                               &reads_retired, &copy_outstanding, &credit_stalls);
+    }
+    // ★"안 합쳐졌다"가 아니라 **그 조건이 막았다**를 주장한다. 한 acquire 가 pump 를 여러 번
+    //   돌리므로 마지막 패스(후보 1건)는 늘 R_RUN 이라 직전 값으로는 지목이 안 된다.
+    bool blocked_by(int32_t r) const { return (mask & (1u << r)) != 0; }
+    std::string tag() const {
+        char b[16];
+        snprintf(b, sizeof(b), "%x", (unsigned)mask);
+        return "groups=" + std::to_string((unsigned long long)groups) +
+               " records=" + std::to_string((unsigned long long)records) +
+               " reads_retired=" + std::to_string((unsigned long long)reads_retired) +
+               " credit_out=" + std::to_string(copy_outstanding) +
+               " credit_stalls=" + std::to_string((unsigned long long)credit_stalls) +
+               " reject=" + std::to_string(reject) + " mask=0x" + std::string(b);
+    }
+};
+
+static const char * v3_coal_reject_name(int32_t r) {
+    switch (r) {
+        case 0:  return "합침";
+        case 1:  return "off";
+        case 2:  return "phase(§3-6 프리필 한정)";
+        case 3:  return "동질성(§5-4 8번째 MUST)";
+        case 4:  return "연속 run(②)";
+        case 5:  return "source(①)";
+        case 6:  return "경계(③)";
+        case 7:  return "정렬·용량(④)";
+        case 8:  return "claim·pin(⑤)";
+        case 9:  return "min(§5)";
+        case 10: return "자원";
+        default: return "?";
+    }
+}
