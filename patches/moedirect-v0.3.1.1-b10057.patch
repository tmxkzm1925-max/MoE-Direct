+// ===========================================================================
+// V3e — 원자 A3: child scheduler(팬아웃 제출·회수·terminal 계약·실패 규칙)
+//
+// ★이 그룹이 A3 의 본 관문이다. 계획 §4-2 규율: 동시성 상태기계는 정적 검토로 닫지 않는다 —
+//   §6-4 네거티브 ⑩ 이 요구하는 경로(out-of-order · immediate/pending 혼합 · 1 child
+//   short/error · stale generation · shutdown success-after-cancel)를 **각각 실제로 발화**시킨다.
+//   실 저장장치는 완료 순서·부분 read 를 재현해주지 않으므로 발화 창구는
+//   `ggml_moe_direct_test_v3_arm()` one-shot 이다(프로덕션 0).
+// ===========================================================================
+
+// ★R11(교차 r5 Y2) — 구현은 앞·뒤 64B 만 봤는데 문면은 "정확 일치"였다. **슬라이스 전장**을
+//   비교하도록 올린다(4KB급 memcmp 는 싸다). 부분 비교는 중간 구간 오프셋 오류를 놓친다.
+static bool v3_verify_ptr_bytes(V3Fixture & fx, int32_t mlpos, int32_t pidx, int32_t expert) {
+    if (mlpos < 0 || (size_t)mlpos >= fx.model.layers.size()) return false;
+    const auto & parts = fx.model.layers[(size_t)mlpos].parts;
+    if (pidx < 0 || (size_t)pidx >= parts.size()) return false;
+    const V3Part & part = parts[(size_t)pidx];
+    ggml_tensor * t = fx.find(part.source_tensor);
+    if (!t) return false;
+    const uint8_t * ptr = (const uint8_t *)ggml_moe_direct_ptr(t, expert);
+    if (!ptr) return false;
+    // ★C1(초안 C §2 H3): 기대값을 재생성하지 않는다(구판 bin_hash(seed+base+j) 는 손수 픽스처의 내용 규약이었다).
+    //   원본 shard GGUF 의 그 자리를 읽어 **전장** 대조한다 — V3PRODM oracle 재사용(§6-3 #2 · 두 벌 금지).
+    std::string why;
+    return v3prod_parity_vs_source(fx.shard_path[(size_t)part.source_index], part.abs_offset,
+                                   part.slice_bytes, expert, ptr, why);
+}
+
+// A3 시나리오 공용 — seal 까지 세우고 픽스처를 살려둔 채 돌려준다(호출자가 acquire 한다).
+struct V3Live {
+    bool ok = false;
+    std::string why;
+};
+static V3Live v3_seal_live(V3Fixture & fx, const char * tag, int32_t n_shards, const char * qd,
+                           bool bounce_model = false, bool head_model = false) {
+    V3Live out;
+    fx.dir   = make_case_dir(tag);
+    fx.model = head_model   ? bounce_head_v3_model(n_shards)
+             : bounce_model ? bounce_v3_model(n_shards)
+             :                default_v3_model(n_shards);
+    if (!fx.build(out.why)) return out;
+    if (qd) set_env("MOE_DIRECT_QD", qd);
+    std::vector<int32_t> ml;
+    ggml_moe_direct_model md = fx.model_desc(ml);
+    std::vector<ggml_moe_direct_source> sd = fx.source_descs();
+    const std::string dir_utf8 = wide_to_utf8(fx.dir);
+    const int rc = ggml_moe_direct_seal_for_test(dir_utf8.c_str(), &md, sd.data(), (int32_t)sd.size(),
+                                                 fx.budget(), 64, fx.expects_u8.c_str(),
+                                                 fx.ref_profile_id.c_str(), fx.ref_expect_sha256.c_str(), nullptr);
+    if (qd) clear_env("MOE_DIRECT_QD");
+    out.ok = (rc == 0);
+    if (!out.ok) out.why = "seal rc=" + std::to_string(rc) +
+                           " stage=" + std::to_string(ggml_moe_direct_test_v3_stage());
+    return out;
+}
+
+// ★재개봉 R2ⓐ — direct demand child 실패 death-test(자식 프로세스).
+//   §3-4 는 direct demand 실패를 `fail-closed(fatal)` 로 규정한다. fatal 은 프로세스를 죽이므로
+//   부모에서 관측할 수 없다 — VEH death-test 와 같은 형식으로 자식에서 친다.
+//   기대: 자식은 `fatal_abort` 로 **죽는다**. 살아서 0/66 으로 끝나면 게이트가 demand 를 retry 로
+//   삼킨 것이고(구 결함), 77 은 픽스처 자체 실패다.
+static int run_v3_demand_fatal_child() {
+    init_scratch_root();
+    V3Fixture * fx = new V3Fixture();   // 죽으므로 해제 불요
+    V3Live lv = v3_seal_live(*fx, "v3_demand_fatal", /*n_shards=*/1, "8");
+    if (!lv.ok) { fprintf(stderr, "v3-demand-fatal-child: seal 실패 (%s)\n", lv.why.c_str()); return 77; }
+    ggml_tensor * gate0 = fx->find("blk.0.ffn_gate_exps.weight");
+    if (!gate0) { fprintf(stderr, "v3-demand-fatal-child: 텐서 조회 실패\n"); return 77; }
+    // part 1 의 child 하나만 실패시킨다. ★형제(part 0)의 정상 완료는 **구조 보장이 아니다** —
+    //   실패 래치가 busy 형제를 `CancelIoEx` 하므로 취소될 수 있다(r2 F5·§H-5 축소분과 같은 실태).
+    //   이 death-test 가 잠그는 것은 형제 결과가 아니라 **demand 실패가 retry 로 삼켜지지 않고
+    //   fail-closed 로 죽는다**는 것뿐이다.
+    ggml_moe_direct_test_v3_arm(/*reverse=*/-1, /*fail_child=*/1, /*fail_after=*/-1);
+    int32_t ids[1] = { 4 };
+    const int arc = ggml_moe_direct_acquire(gate0, ids, 1, 1);
+    fprintf(stderr, "v3-demand-fatal-child: fatal 미발생 — acquire rc=%d (계약 위반: demand 실패가 "
+                    "retry 로 삼켜졌다)\n", arc);
+    return 66;
+}
