+// ── 픽스처 ②. 128E wrap — 0→64·63→127·64→0·127→63 + 16개 범위/유일성 + echo 비-null ──
+static void test_pb_hint_wrap_128e() {
+    section("P25-②. ★128E rot wrap — 0→64·63→127·64→0·127→63 · 16개 범위/유일성 · echo {rule,offset,n_expert}");
+    Fixture fx; pb_setup_2layer(fx, "pb_hint_wrap", PB_HINT_N_EXPERT);
+    const std::wstring mpath = fx.dir + L"\\metrics.jsonl";
+    PbEnv env("4", "8", "2", "trace", nullptr, wide_to_utf8(mpath).c_str());
+    PbHintEnv hint("rot", "1");
+    if (!check(fx.seal((uint64_t)PB_HINT_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+               "P25-②a. seal 성공(128E · rot + MOE_DIRECT_QUALIFY=1)")) return;
+    check(ggml_moe_phaseb_test_hint_rule() == GGML_MOE_PHASEB_TEST_HINT_ROT &&
+          std::string(ggml_moe_phaseb_test_hint_rule_name()) == "rot" &&
+          ggml_moe_phaseb_test_hint_offset() == PB_HINT_N_EXPERT / 2,
+          "P25-②b. 규칙 rot · offset = ⌊128/2⌋ = " + std::to_string(ggml_moe_phaseb_test_hint_offset()));
