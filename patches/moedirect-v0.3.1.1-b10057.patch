+static void test_v3_coalesce() {
+    section("V3i. mode=virtual 원자 A6 — 프리필 coalescing(§3-6 7조건 · §5 파라미터 · §5-4 wire 축)");
+
+    // ---- ★★양성 §6-4 ④ — 합쳐 읽고 흩뿌린 바이트가 정확하다 ----
+    {
+        V3CoalEnv env("prefill", "0", "67108864", "16");   // run 상한 = 16/2 = 8 = n_expert
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a6_pos", /*n_shards=*/1, "8");
+        if (!check(lv.ok, "V3i1a. coalescing on 픽스처 seal [" + lv.why + "]")) {
+            ggml_moe_direct_reset_for_test();
+        } else {
+            V3CoalStat s0; s0.snap();
+            check(s0.phase == 1 && s0.slots == s0.buffers * 2 && s0.slots > 0,
+                  "V3i1b. 파라미터 해소 — phase=prefill · 버퍼 " + std::to_string(s0.buffers) +
+                  "그룹 × part 2 = " + std::to_string(s0.slots) + "칸 확보(기본 off 이므로 이 칸은 "
+                  "명시 opt-in 에서만 생긴다)");
+
+            uint64_t rf0 = 0;
+            ggml_moe_direct_test_v3_io_stats(nullptr, nullptr, nullptr, nullptr, &rf0, nullptr, nullptr);
+            ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+            std::vector<int32_t> ids;
+            for (int32_t e = 0; e < 8; e++) ids.push_back(e);
+            // ★n_tokens_hint > 1 = PREFILL(§3-6 이 합침을 허용하는 유일한 phase).
+            const int arc = ggml_moe_direct_acquire(gate0, ids.data(), 8, /*n_tokens_hint=*/8);
+            uint64_t rf1 = 0;
+            ggml_moe_direct_test_v3_io_stats(nullptr, nullptr, nullptr, nullptr, &rf1, nullptr, nullptr);
+            V3CoalStat s1; s1.snap();
+
+            // ★"합쳐졌다"의 실증 = **물리 read 수**다. 안 합치면 record 8 × part 2 = 16 건이고,
+            //   run 8 로 합치면 part 당 1건씩 2건이다.
+            check(arc == 0 && s1.groups == 2 && s1.records == 8 && (rf1 - rf0) == 2,
+                  "V3i1. ★★합침 성립 — 대구간 " + std::to_string((unsigned long long)s1.groups) +
+                  "건(part 당 1) · 참가 record " + std::to_string((unsigned long long)s1.records) +
+                  " · **물리 demand read " + std::to_string((unsigned long long)(rf1 - rf0)) +
+                  "건**(합치지 않으면 16건) [acquire rc=" + std::to_string(arc) + " " + s1.tag() + "]");
+
+            bool parity = true;
+            for (int32_t e = 0; e < 8; e++) {
+                parity = parity && v3_verify_ptr_bytes(fx, 0, 0, e);
