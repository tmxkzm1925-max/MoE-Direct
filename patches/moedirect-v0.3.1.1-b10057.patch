+// ═══════════════════════════════════════════════════════════════════════════
+// ★P33 — 어댑터 norm 원소별 exact-zero inventory
+//   (FROZEN_NORM_INVENTORY §3 검사 정의 · §4 echo 계약 · §7 397B 검증 벡터 · §8 selftest 목록)
+//
+//   엔진의 보정 분모는 **source 층 norm** 이고 원소 1개가 `0.0f` 이면 그 층을 source 로 쓰는
+//   target 의 예측이 전량 무효(NORM_ZERO)다. 런타임은 첫 zero 에서 break 하므로 "몇 개·어디"는
+//   seal 시점 static 인벤토리만 볼 수 있다 — 이 절이 그 인벤토리의 회귀 잠금이다.
+// ═══════════════════════════════════════════════════════════════════════════
+
+// §3.3 digest 의 **독립 재구현**(모듈 코드 미사용): FNV-1a 64 over little-endian 연접
+//   `(u16 source_layer)(u32 zero_count)(u32 zero_index...)` · zero_index 오름차순.
+//   (x86 는 스칼라의 메모리 표현이 곧 little-endian 이라 raw 바이트 주입이 규범과 동치다.)
+static uint64_t nz_ref_digest(int32_t source_layer, const std::vector<uint32_t> & idx) {
+    uint64_t h = 0xcbf29ce484222325ull;
+    auto feed = [&](const void * p, size_t n) {
+        const uint8_t * b = (const uint8_t *)p;
+        for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 0x100000001b3ull; }
+    };
+    const uint16_t sl = (uint16_t)source_layer;
+    const uint32_t zc = (uint32_t)idx.size();
+    feed(&sl, sizeof(sl));
+    feed(&zc, sizeof(zc));
+    for (size_t i = 0; i < idx.size(); i++) feed(&idx[i], sizeof(uint32_t));
+    return h;
+}
+static std::string nz_hex(uint64_t v) {
+    char b[32]; snprintf(b, sizeof(b), "0x%016llx", (unsigned long long)v); return std::string(b);
+}
+// n 층 연속 qwen35moe 형상(관리 MoE 층 = 0..n-1)을 세우고 norm 주입점을 심어 descriptor 를 선언한다.
+static void nz_setup(Fixture & fx, const std::wstring & dir, int32_t n_layer, int32_t n_embd,
+                     const std::vector<PbNormPoke> & poke) {
+    fx.dir = dir;
+    fx.model.arch = "synth"; fx.model.n_expert = PB_TEST_N_EXPERT; fx.model.n_expert_used = 2;
+    fx.model.n_layer = n_layer; fx.model.n_embd = n_embd; fx.model.f_norm_rms_eps = 1e-6f;
+    fx.model.sources = { default_source() };
+    fx.model.layers.clear();
+    for (int32_t l = 0; l < n_layer; l++)
+        fx.model.layers.push_back(make_separate_layer(l, PB_TEST_N_EXPERT, "MXFP4", false));
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.build();
+    PbInvFix F; PbInvOpt o; o.norm_poke = poke;
+    pb_build_inventory(F, PB_TEST_N_EXPERT, n_embd, n_layer, /*n_expert_used=*/2, o);
+    ggml_moe_phaseb_note_family(&F.fam);   // 즉시 판정·복사
+}
