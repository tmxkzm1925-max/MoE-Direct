+            ggml_moe_phaseb_test_stamp_override(0, 0, 0);
+            ggml_moe_direct_test_hold_retire(0);
+            ggml_moe_direct_test_pb_quiesce(3000);
+            ggml_moe_direct_finalize();
+
+            // ★파일 경유 — 메모리 버퍼가 아니라 **디스크에 쓰인 320B 레코드**를 다시 읽는다.
+            std::vector<ggml_moe_phaseb_ledger> from_file;
+            const uint64_t fsz = pb5ct_read_ledger_file(md + L"\\pb_ledger.pb", from_file);
+            std::set<uint32_t> qd_seen;
+            int window_both = 0;
+            for (const auto & e : from_file) {
+                if (e.kind == GGML_MOE_PB_L_ADMISSION_DECISION &&
+                    !(e.flags & GGML_MOE_PB_L_F_CONTINUATION) && e.stamp_qd != 0)
+                    qd_seen.insert(e.stamp_qd);
+                if (e.kind == GGML_MOE_PB_L_ADMISSION_DECISION &&
+                    e.disposition == GGML_MOE_PB_D_DROP_PREFETCH_CAP && e.n_part_stored > 0) {
+                    bool other = false;
+                    for (uint16_t i = 0; i < e.n_part_stored; i++)
+                        if (e.participants[i].request_epoch != e.request_epoch) other = true;
+                    if (other) window_both++;
+                }
+            }
+            const Pb5ctReduce pos = pb5ct_reduce(from_file, 2);
+            check(fsz > 128 && from_file.size() >= 3 && qd_seen.size() == 2 &&
+                  window_both >= 1 && pos.mixed_tuple,
+                  "P45i2. ★mixed_tuple 양성(**실 wire·파일 경유**) — producer 가 쓴 `pb_ledger.pb` " +
+                  std::to_string(fsz) + "B 를 320B 단위로 재파싱하니 서로 다른 owner 튜플 " +
+                  std::to_string(qd_seen.size()) + "종(QD=4/5)이 실재하고, 두 generation 을 함께 담은 "
+                  "participant window " + std::to_string(window_both) + "건에서 판정이 true 다");
+
+            // 음성 대조 — 같은 파일 레코드에서 튜플만 일치시키면 false 로 되돌아온다
+            //   (판정이 window 안 튜플 차이 때문임을 분리 증명).
+            std::vector<ggml_moe_phaseb_ledger> normalized = from_file;
+            for (auto & e : normalized) if (e.stamp_qd != 0) e.stamp_qd = 4;
+            const Pb5ctReduce ctrl = pb5ct_reduce(normalized, 2);
+            check(!ctrl.mixed_tuple,
+                  "P45i3. ★분리 대조 — 같은 파일 레코드에서 owner 튜플만 일치시키면 판정이 false 로 "
+                  "되돌아온다(다른 요인이 아니라 **window 안 튜플 혼재**가 판정 근거임을 확정)");
+        }
+    }
+
+    // ── ⑦ `mode=off + prefetch=off + collect=on`(r1 M5 fast-gate) ──────────────────────
+    {
+        std::wstring md = make_case_dir("pb5ct_conly");
+        PbCollectEnv ce("on");
+        PbEnv env("4", nullptr, nullptr, "off", wide_to_utf8(md + L"\\pb").c_str(),
+                  wide_to_utf8(md + L"\\m.jsonl").c_str());
+        Fixture fx; pb_setup_2layer(fx, "pb5ct_conly_fx");
+        if (check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+                  "P45j0. seal 성공(mode=off·prefetch=off·collect=on)")) {
+            check(ggml_moe_phaseb_all_off() == false && ggml_moe_phaseb_collect_on(),
+                  "P45j. ★수집 축 독립 fast-gate — `mode=off + prefetch=off` 라도 collect=on 이면 "
+                  "`all_off` 가 서지 않는다(구 판은 collect 를 무시해 run lifecycle 자체가 "
+                  "만들어지지 않았다 — r1 M5)");
+            ggml_moe_phaseb_run_begin();
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            std::vector<int32_t> ids = {0,1,2};
+            ggml_moe_direct_acquire(g0, ids.data(), 3, 1);
+            ggml_moe_direct_release(g0, ids.data(), 3);
+            ggml_moe_phaseb_run_end();
+            ggml_moe_direct_finalize();
+            const json r0 = pb5ct_run_record_of(md + L"\\m.jsonl", 0);
+            const bool lifecycle = r0.is_object() && r0.contains("generation_lifecycle") &&
+                                   r0["generation_lifecycle"].contains("admission_seq") &&
+                                   !r0["generation_lifecycle"]["admission_seq"].is_null() &&
+                                   !r0["generation_lifecycle"]["terminal_seq"].is_null();
+            check(lifecycle,
+                  "P45k. ★collect-only 조합의 request lifecycle — request 0 의 phase_b_run 이 실제로 "
+                  "발급되고 generation admission/terminal 순번이 채워진다(NA bucket 0 로 뭉개지지 않음)");
+        }
+    }
+
+    // ── ⑨ **partition 확정 helper 의 회계 멱등**(r2 M7-1 → r3 라벨 축소) ────────────────
+    //   ★정직 고지: "중복 terminal" 은 **현 call graph 에서 도달 불가**다(Codex r2·r3 두 라운드
+    //   교차 확인 — 채널을 idle 로 되돌리고 queue 커서를 전진시킨 뒤에야 terminal 을 부른다).
+    //   프로젝트 도달성 게이트(유발 입력이 실 도달 가능할 때만 수정)에 따라 **terminal-once
+    //   latch 는 추가하지 않았고**, 이 검사도 진짜 terminal 재진입 검사가 **아니다**.
+    //   잠그는 것은 딱 하나 — 같은 op 에 4분할 확정 helper 를 두 번 태웠을 때 **회계가 멱등**
+    //   (카운터·QD·ledger 증가 0)이라는 것. 구 P44q 의 finalize() 2차 호출 우회보다는 실질이 있다.
+    {
+        struct DupCase { const char * tag; int mode; const char * name; };
+        //   mode 0 = joined 성공(SUCCESS_PUBLISHED · partition=used_join)
+        //        1 = speculative 오류(ERROR_UNPUBLISHED)
+        //        2 = abort 취소(CANCELLED_UNPUBLISHED / CANCEL_SUCCESS_UNPUB · 1건)
+        //        3 = abort 취소 다중 in-flight(취소 계열 enum 3 커버리지 확보 시도)
+        const DupCase cases[] = {
+            { "pb5ct_dup_ok",  0, "SUCCESS_PUBLISHED(joined → used_join)" },
+            { "pb5ct_dup_err", 1, "ERROR_UNPUBLISHED(→ resolved_wasted)" },
+            { "pb5ct_dup_can", 2, "CANCEL 계열(→ resolved_wasted)" },
+            { "pb5ct_dup_can3",3, "CANCEL 계열 다중 in-flight(enum 3 커버리지)" },
+        };
+        int covered = 0, clean = 0;
+        std::string seen_status;
+        for (const auto & cs : cases) {
+            std::wstring md = make_case_dir(cs.tag);
+            PbCollectEnv ce("on");
+            PbEnv env("4", "8", "2", "trace", wide_to_utf8(md + L"\\pb").c_str(), nullptr);
+            Fixture fx; pb_setup_2layer(fx, cs.tag);
+            if (fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) != 0) continue;
+            ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+            std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+            ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+            ggml_moe_direct_release(g1, pre.data(), 7);
+            ggml_moe_phaseb_test_dup_terminal_arm(1);
+            if (cs.mode == 1) ggml_moe_direct_test_pb_fault_next(1);
+            if (cs.mode == 0) {
+                // joined 성공 — 프리페치를 in-flight 로 잡고 그 사이 demand 가 join 한다.
+                ggml_moe_direct_test_hold_retire(1);
+                std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+                ggml_moe_phaseb_test_push_intent(0, 0, 0, 0, 1, ids.data(), 8);
+                for (int i = 0; i < 400; i++) {
+                    int32_t l = 0; int64_t t = 0; ggml_moe_direct_test_lease_stats(&l, &t);
+                    if (ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED) > 0) break;
+                    Sleep(1);
+                }
+                const uint64_t uj0 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN);
+                int32_t e0 = 0;
+                std::thread th([&]() { ggml_moe_direct_acquire(g1, &e0, 1, 1); });
+                for (int i = 0; i < 400; i++) {
+                    if (ggml_moe_phaseb_counter(GGML_MOE_PB_C_USED_JOIN) > uj0) break;
+                    Sleep(1);
+                }
+                ggml_moe_direct_test_hold_retire(0);
+                th.join();
+                ggml_moe_direct_release(g1, &e0, 1);
+            } else if (cs.mode == 2 || cs.mode == 3) {
+                ggml_moe_direct_test_hold_retire(1);
+                std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+                ggml_moe_phaseb_test_push_intent(0, 0, 0, 0, 1, ids.data(), 8);
+                // mode 3 = in-flight 를 최대한 쌓아 CancelIoEx 가 실제 ABORTED 를 돌려줄
+                //          확률을 올린다(취소 enum 3 커버리지 시도 — 실패해도 무해).
+                const uint64_t want = (cs.mode == 3) ? 2u : 1u;
+                for (int i = 0; i < 600; i++) {
+                    int32_t l = 0; int64_t t = 0; ggml_moe_direct_test_lease_stats(&l, &t);
+                    if (ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED) >= want) break;
+                    Sleep(1);
+                }
+                ggml_moe_direct_test_shutdown(/*abort_mode=*/1);   // 취소 terminal 경로
+                ggml_moe_direct_test_hold_retire(0);
+            } else {
+                pb_push_and_settle(0, 0, 0, 0, 1, {0,1,2,3,4,5,6,7});
+            }
+            ggml_moe_direct_test_pb_quiesce(3000);
+            int32_t st = 0, qd = 0; uint64_t cd = 0, ld = 0;
+            const int hits = ggml_moe_phaseb_test_dup_terminal_result(&st, &cd, &ld, &qd);
+            if (hits >= 1) {
+                covered++;
+                seen_status += (seen_status.empty() ? "" : ",") + std::to_string(st);
+                if (cd == 0 && ld == 0 && qd == 0) clean++;
+            }
+        }
+        check(covered >= 3 && clean == covered,
+              "P45m. ★partition 확정 helper 의 **회계 멱등** — terminal 상태 " + seen_status +
+              " 에서 같은 live op 에 확정 helper 를 2차로 태웠고(" + std::to_string(covered) +
+              "회 발동) 전건이 카운터·QD·ledger 증가 0(" + std::to_string(clean) + "). "
+              "★**중복 terminal 자체는 현 call graph 에서 도달 불가**(Codex r2·r3 교차 확인)이며 "
+              "이 검사는 진짜 terminal 재진입 검사가 아니다 — 도달성 게이트에 따라 "
+              "terminal-once latch 는 의도적으로 추가하지 않았다");
+    }
+
+    // ── ⑩ legacy demand + collect 양성 회귀 — demand 레코드의 owner stamp 는 NA(r3 수리 1) ──
+    //   조합: `collect=on + MOE_DIRECT_QUALIFY=1 + MOE_DIRECT_IO_PATH=legacy + prefetch=off`.
+    //   동결 launcher 는 QUALIFY/IO_PATH 를 주입하지 않지만(오히려 `MOE_` deny 위생) **하네스
+    //   직접 기동**은 이 조합을 만들 수 있다 → 운영자·하네스 오설정 카테고리 = 실 도달 경로.
+    //   구 판은 owner_stamp 가 없으면 owner request 튜플로 폴백해, demand 레코드에 QD·
+    //   admission_seq 가 실려 부록 §14.3.3 "demand = stamp NA" 규약과 실물이 어긋났다.
+    {
+        std::wstring md = make_case_dir("pb5ct_legacy");
+        PbCollectEnv ce("on");
+        EnvGuard qual("MOE_DIRECT_QUALIFY", "1");
+        EnvGuard path("MOE_DIRECT_IO_PATH", "legacy");
+        EnvGuard qd("MOE_DIRECT_QD", "4");
+        EnvGuard k("MOE_DIRECT_PREFETCH_K", nullptr);      // prefetch OFF
+        EnvGuard n("MOE_DIRECT_PREFETCH_N", nullptr);
+        EnvGuard mode("MOE_DIRECT_PHASEB", "trace");
+        EnvGuard out("MOE_DIRECT_PHASEB_OUT", wide_to_utf8(md + L"\\pb").c_str());
+        EnvGuard met("MOE_DIRECT_METRICS", nullptr);
+        Fixture fx; pb_setup_2layer(fx, "pb5ct_legacy_fx");
+        if (check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+                  "P45n0. seal 성공(legacy demand + collect=on + prefetch=off)")) {
+            ggml_moe_phaseb_run_begin();
+            ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+            std::vector<int32_t> ids = {0,1,2};
+            ggml_moe_direct_acquire(g0, ids.data(), 3, 1);
+            ggml_moe_direct_release(g0, ids.data(), 3);
+            ggml_moe_phaseb_run_end();
+            ggml_moe_direct_finalize();
+
+            std::vector<ggml_moe_phaseb_ledger> led;
+            const uint64_t fsz = pb5ct_read_ledger_file(md + L"\\pb_ledger.pb", led);
+            int n_demand = 0, leaked = 0, n_prefetch = 0;
+            for (const auto & e : led) {
+                if (e.kind != GGML_MOE_PB_L_INFLIGHT_DELTA) continue;
+                if (e.origin == 1) { n_prefetch++; continue; }
+                n_demand++;
+                // ★demand 행은 stamp 전 필드가 NA 여야 한다(K/N/QD/rev=0 · admission_seq=NA ·
+                //   intent_ordinal=NA · rank=NA).
+                if (e.stamp_k != 0 || e.stamp_n != 0 || e.stamp_qd != 0 || e.tuple_revision != 0 ||
+                    e.admission_seq != GGML_MOE_PHASEB_NA_U64 ||
+                    e.intent_ordinal != GGML_MOE_PHASEB_NA_U64 ||
+                    e.rank != GGML_MOE_PHASEB_NA_U16) leaked++;
+            }
+            check(fsz > 128 && n_demand >= 2 && n_prefetch == 0 && leaked == 0,
+                  "P45n. ★legacy demand + collect 양성 회귀 — INFLIGHT_DELTA demand 행 " +
+                  std::to_string(n_demand) + "건(prefetch 행 " + std::to_string(n_prefetch) +
+                  "건) 전건이 owner stamp NA(K/N/QD/rev=0 · admission_seq=NA · intent_ordinal=NA · "
+                  "rank=NA) — 누출 " + std::to_string(leaked) + "건. 부록 §14.3.3 \"demand = stamp NA\" "
+                  "규약과 실물 일치(r3 수리 1)");
+        }
+    }
+
+    // ── ⑧ 구 소비자 호환 — 신 레코드/신 키를 무시하고 기존 값을 동일 산출 ──────────────
+    {
+        std::wstring md = make_case_dir("pb5ct_oldreader");
+        PbCollectEnv ce("on");
+        PbEnv env("4", "8", "2", "trace", wide_to_utf8(md + L"\\pb").c_str(),
+                  wide_to_utf8(md + L"\\m.jsonl").c_str());
+        Fixture fx; pb_setup_2layer(fx, "pb5ct_oldreader_fx");
+        if (check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+                  "P45l0. seal 성공(구 소비자 호환)")) {
+            pb5ct_scenario(fx, /*promote=*/true);
+            ggml_moe_direct_finalize();
+            // 구 소비자 재현: 5c-T **이전에 존재하던 키만** 읽어 C3 closure 를 재계산한다.
+            const json sum = pb_read_metrics_line(md + L"\\m.jsonl", "summary");
+            const uint64_t cand = sum.value("pb_candidate", (uint64_t)0);
+            const uint64_t adm  = sum.value("pb_admitted", (uint64_t)0);
+            const uint64_t iss  = sum.value("pb_issued", (uint64_t)0);
+            const uint64_t sf   = sum.value("pb_submit_failed", (uint64_t)0);
+            const uint64_t drop = sum.value("pb_dropped_no_slot_qd", (uint64_t)0) +
+                                  sum.value("pb_dropped_prefetch_cap", (uint64_t)0) +
+                                  sum.value("pb_dropped_reserve", (uint64_t)0);
+            const uint64_t uj   = sum.value("pb_used_join", (uint64_t)0);
+            const uint64_t up   = sum.value("pb_used_promoted", (uint64_t)0);
+            const uint64_t wst  = sum.value("pb_wasted", (uint64_t)0);
+            const bool old_closure = cand == adm + drop && adm == iss + sf && wst == iss - uj - up;
+            // 구 판독기의 사이드카 인벤토리: 신설 `_ledger.pb` 는 모드↔파일 조합표 밖이므로
+            // 기존 게이트(trace = sample+io 정확히)를 깨지 않아야 한다.
+            const bool have_sample = std::ifstream(md + L"\\pb_sample.pb", std::ios::binary).good();
+            const bool have_io     = std::ifstream(md + L"\\pb_io.pb", std::ios::binary).good();
+            const bool have_a0     = std::ifstream(md + L"\\pb_a0equiv.pb", std::ios::binary).good();
+            const bool have_led    = std::ifstream(md + L"\\pb_ledger.pb", std::ios::binary).good();
+            // ★r2 M7-5 — 이 검사는 **공용 Python 판독기를 호출하지 않는다**. C++ 안에서 구 키
+            //   집합만으로 C3 등식을 재계산한 것뿐이므로 "구 소비자 호환"의 증명이 아니다
+            //   (실 validator 대입은 메인이 별도 수행 — r2 M6 과 세트). 라벨을 그 범위로 줄인다.
+            check(old_closure && have_sample && have_io && !have_a0 && have_led,
+                  "P45l. ★구 키 집합만으로 C3 등식 재계산 성립(candidate=" + std::to_string(cand) +
+                  ") + trace 모드 사이드카 조합 불변(sample+io · a0equiv 부재 · `_ledger.pb` 별도 축) "
+                  "— ※**실 공용 판독기 호환 검증이 아니다**(그 대입은 별도 수행)");
+        }
+    }
+
+    ggml_moe_direct_reset_for_test();
+}
