+static void test_pb_5ct_oracle() {
+    section("P44. ★5c-T 수집 텔레메트리(SPEC_PHASEB_WIRE 부록 14 · 5CT §6-2 ⓐ~ⓗ) — "
+            "OFF 바이트 동일성 · 종결 4분할 배타 · censor cut · rank 분모 · ledger 결정론");
+
+    Pb5ctBase base_unset, base_off, base_off2, base_on;
+    json sum_off, sum_on, hdr_off, hdr_on, run_off, run_on;
+    // ★재개봉 R7 — 세 arm 의 settle(quiesce) 성공 여부. 구 코드는 `pb_push_and_settle()`
+    //   반환값을 버려서, settle 이 실패해 전이 열이 잘린 런도 조용히 비교 대상이 됐다.
+    bool settled_unset = false, settled_off = false, settled_off2 = false, settled_on = false;
+
+    // ── ⓗ-1. 수집 **미설정**(기본 OFF) 런 ───────────────────────────────────────────────
+    {
+        std::wstring md = make_case_dir("pb5ct_unset");
+        PbCollectEnv ce(nullptr);                      // env 자체를 지운다
+        PbEnv env("4", "8", "2", "trace", wide_to_utf8(md + L"\\pb").c_str(),
+                  wide_to_utf8(md + L"\\m.jsonl").c_str());
+        Fixture fx; pb_setup_2layer(fx, "pb5ct_unset_fx");
+        if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+                   "P44a0. seal 성공(수집 미설정)")) return;
+        check(ggml_moe_phaseb_collect_on() == false,
+              "P44a. ★수집 기본 OFF — `MOE_DIRECT_PHASEB_COLLECT` 미설정이면 collect_on=false "
+              "(부록 14.4 기본 OFF·명시 플래그로만 발효)");
+        settled_unset = pb5ct_scenario(fx, /*promote=*/true);
+        ggml_moe_direct_finalize();
+        base_unset = pb5ct_capture();
+        hdr_off = pb_read_metrics_line(md + L"\\m.jsonl", "header");
+        sum_off = pb_read_metrics_line(md + L"\\m.jsonl", "summary");
+        run_off = pb5ct_first_run_record(md + L"\\m.jsonl");
+        bool no_key = !hdr_off.contains("phaseb_collect");
+        for (const char * k : kPb5ctSummaryKeys) if (sum_off.contains(k)) no_key = false;
+        for (const char * k : { "stamp", "outcome", "blocked_intervals" })
+            if (run_off.contains(k)) no_key = false;
+        if (run_off.contains("counts") && run_off["counts"].contains("c3")) {
+            for (const char * k : { "resolved_wasted", "censored", "eligible_demand_acquire",
+                                    "waited_acquire", "observed_frontier_match" })
+                if (run_off["counts"]["c3"].contains(k)) no_key = false;
+        }
+        const bool no_ledger_file =
+            !std::ifstream(md + L"\\pb_ledger.pb", std::ios::binary).good() &&
+            ggml_moe_phaseb_ledger_records() == 0;
+        check(no_key && no_ledger_file && !sum_off.empty() && !run_off.empty(),
+              "P44b. ★OFF 런 wire 무변경 — header/summary/phase_b_run 어디에도 5c-T 키가 없고 "
+              "`_ledger.pb` 도 생성되지 않는다(부록 14 서두 1급 계약)");
+        // ★sizeof echo 잠금 — 스탬프 N 필드·side table 시공이 구조체 폭을 건드리지 않았음을
+        //   런타임에서 재확인한다(컴파일 타임 static_assert 와 이중 잠금).
