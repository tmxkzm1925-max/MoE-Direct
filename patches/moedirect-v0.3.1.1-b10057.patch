+            ggml_moe_direct_release(g0, &probe5, 1);
+            const uint64_t r2 = qd_reads_total();
+            int32_t probe0 = 0; ggml_moe_direct_acquire(g0, &probe0, 1, 1);
+            const uint64_t dr0 = qd_reads_total() - r2;   // 논리 순서 정상이면 e0 축출됨 → 1
+            ggml_moe_direct_release(g0, &probe0, 1);
+            check(dr5 == 0 && dr0 == 1,
+                  "M3d. ★캐시 압력 후 축출 순서 — 뒤 요청(e5)이 앞 요청(e0)보다 나중 축출(e5 재접근 read=" +
+                  std::to_string(dr5) + " e0 재접근 read=" + std::to_string(dr0) + " · tick 뒤집히면 0/1이 역전)");
+        }
+    }
+
+    // ── M4. slot 0 정상 처리 — 첫 배치의 victim은 slot 0(전 슬롯 last_used 0 → 최소 인덱스)이며
+    //    publish된 slot_index 0이 -1(미상주) 센티널과 혼동되지 않는다(재요청이 hit로 흡수).
