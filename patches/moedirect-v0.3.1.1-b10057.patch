+namespace lm_s2 {
+
+// 레코드 헤더 오프셋(ggml-moe-lmtrace.cpp 직렬화 순서와 1:1 — 판독기 계약과 같은 값).
+enum : size_t {
+    OFF_REC_BYTES = 8,
+    OFF_LAYOUT    = 12,
+    OFF_KIND      = 16,
+    OFF_TAG_FLAGS = 20,   // ★구 reserved
+    OFF_SEQ       = 24,
+    OFF_UID       = 32,
+    OFF_N_NODES   = 40,
+    OFF_N_LEAFS   = 44,
+    OFF_N_SPLITS  = 48,
+    OFF_N_BACKEND = 52,
+    OFF_TAG_BLOCK = 56,   // tag_flags==1 일 때만
+};
+
+static uint64_t rd_u64le(const std::vector<uint8_t> & b, size_t off) {
+    if (off + 8 > b.size()) return 0;
+    uint64_t v = 0;
+    for (int i = 7; i >= 0; --i) v = (v << 8) | (uint64_t) b[off + (size_t) i];
+    return v;
+}
+
+static int32_t rd_i32le(const std::vector<uint8_t> & b, size_t off) {
+    return (int32_t) lm_s0::rd_u32le(b, off);
+}
+
+// 첫 레코드의 바이트 범위를 잘라 온다(완주 파싱 전제).
+static std::vector<uint8_t> first_record(const std::vector<uint8_t> & raw) {
+    if (raw.size() < 12 || memcmp(raw.data(), "MOELMT1", 7) != 0) return {};
+    const uint32_t rb = lm_s0::rd_u32le(raw, OFF_REC_BYTES);
+    if (rb < 12 || (size_t) rb > raw.size()) return {};
+    return std::vector<uint8_t>(raw.begin(), raw.begin() + rb);
+}
+
+static std::string req_field(const std::string & line, const std::string & key) {
+    const std::string pat = "\"" + key + "\":";
+    const size_t p = line.find(pat);
+    if (p == std::string::npos) return std::string();
+    size_t s = p + pat.size();
+    size_t e = line.find_first_of(",}", s);
+    if (e == std::string::npos) e = line.size();
+    return line.substr(s, e - s);
+}
