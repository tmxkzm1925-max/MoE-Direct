+// ===========================================================================
+// XBE - E-2b-2: the scheduler moves onto the TOKEN-key emit surface.
+//   Authority: E2B2_ATOM_SPEC.md (construction-frozen, 70560f8b...) sections C, C-1, C-2.
+//   Exact delta = +12 (XBE01..XBE12, no gaps, no duplicates). The group registers between
+//   XCPU and XSTORE for the reason both of those do: it needs a LIVE dispatcher, and
+//   XSTORE's DRAINING arm stops one.
+//   Two child arms exist and neither changes check(): --xbe-fatal-test aborts (it joins the
+//   exact-abort set, +1) and --xbe-perf-ab returns early and takes no verdict (the pass line
+//   belongs to e2b2_perf_ab.ps1 alone, spec section D-K). The parent reads the fatal arm's
+//   stdout+stderr in ONE top-level check(), so the count stays at 12.
+//
+//   What the offload double is FOR (section C-2): the E-2b-2 transition lives inside
+//   ggml_backend_sched's input-copy loop, and that loop only runs when a graph is SPLIT
+//   across two backends. A CPU-only scheduler never reaches it, so XCPU's fixtures cannot
+//   see this atom at all. The double is the smallest thing that makes the scheduler split:
+//   a device that claims MUL_MAT_ID and ADD_ID, a buffer type only it supports, and a
+//   backend whose set_tensor_async DEFERS - which is what turns "the copies happened" into
+//   an observable sequence instead of an invisible memcpy.
+//
+//   What it does NOT prove, stated here rather than implied: a real device's asynchronous
+//   DMA, a real cudaStreamSynchronize, CUDA's offload batch threshold, or a real quantised
+//   multi-layer model. Those are section D-K Level 2, on the user's slot, and this group
+//   makes no claim about them.
+// ===========================================================================
+
+// ---- fixture shapes (section C-2's constant table) ------------------------------------
+static const int32_t XBE_NEXPERT = 8;
+static const int32_t XBE_NUSED   = 2;
+static const int64_t XBE_K       = 256;
+static const int64_t XBE_M       = 64;
+static const int64_t XBE_NEMBD   = 64;
+static const int32_t XBE_NTOKEN  = 64;
+static const uint32_t XBE_SEED   = 0x2b2u;
+
+// The scheduler replaces a null emit source with a static 512-byte zero page
+// (ggml-backend.cpp, the emit lambda), so `src == NULL` is NOT observable from here. The
+// zero-fill is therefore judged by its SHAPE on the way in (len <= 512 at the slab end) and
+// by the BYTES on the way out (R4-3) - see xbe_zero_is_zero.
+static const uint64_t XBE_ZPAD_MAX = 512;
+
+// ===========================================================================
+// the offload test double - device / buffer type / buffer / backend
+// ===========================================================================
+
+// One entry of the double's event log. Deliberately plain data: the backend records what it
+// was asked to do and the CHECK judges afterwards, so nothing is decided inside a callback.
+enum XbeEvKind { XBE_EV_SET = 0, XBE_EV_SYNC = 1, XBE_EV_COMPUTE = 2 };
+
+struct XbeEvent {
+    XbeEvKind   kind = XBE_EV_SET;
+    std::string dst;            // tensor name, "" when the op has no single destination
+    // The destination ITSELF, not just its name. `off`/`len` are offsets into THIS
+    // tensor - the split-input copy the scheduler allocated on the double - and any
+    // check that reads those bytes back has to read them out of it. XBE02 read them out
+    // of the graph output instead, which is a different and much smaller tensor, and
+    // ggml_backend_tensor_get's bounds assert took the process down mid-group.
+    ggml_tensor * dst_t = nullptr;
+    uint64_t    off = 0;
+    uint64_t    len = 0;
+    int64_t     handles = -1;   // ggml_moe_store_outstanding at the moment of the event
+};
+
+// A copy the double was handed and has not yet performed. The whole point of the double is
+// that a set_tensor_async does NOT touch memory until a synchronize or a graph_compute
+// drains it - that is what makes "release after synchronize" (G-5) a testable ORDER rather
+// than a coincidence of two memcpys.
+struct XbePending {
+    ggml_tensor * tensor = nullptr;
+    std::vector<uint8_t> data;
+    size_t offset = 0;
+};
+
+struct XbeDoubleCtx {
+    ggml_backend_t          inner   = nullptr;   // the REAL cpu backend the double delegates to
+    std::vector<XbePending> pending;
+    std::vector<XbeEvent>   log;
+    int64_t                 n_drained = 0;
+};
+
+static int64_t xbe_handles_now() {
+    int64_t h = -1, u = -1, s = -1;
+    ggml_moe_store_outstanding(&h, &u, &s);
+    return h;
+}
+
+// steady_clock, not GetTickCount64 - the tick counter advances in 15.6 ms steps on this host,
+// which cannot distinguish 1 ms from 15 and is coarser than several of the intervals the perf
+// arm reports. Same reasoning (and the same fix) as xcpu_now_ms.
+static int64_t xbe_now_ns() {
+    return (int64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static bool xbe_axes_zero() {
+    int64_t h = -1, u = -1, s = -1;
+    ggml_moe_store_outstanding(&h, &u, &s);
+    return h == 0 && u == 0 && s == 0;
+}
+
+static std::string xbe_axes_text() {
+    int64_t h = -1, u = -1, s = -1;
+    ggml_moe_store_outstanding(&h, &u, &s);
+    return "h=" + std::to_string(h) + " u=" + std::to_string(u) + " slots=" + std::to_string(s);
+}
+
+// ---- buffer type ----------------------------------------------------------------------
+static const char * xbe_buft_name(ggml_backend_buffer_type_t)  { return "moe-selftest-xbe"; }
+static size_t       xbe_buft_align(ggml_backend_buffer_type_t) { return 64; }
+// is_host = true. The CPU backend's supports_buft is exactly is_host, so a CPU node may read
+// a tensor the double allocated without a copy; the double, in turn, supports ONLY its own
+// buffer type, which is what forces a host CPU weight to arrive as a SPLIT INPUT instead of
+// being read in place. That asymmetry is the whole fixture.
+static bool         xbe_buft_is_host(ggml_backend_buffer_type_t) { return true; }
+
+static void   xbe_buffer_free(ggml_backend_buffer_t buffer) { std::free(buffer->context); }
+static void * xbe_buffer_base(ggml_backend_buffer_t buffer) { return buffer->context; }
+
+static void xbe_buffer_set(ggml_backend_buffer_t, ggml_tensor * tensor, const void * data,
+                           size_t offset, size_t size) {
+    std::memcpy((char *) tensor->data + offset, data, size);
+}
+
+static void xbe_buffer_get(ggml_backend_buffer_t, const ggml_tensor * tensor, void * data,
+                           size_t offset, size_t size) {
+    std::memcpy(data, (const char *) tensor->data + offset, size);
+}
+
+static void xbe_buffer_clear(ggml_backend_buffer_t buffer, uint8_t value) {
+    std::memset(buffer->context, value, buffer->size);
+}
+
+static ggml_backend_buffer_type_t xbe_buft();
+
+static ggml_backend_buffer_t xbe_buft_alloc(ggml_backend_buffer_type_t buft, size_t size) {
+    void * base = std::malloc(size ? size : 1);
+    if (!base) return nullptr;
+    ggml_backend_buffer_i iface{};
+    iface.free_buffer = xbe_buffer_free;
+    iface.get_base    = xbe_buffer_base;
+    iface.set_tensor  = xbe_buffer_set;
+    iface.get_tensor  = xbe_buffer_get;
+    iface.clear       = xbe_buffer_clear;
+    return ggml_backend_buffer_init(buft, iface, base, size);
+}
+
+static ggml_backend_dev_t xbe_device();
+
+static ggml_backend_buffer_type_t xbe_buft() {
+    static ggml_backend_buffer_type b;
+    static bool init = false;
+    if (!init) {
+        b = ggml_backend_buffer_type{};
+        b.iface.get_name      = xbe_buft_name;
+        b.iface.alloc_buffer  = xbe_buft_alloc;
+        b.iface.get_alignment = xbe_buft_align;
+        b.iface.is_host       = xbe_buft_is_host;
+        b.device              = xbe_device();
+        b.context             = nullptr;
+        init = true;
+    }
+    return &b;
+}
+
+// ---- backend --------------------------------------------------------------------------
+static const char * xbe_be_name(ggml_backend_t) { return "moe-selftest-xbe"; }
+
+static XbeDoubleCtx * xbe_ctx_of(ggml_backend_t backend) {
+    return (XbeDoubleCtx *) backend->context;
+}
+
+// The copy is QUEUED, not performed. Nothing observes the bytes until a drain, so the event
+// log's SET entries are a record of what the scheduler ASKED for - which is the quantity
+// XBE02 reads the expert pattern out of.
+static void xbe_be_set_async(ggml_backend_t backend, ggml_tensor * tensor, const void * data,
+                             size_t offset, size_t size) {
+    XbeDoubleCtx * c = xbe_ctx_of(backend);
+    XbePending p;
+    p.tensor = tensor;
+    p.offset = offset;
+    p.data.resize(size);
+    if (size) std::memcpy(p.data.data(), data, size);
+    c->pending.push_back(std::move(p));
+    XbeEvent e;
+    e.kind    = XBE_EV_SET;
+    e.dst     = tensor->name ? std::string(tensor->name) : std::string();
+    e.dst_t   = tensor;
+    e.off     = (uint64_t) offset;
+    e.len     = (uint64_t) size;
+    e.handles = xbe_handles_now();
+    c->log.push_back(e);
+}
+
+static void xbe_drain_pending(XbeDoubleCtx * c) {
+    for (XbePending & p : c->pending) {
+        if (!p.data.empty()) {
+            std::memcpy((char *) p.tensor->data + p.offset, p.data.data(), p.data.size());
+        }
+        c->n_drained++;
+    }
+    c->pending.clear();
+}
+
+static void xbe_be_synchronize(ggml_backend_t backend) {
+    XbeDoubleCtx * c = xbe_ctx_of(backend);
+    xbe_drain_pending(c);
+    XbeEvent e;
+    e.kind    = XBE_EV_SYNC;
+    e.handles = xbe_handles_now();
+    c->log.push_back(e);
+}
+
+// R4-2: the drain happens BEFORE the sample and before the delegate. A double whose
+// graph_compute computed on undrained memory would make the stock arm disagree with the
+// direct arm for a reason that has nothing to do with this atom.
+static enum ggml_status xbe_be_graph_compute(ggml_backend_t backend, ggml_cgraph * cgraph) {
+    XbeDoubleCtx * c = xbe_ctx_of(backend);
+    xbe_drain_pending(c);
+    XbeEvent e;
+    e.kind    = XBE_EV_COMPUTE;
+    e.handles = xbe_handles_now();
+    c->log.push_back(e);
+    return ggml_backend_graph_compute(c->inner, cgraph);
+}
+
+static void xbe_be_free(ggml_backend_t backend) {
+    XbeDoubleCtx * c = xbe_ctx_of(backend);
+    if (c && c->inner) ggml_backend_free(c->inner);
+    delete c;
+    delete backend;
+}
+
+// ---- device ---------------------------------------------------------------------------
+static const char * xbe_dev_name(ggml_backend_dev_t)        { return "XBE"; }
+static const char * xbe_dev_description(ggml_backend_dev_t) { return "moe-direct selftest offload double"; }
+
+static void xbe_dev_memory(ggml_backend_dev_t, size_t * free, size_t * total) {
+    if (free)  *free  = 0;
+    if (total) *total = 0;
+}
+
+static enum ggml_backend_dev_type xbe_dev_type(ggml_backend_dev_t) {
+    return GGML_BACKEND_DEVICE_TYPE_GPU;
+}
+
+// The two ops the atom's transition is about, and nothing else. supports_op decides which
+// nodes the scheduler may place here; offload_op decides whether it WANTS to, even when the
+// weights live in a buffer this device cannot use - which is exactly the case the E-2b-2
+// input-copy path exists to serve.
+static bool xbe_dev_supports_op(ggml_backend_dev_t, const ggml_tensor * op) {
+    return op && (op->op == GGML_OP_MUL_MAT_ID || op->op == GGML_OP_ADD_ID);
+}
+
+static bool xbe_dev_supports_buft(ggml_backend_dev_t, ggml_backend_buffer_type_t buft) {
+    return buft == xbe_buft();
+}
+
+static bool xbe_dev_offload_op(ggml_backend_dev_t dev, const ggml_tensor * op) {
+    return xbe_dev_supports_op(dev, op);
+}
+
+static ggml_backend_buffer_type_t xbe_dev_buffer_type(ggml_backend_dev_t) { return xbe_buft(); }
+
+static ggml_backend_t xbe_dev_init_backend(ggml_backend_dev_t dev, const char *);
+
+static void xbe_dev_props(ggml_backend_dev_t dev, struct ggml_backend_dev_props * props) {
+    struct ggml_backend_dev_props zero{};
+    *props = zero;
+    props->name        = xbe_dev_name(dev);
+    props->description = xbe_dev_description(dev);
+    props->type        = xbe_dev_type(dev);
+    xbe_dev_memory(dev, &props->memory_free, &props->memory_total);
+}
+
+static ggml_backend_dev_t xbe_device() {
+    static ggml_backend_device d;
+    static bool init = false;
+    if (!init) {
+        d = ggml_backend_device{};
+        d.iface.get_name        = xbe_dev_name;
+        d.iface.get_description = xbe_dev_description;
+        d.iface.get_memory      = xbe_dev_memory;
+        d.iface.get_type        = xbe_dev_type;
+        d.iface.get_props       = xbe_dev_props;
+        d.iface.init_backend    = xbe_dev_init_backend;
+        d.iface.get_buffer_type = xbe_dev_buffer_type;
+        d.iface.supports_op     = xbe_dev_supports_op;
+        d.iface.supports_buft   = xbe_dev_supports_buft;
+        d.iface.offload_op      = xbe_dev_offload_op;
+        d.reg     = nullptr;
+        d.context = nullptr;
+        init = true;
+    }
+    return &d;
+}
+
+static ggml_guid_t xbe_guid() {
+    static ggml_guid g = { 0x2b, 0x2e, 0x58, 0x42, 0x45, 0xd0, 0xd0, 0x1e,
+                           0x9a, 0x77, 0x41, 0x0c, 0x53, 0x64, 0x88, 0x21 };
+    return &g;
+}
+
+static ggml_backend_t xbe_dev_init_backend(ggml_backend_dev_t dev, const char *) {
+    ggml_backend_load_all();
+    ggml_backend_dev_t cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (!cpu_dev) return nullptr;
+    XbeDoubleCtx * c = new XbeDoubleCtx();
+    c->inner = ggml_backend_dev_init(cpu_dev, nullptr);
+    if (!c->inner) { delete c; return nullptr; }
+    ggml_backend * be = new ggml_backend();
+    *be = ggml_backend{};
+    be->guid                  = xbe_guid();
+    be->iface.get_name        = xbe_be_name;
+    be->iface.free            = xbe_be_free;
+    be->iface.set_tensor_async = xbe_be_set_async;
+    be->iface.synchronize     = xbe_be_synchronize;
+    be->iface.graph_compute   = xbe_be_graph_compute;
+    be->device                = dev;
+    be->context               = c;
+    return be;
+}
+
+// ---- the double, the real CPU backend, and the scheduler over both --------------------
+struct XbeSched {
+    ggml_backend_t       dbl   = nullptr;
+    ggml_backend_t       cpu   = nullptr;
+    ggml_backend_sched_t sched = nullptr;
+    XbeDoubleCtx *       ctx   = nullptr;
+
+    ~XbeSched() {
+        if (sched) ggml_backend_sched_free(sched);
+        if (cpu)   ggml_backend_free(cpu);
+        if (dbl)   ggml_backend_free(dbl);   // frees its inner CPU backend and its context
+    }
+    void reset_log() { if (ctx) { ctx->log.clear(); ctx->n_drained = 0; } }
+
+    // R4-4: judgement runs on the slice UP TO the first COMPUTE. The scheduler's final
+    // ggml_backend_sched_synchronize appends a SYNC after the graph is already done, and
+    // counting that one would let a release that happened too late still look ordered.
+    std::vector<XbeEvent> slice() const {
+        std::vector<XbeEvent> out;
+        if (!ctx) return out;
+        for (const XbeEvent & e : ctx->log) {
+            out.push_back(e);
+            if (e.kind == XBE_EV_COMPUTE) break;
+        }
+        return out;
+    }
+};
+
+static bool xbe_open_sched(XbeSched & s, bool op_offload = true) {
+    ggml_backend_load_all();
+    ggml_backend_dev_t cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (!cpu_dev) return false;
+    s.dbl = ggml_backend_dev_init(xbe_device(), nullptr);
+    if (!s.dbl) return false;
+    s.ctx = xbe_ctx_of(s.dbl);
+    s.cpu = ggml_backend_dev_init(cpu_dev, nullptr);
+    if (!s.cpu) return false;
+    // The double first and the CPU LAST: ggml_backend_sched_new requires the last backend to
+    // be the CPU one, and the order is also the scheduler's preference order.
+    ggml_backend_t backends[2] = { s.dbl, s.cpu };
+    ggml_backend_buffer_type_t bufts[2] = { xbe_buft(),
+                                            ggml_backend_get_default_buffer_type(s.cpu) };
+    s.sched = ggml_backend_sched_new(backends, bufts, 2, GGML_DEFAULT_GRAPH_SIZE,
+                                     /*parallel=*/false, /*op_offload=*/op_offload);
+    return s.sched != nullptr;
+}
+
+// ===========================================================================
+// the store (real production path: compute_layout -> manifest -> bin -> seal)
+// ===========================================================================
+// Same discipline as section F's parity harness and XCPU's: the fixture comes out of the
+// REAL path, never from hand-laid bytes, and the STOCK arm is handed the same per-expert
+// payloads the store will serve so "identical output" is a comparison against something the
+// direct path did not produce.
+struct XbeStore {
+    SynthModel   model;
+    Computed     comp;
+    std::wstring dir;
+    std::string  sha;
+    int32_t      n_expert = 0;
+    std::vector<std::vector<uint8_t>> wpe, bpe;
+};
+
+// `n_expert` is a DEFAULTED parameter, and the default is the section C-2 constant every
+// check() fixture uses - so the twelve checks call this exactly as they did and build exactly
+// the store they built. The only caller that passes anything else is the --xbe-perf-ab child,
+// whose n_used sweep reaches 64 (section D-K Level 1) and therefore needs a store wide enough
+// to hold that many experts. XCPU's xcpu_make_store already takes n_expert this way and
+// E-2b-1's perf arm already seals a 64-expert store through it (XPERF_NEXPERT), so this is
+// the established shape rather than a new one.
+static bool xbe_make_store(XbeStore & st, const char * tag, int32_t n_expert = XBE_NEXPERT) {
+    st.n_expert = n_expert;
+    st.model.arch = "synth";
+    st.model.n_expert = n_expert; st.model.n_expert_used = XBE_NUSED; st.model.n_layer = 1;
+    st.model.sources = { default_source() };
+    SynthLayer L; L.layer = 0;
+    SynthPart w; w.name = "gate.weight"; w.source_tensor = "blk.0.ffn_gate_exps.weight";
+    w.source_index = 0; w.type = "F32"; w.dims = { XBE_K, XBE_M, n_expert }; w.is_host = true;
+    SynthPart b; b.name = "gate.bias";   b.source_tensor = "blk.0.ffn_gate_exps.bias";
+    b.source_index = 0; b.type = "F32"; b.dims = { XBE_NEMBD, n_expert }; b.is_host = true;
+    L.parts = { w, b };
+    st.model.layers = { L };
+    st.comp = compute_layout(st.model, 4096);
+    st.dir  = make_case_dir(tag);
+
+    // The payload is the fixture generator's, not random: experts.bin is written by
+    // write_bin_hash, so byte j of expert e's part p IS bin_hash(e*stride + part_offset + j).
+    // That gives XBE11 a THIRD opinion for free - an oracle neither emit surface produced -
+    // which is the whole point of section C-1's note that comparing the two emits against
+    // each other lets a shared error pass both. The stock arm is handed the same bytes here.
+    const size_t wf = (size_t)(XBE_K * XBE_M), bf = (size_t) XBE_NEMBD;
+    const uint64_t stride = (uint64_t) st.comp.layers[0].stride;
+    const uint64_t woff   = (uint64_t) st.comp.layers[0].parts[0].part_offset;
+    const uint64_t boff   = (uint64_t) st.comp.layers[0].parts[1].part_offset;
+    st.wpe.resize((size_t) n_expert); st.bpe.resize((size_t) n_expert);
+    for (int e = 0; e < n_expert; e++) {
+        st.wpe[(size_t) e].resize(wf * 4); st.bpe[(size_t) e].resize(bf * 4);
+        for (size_t i = 0; i < wf * 4; i++) {
+            st.wpe[(size_t) e][i] = bin_hash((uint64_t) e * stride + woff + (uint64_t) i);
+        }
+        for (size_t i = 0; i < bf * 4; i++) {
+            st.bpe[(size_t) e][i] = bin_hash((uint64_t) e * stride + boff + (uint64_t) i);
+        }
+    }
+    const std::string expect_body = synth_expect_body("synth", n_expert);
+    st.sha = sha256_hex(expect_body);
+    { std::ofstream ofs(st.dir + L"\\synth.expect.json", std::ios::binary | std::ios::trunc);
+      ofs << expect_body; }
+    write_manifest(st.dir + L"\\manifest.json",
+                   build_manifest_json(st.model, st.comp, "synth", st.sha));
+    write_verify_report(st.dir + L"\\verify_report.json", "synth", st.sha,
+                        sha256_file_hex(st.dir + L"\\manifest.json"));
+    write_bin_hash(st.dir + L"\\experts.bin", st.comp);
+    return true;
+}
+
+static int xbe_seal_store(const XbeStore & st) {
+    int32_t moe_layers[1] = { 0 };
+    ggml_moe_direct_model md{};
+    md.arch = "synth"; md.n_layer = 1;
+    md.n_expert = st.model.n_expert; md.n_expert_used = st.model.n_expert_used;
+    md.moe_layers = moe_layers; md.n_moe_layers = 1;
+    const std::string sp = st.model.sources[0].path;
+    ggml_moe_direct_source src{};
+    src.path = sp.c_str(); src.bytes = st.model.sources[0].bytes;
+    src.mtime_epoch = st.model.sources[0].mtime;
+    src.data_start = st.model.sources[0].data_start;
+    src.gguf_version = st.model.sources[0].gguf_version;
+    src.alignment = st.model.sources[0].alignment;
+    const std::string dir8 = wide_to_utf8(st.dir);
+    return ggml_moe_direct_seal_for_test(dir8.c_str(), &md, &src, 1,
+                                         (uint64_t) st.n_expert * st.comp.slot_stride_max,
+                                         XCPU_SEAL_TOUCH_ABORT,
+                                         dir8.c_str(), "synth", st.sha.c_str(), "all");
+}
+
+// ===========================================================================
+// the two fixtures section C-2 keeps SEPARATE (R4-1)
+// ===========================================================================
+// (1) the WEIGHTS ctx - real host memory, allocated from the CPU backend and then MARKED
+//     usage=WEIGHTS. Both halves matter to the scheduler: `is_host` decides the weight can
+//     be read in place, and `usage == WEIGHTS` is what the input-copy branch tests before it
+//     will consider an expert-wise copy at all. A weight left at usage=ANY never reaches the
+//     path this whole group is about, and the fixture would go quietly green on nothing.
+// (2) the GRAPH ctx - no_alloc, every op output left to the scheduler. Pre-allocating an
+//     op output on the CPU pins the node to the CPU and the graph stops splitting, which is
+//     the same silent nothing by a different route.
+struct XbeWeights {
+    ggml_context *        ctx = nullptr;
+    ggml_tensor *         w   = nullptr;
+    ggml_tensor *         b   = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    ~XbeWeights() {
+        if (buf) ggml_backend_buffer_free(buf);
+        if (ctx) ggml_free(ctx);
+    }
+};
+
+static bool xbe_build_weights(XbeWeights & wt, ggml_backend_t cpu, const XbeStore & st,
+                              bool direct) {
+    ggml_init_params p{};
+    p.mem_size = ggml_tensor_overhead() * 8 + 4096;
+    p.no_alloc = true;
+    wt.ctx = ggml_init(p);
+    if (!wt.ctx) return false;
+    wt.w = ggml_new_tensor_3d(wt.ctx, GGML_TYPE_F32, XBE_K, XBE_M, st.n_expert);
+    wt.b = ggml_new_tensor_2d(wt.ctx, GGML_TYPE_F32, XBE_NEMBD, st.n_expert);
+    if (direct) {
+        ggml_set_name(wt.w, "blk.0.ffn_gate_exps.weight");
+        ggml_set_name(wt.b, "blk.0.ffn_gate_exps.bias");
+        // registration precedes allocation - the order section F's harness uses. The
+        // registration set owes the MANIFEST both parts even when a graph reads one.
+        // The return is CHECKED. register refuses after the seal (ggml-moe-direct.cpp:11489)
+        // and on a duplicate name, and both refusals are otherwise SILENT - the arm would then
+        // run an unregistered weight and report green on the very stock path it exists to
+        // discriminate against.
+        if (ggml_moe_direct_register(wt.w, "blk.0.ffn_gate_exps.weight", 1) != 0) return false;
+        if (ggml_moe_direct_register(wt.b, "blk.0.ffn_gate_exps.bias", 1) != 0) return false;
+    } else {
+        ggml_set_name(wt.w, "stock.weight");
+        ggml_set_name(wt.b, "stock.bias");
+    }
+    wt.buf = ggml_backend_alloc_ctx_tensors(wt.ctx, cpu);
+    if (!wt.buf) return false;
+    ggml_backend_buffer_set_usage(wt.buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    if (!direct) {
+        for (int e = 0; e < st.n_expert; e++) {
+            ggml_backend_tensor_set(wt.w, st.wpe[(size_t) e].data(),
+                                    (size_t) e * wt.w->nb[2], st.wpe[(size_t) e].size());
+            ggml_backend_tensor_set(wt.b, st.bpe[(size_t) e].data(),
+                                    (size_t) e * wt.b->nb[1], st.bpe[(size_t) e].size());
+        }
+    }
+    return true;
+}
+
+// The graph ctx. `mode` picks which op the graph is built around, because the two consumers
+// stride differently (mul_mat_id by nb[2], add_id by nb[1]) and section C-1 wants both.
+enum XbeGraphMode { XBE_G_MMID = 0, XBE_G_ADDID = 1 };
+
+struct XbeGraph {
+    ggml_context * ctx = nullptr;
+    ggml_tensor *  act = nullptr, * ids = nullptr, * y0 = nullptr, * out = nullptr;
+    ggml_cgraph *  graph = nullptr;
+    ~XbeGraph() { if (ctx) ggml_free(ctx); }
+};
+
+static bool xbe_build_graph(XbeGraph & g, XbeWeights & wt, XbeGraphMode mode,
+                            int32_t n_token, int32_t n_used) {
+    ggml_init_params p{};
+    p.mem_size = ggml_tensor_overhead() * 24 + ggml_graph_overhead_custom(32, false);
+    p.no_alloc = true;                       // R4-1: the scheduler allocates, not this ctx
+    g.ctx = ggml_init(p);
+    if (!g.ctx) return false;
+    g.ids = ggml_new_tensor_2d(g.ctx, GGML_TYPE_I32, n_used, n_token);
+    ggml_set_name(g.ids, "xbe.ids");
+    if (mode == XBE_G_MMID) {
+        g.act = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, XBE_K, n_used, n_token);
+        ggml_set_name(g.act, "xbe.act");
+        g.out = ggml_mul_mat_id(g.ctx, wt.w, g.act, g.ids);
+    } else {
+        // section C-1 XBE06: the ADD_ID branch takes its activation from a CPU op output, so
+        // the bias is the split's FIRST node input - the b110 branch the atom rewires.
+        g.act = ggml_new_tensor_3d(g.ctx, GGML_TYPE_F32, XBE_NEMBD, n_used, n_token);
+        ggml_set_name(g.act, "xbe.act");
+        g.y0  = ggml_scale(g.ctx, g.act, 1.0f);
+        ggml_set_name(g.y0, "xbe.y0");
+        g.out = ggml_add_id(g.ctx, g.y0, wt.b, g.ids);
+    }
+    ggml_set_name(g.out, "xbe.out");
+    g.graph = ggml_new_graph_custom(g.ctx, 32, false);
+    ggml_build_forward_expand(g.graph, g.out);
+    return true;
+}
+
+// ids: `n_used` DISTINCT experts per token, the same set for every token so the used-set is
+// small and nameable. The pattern XBE02 reads out of the log is per (graph, expert), so a
+// per-token permutation would only make the expected multiset harder to state, not stronger.
+static std::vector<int32_t> xbe_ids(int32_t n_token, int32_t n_used, int32_t n_expert,
+                                    int32_t first) {
+    std::vector<int32_t> v((size_t)(n_token * n_used), 0);
+    for (int32_t t = 0; t < n_token; t++) {
+        for (int32_t u = 0; u < n_used; u++) {
+            v[(size_t)(t * n_used + u)] = (first + u) % n_expert;
+        }
+    }
+    return v;
+}
+
+static std::vector<int32_t> xbe_used_set(const std::vector<int32_t> & ids) {
+    std::set<int32_t> s(ids.begin(), ids.end());
+    return std::vector<int32_t>(s.begin(), s.end());
+}
+
+// alloc -> fill the scheduler-allocated inputs -> compute. Returns the graph's output bytes.
+static bool xbe_run(XbeSched & s, XbeGraph & g, const std::vector<int32_t> & ids_vals,
+                    const std::vector<float> & act_vals, std::vector<uint8_t> * out_bytes) {
+    s.reset_log();
+    if (!ggml_backend_sched_alloc_graph(s.sched, g.graph)) return false;
+    ggml_backend_tensor_set(g.ids, ids_vals.data(), 0, ids_vals.size() * sizeof(int32_t));
+    ggml_backend_tensor_set(g.act, act_vals.data(), 0, act_vals.size() * sizeof(float));
+    if (ggml_backend_sched_graph_compute_async(s.sched, g.graph) != GGML_STATUS_SUCCESS) {
+        return false;
+    }
+    ggml_backend_sched_synchronize(s.sched);
+    if (out_bytes) {
+        out_bytes->resize(ggml_nbytes(g.out));
+        ggml_backend_tensor_get(g.out, out_bytes->data(), 0, out_bytes->size());
+    }
+    return true;
+}
+
+static std::vector<float> xbe_rand_act(size_t n, uint32_t seed) {
+    std::vector<float> v(n);
+    std::mt19937 rng(seed);
+    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+    for (size_t i = 0; i < n; i++) v[i] = dist(rng);
+    return v;
+}
+
+// The SET events of the slice, in order. XBE02/04/08 all read this and nothing else.
+static std::vector<XbeEvent> xbe_sets(const std::vector<XbeEvent> & slice,
+                                      const std::string & dst_contains) {
+    std::vector<XbeEvent> out;
+    for (const XbeEvent & e : slice) {
+        if (e.kind != XBE_EV_SET) continue;
+        if (!dst_contains.empty() && e.dst.find(dst_contains) == std::string::npos) continue;
+        out.push_back(e);
+    }
+    return out;
+}
+
+static int xbe_count_kind(const std::vector<XbeEvent> & slice, XbeEvKind k) {
+    int n = 0;
+    for (const XbeEvent & e : slice) if (e.kind == k) n++;
+    return n;
+}
+
+// R4-3: the scheduler substitutes a static zero page for a null emit source, so `src==NULL`
+// is not observable. The zero-fill is judged on the DESTINATION after the drain instead.
+static bool xbe_zero_is_zero(ggml_tensor * dst, uint64_t off, uint64_t len) {
+    std::vector<uint8_t> got((size_t) len, 0xAA);
+    ggml_backend_tensor_get(dst, got.data(), (size_t) off, (size_t) len);
+    for (uint8_t x : got) if (x != 0) return false;
+    return true;
+}
+
+// ===========================================================================
+// child arms
+// ===========================================================================
+// SCRATCH LIFETIME. Both arms below are dispatched from the early-return region, which
+// returns BEFORE main reaches its own init_scratch_root(), so a child starts with an EMPTY
+// g_scratch_root. make_case_dir then builds "\case_000_<tag>" and Windows resolves that
+// against the current drive ROOT: the 2026-09-01 run left C:\case_000_xbe_fatal behind
+// (experts.bin + 3 files, 560,242 B) where nothing could see it, because the runner and the
+// probe both sweep only %TEMP%\moe-selftest. run_xstore_fatal_child initialises its own root
+// for exactly this reason (selftest section XSTORE); these two now do the same.
+//
+// The guard covers the RETURNING paths. teardown_scratch_root deletes on success and KEEPS
+// on failure (harness section 2-10 (1)) - and either outcome is now inside the sweep root,
+// so a kept directory is collected by the next run's start-up sweep instead of living
+// forever in a drive root. The engine reset comes FIRST because a sealed store holds
+// experts.bin open with FILE_SHARE_READ and the delete would fail under that handle.
+// An arm that ABORTS runs no destructor, which is correct and is the XSTORE precedent: the
+// dead process's directory carries its pid, and the sweep collects it on that.
+//
+// SUCCESS GOES THROUGH close(), NOT THE DESTRUCTOR, and the caller must propagate what it
+// returns. Harness R-6 (selftest-harness.cpp: teardown_scratch_root) is explicit that a
+// SUCCESS teardown which cannot delete returns false and the caller puts that in its exit
+// code - "success exit with residue behind it" is the precise thing that contract exists to
+// stop, and a destructor cannot return anything to stop it with. The failure is reachable,
+// not hypothetical: reset_for_test returns EARLY when the shutdown stop times out
+// (ggml-moe-direct.cpp, the disp_stop_timed_out latch), which leaves experts.bin open and
+// the delete failing underneath an otherwise clean run.
+struct XbeScratchGuard {
+    bool closed = false;
+    // the success path: returns false when a clean run could not delete its own scratch
+    bool close() {
+        closed = true;
+        ggml_moe_direct_reset_for_test();
+        return teardown_scratch_root(true);
+    }
+    // the error paths: teardown_scratch_root(false) KEEPS the directory on purpose and
+    // always succeeds, so there is nothing to propagate - and the arm is already returning
+    // a non-zero code of its own.
+    ~XbeScratchGuard() {
+        if (closed) return;
+        ggml_moe_direct_reset_for_test();
+        (void) teardown_scratch_root(false);
+    }
+};
+// --xbe-fatal-test : XBE12. An expert the token never captured is emitted, which the store
+// answers with fallback_hit("emit-expert-copies-ptr-null") and then GGML_ABORT. The arm is
+// a SYNTHETIC fail-close witness: it proves the guard fires, not that production reaches it.
+static int run_xbe_fatal_child() {
+    // see the SCRATCH LIFETIME note above: without this the fixture lands in a drive root.
+    init_scratch_root();
+    XbeScratchGuard scratch;      // for the error returns; the abort path deliberately has none
+    XbeStore st;
+    if (!xbe_make_store(st, "xbe_fatal")) { fprintf(stderr, "xbe fatal: store failed\n"); return 70; }
+    ggml_backend_load_all();
+    ggml_backend_dev_t cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (!cpu_dev) { fprintf(stderr, "xbe fatal: no cpu device\n"); return 72; }
+    ggml_backend_t cpu = ggml_backend_dev_init(cpu_dev, nullptr);
+    if (!cpu) { fprintf(stderr, "xbe fatal: no cpu backend\n"); return 73; }
+    XbeWeights wt;
+    if (!xbe_build_weights(wt, cpu, st, /*direct=*/true)) {
+        fprintf(stderr, "xbe fatal: weights failed\n"); ggml_backend_free(cpu); return 74;
+    }
+    // The seal comes AFTER the registration, never before. seal_common_locked_v2 compares the
+    // registration set against the MANIFEST both ways (L_scope == M_all,
+    // ggml-moe-direct.cpp:10447-10467) and xbe_build_weights is the only thing that registers
+    // either part, so sealing first stands L_scope(0) against M_all(2) and the arm dies at the
+    // refusal before it has done anything. xcpu_run_mmid_addid (:22815-22825) is the standing
+    // order this follows: build the registered graph, then seal.
+    if (xbe_seal_store(st) != 0) {
+        fprintf(stderr, "xbe fatal: seal failed\n"); ggml_backend_free(cpu); return 71;
+    }
+    // Capture experts {0,1} and then ask the store to emit expert 7. The used_ids the token
+    // captured and the used_ids handed to emit are DIFFERENT sets on purpose; everything
+    // else is the production call.
+    const int32_t cap_ids[2] = { 0, 1 };
+    uint64_t token = 0;
+    const int rc = ggml_moe_store_acquire(0, 0, cap_ids, 2, XBE_NTOKEN, &token);
+    if (rc < 0) { fprintf(stderr, "xbe fatal: acquire rc=%d\n", rc); ggml_backend_free(cpu); return 75; }
+    const int32_t emit_ids[1] = { 7 };
+    std::vector<uint8_t> sink((size_t) ggml_nbytes(wt.w), 0);
+    struct Ud { std::vector<uint8_t> * v; };
+    Ud ud{ &sink };
+    fflush(stdout); fflush(stderr);
+    (void) ggml_moe_store_emit_expert_copies(
+        token, 0, (uint64_t) wt.w->nb[2], (uint64_t) ggml_nbytes(wt.w), st.n_expert,
+        emit_ids, 1,
+        [](void * u, const void * src, uint64_t dst_offset, uint64_t len) {
+            Ud * c = (Ud *) u;
+            if (src && dst_offset + len <= c->v->size()) {
+                std::memcpy(c->v->data() + dst_offset, src, (size_t) len);
+            }
+        },
+        &ud);
+    // Not reached: the emit aborts on the uncaptured expert. Reaching here IS the failure.
+    fprintf(stderr, "xbe fatal: emit returned without aborting\n");
+    fflush(stderr);
+    ggml_backend_free(cpu);
+    return 76;
+}
+
+// The expert count of the perf fixture. Section D-K Level 1 sweeps n_used over {2, 8, 64},
+// so the store has to be at least 64 wide, and holding it CONSTANT across the three points
+// leaves n_used as the only thing that moves between them. The check() fixtures keep
+// XBE_NEXPERT (see xbe_make_store's defaulted parameter) - this constant is the perf child's
+// alone. 64 is not a new size for this binary either: E-2b-1's XPERF arm seals a 64-expert
+// store on the same helpers, and the seal's slot arithmetic (n_slots = budget /
+// slot_stride_max, refused below n_expert - ggml-moe-direct.cpp:9077) gives exactly one slot
+// per expert at the budget xbe_seal_store passes, so an n_used=64 acquire is resident-wide
+// rather than capacity-bound.
+static const int32_t XBE_PERF_NEXPERT = 64;
+
+// The repetition count, fixed. The runner discards the first repetition as warm-up and needs
+// the rest, so the child emits every one of them and the footer states how many it emitted.
+static const int XBE_PERF_REPS = 32;
+
+// INNER REPETITIONS PER SAMPLE, and the reason this constant exists at all.
+// xbe_now_ns reads steady_clock, which on this host is QPC at 10 MHz - a 100 ns tick. A single
+// release at n_used=2 is a mutex and a couple of lease decrements and can finish inside one
+// tick, so timing it alone quantises to 0 ns: not a small number, a MISSING one, and a ratio
+// built on it means nothing. Each sample therefore times XBE_PERF_INNER complete
+// acquire/emit/release cycles back to back and reports the SUM.
+//
+// ** WHAT SUMMING DOES AND DOES NOT DO (corrected - the first version of this comment claimed
+// summing made a zero "structurally impossible", and that was wrong: Codex e2b2_perf_arm r2
+// F5). The quantum is STILL 100 ns. Summing n cycles multiplies the signal by n while the
+// quantisation error stays one tick, so it raises the SIGNAL-TO-QUANTUM ratio - it does not
+// remove the quantum, and a sum can still land on zero if every cycle did. At inner=16 that
+// was a real probability rather than a theoretical one. inner=256 is chosen to put the summed
+// axes in the microsecond range where the residual tick is a rounding error; the cost is
+// negligible because these are lock-and-arithmetic calls with no I/O. Whether the resolution
+// actually SUFFICES is not decided here at all - the runner owns that gate, and it judges the
+// summed medians against its own floor. This constant is one input to that judgement.
+static const int XBE_PERF_INNER = 256;
+
+// The emit callback for BOTH arms, and it does no per-copy work on purpose. Section D-K writes
+// "no-op callback" onto the legacy arm; giving the two arms callbacks that do different amounts
+// of work would turn emit(new)/emit(old) into a measurement of the two callbacks rather than of
+// the two surfaces, and at n_used=64 a copying callback moves the whole 4 MiB weight and
+// buries the surface entirely. Nothing here judges bytes - XBE09 and XBE11 own byte equality,
+// on the check() path, where the callback is not a no-op. It cannot be optimised away: both
+// emit implementations live in ggml-base.dll and call it through the function pointer.
+//
+// The one thing it does do is COUNT. The footer reports the per-arm call count so the runner
+// can assert the two arms drove the callback the same number of times - "the surfaces did the
+// same work" is otherwise an assumption, and a coalescing change on one side would show up as
+// a faster emit rather than as a different shape. One non-atomic increment is symmetric across
+// the arms (they share this function), so it biases both by the same amount or neither.
+static int64_t g_xbe_perf_callbacks = 0;
+
+static void xbe_perf_emit_noop(void *, const void *, uint64_t, uint64_t) {
+    g_xbe_perf_callbacks++;
+}
+
+// ---- the two arms, one repetition each -------------------------------------------------
+// Section D-K Level 1 is a RATIO, and a ratio is only about the surfaces if nothing else
+// differs. Protocol v2 therefore runs both arms in ONE process, over one sealed store, one
+// registered weight set and one allocator/cache state, alternating per repetition - which is
+// what E-2b-1's run_xcpu_perf_child already does. The previous shape spawned one process per
+// arm and could not make that claim: same recipe, different runtime objects.
+//
+// Each arm is its own function so that the `surface=` it declares and the calls it makes are
+// in ONE block. That pairing is what e2b2_static_gate.py's x2-12 layer binds: an edit that
+// swaps a call without moving the literal, or moves the literal without the call, takes the
+// gate red. Before that binding existed the declaration was a self-report and a runner had no
+// way to tell a true one from a false one (Codex e2b2_perf_arm r1, finding 2).
+//
+// Return codes are the arm's own: 75 issue, 76 a non-zero emit, 77 a negative interval. The
+// emit return is READ, not discarded - a regression that starts returning an argument error
+// would otherwise publish a very fast emit as a normal sample.
+static int xbe_perf_rep_legacy(const XbeWeights & wt, const std::vector<int32_t> & ids,
+                               int32_t n_expert, uint64_t expert_size, uint64_t total_bytes,
+                               int rep, int64_t * out_callbacks, int * out_emit_bad) {
+    const int64_t cb0 = g_xbe_perf_callbacks;
+    int64_t issue_ns = 0, emit_ns = 0, release_ns = 0;
+    for (int i = 0; i < XBE_PERF_INNER; i++) {
+        const int64_t t0 = xbe_now_ns();
+        const int rc = ggml_moe_direct_acquire(wt.w, ids.data(), (int32_t) ids.size(),
+                                               XBE_NTOKEN);
+        const int64_t t1 = xbe_now_ns();
+        if (rc < 0) {
+            fprintf(stderr, "xbe perf: legacy ggml_moe_direct_acquire rc=%d\n", rc);
+            return 75;
+        }
+        const int erc = ggml_moe_direct_emit_expert_copies(
+            wt.w, expert_size, total_bytes, n_expert,
+            ids.data(), (int32_t) ids.size(), xbe_perf_emit_noop, nullptr);
+        const int64_t t2 = xbe_now_ns();
+        // released before the emit verdict on purpose: the lease has to come back whatever
+        // the emit said, and the arm is about to end the process on a non-zero one.
+        ggml_moe_direct_release(wt.w, ids.data(), (int32_t) ids.size());
+        const int64_t t3 = xbe_now_ns();
+        if (erc != 0) {
+            (*out_emit_bad)++;
+            fprintf(stderr, "xbe perf: legacy emit rc=%d\n", erc);
+            return 76;
+        }
+        issue_ns += t1 - t0;
+        emit_ns += t2 - t1;
+        release_ns += t3 - t2;
+    }
+    // NEGATIVE only. A zero sum is UNLIKELY at this inner count, not impossible, and it is the
+    // runner's resolution gate that decides whether a small sum is usable - refusing it here
+    // would put that judgement in two places. A negative sum is different in kind: it can only
+    // mean the clock ran backwards, and no number of repetitions repairs that.
+    if (issue_ns < 0 || emit_ns < 0 || release_ns < 0) {
+        fprintf(stderr, "xbe perf: legacy rep %d has a negative interval (%lld/%lld/%lld ns)\n",
+                rep, (long long) issue_ns, (long long) emit_ns, (long long) release_ns);
+        return 77;
+    }
+    *out_callbacks += g_xbe_perf_callbacks - cb0;
+    printf("XBE-PERF rep=%d surface=legacy issue_ns=%lld emit_ns=%lld release_ns=%lld\n",
+           rep, (long long) issue_ns, (long long) emit_ns, (long long) release_ns);
+    return 0;
+}
+
+// The store arm. adapter_resolve is INSIDE the issue window because legacy acquire takes the
+// tensor and does the same registry resolution internally; charging it to one arm only would
+// not be an A/B. Same placement as E-2b-1's XPERF prim arm.
+static int xbe_perf_rep_store(const XbeWeights & wt, const std::vector<int32_t> & ids,
+                              int32_t n_expert, uint64_t expert_size, uint64_t total_bytes,
+                              int rep, int64_t * out_callbacks, int * out_emit_bad) {
+    const int64_t cb0 = g_xbe_perf_callbacks;
+    int32_t mlpos = -1, part = -1;
+    uint64_t token = 0;
+    int64_t issue_ns = 0, emit_ns = 0, release_ns = 0;
+    for (int i = 0; i < XBE_PERF_INNER; i++) {
+        const int64_t t0 = xbe_now_ns();
+        int rc = ggml_moe_adapter_resolve(wt.w, &mlpos, &part);
+        if (rc == 0) {
+            rc = ggml_moe_store_acquire(mlpos, part, ids.data(), (int32_t) ids.size(),
+                                        XBE_NTOKEN, &token);
+        }
+        const int64_t t1 = xbe_now_ns();
+        if (rc < 0 || token == 0) {
+            fprintf(stderr, "xbe perf: store ggml_moe_store_acquire rc=%d token=%llu\n",
+                    rc, (unsigned long long) token);
+            return 75;
+        }
+        const int erc = ggml_moe_store_emit_expert_copies(
+            token, part, expert_size, total_bytes, n_expert,
+            ids.data(), (int32_t) ids.size(), xbe_perf_emit_noop, nullptr);
+        const int64_t t2 = xbe_now_ns();
+        ggml_moe_store_release(token);
+        const int64_t t3 = xbe_now_ns();
+        token = 0;                 // the handle is returned; keeping it live would be a lie
+        if (erc != 0) {
+            (*out_emit_bad)++;
+            fprintf(stderr, "xbe perf: store emit rc=%d\n", erc);
+            return 76;
+        }
+        issue_ns += t1 - t0;
+        emit_ns += t2 - t1;
+        release_ns += t3 - t2;
+    }
+    if (issue_ns < 0 || emit_ns < 0 || release_ns < 0) {
+        fprintf(stderr, "xbe perf: store rep %d has a negative interval (%lld/%lld/%lld ns)\n",
+                rep, (long long) issue_ns, (long long) emit_ns, (long long) release_ns);
+        return 77;
+    }
+    *out_callbacks += g_xbe_perf_callbacks - cb0;
+    printf("XBE-PERF rep=%d surface=store issue_ns=%lld emit_ns=%lld release_ns=%lld\n",
+           rep, (long long) issue_ns, (long long) emit_ns, (long long) release_ns);
+    return 0;
+}
+
+// --xbe-perf-ab : the section D-K Level 1 arm. Early-return region, exact-argv[1] rule, no
+// verdict - it prints raw per-repetition samples and e2b2_perf_ab.ps1 owns the pass line.
+// MOE_P1_TRACE is deliberately NOT set: a sample carrying observation overhead is not a
+// performance sample.
+//
+// PROTOCOL v2 (the contract e2b2_perf_ab.ps1 parses; this comment is not its authority, the
+// spec section D-K and the lead's protocol note are):
+//   argv     --xbe-perf-ab <n_used> <ab|ba>      EXACTLY four words, nothing else is accepted
+//   header   XBE-PERF mode=<ab|ba> n_used=<k> reps=<n> inner=<m>  exactly one
+//   sample   XBE-PERF rep=<i> surface=<legacy|store> issue_ns= emit_ns= release_ns=
+//            two per repetition, in the order the mode names, i = 0..reps-1, and each
+//            number is the SUM over <m> inner cycles - see XBE_PERF_INNER for why
+//   footer   XBE-PERF done reps= legacy= store= emit_rc_nonzero= callbacks_legacy=
+//            callbacks_store=                                    exactly one
+//            callbacks_* are RUN TOTALS: per-emit calls x inner x completed repetitions
+// Nothing else goes to stdout - every diagnostic in this arm is fprintf(stderr) and the
+// backend's own logging goes there too. `ab` runs legacy first, `ba` runs store first; the runner
+// alternates the mode across rounds so an order effect is mitigated rather than baked in.
+// Alternation stays at the REPETITION level: in repetition i the first arm runs all <m> of
+// its inner cycles, then the second arm runs all of its.
+//
+// The mode is a SELECTOR, not a label to echo: it picks the order of two arms that both run,
+// which is why an unknown third word is a usage error instead of a silent default. Under the
+// previous shape the third word named ONE arm and the runner spawned a process per arm, so
+// "one process, one cache state" was a claim the runner made and the child could not keep.
+//
+// ARGV IS STRICT, and this function owns all of it (Codex e2b2_perf_arm r2 F6). The arm takes
+// the whole vector rather than two pre-picked words because three of the four ways to get the
+// invocation wrong are invisible from the words alone:
+//   * `--xbe-perf-ab` with no n_used used to FALL THROUGH to the general suite path, which
+//     would have started a full selftest run under a perf argv - the worst outcome available,
+//     because it looks like it worked
+//   * `2junk` used to reach atoi and become 2, so a typo silently measured a different point
+//     than the one the log says
+//   * a fifth word used to be ignored, so a runner that passed an option this child never
+//     implemented got no signal that it had not been applied
+// All three are now rc 2 with a message naming the word. There is no default for any of them:
+// a perf sample nobody asked for is worse than no sample.
+static bool xbe_perf_parse_int(const char * s, int32_t * out) {
+    if (!s || !*s) return false;
+    int64_t v = 0;
+    for (const char * p = s; *p; p++) {
+        if (*p < '0' || *p > '9') return false;      // no sign, no space, no suffix
+        v = v * 10 + (*p - '0');
+        if (v > 0x7fffffff) return false;
+    }
+    *out = (int32_t) v;
+    return true;
+}
+
+static int run_xbe_perf_child(int argc, char ** argv) {
+    // exactly: <exe> --xbe-perf-ab <n_used> <ab|ba>
+    if (argc != 4) {
+        fprintf(stderr, "xbe perf: usage: --xbe-perf-ab <n_used> <ab|ba> (got %d argument(s))\n",
+                argc - 1);
+        return 2;
+    }
+    const char * n_used_arg = argv[2];
+    const char * order = argv[3];
+    const bool store_first = (std::strcmp(order, "ba") == 0);
+    if (!store_first && std::strcmp(order, "ab") != 0) {
+        fprintf(stderr, "xbe perf: unknown mode: %s (expected ab or ba)\n", order);
+        return 2;
+    }
+    int32_t n_used = 0;
+    if (!xbe_perf_parse_int(n_used_arg, &n_used)) {
+        fprintf(stderr, "xbe perf: n_used is not a plain integer: %s\n", n_used_arg);
+        return 2;
+    }
+    if (n_used <= 0 || n_used > XBE_PERF_NEXPERT) {
+        fprintf(stderr, "xbe perf: n_used out of range: %s\n", n_used_arg);
+        return 2;
+    }
+    // see the SCRATCH LIFETIME note above. Initialised AFTER the argument check so a usage
+    // error creates nothing at all, and guarded so that EVERY return below tears down -
+    // the error returns are exactly where a hand-written teardown gets forgotten.
+    //
+    // announce=false because THIS child's stdout is the Level 1 protocol. The helper
+    // announces the scratch directory on stdout by default, and that line arrives BEFORE
+    // the XBE-PERF header, so e2b2_perf_ab.ps1 counted it as a stray line and every round
+    // was red before it judged anything (Codex e2b2_perf_arm r3 F1, REACHABLE NOW). The
+    // fix is scoped to this call: no other selftest path loses its line, and the runner's
+    // stray-line rule is not relaxed - relaxing it would weaken the v2.2 contract instead
+    // of repairing what broke it.
+    init_scratch_root(/*announce=*/false);
+    XbeScratchGuard scratch;
+    XbeStore st;
+    if (!xbe_make_store(st, "xbe_perf", XBE_PERF_NEXPERT)) return 70;
+    ggml_backend_load_all();
+    ggml_backend_dev_t cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (!cpu_dev) return 72;
+    ggml_backend_t cpu = ggml_backend_dev_init(cpu_dev, nullptr);
+    if (!cpu) return 73;
+    XbeWeights wt;
+    if (!xbe_build_weights(wt, cpu, st, /*direct=*/true)) { ggml_backend_free(cpu); return 74; }
+    // seal AFTER the registration - see run_xbe_fatal_child for why the other order refuses.
+    if (xbe_seal_store(st) != 0) { ggml_backend_free(cpu); return 71; }
+    // The fixture BOTH arms are measured on, and it is const on purpose (Codex
+    // e2b2_perf_fix r1). Every strengthened rule in x2-12 pins the argument
+    // EXPRESSION each arm is handed, and an expression is not a value: an edit that
+    // swaps two ids before the store call and puts them back before the legacy call
+    // leaves BOTH call sites reading `ids` and still measures the two surfaces under
+    // two different conditions. A const vector cannot be swapped, so the compiler
+    // refuses that edit and the gate does not have to recognise every spelling of it.
+    // The lambda is what lets the vector be built and still be const - the same name,
+    // no mutable second copy left behind for an edit to reach for instead.
+    const std::vector<int32_t> ids = [n_used]() {
+        std::vector<int32_t> v;
+        for (int32_t i = 0; i < n_used; i++) v.push_back(i);
+        return v;
+    }();
+    // The emit argument vector, computed once and handed to BOTH surfaces unchanged, because
+    // "same arguments" is what makes the two numbers comparable at all.
+    const uint64_t expert_size = (uint64_t) wt.w->nb[2];
+    const uint64_t total_bytes = (uint64_t) ggml_nbytes(wt.w);
+    printf("XBE-PERF mode=%s n_used=%d reps=%d inner=%d\n",
+           store_first ? "ba" : "ab", (int) n_used, XBE_PERF_REPS, XBE_PERF_INNER);
+    int64_t cb_legacy = 0, cb_store = 0;
+    int n_legacy = 0, n_store = 0, emit_bad = 0;
+    // ONE loop, BOTH arms, alternating inside it. Every sample of both arms therefore comes
+    // from one process on one store, and the only thing separating the two numbers is which
+    // surface the repetition went through.
+    for (int rep = 0; rep < XBE_PERF_REPS; rep++) {
+        int rc = 0;
+        if (store_first) {
+            rc = xbe_perf_rep_store(wt, ids, st.n_expert, expert_size, total_bytes,
+                                    rep, &cb_store, &emit_bad);
+            if (rc == 0) {
+                n_store++;
+                rc = xbe_perf_rep_legacy(wt, ids, st.n_expert, expert_size, total_bytes,
+                                         rep, &cb_legacy, &emit_bad);
+                if (rc == 0) n_legacy++;
+            }
+        } else {
+            rc = xbe_perf_rep_legacy(wt, ids, st.n_expert, expert_size, total_bytes,
+                                     rep, &cb_legacy, &emit_bad);
+            if (rc == 0) {
+                n_legacy++;
+                rc = xbe_perf_rep_store(wt, ids, st.n_expert, expert_size, total_bytes,
+                                        rep, &cb_store, &emit_bad);
+                if (rc == 0) n_store++;
+            }
+        }
+        if (rc != 0) {
+            // The footer is the runner's completeness signal, so a run that stopped early
+            // must NOT print one. The non-zero exit is the whole message.
+            fflush(stdout);
+            ggml_backend_free(cpu);
+            return rc;
+        }
+    }
+    // Counted, not asserted: every number here is a variable this function incremented.
+    // callbacks_* are RUN TOTALS - per-emit calls x XBE_PERF_INNER x the repetitions that
+    // completed. The runner compares against the same product; the first version of this
+    // contract left the scope unstated and the runner expected one repetition's worth, which
+    // would have failed the very first Level 1 before it judged anything (Codex r2 F1).
+    printf("XBE-PERF done reps=%d legacy=%d store=%d emit_rc_nonzero=%d "
+           "callbacks_legacy=%lld callbacks_store=%lld\n",
+           XBE_PERF_REPS, n_legacy, n_store, emit_bad,
+           (long long) cb_legacy, (long long) cb_store);
+    fflush(stdout);
+    ggml_backend_free(cpu);
+    // 79 = the sampling itself was fine but this child could not delete its own scratch.
+    // It is outside this arm's own codes (2, 70-77) and outside the fatal arm's (70-76), and
+    // any non-zero reads as a failure to the perf runner that owns this child - the atom
+    // runner never spawns it (spec section D-K gives it to e2b2_perf_ab.ps1, and section F
+    // says so in as many words), and e2b1_perf_ab.ps1 is the standing precedent for how such
+    // a runner reads the code: `$res.exit -ne 0` is a failure, whatever the value.
+    return scratch.close() ? 0 : 79;
+}
+
+// ===========================================================================
+// XBE01..XBE12 - exactly twelve top-level check() calls, no gaps, no duplicates
+// ===========================================================================
+static void test_xbe_e2b2() {
+    section("XBE - E-2b-2 token-key emit on the scheduler path");
+
+    // ---- shared fixture: one store, ONE direct weight set, per-arm stock weight sets -----
+    // The direct set is shared by every registered arm, and it HAS to be. The seal compares
+    // the registration set against the MANIFEST both ways (L_scope == M_all,
+    // ggml-moe-direct.cpp:10447-10467), so a second tensor carrying the same source name is a
+    // "L_scope duplicate registration" and exactly one tensor per manifest part may be
+    // registered per seal. Registration also CLOSES at the seal (ggml_moe_direct_register
+    // :11489 returns -1 once g_mod.sealed), so the order is fixed and not a preference: open
+    // the backends, build and register the direct weights, and only then seal. The stock arms
+    // register nothing, so they keep their own per-arm sets and their own schedulers.
+    const std::vector<int32_t> ids_vals = xbe_ids(XBE_NTOKEN, XBE_NUSED, XBE_NEXPERT, 0);
+    const std::vector<int32_t> used     = xbe_used_set(ids_vals);
+    const std::vector<float>   mm_act   = xbe_rand_act((size_t)(XBE_K * XBE_NUSED * XBE_NTOKEN), 11);
+    const std::vector<float>   ad_act   = xbe_rand_act((size_t)(XBE_NEMBD * XBE_NUSED * XBE_NTOKEN), 12);
+
+    // ---- XBE07's episode runs FIRST, on a fixture of its very own ---------------------
+    // PhaseA latches at SEAL time, on BOTH sides, and neither latch can be moved afterwards:
+    //   ggml-moe-direct.cpp   `g_mod.phasea_on = ggml_moe_phasea_enabled();` inside seal, and
+    //                         note_seal is only called when that is true. Every store-side
+    //                         hook then reads `g_mod.phasea_on`.
+    //   ggml-moe-phasea.cpp   note_seal itself returns early on !pa_on(), and it is what sets
+    //                         g_pa.sealed - which acquire_enter and release_enter check before
+    //                         they write a single row.
+    // So a store sealed while PhaseA is off records nothing, forever, no matter what the env
+    // says later. That is what the 2026-09-01 17:02 run measured: the shared fixture is sealed
+    // at the top of this group with PhaseA off, this arm switched it on afterwards, and the
+    // sidecars came out 128 B each - a valid header (ledger_ok=1) over zero records.
+    // The arm therefore owns its fixture: env on, THEN build and register, THEN seal, THEN
+    // run - which is the order xcpu_run_mmid_addid has always used. It runs before the shared
+    // fixture exists because only one store may be sealed at a time and registration closes at
+    // the seal; its two resets hand a clean module to the shared fixture below. The check()
+    // itself still fires in numeric position, further down - computing a result early and
+    // reporting it in place costs nothing, and moving the print would break XBE01..XBE12.
+    bool pa_ok = false;
+    std::string pa_note = "not run";
+    {
+        ggml_moe_direct_reset_for_test();
+        ggml_moe_phasea_reset_for_test();
+        XbeStore st7;
+        // The sidecars go INSIDE the store's own case directory. Deriving the prefix from a
+        // store that failed to build would hand PHASEA_OUT an empty root and write \pa_*.pa
+        // into a drive root - the exact escape the child arms were repaired for - so the
+        // whole arm sits behind the store having been made.
+        if (xbe_make_store(st7, "xbe_pa")) {
+            const std::wstring prefix = st7.dir + L"\\pa";
+            // the value has to OUTLIVE the guard - EnvGuard keeps the char* only for the call,
+            // but a temporary std::string would die at the semicolon.
+            const std::string pa_out = wide_to_utf8(prefix);
+            EnvGuard g_pa("MOE_DIRECT_PHASEA", "timing");
+            EnvGuard g_out("MOE_DIRECT_PHASEA_OUT", pa_out.c_str());
+            XbeSched S5;
+            XbeWeights w7;
+            XbeGraph g5;
+            bool ran = false;
+            if (xbe_open_sched(S5)
+                && xbe_build_weights(w7, S5.cpu, st7, /*direct=*/true)
+                && xbe_seal_store(st7) == 0
+                && xbe_build_graph(g5, w7, XBE_G_MMID, XBE_NTOKEN, XBE_NUSED)) {
+                ggml_moe_phasea_run_begin();
+                ggml_moe_phasea_graph_begin(/*phase=*/1, /*n_tokens=*/XBE_NTOKEN);
+                ran = xbe_run(S5, g5, ids_vals, mm_act, nullptr);
+                ggml_moe_phasea_graph_end(/*n_nodes=*/1, /*n_splits=*/1);
+                ggml_moe_phasea_run_end(/*predicted_n=*/0, /*prompt_n=*/XBE_NTOKEN);
+            }
+            // The sidecars are written by ggml_moe_phasea_flush() and by nothing else - in
+            // production ggml_moe_direct_finalize() reaches it. reset_for_test() is
+            // `g_pa = PaState{}`: it DISCARDS the buffers without writing a byte.
+            ggml_moe_phasea_flush();
+            const PaFile led = pa_read(prefix + L"_ledger.pa");
+            int n_acq = 0, n_rel = 0, n_bad_part = 0;
+            if (led.ok && led.h.record_bytes == sizeof(PaLed)) {
+                for (uint64_t i = 0; i < led.h.record_count; i++) {
+                    PaLed r{};
+                    std::memcpy(&r, led.payload.data() + i * sizeof(PaLed), sizeof(PaLed));
+                    if (r.kind != 1 && r.kind != 4) continue;      // LED_ACQ_CALL / LED_REL_CALL
+                    if (r.kind == 1) n_acq++; else n_rel++;
+                    // the MUL_MAT_ID graph consumes part 0 (gate.weight) and nothing else
+                    if (r.part != 0 || r.layer != 0) n_bad_part++;
+                }
+            }
+            pa_ok = ran && led.ok && n_acq >= 1 && n_rel >= 1 && n_bad_part == 0;
+            pa_note = "acq=" + std::to_string(n_acq) + " rel=" + std::to_string(n_rel) +
+                      " wrong_lp=" + std::to_string(n_bad_part) +
+                      " ledger_ok=" + std::to_string((int) led.ok) +
+                      " records=" + std::to_string((unsigned long long) led.h.record_count);
+        }
+        ggml_moe_phasea_reset_for_test();   // PhaseA back to off for every other arm
+        ggml_moe_direct_reset_for_test();   // and a clean module for the shared seal below
+    }
+
+    XbeStore st;
+    XbeSched S;
+    XbeWeights wdir;
+    const bool sched_ok = xbe_make_store(st, "xbe_main") && xbe_open_sched(S)
+                          && xbe_build_weights(wdir, S.cpu, st, /*direct=*/true);
+    const bool store_ok = sched_ok && xbe_seal_store(st) == 0;
+
+    // ---- XBE01: the double binds, and the registered host weight becomes a SPLIT INPUT ---
+    // Three things at once because they are one fact: the scheduler took the double, it put
+    // the MUL_MAT_ID node THERE, and the CPU-resident weight therefore had to travel. If any
+    // one of them is false the rest of the group would be testing an unsplit graph.
+    bool w_placed = false, w_is_input = false, run1 = false;
+    std::vector<uint8_t> direct_mm;
+    XbeGraph gmm;
+    if (store_ok && xbe_build_graph(gmm, wdir, XBE_G_MMID, XBE_NTOKEN, XBE_NUSED)) {
+        run1 = xbe_run(S, gmm, ids_vals, mm_act, &direct_mm);
+        w_placed = ggml_backend_sched_get_tensor_backend(S.sched, gmm.out) == S.dbl;
+        // the weight arrives as SET traffic on the double - that IS "it was a split input"
+        w_is_input = !xbe_sets(S.slice(), "").empty();
+    }
+    check(sched_ok && run1 && w_placed && w_is_input,
+          "XBE01. the offload double takes the MUL_MAT_ID node and the registered host weight "
+          "travels to it as a split input [sched=" + std::to_string((int) sched_ok) +
+          " run=" + std::to_string((int) run1) + " placed=" + std::to_string((int) w_placed) +
+          " input=" + std::to_string((int) w_is_input) + "]");
+
+    // ---- XBE02: the copies are EXPERT-WISE, with the slab-boundary zero fill --------------
+    // The discriminator between this atom's path and the stock one is the SHAPE of the
+    // traffic: stock groups consecutive experts into one big copy, the store emits one copy
+    // per used expert at id*expert_size plus a <=512 B tail. R4-3: `src == NULL` is not
+    // observable (the scheduler substitutes a static zero page), so the zero fill is judged
+    // by its shape on the way in AND by the destination bytes after the drain.
+    int n_expert_sets = 0, n_zero_sets = 0, n_oob = 0;
+    bool offsets_ok = true, zero_bytes_ok = true;
+    if (run1) {
+        const uint64_t esz = (uint64_t) gmm.out ? (uint64_t) wdir.w->nb[2] : 0;
+        for (const XbeEvent & e : xbe_sets(S.slice(), "")) {
+            if (esz && e.len == esz) {
+                n_expert_sets++;
+                bool matched = false;
+                for (int32_t id : used) if (e.off == (uint64_t) id * esz) matched = true;
+                if (!matched) offsets_ok = false;
+            } else if (e.len > 0 && e.len <= XBE_ZPAD_MAX) {
+                n_zero_sets++;
+                // Read the bytes back out of the SET's OWN destination. `e.off` is an
+                // offset into the split-input COPY of the weight; the graph output is a
+                // different tensor and a far smaller one (M*n_used*n_token*4 = 32 KiB
+                // against the weight's 512 KiB), so asking for the same offset there ran
+                // off the end and ggml_backend_tensor_get's bounds assert killed the
+                // process at XBE02, before the other ten checks had run at all.
+                // The range is tested HERE, first: a fail-close belongs in the run as a
+                // FAIL carrying its numbers, not as an abort that costs the rest of the
+                // group. The assert stays exactly as strict as it was - this reads the
+                // bytes the contract names, inside the tensor that actually holds them.
+                if (!e.dst_t || e.off + e.len > (uint64_t) ggml_nbytes(e.dst_t)) {
+                    n_oob++;
+                    zero_bytes_ok = false;
+                } else if (!xbe_zero_is_zero(e.dst_t, e.off, e.len)) {
+                    zero_bytes_ok = false;
+                }
+            }
+        }
+    }
+    check(run1 && n_expert_sets == (int) used.size() && offsets_ok
+              && n_zero_sets >= 1 && zero_bytes_ok && n_oob == 0
+              && ggml_moe_direct_fallback_count() == 0,
+          "XBE02. the emit is one copy per USED expert at id*expert_size plus a bounded "
+          "zero-fill whose bytes really are zero, and no structural fallback fired "
+          "[experts=" + std::to_string(n_expert_sets) + "/" + std::to_string(used.size()) +
+          " zero=" + std::to_string(n_zero_sets) + " off_ok=" + std::to_string((int) offsets_ok) +
+          " zeroed=" + std::to_string((int) zero_bytes_ok) +
+          " oob=" + std::to_string(n_oob) +
+          " fallback=" + std::to_string((unsigned long long) ggml_moe_direct_fallback_count()) + "]");
+
+    // ---- XBE03: lease accounting ---------------------------------------------------------
+    // Peak handles == 1 is a property of the fixture (one registered input per split), and it
+    // is the half that says the token was actually TAKEN; the three zeroed axes are the half
+    // that says it was given back.
+    int64_t peak_handles = 0;
+    if (run1) for (const XbeEvent & e : S.slice()) if (e.handles > peak_handles) peak_handles = e.handles;
+    check(run1 && peak_handles == 1 && xbe_axes_zero(),
+          "XBE03. one lease is outstanding at the peak and all three store axes return to zero "
+          "[peak=" + std::to_string((long long) peak_handles) + " " + xbe_axes_text() + "]");
+
+    // ---- XBE04: the G-5 order witness ----------------------------------------------------
+    // R4-4: the slice ends at the FIRST compute, so the scheduler's own closing synchronize
+    // is out of the sample. What has to be true inside it: every SET precedes the RELEASE
+    // synchronize, that synchronize still sees the lease alive (handles >= 1 - it is the one
+    // the release waits for), and by COMPUTE the lease is gone (handles == 0). A release that
+    // ran before the synchronize would show handles == 0 at it.
+    //
+    // WHICH synchronize. The contract names exactly one (ggml-backend.cpp, the sched-release
+    // pinned region): the input-copy loop finishes, then `if (!moe_direct_split_leases.empty())
+    // { ggml_backend_synchronize(split_backend); for (...) ggml_moe_store_release(...); }`, and
+    // only then graph_compute_async. That is the LAST synchronize before the compute, not the
+    // first one in the slice. The generic input-copy path synchronizes the same backend several
+    // times on its way through the split - measured here as FOUR of them, which is exactly why
+    // XBE08 states its claim as a DELTA ('the registered one adds exactly the release
+    // synchronize', stock 4 -> direct 5) rather than as a total. Reading the first SYNC asked
+    // whether a lease was already held before the acquire had run, which it is not; the run of
+    // 2026-09-01 reported order=0 sync_live=0 compute_free=1 for that reason and for no other.
+    // The claim being witnessed is unchanged - the lease outlives the synchronize that guards
+    // its copies and is gone by the compute - it is now read off the event the contract names.
+    bool order_ok = false, sync_live = false, compute_free = false;
+    int n_sync_in_slice = 0;
+    if (run1) {
+        const std::vector<XbeEvent> sl = S.slice();
+        int last_set = -1, rel_sync = -1, first_compute = -1;
+        for (int i = 0; i < (int) sl.size(); i++) {
+            if (sl[i].kind == XBE_EV_COMPUTE && first_compute < 0) first_compute = i;
+            if (first_compute >= 0) continue;          // the release sync precedes the compute
+            if (sl[i].kind == XBE_EV_SET)  last_set = i;
+            if (sl[i].kind == XBE_EV_SYNC) { rel_sync = i; n_sync_in_slice++; }
+        }
+        order_ok = last_set >= 0 && rel_sync > last_set && first_compute > rel_sync;
+        if (rel_sync >= 0)      sync_live    = sl[(size_t) rel_sync].handles >= 1;
+        if (first_compute >= 0) compute_free = sl[(size_t) first_compute].handles == 0;
+    }
+    check(run1 && order_ok && sync_live && compute_free,
+          "XBE04. the slice up to the first COMPUTE reads SET* -> the release SYNC -> COMPUTE, "
+          "the lease is still held at that synchronize and released before the compute "
+          "[order=" + std::to_string((int) order_ok) + " sync_live=" + std::to_string((int) sync_live) +
+          " compute_free=" + std::to_string((int) compute_free) +
+          " syncs=" + std::to_string(n_sync_in_slice) + "]");
+
+    // ---- XBE05: output identity, MUL_MAT_ID ----------------------------------------------
+    // The stock arm is an UNREGISTERED weight carrying the same bytes, so the scheduler takes
+    // its ordinary grouped-copy path. Identical output bytes is the claim; anything the token
+    // path did differently would have to be invisible in the result to pass, and the slab
+    // arithmetic is exactly what would not be.
+    std::vector<uint8_t> stock_mm;
+    bool run_stock_mm = false;
+    {
+        XbeSched S2;
+        XbeWeights wstk;
+        XbeGraph gstk;
+        if (xbe_open_sched(S2) && xbe_build_weights(wstk, S2.cpu, st, /*direct=*/false)
+            && xbe_build_graph(gstk, wstk, XBE_G_MMID, XBE_NTOKEN, XBE_NUSED)) {
+            run_stock_mm = xbe_run(S2, gstk, ids_vals, mm_act, &stock_mm);
+        }
+    }
+    check(run1 && run_stock_mm && !direct_mm.empty() && direct_mm == stock_mm,
+          "XBE05. MUL_MAT_ID output is byte-identical to the unregistered stock path "
+          "[direct=" + std::to_string(direct_mm.size()) + "B stock=" +
+          std::to_string(stock_mm.size()) + "B]");
+
+    // ---- XBE06: output identity, ADD_ID (the bias part, b110's branch) --------------------
+    std::vector<uint8_t> direct_add, stock_add;
+    bool run_dir_add = false, run_stk_add = false;
+    const uint64_t fb_before_add = ggml_moe_direct_fallback_count();
+    {
+        // The DIRECT arm reuses the one registered set: a second tensor named
+        // blk.0.ffn_gate_exps.bias is a duplicate registration, and past the seal a
+        // registration is refused outright, so this arm cannot own one. wdir lives on S.cpu
+        // and the scheduler places a pre-allocated tensor by its BUFFER TYPE, not by backend
+        // instance (ggml_backend_sched_backend_from_buffer, ggml-backend.cpp:854-866), so S3
+        // sees it exactly as S does.
+        XbeSched S3;
+        XbeGraph gd2;
+        if (store_ok && xbe_open_sched(S3)
+            && xbe_build_graph(gd2, wdir, XBE_G_ADDID, XBE_NTOKEN, XBE_NUSED)) {
+            run_dir_add = xbe_run(S3, gd2, ids_vals, ad_act, &direct_add);
+        }
+        XbeSched S4;
+        XbeWeights ws2;
+        XbeGraph gs2;
+        if (xbe_open_sched(S4) && xbe_build_weights(ws2, S4.cpu, st, /*direct=*/false)
+            && xbe_build_graph(gs2, ws2, XBE_G_ADDID, XBE_NTOKEN, XBE_NUSED)) {
+            run_stk_add = xbe_run(S4, gs2, ids_vals, ad_act, &stock_add);
+        }
+    }
+    check(run_dir_add && run_stk_add && !direct_add.empty() && direct_add == stock_add
+              && xbe_axes_zero() && ggml_moe_direct_fallback_count() == fb_before_add,
+          "XBE06. ADD_ID output is byte-identical to stock, the axes return to zero and no new "
+          "structural fallback fired [direct=" + std::to_string(direct_add.size()) +
+          "B stock=" + std::to_string(stock_add.size()) + "B " + xbe_axes_text() + "]");
+
+    // ---- XBE07: the part travels with the token, through PhaseA --------------------------
+    // The ledger is written by the store itself, so this is not the harness restating its own
+    // argument: the acquire and release rows carry the part the ADAPTER resolved, and the
+    // whole point of the b110 rewiring is that the backend stopped guessing it.
+    // The episode itself ran at the top of this group, on its own PhaseA-sealed fixture - see
+    // the note there for why it cannot run here. Only the verdict is reported at this
+    // position, so the printed order stays XBE01..XBE12.
+    check(pa_ok,
+          "XBE07. the PhaseA ledger's acquire and release rows carry the (layer, part) the "
+          "adapter resolved, not a value the backend guessed [" + pa_note + "]");
+
+    // ---- XBE08: a split with ZERO registered inputs is unchanged --------------------------
+    // The off/unregistered path must not gain a synchronize. This is the control that says
+    // the atom's edits are inert where they are supposed to be inert.
+    int stock_syncs = -1, direct_syncs = -1;
+    {
+        XbeSched S6;
+        XbeWeights ws3;
+        XbeGraph gs3;
+        if (xbe_open_sched(S6) && xbe_build_weights(ws3, S6.cpu, st, /*direct=*/false)
+            && xbe_build_graph(gs3, ws3, XBE_G_MMID, XBE_NTOKEN, XBE_NUSED)
+            && xbe_run(S6, gs3, ids_vals, mm_act, nullptr)) {
+            stock_syncs = xbe_count_kind(S6.slice(), XBE_EV_SYNC);
+        }
+    }
+    if (run1) direct_syncs = xbe_count_kind(S.slice(), XBE_EV_SYNC);
+    check(stock_syncs >= 0 && direct_syncs >= 0 && direct_syncs == stock_syncs + 1
+              && xbe_axes_zero(),
+          "XBE08. the unregistered split keeps its stock synchronize count and holds no "
+          "handles; the registered one adds exactly the release synchronize "
+          "[stock=" + std::to_string(stock_syncs) + " direct=" + std::to_string(direct_syncs) + "]");
+
+    // ---- XBE09: the bytes cross-check agrees with ggml's own stride -----------------------
+    // Two independent producers of the same number: ggml's tensor strides and the manifest the
+    // store sealed. A1-R's entry comparison is what would abort if they ever disagreed, so a
+    // silent run IS the positive result - and it is asserted, not assumed.
+    // Every arm from here down dereferences wdir.w AND talks to the sealed store. When the
+    // fixture did not open, wdir.w is null: reading its stride was an access violation
+    // (0xC0000005) that killed the process mid-group and took the whole run's totals and
+    // receipt with it. A refused seal has to leave FAILing checks behind, not a corpse.
+    bool bytes_ok = store_ok;
+    int n_viewed = 0;
+    if (store_ok) {
+        uint64_t token = 0;
+        std::vector<int32_t> cap(used.begin(), used.end());
+        if (ggml_moe_store_acquire(0, 0, cap.data(), (int32_t) cap.size(), XBE_NTOKEN, &token) == 0) {
+            for (int32_t id : cap) {
+                ggml_moe_buffer_view v{};
+                if (ggml_moe_store_view(token, id, 0, &v) != 0) { bytes_ok = false; continue; }
+                n_viewed++;
+                if (v.bytes != (uint64_t) wdir.w->nb[2]) bytes_ok = false;
+            }
+            ggml_moe_store_release(token);
+        } else {
+            bytes_ok = false;
+        }
+    }
+    check(bytes_ok && n_viewed == (int) used.size() && xbe_axes_zero(),
+          "XBE09. every captured expert's view reports exactly the ggml stride the consumer "
+          "reads with [viewed=" + std::to_string(n_viewed) + "/" + std::to_string(used.size()) + "]");
+
+    // ---- XBE10: ...and the comparison DISCRIMINATES ---------------------------------------
+    // XBE09 alone would pass against a view that returned any constant. This is the other
+    // half: the same number compared against stride +/- 1 has to be unequal, which is what
+    // makes XBE09's equality evidence rather than a coincidence of shapes.
+    bool discriminates = false;
+    if (store_ok) {
+        const uint64_t stride = (uint64_t) wdir.w->nb[2];
+        uint64_t token = 0;
+        std::vector<int32_t> cap(used.begin(), used.end());
+        if (ggml_moe_store_acquire(0, 0, cap.data(), (int32_t) cap.size(), XBE_NTOKEN, &token) == 0) {
+            ggml_moe_buffer_view v{};
+            if (ggml_moe_store_view(token, cap[0], 0, &v) == 0) {
+                discriminates = (v.bytes != stride + 1) && (v.bytes != stride - 1);
+            }
+            ggml_moe_store_release(token);
+        }
+    }
+    check(discriminates && xbe_axes_zero(),
+          "XBE10. the same view bytes are NOT equal to the stride off by one, so XBE09's "
+          "equality is a measurement and not a shape coincidence");
+
+    // ---- XBE11: token-key emit == tensor-key emit, against an INDEPENDENT oracle ----------
+    // The spec is explicit that comparing the two emit surfaces alone is not enough: a shared
+    // error passes both. The third opinion is bin_hash - the generator the fixture's own
+    // experts.bin was written from - so the slab bytes, the boundary zero-fill and the
+    // untouched 0xAA sentinel are all checked against something neither emit produced.
+    // Three named counters rather than one boolean: when the oracle disagrees, "which of the
+    // three clauses" is the whole of the diagnosis, and a single flag hides it.
+    bool emit_equal = false, oracle_ok = false;
+    int n_bad_bytes = 0, n_bad_zero = 0, n_bad_sent = 0;
+    if (store_ok) {
+        const uint64_t esz   = (uint64_t) wdir.w->nb[2];
+        const uint64_t total = (uint64_t) ggml_nbytes(wdir.w);
+        std::vector<uint8_t> dst_tok((size_t) total, 0xAA), dst_ten((size_t) total, 0xAA);
+        struct Ud { std::vector<uint8_t> * v; };
+        auto emit_fn = [](void * u, const void * src, uint64_t dst_offset, uint64_t len) {
+            Ud * c = (Ud *) u;
+            if (dst_offset + len > c->v->size()) return;
+            if (src) std::memcpy(c->v->data() + dst_offset, src, (size_t) len);
+            else     std::memset(c->v->data() + dst_offset, 0, (size_t) len);
+        };
+        std::vector<int32_t> cap(used.begin(), used.end());
+        uint64_t token = 0;
+        Ud ut{ &dst_tok }, un{ &dst_ten };
+        const bool acq = ggml_moe_store_acquire(0, 0, cap.data(), (int32_t) cap.size(),
+                                                XBE_NTOKEN, &token) == 0;
+        if (acq) {
+            const int rc_tok = ggml_moe_store_emit_expert_copies(
+                token, 0, esz, total, XBE_NEXPERT, cap.data(), (int32_t) cap.size(), emit_fn, &ut);
+            const int rc_ten = ggml_moe_direct_emit_expert_copies(
+                wdir.w, esz, total, XBE_NEXPERT, cap.data(), (int32_t) cap.size(), emit_fn, &un);
+            ggml_moe_store_release(token);
