+// ── P12. ★실 capture→worker→**자연 wake**→admission→publish E2E(수동 turn 강제 없음) ──
+static void test_pb_e2e_natural_wake() {
+    section("P12. ★실 wire E2E — capture→worker→intent→**자연 wake**(query turn 강제 없음)→admission→publish");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_e2e");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P12a. seal 성공")) return;
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    std::vector<float> w0, w1, rt1, x((size_t)PB_TEST_N_EMBD);
+    pb_fill_snapshot(PB_TEST_N_EMBD, PB_TEST_N_EXPERT, 424242, w0, w1, rt1);
+    std::mt19937 rng(7); std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (auto & v : x) v = ud(rng);
+
+    // 층 1의 expert 1..7 상주 → 후보 1건으로 고정(결정론).
+    std::vector<int32_t> pre = {1,2,3,4,5,6,7};
+    ggml_moe_direct_acquire(g1, pre.data(), 7, 1);
+    ggml_moe_direct_release(g1, pre.data(), 7);
+
+    const uint64_t iss0 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED);
+    ggml_moe_phaseb_run_begin();
+    ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+    const int cap_rc = ggml_moe_phaseb_capture(0, -1, x.data(), (int32_t)GGML_TYPE_F32,
+                                               PB_TEST_N_EMBD, 1, 1, 1);
+    // ★여기서 command 왕복을 **일절 하지 않는다** — worker의 intent enqueue가 dispatcher를
+    //   깨우지 못하면(R1 #2 ① lost-wake) 아래 대기가 타임아웃 나야 한다.
+    uint64_t iss1 = iss0;
+    for (int i = 0; i < 3000 && iss1 == iss0; i++) { Sleep(1); iss1 = ggml_moe_phaseb_counter(GGML_MOE_PB_C_ISSUED); }
+    check(cap_rc == 1 && iss1 > iss0,
+          "P12b. ★★자연 wake — capture 1건이 command 왕복 없이 admission·submit 까지 도달"
+          "(issued " + std::to_string(iss0) + "→" + std::to_string(iss1) + " · lost-wake면 타임아웃)");
+    ggml_moe_direct_test_pb_quiesce(3000);
+    // ★실 predictor의 top-k는 합성 스냅샷이 정하므로 특정 expert를 가정하지 않는다 —
+    //   "waiter 無 publish → READY_PROBATION" 상태기계만 확인한다.
+    int32_t n_prob = 0;
+    for (int32_t i = 0; i < PB_TEST_N_EXPERT; i++) {
+        int32_t c = -1, rk = -1; uint64_t o = 0;
+        ggml_moe_direct_test_slot_class(i, &c, &o, &rk);
+        if (c == GGML_MOE_PB_CLASS_PROBATION) n_prob++;
+    }
+    check(n_prob >= 1,
+          "P12c. ★실 신호로 publish된 슬롯이 READY_PROBATION(" + std::to_string(n_prob) +
+          "건) — 실 capture→worker→admission→publish E2E 폐합");
+    ggml_moe_phaseb_graph_end();
+    ggml_moe_phaseb_run_end();
+}
