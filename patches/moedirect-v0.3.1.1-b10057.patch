+static SynthModel make_2shard_model() {
+    SynthModel m; m.arch = "mistral4"; m.n_expert = 8; m.n_expert_used = 2; m.n_layer = 2;
+    // 값 상이 2 shard(Mistral 실측 근사: s0 data_start=7887680, s1=17024·양쪽 v3/align32).
+    SynthSource s0; s0.path = "C:\\fake\\mistral-00001-of-00002.gguf"; s0.bytes = 111111; s0.mtime = 1700000001; s0.data_start = 7887680; s0.gguf_version = 3; s0.alignment = 32;
+    SynthSource s1; s1.path = "C:\\fake\\mistral-00002-of-00002.gguf"; s1.bytes = 222222; s1.mtime = 1700000099; s1.data_start = 17024;   s1.gguf_version = 3; s1.alignment = 32;
+    m.sources = { s0, s1 };
+    // Mistral 경계처럼 layer0=shard0, layer1=shard1 (parts.source_index 상이).
+    m.layers = { make_separate_layer(0, 8, "MXFP4", false, true, 0),
+                 make_separate_layer(1, 8, "MXFP4", false, true, 1) };
+    return m;
+}
