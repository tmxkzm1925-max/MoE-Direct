+// ===========================================================================
+// S2CHAR - the S2 decode() path (admission -> host prelude -> range run, the dispose table's
+//   handled/rc mapping, the prelude re-run after FALLTHROUGH, and the bench attribution of an S2
+//   decode) characterized through real llama_decode on a synthetic qwen35moe model (T-CHAR).
+//   The suite parent pins MOE_DIRECT=1 through a call_once cache (0a above) and a synthetic model
+//   cannot load under it, so the cases run in a child process in the trace-on child's form: the
+//   child clears MOE_DIRECT before anything reads it, runs the engine entry once per group, and
+//   prints each group's closing banner and total. The banner names are the required_groups names
+//   the runner reads by name (rb_atom_run.ps1 Read-SuiteGroups); the parent scores the child's
+//   exit code with its own three checks.
+// ===========================================================================
+extern "C" LLAMA_API int llama_s2_char_selfcheck(void (*cb)(void * ud, int ok, const char * name), void * ud, int mode);
+
+static void s2char_engine_cb(void * ud, int ok, const char * name) {
+    (void) ud;
+    check(ok != 0, name ? name : "(unnamed S2CHAR check)");
+}
+
+static int run_s2char_cases_child(const char * only) {
+    // Without an argument the child runs the T-CHAR groups S2CHAR-DECODE and S2CHAR-ATTR; with a
+    // group's banner name it runs that group alone (T-BENCH: the sibling parent group S2BENCH
+    // spawns `--s2char-cases OBSERVE-BENCH`, so each group runs once per suite).
+    struct s2char_group { const char * banner; int mode; };
+    const s2char_group all_groups[] = {
+        { "S2CHAR-DECODE", 1 },
+        { "S2CHAR-ATTR",   2 },
+        { "OBSERVE-BENCH", 3 },
+    };
+    std::vector<s2char_group> groups;
+    for (const auto & g : all_groups) {
+        if (only ? std::strcmp(g.banner, only) == 0 : g.mode != 3) {
+            groups.push_back(g);
+        }
+    }
+    if (groups.empty()) {
+        fprintf(stderr, "--s2char-cases: unknown group '%s'\n", only ? only : "");
+        return 2;
+    }
+
+    // The child inherits the parent's MOE_DIRECT=1; it must be gone before any
+    // ggml_moe_direct_enabled() call fixes the call_once cache.
+    clear_env("MOE_DIRECT");
+    init_scratch_root();
+    ggml_backend_load_all();   // the child registers its own backends (the P42 precedent)
+
+    for (const auto & g : groups) {
+        const int t0 = g_total;
+        const int f0 = g_failed;
+        const int engine_failed = llama_s2_char_selfcheck(s2char_engine_cb, nullptr, g.mode);
+        check(g_total - t0 > 0 && engine_failed == g_failed - f0,
+              std::string(g.banner) + "-z. accounting: the engine's failed-case count equals the FAIL lines the "
+              "harness counted for this group (no lost or doubled callback)");
+        const int total  = g_total - t0;
+        const int failed = g_failed - f0;
+        printf("\n==== %s ====\n%d/%d PASS", g.banner, total - failed, total);
+        if (failed > 0) printf(" (%d FAIL)", failed);
+        printf("\n"); fflush(stdout);
+    }
+    // The child tears down its own scratch root, and a failed teardown reaches the exit code.
+    const bool child_torn_down = teardown_scratch_root(g_failed == 0);
+    return (g_failed == 0 && child_torn_down) ? 0 : 1;
+}
+static void test_s2char_cases() {
+    section("S2CHAR. S2 decode() characterization through llama_decode on a synthetic qwen35moe model (child process)");
+    wchar_t exe[MAX_PATH]; DWORD n = GetModuleFileNameW(nullptr, exe, MAX_PATH);
+    if (!check(n > 0 && n < MAX_PATH, "S2CHAR-a. exe path lookup")) return;
+    std::wstring cmd = L"\"" + std::wstring(exe) + L"\" --s2char-cases";
+    std::vector<wchar_t> cb(cmd.begin(), cmd.end()); cb.push_back(L'\0');
+    STARTUPINFOW si; ZeroMemory(&si, sizeof(si)); si.cb = sizeof(si);
+    PROCESS_INFORMATION pi; ZeroMemory(&pi, sizeof(pi));
+    BOOL ok = CreateProcessW(exe, cb.data(), nullptr, nullptr, FALSE, 0, nullptr, nullptr, &si, &pi);
+    if (!check(ok, "S2CHAR-b. the s2char-cases child process starts")) return;
+    WaitForSingleObject(pi.hProcess, INFINITE);
+    DWORD ec = 0xFFFFFFFF; GetExitCodeProcess(pi.hProcess, &ec);
+    CloseHandle(pi.hProcess); CloseHandle(pi.hThread);
+    printf("    (note) s2char-cases child exit code = %lu\n", (unsigned long)ec);
+    check(ec == 0, "S2CHAR-c. the s2char-cases child (groups S2CHAR-DECODE and S2CHAR-ATTR) passed every case and "
+                   "tore down its scratch (exit 0)");
+}
