+// ===========================================================================
+// arm 4: `--xcpu-off-test` - the enabled()==false short-circuit (XCPU11)
+// ===========================================================================
+// The dispatch fixes MOE_DIRECT=0 BEFORE the first ggml_moe_direct_enabled() call. That read
+// is cached by std::call_once (ggml-moe-direct.cpp:11310) and the parent's main() sets the
+// flag to 1 before any group runs, so this branch is unreachable in the parent and needs a
+// process of its own.
+//
+// What this arm proves. A tensor that is registered AND SEALED, in a process where enabled()
+// is false, must take the ORIGINAL path: the same bytes as stock, no token issued, all three
+// ledgers at zero, no structural fallback. XCPU09 cannot reach this branch - there enabled()
+// is true and is_registered() is false, which is the OTHER operand of the same conjunction.
+//
+// The seal is not incidental to that claim, it is what makes it checkable. seal protects every
+// registered tensor's interior pages with PAGE_NOACCESS and installs the VEH, neither of them
+// gated on enabled() (ggml-moe-direct.cpp:10513-10540, :10713). So with the flag off, the
+// original path's first read of each protected page lands in the VEH, which increments
+// touch_events, increments touch_pages once per unique page, restores that page to
+// PAGE_READONLY and CONTINUES EXECUTION (:4384-4388). The process is terminated only when the
+// UNIQUE page count reaches touch_abort_threshold (:4378) - reaching the tripwire is not
+// itself fatal.
+// The counters are therefore POSITIVE EVIDENCE here, not a defect: touch_events > 0 and
+// touch_pages > 0 say the kernel really did read t->data instead of the store, and
+// touch_pages < touch_abort says the run stayed inside the window where that is observable.
+// An arm that asserted touch == 0 on a sealed store would be asserting that the OFF path
+// never ran.
+static int xcpu_child_off() {
+    const bool enabled = ggml_moe_direct_enabled();
+    if (enabled) {
+        // The env did not take. Everything below would be measuring the ON path.
+        printf("xcpu_off_ok=0 xcpu_off_stage=0 xcpu_off_enabled=1\n"); fflush(stdout); return 0;
+    }
+    init_scratch_root();
+    XcpuStore st;
+    if (!xcpu_make_store(st, "xcpu_off", XCPU_S_NEXPERT, XCPU_S_NUSED,
+                         XCPU_OFF_K, XCPU_OFF_M, XCPU_OFF_NEMBD, 424242u)) {
+        printf("xcpu_off_ok=0 xcpu_off_stage=90\n"); fflush(stdout); return 0;
+    }
+    XcpuBackend be; xcpu_open_backend(be, 4);
+    if (!be.ok) { printf("xcpu_off_ok=0 xcpu_off_stage=91\n"); fflush(stdout); return 0; }
+
+    std::vector<int32_t> idv((size_t) XCPU_S_NUSED * XCPU_OFF_NTOKEN);
+    for (size_t i = 0; i < idv.size(); i++) idv[i] = (int32_t)(i % XCPU_S_NEXPERT);
+    std::mt19937 rng(5150u); std::uniform_real_distribution<float> dd(-1.0f, 1.0f);
+    std::vector<float> mm_act((size_t)(XCPU_OFF_K * XCPU_S_NUSED * XCPU_OFF_NTOKEN));
+    std::vector<float> add_act((size_t)(XCPU_OFF_NEMBD * XCPU_S_NUSED * XCPU_OFF_NTOKEN));
+    for (size_t i = 0; i < mm_act.size(); i++)  mm_act[i]  = dd(rng);
+    for (size_t i = 0; i < add_act.size(); i++) add_act[i] = dd(rng);
+
+    // (1) STOCK - nothing registered, nothing sealed. The byte oracle.
+    XcpuPairGraph gs;
+    if (!xcpu_build_pair_graph(gs, be.backend, false, st, XCPU_OFF_K, XCPU_OFF_M, XCPU_OFF_NEMBD,
+                               XCPU_OFF_NTOKEN, XCPU_S_NUSED, idv, mm_act, add_act)) {
+        printf("xcpu_off_ok=0 xcpu_off_stage=92\n"); fflush(stdout); return 0;
+    }
+    const ggml_status s1 = ggml_backend_graph_compute(be.backend, gs.graph);
+    std::vector<uint8_t> ref_mm(ggml_nbytes(gs.mm_out)), ref_add(ggml_nbytes(gs.add_out));
+    ggml_backend_tensor_get(gs.mm_out, ref_mm.data(), 0, ref_mm.size());
+    ggml_backend_tensor_get(gs.add_out, ref_add.data(), 0, ref_add.size());
+
+    // (2) REGISTERED and SEALED, flag OFF.
+    //     Order is load-bearing and is not a matter of taste:
+    //       build (direct=true, so the two weight tensors are QUEUED for registration)
+    //       -> write the payload
+    //       -> seal
+    //     ggml_moe_direct_register() only appends to g_mod.pending (ggml-moe-direct.cpp:11320);
+    //     it is SEAL that publishes g_mod.registry (:10497), and is_registered() reads the
+    //     registry alone (:11395). So without a seal both tensors would read back as NOT
+    //     registered and this arm would assert on a branch it never entered.
+    //     The payload must be written BEFORE the seal, because seal turns those pages into
+    //     PAGE_NOACCESS and the VEH returns CONTINUE_SEARCH for a WRITE fault (:4383) - a
+    //     write afterwards is a crash, not a slow path.
+    XcpuPairGraph gd;
+    if (!xcpu_build_pair_graph(gd, be.backend, true, st, XCPU_OFF_K, XCPU_OFF_M, XCPU_OFF_NEMBD,
+                               XCPU_OFF_NTOKEN, XCPU_S_NUSED, idv, mm_act, add_act)) {
+        printf("xcpu_off_ok=0 xcpu_off_stage=93\n"); fflush(stdout); return 0;
+    }
+    for (int e = 0; e < XCPU_S_NEXPERT; e++) {
+        ggml_backend_tensor_set(gd.w, st.wpe[(size_t) e].data(), (size_t) e * gd.w->nb[2],
+                                st.wpe[(size_t) e].size());
+        ggml_backend_tensor_set(gd.b, st.bpe[(size_t) e].data(), (size_t) e * gd.b->nb[1],
+                                st.bpe[(size_t) e].size());
+    }
+    if (xcpu_seal_store(st) != 0) {
+        printf("xcpu_off_ok=0 xcpu_off_stage=94\n"); fflush(stdout); return 0;
+    }
+    const bool reg_w = ggml_moe_direct_is_registered(gd.w);
+    const bool reg_b = ggml_moe_direct_is_registered(gd.b);
+    const int64_t epoch = (int64_t) ggml_moe_store_epoch();
+    // With the flag off, moe_direct_active is false for BOTH consumers, so the kernel reads
+    // t->data - which the seal just protected. Every first read of an interior page therefore
+    // lands in the VEH, which counts it, restores the page to PAGE_READONLY and CONTINUES
+    // (:4384-4388). The graph completes and its output is the stock output; the tripwire is
+    // what says the original path really was the one that ran.
+    const ggml_status s2 = ggml_backend_graph_compute(be.backend, gd.graph);
+    std::vector<uint8_t> got_mm(ref_mm.size()), got_add(ref_add.size());
+    ggml_backend_tensor_get(gd.mm_out, got_mm.data(), 0, got_mm.size());
+    ggml_backend_tensor_get(gd.add_out, got_add.data(), 0, got_add.size());
+    const bool eq_mm  = std::memcmp(got_mm.data(),  ref_mm.data(),  ref_mm.size())  == 0;
+    const bool eq_add = std::memcmp(got_add.data(), ref_add.data(), ref_add.size()) == 0;
+
+    int64_t h = -1, u = -1, sl = -1;
+    ggml_moe_store_outstanding(&h, &u, &sl);
+    const int64_t tev  = (int64_t) ggml_moe_direct_touch_events();
+    const int64_t tpg  = (int64_t) ggml_moe_direct_touch_pages();
+    const int64_t fbk  = (int64_t) ggml_moe_direct_fallback_count();
+    const int64_t tab  = (int64_t) XCPU_SEAL_TOUCH_ABORT;
+
+    const bool ok = (!enabled) && reg_w && reg_b && (epoch > 0)
+                 && (s1 == GGML_STATUS_SUCCESS) && (s2 == GGML_STATUS_SUCCESS)
+                 && eq_mm && eq_add
+                 && (h == 0) && (u == 0) && (sl == 0)
+                 && (fbk == 0)
+                 && (tev > 0) && (tpg > 0) && (tpg < tab);
+    printf("xcpu_off_ok=%d xcpu_off_stage=10 xcpu_off_enabled=%d xcpu_off_regw=%d "
+           "xcpu_off_regb=%d xcpu_off_s1=%d xcpu_off_s2=%d xcpu_off_eqmm=%d xcpu_off_eqadd=%d "
+           "xcpu_off_h=%lld xcpu_off_u=%lld xcpu_off_slots=%lld xcpu_off_touch_events=%lld "
+           "xcpu_off_touch_pages=%lld xcpu_off_abort=%lld xcpu_off_fbk=%lld "
+           "xcpu_off_epoch=%lld xcpu_off_sealed=1\n",
+           ok ? 1 : 0, enabled ? 1 : 0, reg_w ? 1 : 0, reg_b ? 1 : 0,
+           (int) s1, (int) s2, eq_mm ? 1 : 0, eq_add ? 1 : 0,
+           (long long) h, (long long) u, (long long) sl, (long long) tev,
+           (long long) tpg, (long long) tab, (long long) fbk, (long long) epoch);
+    fflush(stdout);
+    return 0;
+}
+
+static int run_xcpu_off_child() {
+    return xcpu_child_off();
+}
+
+static int run_xcpu_graph_child(const char * mode) {
+    // MOE_P1_TRACE has to be fixed before the FIRST trace call of the process - the read is
+    // cached by std::call_once, which is the whole reason these three arms are children.
+    set_env("MOE_P1_TRACE", "1");
+    const bool is_hold  = (std::strcmp(mode, "hold")  == 0);
+    const bool is_mmid  = (std::strcmp(mode, "mmid")  == 0);
+    const bool is_addid = (std::strcmp(mode, "addid") == 0);
+    if (!is_hold && !is_mmid && !is_addid) {
+        fprintf(stderr, "xcpu-graph-child: unknown mode %s\n", mode);
+        return 77;
+    }
+    init_scratch_root();
+    if (!ggml_moe_trace_enabled()) {
+        printf("xcpu_%s_ok=0 xcpu_%s_stage=0\n", mode, mode); fflush(stdout); return 0;
+    }
+    if (is_hold) return xcpu_child_hold();
+    return xcpu_child_mw(is_mmid);
+}
+
+// ===========================================================================
+// --xcpu-perf-ab : the G-3 (b) performance A/B measurement arm (E2B1_ATOM_SPEC section D-K).
+//   An early-return CLI arm, like --xstore-budget-test: it is OUTSIDE run_group, so the
+//   check count is untouched (exact delta stays 14). It PRINTS RAW PER-REPETITION SAMPLES
+//   and takes no verdict - the median / p95 / minimum / variance and the D11 pass line live
+//   in e2b1_perf_ab.ps1, so the thresholds have exactly one home and nothing here has to be
+//   kept in sync with a number written down somewhere else.
+//   Two modes:
+//     prim   Level 1 - the two SURFACES timed against each other inside one process, one
+//            binary, so nothing but the surface differs. Answers "issue latency per batch"
+//            and "cost per view".
+//     opwall Level 2 - the op wall of a real graph. The .ps1 runs this same exe twice with
+//            two DLL sets beside it (E-2b-0's and E-2b-1's) and pairs the results.
+//   Trace is OFF in this process (nothing sets MOE_P1_TRACE), which section C's D7 note
+//   requires: a run carrying observation overhead is not a performance sample.
+// ===========================================================================
+static const int32_t XPERF_NEXPERT = 64;
+static const int64_t XPERF_K       = 512;
+static const int64_t XPERF_M       = 512;
+static const int64_t XPERF_NEMBD   = 1024;
+static const int32_t XPERF_NUSED   = 8;
+static const int32_t XPERF_NTOKEN  = 64;
+static const int32_t XPERF_THREADS = 8;
+static const int32_t XPERF_PRIM_REPS = 200;   // per surface, after warm-up
+static const int32_t XPERF_PRIM_WARM = 20;
+static const int32_t XPERF_OP_REPS   = 12;    // per invocation; the .ps1 pairs across stages
+static const int32_t XPERF_OP_WARM   = 3;
+// The view density one op really produces: mul_mat_id calls view once per (worker, active
+// expert), add_id once per row. Level 1 models the mul_mat_id side, which is the larger.
+static const int32_t XPERF_VIEWS_PER_ISSUE = XPERF_NEXPERT * XPERF_THREADS;
+
+static int64_t xperf_qpc() {
+    LARGE_INTEGER v; QueryPerformanceCounter(&v); return (int64_t) v.QuadPart;
+}
+static int64_t xperf_qpf() {
+    LARGE_INTEGER v; QueryPerformanceFrequency(&v); return (int64_t) v.QuadPart;
+}
+static void xperf_emit(const char * key, const std::vector<int64_t> & ns) {
+    printf("%s=", key);
+    for (size_t i = 0; i < ns.size(); i++) printf("%s%lld", i ? "," : "", (long long) ns[i]);
+    printf("\n");
+}
+
+// Every ggml*/llama* module this process has loaded, by full path. Toolhelp rather than
+// psapi: psapi would mean a new link library, and the selftest CMakeLists is one of this
+// atom's untouched files. Section D-K implementation contract (e) calls this twice - once
+// after warm-up and before the timer, once after the run - and the .ps1 asserts every path
+// sits under the staging directory it laid out.
+static bool xperf_module_snapshot(std::vector<std::string> & out) {
+    out.clear();
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE, GetCurrentProcessId());
+    if (snap == INVALID_HANDLE_VALUE) return false;
+    MODULEENTRY32W me; ZeroMemory(&me, sizeof(me)); me.dwSize = sizeof(me);
+    if (!Module32FirstW(snap, &me)) { CloseHandle(snap); return false; }
+    do {
+        const std::string p = wide_to_utf8(std::wstring(me.szExePath));
+        std::string base = p;
+        const size_t at = base.find_last_of("\\/");
+        if (at != std::string::npos) base = base.substr(at + 1);
+        for (size_t i = 0; i < base.size(); i++) {
+            if (base[i] >= 'A' && base[i] <= 'Z') base[i] = (char)(base[i] - 'A' + 'a');
+        }
+        if (base.compare(0, 4, "ggml") == 0 || base.compare(0, 5, "llama") == 0) out.push_back(p);
+        me.dwSize = sizeof(me);
+    } while (Module32NextW(snap, &me));
+    CloseHandle(snap);
+    std::sort(out.begin(), out.end());
+    return true;
+}
+
+// One PHASE's module reading, emitted under its own tag. Section D-K implementation contract
+// (e) asks for two readings - after warm-up and after the run - and they have to stay
+// separate: merging them would let a module that appeared late hide inside the union.
+// The list is taken twice and accepted only when two consecutive snapshots agree, because a
+// module table can be walked while a delay-load is still in flight. Failure is emitted as a
+// failure, never as an empty list: the .ps1 turns modfail != 0 or modn == 0 into a finding.
+static void xperf_print_modules(const char * tag) {
+    std::vector<std::string> a, b;
+    bool stable = false;
+    for (int attempt = 0; attempt < 5 && !stable; attempt++) {
+        if (!xperf_module_snapshot(a)) { printf("xperf_%s_modfail=1\n", tag); return; }
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        if (!xperf_module_snapshot(b)) { printf("xperf_%s_modfail=1\n", tag); return; }
+        stable = (a == b);
+    }
+    if (!stable) { printf("xperf_%s_modfail=2\n", tag); return; }
+    int cpuvar = 0;
+    for (size_t i = 0; i < b.size(); i++) {
+        std::string base = b[i];
+        const size_t at = base.find_last_of("\\/");
+        if (at != std::string::npos) base = base.substr(at + 1);
+        for (size_t j = 0; j < base.size(); j++) {
+            if (base[j] >= 'A' && base[j] <= 'Z') base[j] = (char)(base[j] - 'A' + 'a');
+        }
+        if (base.compare(0, 9, "ggml-cpu-") == 0) cpuvar++;
+        printf("xperf_%s_mod=%s\n", tag, b[i].c_str());
+    }
+    printf("xperf_%s_modfail=0 xperf_%s_modn=%d xperf_%s_cpuvar=%d\n",
+           tag, tag, (int) b.size(), tag, cpuvar);
+}
+
+static int run_xcpu_perf_child(const char * mode, const char * order) {
+    const bool is_prim   = (std::strcmp(mode, "prim")   == 0);
+    const bool is_opwall = (std::strcmp(mode, "opwall") == 0);
+    if (!is_prim && !is_opwall) {
+        fprintf(stderr, "xcpu-perf-child: unknown mode %s\n", mode);
+        return 77;
+    }
+    const bool new_first = (order != nullptr && std::strcmp(order, "ba") == 0);
+    init_scratch_root();
+    printf("xperf_mode=%s\nxperf_order=%s\nxperf_qpf=%lld\n",
+           mode, new_first ? "ba" : "ab", (long long) xperf_qpf());
+
+    XcpuStore st;
+    if (!xcpu_make_store(st, is_prim ? "xperf_prim" : "xperf_op", XPERF_NEXPERT, XPERF_NUSED,
+                         XPERF_K, XPERF_M, XPERF_NEMBD, 26082300u)) {
+        printf("xperf_ok=0 xperf_stage=90\n"); fflush(stdout); return 0;
+    }
+    XcpuBackend be; xcpu_open_backend(be, XPERF_THREADS);
+    if (!be.ok) { printf("xperf_ok=0 xperf_stage=91\n"); fflush(stdout); return 0; }
+
+    std::vector<int32_t> idv((size_t) XPERF_NUSED * XPERF_NTOKEN);
+    for (size_t i = 0; i < idv.size(); i++) idv[i] = (int32_t)(i % (size_t) XPERF_NEXPERT);
+    std::mt19937 rng(31337u); std::uniform_real_distribution<float> dd(-1.0f, 1.0f);
+    std::vector<float> mm_act((size_t)(XPERF_K * XPERF_NUSED * XPERF_NTOKEN));
+    std::vector<float> add_act((size_t)(XPERF_NEMBD * XPERF_NUSED * XPERF_NTOKEN));
+    for (size_t i = 0; i < mm_act.size(); i++)  mm_act[i]  = dd(rng);
+    for (size_t i = 0; i < add_act.size(); i++) add_act[i] = dd(rng);
+
+    XcpuPairGraph g;
+    if (!xcpu_build_pair_graph(g, be.backend, true, st, XPERF_K, XPERF_M, XPERF_NEMBD,
+                               XPERF_NTOKEN, XPERF_NUSED, idv, mm_act, add_act)) {
+        printf("xperf_ok=0 xperf_stage=92\n"); fflush(stdout); return 0;
+    }
+    if (xcpu_seal_store(st) != 0) {
+        printf("xperf_ok=0 xperf_stage=93\n"); fflush(stdout); return 0;
+    }
+    int32_t mlpos = -1, part = -1;
+    if (ggml_moe_adapter_resolve(g.w, &mlpos, &part) != 0) {
+        printf("xperf_ok=0 xperf_stage=94\n"); fflush(stdout); return 0;
+    }
+    const int64_t qpf = xperf_qpf();
+
+    if (is_prim) {
+        // Level 1. The same fixture, the same expert set, the same cache state; the ONLY
+        // difference between the two arms is which surface they go through.
+        std::vector<int32_t> all((size_t) XPERF_NEXPERT);
+        for (int e = 0; e < XPERF_NEXPERT; e++) all[(size_t) e] = e;
+        std::vector<int64_t> old_issue, old_view, old_rel, new_issue, new_view, new_rel;
+        old_issue.reserve(XPERF_PRIM_REPS); old_view.reserve(XPERF_PRIM_REPS);
+        old_rel.reserve(XPERF_PRIM_REPS);   new_issue.reserve(XPERF_PRIM_REPS);
+        new_view.reserve(XPERF_PRIM_REPS);  new_rel.reserve(XPERF_PRIM_REPS);
+        const int64_t scale = 1000000000LL;
+
+        // one repetition of the OLD surface: acquire, M pointer lookups, release
+        struct Timing { int64_t issue, view, rel; };
+        const int32_t vpi = XPERF_VIEWS_PER_ISSUE;
+        // the sink keeps the optimiser from deleting the lookups the arm exists to measure
+        volatile uint64_t sink = 0;
+
+        for (int32_t rep = 0; rep < XPERF_PRIM_WARM + XPERF_PRIM_REPS; rep++) {
+            Timing to_ = { 0, 0, 0 }, tn = { 0, 0, 0 };
+            for (int pass = 0; pass < 2; pass++) {
+                const bool run_new = (pass == 0) ? new_first : !new_first;
+                if (!run_new) {
+                    const int64_t a0 = xperf_qpc();
+                    const int rc = ggml_moe_direct_acquire(g.w, all.data(), XPERF_NEXPERT, 1);
+                    const int64_t a1 = xperf_qpc();
+                    if (rc != 0) { printf("xperf_ok=0 xperf_stage=95\n"); fflush(stdout); return 0; }
+                    const int64_t v0 = xperf_qpc();
+                    for (int32_t i = 0; i < vpi; i++) {
+                        const void * p = ggml_moe_direct_ptr(g.w, i % XPERF_NEXPERT);
+                        sink += (uint64_t)(uintptr_t) p;
+                    }
+                    const int64_t v1 = xperf_qpc();
+                    const int64_t r0 = xperf_qpc();
+                    ggml_moe_direct_release(g.w, all.data(), XPERF_NEXPERT);
+                    const int64_t r1 = xperf_qpc();
+                    to_.issue = a1 - a0; to_.view = v1 - v0; to_.rel = r1 - r0;
+                } else {
+                    const int64_t a0 = xperf_qpc();
+                    int32_t mp = -1, pt = -1;
+                    uint64_t tok = 0;
+                    const int rr = ggml_moe_adapter_resolve(g.w, &mp, &pt);
+                    const int rc = (rr == 0)
+                        ? ggml_moe_store_acquire(mp, pt, all.data(), XPERF_NEXPERT, 1, &tok)
+                        : -1;
+                    const int64_t a1 = xperf_qpc();
+                    if (rc != 0 || tok == 0) { printf("xperf_ok=0 xperf_stage=96\n"); fflush(stdout); return 0; }
+                    const int64_t v0 = xperf_qpc();
+                    for (int32_t i = 0; i < vpi; i++) {
+                        ggml_moe_buffer_view bv = { nullptr, 0 };
+                        (void) ggml_moe_store_view(tok, i % XPERF_NEXPERT, pt, &bv);
+                        sink += (uint64_t)(uintptr_t) bv.ptr + bv.bytes;
+                    }
+                    const int64_t v1 = xperf_qpc();
+                    const int64_t r0 = xperf_qpc();
+                    ggml_moe_store_release(tok);
+                    const int64_t r1 = xperf_qpc();
+                    tn.issue = a1 - a0; tn.view = v1 - v0; tn.rel = r1 - r0;
+                }
+            }
+            if (rep < XPERF_PRIM_WARM) continue;
+            old_issue.push_back(to_.issue * scale / qpf);
+            old_view.push_back(to_.view  * scale / qpf / (int64_t) vpi);
+            old_rel.push_back(to_.rel    * scale / qpf);
+            new_issue.push_back(tn.issue * scale / qpf);
+            new_view.push_back(tn.view   * scale / qpf / (int64_t) vpi);
+            new_rel.push_back(tn.rel     * scale / qpf);
+        }
+        printf("xperf_views_per_issue=%d\nxperf_reps=%d\nxperf_sink=%llu\n",
+               (int) vpi, (int) XPERF_PRIM_REPS, (unsigned long long) sink);
+        xperf_emit("xperf_old_issue_ns", old_issue);
+        xperf_emit("xperf_new_issue_ns", new_issue);
+        xperf_emit("xperf_old_view_ns",  old_view);
+        xperf_emit("xperf_new_view_ns",  new_view);
+        xperf_emit("xperf_old_rel_ns",   old_rel);
+        xperf_emit("xperf_new_rel_ns",   new_rel);
+        printf("xperf_ok=1 xperf_stage=10\n");
+        fflush(stdout);
+        return 0;
+    }
+
+    // Level 2 - the op wall of a real graph. This exe is byte-identical across the two
+    // staging directories the .ps1 lays out; only the DLL set beside it differs, which is
+    // why the attribution this measurement supports is "engine generation A/B" and not
+    // "the effect of the E-2b-1 source change" (section D-K, implementation contract (g)).
+    std::vector<int64_t> wall;
+    wall.reserve(XPERF_OP_REPS);
+    const int64_t scale = 1000000000LL;
+    for (int32_t rep = 0; rep < XPERF_OP_WARM; rep++) {
+        if (ggml_backend_graph_compute(be.backend, g.graph) != GGML_STATUS_SUCCESS) {
+            printf("xperf_ok=0 xperf_stage=97\n"); fflush(stdout); return 0;
+        }
+    }
+    xperf_print_modules("warm");                 // contract (e), reading 1 of 2
+    for (int32_t rep = 0; rep < XPERF_OP_REPS; rep++) {
+        const int64_t t0 = xperf_qpc();
+        const ggml_status s = ggml_backend_graph_compute(be.backend, g.graph);
+        const int64_t t1 = xperf_qpc();
+        if (s != GGML_STATUS_SUCCESS) {
+            printf("xperf_ok=0 xperf_stage=98\n"); fflush(stdout); return 0;
+        }
+        wall.push_back((t1 - t0) * scale / qpf);
+    }
+    xperf_print_modules("post");                 // contract (e), reading 2 of 2
+    printf("xperf_reps=%d\n", (int) XPERF_OP_REPS);
+    xperf_emit("xperf_op_wall_ns", wall);
+    printf("xperf_axes=%d\n", xcpu_axes_zero() ? 1 : 0);
+    printf("xperf_ok=1 xperf_stage=10\n");
+    fflush(stdout);
+    return 0;
+}
+
+// ===========================================================================
+// the group - exactly 14 check() calls, every one of them unconditional
+// ===========================================================================
+static void test_xcpu_e2b1() {
+    section("XCPU. E-2b-1 CPU consumer transition - adapter key, view, token release, the "
+            "shared lease slot, real multi-worker");
+
+    // ---- XCPU01: the key the transition hands to acquire ---------------------------------
+    {
+        Fixture fx;
+        const int rc = xstore_seal_basic(fx, "xcpu_adapter");
+        int pairs = 0, agree = 0;
+        for (int32_t lay = 0; lay < 2; lay++) {
+            ggml_tensor * p[3]; xstore_part_tensors(fx, lay, p);
+            for (int i = 0; i < 3; i++) {
+                if (!p[i]) continue;
+                pairs++;
+                int32_t mlpos = -1, apart = -1, rlay = -1, rpart = -1;
+                const int ar = ggml_moe_adapter_resolve(p[i], &mlpos, &apart);
+                const int rr = ggml_moe_direct_registered_layer_part(p[i], &rlay, &rpart);
+                // this fixture's moe_layers is {0, 1} ascending, so moe_layers[mlpos] == mlpos
+                if (ar == 0 && rr == 0 && apart == rpart && mlpos == rlay) agree++;
+            }
+        }
+        check(rc == 0 && pairs == 6 && agree == 6,
+              "XCPU01. the adapter map and the registry agree on the logical key for every "
+              "registered tensor (2 layers x 3 parts): adapter_resolve's part equals "
+              "registered_layer_part's part, and moe_layers[mlpos] is that layer. The "
+              "transition replaced acquire's INTERNAL resolution with this call, so this "
+              "equality is the acquire-key no-regression [pairs=" + std::to_string(pairs) +
+              " agree=" + std::to_string(agree) + " rc=" + std::to_string(rc) + "]");
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- XCPU02: view == the old ptr(), exhaustively --------------------------------------
+    {
+        Fixture fx;
+        const int rc = xstore_seal_basic(fx, "xcpu_view");
+        int cells = 0, same = 0;
+        for (int32_t lay = 0; lay < 2; lay++) {
+            ggml_tensor * p[3]; xstore_part_tensors(fx, lay, p);
+            int32_t ids[8]; for (int e = 0; e < 8; e++) ids[e] = e;
+            uint64_t tok = 0;
+            if (ggml_moe_store_acquire(lay, 0, ids, 8, 1, &tok) != 0 || tok == 0) continue;
+            for (int part = 0; part < 3; part++) {
+                if (!p[part]) continue;
+                for (int e = 0; e < 8; e++) {
+                    cells++;
+                    ggml_moe_buffer_view v = xstore_poisoned_view();
+                    const int vr = ggml_moe_store_view(tok, e, part, &v);
+                    const void * old = ggml_moe_direct_ptr(p[part], e);
+                    if (vr == 0 && old != nullptr && v.ptr == old) same++;
+                }
+            }
+            // Return this layer's token before asking for the next layer's. The fixture is
+            // deliberately at the capacity floor - xstore_seal_basic budgets exactly
+            // 8 * slot_stride_max, so n_slots == n_expert == 8 (ggml-moe-direct.cpp:10429)
+            // and one layer's eight records fill the pool. Holding both layers' tokens at
+            // once leaves the capacity preflight with zero unleased victims for the second
+            // layer's eight misses, so it refuses with no token (:4159-4168) and half the
+            // grid is never walked - which is what "cells=24 same=24" was reporting.
+            // Nothing is weakened by releasing here: this check is about the ADDRESS the two
+            // surfaces return, one layer at a time. Simultaneous multi-token possession is
+            // XCPU10's subject and it is a ONE-layer, two-part claim, which fits the pool.
+            ggml_moe_store_release(tok);
+        }
+        check(rc == 0 && cells == 48 && same == 48 && xcpu_axes_zero(),
+              "XCPU02. store_view lands byte for byte where ggml_moe_direct_ptr lands across "
+              "the whole 2 layers x 3 parts x 8 experts grid. The expected address is the OLD "
+              "surface's real return value, not a literal [cells=" + std::to_string(cells) +
+              " same=" + std::to_string(same) + " " + xcpu_axes_text() + "]");
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- XCPU03..XCPU07: byte counts, event binding, one-token return ---------------------
+    {
+        Fixture fx;
+        const int rc = xcpu_seal_shapes(fx, "xcpu_bytes");
+        ggml_tensor * tw = fx.find("blk.0.ffn_gate_exps.weight");
+        ggml_tensor * tb = fx.find("blk.0.ffn_gate_exps.bias");
+        int32_t wl = -1, wp = -1, bl = -1, bp = -1;
+        if (tw) ggml_moe_direct_registered_layer_part(tw, &wl, &wp);
+        if (tb) ggml_moe_direct_registered_layer_part(tb, &bl, &bp);
+        int32_t ids[8]; for (int e = 0; e < 8; e++) ids[e] = e;
+        uint64_t tok = 0;
+        const int arc = ggml_moe_store_acquire(0, 0, ids, 8, 1, &tok);
+
+        int w_cells = 0, w_ok = 0;
+        const uint64_t w_stride = tw ? (uint64_t) tw->nb[2] : 0;
+        for (int e = 0; tok != 0 && tw && e < 8; e++) {
+            ggml_moe_buffer_view v = xstore_poisoned_view();
+            w_cells++;
+            if (ggml_moe_store_view(tok, e, wp, &v) == 0 && v.bytes == w_stride) w_ok++;
+        }
+        check(rc == 0 && arc == 0 && tok != 0 && tw != nullptr && w_stride > 0
+              && w_cells == 8 && w_ok == 8,
+              "XCPU03. for the mul_mat_id form (3-D part) the view's byte count equals the "
+              "tensor stride nb[2] that the consumer computes for itself - ggml derived one "
+              "from the shape and the store derived the other from the manifest, so the two "
+              "sides of this comparison have different producers [nb2=" +
+              std::to_string((unsigned long long) w_stride) + " ok=" + std::to_string(w_ok) +
+              "/" + std::to_string(w_cells) + " part=" + std::to_string(wp) + "]");
+
+        int b_cells = 0, b_ok = 0;
+        const uint64_t b_stride = tb ? (uint64_t) tb->nb[1] : 0;
+        for (int e = 0; tok != 0 && tb && e < 8; e++) {
+            ggml_moe_buffer_view v = xstore_poisoned_view();
+            b_cells++;
+            if (ggml_moe_store_view(tok, e, bp, &v) == 0 && v.bytes == b_stride) b_ok++;
+        }
+        check(tb != nullptr && b_stride > 0 && b_cells == 8 && b_ok == 8 && bp != wp,
+              "XCPU04. for the add_id form (2-D part) it equals nb[1], and that part index is "
+              "a different one from XCPU03's - one seal carries both consumer stride forms "
+              "[nb1=" + std::to_string((unsigned long long) b_stride) + " ok=" +
+              std::to_string(b_ok) + "/" + std::to_string(b_cells) + " part=" +
+              std::to_string(bp) + " vs " + std::to_string(wp) + "]");
+
+        int diff_cells = 0, diff_ok = 0;
+        for (int e = 0; tok != 0 && tw && e < 8; e++) {
+            ggml_moe_buffer_view v = xstore_poisoned_view();
+            diff_cells++;
+            if (ggml_moe_store_view(tok, e, wp, &v) == 0
+                && v.bytes != w_stride + 1 && v.bytes != w_stride - 1) diff_ok++;
+        }
+        check(diff_cells == 8 && diff_ok == 8 && w_stride > 1,
+              "XCPU05. the same view's byte count differs from that stride +/- 1, so the "
+              "comparison XCPU03/04 make has discriminating power and is not x == x. Recorded "
+              "limit: this does NOT fire the production abort - an input that mismatches is "
+              "unreachable, which is why D8 refused an injection arm [ok=" +
+              std::to_string(diff_ok) + "/" + std::to_string(diff_cells) + "]");
+
+        uint64_t tok_sub = 0;
+        int32_t sub[3] = { 0, 3, 7 };
+        const int src2 = ggml_moe_store_acquire(0, 0, sub, 3, 1, &tok_sub);
+        int e_cells = 0, e_ok = 0, e_widened = 0;
+        for (int e = 0; tok_sub != 0 && tw && e < 8; e++) {
+            ggml_moe_buffer_view v = xstore_poisoned_view();
+            const bool viewed = (ggml_moe_store_view(tok_sub, e, wp, &v) == 0);
+            const void * old = ggml_moe_direct_ptr(tw, e);
+            const bool captured = (e == 0 || e == 3 || e == 7);
+            e_cells++;
+            if (old == nullptr) continue;            // residency is supplied by `tok` above
+            if (viewed == captured && (!viewed || v.ptr == old)
+                && (viewed || xstore_view_untouched(v))) {
+                e_ok++;
+                if (!captured) e_widened++;
+            }
+        }
+        if (tok_sub != 0) ggml_moe_store_release(tok_sub);
+        check(src2 == 0 && e_cells == 8 && e_ok == 8 && e_widened == 5,
+              "XCPU06. the view predicate is the old ptr() predicate widened by EXACTLY one "
+              "case - an expert the token did not capture. Where they agree the addresses "
+              "agree; where they differ it is only those 5, all of them resident; and a soft "
+              "refusal leaves the out struct completely untouched [ok=" +
+              std::to_string(e_ok) + "/" + std::to_string(e_cells) + " widened=" +
+              std::to_string(e_widened) + "]");
+
+        if (tok != 0) ggml_moe_store_release(tok);
+        int64_t h1 = -1, u1 = -1, s1 = -1, h2 = -1, u2 = -1, s2 = -1;
+        uint64_t tok_new = 0;
+        int32_t ids3[3] = { 1, 4, 6 };
+        const int an = ggml_moe_store_acquire(0, 0, ids3, 3, 1, &tok_new);
+        if (tok_new != 0) ggml_moe_store_release(tok_new);
+        ggml_moe_store_outstanding(&h1, &u1, &s1);
+        const int ao = tw ? ggml_moe_direct_acquire(tw, ids3, 3, 1) : -1;
+        if (ao == 0) ggml_moe_direct_release(tw, ids3, 3);
+        ggml_moe_store_outstanding(&h2, &u2, &s2);
+        check(an == 0 && ao == 0 && h1 == 0 && u1 == 0 && s1 == 0
+              && h2 == 0 && u2 == 0 && s2 == 0,
+              "XCPU07. returning the TOKEN once settles all three ledgers at zero, exactly "
+              "where the old path's malloc / re-walk / release settled them - the id "
+              "re-collection the transition deleted was doing no work the token does not do "
+              "[new=" + std::to_string(h1) + "/" + std::to_string(u1) + "/" +
+              std::to_string(s1) + " old=" + std::to_string(h2) + "/" + std::to_string(u2) +
+              "/" + std::to_string(s2) + "]");
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- XCPU08: the shared slot's ABI ----------------------------------------------------
+    {
+        struct xcpu_lease_ctx c;
+        c.token = 0; c.part = -1; c.reserved = 0;          // the per-op reset
+        c.part = 2; c.token = 0x1122334455667788ull;       // the publish order the kernel uses
+        const bool abi = sizeof(struct xcpu_lease_ctx) == 16
+                      && alignof(struct xcpu_lease_ctx) == 8
+                      && offsetof(struct xcpu_lease_ctx, token) == 0
+                      && offsetof(struct xcpu_lease_ctx, part) == 8
+                      && offsetof(struct xcpu_lease_ctx, reserved) == 12;
+        check(abi && c.reserved == 0 && c.part == 2,
+              "XCPU08. the shared lease slot has the layout the contract froze - 16 bytes, "
+              "8-byte alignment, token at 0, part at 8, reserved at 12 - and a publish leaves "
+              "reserved at 0, because this atom neither reads nor writes that field. The "
+              "expectation is the contract's own text; the measurement is offsetof [size=" +
+              std::to_string((unsigned long long) sizeof(struct xcpu_lease_ctx)) + " align=" +
+              std::to_string((unsigned long long) alignof(struct xcpu_lease_ctx)) + " off=" +
+              std::to_string((unsigned long long) offsetof(struct xcpu_lease_ctx, token)) + "/" +
+              std::to_string((unsigned long long) offsetof(struct xcpu_lease_ctx, part)) + "/" +
+              std::to_string((unsigned long long) offsetof(struct xcpu_lease_ctx, reserved)) +
+              " reserved=" + std::to_string(c.reserved) + "]");
+    }
+
+    // ---- XCPU09 / XCPU10: a real graph beside a live store --------------------------------
+    {
+        ggml_backend_load_all();
+        ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+        ggml_backend_ptr be(dev ? ggml_backend_dev_init(dev, nullptr) : nullptr);
+        bool built = false, eq_off = false, axes_off = false;
+        bool two_ok = false;
+        int32_t capA = -7, capB = -7, capA2 = -7, wp = -1, bp = -1;
+        int64_t traffic_rc = -1;
+        XcpuStore st;
+        if (be) {
+            ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+            ggml_backend_set_n_threads_t set_n = (ggml_backend_set_n_threads_t)
+                ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+            if (set_n) set_n(be.get(), 4);
+            std::vector<int32_t> idv((size_t) XCPU_S_NUSED * XCPU_G_NTOKEN);
+            for (size_t i = 0; i < idv.size(); i++) idv[i] = (int32_t)(i % XCPU_S_NEXPERT);
+            std::mt19937 rng(909u); std::uniform_real_distribution<float> dd(-1.0f, 1.0f);
+            std::vector<float> mm_act((size_t)(XCPU_S_K * XCPU_S_NUSED * XCPU_G_NTOKEN));
+            std::vector<float> add_act((size_t)(XCPU_S_NEMBD * XCPU_S_NUSED * XCPU_G_NTOKEN));
+            for (size_t i = 0; i < mm_act.size(); i++)  mm_act[i]  = dd(rng);
+            for (size_t i = 0; i < add_act.size(); i++) add_act[i] = dd(rng);
