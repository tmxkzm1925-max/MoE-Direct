+// ── P23. ★정지 신호 lost wakeup 회귀 — 활성 dispatcher 직후 stop_and_join 이 유한 시간에 완료 ──
+//    수리 전 코드에서는 `disp_peek`이 stop 의 SetEvent(1회)를 ResetEvent 로 소비해, 그 pass 가
+//    graceful 평가를 건너뛴 채 INFINITE 대기로 들어가 **전 스레드 idle 교착**이 됐다(실측 16%).
+//    창이 좁으므로 반복으로 잡는다 — 30회면 미검출 확률 0.84^30 ≈ 0.5%.
+static void test_pb_stop_wakeup() {
+    section("P23. ★정지 신호 보존 회귀 — acquire 직후 stop_and_join 이 유한 시간 내 완료(교착 0)");
+    const int kIter = 30;
+    int    hung = 0, ran = 0;
+    double worst_ms = 0.0;
+    for (int it = 0; it < kIter; it++) {
+        PbEnv env("4", nullptr, nullptr, "off", nullptr, nullptr);
+        Fixture * fx = new Fixture();
+        pb_setup_2layer(*fx, ("pb_stopwake_" + std::to_string(it)).c_str());
+        if (fx->seal((uint64_t)PB_TEST_N_EXPERT * fx->comp.slot_stride_max, 64) != 0) { delete fx; continue; }
+        ran++;
+        ggml_tensor * g0 = fx->find("blk.0.ffn_gate_exps.weight");
+        std::vector<int32_t> ids = {0,1,2};
+        ggml_moe_direct_acquire(g0, ids.data(), 3, 1);
+        ggml_moe_direct_release(g0, ids.data(), 3);
+        // ★acquire 직후 = 디스패처가 pass 안에 있을 확률이 최대인 순간에 정지 요청을 건다.
+        std::atomic<bool> done{false};
+        const auto t0 = std::chrono::steady_clock::now();
+        std::thread th([&]() { ggml_moe_direct_test_shutdown(/*abort=*/0); done.store(true, std::memory_order_release); });
+        for (int w = 0; w < 5000 && !done.load(std::memory_order_acquire); w++) Sleep(1);   // 5s 타임아웃
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        if (ms > worst_ms) worst_ms = ms;
+        if (!done.load(std::memory_order_acquire)) {
+            // ★교착 확정 — join/소멸(reset)도 함께 막히므로 스레드/Fixture 를 회수하지 않고 즉시 종결한다.
+            hung++;
+            th.detach();
+            break;
+        }
+        th.join();
+        delete fx;
+    }
+    check(hung == 0 && ran > 0,
+          "P23. ★★정지 신호 lost wakeup 없음 — " + std::to_string(ran) + "회 반복 전건 유한 완료(최장 " +
+          std::to_string((int)worst_ms) + " ms · 교착 " + std::to_string(hung) +
+          "회 · 수리 전에는 여기서 5s 타임아웃)");
+}
