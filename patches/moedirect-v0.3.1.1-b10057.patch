+    } else {
+        dfac_q_pause_set_locked(false);
+        SetEvent(g_mod.resume_event);
+        g_mod.q_pause_cv.wait(lk, [] { return !g_mod.q_paused || g_mod.q_stopping; });
+    }
+}
