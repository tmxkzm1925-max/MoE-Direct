+
+        // 결정론적 스트림: A 5행(A1 3 + A2 2) · B 6행(mlpos 0 프레임 3 + mlpos 1 프레임 3).
+        const char * a_names[3] = { "ffn_moe_topk-0", "ffn_moe_topk-1", "blk.0.attn_norm.weight" };
+        for (int i = 0; i < 3; i++) {
+            ggml_moe_leadtime_stamp_a(GGML_MOE_LEADTIME_SITE_A1, 1000 + (uint64_t)i, a_names[i]);
+        }
+        for (int i = 0; i < 2; i++) {
+            ggml_moe_leadtime_stamp_a(GGML_MOE_LEADTIME_SITE_A2, 2000 + (uint64_t)i, "ffn_moe_topk-7");
+        }
+        for (int i = 0; i < 6; i++) {
+            ggml_moe_leadtime_stamp_b(3000 + (uint64_t)i, i / 3, i % 3, 4 + i, (i < 3) ? 1 : 0);
+        }
+
+        uint64_t na = 0, nb = 0, nd = 9, ca = 0, cb = 0; int32_t comp = -1;
+        ggml_moe_leadtime_test_counts(&na, &nb, &nd, &comp, &ca, &cb);
+        check(na == 5 && nb == 6 && nd == 0 && comp == 1,
+              "P46d1. flush 전 상태 — A 5행 · B 6행 · drop 0 · complete=1");
+
+        ggml_moe_leadtime_flush();
+
+        const LtFile fa = lt_read(pa);
+        const LtFile fb = lt_read(pb);
+        check(fa.ok, "P46d2. `_lead_a.lt` 생성 + magic·크기등식·payload digest 통과" +
+                     (fa.ok ? std::string() : (" [" + fa.why + "]")));
+        check(fb.ok, "P46d3. `_lead_b.lt` 생성 + magic·크기등식·payload digest 통과" +
+                     (fb.ok ? std::string() : (" [" + fb.why + "]")));
+        check(fa.h.file_kind == GGML_MOE_LEADTIME_KIND_A && fa.h.record_bytes == GGML_MOE_LEADTIME_A_BYTES &&
+              fa.h.layout_version == 1 && fa.h.record_count == 5,
+              "P46d4. ★kind=1 · record_bytes=64 · layout=1 · 5행");
+        check(fb.h.file_kind == GGML_MOE_LEADTIME_KIND_B && fb.h.record_bytes == GGML_MOE_LEADTIME_B_BYTES &&
+              fb.h.layout_version == 1 && fb.h.record_count == 6,
+              "P46d5. ★kind=2 · record_bytes=32 · layout=1 · 6행");
+        check(fa.h.complete == 1 && fb.h.complete == 1 &&
+              fa.h.dropped_records == 0 && fb.h.dropped_records == 0,
+              "P46d6. ★사양 §4b lead 무결 게이트의 입력 — complete=1 ∧ dropped=0");
+        check(fa.h.boot_id == join && fa.h.boot_id == fb.h.boot_id &&
+              fa.h.boot_id == ggml_moe_leadtime_boot_id(),
+              "P46d7. ★조인 키 — 두 파일과 모듈 조회값이 동일(IO3 헤더 boot_id 와 대조될 값)");
+        check(fa.h.qpc_frequency != 0 && fa.h.qpc_frequency == fb.h.qpc_frequency &&
+              fa.h.t0_qpc != 0 && fa.h.t0_qpc == fb.h.t0_qpc &&
+              fa.h.pid == (uint32_t) GetCurrentProcessId(),
+              "P46d8. ★QPC 도메인 — 두 축이 같은 frequency·t0·pid(단일 시계 계약)");
+        check(fa.h.record_capacity == ca && fb.h.record_capacity == cb,
+              "P46d9. 헤드룸 감사 칸 — 헤더 record_capacity 가 선할당 칸 수와 일치");
+        check(fa.h.engine_mode == 2 && fa.h.n_expert == 128 && fa.h.n_moe_layers == 48,
+              "P46d10. seal echo — engine_mode/n_expert/n_moe_layers");
+
+        // ★버퍼 → 파일 바이트 동일성(직렬화가 레코드를 손대지 않는다).
+        bool same = fa.ok && fb.ok &&
+                    fa.payload.size() == 5 * sizeof(LtAMirror) &&
+                    fb.payload.size() == 6 * sizeof(LtBMirror);
+        if (same) {
+            for (uint64_t i = 0; i < 5 && same; i++) {
+                LtAMirror x{}, y{};
+                if (ggml_moe_leadtime_test_a_bytes(i, &x, sizeof(x)) != 0) { same = false; break; }
+                std::memcpy(&y, fa.payload.data() + i * sizeof(y), sizeof(y));
+                if (std::memcmp(&x, &y, sizeof(x)) != 0) same = false;
+            }
+            for (uint64_t i = 0; i < 6 && same; i++) {
+                LtBMirror x{}, y{};
+                if (ggml_moe_leadtime_test_b_bytes(i, &x, sizeof(x)) != 0) { same = false; break; }
+                std::memcpy(&y, fb.payload.data() + i * sizeof(y), sizeof(y));
+                if (std::memcmp(&x, &y, sizeof(x)) != 0) same = false;
+            }
+        }
+        check(same, "P46d11. ★버퍼 → 파일 바이트 동일 — A 5행 + B 6행 전건 memcmp");
+
+        // 내용 계약 — site·seq·이름 정확 복사·B 필드.
+        if (fa.payload.size() == 5 * sizeof(LtAMirror)) {
+            LtAMirror r0{}, r2{}, r4{};
+            std::memcpy(&r0, fa.payload.data() + 0 * sizeof(LtAMirror), sizeof(r0));
+            std::memcpy(&r2, fa.payload.data() + 2 * sizeof(LtAMirror), sizeof(r2));
+            std::memcpy(&r4, fa.payload.data() + 4 * sizeof(LtAMirror), sizeof(r4));
+            check(r0.seq == 0 && r2.seq == 2 && r4.seq == 4 &&
+                  r0.site == GGML_MOE_LEADTIME_SITE_A1 && r4.site == GGML_MOE_LEADTIME_SITE_A2 &&
+                  r0.qpc == 1000 && r4.qpc == 2001,
+                  "P46d12. ★A 행 내용 — seq 예약 순번 · site A1/A2 분리 · qpc 호출값 그대로");
+            check((size_t) r0.name_len == std::strlen(a_names[0]) && r0.flags == 0 &&
+                  std::strncmp(r0.name, a_names[0], sizeof(r0.name)) == 0 &&
+                  (size_t) r2.name_len == std::strlen(a_names[2]) &&
+                  std::strncmp(r2.name, a_names[2], sizeof(r2.name)) == 0,
+                  "P46d13. ★tensor_name 정확 복사 — 대상(`ffn_moe_topk-0`)과 **비대상**"
+                  "(`blk.0.attn_norm.weight`) 둘 다 그대로 실린다(엔진은 이름을 필터하지 않는다)");
+        } else {
+            check(false, "P46d12/13. A payload 크기가 5x64 가 아니다");
+        }
+        if (fb.payload.size() == 6 * sizeof(LtBMirror)) {
+            LtBMirror r0{}, r5{};
+            std::memcpy(&r0, fb.payload.data() + 0 * sizeof(LtBMirror), sizeof(r0));
+            std::memcpy(&r5, fb.payload.data() + 5 * sizeof(LtBMirror), sizeof(r5));
+            check(r0.seq == 0 && r0.mlpos == 0 && r0.part_idx == 0 && r0.n_ids == 4 &&
+                  r0.qpc == 3000 && (r0.flags & GGML_MOE_LEADTIME_B_FLAG_PREFILL) != 0 &&
+                  r5.seq == 5 && r5.mlpos == 1 && r5.part_idx == 2 && r5.n_ids == 9 &&
+                  r5.qpc == 3005 && (r5.flags & GGML_MOE_LEADTIME_B_FLAG_PREFILL) == 0,
+                  "P46d14. ★B 행 내용 — (seq, qpc, mlpos, part_idx, n_ids) 전건 + prefill 플래그 · "
+                  "같은 mlpos 연속 3행이 판독기의 완전집합 프레임이 된다");
+            check(r0.reserved0 == 0 && r0.reserved1 == 0 && r0.reserved2 == 0,
+                  "P46d15. reserved 칸은 0(판독기가 미래 필드를 0 으로 볼 수 있다)");
+        } else {
+            check(false, "P46d14/15. B payload 크기가 6x32 가 아니다");
+        }
+
+        // ★음성 대조(wire) — payload 1바이트를 바꾸면 digest 검사가 실제로 FAIL 해야 한다.
+        {
+            bool detected = false;
+            if (fa.ok && !fa.payload.empty()) {
+                std::vector<uint8_t> bad = fa.payload;
+                bad[0] ^= 0x01;
+                detected = (sh_fnv1a64(bad.data(), bad.size()) != fa.h.payload_digest);
