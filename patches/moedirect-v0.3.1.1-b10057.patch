+// ★A6 wire — 합쳐진 런의 IO3 3채널을 되읽어 §5-6 을 판정한다. R18 의 `io3_verify` 를 **그대로**
+//   쓴다(관문을 새로 만들지 않는다 — 그 관문의 coalesce 항이 지금까지 늘 0 이었을 뿐이다).
+static void test_v3_coalesce_wire() {
+    section("V3j. mode=virtual A6 — coalescing 의 IO3 wire 축(§5-4 `coalesce_group`·§5-5 copies 의무)");
+
+    std::wstring dir = make_case_dir("v3_a6_io3");
+    std::wstring pfx = dir + L"\\io3";
+    Io3Arm arm;
+    {
+        V3CoalEnv env("prefill", "0", "67108864", "16");
+        EnvGuard e1("MOE_DIRECT_IO3", "on"), e2("MOE_DIRECT_IO3_OUT", wide_to_utf8(pfx).c_str());
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a6_io3_fx", /*n_shards=*/1, "8");
+        if (!check(lv.ok, "V3j1a. IO3 on + coalescing 픽스처 seal [" + lv.why + "]")) {
+            ggml_moe_direct_reset_for_test(); return;
+        }
+        ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+        int32_t ids[4] = { 2, 3, 4, 5 };
+        ggml_moe_direct_acquire(gate0, ids, 4, /*n_tokens_hint=*/4);
+        ggml_moe_direct_release(gate0, ids, 4);
+        ggml_moe_direct_finalize();
+        ggml_moe_direct_reset_for_test();
+    }
+    std::string why;
+    if (!check(arm.load(pfx, why), "V3j1. IO3 3파일 생성·헤더/크기/payload digest 정합 [" + why + "]")) return;
+
+    // record 4 · children 2(part 당 대구간 1) · copies 8(참가 record 4 × part 2)
+    check(arm.recs.size() == 4 && arm.kids.size() == 2 && arm.cps.size() == 8,
+          "V3j2. ★채널 3분리 — records " + std::to_string(arm.recs.size()) + " · children " +
+          std::to_string(arm.kids.size()) + "(**대구간 2건** = part 당 1) · copies " +
+          std::to_string(arm.cps.size()) + "(참가 record 마다 1행 = 4×2) — 바운스의 'child 당 1행'과 "
+          "갈리는 바로 그 지점(§5-5)");
+
+    const std::string v = io3_verify(arm);
+    check(v.empty(),
+          "V3j3. ★★§5-6 완전성이 **coalesce 열에서 실제로 선다** — cardinality 전식(단독 children + "
+          "coalesce copies) · 대구간 의무(참가 record 마다 1행·expert 연속열) · `src_kind`↔child "
+          "flags · `coalesce_group` 일치 · record_seq/generation NA 규약 · QD 재생 · cap 6항 [" +
+          (v.empty() ? "OK" : v) + "]");
+
+    bool coal_ok = arm.kids.size() == 2, group_distinct = true;
+    uint32_t g0 = 0xFFFFFFFFu;
+    for (const auto & k : arm.kids) {
+        if (!(k.flags & 0x10)) coal_ok = false;                  // b4 = coalesced
+        if (k.record_seq != ~(uint64_t)0) coal_ok = false;
+        if (k.generation != ~(uint64_t)0) coal_ok = false;
+        if (k.coalesce_group == 0xFFFFFFFFu) coal_ok = false;
+        if (k.expert != 2) coal_ok = false;                      // run 시작 expert
+        if (g0 == 0xFFFFFFFFu) g0 = k.coalesce_group;
+        else if (k.coalesce_group == g0) group_distinct = false;  // part 마다 다른 대구간이다
+    }
+    check(coal_ok && group_distinct,
+          "V3j4. ★§5-4 coalesced children — flags b4=1 · `record_seq`=NA · `generation`=NA · "
+          "`coalesce_group` 실값(part 마다 서로 다름) · `expert`=run 시작(2)");
+
+    bool cp_ok = arm.cps.size() == 8;
+    for (const auto & c : arm.cps) {
+        if (!(c.flags & 0x02)) cp_ok = false;                    // b1 = src_kind coalesce staging
+        if (c.coalesce_group == 0xFFFFFFFFu) cp_ok = false;
+        if (c.record_seq == ~(uint64_t)0) cp_ok = false;
+        if (c.status != 1) cp_ok = false;
+    }
+    check(cp_ok,
+          "V3j5. ★§5-5 copies — 전 8행이 `src_kind=1(coalesce staging)` · `coalesce_group` 실값 · "
+          "실 `record_seq`(귀속 권위) · status=OK");
+
+    bool nchild_ok = !arm.recs.empty();
+    for (const auto & r : arm.recs) if (r.n_children != 2) nchild_ok = false;
+    check(nchild_ok,
+          "V3j6. ★§5-6 cardinality — 합쳐진 record 의 `n_children` 이 **coalesce copies 항으로** 2가 "
+          "된다(단독 children 은 0건인데도 그 record 의 물리 read 몫은 2 part 다)");
+}
