+uint64_t pb_qpc_to_us(uint64_t ticks) {
+    static uint64_t freq = 0;
+    if (freq == 0) { LARGE_INTEGER f{}; QueryPerformanceFrequency(&f); freq = (uint64_t)f.QuadPart; }
+    return freq ? (ticks * 1000000ull / freq) : 0;
+}
