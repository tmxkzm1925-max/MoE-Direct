+//   ① 핀 env `MOE_SELFTEST_PYTHON` 최우선(작업 규약 §2-6 의 인터프리터 고정과 결속)
+//   ② py.exe -3 → python.exe → python3.exe
+static void sh_resolve_interp(const std::wstring & log_path) {
+    if (g_py_env_state != 0) return;
+    std::vector<std::pair<std::wstring, std::string>> cands;
