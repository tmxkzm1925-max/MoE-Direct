+    // This arm and the argsort arm are mutually exclusive by construction: when fusion fires it
+    // consumes the ARGSORT node, so that layer never reaches the argsort dispatch in the same pass.
+    ggml_cuda_gpuearly_router_anchor(ctx, ids, GGML_MOE_GPUEARLY_ROUTER_FUSED);
 }
 
