+// ── observe 공용 관측 구조 ─────────────────────────────────────────────────
+struct PbObsCtr {
+    uint64_t v[GGML_MOE_PB_O_COUNT] = {0};
+    uint64_t g(int i) const { return v[i]; }
+};
+static PbObsCtr pb_obs_ctr() {
+    PbObsCtr c;
+    for (int i = 0; i < GGML_MOE_PB_O_COUNT; i++) c.v[i] = ggml_moe_phaseb_observe_counter(i);
+    return c;
+}
+// closure **5등식**(FROZEN_PB_OBSV_V2 §5.2) — 판독기와 **같은 식**을 엔진 측 카운터로 독립 검사한다.
+//   V1 대비 개정은 상위 2등식뿐이고(`+ no_output`), 하위 2등식은 **바이트 그대로 보존**된다
+//   (= 최소 델타의 증거). `no_output` 은 expected/recorded 에만 들고 eligible/captured/Σinvalid_*
+//   에는 들지 않는다.
+static bool pb_obs_closure(const PbObsCtr & c) {
+    const uint64_t inv = c.g(GGML_MOE_PB_O_INVALID_NORM_ZERO) + c.g(GGML_MOE_PB_O_INVALID_NONFINITE) +
+                         c.g(GGML_MOE_PB_O_INVALID_OVERFLOW);
+    return c.g(GGML_MOE_PB_O_EXPECTED) == c.g(GGML_MOE_PB_O_RECORDED) &&
+           c.g(GGML_MOE_PB_O_EXPECTED) == c.g(GGML_MOE_PB_O_VALID) + inv +
+                                          c.g(GGML_MOE_PB_O_NOT_ELIGIBLE) + c.g(GGML_MOE_PB_O_CAPTURE_MISS) +
+                                          c.g(GGML_MOE_PB_O_NO_OUTPUT) &&
+           c.g(GGML_MOE_PB_O_EXPECTED) == c.g(GGML_MOE_PB_O_ELIGIBLE) + c.g(GGML_MOE_PB_O_NOT_ELIGIBLE) +
+                                          c.g(GGML_MOE_PB_O_NO_OUTPUT) &&
+           c.g(GGML_MOE_PB_O_ELIGIBLE) == c.g(GGML_MOE_PB_O_CAPTURED) + c.g(GGML_MOE_PB_O_CAPTURE_MISS) &&
+           c.g(GGML_MOE_PB_O_CAPTURED) == c.g(GGML_MOE_PB_O_VALID) + inv;
+}
+static json pb_read_metrics_line(const std::wstring & path, const char * type) {
+    std::ifstream ifs(path, std::ios::binary);
+    std::string line; json last = json::object();
+    while (std::getline(ifs, line)) {
+        while (!line.empty() && (line.back()=='\r'||line.back()=='\n')) line.pop_back();
+        if (line.empty()) continue;
+        json j = json::parse(line, nullptr, false);
+        if (j.is_object() && j.value("type","") == type) last = j;
+    }
+    return last;
+}
