+    if (ov && ov[0]) return utf8_to_wide(ov);
+    return L"C:\\Users\\tmxkz\\Claude\\Projects\\moe-expert-stream\\bench\\techdev\\decode_hunt"
+           L"\\shadow_reader.py";
+}
