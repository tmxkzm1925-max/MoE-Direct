+    section("V3c. mode=virtual 소비자 — 네거티브(§6-4 ⑦⑧⑨ + IO_METRICS §3)");
+
+    // ================= §2-1 모드·스키마 게이트(stage 0 = v3 본문 미진입) =================
+    v3_neg_manifest("v3_n_mode_missing", 0, "V3c1. schema 3.0 인데 mode 필드 누락 = 기동 중단",
+                    [](json & m) { m.erase("mode"); });
