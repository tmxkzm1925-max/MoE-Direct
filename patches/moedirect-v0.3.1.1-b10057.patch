+// ★r1 차단 7 수리 — production emitter → **production reader** 왕복 창구.
+//   실 emitter 가 낸 사이드카를 하네스가 스스로 파싱하는 것(sh_read)으로 끝내지 않고,
+//   게이트 판정에 실제로 쓰일 판독기 `bench/techdev/decode_hunt/shadow_reader.py` 를
+//   자식 프로세스로 돌려 **exit code + 출력**으로 판정한다(0=통과 · 3=fail-close).
+// ===========================================================================
+
+struct ShProc {
+    bool        launched = false;   // CreateProcessW 성공 여부(인터프리터 탐색 실패와 구분)
+    uint32_t    code     = 0xFFFFFFFFu;
+    std::string out;                // stdout+stderr 합본(UTF-8)
+};
+
+// 판독기 스크립트 경로 — 운영자가 트리를 옮겼으면 MOE_SHADOW_READER_PY 로 덮어쓴다.
