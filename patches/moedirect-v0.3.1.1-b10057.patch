+static void test_v3_wave() {
+    section("V3W. ★★R-1 wave/부분 제출 상태기계(FROZEN §2-0 A0-2 — 교차 r1 F2)");
+    auto wave_hex = [](uint64_t v) {
+        char b[32]; snprintf(b, sizeof(b), "0x%016llx", (unsigned long long)v); return std::string(b);
+    };
+
+    struct WaveArm { bool ok = false; uint64_t waves = 0, children = 0, terms = 0, pubs = 0;
+                     uint64_t rf_ops = 0, rf_digest = 0;
+                     int32_t iop = 0; std::string why; };
+    // `iop` 만 바꿔 같은 demand 를 친다. 픽스처는 층당 part 2개(P=2)다.
+    auto arm = [&](const char * tag, const char * iop_env) {
+        WaveArm a;
+        EnvGuard p("MOE_DIRECT_IO_PART_PARALLELISM", iop_env);
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, tag, /*n_shards=*/1, "8");
+        if (!lv.ok) { a.why = lv.why; return a; }
+        ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+        if (!g0) { a.why = "tensor lookup"; return a; }
+        int32_t ids[2] = { 3, 5 };                    // record 2건 × P=2 ⇒ child 4건
+        const int rc = ggml_moe_direct_acquire(g0, ids, 2, 1);
+        if (rc != 0) { a.why = "acquire rc=" + std::to_string(rc); return a; }
+        ggml_moe_direct_test_v3_wave_stats(&a.waves, &a.iop);
+        ggml_moe_direct_test_v3_child_stats(&a.children, nullptr, &a.terms, &a.pubs);
+        ggml_moe_direct_test_v3_io_stats(nullptr, nullptr, nullptr, nullptr,
+                                        &a.rf_ops, &a.rf_digest, nullptr);
+        a.ok = true;
+        return a;
+    };
+
+    // ⓐ W = min(P=2, iop=3) = 2 ⇒ record 당 **1 wave**(구 판과 같은 형상).
+    const WaveArm wide = arm("v3w_wide", "3");
+    ggml_moe_direct_reset_for_test();
+    // ⓑ W = min(P=2, iop=1) = 1 ⇒ record 당 **2 wave**(부분 제출 = 정상 상태).
+    const WaveArm narrow = arm("v3w_narrow", "1");
+    ggml_moe_direct_reset_for_test();
+
+    if (!check(wide.ok && narrow.ok,
+               "V3W1. 두 arm seal·acquire 성립(wide=" + wide.why + " narrow=" + narrow.why + ")")) return;
+
+    check(wide.iop == 3 && narrow.iop == 1,
+          "V3W2. `io_part_parallelism` 이 **명시값 그대로 해소**된다 — 구 판은 팬아웃 하한이 1을 "
+          "2로 끌어올려 wave 폭을 P 로 고정했다(교차 r1 F2 의 직접 원인) [wide=" +
+          std::to_string(wide.iop) + " narrow=" + std::to_string(narrow.iop) + "]");
+
+    // ★핵심 판별: child 총수는 **같고** wave 수만 갈린다.
+    check(wide.children == narrow.children && wide.children == 4,
+          "V3W3. 두 arm 의 **child 총수 동일**(각 4 = record 2 × part 2) — 이 축만 보면 wave 기계가 "
+          "돌았는지 알 수 없다는 사실 자체를 관문에 박는다 [wide=" +
+          std::to_string((unsigned long long)wide.children) + " narrow=" +
+          std::to_string((unsigned long long)narrow.children) + "]");
+
+    check(wide.waves == 2 && narrow.waves == 4,
+          "V3W4. ★★wave 수가 `ceil(P/W) × records` 로 갈린다 — wide(W=2)=2 wave · narrow(W=1)="
+          "**4 wave**. 즉 narrow arm 의 record 는 **part 를 두 번에 나눠 제출**했다(FROZEN A0-2 "
+          "부분 제출 = 정상 상태). 구 판에서는 narrow arm 이 seal 단계에서 거부돼 이 사건 자체가 "
+          "생성되지 않았다 [wide=" + std::to_string((unsigned long long)wide.waves) + " narrow=" +
+          std::to_string((unsigned long long)narrow.waves) + "]");
+
+    check(wide.terms == narrow.terms && wide.terms == 2 &&
+          wide.pubs == narrow.pubs && wide.pubs == 2,
+          "V3W5. **부분 제출이 결과를 바꾸지 않는다** — 두 arm 모두 op terminal 2·publish 2. "
+          "다중 wave record 는 **마지막 wave 까지 회수된 뒤에만** publish 로 간다(첫 wave 회수만으로 "
+          "publish 가 서면 부분 데이터가 완성본으로 나간다) [terms " +
+          std::to_string((unsigned long long)wide.terms) + "/" +
+          std::to_string((unsigned long long)narrow.terms) + " pubs " +
+          std::to_string((unsigned long long)wide.pubs) + "/" +
+          std::to_string((unsigned long long)narrow.pubs) + "]");
+
+    // ★★§4 mode-local ordered ReadFile digest — **주장을 실측이 정정했다**.
+    //   초안은 "wave 로 쪠개도 제출 열이 all-at-once 와 같다"로 적었고, 그걸 게이트로
+    //   세우자 **거짓임이 드러났다**(W=2 vs W=1 digest 불일치 — 이 관문의 1차 실측).
+    //   실제 제출 열: W=2 → A0 A1 B0 B1 / W=1 → A0 **B0** A1 B1. 한 pass 에서 각
+    //   record 가 자기 wave 1 을 먼저 내기 때문이다(A 의 wave 2 는 자기 part cap 에
+    //   막히고, B 의 wave 1 은 안 막힌다).
+    //   ★그래서 계약은 "형상 간 불변"이 아니라 **형상 내 결정론**이다(§4 "같은 모드
+    //     결정론 검증 전용" · 동일 구성의 패어드 런끼리 비교가 그 소비처다).
+    //     `io_part_parallelism` 이 달라지면 다른 구성이므로 digest 가 갈리는 것은
+    //     정상이다. 아래는 그 **진짜 계약**을 친다.
+    //   ★★demand 가 part cap 에 막힐 때 `break`(skip 아님)인 것이 바로 이 결정론의
+    //     근거다 — skip 이면 어느 record 의 wave 가 먼저 회수됐느냐(=I/O 타이밍)가
+    //     제출 열을 정해 같은 구성에서도 런마다 달라진다.
+    const WaveArm narrow2 = arm("v3w_narrow2", "1");
+    ggml_moe_direct_reset_for_test();
+    check(narrow2.ok && narrow2.waves == narrow.waves && narrow2.rf_ops == narrow.rf_ops &&
+          narrow2.rf_digest == narrow.rf_digest,
+          "V3W6. ★★**형상 내 결정론** — 다중 wave 구성(W=1)을 2회 돌려 wave 수·ops·"
+          "**ordered ReadFile digest 가 전건 동일**(" + wave_hex(narrow.rf_digest) + " ×2 · waves " +
+          std::to_string((unsigned long long)narrow.waves) + "/" +
+          std::to_string((unsigned long long)narrow2.waves) + "). demand 는 part cap 에 막히면 "
+          "**건너뛰지 않고 멈춘다** — 건너뛰면 회수 타이밍이 제출 열을 정해 같은 "
+          "구성에서도 digest 가 흔린다");
+    check(wide.rf_digest != narrow.rf_digest && wide.rf_ops == narrow.rf_ops,
+          "V3W7. ★반대로 **형상이 달라지면 digest 는 갈린다** — W=2(" +
+          wave_hex(wide.rf_digest) + ") ≠ W=1(" + wave_hex(narrow.rf_digest) + ") · ops 는 같다(" +
+          std::to_string((unsigned long long)wide.rf_ops) + "). 제출 **열**이 A0 A1 B0 B1 → "
+          "A0 B0 A1 B1 로 바뀌기 때문이고, §4 digest 는 mode-local·동일 형상 전용이라 "
+          "정상이다(교차 비교의 전제가 ‘같은 구성’ 임을 이 관문이 박아 둔다)");
+}
