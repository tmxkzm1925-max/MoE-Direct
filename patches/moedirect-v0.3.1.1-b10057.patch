+// 사이드카 파일 1개를 읽어 128B 공통 헤더를 검증한다(pa_read 관례와 동형).
+struct ShFile {
+    bool     ok = false;
+    std::string why;
+    uint32_t file_kind = 0, record_bytes = 0, layout = 0, complete = 0;
+    uint64_t record_count = 0, payload_digest = 0, boot_id = 0;
+    std::vector<uint8_t> payload;
+};
+
+static uint64_t sh_fnv1a64(const void * data, size_t n) {
+    uint64_t h = 0xcbf29ce484222325ull;
+    const uint8_t * p = (const uint8_t *) data;
+    for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 0x100000001b3ull; }
+    return h;
+}
+
+static ShFile sh_read(const std::wstring & path) {
+    ShFile f;
+    std::ifstream in(path, std::ios::binary);
+    if (!in) { f.why = "open failed"; return f; }
+    std::vector<uint8_t> blob((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    if (blob.size() < 128) { f.why = "shorter than header"; return f; }
+    if (std::memcmp(blob.data(), "MOEPA1\0\0", 8) != 0) { f.why = "magic"; return f; }
+    std::memcpy(&f.layout,         blob.data() +  8, 4);
+    std::memcpy(&f.file_kind,      blob.data() + 12, 4);
+    std::memcpy(&f.record_bytes,   blob.data() + 16, 4);
+    std::memcpy(&f.record_count,   blob.data() + 24, 8);
+    std::memcpy(&f.payload_digest, blob.data() + 32, 8);
+    std::memcpy(&f.complete,       blob.data() + 60, 4);
+    std::memcpy(&f.boot_id,        blob.data() + 80, 8);
+    if (blob.size() != 128 + f.record_count * f.record_bytes) { f.why = "size equation"; return f; }
+    f.payload.assign(blob.begin() + 128, blob.end());
+    if (sh_fnv1a64(f.payload.data(), f.payload.size()) != f.payload_digest) { f.why = "payload digest"; return f; }
+    f.ok = true;
+    return f;
+}
