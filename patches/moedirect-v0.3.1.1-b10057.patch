+        // surface and never give it back. The inventory must still be non-empty while the
+        // token list is empty - exactly the case r3 named when it replaced "token list" with
+        // "lease inventory".
+        ggml_moe_store_release(tok);
+        if (ggml_moe_direct_acquire(g0, ids, 2, 1) != 0) {
+            fprintf(stderr, "xstore-fatal-child(drain): legacy acquire failed\n"); return 77;
+        }
+        if (ggml_moe_store_drain_begin() != 0) {
+            fprintf(stderr, "xstore-fatal-child(drain): drain_begin refused\n"); return 77;
+        }
+        // Burn a measurable slice of the ONE deadline BETWEEN begin and finish. If the
+        // budget were re-armed at drain_finish, or replaced by the 30 s default, the
+        // remaining time printed here would still be the whole caller value. The parent
+        // reads this line: it is the evidence that the deadline is anchored at begin.
+        Sleep(400);
+        const int32_t rem = ggml_moe_direct_test_xstore_drain_remaining(1500);
+        int64_t adm = -1, units = -1;
+        (void)ggml_moe_direct_test_xstore_drain_zero_ready(&adm, &units);
+        fprintf(stderr, "xstore-drain-child: budget caller=1500 remaining=%d units=%lld "
+                        "admissions=%lld\n", (int)rem, (long long)units, (long long)adm);
+        fflush(stderr);
+        ggml_moe_store_drain_finish(1500);    // <- the fatal, once the remainder runs out
+        fprintf(stderr, "xstore-fatal-child(drain): no fatal - the drain accepted a residue\n");
+        return 0;
