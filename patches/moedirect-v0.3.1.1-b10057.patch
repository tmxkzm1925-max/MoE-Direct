+static bool sh_probe_interp(const std::wstring & itp, const std::wstring & log_path, std::string & why) {
+    const std::wstring cl = itp + L"-c \"print('" + utf8_to_wide(kPyProbeMarker) + L"')\"";
+    const ShProc p = sh_exec(cl, log_path);
