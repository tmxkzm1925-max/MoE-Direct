+    bool    router_shape_bad  = false;
+    bool    router_noncontig  = false;
+    bool    router_unalloc    = false;
+    bool    norm_bf16         = false;  // ⑥ 격리 음성 — DSV4 의 norm 을 BF16 으로(거부 기대)
+    bool    bias_bf16         = false;  // ⑥ 격리 음성 — DSV4 의 exp_probs_b 를 BF16 으로(거부 기대)
+    // ⑦ 버퍼 팔 — 0=버퍼 미부착(기존 픽스처 그대로·host 직독) · 1=host 스텁 · 2=비-host 스텁.
+    //   스냅샷 경로(`ggml_moe_phaseb_snapshot_layer`)는 항상 backend get_tensor 를 쓰므로 실
+    //   버퍼가 필요하다 — 그래서 host 팔도 스텁을 붙인다(판정 분기는 여전히 host 직독).
+    int32_t buffer_mode       = 0;
