+                  pb_fnv(0xcbf29ce484222325ull, sb.data() + 128, sb.size() - 128) == hs.payload_digest &&
+                  hs.complete == 1 && hs.dropped_records == 0 &&
+                  hs.prefetch_on == 1 && hs.prefetch_k == 8 && hs.prefetch_n == 2 && hs.qd_effective == 4 &&
+                  hi.file_kind == 3 && hi.record_bytes == sizeof(ggml_moe_phaseb_io) &&
+                  std::memcmp(hi.kind_tag, "PB_IO_V1\0\0\0\0", 12) == 0 &&
+                  ib.size() == 128 + (size_t)hi.record_count * hi.record_bytes &&
