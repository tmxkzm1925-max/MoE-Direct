+// ===========================================================================
+// BINSEAL — ★v0.3.1 이월 원자 ⓐ: bin `note_seal` fail-close + **대칭 rollback**
+//
+// ★무엇이 결함이었나: `ggml_moe_phaseb_note_seal()` 은 프리페치 ON 이면 capture 풀·intent_q·
+//   predictor worker 를 기동하고 **그 성공 여부를 반환**한다. v3 경로는 이를 받아 fail-close
+//   하는데 **bin 경로는 반환값을 버렸다** ⇒ worker 기동 실패 시 bin seal 이 성공으로 성립하고,
+//   런은 header 에 `prefetch ON` 을 echo 한 채 intent 생산자 0 으로 돈다(조용한 no-op).
+//   수리는 실패 전파 + **그 시점 보유분 전량 rollback**(전역 alias·registry·슬롯·보호까지)이다.
+//
+// ★이 그룹의 관문 설계(교차 r1~r4 심의분):
+//   ⓐ**형상 의무** — 보호 구간은 `align_up(data,4096)~align_down(data+nbytes,4096)` 이고 완전
+//     페이지가 없으면 **건너뛴다**. 픽스처 텐서는 VirtualAlloc 반환 base(4K 이상 정렬)를 그대로
+//     쓰므로 조건은 `ggml_nbytes >= 4096` 으로 축약된다 — 기존 소형 MXFP4 형상(수백 B)으로 이
+//     관문을 지으면 **보호 구간이 0개**라 "원복됐다"가 아무것도 검사하지 않는다.
+//   ⓑ**양성 대조** — 같은 픽스처의 **정상 seal** 에서 PAGE_NOACCESS 와 `prot_intervals>=1` 을
+//     먼저 관측한다. 없으면 ⓒ의 녹색이 "애초에 안 걸렸다"와 구분되지 않는다.
+//   ⓒ**실패 직후 직접 관측** — "후속 seal 이 성립한다"는 완전 rollback 의 증거가 못 된다(후속
+//     seal 이 전역을 재게시해 stale alias 를 관측에서 지운다). `..._test_seal_residue()` 11축을
+//     실패 **직후** 읽는 것이 유일한 창이다.
+// ===========================================================================
+
+// ★형상 의무를 만족하는 bin 픽스처(fused Q6_K mid=256 = expert 슬라이스 53,760B × 8 =
+//   텐서 430,080B ⇒ 완전 4K 페이지 다수). `pb_setup_2layer` 와 같은 형태지만 그쪽 MXFP4
+//   {32,E} 형상은 텐서가 수백 B 라 보호 구간이 생기지 않으므로 여기서는 쓸 수 없다.
+static void binseal_setup(Fixture & fx, const char * tag) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "synth"; fx.model.n_expert = 8; fx.model.n_expert_used = 2; fx.model.n_layer = 2;
+    fx.model.n_embd = PB_TEST_N_EMBD; fx.model.f_norm_rms_eps = 1e-6f;   // note_seal 스냅샷 형상 확정
+    fx.model.sources = { default_source() };
+    fx.model.layers = { make_fused_layer(0, 8, "Q6_K", 256), make_fused_layer(1, 8, "Q6_K", 256) };
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.build();
+}
+
+// 계열 adapter 해소(선언 descriptor). 빼면 adapter 가 none 으로 내려가 `pf_on=false` 가 되고
+// note_seal 이 worker 를 아예 안 띄워 **주입이 소비되지 않는다**. reset 이 선언을 취소하므로
+// (`ggml_moe_phaseb_note_family(nullptr)`) 재seal 마다 다시 부른다.
+static void binseal_declare_family() {
+    PbInvFix F; PbInvOpt o;
+    pb_build_inventory(F, /*n_expert=*/8, PB_TEST_N_EMBD, /*n_layer_exec=*/2, /*n_expert_used=*/2, o);
+    ggml_moe_phaseb_note_family(&F.fam);   // 즉시 판정·복사 — F 는 여기서 파괴돼도 안전
+}
+
+// 픽스처가 이미 만든 텐서를 **그대로** 다시 등록한다(재빌드가 아니다 — 재빌드하면 주소가 바뀌어
+// 기준 페이지가 무효가 된다). `reset_for_test` 가 `g_mod.pending`·registry 를 비우므로 필요하다.
+static void binseal_reregister(Fixture & fx) {
+    for (auto & kv : fx.tensors) ggml_moe_direct_register(kv.second, kv.first.c_str(), 1);
+}
+
+struct BinSealResidue {
+    int32_t  df = -1, pb = -1, ns = -1, se = -1, rt = -1, rg = -1, pi = -1, ti = -1, sf = -1, veh = -1;
+    uint64_t pbytes = 0;
+    bool all_zero() const {
+        return df == 0 && pb == 0 && pbytes == 0 && ns == 0 && se == 0 && rt == 0 &&
+               rg == 0 && pi == 0 && ti == 0 && sf == 0 && veh == 0;
+    }
+    std::string str() const {
+        return "data_file=" + std::to_string(df) + " pool=" + std::to_string(pb) +
+               " pool_bytes=" + std::to_string(pbytes) + " n_slots=" + std::to_string(ns) +
+               " slots=" + std::to_string(se) + " records=" + std::to_string(rt) +
+               " registry=" + std::to_string(rg) + " prot=" + std::to_string(pi) +
+               " reg_info=" + std::to_string(ti) + " src_files=" + std::to_string(sf) +
+               " veh=" + std::to_string(veh);
+    }
+};
+static BinSealResidue binseal_residue() {
+    BinSealResidue r;
+    ggml_moe_direct_test_seal_residue(&r.df, &r.pb, &r.pbytes, &r.ns, &r.se, &r.rt, &r.rg,
+                                      &r.pi, &r.ti, &r.sf, &r.veh);
+    return r;
+}
+
+static DWORD binseal_protect_of(uintptr_t addr) {
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (VirtualQuery((LPCVOID)addr, &mbi, sizeof(mbi)) == 0) return 0;
+    return mbi.Protect;
+}
+
+static std::string hex32(DWORD v) {
+    char b[16]; snprintf(b, sizeof(b), "%08lx", (unsigned long)v); return std::string(b);
+}
