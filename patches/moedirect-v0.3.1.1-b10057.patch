+// ★★S2(교차 r8 Z3) — IO3 예상-cap 경계. `used < cap < used + need` 에서 대구간 행 묶음이
+//   통째로 빠지는데 `complete=1` 이면, 빠진 물리 행과 그만큼 낮아진 `records.n_children` 이
+//   **서로 자기일관**이라 §5-6 검산을 통과한다(false-valid wire). 그 경계를 실제로 밟아서
+//   wire 가 **무효로 선언되는지**를 잠근다.
+static void test_v3_coalesce_cap() {
+    section("V3k. mode=virtual A6 — IO3 예상-cap fail-close(§5-1 버퍼 상한 · 조용한 누락 금지)");
+
+    std::wstring dir = make_case_dir("v3_a6_cap_io3");
+    std::wstring pfx = dir + L"\\io3";
+    Io3Arm arm;
+    bool ran = false;
+    {
+        V3CoalEnv env("prefill", "0", "67108864", "16");
+        EnvGuard e1("MOE_DIRECT_IO3", "on"), e2("MOE_DIRECT_IO3_OUT", wide_to_utf8(pfx).c_str());
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_a6_cap_fx", /*n_shards=*/1, "8");
+        if (!check(lv.ok, "V3k1a. IO3 on + coalescing 픽스처 seal [" + lv.why + "]")) {
+            ggml_moe_direct_reset_for_test(); return;
+        }
+        ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+        // ① 먼저 한 묶음을 정상 기록해 `used` 를 만든다.
+        int32_t warm[2] = { 0, 1 };
+        ggml_moe_direct_acquire(gate0, warm, 2, /*n_tokens_hint=*/2);
+        ggml_moe_direct_release(gate0, warm, 2);
+        // ② cap 을 **지금 사용량 + 아주 조금**으로 낮춘다 — 다음 대구간 묶음(child 1 + copies n)이
+        //    통째로는 못 들어가는 경계다(운영 키는 MB 단위라 이 경계를 만들 수 없다).
+        //    ★경계를 **대구간 묶음에만** 걸어야 한다: records 행(80B×4)까지는 들어가고 그 뒤의
+        //    묶음(child 88 + copies 4×64 = 344B)만 못 들어가게 잡는다. records 쪽이 먼저 걸리면
+        //    그 경로가 complete=0 을 세워버려 이 관문이 coalesce 축을 증명하지 못한다.
+        const int32_t n_rec = 2, n_kid = 2, n_cp = 4;   // ①이 만든 행 수(record 2 · 대구간 2 · copies 4)
+        const uint64_t used = (uint64_t)n_rec * 80 + (uint64_t)n_kid * 88 + (uint64_t)n_cp * 64;
+        ggml_moe_direct_test_v3_set_io3_cap(used + 4 * 80 + 100);
+        int32_t more[4] = { 4, 5, 6, 7 };
+        ggml_moe_direct_acquire(gate0, more, 4, /*n_tokens_hint=*/4);
+        ggml_moe_direct_release(gate0, more, 4);
+        ggml_moe_direct_finalize();
+        ran = true;
+        ggml_moe_direct_reset_for_test();
+    }
+    if (!ran) return;
+    std::string why;
+    if (!check(arm.load(pfx, why), "V3k1. IO3 3파일 적재 [" + why + "]")) return;
+
+    const bool incomplete = (arm.hr.complete == 0 && arm.hc.complete == 0 && arm.hp.complete == 0);
+    const bool dropped    = (arm.hr.dropped_records > 0);
+    check(incomplete && dropped,
+          "V3k2. ★★예상-cap 경계에서 wire 가 **무효로 선언된다** — 3파일 `complete=0` · "
+          "`dropped_records=" + std::to_string((unsigned long long)arm.hr.dropped_records) +
+          "`(구 판은 현재 사용량만 봐서 `complete=1` 인 채로 행 묶음만 조용히 빠졌다)");
+
+    const std::string v = io3_verify(arm);
+    check(!v.empty() && v.find("complete") != std::string::npos,
+          "V3k3. ★그 wire 는 판독기가 **거부**한다(§5-6 fail-close) — 사유: " +
+          (v.empty() ? std::string("(통과해버렸다 = false-valid)") : v));
+}
