+// ===========================================================================
+// N. ★프리페치 Phase A 무행동 계측 (PREFETCH_DESIGN.md §3 · bench/moe-direct/SPEC_PHASEA_WIRE.md)
+//    off 무영향 · counts projection 결정론 · canonical dedupe · ledger 정합(claim/evict/release) ·
+//    NextN 제외(target 상한) · u16 경계(expert 255).
+// ===========================================================================
+
+// 사이드카 공용 헤더(SPEC_PHASEA_WIRE §2) — 판독기 쪽 계약을 selftest가 직접 행사한다.
+#pragma pack(push, 1)
+struct PaHdr {
+    char     magic[8];
+    uint32_t layout_version, file_kind, record_bytes, phasea_mode;
+    uint64_t record_count, payload_digest, qpc_frequency, t0_qpc;
+    uint32_t pid, complete, n_expert, n_moe_layers, n_slots, n_expert_used;
+    uint64_t boot_id, total_requests, dropped_records;
+    uint8_t  reserved[24];
+};
+struct PaLed {
+    uint8_t  kind, flags;
+    uint16_t expert, layer, part;
+    int32_t  slot;
+    uint32_t c32;
+    uint64_t t_qpc, val;
+};
+struct PaSetRec {
+    uint32_t graph_seq;
+    uint16_t layer;
+    uint8_t  flags, n_actual, n_miss, n_pred;
+    uint16_t reserved;
+    uint32_t request_index;
+    uint16_t actual[16], miss[16], pred_a0[16], pred_b[16];
+};
+#pragma pack(pop)
+static_assert(sizeof(PaHdr) == 128, "PaHdr 128B");
+static_assert(sizeof(PaLed) == 32,  "PaLed 32B");
+static_assert(sizeof(PaSetRec) == 144, "PaSetRec 144B");
+
+static uint64_t pa_fnv(uint64_t h, const void * d, size_t n) {
+    const uint8_t * p = (const uint8_t *)d;
+    for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 0x100000001b3ull; }
+    return h;
+}
+
+// 사이드카 파일 1개를 읽어 헤더+payload 를 돌려준다(완전성 게이트 포함).
+struct PaFile {
+    bool ok = false;
+    PaHdr h{};
+    std::vector<uint8_t> payload;
+};
+static PaFile pa_read(const std::wstring & path) {
+    PaFile f;
+    std::ifstream ifs(path, std::ios::binary);
+    if (!ifs.is_open()) return f;
+    std::vector<uint8_t> all((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
+    if (all.size() < sizeof(PaHdr)) return f;
+    std::memcpy(&f.h, all.data(), sizeof(PaHdr));
+    if (std::memcmp(f.h.magic, "MOEPA1\0\0", 8) != 0) return f;
+    if (f.h.layout_version != 1) return f;
+    if (all.size() != sizeof(PaHdr) + (size_t)f.h.record_count * f.h.record_bytes) return f;
+    f.payload.assign(all.begin() + sizeof(PaHdr), all.end());
+    if (pa_fnv(0xcbf29ce484222325ull, f.payload.data(), f.payload.size()) != f.h.payload_digest) return f;
+    f.ok = true;
+    return f;
+}
+
+// counts projection 만 추출(결정론 게이트 대상 — timing/pid/ts/seq 제외).
+static std::string pa_counts_projection(const std::wstring & metrics_path) {
+    std::ifstream ifs(metrics_path, std::ios::binary);
+    std::string line, out;
+    while (std::getline(ifs, line)) {
+        while (!line.empty() && (line.back() == '\r' || line.back() == '\n')) line.pop_back();
+        if (line.empty()) continue;
+        json j = json::parse(line, nullptr, false);
+        if (!j.is_object() || j.value("type", "") != "phase_a_run") continue;
+        out += std::to_string(j.value("request_index", -1)) + "|" + j["counts"].dump() + "\n";
+    }
+    return out;
+}
+
+// PA 시나리오 1회 완주: seal → run/graph 경계 → 고정 acquire/release 시퀀스 → finalize.
+// 반환: metrics 경로(비어 있으면 실패).
+struct PaRun {
+    bool ok = false;
+    std::wstring metrics, prefix;
+    uint64_t reads_total = 0;
+    QdStateSnap snap;
+    uint64_t hit[2] = {0,0}, miss[2] = {0,0}, rb[2] = {0,0};
+};
+static PaRun pa_run_scenario(const char * tag, const char * mode, int32_t n_expert = 8,
+                             bool with_out = true) {
+    PaRun r;
+    ggml_moe_phasea_reset_for_test();
+    std::wstring dir = make_case_dir(tag);
+    r.metrics = dir + L"\\metrics.jsonl";
+    r.prefix  = dir + L"\\pa";
+    if (mode) set_env("MOE_DIRECT_PHASEA", mode); else clear_env("MOE_DIRECT_PHASEA");
+    if (with_out) set_env("MOE_DIRECT_PHASEA_OUT", wide_to_utf8(r.prefix)); else clear_env("MOE_DIRECT_PHASEA_OUT");
+    set_env("MOE_DIRECT_METRICS", wide_to_utf8(r.metrics));
+
+    {
+        Fixture fx;
+        fx.dir = dir;
+        fx.model.arch = "synth"; fx.model.n_expert = n_expert; fx.model.n_expert_used = 2; fx.model.n_layer = 3;
+        fx.model.sources = { default_source() };
+        // 3층(0·1·2) — "NextN 제외" 계약은 target 상한(= n_moe_layers-1)으로 행사한다.
+        fx.model.layers = { make_separate_layer(0, n_expert, "MXFP4", false),
+                            make_separate_layer(1, n_expert, "MXFP4", false),
+                            make_separate_layer(2, n_expert, "MXFP4", false) };
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        // 슬롯 = n_expert (층 간 축출 강제 → EVICT 레코드가 실제로 나온다)
+        if (fx.seal((uint64_t)n_expert * fx.comp.slot_stride_max, 64) != 0) {
+            clear_env("MOE_DIRECT_METRICS"); clear_env("MOE_DIRECT_PHASEA"); clear_env("MOE_DIRECT_PHASEA_OUT");
+            return r;
+        }
+        ggml_tensor * g[3] = { fx.find("blk.0.ffn_gate_exps.weight"),
+                               fx.find("blk.1.ffn_gate_exps.weight"),
+                               fx.find("blk.2.ffn_gate_exps.weight") };
+        ggml_tensor * u[3] = { fx.find("blk.0.ffn_up_exps.weight"),
+                               fx.find("blk.1.ffn_up_exps.weight"),
+                               fx.find("blk.2.ffn_up_exps.weight") };
+        ggml_tensor * d[3] = { fx.find("blk.0.ffn_down_exps.weight"),
+                               fx.find("blk.1.ffn_down_exps.weight"),
+                               fx.find("blk.2.ffn_down_exps.weight") };
+        // 요청 2개(warmup 상당 + measured 상당) × decode graph 2개 × 3층 × 3 part.
+        const int32_t hi = n_expert - 1;   // ★u16 경계 — n_expert=256이면 255
+        bool fail = false;                 // ★실패 latch(Codex R1 권고 — 무조건 true 덮어쓰기 금지)
+        for (int req = 0; req < 2; req++) {
+            ggml_moe_phasea_run_begin();
+            for (int gi = 0; gi < 2; gi++) {
+                ggml_moe_phasea_graph_begin(/*phase=*/0, /*n_tokens=*/1);
+                for (int l = 0; l < 3; l++) {
+                    std::vector<int32_t> ids = { (int32_t)((l + gi) % n_expert), hi };
+                    for (ggml_tensor * t : { g[l], u[l], d[l] }) {
+                        const int32_t n = (int32_t)ids.size();
+                        if (ggml_moe_direct_acquire(t, ids.data(), n, 1) != 0) fail = true;
+                        ggml_moe_direct_release(t, ids.data(), n);
+                    }
+                }
+                ggml_moe_phasea_graph_end(/*n_nodes=*/100 + gi, /*n_splits=*/7);
+                // ★llama-context 배선과 동일하게 PA 무관 graph 형상 지문도 매 graph 기록(N9c 원자료).
+                ggml_moe_direct_graph_shape_note(/*n_nodes=*/100 + gi, /*n_splits=*/7);
+            }
+            // prefill graph 1개(set 레코드 미방출 계약 행사)
+            ggml_moe_phasea_graph_begin(/*phase=*/1, /*n_tokens=*/16);
+            {
+                std::vector<int32_t> ids = { 0, 1, hi };
+                if (ggml_moe_direct_acquire(g[0], ids.data(), (int32_t)ids.size(), 16) != 0) fail = true;
+                ggml_moe_direct_release(g[0], ids.data(), (int32_t)ids.size());
+            }
+            ggml_moe_phasea_graph_end(/*n_nodes=*/200, /*n_splits=*/3);
+            ggml_moe_direct_graph_shape_note(/*n_nodes=*/200, /*n_splits=*/3);
+            ggml_moe_phasea_run_end(/*predicted_n=*/2, /*prompt_n=*/16);
+        }
+        r.snap = qd_snapshot((int64_t)3 * n_expert);
+        for (int p = 0; p < 2; p++) ggml_moe_direct_phase_read_bytes_hit_miss(p, &r.rb[p], &r.hit[p], &r.miss[p]);
+        r.reads_total = qd_reads_total();
+        ggml_moe_direct_finalize();   // ★flush = 마지막 measured rep 종료 뒤 1회
+        r.ok = !fail;
+    }
+    clear_env("MOE_DIRECT_METRICS");
+    clear_env("MOE_DIRECT_PHASEA");
+    clear_env("MOE_DIRECT_PHASEA_OUT");
+    return r;
+}
+
+static void test_phasea() {
+    section("N. ★프리페치 Phase A — off 무영향·counts 결정론·canonical dedupe·ledger 정합·target 상한·u16 경계");
+
+    // ── N1. off 모드 무영향: 사이드카 미생성 + phase_a_run 미기록 + mode 판정 ──
+    {
+        PaRun off = pa_run_scenario("pa_off", nullptr);
+        bool no_files = true;
+        for (const wchar_t * suf : { L"_events.pa", L"_ops.pa", L"_ledger.pa", L"_sets.pa" }) {
+            std::ifstream f(off.prefix + suf, std::ios::binary);
+            if (f.is_open()) no_files = false;
+        }
+        check(off.ok && no_files, "N1a. ★PA=off — 사이드카 4파일 전부 미생성");
+        check(pa_counts_projection(off.metrics).empty(), "N1b. ★PA=off — phase_a_run 레코드 0건");
+        ggml_moe_phasea_reset_for_test();
+        check(ggml_moe_phasea_mode() == GGML_MOE_PHASEA_OFF && !ggml_moe_phasea_enabled(),
+              "N1c. env 미설정 → mode=off");
+
+        // ★무행동 계약: timing 모드의 캐시/읽기 결과가 off 와 완전 동일해야 한다.
+        PaRun tm = pa_run_scenario("pa_tm_parity", "timing");
+        bool same = off.ok && tm.ok && (off.snap == tm.snap) && off.reads_total == tm.reads_total;
+        for (int p = 0; p < 2; p++)
+            same = same && off.hit[p] == tm.hit[p] && off.miss[p] == tm.miss[p] && off.rb[p] == tm.rb[p];
+        check(same, "N1d. ★PA=off ↔ PA=timing 무행동 — record→slot/LRU/lease 스냅샷·hit/miss·read bytes 전량 동일");
+    }
+
+    // ── N2. counts projection 결정론 — 같은 시퀀스 2회의 counts 가 바이트 동일 ──
+    std::wstring det_prefix, det_metrics;
+    {
+        PaRun a = pa_run_scenario("pa_det1", "timing");
+        PaRun b = pa_run_scenario("pa_det2", "timing");
+        det_prefix = b.prefix; det_metrics = b.metrics;
+        const std::string ca = pa_counts_projection(a.metrics);
+        const std::string cb = pa_counts_projection(b.metrics);
+        check(a.ok && b.ok && !ca.empty() && ca == cb,
+              "N2. ★counts projection 결정론(2회 기동 바이트 동일, " + std::to_string(ca.size()) + "B)");
+    }
+
+    // ── N3~N6. 마지막 timing 런의 사이드카·metrics 를 판독해 계약 검사 ──
+    {
+        PaFile ev  = pa_read(det_prefix + L"_events.pa");
+        PaFile ops = pa_read(det_prefix + L"_ops.pa");
+        PaFile led = pa_read(det_prefix + L"_ledger.pa");
+        PaFile set = pa_read(det_prefix + L"_sets.pa");
+        check(ev.ok && ops.ok && led.ok && set.ok,
+              "N3a. ★사이드카 4파일 완전성(magic·version·크기·digest 재해시) 통과");
+        check(ev.h.complete == 1 && led.h.dropped_records == 0 && ev.h.record_bytes == 80 &&
+              ops.h.record_bytes == 72 && led.h.record_bytes == 32 && set.h.record_bytes == 144,
+              "N3b. ★헤더 계약 — complete=1·dropped=0·record_bytes(80/72/32/144)");
+        check(ev.h.boot_id == led.h.boot_id && ev.h.boot_id == set.h.boot_id && ev.h.boot_id != 0,
+              "N3c. ★boot_id 4파일 동일(사이드카↔metrics 조인 키)");
+
+        // metrics header 의 phasea echo 와 boot_id 결속
+        {
+            std::ifstream ifs(det_metrics, std::ios::binary);
+            std::string line; json hdr;
+            while (std::getline(ifs, line)) {
+                while (!line.empty() && (line.back() == '\r' || line.back() == '\n')) line.pop_back();
+                if (line.empty()) continue;
+                json j = json::parse(line, nullptr, false);
+                if (j.is_object() && j.value("type", "") == "header") { hdr = j; break; }
+            }
+            char want[32];
+            snprintf(want, sizeof(want), "0x%016llx", (unsigned long long)ev.h.boot_id);
+            check(!hdr.is_null() && hdr.value("phasea_mode", "") == "timing" &&
+                  hdr.value("phasea_boot_id", "") == std::string(want) &&
+                  hdr.value("phasea_eval_callback", true) == false,
+                  "N3d. ★metrics header echo — phasea_mode=timing·boot_id 일치·eval_callback=false(timing 금지 증명)");
+        }
+
+        // ── N4. canonical dedupe — (graph, layer)당 ACQ_CALL canonical 은 정확히 1개.
+        //    3 part 를 전부 acquire 했으므로 canonical 아닌 ACQ_CALL 이 2개씩 있어야 한다.
+        {
+            std::map<std::pair<uint32_t,uint16_t>, int> canon, total;
+            const size_t n = led.h.record_count;
+            for (size_t i = 0; i < n; i++) {
+                PaLed r; std::memcpy(&r, led.payload.data() + i * sizeof(PaLed), sizeof(PaLed));
+                if (r.kind != 1) continue;   // ACQ_CALL
+                auto key = std::make_pair(r.c32, r.layer);
+                total[key]++;
+                if (r.flags & 0x02) canon[key]++;
+            }
+            bool ok = !canon.empty();
+            for (auto & kv : canon) ok = ok && kv.second == 1;
+            int part3 = 0;
+            for (auto & kv : total) if (kv.second == 3) part3++;
+            check(ok && part3 > 0,
+                  "N4a. ★canonical dedupe — (graph,layer)당 canonical ACQ_CALL 정확히 1개(3-part 그룹 " +
+                  std::to_string(part3) + "개)");
+            // events 는 canonical 당 1건이므로 canonical 수와 같아야 한다.
+            check(ev.h.record_count == canon.size(),
+                  "N4b. ★A2 event 수 == canonical acquire 수(" + std::to_string(ev.h.record_count) +
+                  " vs " + std::to_string(canon.size()) + ")");
+        }
+
+        // ── N5. ledger 정합 — EVICT.slot 은 같은 ACQ_CALL 무리의 miss ACQ_EXPERT slot 과 대응하고,
+        //    ACQ_EXPERT 수 == REL_EXPERT 수, lease_after == lease_before-1, tick 엄격 증가,
+        //    SLOT_INIT 수 == n_slots, ops 수 == miss ACQ_EXPERT 수.
+        {
+            const size_t n = led.h.record_count;
+            uint64_t n_acq = 0, n_rel = 0, n_evict = 0, n_slotinit = 0, n_miss_exp = 0;
+            uint64_t last_tick = 0;
+            uint64_t cur_acq_t = 0, cur_rel_t = 0;
+            bool tick_mono = true, lease_ok = true, evict_ok = true, qpc_ok = true;
+            std::vector<int32_t> pending_evict_slots;
+            std::vector<int32_t> pending_miss_slots;
+            for (size_t i = 0; i < n; i++) {
+                PaLed r; std::memcpy(&r, led.payload.data() + i * sizeof(PaLed), sizeof(PaLed));
+                switch (r.kind) {
+                    case 1: // ACQ_CALL — 직전 그룹의 evict/miss slot 대응 정산
+                        for (int32_t s : pending_evict_slots) {
+                            if (std::find(pending_miss_slots.begin(), pending_miss_slots.end(), s)
+                                == pending_miss_slots.end()) evict_ok = false;
+                        }
+                        pending_evict_slots.clear(); pending_miss_slots.clear();
+                        cur_acq_t = r.t_qpc;
+                        break;
+                    case 2: // ACQ_EXPERT
+                        n_acq++;
+                        if (r.val <= last_tick) tick_mono = false;
+                        last_tick = r.val;
+                        if ((r.flags & 0x01) == 0) { n_miss_exp++; pending_miss_slots.push_back(r.slot); }
+                        if (r.t_qpc != cur_acq_t) qpc_ok = false;   // ★소속 CALL과 동일 시각(§5·F-2)
+                        break;
+                    case 3: n_evict++; pending_evict_slots.push_back(r.slot); break;
+                    case 4: cur_rel_t = r.t_qpc; break;             // REL_CALL
+                    case 5: { // REL_EXPERT
+                        n_rel++;
+                        const uint32_t before = (uint32_t)(r.val >> 32), after = (uint32_t)(r.val & 0xFFFFFFFFu);
+                        if (!(after + 1 == before)) lease_ok = false;
+                        if (r.t_qpc != cur_rel_t) qpc_ok = false;   // ★소속 CALL과 동일 시각(§5·F-2)
+                        break;
+                    }
+                    case 6: n_slotinit++; break;
+                    default: break;
+                }
+            }
+            for (int32_t s : pending_evict_slots) {
+                if (std::find(pending_miss_slots.begin(), pending_miss_slots.end(), s)
+                    == pending_miss_slots.end()) evict_ok = false;
+            }
+            check(n_slotinit == led.h.n_slots && n_slotinit > 0,
+                  "N5a. ★SLOT_INIT 수 == n_slots(" + std::to_string(n_slotinit) + ") — arm 시작 초기 상태 기록");
+            check(n_acq == n_rel && n_acq > 0,
+                  "N5b. ★ACQ_EXPERT(" + std::to_string(n_acq) + ") == REL_EXPERT(" + std::to_string(n_rel) + ")");
+            check(lease_ok, "N5c. ★REL_EXPERT lease_after == lease_before-1 전건");
+            check(tick_mono, "N5d. ★ACQ_EXPERT logical_last_tick 엄격 증가(논리 요청 순서 tick)");
+            check(n_evict > 0 && evict_ok,
+                  "N5e. ★EVICT(" + std::to_string(n_evict) + ")의 slot 이 같은 acquire 무리의 miss slot 과 대응");
+            check(ops.h.record_count == n_miss_exp,
+                  "N5f. ★op-level demand read 수(" + std::to_string(ops.h.record_count) +
+                  ") == miss ACQ_EXPERT 수(" + std::to_string(n_miss_exp) + ")");
+            check(qpc_ok, "N5g. ★ACQ/REL_EXPERT t_qpc == 소속 CALL t_qpc 전건(§5 시각 계약·F-2)");
+        }
+
+        // ── N6. set 레코드 — decode graph 전용 · target 상한(NextN 제외) · pred 미기록(timing) ──
+        {
+            const size_t n = set.h.record_count;
+            bool phase_ok = true, layer_ok = true, pred_ok = true, actual_ok = true;
+            uint16_t max_layer = 0;
+            for (size_t i = 0; i < n; i++) {
+                PaSetRec s; std::memcpy(&s, set.payload.data() + i * sizeof(PaSetRec), sizeof(PaSetRec));
+                if (s.flags & 0x01) phase_ok = false;                     // b0 = prefill 이면 위반
+                if (s.layer >= set.h.n_moe_layers) layer_ok = false;      // 실행층 상한(NextN 제외)
+                max_layer = std::max(max_layer, s.layer);
+                if (s.n_pred != 0 || (s.flags & 0x06)) pred_ok = false;   // timing 은 예측 없음
+                if (s.n_actual == 0) actual_ok = false;
+            }
+            check(n > 0 && phase_ok, "N6a. ★set 레코드 decode graph 전용(prefill graph 미방출) — " +
+                                     std::to_string(n) + "건");
+            check(layer_ok && max_layer + 1 == set.h.n_moe_layers,
+                  "N6b. ★target layer 상한 = 실행층 수-1(" + std::to_string(max_layer) +
+                  ") — NextN 층 계상 없음");
+            check(pred_ok, "N6c. ★timing 모드는 pred 미기록(n_pred=0·pred valid flag 0)");
+            check(actual_ok, "N6d. ★actual 집합 전건 기록(canonical acquire 요청 집합)");
+        }
+    }
+
+    // ── N7. u16 경계 — n_expert=256 · expert 255 가 사이드카에 u16 으로 온전히 실린다 ──
+    {
+        PaRun r = pa_run_scenario("pa_u16", "timing", /*n_expert=*/256);
+        PaFile led = pa_read(r.prefix + L"_ledger.pa");
+        PaFile ops = pa_read(r.prefix + L"_ops.pa");
+        bool have255 = false, bad = false;
+        if (led.ok) {
+            for (size_t i = 0; i < led.h.record_count; i++) {
+                PaLed e; std::memcpy(&e, led.payload.data() + i * sizeof(PaLed), sizeof(PaLed));
+                if (e.kind != 2 && e.kind != 5) continue;
+                if (e.expert == 255) have255 = true;
+                if (e.expert == 0xFFFF) bad = true;   // u8 재사용이면 255가 NA로 오염된다
+            }
+        }
+        check(r.ok && led.ok && ops.ok && have255 && !bad,
+              "N7. ★u16 경계 — n_expert=256에서 expert 255가 NA(0xFFFF)와 충돌 없이 기록(ledger records=" +
+              std::to_string(led.h.record_count) + ")");
+    }
+
+    // ── N8. OUT 미설정 fail-close — 사이드카 미기록 + complete=0 ──
+    {
+        PaRun r = pa_run_scenario("pa_noout", "timing", 8, /*with_out=*/false);
+        std::ifstream f(r.prefix + L"_events.pa", std::ios::binary);
+        const bool no_file = !f.is_open();
+        std::ifstream ifs(r.metrics, std::ios::binary);
+        std::string line; bool complete_zero = false, saw = false;
+        while (std::getline(ifs, line)) {
+            while (!line.empty() && (line.back() == '\r' || line.back() == '\n')) line.pop_back();
+            if (line.empty()) continue;
+            json j = json::parse(line, nullptr, false);
+            if (j.is_object() && j.value("type", "") == "phase_a_run") {
+                saw = true;
+                if (j.contains("sidecar") && j["sidecar"].value("complete", 1) == 0) complete_zero = true;
+            }
+        }
+        check(r.ok && no_file && saw && complete_zero,
+              "N8. ★MOE_DIRECT_PHASEA_OUT 미설정 → 사이드카 미기록 + sidecar.complete=0(fail-close)");
+    }
+
+    // ── N9. V1 무행동 증명 필드 — summary 에 readfile/lru digest 가 실린다(PA 모드 무관) ──
+    {
+        PaRun off = pa_run_scenario("pa_v1_off", nullptr);
+        PaRun tm  = pa_run_scenario("pa_v1_tm",  "timing");
+        auto summary_of = [](const std::wstring & p) {
+            std::ifstream ifs(p, std::ios::binary);
+            std::string line; json last;
+            while (std::getline(ifs, line)) {
+                while (!line.empty() && (line.back() == '\r' || line.back() == '\n')) line.pop_back();
+                if (line.empty()) continue;
+                json j = json::parse(line, nullptr, false);
+                if (j.is_object() && j.value("type", "") == "summary") last = j;
+            }
+            return last;
+        };
+        json so = summary_of(off.metrics), st = summary_of(tm.metrics);
+        const bool present = !so.is_null() && !st.is_null() &&
+                             so.contains("moe_readfile_digest") && so.contains("moe_lru_tick_digest") &&
+                             st.contains("moe_readfile_digest") && st.contains("moe_lru_tick_digest");
+        const bool equal = present &&
+                           so["moe_readfile_digest"] == st["moe_readfile_digest"] &&
+                           so["moe_lru_tick_digest"] == st["moe_lru_tick_digest"] &&
+                           so["moe_readfile_ops"]    == st["moe_readfile_ops"] &&
+                           so["moe_tick_final"]      == st["moe_tick_final"];
+        check(present, "N9a. ★summary 에 V1 digest 4필드(readfile/lru tick) 존재 — PA off·timing 양쪽");
+        check(equal, "N9b. ★PA=off ↔ PA=timing ordered ReadFile digest · LRU tick digest 동일(무행동 증명)");
+        // ★Codex R1 필수 1 — PA 무관 graph 형상 지문이 off arm에도 있어야 §3.3 비교가 성립한다.
+        const bool g_present = !so.is_null() && !st.is_null() &&
+                               so.contains("moe_graph_nodes_digest") && st.contains("moe_graph_nodes_digest");
+        const bool g_equal = g_present &&
+                             so["moe_graph_count"]         == st["moe_graph_count"] &&
+                             so["moe_graph_nodes_digest"]  == st["moe_graph_nodes_digest"] &&
+                             so["moe_graph_splits_digest"] == st["moe_graph_splits_digest"] &&
+                             so.value("moe_graph_count", 0) == 6;   // 2요청 × (decode 2 + prefill 1)
+        check(g_present, "N9c. ★summary 에 graph 형상 지문 3필드 존재 — PA off 포함(off측 비교값)");
+        check(g_equal, "N9d. ★PA=off ↔ PA=timing graph nodes/splits digest·count 동일(형상 무변경 증명)");
+    }
+
+    // ── N10. accuracy 관측 결손 fail-close — 콜백 미설치·tap 0 이면 arm 무효(Codex R1 필수 2) ──
+    {
+        PaRun r = pa_run_scenario("pa_acc_gate", "accuracy");
+        PaFile ev = pa_read(r.prefix + L"_events.pa");
+        std::ifstream ifs(r.metrics, std::ios::binary);
+        std::string line;
+        bool saw = false, gate_zero = false, complete_zero = false, expected_pos = false;
+        while (std::getline(ifs, line)) {
+            while (!line.empty() && (line.back() == '\r' || line.back() == '\n')) line.pop_back();
+            if (line.empty()) continue;
+            json j = json::parse(line, nullptr, false);
+            if (!j.is_object() || j.value("type", "") != "phase_a_run") continue;
+            saw = true;
+            if (j.contains("counts") && j["counts"].contains("accuracy_gate")) {
+                const json & gjson = j["counts"]["accuracy_gate"];
+                if (gjson.value("pass", 1) == 0) gate_zero = true;
+                if (gjson.value("expected_taps", (uint64_t)0) > 0) expected_pos = true;
+            }
+            if (j.contains("sidecar") && j["sidecar"].value("complete", 1) == 0) complete_zero = true;
+        }
+        check(r.ok && saw && expected_pos && gate_zero && complete_zero && ev.ok && ev.h.complete == 0,
+              "N10. ★accuracy 관측 결손(콜백 미설치·tap 0) → accuracy_gate.pass=0 + complete=0(fail-close)");
+    }
+
+    ggml_moe_phasea_reset_for_test();
+}
+
+// ===========================================================================
+// P. ★B2 층-선행 프리페치 (PHASEB_DESIGN §3~§5 · SPEC_PHASEB_WIRE §1~§9)
+//    §7.1 픽스처군 — ①A′ ordered 동등성 ②persistent pending/join·multiplicity·promotion
+//    ③demand preflight reserve↔probation victim ④prefetch 오류/부분 read unpublish + joined
+//    retry 이전(구 슬롯 lease 0) ⑤cancel 후 완료 확인 전 slot 재사용 금지 + shutdown 중
+//    success-after-cancel 미publish ⑥stale generation·사전 처분 ⑦abort/shutdown drain(CUT)
+//    ⑧trace OFF/ON 동일 digest(C4′) ⑨256E u16 실 wire + (A) join last_used LRU 회귀
+//    + wire 게이트 코드 재계산(closure·dense event seq·QD 재생·publish_seq·digest 대조).
+// ===========================================================================
+
+static const int32_t PB_TEST_N_EXPERT = 16;   // n_expert >= k(8) 이어야 프리페치가 켜진다
+static const int32_t PB_TEST_N_EMBD   = 8;
+
+// 프리페치 ON 형상 seal — QD/K/N/PB 모드를 env로 지정하고 2층 × 16E 합성 모델을 seal한다.
+struct PbEnv {
+    // ★B2 프리페치는 영속 dispatcher 경로에서만 정의된다(legacy는 qualification 대조군) —
+    //   외부에서 selector를 legacy로 강제해 전 구간을 돌리는 실행에서도 이 섹션은 persistent로 고정한다.
+    EnvGuard path, qd, k, n, mode, out, metrics;
+    PbEnv(const char * qd_v, const char * k_v, const char * n_v, const char * mode_v,
+          const char * out_v, const char * metrics_v)
+        : path("MOE_DIRECT_IO_PATH", "persistent"),
+          qd("MOE_DIRECT_QD", qd_v), k("MOE_DIRECT_PREFETCH_K", k_v), n("MOE_DIRECT_PREFETCH_N", n_v),
+          mode("MOE_DIRECT_PHASEB", mode_v), out("MOE_DIRECT_PHASEB_OUT", out_v),
+          metrics("MOE_DIRECT_METRICS", metrics_v) {}
+};
+
+// ★계열 신호 descriptor(SPEC_FAMILY_SIGNAL v0.2 §1) — qwen35moe_v1 프로필.
+//   ★합성 count 직접 주입 금지: 실제 `ggml_tensor` 를 만들어 **프로덕션과 동일한 inventory
+//   생산 경로**(모듈의 이름/타입/전 차원 형상/contiguous/finite 판정)를 그대로 행사한다.
+//   프로덕션에선 llama-model.cpp 가 로드된 `layers[]` 포인터를 그대로 넘긴다.
+//   ★1차 소스 대조: qwen35moe 는 `expert_gating_func`/`expert_group_count` 를 설정하지 않고
+//     (src/models/qwen35moe.cpp), norm=attn_post_norm(74행)·router=ffn_gate_inp(98행)·
+//     gate/exp_probs bias 부재다. manifest 의 `arch`("synth")와는 독립 축이라 기존 카탈로그
+//     검증 경로는 건드리지 않는다.
+
+// ★품목5 — norm 인벤토리 원소 주입점(층 · 0-based 좌표 · 값). exact-zero 인벤토리 픽스처가
+//   397B 실측 벡터를 **합성 데이터로** 재현하는 데 쓴다(N7 — 매 회귀 447GB 재스캔 금지).
+struct PbNormPoke { int32_t layer; int32_t index; float value; };
+
+// 인벤토리 주입 훅(0 = 정상 qwen 프로필).
+struct PbInvOpt {
+    bool    bias_gi_named   = false;  // layer≥1 에 ffn_gate_inp.bias 부착(**정상 이름**)
+    bool    bias_gi_misname = false;  // 〃 **비-null·오이름**(부재로 오인되던 구멍)
+    bool    bias_gi_nan     = false;  // 〃 정상 이름·NaN 원소(finite 봉인 — 3단계 gpt 프로필)
+    bool    bias_ep_named   = false;  // layer≥1 에 exp_probs_b.bias 부착(K2.6 프로필)
+    bool    norm_shape_bad  = false;  // layer0 norm ne[0] 오형상
+    bool    norm_dim3_bad   = false;  // layer0 norm ne[2]=2(3·4차원 오염 — 부분 봉인 회귀)
+    bool    router_type_bad = false;  // layer1 router F16
+    // ★§1.6 격리 음성 — layer≥1 router 를 BF16 으로. **deepseek4_v1 이 아닌 계열**에서는
+    //   allowlist 가 닫혀 있어야 하므로 이 옵션은 전부 거부(=fail-close)를 기대한다.
+    bool    router_bf16     = false;
+    bool    router_nan      = false;  // layer1 router 원소에 NaN
+    bool    norm_inf        = false;  // layer0 norm 원소에 Inf
+    bool    drop_norm_l0    = false;  // layer0 norm 결손
+    bool    drop_router_l1  = false;  // layer1 router 결손
+    int32_t groups          = 0;      // n_expert_groups 주입값
+    int32_t gating          = 0;      // expert_gating_func 주입값(K2.6 프로필 = 2=sigmoid)
+    int     ml_mode         = 0;      // 0=정상 1=역순 2=층 누락(gap) 3=leading 1 4=전층(seal 표류용)
+    // ★품목5 — attn_post_norm 원소 직접 기입(exact-zero 인벤토리 픽스처 · 다른 옵션과 독립).
+    std::vector<PbNormPoke> norm_poke;
+};
+
+// 합성 인벤토리 소유자 — note_family 가 **즉시** 판정·복사하므로 이 객체는 그 호출 뒤 파괴해도 된다.
+struct PbInvFix {
+    ggml_context * ctx = nullptr;
+    std::vector<void *> blocks;
+    std::vector<ggml_moe_phaseb_layer_in> lin;
+    std::vector<int32_t> ml;
+    // ★게이트 ⑦ — 비-host 팔 픽스처가 붙인 스텁 버퍼(host 팔 픽스처에서는 비어 있다).
+    std::vector<ggml_backend_buffer_t> bufs;
+    ggml_moe_phaseb_family_in fam{};
+    ~PbInvFix() {
+        for (ggml_backend_buffer_t b : bufs) ggml_backend_buffer_free(b);
+        for (void * b : blocks) free(b);
+        if (ctx) ggml_free(ctx);
+    }
+};
+
+static void pb_build_inventory(PbInvFix & F, int32_t n_expert, int32_t n_embd,
+                               int32_t n_layer_exec, int32_t n_expert_used, const PbInvOpt & o) {
+    ggml_init_params p{};
+    p.mem_size  = (size_t)(n_layer_exec * 6 + 8) * ggml_tensor_overhead() + 4096;
+    p.no_alloc  = true;
+    F.ctx = ggml_init(p);
+    auto mk = [&](ggml_type ty, int64_t e0, int64_t e1, int64_t e2, const std::string & name,
+                  float bad) -> ggml_tensor * {
+        int64_t ne[GGML_MAX_DIMS] = { e0, e1, e2, 1 };
+        ggml_tensor * t = ggml_new_tensor(F.ctx, ty, (e2 > 1 ? 3 : (e1 > 1 ? 2 : 1)), ne);
+        ggml_set_name(t, name.c_str());
+        const size_t nb = ggml_nbytes(t);
+        void * blk = calloc(1, nb + 64);
+        F.blocks.push_back(blk);
+        t->data = blk;                       // buffer 는 nullptr — 모듈의 host 직독 분기를 탄다
+        if (ty == GGML_TYPE_F32) {
+            float * f = (float *)blk;
+            const size_t n = nb / sizeof(float);
+            for (size_t i = 0; i < n; i++) f[i] = 0.25f + 0.01f * (float)(i % 7);
+            if (bad != 0.0f && n > 0) f[n / 2] = bad;
+        }
+        return t;
+    };
+    const float NANV = std::numeric_limits<float>::quiet_NaN();
+    const float INFV = std::numeric_limits<float>::infinity();
+
+    F.lin.assign((size_t)n_layer_exec, ggml_moe_phaseb_layer_in{});
+    for (int32_t il = 0; il < n_layer_exec; il++) {
+        const std::string b = "blk." + std::to_string(il) + ".";
+        if (!(il == 0 && o.drop_norm_l0)) {
+            const int64_t e0 = (il == 0 && o.norm_shape_bad) ? n_embd + 1 : n_embd;
+            const int64_t e2 = (il == 0 && o.norm_dim3_bad)  ? 2 : 1;
+            F.lin[(size_t)il].attn_post_norm =
+                mk(GGML_TYPE_F32, e0, 1, e2, b + "post_attention_norm.weight",
+                   (il == 0 && o.norm_inf) ? INFV : 0.0f);
+        }
+        if (il >= 1) {
+            if (!(il == 1 && o.drop_router_l1)) {
+                const ggml_type rt = (il == 1 && o.router_type_bad) ? GGML_TYPE_F16
+                                   : (o.router_bf16 ? GGML_TYPE_BF16 : GGML_TYPE_F32);
+                F.lin[(size_t)il].ffn_gate_inp =
+                    mk(rt, n_embd, n_expert, 1, b + "ffn_gate_inp.weight",
+                       (il == 1 && o.router_nan) ? NANV : 0.0f);
+            }
+            if (o.bias_gi_named || o.bias_gi_nan)
+                F.lin[(size_t)il].ffn_gate_inp_b =
+                    mk(GGML_TYPE_F32, n_expert, 1, 1, b + "ffn_gate_inp.bias",
+                       (il == 1 && o.bias_gi_nan) ? NANV : 0.0f);
+            if (o.bias_gi_misname)   // ★비-null 인데 이름이 다르다 → "부재"가 아니라 present
+                F.lin[(size_t)il].ffn_gate_inp_b = mk(GGML_TYPE_F32, n_expert, 1, 1, b + "ffn_gate_inp_WRONG.bias", 0.0f);
+            if (o.bias_ep_named)     // K2.6 프로필 — 4단계 미등재 확인용
+                F.lin[(size_t)il].ffn_exp_probs_b = mk(GGML_TYPE_F32, n_expert, 1, 1, b + "exp_probs_b.bias", 0.0f);
+        }
+    }
+    // ★품목5 — norm 원소 주입(전 층 정상 생성 후 좌표 단위로 덮어쓴다. 주입 순서는 무관 —
+    //   인벤토리가 **오름차순으로** 산출하는지까지 이 순서 무관성으로 검증된다).
+    for (const auto & pk : o.norm_poke) {
+        if (pk.layer < 0 || pk.layer >= n_layer_exec) continue;
+        const ggml_tensor * t = F.lin[(size_t)pk.layer].attn_post_norm;
+        if (!t || pk.index < 0 || pk.index >= n_embd) continue;
+        ((float *)t->data)[pk.index] = pk.value;
+    }
+    F.ml.clear();
+    switch (o.ml_mode) {
+        case 1: F.ml = { 1, 0 }; break;                       // 역순
+        case 2: F.ml = { 0 }; break;                          // 층 1 누락(gap)
+        case 3: F.ml = { 1 }; break;                          // leading-dense 1(K2.6 형)
+        case 4: for (int32_t l = 0; l < n_layer_exec; l++) F.ml.push_back(l); break;
+        default: for (int32_t l = 0; l < n_layer_exec; l++) F.ml.push_back(l); break;
+    }
+    F.fam = ggml_moe_phaseb_family_in{};
+    F.fam.arch               = "qwen35moe";
+    F.fam.expert_gating_func = o.gating;     // qwen35moe·gpt-oss 미설정(=none 0) · K2.6 = 2
+    F.fam.n_expert_groups    = o.groups;
+    F.fam.n_embd             = n_embd;
+    F.fam.n_expert           = n_expert;
+    F.fam.n_expert_used      = n_expert_used;
+    F.fam.n_layer_exec       = n_layer_exec;
+    F.fam.n_moe_layers       = (int32_t)F.ml.size();
+    F.fam.moe_layers         = F.ml.data();
+    F.fam.layers             = F.lin.data();
+}
+
+//   ★3단계 확장: arch/bias 프로필을 인자로 받아 gpt-oss(openai_moe_v1) 형상도 같은 경로로
+//   세울 수 있게 한다(기본값 = 종전 qwen35moe 프로필 — 기존 호출부 무변경).
+static void pb_setup_2layer(Fixture & fx, const char * tag, int32_t n_expert = PB_TEST_N_EXPERT,
+                            const char * arch = nullptr, bool bias_gi = false) {
+    fx.dir = make_case_dir(tag);
+    fx.model.arch = "synth"; fx.model.n_expert = n_expert; fx.model.n_expert_used = 2; fx.model.n_layer = 2;
+    // ★R1 #5 ② — seal 시점에 router/norm 스냅샷 형상이 확정되도록 n_embd 를 실 디스크립터로 준다.
+    fx.model.n_embd = PB_TEST_N_EMBD; fx.model.f_norm_rms_eps = 1e-6f;
+    fx.model.sources = { default_source() };
+    fx.model.layers = { make_separate_layer(0, n_expert, "MXFP4", false),
+                        make_separate_layer(1, n_expert, "MXFP4", false) };
+    fx.comp = compute_layout(fx.model, 4096);
+    fx.build();
+    // ★seal 이전 descriptor 선언(§1) — 실 텐서 인벤토리로 생산 경로를 행사한다. 이걸 빼면
+    //   adapter 가 none 으로 해소돼 신호가 전면 비활성된다.
+    PbInvFix F; PbInvOpt o;
+    o.bias_gi_named = bias_gi;
+    pb_build_inventory(F, n_expert, PB_TEST_N_EMBD, /*n_layer_exec=*/2, /*n_expert_used=*/2, o);
+    if (arch) F.fam.arch = arch;
+    ggml_moe_phaseb_note_family(&F.fam);   // 즉시 판정·복사 — F 는 여기서 파괴돼도 안전
+}
+
+// C3 카운터 스냅샷(§6 표 전건).
+struct PbCtr {
+    uint64_t v[GGML_MOE_PB_C_COUNT] = {0};
+    uint64_t get(int c) const { return v[c]; }
+};
+static PbCtr pb_ctr() {
+    PbCtr c;
+    for (int i = 0; i < GGML_MOE_PB_C_COUNT; i++) c.v[i] = ggml_moe_phaseb_counter(i);
+    return c;
+}
