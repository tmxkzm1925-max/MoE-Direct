+
+// 동결 산식 + **bias 가산**의 독립 재계산(모듈 코드 미사용): TopK16(router[1]·a0_norm + bias[1]).
+static std::vector<uint16_t> pb_ref_topk16_bias(const std::vector<float> & x, const std::vector<float> & w0,
+                                                const std::vector<float> & w1, const std::vector<float> & rt1,
+                                                const std::vector<float> * bias, int32_t ne, int32_t nx) {
+    std::vector<float> y((size_t)ne), lg((size_t)nx);
+    for (int32_t i = 0; i < ne; i++) y[(size_t)i] = (x[(size_t)i] * w1[(size_t)i]) / w0[(size_t)i];
+    for (int32_t e = 0; e < nx; e++) {
+        float acc = 0.0f;
+        for (int32_t i = 0; i < ne; i++) acc += rt1[(size_t)e * (size_t)ne + (size_t)i] * y[(size_t)i];
+        if (bias) acc += (*bias)[(size_t)e];
+        lg[(size_t)e] = acc;
+    }
+    std::vector<char> used((size_t)nx, 0);
+    std::vector<uint16_t> ref(16, 0xFFFF);
+    const int k = (int)std::min<int32_t>(16, nx);
+    for (int r = 0; r < k; r++) {
+        int best = -1; float bv = 0.0f;
+        for (int32_t e = 0; e < nx; e++) {
+            if (used[(size_t)e]) continue;
+            if (best < 0 || lg[(size_t)e] > bv) { best = e; bv = lg[(size_t)e]; }
+        }
+        used[(size_t)best] = 1; ref[(size_t)r] = (uint16_t)best;
+    }
+    return ref;
+}
+
+// 합성 스냅샷(router/norm/bias) 주입 + seal. bias 는 **지배적 부호 패턴**(홀수 expert +B)을 실어
+// "bias 가 실제 선택에 도달했는가"를 부정 컨트롤로 판별할 수 있게 만든다.
+static void pb_fill_snapshot_bias(int32_t ne, int32_t nx, uint32_t seed, float bias_mag,
+                                  std::vector<float> & w0, std::vector<float> & w1,
+                                  std::vector<float> & rt1, std::vector<float> & bias) {
+    w0.assign((size_t)ne, 0.0f); w1.assign((size_t)ne, 0.0f);
+    rt1.assign((size_t)ne * (size_t)nx, 0.0f);
+    bias.assign((size_t)nx, 0.0f);
+    std::mt19937 rng(seed);
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (auto & v : w0)  v = 0.5f + std::fabs(ud(rng));
+    for (auto & v : w1)  v = ud(rng);
+    for (auto & v : rt1) v = ud(rng);
+    for (int32_t e = 0; e < nx; e++) bias[(size_t)e] = ((e % 2) ? bias_mag : -bias_mag) + 0.25f * ud(rng);
+    ggml_moe_phaseb_test_snapshot_raw(0, nullptr, w0.data());
+    ggml_moe_phaseb_test_snapshot_raw(1, rt1.data(), w1.data());
+    ggml_moe_phaseb_test_snapshot_bias_raw(1, bias.data());
+    ggml_moe_phaseb_snapshot_seal();
+}
