+        fx.model.n_layer = 2; fx.model.n_embd = PB_TEST_N_EMBD; fx.model.f_norm_rms_eps = 1e-6f;
+        fx.model.sources = { default_source() };
+        fx.model.layers = { make_separate_layer(0, PB_TEST_N_EXPERT, "MXFP4", false),
+                            make_separate_layer(1, PB_TEST_N_EXPERT, "MXFP4", false) };
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0,
+                   "P15a. seal 성공(PA timing + PB trace 병행)")) return;
+        check(ggml_moe_phaseb_boot_id() == ggml_moe_phasea_boot_id() && ggml_moe_phaseb_boot_id() != 0,
+              "P15b. ★★PB boot_id == PA boot_id(조인 키는 boot_id 축뿐 — t0_qpc 는 v4 확정 PB-local)");
+        ggml_moe_phaseb_run_begin();
+        ggml_moe_phasea_run_begin();
+        ggml_moe_phasea_graph_begin(0, 1);
+        ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+        ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+        std::vector<int32_t> ids = {0,1};
+        ggml_moe_direct_acquire(g0, ids.data(), 2, 1);
+        ggml_moe_direct_release(g0, ids.data(), 2);
+        ggml_moe_phaseb_graph_end();
+        ggml_moe_phasea_graph_end(10, 2);
+        ggml_moe_phasea_run_end(1, 1);
+        ggml_moe_phaseb_run_end();
+        ggml_moe_direct_finalize();
+    }
+    // .pb / .pa 헤더 boot_id 와 metrics header echo 3자 대조.
+    auto read_u64 = [](const std::wstring & path, size_t off) -> uint64_t {
+        std::ifstream ifs(path, std::ios::binary);
+        std::vector<uint8_t> h(128);
+        ifs.read((char *)h.data(), 128);
+        uint64_t v = 0; std::memcpy(&v, h.data() + off, 8); return v;
+    };
+    const uint64_t pb_boot = read_u64(dir + L"\\pb_io.pb", 80);
+    const uint64_t pa_boot = read_u64(dir + L"\\pa_ops.pa", 80);
+    std::string hdr_pb, hdr_pa;
+    {
+        std::ifstream ifs(dir + L"\\metrics.jsonl", std::ios::binary);
+        std::string line;
+        while (std::getline(ifs, line)) {
+            while (!line.empty() && (line.back()=='\r'||line.back()=='\n')) line.pop_back();
+            if (line.empty()) continue;
+            json j = json::parse(line, nullptr, false);
+            if (j.is_object() && j.value("type","") == "header") {
+                hdr_pb = j.value("phaseb_boot_id", ""); hdr_pa = j.value("phasea_boot_id", "");
+            }
+        }
+    }
+    char buf[32]; snprintf(buf, sizeof(buf), "0x%016llx", (unsigned long long)pb_boot);
+    check(pb_boot != 0 && pb_boot == pa_boot && hdr_pb == std::string(buf) && hdr_pb == hdr_pa,
+          "P15c. ★★3자 일치 — pb_io.pb boot_id(" + std::string(buf) + ") == pa_ops.pa boot_id == "
+          "metrics phaseb_boot_id(" + hdr_pb + ") == phasea_boot_id(" + hdr_pa + ")");
+}
