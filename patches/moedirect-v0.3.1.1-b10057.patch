+};
+
+// SPEC_PHASEB_WIRE §4.2 — rank_disposition 닫힌 enum.
+enum ggml_moe_phaseb_disp {
+    GGML_MOE_PB_D_RANK_NA            = 0,
+    GGML_MOE_PB_D_PRE_TOO_LATE       = 1,
