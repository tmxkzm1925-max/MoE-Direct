+    EnvGuard eg_q("MOE_DIRECT_QUALIFY", nullptr);
+    EnvGuard eg_p("MOE_DIRECT_IO_PATH", nullptr);
+    EnvGuard eg_qd("MOE_DIRECT_QD", "8");
+    Fixture fx; qd_setup_2layer(fx, "b1_evdisc");
+    int rc = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+    if (!check(rc == 0, "O10a. seal 성공(QD=8 — 채널 8개)")) return;
+
+    ggml_tensor * g0 = fx.find("blk.0.ffn_gate_exps.weight");
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+
+    uint64_t imm0 = 0, pend0 = 0;
+    ggml_moe_direct_test_read_stats(&imm0, &pend0);
+
+    // 배치 여러 번(층 교대로 축출 강제) — 매 배치 terminal 직후 불변식을 확인한다.
+    int worst_idle_signaled = 0;
+    int32_t n_ch = 0, busy = 0, idle_sig = 0;
+    uint64_t wk = 0;
+    for (int r = 0; r < 6; r++) {
+        ggml_tensor * t = (r & 1) ? g1 : g0;
+        std::vector<int32_t> ids = {0,1,2,3,4,5,6,7};
+        if (ggml_moe_direct_acquire(t, ids.data(), 8, 8) != 0) { check(false, "O10b. acquire 실패"); return; }
+        ggml_moe_direct_release(t, ids.data(), 8);
+        ggml_moe_direct_test_channel_event_state(&n_ch, &busy, &idle_sig, &wk, nullptr);
+        if (idle_sig > worst_idle_signaled) worst_idle_signaled = idle_sig;
+    }
+    uint64_t imm1 = 0, pend1 = 0;
+    ggml_moe_direct_test_read_stats(&imm1, &pend1);
+    printf("    (참고) 채널=%d busy=%d idle_signaled(최대)=%d · 완료 분기 immediate=%llu pending=%llu\n",
+           n_ch, busy, worst_idle_signaled,
+           (unsigned long long)(imm1 - imm0), (unsigned long long)(pend1 - pend0));
+    fflush(stdout);
+    check(n_ch == 8 && worst_idle_signaled == 0,
+          "O10b. ★terminal 처리 후 idle 채널 ev 전건 non-signaled(48건 회수 · idle_signaled 최대=" +
+          std::to_string(worst_idle_signaled) + ")");
+
+    // (b) 유휴 250ms 동안 dispatcher가 이벤트 대기에서 복귀하지 않아야 한다(공회전 0).
+    uint64_t wk_a = 0, wk_b = 0;
+    ggml_moe_direct_test_channel_event_state(nullptr, nullptr, nullptr, &wk_a, nullptr);
+    Sleep(250);
+    ggml_moe_direct_test_channel_event_state(&n_ch, &busy, &idle_sig, &wk_b, nullptr);
+    printf("    (참고) idle 250ms 대기 복귀 델타=%llu (hot-loop면 수만~수백만)\n",
+           (unsigned long long)(wk_b - wk_a));
+    fflush(stdout);
+    check((wk_b - wk_a) == 0 && busy == 0 && idle_sig == 0,
+          "O10c. ★유휴 250ms 동안 dispatcher 대기 복귀 0회(공회전 없음 · 델타=" +
+          std::to_string(wk_b - wk_a) + ")");
+
+    // ── (c) ★sync_done 분기 강제 행사(one-shot) — 이 검사만이 sync 분기의 ResetEvent를 잠근다.
+    //    강제 훅은 pending 제출 1건의 완료를 그 자리에서 기다린 뒤 sync_done 분기 코드를 그대로
+    //    통과시킨다(GetOverlappedResult→ResetEvent→busy=false→terminal). 그 ResetEvent를 지우면
+    //    해당 채널이 idle인데 signaled로 남아 아래 idle_signaled==0이 즉시 깨진다(회귀 가치).
+    uint64_t sync0 = 0, sync1 = 0, wk_c = 0;
+    ggml_moe_direct_test_channel_event_state(nullptr, nullptr, nullptr, nullptr, &sync0);
+    ggml_moe_direct_test_force_sync_next(1);
+    {
+        // ★유니크 miss가 정확히 1건인 배치를 쓴다(위 루프 마지막이 g1이라 g0는 전건 축출됨).
+        //   - hit 배치면 제출 자체가 없어 훅이 발화하지 않는다.
+        //   - miss가 여럿이면 강제 sync로 비운 채널을 **같은 pump 루프의 다음 제출이 재사용**하고,
+        //     io_submit_locked 진입부의 ResetEvent가 누락된 신호를 덮어써 결함이 가려진다.
+        //     제출 1건짜리 배치여야 그 채널이 idle인 채로 남아 불변식이 결함을 드러낸다.
+        int32_t one = 3;
+        if (ggml_moe_direct_acquire(g0, &one, 1, 1) != 0) { check(false, "O10d. 강제 sync 배치 acquire 실패"); return; }
+        ggml_moe_direct_release(g0, &one, 1);
+    }
+    ggml_moe_direct_test_channel_event_state(&n_ch, &busy, &idle_sig, &wk_c, &sync1);
+    printf("    (참고) 강제 sync 행사 — sync_terminal 델타=%llu busy=%d idle_signaled=%d\n",
+           (unsigned long long)(sync1 - sync0), busy, idle_sig);
+    fflush(stdout);
+    check((sync1 - sync0) >= 1 && busy == 0 && idle_sig == 0,
+          "O10d. ★sync_done 분기 실통과(hit 델타=" + std::to_string(sync1 - sync0) +
+          ") 후에도 idle 채널 ev non-signaled(idle_signaled=" + std::to_string(idle_sig) +
+          ") — ★sync 분기 ResetEvent 회귀 관문");
+
+    uint64_t wk_d = 0;
+    Sleep(250);
+    ggml_moe_direct_test_channel_event_state(&n_ch, &busy, &idle_sig, &wk_d, nullptr);
+    printf("    (참고) 강제 sync 후 idle 250ms 대기 복귀 델타=%llu\n", (unsigned long long)(wk_d - wk_c));
+    fflush(stdout);
+    check((wk_d - wk_c) == 0 && idle_sig == 0,
+          "O10e. ★sync terminal 이후에도 공회전 0(델타=" + std::to_string(wk_d - wk_c) + ")");
+}
