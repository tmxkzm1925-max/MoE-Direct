+// ── P19. ★metrics header 실파일 판독 — phaseb_mem 게이트 산술(OFF/ON) ──
+static void test_pb_header_gate() {
+    section("P19. ★metrics header 실파일 판독 — phaseb_mem 게이트 산술(§7.2 ⓐ~ⓓ) · OFF 확장 항 0");
+    auto read_header = [](const std::wstring & path) -> json {
+        std::ifstream ifs(path, std::ios::binary);
+        std::string line;
+        while (std::getline(ifs, line)) {
+            while (!line.empty() && (line.back()=='\r'||line.back()=='\n')) line.pop_back();
+            if (line.empty()) continue;
+            json j = json::parse(line, nullptr, false);
+            if (j.is_object() && j.value("type","") == "header") return j;
+        }
+        return json::object();
+    };
+    json hon, hoff;
+    {
+        Fixture fx; pb_setup_2layer(fx, "pb_hdr_on");
+        PbEnv env("4", "8", "2", "trace", nullptr, wide_to_utf8(fx.dir + L"\\metrics.jsonl").c_str());
+        if (fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0) {
+            ggml_moe_direct_finalize();
+            hon = read_header(fx.dir + L"\\metrics.jsonl");
+        }
+    }
+    {
+        Fixture fx; pb_setup_2layer(fx, "pb_hdr_off");
+        PbEnv env("4", nullptr, nullptr, "off", nullptr, wide_to_utf8(fx.dir + L"\\metrics.jsonl").c_str());
+        if (fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0) {
+            ggml_moe_direct_finalize();
+            hoff = read_header(fx.dir + L"\\metrics.jsonl");
+        }
+    }
+    static const char * kKeys[] = {
+        "slot_pool_bytes","control_q_slots","control_q_bytes","pending_table_bytes",
+        "pending_by_record_bytes","channel_bytes","dispatcher_stack_reserve_bytes","dispatcher_threads",
+        "capture_pool_slots","capture_slot_bytes","capture_pool_bytes","router_snapshot_bytes",
+        "norm_snapshot_bytes","router_norm_snapshot_bytes","intent_q_slots","intent_record_bytes",
+        "intent_q_bytes","predictor_threads","predictor_stack_reserve_bytes","predictor_worker_bytes",
+        "pb_buffer_cap_bytes",
+    };
+    bool keys_ok = hon.contains("phaseb_mem") && hoff.contains("phaseb_mem");
+    if (keys_ok) for (const char * k : kKeys)
+        if (!hon["phaseb_mem"].contains(k) || !hoff["phaseb_mem"].contains(k)) keys_ok = false;
+    check(keys_ok, "P19a. ★phaseb_mem 키 전건 존재(ON/OFF 양쪽 — §9 게이트 16 키 결손)");
+    if (!keys_ok) return;
+    const json & mon = hon["phaseb_mem"];
+    const json & mof = hoff["phaseb_mem"];
+    const uint64_t cslots = mon.value("capture_pool_slots", (uint64_t)0);
+    const uint64_t cbytes = mon.value("capture_slot_bytes", (uint64_t)0);
+    const uint64_t islots = mon.value("intent_q_slots", (uint64_t)0);
+    const uint64_t irec   = mon.value("intent_record_bytes", (uint64_t)0);
+    const uint64_t rt     = mon.value("router_snapshot_bytes", (uint64_t)0);
+    const uint64_t nm     = mon.value("norm_snapshot_bytes", (uint64_t)0);
+    const bool arith_ok =
+        mon.value("capture_pool_bytes", (uint64_t)0) == cslots * cbytes &&
+        mon.value("intent_q_bytes", (uint64_t)0)     == islots * irec &&
+        mon.value("router_norm_snapshot_bytes", (uint64_t)0) == rt + nm &&
+        mon.value("predictor_worker_bytes", (uint64_t)0) == mon.value("predictor_stack_reserve_bytes", (uint64_t)0) &&
+        cslots == 48 && islots == 48 && mon.value("predictor_threads", (uint64_t)0) == 1 &&
+        rt == (uint64_t)(2 - 1) * PB_TEST_N_EMBD * PB_TEST_N_EXPERT * sizeof(float) &&
