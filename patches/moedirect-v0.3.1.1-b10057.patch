+struct PbvStat {
+    int32_t  rec_active = 0, rec_inflight = 0, child_reserved = 0;
+    int32_t  cin_demand = 0, cin_prefetch = 0, parked = 0;
+    uint64_t defer_attempts = 0, drain_turns = 0;
+    void snap() {
+        ggml_moe_direct_test_pbv_stats(&rec_active, &rec_inflight, &child_reserved,
+                                       &cin_demand, &cin_prefetch,
+                                       &defer_attempts, &drain_turns, &parked);
+    }
+    std::string tag() const {
+        return "rec_active=" + std::to_string(rec_active) +
+               " rec_inflight=" + std::to_string(rec_inflight) +
+               " reserved=" + std::to_string(child_reserved) +
+               " child_d=" + std::to_string(cin_demand) +
+               " child_p=" + std::to_string(cin_prefetch) +
+               " defer=" + std::to_string((unsigned long long)defer_attempts) +
+               " drain=" + std::to_string((unsigned long long)drain_turns) +
+               " parked=" + std::to_string(parked);
+    }
+};
