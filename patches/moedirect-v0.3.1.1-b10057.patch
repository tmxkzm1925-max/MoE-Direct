+// ===========================================================================
+// V3b/V3c — mode=virtual 소비자 관문(원자 A1)
+//
+// 판정 규율: 네거티브는 "거부됐다"(rc<0)만으로 서지 않는다. **의도한 관문에서** 거부돼야
+// 그 거부 사유가 실제로 행사된 것이다 — 앞 관문이 우연히 잡아도 rc<0 은 같기 때문이다.
+// 그래서 매 케이스가 `ggml_moe_direct_test_v3_stage()`(통과 깊이 래치)를 함께 주장한다.
+//
+// ★A1 의 양성은 "seal 성공"이 아니라 "**전 관문 통과 후 A2 경계에서 명시적 거부**"다.
+//   소스 핸들·child 상태기계가 아직 없으므로 성공 반환은 반쯤 세운 소비자를 여는 것이 된다.
+// ===========================================================================
+
+struct V3Run {
+    bool     built = false;
+    int      rc    = 0;
+    int32_t  stage = -1;
+    std::string why;
+};
+
+static V3Run run_v3_seal(const std::string & tag, int32_t n_shards,
+                         const std::function<void(V3Fixture &)> & setup) {
+    V3Run out;
+    V3Fixture fx;
+    fx.dir   = make_case_dir(tag);
+    fx.model = default_v3_model(n_shards);
+    if (setup) setup(fx);
+    out.built = fx.build(out.why);
+    if (!out.built) return out;
+    std::vector<int32_t> ml;
+    ggml_moe_direct_model md = fx.model_desc(ml);
+    std::vector<ggml_moe_direct_source> sd = fx.source_descs();
+    const std::string dir_utf8 = wide_to_utf8(fx.dir);
+    out.rc = ggml_moe_direct_seal_for_test(dir_utf8.c_str(), &md, sd.data(), (int32_t)sd.size(),
+                                           fx.budget(), 64, fx.expects_u8.c_str(),
+                                           fx.ref_profile_id.c_str(), fx.ref_expect_sha256.c_str(), nullptr);
+    out.stage = ggml_moe_direct_test_v3_stage();   // ★reset 전에 읽는다(reset 이 래치를 지운다)
+    return out;
+}
+
+// manifest 1점 변형 네거티브. want_stage = 그 결함이 걸려야 하는 관문의 **직전** 통과 깊이.
+static void v3_neg_manifest(const std::string & tag, int32_t want_stage, const std::string & name,
+                            const std::function<void(json &)> & mutate, int32_t n_shards = 1) {
+    V3Run r = run_v3_seal(tag, n_shards, [&](V3Fixture & fx) { fx.mutate_manifest = mutate; });
+    check(r.built && r.rc != 0 && r.stage == want_stage,
+          name + " [rc=" + std::to_string(r.rc) + " stage=" + std::to_string(r.stage) + "/" +
+          std::to_string(want_stage) + (r.built ? "" : " ★픽스처 생성 실패: " + r.why) + "]");
+}
+
+// records[]/source_tensors[] 는 abs_offset 의 **사본**이다. live 대조(§2-5)를 단독으로 행사
+// 하려면 사본까지 함께 옮겨야 한다 — 안 옮기면 witness 재생성 대조(앞 관문)가 먼저 잡는다.
+static void v3_shift_abs_offset(json & m, uint64_t delta) {
+    auto & P = m["layout"]["layers"][0]["parts"][0];
+    const std::string stensor = P["source_tensor"].get<std::string>();
+    const std::string pname   = P["name"].get<std::string>();
+    const int32_t     layer   = m["layout"]["layers"][0]["layer"].get<int32_t>();
+    P["abs_offset"] = P["abs_offset"].get<uint64_t>() + delta;
+    for (auto & ST : m["source_tensors"])
+        if (ST["name"].get<std::string>() == stensor)
+            ST["abs_offset"] = ST["abs_offset"].get<uint64_t>() + delta;
+    for (auto & R : m["records"])
+        if (R["layer"].get<int32_t>() == layer && R["part"].get<std::string>() == pname)
+            R["src_offset"] = R["src_offset"].get<uint64_t>() + delta;
+}
