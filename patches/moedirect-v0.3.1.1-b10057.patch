index 0000000..f815b42
--- /dev/null
+++ b/ggml/include/ggml-moe-leadtime.h
@@ -0,0 +1,162 @@
+// MoE lead-time 계측 모듈 — 사양: bench/techdev/repack_space/PROBE_LEADTIME_SPEC_R1.md ★FROZEN v1.0
+//
+// 이 모듈은 "관측만" 한다. 캐시·플래너·PhaseA/PhaseB·IO3 의 어떤 상태도 읽거나 바꾸지 않으며,
+// 힌트 소비(프리페치 개입) 배선은 존재하지 않는다. 기본 OFF 에서 기존 거동은 완전 불변이다.
+//
+// 재는 것(사양 §1 — "host-visible exact-id lead"):
+//   T0 = ids 의 host 실체화 완료      → stamp A (2지점: A1=decode generic 동기 복사 직후 /
+//                                       A2=offload split 의 explicit ids D2H synchronize 직후)
+//   T1 = 그 층 첫 acquire 진입(pre-lock) → stamp B
+//   T2/T3(첫 child submit · burst 마지막 publish)는 **기존 IO3** 가 이미 낸다 — 이 모듈은
+//   T0·T1 두 축만 신설하고, 판독기가 IO3 와 boot_id·QPC 도메인으로 조인한다(사양 §2 join 계약).
+//
+// 왜 PhaseA 를 안 쓰는가(사양 §2 · COE 사실 4-ⓐ): PA timing 도 `phasea_on` 을 세우고,
+// `disp_can_plan_demand` 가 `phasea_on ∧ demand_outstanding>0` 이면 계획을 지연시킨다 —
+// 관측이 거동을 바꾼다. 이 모듈은 PA 와 완전히 독립된 게이트를 쓰고 PA 코드·의미론을
+// 한 줄도 건드리지 않는다.
+//
+// ★★hot-path 계약(사양 §2 — 위반은 이 프로브의 존재 이유를 무너뜨린다)
+//   ① 버퍼는 **arm 시점(=seal)에 전량 선할당**된 고정 폭 POD 링이다. A/B 는 **분리 버퍼**이며
+//      각자 원자 인덱스 예약(fetch_add)으로 칸을 잡는다 — mutex 교차 경합이 없다.
+//   ② hot hook 안에서 **문자열 포맷·파일 I/O·동적 할당·getenv·락 획득이 전부 0** 이다.
+//      그래서 env 해소는 hook 이 아니라 `ggml_moe_leadtime_note_seal()` 만 한다(아래 ★).
+//   ③ OFF 계약 = "QPC·registry·lock·allocation 0회 + 예측 가능한 fast-gate(캐시 bool) 1회".
+//      문자적 제로가 아니라 **검증 가능형**이다: `ggml_moe_leadtime_enabled()` 는 해소 여부와
+//      무관하게 원자 로드 1회로 끝나며(미해소 = false), 그 뒤 훅은 실행문 0 이다.
+//      ★훅은 `enabled()` 가 참일 때만 `stamp_*` 를 부르므로, 아래 publication 카운터의 비용은
+//      **게이트가 켜진 런에만** 든다(OFF 런의 훅 비용은 원자 로드 1회 그대로다).
+//
+// ★★★publication 계약(교차 r1 BLOCKER 폐합 — **불변식: torn/late 행은 `complete=1` 파일에
+//      실릴 수 없다**)
+//   무엇이 문제였나: 칸 예약(`next.fetch_add`)이 본문 memcpy **보다 먼저** 공개되므로, 그 사이에
+//   flush 가 `next` 를 record_count 로 삼으면 **아직 안 쓰인 칸**이 유효한 행으로 파일에 실린다.
+//   게다가 flush 가 게이트를 닫지 않으면 **flush 이후 도착한 스탬프**가 버퍼에만 남고
+//   `complete` 도 안 내려간다(요구된 관측이 조용히 사라진다).
+//   폐합 기제 — **진입/완료 카운터 쌍**:
+//     · 스탬프는 게이트 확인 **이전에** `w_enter` 를 올린다(순서가 계약이다 — "게이트를 통과했지만
+//       아직 예약하지 않은" 스레드가 drain 창 밖으로 빠져나가지 못하게 한다).
+//     · 본문 memcpy 를 마친 뒤 `w_exit` 를 **release** 로 올린다(스코프 소멸자 — 전 반환 경로).
+//     · flush 는 ①게이트를 **먼저 닫고**(신규 스탬프 차단) ②`w_enter == w_exit` 까지 대기
+//       (acquire — 이 시점에 기록된 전 본문이 flush 스레드에 가시적이다) ③그 뒤에야 record_count
+//       를 확정한다. 미완 예약이 남은 채 대기가 끝나면 **그 수만큼 dropped 계상 + `complete=0`**.
+//   ⇒ drain 이 성립한 파일의 모든 행은 **커밋 완료 행**이고, drain 이 실패한 파일은 `complete=0`
+//      이라 판독기가 fail-close 한다. 게이트 폐쇄 후 도착한 스탬프도 dropped + `complete=0` 로
+//      정직 처분된다(실 런타임에서 finalize 이후 스탬프는 도달 불가하지만 fail-loud 로 둔다).
+//
+// ★**env 해소 지점이 계약의 일부다**: `ggml_moe_leadtime_enabled()` 는 **절대 해소하지 않는다**
+//   (미해소 상태를 그냥 false 로 돌려준다). 해소·선할당은 `ggml_moe_leadtime_note_seal()` 과
+//   테스트 전용 리셋만 수행한다. 이렇게 두면 "첫 hook 진입이 VirtualAlloc 을 유발"하는 경로가
+//   **구조적으로 존재할 수 없다** — 사양의 "hot hook 내 동적 할당 금지"를 코드 형상으로 잠근다.
+//   대가: virtual seal 에 도달하지 않은 런은 env 를 켜도 무장되지 않는다(= 기록 0). 그 침묵을
+//   막기 위해 `ggml_moe_leadtime_flush()` 가 미해소 상태에서 진단 1줄을 남긴다(§flush 주석).
+//
+// Windows 전용: 비Windows 빌드에서는 전부 no-op 스텁으로 컴파일된다(Phase A·shadow 관례 동일).
+#pragma once
+
+#include "ggml.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ---------------------------------------------------------------------------
+// wire 상수 (.cpp 에서 static_assert 로 폭·오프셋을 동결한다)
+// ---------------------------------------------------------------------------
+#define GGML_MOE_LEADTIME_KIND_A      1     // `<prefix>_lead_a.lt` — T0 스탬프
+#define GGML_MOE_LEADTIME_KIND_B      2     // `<prefix>_lead_b.lt` — T1 스탬프
+#define GGML_MOE_LEADTIME_A_BYTES     64
+#define GGML_MOE_LEADTIME_B_BYTES     32
+#define GGML_MOE_LEADTIME_HDR_BYTES   128
+#define GGML_MOE_LEADTIME_NAME_BYTES  48    // 사양 §2 "tensor_name[<=48B 정확 복사]"
+
+// stamp A 채취 지점(wire 에 u8). 판독기는 A1=decode 경로 / A2=prefill 경로로 읽는다.
+#define GGML_MOE_LEADTIME_SITE_A1     1     // ggml-backend.cpp generic 동기 복사 직후
+#define GGML_MOE_LEADTIME_SITE_A2     2     // ggml-backend.cpp offload split explicit ids D2H 직후
+
+// stamp A flags(u8)
+#define GGML_MOE_LEADTIME_A_FLAG_NAME_TRUNCATED 0x01  // 원 이름 길이 > 48B(앞 48B 만 실렸다)
+#define GGML_MOE_LEADTIME_A_FLAG_NAME_NULL      0x02  // 이름 포인터가 NULL(있을 수 없는 입력의 정직 표시)
+
+// stamp B flags(u8)
+#define GGML_MOE_LEADTIME_B_FLAG_PREFILL        0x01  // n_tokens_hint > 1 (= Phase::PREFILL)
+
+// ---------------------------------------------------------------------------
+// ① 게이트 (env: `MOE_DIRECT_LEADTIME=1` · 그 외 = off + 경고 1회 · 미설정 = 조용한 off)
+//    `MOE_DIRECT_LEADTIME_OUT`     미설정 = 카운터만(파일 미생성 — LMTRACE 관례)
+//    `MOE_DIRECT_LEADTIME_MAX_MB`  기본 64 (A 3/4 · B 1/4 로 분할 선할당)
+// ---------------------------------------------------------------------------
+
+// ★hot-path 게이트. 원자 로드 1회 + 비교 1회. **해소하지 않는다**(미해소 = false).
+//   ★flush 가 게이트를 닫은 뒤에도 false 다(publication 계약 ① — 폐쇄 = 신규 스탬프 차단).
+GGML_API bool ggml_moe_leadtime_enabled(void);
+
+// 관측 시계 — 이 프로브의 모든 QPC 는 여기서 나온다(raw QueryPerformanceCounter · 게이트 무관).
+// 호출측은 `enabled()` 가 참일 때만 부른다(OFF 계약의 "QPC 0회"가 그렇게 성립한다).
+GGML_API uint64_t ggml_moe_leadtime_now_qpc(void);
+
+// 조인 키. IO3 가 무장돼 있으면 `note_seal` 이 그 boot_id 를 그대로 채택한다(= 같은 값).
+// 미무장이면 0. ★flush 로 게이트가 닫힌 뒤에도 값이 유지된다(사후 대조용 — 게이트 상태가 아니라
+// "이 런이 무장됐었나"를 뜻하는 값이다).
+GGML_API uint64_t ggml_moe_leadtime_boot_id(void);
+
+// ---------------------------------------------------------------------------
+// ② arm — env 해소 + 버퍼 전량 선할당 + 조인 키 채택. seal 경로가 1회 부른다.
+//    ★IO3 의 boot_id 해소 **뒤**에 불러야 조인 키를 그대로 채택할 수 있다.
+//      join_boot_id == 0 이면 자체 생성값을 쓰며, 그 경우 IO3 조인은 성립하지 않는다
+//      (판독기 fail-close — 의도된 침묵 금지이므로 경고 1줄을 남긴다).
+//    engine_mode: 1=bin 2=virtual (헤더 echo · 진단용) · n_expert/n_moe_layers 도 echo.
+//    멱등: 두 번째 호출은 계수만 로그하고 상태를 바꾸지 않는다.
+// ---------------------------------------------------------------------------
+GGML_API void ggml_moe_leadtime_note_seal(uint64_t join_boot_id, uint32_t engine_mode,
+                                          uint32_t n_expert, uint32_t n_moe_layers);
+
+// ---------------------------------------------------------------------------
+// ③ hot hook — 게이트가 참일 때만 호출된다. 락·할당·포맷 0.
+// ---------------------------------------------------------------------------
+
+// stamp A: ids 의 host 실체화 시각. site = GGML_MOE_LEADTIME_SITE_A1|A2.
+// tensor_name 은 호출 시점에 **정확 복사**된다(<=48B · 초과분은 절단 + 플래그).
+// 판독기는 `^ffn_moe_topk-(\d+)$` 정확 매칭으로 대상 층을 고르고, 비대상 이름 행은 배제한다
+// (사양 §2 NIT — 엔진은 필터하지 않는다. 필터를 엔진에 두면 이름 규칙 변경이 조용한 결손이 된다).
+GGML_API void ggml_moe_leadtime_stamp_a(int32_t site, uint64_t qpc, const char * tensor_name);
+
+// stamp B: 그 층 acquire 의 pre-lock 진입 시각 + registry 해소값.
+// qpc 는 **호출측이 진입부에서 미리 채취한 값**을 그대로 싣는다(락 대기·registry 조회 시간이
+// T1 에 섞이지 않게 하는 것이 사양 §1 의 "pre-lock" 의미다).
+GGML_API void ggml_moe_leadtime_stamp_b(uint64_t qpc, int32_t mlpos, int32_t part_idx,
+                                        int32_t n_ids, int32_t is_prefill);
+
+// ---------------------------------------------------------------------------
+// ④ flush — 사이드카 기록(멱등·once 래치). `ggml_moe_direct_finalize()` 가 dispatcher drain 과
+//    IO3 flush **뒤**에 1회 호출한다(같은 boot_id 를 쓰므로 IO3 가 먼저 닫혀 있어야 한다).
+//    drop 이 한 건이라도 있으면 헤더 `complete=0` 으로 정직하게 강하한다(사양 §4b: lead 지표는
+//    분포 자체가 산출물이라 결손 비허용 — 판독기가 fail-close 한다).
+//    ★미해소(=무장 실패) 상태에서는 여기서만 env 를 진단 목적으로 1회 들여다보고, `=1` 이었으면
+//      "켰는데 무장되지 않았다"를 1줄 남긴다. finalize 는 hot path 가 아니므로 계약 위반이 아니다.
+// ---------------------------------------------------------------------------
+GGML_API void ggml_moe_leadtime_flush(void);
+
+// ===========================================================================
+// 시나리오 teardown — 전역 상태·버퍼 해제 + env 재해소 가능 상태로 되돌린다.
+// ★이것만 공개 헤더에 남긴다: `ggml_moe_direct_reset_for_test()`(다른 TU)가 부르고, 회계를
+//   어긋나게 만드는 시임이 아니라 순수 teardown 이며, `ggml_moe_phaseb_reset_for_test` ·
+//   `ggml_moe_shadow_reset_for_test` 가 이미 같은 자리에 있는 선례를 따른다.
+GGML_API void ggml_moe_leadtime_reset_for_test(void);
+
+// ===========================================================================
+// ★관측 창구와 **시임**은 **이 공개 헤더에 없다**(교차 r2 R3-4 폐합).
+//   위치 = `ggml/src/ggml-moe-leadtime-internal.h`(설치·배포 대상이 아닌 내부 헤더).
+//   이유: `test_stall_writer` 류는 publication 회계를 임의로 어긋나게 만들 수 있는 시임이라
+//   **생산 API 표면에 광고되면 안 된다**. selftest 는 그 내부 헤더를 상대경로로 include 해
+//   접근한다(같은 트리의 `ggml-backend-impl.h` 접근 관례와 동일).
+//   ★정직 고지: 심볼 자체는 공유 DLL 구조상 여전히 export 된다(selftest 가 별 프로세스로
+//   `ggml-base.dll` 에 링크하므로 export 없이는 링크가 불가능하다). 이 수리가 없애는 것은
+//   **공개 헤더 표면**이며, ABI 표면까지 없애려면 테스트 전용 별도 DLL 빌드가 필요하다.
+// ===========================================================================
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/include/ggml-moe-lmtrace.h b/ggml/include/ggml-moe-lmtrace.h
new file mode 100644
index 0000000..bef62ca
--- /dev/null
+++ b/ggml/include/ggml-moe-lmtrace.h
@@ -0,0 +1,257 @@
+// MoE-Direct 레버 A 단계 1 — layer-major 관측 모듈(LMTRACE). **관측 전용·기본 OFF.**
+//
+// 사양: SUPERBATCH_DESIGN.md v0.3 §3(a) 계측 · §5 G-L0 구조 게이트 ·
+//       reviews/codex_techdev_speed_r11.md §⑤ 발주문 S0 절.
+//
+// 이 모듈은 아무 것도 바꾸지 않는다 — 그래프 형상·backend 배치·split 경계·커널 결정·출력 토큰
+// 중 어느 것도 건드리지 않고 "이미 확정된 스케줄"을 읽어 지문만 남긴다. 그래서 ggml_backend_sched
+// 의 eval callback(=split 을 graph view 로 재분할해 실행 형상을 바꾼다)은 **쓰지 않는다**.
+//
+// 기능 두 가지:
+//   (A) graph/sched 시그니처 — 실행 직전의 ordered node(op/type/shape/stride/버퍼 사용)·split
+//       경계·split별 backend 를 결정론 직렬화(길이 프레이밍)해 sidecar 에 적고 SHA-256 을 남긴다.
+//       ★관측 범위는 **스케줄러 수준까지**다. CUDA 내부 fusion/커널 선택은 stock DLL 에서
+//         관측 불가(근거는 아래 "CUDA 관측 한계" 절) — G-L0 문구와의 갭은 보고서에 표면화한다.
+//   (B) request-level 카운터 — 프리필 요청 단위 graph_build/sched_alloc/submit_sync/boundary_copy
+//       분해 시간 + 세그먼트 수 + experts 읽기 바이트(기존 direct 카운터의 스냅샷 델타).
+//
+// ★CUDA 관측 한계(1차 소스 조사 결과 — 시공 보고서와 세트):
+//   ggml-cuda.cu 의 fusion 보고 경로(nodes_fused 로그)는 전부 `#ifdef GGML_CUDA_DEBUG` 이고 그
+//   정의는 ggml/src/ggml-cuda/CMakeLists.txt 의 GGML_CUDA_DEBUG 옵션에서만 켜진다 — 배포 DLL 엔
+//   없다. 노출 export 도 11개뿐이라 in-process 조회 API 가 없다. 따라서 이 모듈이 남기는 것은
+//   **sched 수준 시그니처**이며, fusion 동일성은 별도 논거(동일 DLL·동일 그래프 형상)로만 말할 수
+//   있다. 그 논거의 한계(fusion 이 버퍼 배치·포인터 겹침·CUDA graph capture 상태에도 의존)는
+//   보고서 §설계 결정에 기록했다.
+//
+// 환경 변수(전부 기본 OFF):
+//   MOE_DIRECT_LMTRACE=1        모듈 활성(최초 사용 시 1회 캐시)
+//   MOE_DIRECT_LMTRACE_OUT=<접두사>   sidecar 경로 접두사. **미설정이면 파일을 만들지 않는다**
+//                               (카운터·digest 만 메모리 유지). 산출물 3종:
+//                               <접두사>.lmt    — 바이너리 레코드(길이 프레이밍)
+//                               <접두사>.lmtidx — 레코드별 한 줄:
+//                                 `seq= uid= nodes= leafs= splits= externs= bytes= sha256=`
+//                                 (★externs 는 G-L0 fail-close 조건 — R13 ③8·④7)
+//                               <접두사>.lmtreq — 요청 단위 카운터 JSON lines. 키:
+//                                 req_seq·status·segments·prefill_tokens·graph_build_ms·
+//                                 sched_alloc_ms·submit_host_ms·sync_ms·boundary_copy_ms·
+//                                 experts_read_bytes·experts_hit·experts_miss·graph_records·
+//                                 graph_chain_sha256
+//   MOE_DIRECT_LMTRACE_MAX_MB=<n>   sidecar 바이너리 상한(기본 512). 초과분은 드롭 카운트만 증가.
+//
+// ★기존 metrics jsonl(MOE_DIRECT_METRICS)은 건드리지 않는다 — 소비자 중 하나가 header/summary
+//   사이의 interior 레코드 type 을 "periodic 만"으로 강제 검사하므로(bench/g3_2bm_killscreen.py)
+//   신규 type 주입은 기존 게이트를 깨뜨린다. 그래서 전용 sidecar 로 분리했다.
+//
+// Windows 전용: 비Windows 빌드에서는 ggml-moe-lmtrace.cpp 가 전부 no-op 스텁으로 컴파일된다.
+#pragma once
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ---------------------------------------------------------------------------
+// 상수
+// ---------------------------------------------------------------------------
+
+// sidecar 바이너리 레코드 헤더 magic / layout version.
+#define MOE_LMTRACE_MAGIC          "MOELMT1"
+#define MOE_LMTRACE_LAYOUT_VERSION 1u
+
+// 레코드 종류.
+enum {
+    MOE_LMTRACE_KIND_GRAPH_SIGNATURE = 1,
+};
+
+// ---------------------------------------------------------------------------
+// ★S2 range 태그 (하위 호환 layout — SPEC_S2_RANGEGRAPH §5 ⓐ)
+// ---------------------------------------------------------------------------
+// S2 층-우선 프리필은 한 llama_decode 안에서 `for R(층 구간): for ub` 순회로 **(range, ub)마다
+// 별도 그래프**를 실행한다. 판독기가 그 다중 레코드를 "ub당 논리 그래프 1개"로 재조립하려면
+// 레코드에 (decode_call/range/ub/il 구간/경계 역할) 이 실려야 한다.
+//
+// ★하위 호환 규약(필수 — S0 baseline v1 파일이 계속 판독돼야 G-L0 비교가 성립한다):
+//   `layout_version` 은 **1 그대로 둔다**. 대신 기존 헤더의 `reserved` u32 를 `tag_flags` 로
+//   의미 부여한다 — 0 이면 태그 블록 없음(= 구 레이아웃과 **바이트 동일**), 1 이면 헤더 직후
+//   (n_backends 다음) 에 아래 고정 48바이트 블록이 온다. 그래서
+//     · S0 baseline 파일           → tag_flags=0 → 구 파서 경로 그대로
+//     · S2 legacy(비 admission) 레코드 → tag_flags=0 → baseline 과 1:1 바이트 비교 가능
+//     · S2 range 레코드             → tag_flags=1 → 재조립 대상
+//   `tag_bytes` 는 블록 총 바이트(이 필드 포함)이며, 판독기는 48 초과분을 skip 해 전방 호환한다.
+//
+//   레이아웃(little-endian):
+//     u32 tag_bytes      = MOE_LMTRACE_TAG_BYTES (48)
+//     u32 tag_version    = MOE_LMTRACE_TAG_VERSION (1)
+//     u64 decode_call    프로세스 전역 단조 증가 — layer-major admission 을 통과한 decode 호출 번호
+//     u32 range_idx      0..n_ranges-1
+//     u32 n_ranges
+//     u32 ub_idx         0..n_ubatch-1
+//     u32 n_ubatch       = K
+//     i32 il_start
+//     i32 il_end         (exclusive)
+//     u32 boundary_role  bit0=bank 입력 leaf 소비 · bit1=경계 CPY 출력 생성
+//     u32 mode           = 1 (layer-major range)
+#define MOE_LMTRACE_TAG_FLAG_NONE  0u
+#define MOE_LMTRACE_TAG_FLAG_RANGE 1u
+#define MOE_LMTRACE_TAG_VERSION    1u
+#define MOE_LMTRACE_TAG_BYTES      48u
+
+enum {
+    GGML_MOE_LMTRACE_BOUNDARY_ROLE_NONE = 0,
+    GGML_MOE_LMTRACE_BOUNDARY_ROLE_IN   = 1,   // bank 슬라이스를 입력 leaf 로 소비
+    GGML_MOE_LMTRACE_BOUNDARY_ROLE_OUT  = 2,   // 경계 CPY 로 bank 슬라이스에 기록
+};
+
+enum {
+    GGML_MOE_LMTRACE_MODE_LEGACY = 0,
+    GGML_MOE_LMTRACE_MODE_RANGE  = 1,
+};
+
+// (B) 요청 단위 고정비 분해 스테이지 — R11 §M-1 의 build/alloc/submit/sync **4분리**.
+//   ★submit 과 sync 는 반드시 분리한다(R13 ③4 지적): `llama_context::graph_compute()` 는
+//     `ggml_backend_sched_graph_compute_async()` 만 호출하므로 그 둘레는 **host 측 제출 시간**일
+//     뿐이고, 실제 device 대기는 `llama_context::synchronize()` 안의
+//     `ggml_backend_sched_synchronize()` 에서 발생한다. 합쳐 두면 이름과 달리 sync 가 빠진 값이다.
+//   boundary_copy 는 S0 에서 **배선만**(현재 경로엔 호출자가 없어 항상 0) — 층 경계 F32 CPY 가
+//   생기는 S2 에서 채워진다.
+//   ★S2 에서의 정확한 의미(SPEC §5 ⓑ · r28 수정문안 7): 경계 CPY 는 range 그래프에 **융합된
+//     노드**라 host 제출 단위로 분리되지 않는다. 따라서 `boundary_copy_ms` 는 **경계 CPY 를
+//     포함한 range 그래프의 host-submit 시간 상계**이며 CPY 단독 시간도, device 시간도 아니다
+//     (device 분리는 G-P2 계측 소관). S2 가 정확히 책임지는 값은 아래 bytes/count 다.
+enum {
+    GGML_MOE_LMTRACE_STAGE_GRAPH_BUILD   = 0,
+    GGML_MOE_LMTRACE_STAGE_SCHED_ALLOC   = 1,
+    GGML_MOE_LMTRACE_STAGE_SUBMIT_HOST   = 2,  // graph_compute() 둘레 = async 제출까지(호스트)
+    GGML_MOE_LMTRACE_STAGE_SYNC          = 3,  // ggml_backend_sched_synchronize() 둘레 = device 대기
+    GGML_MOE_LMTRACE_STAGE_BOUNDARY_COPY = 4,
+    GGML_MOE_LMTRACE_STAGE_COUNT         = 5,
+};
+
+// 요청 폐합 사유 — `.lmtreq` 의 "status" 값.
+#define MOE_LMTRACE_STATUS_DECODE  "decode"   // 첫 decode graph 진입으로 자연 폐합
+#define MOE_LMTRACE_STATUS_REOPEN  "reopen"   // 다음 프리필 요청이 열리며 폐합(순수 프리필 요청)
+#define MOE_LMTRACE_STATUS_FINISH  "finish"   // 명시 폐합(컨텍스트 소멸 등)
+#define MOE_LMTRACE_STATUS_ABORT   "abort"    // 실패 경로 폐합(다음 요청과 합쳐지지 않게 상태 리셋)
+
+// ---------------------------------------------------------------------------
+// 게이트
+// ---------------------------------------------------------------------------
+
+// env MOE_DIRECT_LMTRACE=1 이면 true(최초 호출 시 1회 캐시). false 면 이 모듈의 모든 경로가
+// 비활성이며, 침습 지점은 이 함수 하나만 평가하고 아무 일도 하지 않는다.
+GGML_API bool ggml_moe_lmtrace_enabled(void);
+
+// ---------------------------------------------------------------------------
+// (A) graph/sched 시그니처
+// ---------------------------------------------------------------------------
+
+// split 경계 기술자 — ggml_backend_sched_split 은 ggml-backend.cpp 파일 전용 타입이라 훅 지점에서
+// 이 POD 로 옮겨 넘긴다(스케줄러 내부 구조를 헤더로 노출하지 않기 위함).
+struct ggml_moe_lmtrace_split_desc {
+    int32_t backend_id;
+    int32_t i_start;
+    int32_t i_end;
+    int32_t n_inputs;
+};
+
+// 스케줄 확정 이후·커널 발행 이전에 1회 호출한다(호출자가 게이트를 먼저 확인해야 한다).
+//   graph            : 스케줄러가 조립한 실행 그래프(주입된 input_dep/input_cpy 포함)
+//   node_backend_ids : [graph->n_nodes] — graph->nodes 와 인덱스 정렬
+//   leaf_backend_ids : [graph->n_leafs] — graph->leafs 와 인덱스 정렬
+//   backends         : [n_backends] — NULL 원소 허용(이름은 빈 문자열로 기록)
+//   splits           : [n_splits]
+// 포인터 값(data/extra)·할당 주소는 기록하지 않는다(할당자 배치는 정체성 계약의 대상이 아니다).
+GGML_API void ggml_moe_lmtrace_graph_capture(
+        const struct ggml_cgraph                   * graph,
+        const int32_t                              * node_backend_ids,
+        const int32_t                              * leaf_backend_ids,
+        int32_t                                      n_backends,
+        ggml_backend_t                             * backends,
+        int32_t                                      n_splits,
+        const struct ggml_moe_lmtrace_split_desc   * splits);
+
+// ---------------------------------------------------------------------------
+// (B) request-level 카운터
+// ---------------------------------------------------------------------------
+
+// graph 실행 1건의 경계 통지(계산 시작 전). 요청 상태기계는 여기서만 전이한다:
+//   prefill graph 가 prefill 상태 밖에서 오면 = 새 요청 개시(이전 요청은 폐합·기록)
+//   decode  graph 가 prefill 상태에서 오면  = 현 요청 폐합·기록
+// 세그먼트 수 = 한 요청에 속한 prefill graph 실행 횟수.
+GGML_API void ggml_moe_lmtrace_graph_boundary(int32_t is_prefill, int32_t n_tokens);
+
+// 고정비 스테이지 구간 계측(중첩 없음 — 같은 stage 를 겹쳐 열지 않는다).
+GGML_API void ggml_moe_lmtrace_stage_enter(int32_t stage);
+GGML_API void ggml_moe_lmtrace_stage_leave(int32_t stage);
+
+// ★S2 — 다음 graph_capture 에 실릴 range 태그를 설정/해제한다(설정 후 capture 1건에만 적용되는
+// 것이 아니라, clear 될 때까지 유지된다 — 드라이버가 (range,ub) 마다 set 하고 구간을 벗어날 때
+// clear 한다). 게이트 OFF 면 무동작. 스레드 간 공유 상태이므로 v1 단일 활성 요청 전제(SPEC §1)
+// 하에서만 의미가 있다.
+GGML_API void ggml_moe_lmtrace_range_tag_set(uint64_t decode_call,
+                                             int32_t  range_idx, int32_t n_ranges,
+                                             int32_t  ub_idx,    int32_t n_ubatch,
+                                             int32_t  il_start,  int32_t il_end,
+                                             int32_t  boundary_role);
+GGML_API void ggml_moe_lmtrace_range_tag_clear(void);
+
+// ★S2 — 층-우선 프리필 진입 통지. `graph_boundary` 와 달리 **한 llama_decode 진입당 1회만**
+// 부르며 tokens/phase 를 그때 적산한다(SPEC §5 ⓑ: range compute 는 segment 만 늘린다).
+// 이후 각 (range,ub) compute 는 `ggml_moe_lmtrace_range_segment()` 로 세그먼트만 증가시킨다.
+GGML_API void ggml_moe_lmtrace_request_prefill_enter(int32_t n_tokens);
+GGML_API void ggml_moe_lmtrace_range_segment(void);
+
+// ★S2 — 경계 CPY 회계(정확값). count = 이번 range 그래프가 만든 경계 CPY 개수(0 또는 1),
+// bytes = 그 CPY 가 옮기는 바이트. 요청 폐합 시 `.lmtreq` 의 boundary_copy_bytes/
+// boundary_copy_count 로 나간다.
+GGML_API void ggml_moe_lmtrace_boundary_copy_note(uint64_t bytes, uint64_t count);
+
+// 경계 CPY 회계 조회(판독·selftest 전용 — 현재 열린 요청의 누적값).
+GGML_API void ggml_moe_lmtrace_boundary_copy_counters(uint64_t * bytes, uint64_t * count);
+
+// 열려 있는 요청을 즉시 정상 폐합·기록한다(status="finish"). 열린 요청이 없으면 무동작.
+// 생산 호출자 = llama_context 소멸자 — decode 없이 끝난 순수 프리필 요청의 레코드가 유실되지
+// 않게 한다.
+GGML_API void ggml_moe_lmtrace_request_finish(void);
+
+// ★실패 경로 폐합(status="abort"). 열린 요청을 기록한 뒤 **상태기계를 idle 로 되돌린다** —
+// 이것이 없으면 실패 이후의 다음 프리필이 `phase_state==prefill` 인 채로 도착해 **이전 요청과
+// 같은 요청으로 합쳐진다**(R13 ③4 가 지적한 REACHABLE 결함). 생산 호출자 =
+// llama_context::process_ubatch() 의 실패 조기 반환 4지점.
+GGML_API void ggml_moe_lmtrace_request_abort(void);
+
+// ---------------------------------------------------------------------------
+// 조회(판독·selftest 전용)
+// ---------------------------------------------------------------------------
+
+// ★도달성 앵커. NULL 인자는 건너뛴다.
+//   probe_calls    : ggml_moe_lmtrace_graph_capture 진입 횟수(게이트 **이전**에 증가).
+//                    프로덕션 OFF 에서는 호출자가 게이트로 막으므로 0 이어야 한다.
+//   records        : 게이트를 통과해 실제로 직렬화된 레코드 수. OFF 면 0(신규 경로 미진입 증명).
+//   dropped        : 상한 초과로 버린 레코드 수.
+//   bytes          : 직렬화한 누적 바이트.
+//   requests       : 폐합·기록된 요청 수.
+GGML_API void ggml_moe_lmtrace_counters(uint64_t * probe_calls,
+                                        uint64_t * records,
+                                        uint64_t * dropped,
+                                        uint64_t * bytes,
+                                        uint64_t * requests);
+
+// 마지막 레코드의 SHA-256(소문자 hex, NUL 종료). 65바이트 이상 필요. 성공=0, 버퍼 부족=-1.
+GGML_API int ggml_moe_lmtrace_last_digest(char * out, int32_t cap);
+
+// 지금까지의 레코드 전체를 순서대로 묶은 연쇄 SHA-256(chain = SHA256(prev_hex || rec_hex)).
+// 한 런 전체의 graph 시그니처를 값 하나로 비교할 때 쓴다. 성공=0, 버퍼 부족=-1.
+GGML_API int ggml_moe_lmtrace_chain_digest(char * out, int32_t cap);
+
+// selftest 전용 — env 재해석 + 카운터/digest 초기화 + sidecar 핸들 닫기. 프로덕션 호출 금지.
+GGML_API void ggml_moe_lmtrace_test_reset(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/include/ggml-moe-phasea.h b/ggml/include/ggml-moe-phasea.h
new file mode 100644
index 0000000..45c7a21
--- /dev/null
+++ b/ggml/include/ggml-moe-phasea.h
@@ -0,0 +1,159 @@
+// MoE 프리페치 Phase A — 무행동 계측 모듈(관측 전용: 출력·캐시·읽기 무변경).
+//
+// 사양 권위: bench/moe-direct/PREFETCH_DESIGN.md §3(★FROZEN v1 · 하드 동결 §3.1~3.5)
+// wire 계약: bench/moe-direct/SPEC_PHASEA_WIRE.md (필드 단위 확정 — 후속 러너/replay 인터페이스)
+//
+// 이 모듈은 ggml-base에 포함되어 exported C ABI로 노출된다. 소비자는 셋:
+//   ① ggml/src/ggml-moe-direct.cpp  — acquire/release/pump 훅(캐시 mutation ledger·A2·A3·ops)
+//   ② src/llama-context.cpp          — graph 경계·가중치 스냅샷·eval callback 설치(accuracy)
+//   ③ tools/server/server-context.cpp— 요청(run) 경계
+//
+// ★★ 동시성 계약(중요) ★★
+//   이 모듈은 **자체 뮤텍스를 두지 않는다.** 전 진입점이 아래 둘 중 하나이기 때문이다:
+//     (a) ggml_moe_direct_acquire/release 내부 — 호출자가 g_mod.mutex를 보유하며, acquire 자체가
+//         "단일 스레드 호출 전제"(ggml-moe-direct.h) 이므로 직렬화된다.
+//     (b) graph/run 경계·flush — llama_decode를 부르는 단일 스레드에서만 실행되며, 그 시점에는
+//         (a)가 진행 중일 수 없다(graph_begin < graph_compute < graph_end 순서).
+//   자체 뮤텍스를 두면 (a)에서 direct→pa, flush에서 pa→direct 순으로 락 순서가 역전된다.
+//   ★새 호출부를 추가할 때 이 전제를 반드시 재확인할 것.
+//
+// Windows 전용 — 비Windows는 전부 no-op 스텁으로 컴파일된다.
+#pragma once
+
+#include "ggml.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ---------------------------------------------------------------------------
+// 모드 (env MOE_DIRECT_PHASEA — off[기본] / accuracy / timing)
+// ---------------------------------------------------------------------------
+#define GGML_MOE_PHASEA_OFF      0
+#define GGML_MOE_PHASEA_ACCURACY 1
+#define GGML_MOE_PHASEA_TIMING   2
+
+// 최초 호출 시 env를 해소해 캐시한다(테스트는 ggml_moe_phasea_reset_for_test()로 재해소).
+GGML_API int32_t      ggml_moe_phasea_mode(void);
+GGML_API bool         ggml_moe_phasea_enabled(void);      // mode != off
+GGML_API const char * ggml_moe_phasea_mode_name(void);    // "off"/"accuracy"/"timing"
+GGML_API uint64_t     ggml_moe_phasea_boot_id(void);      // 사이드카↔metrics 조인 키
+GGML_API const char * ggml_moe_phasea_out_prefix(void);   // MOE_DIRECT_PHASEA_OUT 원값("" 가능)
+GGML_API uint32_t     ggml_moe_phasea_buf_mb(void);       // 버퍼 상한(MiB)
+GGML_API bool         ggml_moe_phasea_eval_callback_installed(void);
+GGML_API uint64_t     ggml_moe_phasea_now_qpc(void);      // QueryPerformanceCounter 원값(off여도 유효)
+
+// ---------------------------------------------------------------------------
+// seal 통지 (ggml-moe-direct.cpp seal 성공 말미) — 모델 상수 + arm 시작 슬롯 상태 확정
+//   layer_stride_bytes[i] = moe_layers[i] 층의 record stride(=1 record 읽기 바이트)
+// ---------------------------------------------------------------------------
+GGML_API void ggml_moe_phasea_note_seal(
+    int32_t n_expert, int32_t n_expert_used, int32_t n_moe_layers, int32_t n_slots,
+    const int32_t * moe_layers, const uint64_t * layer_stride_bytes);
+
+// ---------------------------------------------------------------------------
+// 요청(run) 경계 — tools/server/server-context.cpp
+// ---------------------------------------------------------------------------
+GGML_API void ggml_moe_phasea_run_begin(void);
+GGML_API void ggml_moe_phasea_run_end(uint32_t predicted_n, uint32_t prompt_n);
+
+// ---------------------------------------------------------------------------
+// graph 경계 — src/llama-context.cpp (phase: 0=decode 1=prefill, ubatch.n_tokens 원값 기준)
+//   graph_end는 무행동 증명용 형상(n_nodes/n_splits)을 함께 넘긴다.
+// ---------------------------------------------------------------------------
+// ★r1 차단 1 수리 — 섬도 트리거가 쉼 수 있는 **coherent identity 스냅샷**.
+//   두 개의 독립 getter 로 나누면 그 사이에 graph 경계가 끊길 수 있어 한 번에 읽는다.
+//   갱신 조건 = `phase=decode ∧ n_tokens=1 ∧ n_outputs=1` graph 가 **끝났을 때**만.
+//   run begin/end 에서 무효화된다(요청 경계를 넘는 재사용 금지).
+struct ggml_moe_phasea_ident {
+    int32_t  valid;            // 0 = 쓸 수 없음(트리거 금지)
+    uint32_t request_index;
+    uint32_t graph_seq;
+    uint32_t decode_ordinal;   // 이 요청 안에서의 0-based decode 순번
+};
+GGML_API void ggml_moe_phasea_identity(struct ggml_moe_phasea_ident * out);
+
+// 이 graph 의 확정 출력 행 수를 PA 에 알린다(graph_begin 직후 호출).
+GGML_API void ggml_moe_phasea_note_outputs(int32_t n_outputs);
+
+GGML_API void ggml_moe_phasea_graph_begin(uint8_t phase, uint32_t n_tokens);
+GGML_API void ggml_moe_phasea_graph_end  (int32_t n_nodes, int32_t n_splits);
+
+// ---------------------------------------------------------------------------
+// accuracy 모드 가중치 host 스냅샷 — src/llama-context.cpp (모델 로드 후 1회·멱등)
+//   router      = blk.<l>.ffn_gate_inp.weight        [n_embd, n_expert] F32
+//   post_norm   = blk.<l>.post_attention_norm.weight [n_embd]           F32
+//   ★target layer 1..n_layer_exec-1 만 필요(전이 l→l+1 · NextN 층 제외).
+//   반환 0=성공(또는 무동작), <0=실패(타입/차원 불일치 등 — 호출측은 로그만).
+// ---------------------------------------------------------------------------
+GGML_API int  ggml_moe_phasea_snapshot_configure(int32_t n_layer_exec, int32_t n_embd,
+                                                 int32_t n_expert, int32_t n_expert_used,
+                                                 float rms_eps);
+GGML_API bool ggml_moe_phasea_snapshot_needed(void);   // accuracy && 아직 미완료
+GGML_API int  ggml_moe_phasea_snapshot_layer(int32_t target_layer,
+                                             const struct ggml_tensor * router,
+                                             const struct ggml_tensor * post_norm);
+GGML_API int  ggml_moe_phasea_snapshot_seal(void);     // 전 층 채워졌는지 검사 + 확정
+GGML_API uint64_t ggml_moe_phasea_snapshot_bytes(void);
+
+// eval callback — accuracy 모드에서 llama_context가 sched에 설치한다(timing/off는 설치 금지).
+GGML_API bool ggml_moe_phasea_eval_callback(struct ggml_tensor * t, bool ask, void * user_data);
+GGML_API void ggml_moe_phasea_note_eval_callback_installed(void);
+
+// ---------------------------------------------------------------------------
+// ggml-moe-direct.cpp 전용 훅 (전부 g_mod.mutex 보유 상태에서 호출)
+// ---------------------------------------------------------------------------
+
+// acquire 진입. t_enter_qpc는 **락 취득 이전**에 채취한 값(D_j).
+// out_is_canonical: 이 (graph, layer) 조합의 첫 acquire면 1.
+GGML_API void ggml_moe_phasea_acquire_enter(int32_t mlpos, int32_t part, int32_t n_ids,
+                                            const int32_t * expert_ids, int32_t is_prefill,
+                                            uint64_t t_enter_qpc, int32_t * out_is_canonical);
+
+// claim에서 victim이 기존 owner를 갖고 있었을 때(축출 발생) 1건.
+GGML_API void ggml_moe_phasea_acquire_evict(int32_t slot, int64_t evicted_record_idx,
+                                            int32_t new_expert);
+
+// 요청 인덱스 순서대로 n_ids회 호출(hit/miss·slot·논리 tick).
+GGML_API void ggml_moe_phasea_acquire_expert(int32_t expert, int32_t is_hit, int32_t slot,
+                                             uint64_t logical_tick);
+
+// 배치 pump 중 outstanding 수가 바뀔 때마다(제출 버스트 후 / 회수 후) 호출 — Q_j 적분.
+GGML_API void ggml_moe_phasea_io_qd(int32_t n_outstanding, uint64_t t_qpc);
+
+// demand read op 1건 회수 확정 시(publish 직전).
+GGML_API void ggml_moe_phasea_io_op(int64_t record_idx, uint64_t file_offset, uint32_t bytes,
+                                    int32_t slot, uint32_t batch_order,
+                                    uint64_t submit_seq, uint64_t submit_qpc,
+                                    uint64_t retire_seq, uint64_t retire_qpc,
+                                    int32_t was_pending);
+
+// acquire 종료(R_j) — n_miss/miss_bytes는 이 배치의 유니크 miss 집계.
+GGML_API void ggml_moe_phasea_acquire_exit(int32_t n_miss, uint64_t miss_bytes, uint64_t t_exit_qpc);
+
+// release 경계.
+GGML_API void ggml_moe_phasea_release_enter(int32_t mlpos, int32_t part, int32_t n_ids,
+                                            uint64_t t_qpc);
+GGML_API void ggml_moe_phasea_release_expert(int32_t expert, int32_t slot,
+                                             int32_t lease_before, int32_t lease_after);
+
+// ---------------------------------------------------------------------------
+// flush — ggml_moe_direct_finalize()가 **락을 잡기 전에** 1회 호출한다(멱등).
+//   사이드카 4파일 기록 + 버퍼된 phase_a_run 레코드를 metrics JSONL에 일괄 방출.
+// ---------------------------------------------------------------------------
+GGML_API void ggml_moe_phasea_flush(void);
+
+// selftest 전용: 전역 상태 완전 초기화 + env 재해소.
+GGML_API void ggml_moe_phasea_reset_for_test(void);
+
+// selftest 전용 관측 창구(프로덕션 경로 무접촉).
+GGML_API void ggml_moe_phasea_test_counts(uint64_t * out_events, uint64_t * out_ops,
+                                          uint64_t * out_ledger, uint64_t * out_sets,
+                                          uint64_t * out_dropped, int32_t * out_complete);
+
+#ifdef __cplusplus
+}
+#endif
