+    std::vector<float> w0, w1, rt1, x((size_t)PB_TEST_N_EMBD);
+    pb_fill_snapshot(PB_TEST_N_EMBD, PB_TEST_N_EXPERT, 99, w0, w1, rt1);
+    std::mt19937 rng(11); std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (auto & v : x) v = ud(rng);
+
+    ggml_moe_phaseb_run_begin();
+    // 여러 graph 에 걸쳐 capture 를 몰아넣어 worker가 바쁜 채로 CUT 에 진입하게 한다.
+    //   ★graph 수는 유계(12) — (graph, layer) 키 기반 구조가 실 워크로드 규모를 넘지 않게 한다.
+    for (int gph = 0; gph < 12; gph++) {
