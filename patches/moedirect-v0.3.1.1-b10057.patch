+            built = xcpu_make_store(st, "xcpu_graph", XCPU_S_NEXPERT, XCPU_S_NUSED,
+                                    XCPU_S_K, XCPU_S_M, XCPU_S_NEMBD, 777u);
+            XcpuPairGraph gs, gd;
+            if (built) {
+                built = xcpu_build_pair_graph(gs, be.get(), false, st, XCPU_S_K, XCPU_S_M,
+                                              XCPU_S_NEMBD, XCPU_G_NTOKEN, XCPU_S_NUSED,
+                                              idv, mm_act, add_act);
+            }
+            std::vector<uint8_t> ref_mm, ref_add;
+            if (built) {
+                ggml_backend_graph_compute(be.get(), gs.graph);
+                ref_mm.resize(ggml_nbytes(gs.mm_out));
+                ref_add.resize(ggml_nbytes(gs.add_out));
+                ggml_backend_tensor_get(gs.mm_out, ref_mm.data(), 0, ref_mm.size());
+                ggml_backend_tensor_get(gs.add_out, ref_add.data(), 0, ref_add.size());
+                built = xcpu_build_pair_graph(gd, be.get(), true, st, XCPU_S_K, XCPU_S_M,
+                                              XCPU_S_NEMBD, XCPU_G_NTOKEN, XCPU_S_NUSED,
+                                              idv, mm_act, add_act);
+            }
+            if (built && xcpu_seal_store(st) == 0) {
+                int32_t gwl = -1, gbl = -1;
+                ggml_moe_direct_registered_layer_part(gd.w, &gwl, &wp);
+                ggml_moe_direct_registered_layer_part(gd.b, &gbl, &bp);
+                // real traffic through the NEW surface before the off-path graph re-runs
+                int32_t t3[3] = { 0, 2, 5 };
+                uint64_t tk = 0;
+                traffic_rc = ggml_moe_store_acquire(0, wp, t3, 3, 1, &tk);
+                if (traffic_rc == 0 && tk != 0) {
+                    ggml_moe_buffer_view v = xstore_poisoned_view();
+                    (void) ggml_moe_store_view(tk, 2, wp, &v);
+                    ggml_moe_store_release(tk);
+                }
+                // XCPU09 - the UNREGISTERED graph again, now with a live store behind it
+                ggml_backend_graph_compute(be.get(), gs.graph);
+                std::vector<uint8_t> off_mm(ref_mm.size()), off_add(ref_add.size());
+                ggml_backend_tensor_get(gs.mm_out, off_mm.data(), 0, off_mm.size());
+                ggml_backend_tensor_get(gs.add_out, off_add.data(), 0, off_add.size());
+                eq_off = std::memcmp(off_mm.data(), ref_mm.data(), ref_mm.size()) == 0
+                      && std::memcmp(off_add.data(), ref_add.data(), ref_add.size()) == 0;
+                axes_off = xcpu_axes_zero() && ggml_moe_direct_touch_events() == 0
+                                            && ggml_moe_direct_fallback_count() == 0;
+                // XCPU10 - two parts of ONE layer held at once, released out of order
+                uint64_t tokA = 0, tokB = 0;
+                int32_t two[2] = { 2, 5 };
+                const int aA = ggml_moe_store_acquire(0, wp, two, 2, 1, &tokA);
+                const int aB = ggml_moe_store_acquire(0, bp, two, 2, 1, &tokB);
+                const int cA = (tokA != 0) ? ggml_moe_direct_test_xstore_token_part(tokA, &capA) : -1;
+                const int cB = (tokB != 0) ? ggml_moe_direct_test_xstore_token_part(tokB, &capB) : -1;
+                // Acquisition was A then B; the RETURN is B then A. That is the reverse order,
+                // and it is the one worth exercising: the survivor across a release is then the
+                // token taken FIRST. Releasing A first would only have shown that the later
+                // token outlives the earlier one, which is the direction a stack discipline
+                // produces on its own and proves nothing about ordering independence.
+                if (tokB != 0) ggml_moe_store_release(tokB);
+                const int cA2 = (tokA != 0) ? ggml_moe_direct_test_xstore_token_part(tokA, &capA2) : -1;
+                if (tokA != 0) ggml_moe_store_release(tokA);
+                two_ok = (aA == 0 && aB == 0 && cA == 0 && cB == 0 && cA2 == 0
+                          && xcpu_axes_zero());
+                // XCPU11 no longer lives here: the OFF branch it has to exercise is
+                // unreachable in this process, so it moved to the --xcpu-off-test child
+                // below. `gd` stays because XCPU10 needs its two registered parts.
