+// pb_io / pb_sample 전건 덤프.
+static std::vector<ggml_moe_phaseb_io> pb_read_ios() {
+    uint64_t ns = 0, ni = 0, ps = 0, es = 0; int32_t on = 0, k = 0, n = 0;
+    ggml_moe_direct_test_pb_counts(&ns, &ni, &ps, &es, &on, &k, &n);
