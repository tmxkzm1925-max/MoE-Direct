+
+// 수집 축 env(기본 미설정 = off). PbEnv 와 겹치지 않는 독립 축이다(부록 14.4).
+struct PbCollectEnv {
+    EnvGuard collect;
+    explicit PbCollectEnv(const char * v) : collect("MOE_DIRECT_PHASEB_COLLECT", v) {}
+};
+
+// 한 시나리오 런의 **기존(pre-5c-T) 관측 표면** 스냅샷 — additive 동일성 대조 대상.
+struct Pb5ctBase {
+    uint64_t  c3[GGML_MOE_PB_C_COUNT] = {0};
+    PbDigests dg;
+    size_t    n_ios = 0, n_samples = 0;
+    uint64_t  term_hist[8] = {0};      // terminal_status 히스토그램(qpc 무관 결정론 축)
+    uint64_t  flag_or = 0;             // pb_io flags 의 OR(래치 조합 보존 확인)
+    bool operator==(const Pb5ctBase & o) const {
+        for (int i = 0; i < GGML_MOE_PB_C_DEMAND_PREFLIGHT_REJECT + 1; i++)
+            if (c3[i] != o.c3[i]) return false;      // ★기존 20종만 대조(신설 5종은 제외)
+        for (int i = 0; i < 8; i++) if (term_hist[i] != o.term_hist[i]) return false;
+        return dg == o.dg && n_ios == o.n_ios && n_samples == o.n_samples && flag_or == o.flag_or;
+    }
+    // ★재개봉 R4ⓑ — 불일치 시 **첫 성분**을 이름과 값으로 낸다. 이 검사들은 지금까지 "다르다"만
+    //   말해서, 간헐 실패가 뜰 때마다 원인을 추론으로 좁혀야 했다(교차 X6 지적). 성분이 찍히면
+    //   다음 1회 발생으로 원인 분류가 닫힌다.
+    std::string first_diff(const Pb5ctBase & o) const {
+        auto u = [](uint64_t v) { return std::to_string((unsigned long long)v); };
+        for (int i = 0; i < GGML_MOE_PB_C_DEMAND_PREFLIGHT_REJECT + 1; i++)
+            if (c3[i] != o.c3[i]) return "c3[" + std::to_string(i) + "] " + u(c3[i]) + " != " + u(o.c3[i]);
+        for (int i = 0; i < 8; i++)
+            if (term_hist[i] != o.term_hist[i])
+                return "terminal_status[" + std::to_string(i) + "] " + u(term_hist[i]) + " != " + u(o.term_hist[i]);
+        if (dg.intent       != o.dg.intent)       return "digest.intent";
+        if (dg.disposition  != o.dg.disposition)  return "digest.disposition";
+        if (dg.transition   != o.dg.transition)   return "digest.transition";
+        if (dg.cache_class  != o.dg.cache_class)  return "digest.cache_class";
+        if (dg.readfile     != o.dg.readfile)     return "digest.readfile";
+        if (dg.readfile_ops != o.dg.readfile_ops) return "digest.readfile_ops " + u(dg.readfile_ops) + " != " + u(o.dg.readfile_ops);
+        if (dg.intent_count != o.dg.intent_count) return "digest.intent_count " + u(dg.intent_count) + " != " + u(o.dg.intent_count);
+        if (n_ios     != o.n_ios)     return "n_ios " + u(n_ios) + " != " + u(o.n_ios);
+        if (n_samples != o.n_samples) return "n_samples " + u(n_samples) + " != " + u(o.n_samples);
+        if (flag_or   != o.flag_or)   return "pb_io flags OR " + u(flag_or) + " != " + u(o.flag_or);
+        return "(동일)";
+    }
+};
+
+static Pb5ctBase pb5ct_capture() {
+    Pb5ctBase b;
+    for (int i = 0; i < GGML_MOE_PB_C_COUNT; i++) b.c3[i] = ggml_moe_phaseb_counter(i);
+    b.dg = pb_digests();
+    const std::vector<ggml_moe_phaseb_io> ios = pb_read_ios();
+    b.n_ios     = ios.size();
+    b.n_samples = pb_read_samples().size();
+    for (const auto & r : ios) {
+        if (r.terminal_status < 8) b.term_hist[r.terminal_status]++;
+        b.flag_or |= r.flags;
+    }
+    return b;
+}
+
+// ★결정론 시나리오 — 층 1의 expert 1..7 을 상주시켜 rank 0(expert 0)만 candidate 로 남기고
+//   프리페치 1건을 issue → READY_PROBATION 으로 만든다. promote=true 면 demand hit 으로 승격.
+// ★재개봉 R7(fix-confirm r2 F4) — 사전 적재를 **1건씩 직렬화**한다. 반환 = settle 성공 여부.
+//
+// 구 형태는 expert 1~7 을 **한 번의 acquire 로 동시 제출**했다(QD=4). `moe_pb_transition_digest`
+// 는 전이 사건을 **발생 순서 그대로** FNV 에 먹이고 `PUBLISH_*` 는 terminal(= 물리 I/O 완료)
+// 시점에 투입되므로, QD>1 동시 제출에서는 **기동 간 완전일치가 원리상 불성립**이다 — 권위
+// 사양이 그렇게 명문화한다(`SPEC_PHASEB_WIRE.md` :639-647 "비결정 채널 분류(v4)").
+// 그것이 P44g/P44h 가 간헐로 `digest.transition` 에서만 갈리던 실원인이다.
+// ⇒ **한 번에 1건만 in-flight** 로 만들면 완료 순서 = 제출 순서로 고정돼 등식이 정의된다.
+//   그래서 성분을 비교에서 **빼지 않고 그대로 유지**할 수 있다(감퇴 금지 — 리드 ⓐ 수정형).
+// ★**5c-T wire 계약 무접촉**: 사양 문면·필드·바이트 규약을 건드리지 않고 테스트 시나리오의
+//   동시성만 없앤다. 사양이 QD>1 을 비결정 조건으로 지목했으므로 그 조건을 제거하는 것은
+//   사양에 **부합하는** 결정론화다 ⇒ 프리페치 트랙 재심 불요.
+static bool pb5ct_scenario(Fixture & fx, bool promote) {
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    for (int32_t e = 1; e <= 7; e++) {
+        ggml_moe_direct_acquire(g1, &e, 1, 1);
+        ggml_moe_direct_release(g1, &e, 1);
+    }
+    // ★R9 — "settle 성공" = rank 전건 처분(`done`) **∧ quiesce 성공**. 둘 중 하나만 보면
+    //   in-flight 가 남은 미완 런을 등식 비교에 넣게 된다.
+    int quiesced = 0;
+    const bool disposed = pb_push_and_settle(0, 0, 0, /*src=*/0, /*tgt=*/1, {0,1,2,3,4,5,6,7}, &quiesced);
+    const bool settled = disposed && (quiesced == 1);
+    if (promote) {
+        int32_t e0 = 0;
+        ggml_moe_direct_acquire(g1, &e0, 1, 1);
+        ggml_moe_direct_release(g1, &e0, 1);
+    }
+    return settled;
+}
+
+// ★r3 수리 2 — 디스크에 쓰인 `pb_ledger.pb` 를 **공통 128B 헤더 + 320B 레코드**로 재파싱한다.
+//   메모리 버퍼가 아니라 파일 바이트를 통과시켜야 "실 wire 경유" 반례가 된다. 반환 = 파일 바이트.
+static uint64_t pb5ct_read_ledger_file(const std::wstring & path,
+                                       std::vector<ggml_moe_phaseb_ledger> & out) {
+    out.clear();
+    std::ifstream ifs(path, std::ios::binary);
+    if (!ifs.good()) return 0;
+    std::vector<char> buf((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
+    if (buf.size() < 128) return (uint64_t)buf.size();
+    const size_t n = (buf.size() - 128) / sizeof(ggml_moe_phaseb_ledger);
+    out.resize(n);
+    for (size_t i = 0; i < n; i++)
+        std::memcpy(&out[i], buf.data() + 128 + i * sizeof(ggml_moe_phaseb_ledger),
+                    sizeof(ggml_moe_phaseb_ledger));
+    return (uint64_t)buf.size();
+}
+
+// ledger 전량 덤프(수집 OFF = 빈 벡터).
+static std::vector<ggml_moe_phaseb_ledger> pb5ct_read_ledger() {
+    const uint64_t n = ggml_moe_phaseb_ledger_records();
+    std::vector<ggml_moe_phaseb_ledger> v((size_t)n);
+    for (uint64_t i = 0; i < n; i++)
+        if (ggml_moe_phaseb_test_ledger_record(i, &v[(size_t)i],
+                                               (uint32_t)sizeof(ggml_moe_phaseb_ledger)) != 0) {
+            v.clear(); break;
+        }
+    return v;
+}
+
+// ★offline 재구성기(§6-2 ⓕⓖ) — 엔진이 아니라 **판독 측** 결정론을 행사한다.
+//   ⓐevent_seq 오름차순 정렬 후 ⓑADMISSION_DECISION 을 임의 하한 P_MIN 으로 seal 열로 접고
+//   ⓒINFLIGHT_DELTA 를 재생해 동시성 창을 복원한다. 같은 원시 행 → 같은 digest 가 계약이다.
+struct Pb5ctReduce {
+    uint64_t seal_digest = 0xcbf29ce484222325ull;
+    uint64_t n_seals = 0;
+    int64_t  inflight_min = 0, inflight_end = 0, inflight_max = 0;
+    uint64_t n_admission = 0, n_blocked = 0, n_terminal = 0, n_evict = 0, n_census = 0, n_delta = 0;
+    uint64_t censored_owners = 0;
+    bool     mixed_tuple = false;
+    bool operator==(const Pb5ctReduce & o) const {
+        return seal_digest == o.seal_digest && n_seals == o.n_seals &&
+               inflight_min == o.inflight_min && inflight_end == o.inflight_end &&
+               inflight_max == o.inflight_max && n_admission == o.n_admission &&
+               n_blocked == o.n_blocked && n_terminal == o.n_terminal && n_evict == o.n_evict &&
+               n_census == o.n_census && n_delta == o.n_delta &&
+               censored_owners == o.censored_owners && mixed_tuple == o.mixed_tuple;
+    }
+};
+
+static bool r_mixed_seen = false;   // pb5ct_reduce 내부 스크래치(단일 스레드 하네스)
+static Pb5ctReduce pb5ct_reduce(std::vector<ggml_moe_phaseb_ledger> recs, uint64_t p_min) {
+    std::stable_sort(recs.begin(), recs.end(),
+                     [](const ggml_moe_phaseb_ledger & a, const ggml_moe_phaseb_ledger & b) {
+                         return a.event_seq < b.event_seq;
+                     });
+    // ★r2 M7-3 — `mixed_tuple` 은 **동일 participant window 안**의 튜플 혼재로 판정한다
+    //   (controller §6). 전체 admission 열의 첫 K/N 과 비교하는 구 판은 window 개념이 없었다.
+    //   ⓐADMISSION_DECISION 에서 owner epoch → 튜플 표를 만들고
+    //   ⓑwindow 를 가진 레코드(DROP admission · BLOCKED_INTERVAL · CENSOR_CENSUS)마다
+    //     participants ∪ 자기 owner 의 튜플이 2종 이상인지 본다.
+    std::map<uint32_t, uint32_t> owner_tuple;   // request_epoch → (k<<16|n<<8|qd)
+    for (const auto & e : recs) {
+        if (e.kind != GGML_MOE_PB_L_ADMISSION_DECISION) continue;
+        if (e.flags & GGML_MOE_PB_L_F_CONTINUATION) continue;
+        if (e.request_epoch == GGML_MOE_PHASEB_NA_U32) continue;
+        owner_tuple[e.request_epoch] =
+            ((uint32_t)e.stamp_k << 16) | ((uint32_t)e.stamp_n << 8) | (uint32_t)e.stamp_qd;
+    }
+    {   // window 단위 판정 — 연속 레코드는 선행 head 의 event_seq 로 묶인다.
+        std::map<uint64_t, std::set<uint32_t>> win;
+        for (const auto & e : recs) {
+            const bool has_window = (e.kind == GGML_MOE_PB_L_BLOCKED_INTERVAL ||
+                                     e.kind == GGML_MOE_PB_L_CENSOR_CENSUS ||
+                                     (e.kind == GGML_MOE_PB_L_ADMISSION_DECISION &&
+                                      (e.disposition == GGML_MOE_PB_D_DROP_NO_SLOT_QD ||
+                                       e.disposition == GGML_MOE_PB_D_DROP_PREFETCH_CAP ||
+                                       e.disposition == GGML_MOE_PB_D_DROP_RESERVE)));
+            if (!has_window) continue;
+            std::set<uint32_t> & tset = win[e.event_seq];
+            if (!(e.flags & GGML_MOE_PB_L_F_CONTINUATION) &&
+                e.request_epoch != GGML_MOE_PHASEB_NA_U32 && e.stamp_k != 0)
+                tset.insert(((uint32_t)e.stamp_k << 16) | ((uint32_t)e.stamp_n << 8) |
+                            (uint32_t)e.stamp_qd);
+            for (uint16_t i = 0; i < e.n_part_stored; i++) {
+                auto it = owner_tuple.find(e.participants[i].request_epoch);
+                if (it != owner_tuple.end()) tset.insert(it->second);
+            }
+        }
+        for (const auto & kv : win) if (kv.second.size() > 1) r_mixed_seen = true;
+    }
+    Pb5ctReduce r;
+    r.mixed_tuple = r_mixed_seen;
+    r_mixed_seen = false;
+    uint64_t sample = 0;
+    int64_t  inflight = 0;
+    for (const auto & e : recs) {
+        if (e.flags & GGML_MOE_PB_L_F_CONTINUATION) {
+            // 연속 레코드는 참여 집합만 잇는다(사건 계수 금지).
+            for (uint16_t i = 0; i < e.n_part_stored; i++)
+                if (e.kind == GGML_MOE_PB_L_CENSOR_CENSUS) r.censored_owners++;
+            continue;
+        }
+        switch (e.kind) {
+            case GGML_MOE_PB_L_ADMISSION_DECISION: {
+                r.n_admission++;
+                if (e.decision_seq != GGML_MOE_PHASEB_NA_U64) {
+                    sample++;
+                    if (sample >= p_min) {   // 임의 하한 스윕 — seal 경계를 결정적으로 재생
+                        sample = 0;
+                        r.n_seals++;
+                        r.seal_digest = pb_fnv(r.seal_digest, &e.decision_seq, sizeof(e.decision_seq));
+                        r.seal_digest = pb_fnv(r.seal_digest, &e.disposition, sizeof(e.disposition));
+                    }
+                }
+                break;
+            }
+            case GGML_MOE_PB_L_INFLIGHT_DELTA:
+                r.n_delta++;
+                inflight += e.delta;
+                if (inflight < r.inflight_min) r.inflight_min = inflight;
+                if (inflight > r.inflight_max) r.inflight_max = inflight;
+                break;
+            case GGML_MOE_PB_L_BLOCKED_INTERVAL: r.n_blocked++;  break;
+            case GGML_MOE_PB_L_OP_TERMINAL:      r.n_terminal++; break;
+            case GGML_MOE_PB_L_READY_EVICT:      r.n_evict++;    break;
+            case GGML_MOE_PB_L_CENSOR_CENSUS:
+                r.n_census++;
+                r.censored_owners += e.n_part_stored;
+                break;
+            default: break;
+        }
+    }
+    r.inflight_end = inflight;
+    return r;
+}
+
+// summary/header 에 있으면 안 되는(수집 전용) 키 목록 — 부록 14.1·14.3·14.4.
+static const char * kPb5ctSummaryKeys[] = {
+    "pb_resolved_wasted", "pb_censored", "pb_eligible_demand_acquire",
+    "pb_waited_acquire", "pb_observed_frontier_match", "pb_ledger",
+};
+
+static json pb5ct_first_run_record(const std::wstring & path) {
+    std::ifstream ifs(path, std::ios::binary);
+    std::string line;
+    while (std::getline(ifs, line)) {
+        json j = json::parse(line, nullptr, false);
+        if (j.is_object() && j.value("type", "") == "phase_b_run") return j;
+    }
+    return json::object();
+}
