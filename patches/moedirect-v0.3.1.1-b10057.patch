+// ===========================================================================
+
+namespace {
+
+// ★r2 차단 M1 수리 — custom op 안의 런타임 heap 할당 제거용 **층별 사전확보 스크래치**.
+//
+//   왜 필요한가: 콜백 `llm_shadow_moe_op` 은 **OpenMP 계산 영역 안에서 직접** 호출된다
+//   (ggml-cpu.c:3565-3587 → ops.cpp:11631 · 현 빌드는 OpenMP ON). 그 영역 안에서 던져진
+//   예외가 드라이버(llama-context.cpp)의 catch 로 안전하게 도달한다는 보장이 없다. 콜백
+//   안에서 `std::vector` 6개를 만들던 구식 구현은 OOM 한 번에 프로세스를 잃을 수 있었다.
+//
+//   정정: 버퍼 크기는 n_embd / n_ff 로 **graph-build 시점에 이미 확정**된다. 확보는
+//   `build_moe_shadow_experts()`(드라이버 스레드·graph build)에서 끝내고, 콜백은 이미
+//   확보된 포인터만 집어 쓴다 → 콜백의 heap 할당 0 · 예외 발생점 0.
+//   확보 실패(OOM)는 build 시점에서 run_error latch + 그 층 unsupported 로 닫는다.
+struct llm_shadow_moe_scratch {
+    std::vector<float> x;     // [n_embd]              토큰 입력 게더
+    std::vector<float> row;   // [max(n_embd, n_ff)]   역양자화 1행 버퍼
+    std::vector<float> vg;    // [merged ? 2*n_ff : n_ff]
+    std::vector<float> vu;    // [n_ff]
+    std::vector<float> act;   // [n_ff]
+    std::vector<float> vo;    // [n_embd]
+
+    // 확보된 용량(단조 증가) — 이미 충분하면 재빌드에서 재할당하지 않는다.
+    int64_t cap_embd = 0;
+    int64_t cap_ff   = 0;
+    int64_t cap_vg   = 0;
+    bool    ready    = false;
+};
+
+struct llm_shadow_moe_ud {
+    const ggml_tensor * gate_exps    = nullptr;
+    const ggml_tensor * up_exps      = nullptr;
+    const ggml_tensor * down_exps    = nullptr;
+    const ggml_tensor * gate_up_exps = nullptr;
+    int32_t  layer_id      = -1;   // 실제 layer id
+    int32_t  mlpos         = -1;   // moe_layers 내 위치(present 조회 키)
+    int32_t  n_expert_used = 0;
+    int32_t  type_op       = 0;    // llm_ffn_op_type
+    int32_t  arch_ds4      = 0;    // DEEPSEEK4 clamp 분기 여부
+    float    swiglu_limit  = 0.0f;
+    uint32_t stride_bytes  = 0;
+    int32_t  unsupported   = 0;    // 1 = 지원 밖 형상(bias/scale/weight_before_ffn 등)
+
+    // ★M1 — build 시점에 확보된 층별 작업 버퍼. 콜백은 **여기서만** 메모리를 얻는다.
+    llm_shadow_moe_scratch * scratch = nullptr;
+
+    // ★M3 test-only — 전문가 가중치 base 를 픽스처가 직접 지정할 때만 non-null.
+    //   [0]=gate(merged 면 gate_up) · [1]=up · [2]=down.
+    //   그래프가 채우는 g_shadow_ud[] 는 이 필드를 **절대** 채우지 않는다 →
+    //   프로덕션 경로는 언제나 `ggml_moe_shadow_view_ptr()` 를 탄다.
+    const void * test_bases[3] = { nullptr, nullptr, nullptr };
+};
+
+// 층당 1슬롯. 섀도는 동기 실행이고 한 graph 안에서 층 id 가 유일하므로 충돌하지 않는다.
+llm_shadow_moe_ud g_shadow_ud[LLAMA_MAX_LAYERS];
+
+// ★M1 — 스크래치는 ud 와 **분리 보관**한다. build 마다 `ud = llm_shadow_moe_ud{}` 로
+//   초기화되는데, 확보해 둔 버퍼가 거기서 함께 해제되면 사전확보의 의미가 사라진다.
+llm_shadow_moe_scratch g_shadow_scratch[LLAMA_MAX_LAYERS];
+
+// ★M1 — build 시점 전용(드라이버 스레드). **던지지 않는다** — 성공 true / 실패 false.
+//   이미 충분히 큰 버퍼가 있으면 재할당하지 않는다(용량 단조 증가).
+//   ★r3 M1 — 실패 latch 를 **이 함수 안**으로 옮겼다. 예전에는 호출측(build_moe_shadow_experts)
+//   한 곳만 latch 해서, 같은 실패가 다른 호출 경로(테스트 export 포함)에서는 아무 표지도 남기지
+//   않았다. 사전확보 실패는 어느 경로에서 나든 "관측을 신뢰할 수 없다"는 같은 사실이다.
+bool shadow_scratch_reserve(llm_shadow_moe_scratch & sc, int64_t n_embd, int64_t n_ff, bool merged) {
+    if (n_embd <= 0 || n_ff <= 0) {
+        ggml_moe_shadow_run_error("shadow scratch pre-reservation failed (invalid layer shape)");
+        return false;
+    }
+
+    // ★r4 R1' — 음성 창구는 **실 allocator 실패를 만드는 것**이지 실패 처분을 흉내 내는 것이
+    //   아니다. r3 은 try 앞에서 `ready=false → latch → return false` 를 직접 수행해서 정작
+    //   프로덕션의 `catch(...)`(아래)를 한 번도 태우지 않았다(교차 r4 R1 [미흡]).
+    //   지금은 (a) 무장 시 "이미 충분" 지름길을 타지 않고 반드시 실 resize 경로로 들어가서
+    //   (b) try **안에서** `std::bad_alloc` 을 던진다. 처분(ready=false·latch·return false)은
+    //   오직 아래 catch 한 곳에만 존재하므로, P43j6 이 그 값들을 관측한다는 것은 곧 프로덕션
+    //   catch 가 실행됐다는 뜻이다(다른 생산자가 없다).
+    const bool fault_scratch_oom =
+        (ggml_moe_shadow_test_fault_bits() & GGML_MOE_SHADOW_FAULT_SCRATCH_OOM) != 0;
+
+    const int64_t need_vg = merged ? n_ff * 2 : n_ff;
+    if (!fault_scratch_oom &&
+        sc.ready && sc.cap_embd >= n_embd && sc.cap_ff >= n_ff && sc.cap_vg >= need_vg) {
+        return true;   // 이미 충분 — 할당 없음
+    }
+
+    const int64_t new_embd = sc.cap_embd > n_embd  ? sc.cap_embd : n_embd;
+    const int64_t new_ff   = sc.cap_ff   > n_ff    ? sc.cap_ff   : n_ff;
+    const int64_t new_vg   = sc.cap_vg   > need_vg ? sc.cap_vg   : need_vg;
+    const int64_t new_row  = new_embd > new_ff ? new_embd : new_ff;
+
+    try {
+        // ★test-only 주입 지점 — 여기서 던진 예외는 std::vector::resize 가 던지는 것과 같은
+        //   타입이고 같은 catch 로 들어간다(프로덕션은 fault_bits==0 이라 항상 거짓).
+        if (fault_scratch_oom) {
+            throw std::bad_alloc();
+        }
+        sc.x  .resize((size_t) new_embd);
+        sc.row.resize((size_t) new_row);
+        sc.vg .resize((size_t) new_vg);
+        sc.vu .resize((size_t) new_ff);
+        sc.act.resize((size_t) new_ff);
+        sc.vo .resize((size_t) new_embd);
+    } catch (...) {
+        sc.ready = false;   // 부분 확보 상태 — 콜백은 이 층을 계산하지 않는다(fail-close)
+        ggml_moe_shadow_run_error("shadow scratch pre-reservation failed (out of memory)");
+        return false;
+    }
+
+    sc.cap_embd = new_embd;
+    sc.cap_ff   = new_ff;
+    sc.cap_vg   = new_vg;
+    sc.ready    = true;
+    return true;
+}
+
+inline float shadow_silu(float x) { return x / (1.0f + expf(-x)); }
+inline float shadow_gelu(float x) {
+    return 0.5f * x * (1.0f + tanhf(0.79788456080286535588f * (x + 0.044715f * x * x * x)));
+}
+
+// 양자화 행 1개를 F32 로 펼친다. 성공 true. (블록 크기 정합이 안 맞으면 false)
+// ★M1 — 인자를 `std::vector&` 가 아니라 **원시 포인터**로 받는다. 벡터를 넘기면 이 안에서
+//   resize/할당이 일어날 여지가 남지만, 포인터만 받으면 그 여지가 구조적으로 없다
+//   (버퍼는 호출자가 build 시점에 확보한 스크래치다).
+bool shadow_row_to_f32(const void * src, enum ggml_type type, int64_t k, float * out) {
+    if (type == GGML_TYPE_F32) {
+        std::memcpy(out, src, (size_t) k * sizeof(float));
+        return true;
+    }
+    const ggml_type_traits * tt = ggml_get_type_traits(type);
+    if (!tt || !tt->to_float) return false;
+    if (tt->blck_size > 0 && (k % tt->blck_size) != 0) return false;
+    tt->to_float(src, out, k);
+    return true;
+}
+
+// ★r1 차단 6 수리 — layer_begin_qpc 의 출처(SPEC §4 G-SD3 ②: "각 layer begin/route-ready/end").
+//
+//   이전 구현은 **custom op 진입 시각**을 layer_begin 으로 실었다. 그 시점엔 이 층의 라우터
+//   (gate mul_mat · top-k · weight 정규화)가 이미 끝나 있어서 begin 과 route_ready 가 사실상
+//   같은 점으로 붕괴했고, 층 span 이 "라우터 앞 층 시작~끝"이 아니라 마스크 GEMV 구간만
+//   덮었다. 그러면 G-SD3 의 층별 비용 배분이 라우터 몫을 통째로 놓친다.
+//
+//   정정: 층 창의 시작 = **직전 층 레코드의 layer_end_qpc**(스텝의 첫 층이면 step_begin_qpc).
+//   커서는 shadow 모듈이 소유한다(step_begin 에서 초기화 · layer_record 에서 단조 전진).
+//   결과로 한 스텝의 층 span 들이 [step_begin, step_end] 를 겹침 없이 분할하고
+//     (route_ready − layer_begin) = 라우터 포함 층 전반부,
+//     (layer_end   − route_ready) = 마스크-재정규화 GEMV 구간
+//   이 된다. op 진입 시각 자체는 route_ready 가 대신한다(그 사이는 정수 몇 개 로드뿐).
+//
+//   그래프에 마커 노드를 심지 않은 이유: custom op 은 CPU 전용이라 라우터 앞에 노드를 하나
+//   더 넣으면 층마다 backend split 이 하나씩 늘고 device 왕복이 끼어든다 — 재려는 비용
+//   자체를 바꿔놓는다. 커서 파생은 그래프를 한 노드도 건드리지 않는다.
+inline uint64_t shadow_layer_window_qpc() {
+    const uint64_t w = ggml_moe_shadow_layer_window_qpc();
+    return w != 0 ? w : ggml_moe_phasea_now_qpc();   // 스텝 밖(드라이버 계약 위반) = 현재 시각
+}
+
+inline float shadow_dot(const float * a, const float * b, int64_t n) {
+    double s = 0.0;   // 누적은 double — 층 60개를 8스텝 굴리므로 F32 누적 오차가 신호를 흐린다.
+    for (int64_t i = 0; i < n; i++) s += (double) a[i] * (double) b[i];
+    return (float) s;
+}
+
+// 전문가 e 의 [k, m] 행렬 × 벡터 x[k] → y[m]. base = view 스냅샷 포인터.
+// ★M1 — row/y 모두 사전확보 버퍼(원시 포인터). 이 함수는 heap 을 건드리지 않는다.
+bool shadow_gemv(const void * base, const ggml_tensor * w, const float * x,
+                 int64_t k, int64_t m, float * row, float * y) {
+    if (!base) return false;
+    for (int64_t r = 0; r < m; r++) {
+        const void * p = (const char *) base + (size_t) r * w->nb[1];
+        if (!shadow_row_to_f32(p, w->type, k, row)) return false;
+        y[r] = shadow_dot(row, x, k);
+    }
+    return true;
+}
+
+// ★M3 — 전문가 e 의 가중치 base 해석. **프로덕션과 픽스처가 갈리는 유일한 지점**이다.
+//   프로덕션: `ud.test_bases[*]` 가 전부 null 이므로 언제나 캐시 view 스냅샷
+//             `ggml_moe_shadow_view_ptr()` 를 탄다(tick-중립·읽기 제출 0 계약 유지).
+//   픽스처  : `llama_shadow_moe_op_calibrate()` 가 F32 가중치 배열의 선두를 실어 주면
+//             전문가 stride(t->nb[2])로 오프셋만 계산한다. 캐시가 없는 단위 테스트 환경.
+//   `t == nullptr` / `e < 0` 처분은 기존과 동일한 null 이다 —
+//   `ggml_moe_shadow_view_ptr()`(ggml-moe-direct.cpp) 자신이 두 경우 모두 null 을 돌려준다.
+//   두 검사를 앞으로 뺀 덕에 픽스처 분기가 음수 인덱스로 포인터를 계산할 여지도 사라진다.
+inline const void * shadow_expert_base(const llm_shadow_moe_ud & ud, const ggml_tensor * t,
+                                       int32_t e, int which) {
+    if (!t || e < 0) return nullptr;
+    if (ud.test_bases[which]) {
+        return (const char *) ud.test_bases[which] + (size_t) e * t->nb[2];
+    }
+    return ggml_moe_shadow_view_ptr(t, e);
+}
+
+// 한 토큰 본체의 결과 요약(레코드 기재용). 힙을 잡지 않는 POD.
+struct llm_shadow_token_stat {
+    float mass_all     = 0.0f;
+    float mass_present = 0.0f;
+    float mass_ratio   = 0.0f;   // Σ(present 원 가중)/Σ(전체 선택 가중) — 진단 전용
+    int32_t all_dropped = 1;
+    int32_t failed      = 0;     // fail-close(run_error latch)가 1회라도 섰다
+};
+
+// ===========================================================================
+// ★D2 본체(SPEC_SHADOW_DRAFT §1) — 토큰 1개의 마스크-재정규화 sparse 기여를 out 에 누적.
+//
+//   ★M3 의 핵심: 실 custom op(`llm_shadow_moe_op`)과 test-only calibration
+//   (`llama_shadow_moe_op_calibrate`)이 **이 함수 하나**를 공유한다. 실 경로의 산식·클램프·
+//   fail-close 가 회귀하면 calibration 이 그 자리에서 틀린 값을 낸다(오라클 재구현이 아니다).
+//
+//   호출 전제: `out` 은 이미 0 이고, `sc` 는 (n_embd, n_ff) 를 담을 만큼 사전확보돼 있다.
+//   ★이 함수와 그 피호출자는 heap 을 일절 잡지 않는다 — 작업 버퍼는 전부 sc 에서 온다.
+// ===========================================================================
+void shadow_moe_token_body(const llm_shadow_moe_ud & ud,
+                           llm_shadow_moe_scratch & sc,
+                           const ggml_tensor * w_gate,
+                           const ggml_tensor * w_up,
+                           const ggml_tensor * w_down,
+                           bool     merged,
+                           bool     has_gate,
+                           int64_t  n_embd,
+                           int64_t  n_ff,
+                           const char * x_base,     // 토큰 t 의 첫 성분 주소
+                           size_t       x_stride,   // 성분 간 바이트 stride(= src->nb[0])
+                           const int32_t * pred,
+                           const float   * wt,
+                           int32_t  n_pred,
+                           uint16_t mask,
+                           int32_t  n_present,      // < 0 이면 residency 조회 실패
+                           float  * out,
+                           llm_shadow_token_stat & st) {
+    float * const px   = sc.x.data();
+    float * const prow = sc.row.data();
+    float * const pvg  = sc.vg.data();
+    float * const pvu  = sc.vu.data();
+    float * const pact = sc.act.data();
+    float * const pvo  = sc.vo.data();
+
+    // ── ③ 원 gate weight 비율로 재정규화 ──
+    float mass_present = 0.0f, mass_all = 0.0f;
+    for (int32_t i = 0; i < n_pred; i++) {
+        mass_all += wt[i];
+        if (mask & (1u << i)) mass_present += wt[i];
+    }
+    st.mass_all     = mass_all;
+    st.mass_present = mass_present;
+    st.mass_ratio   = (mass_all != 0.0f) ? (mass_present / mass_all) : 0.0f;
+    st.all_dropped  = ((n_present <= 0) || (mass_present <= 0.0f)) ? 1 : 0;
+
+    if (st.all_dropped) {
+        return;   // sparse 기여 0 (0-나눗셈 금지 · residual/shared 분기는 호출자가 유지)
+    }
+
+    for (int64_t c = 0; c < n_embd; c++) {
+        px[c] = *(const float *) (x_base + (size_t) c * x_stride);
+    }
+
+    for (int32_t i = 0; i < n_pred; i++) {
+        if (!(mask & (1u << i))) continue;             // ★drop — 0-기여, 읽기 없음
+        const int32_t e  = pred[i];
+        // ★r1 차단 2 수리 — routed scaling factor 보존.
+        //   구식 `wt[i]/mass_present` 는 present 가중합을 **1 로 강제**해, 메인이 곱해 둔
+        //   routed_scaling_factor(K2.6 = 2.446)를 지워버렸다. 그러면 all-present 에서도
+        //   메인 가중합과 달라져 D1 "같은 모델"·D2 all-present 항등이 깨진다.
+        //   `wt[i] * (mass_all / mass_present)` 로 바꾸면
+        //     · all-present(mass_present == mass_all) → wn == wt[i] (메인과 동일 산술)
+        //     · partial → 상대비는 재정규화하되 원 routed scale 은 그대로 보존
+        const float wn = wt[i] * (mass_all / mass_present);   // 0-나눗셈은 위에서 배제
+
+        const void * pg = shadow_expert_base(ud, w_gate, e, 0);
+        const void * pu = merged ? pg : shadow_expert_base(ud, w_up, e, 1);
+        const void * pd = shadow_expert_base(ud, w_down, e, 2);
+        // ★r1 차단 2 수리 — resident 판정이 섰는데 view 포인터가 없다는 것은 동결 위반이다.
+        //   조용한 continue 는 "일부 전문가가 빠진 값"을 정상값처럼 내보낸다 → fail-close.
+        if (!pg || !pd || (has_gate && !pu)) {
+            ggml_moe_shadow_run_error("view ptr null for a resident expert"); st.failed = 1; continue; }
+
+        // ★r1 차단 2 수리 — 역양자화/GEMV 실패도 조용히 넘기지 않는다(fail-close).
+        if (merged) {
+            if (!shadow_gemv(pg, w_gate, px, n_embd, n_ff * 2, prow, pvg)) {
+                ggml_moe_shadow_run_error("dequant/gemv failed (merged gate_up)"); st.failed = 1; continue; }
+            std::memcpy(pvu, pvg + n_ff, (size_t) n_ff * sizeof(float));
+        } else {
+            if (!shadow_gemv(pg, w_gate, px, n_embd, n_ff, prow, pvg)) {
+                ggml_moe_shadow_run_error("dequant/gemv failed (gate)"); st.failed = 1; continue; }
+            if (has_gate && !shadow_gemv(pu, w_up, px, n_embd, n_ff, prow, pvu)) {
+                ggml_moe_shadow_run_error("dequant/gemv failed (up)"); st.failed = 1; continue; }
+        }
+
+        for (int64_t r = 0; r < n_ff; r++) {
+            float g = pvg[r];
+            float u = has_gate ? pvu[r] : 1.0f;
+            if (ud.swiglu_limit > 1e-6f) {
+                if (u >  ud.swiglu_limit) u =  ud.swiglu_limit;
+                if (u < -ud.swiglu_limit) u = -ud.swiglu_limit;
+            }
+            switch (ud.type_op) {
+                case LLM_FFN_SILU:
+                case LLM_FFN_SWIGLU_OAI_MOE:
+                    if (ud.swiglu_limit > 1e-6f && ud.arch_ds4 && g > ud.swiglu_limit) g = ud.swiglu_limit;
+                    g = shadow_silu(g);
+                    if (ud.swiglu_limit > 1e-6f && !ud.arch_ds4 && g > ud.swiglu_limit) g = ud.swiglu_limit;
+                    break;
+                case LLM_FFN_GELU:    g = shadow_gelu(g); break;
+                case LLM_FFN_RELU:    g = g > 0.0f ? g : 0.0f; break;
+                default:              g = shadow_silu(g); break;
+            }
+            pact[r] = has_gate ? g * u : g;
+        }
+
+        if (!shadow_gemv(pd, w_down, pact, n_ff, n_embd, prow, pvo)) {
+            ggml_moe_shadow_run_error("dequant/gemv failed (down)"); st.failed = 1; continue; }
+        for (int64_t c = 0; c < n_embd; c++) out[c] += wn * pvo[c];
+    }
+}
+
+void llm_shadow_moe_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) return;   // n_tasks = 1 (결정론 — 섀도는 재현성이 관측의 전제다)
+
+    const llm_shadow_moe_ud & ud = *(const llm_shadow_moe_ud *) userdata;
+
+    const ggml_tensor * src_cur = dst->src[0];   // [n_embd, n_tokens]  F32
+    const ggml_tensor * src_ids = dst->src[1];   // [n_used, n_tokens]  I32
+    const ggml_tensor * src_w   = dst->src[2];   // [1, n_used, n_tokens] F32
+
+    const int64_t n_embd   = src_cur->ne[0];
+    const int64_t n_tokens = src_cur->ne[1];
+    const int32_t n_used   = ud.n_expert_used;
+
+    std::memset(dst->data, 0, ggml_nbytes(dst));
+
+    // 지원 밖 형상이면 sparse 기여 0 + all_dropped=1 로 **눈에 보이게** 남긴다
+    // (조용히 틀린 값을 내는 것보다 판독기에서 100% all_dropped 로 드러나는 편이 옳다).
+    // ★M1 — 경고 로깅은 build 시점(드라이버 스레드)으로 옮겼다. `LLAMA_LOG_*` 는 128B 초과
+    //   메시지에서 `new char[]` 를 잡는데(llama-impl.cpp:46), 이 자리는 OpenMP 계산 영역이라
+    //   그 할당이 던지면 드라이버 catch 도달이 보장되지 않는다.
+    if (ud.unsupported) {
+        int32_t pred_na[GGML_MOE_SHADOW_PRED_CAP];
+        for (int i = 0; i < GGML_MOE_SHADOW_PRED_CAP; i++) pred_na[i] = -1;
+        // 예측이 없는 층이므로 route_ready 는 "여기서 그렇게 판정한 시각"이다
+        // (begin <= route_ready <= end 순서 계약은 유지한다).
+        const uint64_t t_layer_begin = shadow_layer_window_qpc();
+        const uint64_t t_route_ready = ggml_moe_phasea_now_qpc();
+        ggml_moe_shadow_layer_record(ud.layer_id, pred_na, 0, 0, 0.0f, /*all_dropped=*/1,
+                                     ud.stride_bytes, t_route_ready, t_layer_begin,
+                                     ggml_moe_phasea_now_qpc());
+        return;
+    }
+
+    const bool     merged = (ud.gate_up_exps != nullptr);
+    const ggml_tensor * w_gate = merged ? ud.gate_up_exps : ud.gate_exps;
+    const ggml_tensor * w_up   = merged ? ud.gate_up_exps : ud.up_exps;
+    const ggml_tensor * w_down = ud.down_exps;
+    if (!w_gate || !w_down) return;
+
+    // merged 는 [n_ff*2, n_embd, n_expert] — 앞 n_ff 가 gate, 뒤 n_ff 가 up.
+    const int64_t n_ff = merged ? (w_gate->ne[1] / 2) : w_gate->ne[1];
+    const bool    has_gate = merged || (ud.gate_exps && ud.up_exps);
+
+    // ★M1 — 작업 버퍼는 build 시점에 확보된 것만 쓴다. **여기서는 절대 할당하지 않는다.**
+    //   부족/미확보는 이론상 불가(크기가 같은 소스에서 나온다)지만, 그래도 계산하지 않고
+    //   fail-close 한다 — 콜백이 OpenMP 계산 영역 안이라 여기서 던질 수는 없기 때문이다.
+    llm_shadow_moe_scratch * const sc = ud.scratch;
+    if (!sc || !sc->ready || sc->cap_embd < n_embd || sc->cap_ff < n_ff ||
+        sc->cap_vg < (merged ? n_ff * 2 : n_ff)) {
+        ggml_moe_shadow_run_error("shadow scratch not pre-reserved for this layer");
+        return;
+    }
+
+    int32_t  pred[GGML_MOE_SHADOW_PRED_CAP];
+    float    wt  [GGML_MOE_SHADOW_PRED_CAP];
+
+    for (int64_t t = 0; t < n_tokens; t++) {
+        // ── ⓪ 층 창 시작(라우터 앞) — 직전 층 레코드의 end(첫 층이면 step_begin). ──
+        //     루프 안에서 매번 집는 이유: n_tokens>1 이면 토큰마다 레코드가 1행씩 나가므로
+        //     커서도 그때마다 전진한다 — 그래야 토큰별 span 이 겹치지 않는다.
+        const uint64_t t_layer_begin = shadow_layer_window_qpc();
+
+        // ── ① all-expert 라우터 top-k P 를 **먼저** 확보(마스크 이전 원값) ──
+        const int32_t n_pred = n_used > GGML_MOE_SHADOW_PRED_CAP ? GGML_MOE_SHADOW_PRED_CAP : n_used;
+        for (int32_t i = 0; i < GGML_MOE_SHADOW_PRED_CAP; i++) pred[i] = -1;
+        for (int32_t i = 0; i < n_pred; i++) {
+            pred[i] = *(const int32_t *) ((const char *) src_ids->data + t * src_ids->nb[1] + i * src_ids->nb[0]);
+            wt[i]   = *(const float   *) ((const char *) src_w->data   + t * src_w->nb[2]   + i * src_w->nb[1]);
+        }
+        const uint64_t t_route_ready = ggml_moe_phasea_now_qpc();
+
+        // ── ② P ∩ resident (tick-중립 조회 · 읽기 제출 0) ──
+        uint16_t mask = 0;
+        const int32_t n_present = ggml_moe_shadow_view_present_mask(ud.mlpos, pred, n_pred, &mask);
+
+        // ── ③ D2 본체(재정규화 + 마스크 GEMV) — test calibration 과 **공유하는 함수** ──
+        //     dst 는 위에서 통째로 0 으로 밀어 두었으므로 out 은 이미 0 이다.
+        llm_shadow_token_stat st;
+        shadow_moe_token_body(ud, *sc, w_gate, w_up, w_down, merged, has_gate,
+                              n_embd, n_ff,
+                              (const char *) src_cur->data + t * src_cur->nb[1],
+                              (size_t) src_cur->nb[0],
+                              pred, wt, n_pred, mask, n_present,
+                              (float *) ((char *) dst->data + t * dst->nb[1]),
+                              st);
+
+        // ── ④ 층 레코드(kind=5) — P 는 마스크 **이전** 원값을 그대로 싣는다 ──
+        ggml_moe_shadow_layer_record(ud.layer_id, pred, n_pred, mask, st.mass_ratio,
+                                     st.all_dropped, ud.stride_bytes,
+                                     t_route_ready, t_layer_begin, ggml_moe_phasea_now_qpc());
+    }
+}
+
+} // namespace
+
+ggml_tensor * llm_graph_context::build_moe_shadow_experts(
+        ggml_tensor * cur,
+        ggml_tensor * selected_experts,
+        ggml_tensor * weights,
+        ggml_tensor * gate_exps,
+        ggml_tensor * up_exps,
+        ggml_tensor * down_exps,
+        ggml_tensor * gate_up_exps,
+        ggml_tensor * gate_exps_b,
+        ggml_tensor * up_exps_b,
+        ggml_tensor * down_exps_b,
+        ggml_tensor * gate_up_exps_b,
+        ggml_tensor * up_exps_s,
+        ggml_tensor * gate_exps_s,
+        ggml_tensor * down_exps_s,
+            int64_t   n_expert_used,
+    llm_ffn_op_type   type_op,
+               bool   weight_before_ffn,
+                int   il) const {
+    const int64_t n_embd   = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+
+    GGML_ASSERT(il >= 0 && il < LLAMA_MAX_LAYERS);
+    llm_shadow_moe_ud & ud = g_shadow_ud[il];
+
+    ud = llm_shadow_moe_ud{};
+    ud.gate_exps     = gate_exps;
+    ud.up_exps       = up_exps;
+    ud.down_exps     = down_exps;
+    ud.gate_up_exps  = gate_up_exps;
+    ud.layer_id      = il;
+    ud.n_expert_used = (int32_t) n_expert_used;
+    ud.type_op       = (int32_t) type_op;
+    ud.arch_ds4      = (arch == LLM_ARCH_DEEPSEEK4) ? 1 : 0;
+    ud.swiglu_limit  = (il >= 0) ? hparams.swiglu_clamp_exp[il] : 0.0f;
+
+    // present 조회 키(mlpos)와 byte 가중치(stride)는 direct 모듈 등록 정보가 권위다.
+    const ggml_tensor * anchor = gate_up_exps ? gate_up_exps : (gate_exps ? gate_exps : down_exps);
+    ud.mlpos        = ggml_moe_shadow_mlpos_of(anchor);
+    ud.stride_bytes = (uint32_t) ggml_moe_shadow_layer_stride_bytes(ud.mlpos);
+
+    // 지원 밖 형상 — bias/scale 텐서·llama4 의 weight_before_ffn 은 이 경로에 없다.
+    if (gate_exps_b || up_exps_b || down_exps_b || gate_up_exps_b ||
+        up_exps_s || gate_exps_s || down_exps_s || weight_before_ffn || ud.mlpos < 0) {
+        ud.unsupported = 1;
+    }
+
+    // ★r2 차단 M1 수리 — 콜백의 작업 버퍼를 **여기서**(드라이버 스레드·graph build) 확보한다.
+    //   크기는 n_embd / n_ff 로 이 시점에 이미 확정돼 있다. 콜백은 OpenMP 계산 영역 안에서
+    //   불리므로 거기서 할당(→ 잠재적 bad_alloc)을 남겨 두면 예외가 드라이버 catch 에 도달
+    //   한다는 보장이 없다. 확보 실패는 던지지 않고 run_error latch + 그 층 unsupported 로
+    //   닫는다(사이드카 complete=0 → 판독기 fail-close).
+    ud.scratch = &g_shadow_scratch[il];
+    {
+        // op 이 쓰는 것과 **같은 소스**에서 n_ff 를 뽑는다(merged 는 [n_ff*2, n_embd, n_expert]).
+        const ggml_tensor * w_gate_b = gate_up_exps ? gate_up_exps : gate_exps;
+        if (!ud.unsupported && w_gate_b && down_exps) {
+            const int64_t n_ff_b = gate_up_exps ? (w_gate_b->ne[1] / 2) : w_gate_b->ne[1];
+            if (!shadow_scratch_reserve(*ud.scratch, n_embd, n_ff_b, gate_up_exps != nullptr)) {
+                // latch 는 shadow_scratch_reserve() 안에서 이미 섰다(r3 M1 — 단일 지점).
+                ud.unsupported = 1;
+            }
+        }
+        // w_gate_b/down_exps 가 없는 층은 콜백이 계산 전에 반환한다(기존 동작 유지) —
+        // 스크래치도 필요하지 않다.
+    }
+
+    // ★M1 — 지원 밖 형상 경고는 **build 시점에서** 1회 낸다. 예전엔 콜백 안에서 냈는데,
+    //   LLAMA_LOG_* 는 128B 초과 메시지에서 heap 을 잡으므로(llama-impl.cpp:46) OpenMP
+    //   계산 영역 안에 예외 발생점을 하나 남겨 두는 셈이었다.
+    if (ud.unsupported) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            LLAMA_LOG_WARN("%s: shadow MoE path does not support this layer shape "
+                           "(bias/scale/weight_before_ffn/unregistered/oom) - sparse contribution "
+                           "is 0 and all_dropped=1 is recorded for every such layer (first at il=%d)\n",
+                           __func__, il);
+        }
+    }
+
+    ggml_tensor * args[3] = { cur, selected_experts, weights };
+    ggml_tensor * out = ggml_custom_4d(ctx0, GGML_TYPE_F32, n_embd, n_tokens, 1, 1,
+                                       args, 3, llm_shadow_moe_op, /*n_tasks=*/1, (void *) &ud);
+    cb(out, "ffn_moe_out_shadow", il);
+    ggml_build_forward_expand(gf, out);
+
+    return out;
+}
+
+// ===========================================================================
+// ★r2 차단 M3 수리 — D2 실 op known-output calibration 진입점 (**테스트 전용**)
+//
+//   문제(codex_shadow_impl_r2 미이행 ⓒ): `llm_shadow_moe_op` 은 익명 네임스페이스에 있어
+//   다른 TU 가 닿을 수 없었다. 그래서 P43g 는 스스로 "산식 오라클이지 실 custom op 이
+//   아니다"라고 선언할 수밖에 없었고, D2 값의 신뢰성이 미검증으로 남았다.
+//
+//   해법: 토큰 1개의 D2 본체를 `shadow_moe_token_body()` 로 뽑아, **실 op 과 이 함수가
+//   같은 함수를 호출**한다. 산식·클램프·활성함수·fail-close 처분 중 하나라도 실 경로에서
+//   회귀하면 이 calibration 이 즉시 다른 값을 낸다(재구현 사본이 아니다).
+//
+//   프로덕션과 갈리는 지점은 **단 하나**, 전문가 가중치 주소 해석이다:
+//     · 프로덕션 : `ggml_moe_shadow_view_ptr()` (캐시 view 스냅샷 · tick-중립)
+//     · 픽스처   : 호출자가 준 F32 배열 + 전문가 stride (`llm_shadow_moe_ud::test_bases`)
+//   residency 판정도 캐시가 없는 단위 테스트 환경이라 `present_mask` 로 직접 주입한다.
+//   그래프가 만드는 `g_shadow_ud[]` 는 `test_bases` 를 절대 채우지 않으므로, 라이브 경로가
+//   이 분기로 새는 일은 없다.
+//
+// ── 인자 계약 ───────────────────────────────────────────────────────────────
+//   x          [n_embd]                     연속 F32 토큰 입력
+//   n_embd     > 0, n_ff > 0
+//   pred       [n_pred]                     마스크 **이전** 라우터 top-k 전문가 id
+//   wt         [n_pred]                     그 원 gate weight(routed scale 포함 그대로)
+//   n_pred     0 .. GGML_MOE_SHADOW_PRED_CAP(16)
+//   present_mask                            비트 i = pred[i] 상주 여부(bits[n_pred..15] 무시)
+//   gate_w     [n_expert][n_ff  ][n_embd]   연속 F32 (행 = n_embd 성분, 행 수 = n_ff)
+//   up_w       ↓ 세 가지 모드를 이 인자 하나로 고른다
+//                · up_w == nullptr          → gate 곱 없음(has_gate=false). u = 1.0
+//                · up_w == gate_w           → **merged gate_up**. gate_w 는
+//                                             [n_expert][2*n_ff][n_embd], 앞 n_ff = gate,
+//                                             뒤 n_ff = up
+//                · 그 밖의 non-null         → 분리형. up_w 는 [n_expert][n_ff][n_embd]
+//   down_w     [n_expert][n_embd][n_ff  ]   연속 F32 (행 = n_ff 성분, 행 수 = n_embd)
+//   n_expert   > 0. present 로 표시된 pred[i] 는 반드시 [0, n_expert) 안이어야 한다
+//   type_op    llm_ffn_op_type (LLM_FFN_SILU=0 … 실 op 과 동일 도메인)
+//   out        [n_embd]                     함수가 먼저 0 으로 밀고 결과를 쓴다
+//
+//   ★고정값: swiglu_limit = 0, arch_ds4 = 0 (클램프 분기 비활성). 클램프까지 재려면
+//     이 진입점을 확장해야 한다 — 현재 D2 재정규화 검증에는 필요 없다.
+//
+// ── 반환 ───────────────────────────────────────────────────────────────────
+//    0  성공. all_dropped(= present 질량 0)면 out 은 전부 0 이고 반환도 0 이다.
+//   -1  필수 포인터가 null
+//   -2  차원/개수가 범위 밖
+//   -3  present 로 표시된 pred[i] 가 [0, n_expert) 밖
+//   -4  스크래치 확보 실패(OOM)
+//   -5  실 본체가 fail-close 를 걸었다(ggml_moe_shadow_run_error latch) — 결과 신뢰 불가
+// ===========================================================================
+extern "C" LLAMA_API int llama_shadow_moe_op_calibrate(
+        const float * x, int64_t n_embd, int64_t n_ff,
+        const int32_t * pred, const float * wt, int32_t n_pred,
+        uint16_t present_mask,
+        const float * gate_w, const float * up_w, const float * down_w,
+        int32_t n_expert, int32_t type_op,
+        float * out) {
+    if (!x || !pred || !wt || !gate_w || !down_w || !out) {
+        return -1;
+    }
+    if (n_embd <= 0 || n_ff <= 0 || n_expert <= 0) {
+        return -2;
+    }
+    if (n_pred < 0 || n_pred > GGML_MOE_SHADOW_PRED_CAP) {
+        return -2;
+    }
+
+    const bool merged   = (up_w != nullptr && up_w == gate_w);
+    const bool has_gate = (up_w != nullptr);
+
+    // present 비트 계약은 kind=5 레코드와 동일하다 — bits[n_pred..15] 는 0 으로 자른다.
+    const uint16_t mask = (uint16_t) (n_pred >= 16
