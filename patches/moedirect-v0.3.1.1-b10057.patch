+static void test_v3_io3() {
+    section("V3g. mode=virtual 원자 A5 — IO3 사이드카 wire(MOEIO3 · §5·§8)");
+
+    std::wstring dir1 = make_case_dir("v3_io3_on");
+    std::wstring pfx1 = dir1 + L"\\io3";
+    Io3Arm arm1;
+    // ★R12 — 엔진 축 스냅샷(reset 전에 집는다). wire 는 이 값들의 **사본**이므로 둘을 대조하면
+    //   "행이 실값을 담는가"가 관문이 된다(사본이 원본과 갈리면 여기서 깨진다).
+    int32_t  e_par[6] = { 0, 0, 0, 0, 0, 0 };
+    uint8_t  e_src[6] = { 0, 0, 0, 0, 0, 0 };
+    uint64_t e_pending = 0, e_immediate = 0, e_rf_ops = 0, e_rf_digest = 0;
+    int32_t  e_rows_alloc = 0;
+    {
+        EnvGuard e1("MOE_DIRECT_IO3", "on"), e2("MOE_DIRECT_IO3_OUT", wide_to_utf8(pfx1).c_str());
+        V3Fixture fx;
+        V3Live lv = v3_seal_live(fx, "v3_io3_fx", /*n_shards=*/1, "8", /*bounce=*/true);
+        if (!check(lv.ok, "V3g1a. IO3 on 픽스처 seal [" + lv.why + "]")) { ggml_moe_direct_reset_for_test(); return; }
+        ggml_tensor * gate0 = fx.find("blk.0.ffn_gate_exps.weight");
+        int32_t ids[3] = { 1, 4, 6 };
+        ggml_moe_direct_acquire(gate0, ids, 3, 1);
+        ggml_moe_direct_release(gate0, ids, 3);
+        ggml_moe_direct_finalize();          // ★flush 는 여기 1회
+        ggml_moe_direct_test_v3_io_stats(e_par, e_src, &e_pending, &e_immediate,
+                                         &e_rf_ops, &e_rf_digest, &e_rows_alloc);
+        ggml_moe_direct_reset_for_test();
+    }
+    std::string why;
+    if (!check(arm1.load(pfx1, why), "V3g1. IO3 3파일 생성·헤더/크기/payload digest 정합 [" + why + "]")) return;
+
+    check(arm1.recs.size() == 3 && arm1.kids.size() == 6 && arm1.cps.size() == 3,
+          "V3g2. ★채널 3분리 실측 — records " + std::to_string(arm1.recs.size()) +
+          "(논리 record) · children " + std::to_string(arm1.kids.size()) +
+          "(물리 read = record×part) · copies " + std::to_string(arm1.cps.size()) +
+          "(바운스 part 1개×3 record) = 'record 1건=물리 read 1건'이 깨진 구조가 wire 에 그대로");
+
+    const std::string v = io3_verify(arm1);
+    check(v.empty(), "V3g3. ★★§5-6 완전성 — event namespace 조밀·무중복(0..2N-1) · cardinality · "
+                     "bounce obligation 전건 · copies 조인 · §5-5 시각 규약 · QD 재생 · "
+                     "★cap 준수 **6항**(total·reserve·prefetch child·part·copy queue·worker busy — R13) [" +
+                     (v.empty() ? "OK" : v) + "]");
+
+    // ★F1 — 같은 결손을 **wire 쪽에서도** 잠근다. `io3_verify` 의 §5-5 시각 규약은 일관성
+    //   조건(worker==0xFF ⟺ start==0)이라 "한 줄도 안 찍힌 행"을 통과시킨다 — 이 arm 은 전
+    //   record 가 성공 publish 된 런이므로 copies 3행은 **실행된 것으로** 기록돼 있어야 한다.
+    {
+        bool exec_ok = (arm1.cps.size() == 3);
+        for (const auto & c : arm1.cps) {
+            if (c.status != 1 || c.worker == 0xFF) exec_ok = false;
+            if (c.enqueue_qpc == 0 || c.start_qpc == 0 || c.done_qpc == 0) exec_ok = false;
+        }
+        check(exec_ok,
+              "V3g3b. ★★copies 행이 **채워져 있다** — 성공 publish 런의 바운스 copy 전건이 "
+              "status=OK · worker 실값 · enqueue/start/done 실시각(행 개수만 맞고 내용이 비면 "
+              "일관성 검사는 통과하므로 이 양성 조건이 따로 필요하다)");
