+// ===========================================================================
+// ★`--gpuearly-emit <prefix>` — **실 producer 모드**(교차 r5 ② · L:fixture-real-path).
+//
+//   러너 selfcheck 가 `.gc` 를 손으로 조립하면 판독기가 **자기 사본**을 읽는 것이라
+//   producer↔reader ABI 를 전혀 행사하지 못한다(이 트랙에서 같은 은폐가 두 번 났다:
+//   `removed` 반환형 · plan sha 규약). 이 모드는 **프로덕션 wire writer 를 그대로 태워**
+//   실제 `.gc` 를 남기고, 커밋한 내용을 JSON manifest 로 stdout 에 찍는다. 러너는 그 파일을
+//   파싱해 manifest 와 대조한다 — 쓴 쪽이 선언한 것과 읽은 쪽이 읽은 것이 어긋나면 곧 ABI 결함.
+//
+//   ★manifest 는 사본이 아니다: 아래 커밋 호출과 **같은 값**에서 생성되므로, writer 가 필드를
+//   뭉개면 파일만 바뀌고 manifest 는 그대로여서 대조가 붉어진다.
+//   ★CUDA 불요 — ggml-base 측 wire 경로만 탄다(그래서 GPU 없이도 ABI 를 행사할 수 있다).
+// ===========================================================================
+static int run_gpuearly_emit_child(const char * prefix) {
+    if (!prefix || !prefix[0]) {
+        fprintf(stderr, "--gpuearly-emit needs an output prefix\n");
+        return 2;
+    }
+    set_env("MOE_DIRECT_GPUEARLY", "1");
+    set_env("MOE_DIRECT_GPUEARLY_OUT", prefix);
+    set_env("MOE_DIRECT_GPUEARLY_MAX_MB", "1");
+    ggml_moe_gpuearly_reset_for_test();
+
+    const uint64_t boot = 0x0F1E2D3C4B5A6978ull;
+    ggml_moe_gpuearly_note_seal(boot);
+    if (!ggml_moe_gpuearly_enabled()) {
+        fprintf(stderr, "gpuearly probe did not arm - cannot emit\n");
+        return 3;
+    }
+
+    struct EmitRow {
+        uint64_t bseq; uint32_t layer, path, flags, occ;
+        uint64_t dns, sq, aq, uid;
+    };
+    const uint32_t FV = GGML_MOE_GPUEARLY_FLAG_VALID;
+    const uint32_t FD = GGML_MOE_GPUEARLY_FLAG_EXCLUDED_DIRECT;
+    const uint32_t FW = GGML_MOE_GPUEARLY_FLAG_EXCLUDED_WARMUP;
+    // 결정론적 스트림 — 분류 4종(eligible 3 · direct 1 · warmup 1 · invalid 1) 전부 덮는다.
+    const EmitRow rows[] = {
+        { 11, 0, GGML_MOE_GPUEARLY_ROUTER_FUSED,   FV,           0, 1500, 100, 101, 900 },
+        { 11, 1, GGML_MOE_GPUEARLY_ROUTER_ARGSORT, FV,           0, 2500, 100, 101, 900 },
+        { 12, 0, GGML_MOE_GPUEARLY_ROUTER_FUSED,   FV,           1, 1600, 200, 201, 901 },
+        {  0, 2, GGML_MOE_GPUEARLY_ROUTER_ARGSORT, FV | FD | FW, 0,    0,   0,   0, 902 },
+        {  0, 3, GGML_MOE_GPUEARLY_ROUTER_FUSED,   FV | FW,      0,    0,   0,   0, 903 },
+        { 13, 4, GGML_MOE_GPUEARLY_ROUTER_FUSED,   0,            0,    0, 300, 301, 904 },
+    };
+    const size_t n_rows = sizeof(rows) / sizeof(rows[0]);
+
+    printf("{\"schema\":\"gpuearly-emit-1\",\"boot_id\":%llu,\"rows\":[",
+           (unsigned long long) boot);
+    for (size_t i = 0; i < n_rows; i++) {
+        const EmitRow & r = rows[i];
+        ggml_moe_gpuearly_commit(r.bseq, r.layer, r.path, r.flags, r.occ, r.dns, r.sq, r.aq,
+                                 r.uid);
+        printf("%s{\"boundary_seq\":%llu,\"layer\":%u,\"router_path\":%u,\"flags\":%u,"
+               "\"occurrence\":%u,\"delta_tail_gpu_ns\":%llu,\"sync_return_qpc\":%llu,"
+               "\"a1_qpc\":%llu,\"graph_uid\":%llu}",
+               i ? "," : "", (unsigned long long) r.bseq, r.layer, r.path, r.flags, r.occ,
+               (unsigned long long) r.dns, (unsigned long long) r.sq,
+               (unsigned long long) r.aq, (unsigned long long) r.uid);
+    }
+    printf("]}\n");
+    fflush(stdout);
+
+    ggml_moe_gpuearly_flush();
+    return 0;
+}
