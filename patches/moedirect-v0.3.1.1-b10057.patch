+// ===========================================================================
+// V3a — 픽스처 자체 계약(§2-2·§2-4 산술이 픽스처 안에서 닫히는가)
+//   이 그룹이 먼저 서야 뒤의 소비자 검사가 "엔진이 틀렸다"를 말할 수 있다. 픽스처가 낸 좌표가
+//   실 GGUF 와 어긋나면 그건 엔진 결함이 아니라 하네스 결함이다.
+// ===========================================================================
+static void test_v3_fixture() {
+    section("V3a. mode=virtual 픽스처 자체 계약(실물 GGUF + §2-4 슬롯 산술)");
+
+    V3Fixture fx;
+    fx.dir = make_case_dir("v3_fixture");
+    fx.model = default_v3_model(/*n_shards=*/2);
+    std::string why;
+    const bool built = fx.build(why);
+    if (!check(built, "V3a1. 합성 shard(실물 GGUF 2개) + manifest v3 + plan_report 생성" +
+                      (built ? std::string() : std::string(" — 실패: ") + why))) return;
+
+    // ① 생산 layout 좌표 == **C++ GGUF 파서의 독립 되읽기**(data_offset + tensor_offset).
+    //   ★C1 수리(초안 C §10-1 · Codex r8 항목 1·2·7): 구 판은 물리 파일 순서를 layer-major 로
+    //     가정해 누적 패딩합으로 예측했다. 그러나 `--part-spec` 생산 경로의 물리 순서는
+    //     **kind-major**(`make_v3_fixture.py:268` extra 순서 · `repack_experts.py:4325` drop+append)이고
+    //     layout 은 canonical layer-major(`repack_experts.py:597`)라 **예측만 틀렸다**(좌표 자체는 정합).
+    //     ⇒ 파일순서·패딩 누적 산술은 재구현하지 않고, 선언 shard 의 GGUF 디렉토리에서
+    //     좌표를 독립 재도출해 대조한다. `gguf_get_tensor_offset` 은 음수 ID 에 assert 하므로
+    //     (`gguf.cpp:1179`) `gguf_find_tensor` 성공을 먼저 확인하고, 합산은 overflow-safe 하게 한다.
+    bool offsets_ok = true, all_in_file = true;
+    for (auto & L : fx.model.layers) {
+        for (auto & part : L.parts) {
+            const size_t si = (size_t)part.source_index;
+            if (si >= fx.gcs.size() || !fx.gcs[si]) { offsets_ok = false; continue; }
+            const int64_t tid = gguf_find_tensor(fx.gcs[si], part.source_tensor.c_str());
+            if (tid < 0) { offsets_ok = false; continue; }
+            const uint64_t ds  = (uint64_t)gguf_get_data_offset(fx.gcs[si]);
+            const uint64_t rel = (uint64_t)gguf_get_tensor_offset(fx.gcs[si], tid);
+            if (ds > (uint64_t)-1 - rel || part.abs_offset != ds + rel) offsets_ok = false;
+            const uint64_t tensor_bytes = part.slice_bytes * (uint64_t)fx.model.n_expert;
+            if (part.abs_offset + tensor_bytes > fx.shard_bytes[si]) all_in_file = false;
+        }
+    }
+    check(offsets_ok, "V3a2. abs_offset(GGUF 되읽기) == data_start + 누적 패딩합(해석적 예측)");
+    check(all_in_file, "V3a3. 전 part payload 가 shard EOF 안(abs_offset + n_expert*slice <= source.bytes)");
+
+    // ② §2-4 슬롯 산술 점화식·A 배수 불변식.
+    bool recur_ok = true, mult_ok = true, head_ok = true, stride_ok = false;
+    uint64_t max_lsb = 0;
+    for (auto & L : fx.model.layers) {
+        uint64_t so = 0;
+        for (auto & part : L.parts) {
+            if (part.slot_offset != so) recur_ok = false;
+            if (part.region % fx.A != 0) mult_ok = false;
+            if (part.aligned) {
+                if (part.bracket_head != part.abs_offset % fx.A) head_ok = false;
+                if (part.data_offset != part.slot_offset + part.bracket_head) head_ok = false;
+                if (part.region != ceil_to(part.bracket_head + part.slice_bytes, fx.A)) recur_ok = false;
+            } else if (part.data_offset != part.slot_offset) {
+                head_ok = false;
+            }
+            so += part.region;
+        }
+        if (L.layer_slot_bytes != so) recur_ok = false;
+        if (so % fx.A != 0) mult_ok = false;
+        if (so > max_lsb) max_lsb = so;
+    }
+    stride_ok = (fx.slot_stride_max == max_lsb) && (fx.slot_stride_max % fx.A == 0);
+    check(recur_ok,  "V3a4. slot_offset 점화식 + region=align_up(h+slice,A) + layer_slot_bytes=sum(region)");
+    check(mult_ok,   "V3a5. region·layer_slot_bytes 전부 A 배수");
+    check(head_ok,   "V3a6. bracket_head=abs_offset%A · data_offset=slot_offset+bracket_head(비4K=slot_offset)");
+    check(stride_ok, "V3a7. slot_stride_max == max(layer_slot_bytes) · A 배수");
+
+    // ③ bracket_head 가 실제로 0 이 아닌 part 가 있어야 이 픽스처가 그 경로를 행사한다
+    //    (GGUF 정렬 32 를 고른 이유 — 4096 이면 전부 0 이라 경로가 죽는다).
+    bool any_head = false;
+    for (auto & L : fx.model.layers) for (auto & part : L.parts) if (part.aligned && part.bracket_head != 0) any_head = true;
+    check(any_head, "V3a8. bracket_head != 0 인 part 가 존재(비자명 브라켓 경로 행사 가능)");
+
+    // ④ §2-2 bin 전용 좌표 필드 부재 — 있으면 그 자체가 기동 중단 사유다.
+    const json & m = fx.manifest;
+    bool no_bin_fields = !m["totals"].contains("bin_file_bytes");
+    for (const auto & L : m["layout"]["layers"]) {
+        if (L.contains("record_base") || L.contains("stride_bytes") || L.contains("payload_bytes")) no_bin_fields = false;
+        for (const auto & P : L["parts"]) if (P.contains("part_offset") || P.contains("part_bytes")) no_bin_fields = false;
+    }
+    check(no_bin_fields, "V3a9. §2-2 bin 전용 필드 부재(record_base·stride_bytes·part_offset·bin_file_bytes)");
+
+    // ⑤ 총계·cardinality 폐합.
+    uint64_t payload = 0; int64_t nrec = 0;
+    for (auto & L : fx.model.layers) {
+        for (auto & part : L.parts) payload += part.slice_bytes * (uint64_t)fx.model.n_expert;
+        nrec += (int64_t)fx.model.n_expert * (int64_t)L.parts.size();
+    }
+    check(m["totals"]["virtual_payload_bytes"].get<uint64_t>() == payload &&
+          m["totals"]["n_records"].get<int64_t>() == nrec &&
+          (int64_t)m["records"].size() == nrec,
+          "V3a10. totals.virtual_payload_bytes = sum(slice*n_expert) · records cardinality = sum(n_expert*n_parts)");
+
+    // ⑥ plan_report 결속 키 — 재해시 == report.manifest_sha256 ∧ pass:true(§4-3 소비 결속의 재료).
+    const std::string on_disk_sha = sha256_file_hex(fx.dir + L"\\manifest.json");
+    json rep;
+    { std::ifstream ifs(fx.dir + L"\\plan_report.json", std::ios::binary); ifs >> rep; }
+    check(rep["pass"].get<bool>() == true &&
+          rep["manifest_sha256"].get<std::string>() == on_disk_sha &&
+          rep["cardinality"]["records"].get<int64_t>() == nrec,
+          "V3a11. plan_report: pass=true · manifest_sha256 == 디스크 manifest.json 실해시 · cardinality 일치");
+
+    // ⑦ DF-1 헤더 digest 가 실 파일 [0,data_start) 재해시와 일치.
+    bool digest_ok = true;
+    for (int32_t s = 0; s < fx.model.n_shards; s++) {
+        const std::wstring wp = utf8_to_wide(fx.shard_path[(size_t)s]);
+        if (fx.shard_digest[(size_t)s]["sha256"].get<std::string>() != v3_head_sha256(wp, fx.shard_data_start[(size_t)s]))
+            digest_ok = false;
+        if (fx.shard_digest[(size_t)s]["header_bytes"].get<uint64_t>() != fx.shard_data_start[(size_t)s])
+            digest_ok = false;
+    }
+    check(digest_ok, "V3a12. DF-1 sources[].digest = sha256(shard[0,data_start)) 재해시 일치");
+
+    ggml_moe_direct_reset_for_test();
+}
