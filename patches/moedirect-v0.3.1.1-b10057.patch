+int32_t ggml_moe_shadow_mlpos_of(const struct ggml_tensor * t) {
+    if (!t) return -1;
+    if (!g_mod.sealed.load(std::memory_order_acquire)) return -1;
+    auto it = g_mod.registry.find(t);
+    if (it == g_mod.registry.end()) return -1;
+    return it->second.mlpos;
+}
