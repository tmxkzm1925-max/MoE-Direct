+// ── P18. ★9-graph 지연 intent 의 too_late 정확 판정(R1 #8) ──
+static void test_pb_delayed_too_late() {
+    section("P18. ★지연 intent too_late 정확성 — 9 graph 이상 지연돼도 stale 로 왜곡되지 않는다(R1 #8)");
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; pb_setup_2layer(fx, "pb_delay");
+    if (!check(fx.seal((uint64_t)PB_TEST_N_EXPERT * fx.comp.slot_stride_max, 64) == 0, "P18a. seal 성공")) return;
+    ggml_tensor * g1 = fx.find("blk.1.ffn_gate_exps.weight");
+    ggml_moe_phaseb_run_begin();
+    // graph 0 에서 층 1 demand 를 치른다(= 그 graph 의 target 은 too_late 확정).
+    ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+    uint32_t req = 0, gep = 0, gseq0 = 0; uint8_t ph = 0;
+    ggml_moe_phaseb_current_epoch(&req, &gep, &gseq0, &ph);
+    int32_t e = 0;
+    ggml_moe_direct_acquire(g1, &e, 1, 1);
+    ggml_moe_direct_release(g1, &e, 1);
+    ggml_moe_phaseb_graph_end();
+    // graph 를 9개 더 진행(고정 8칸 링이면 graph 0 표식이 밀려나 stale 로 오판된다).
+    for (int i = 0; i < 9; i++) {
+        ggml_moe_phaseb_graph_begin(0, 1, /*n_outputs=*/1);
+        int32_t ei = (int32_t)(i % 7) + 1;
+        ggml_moe_direct_acquire(g1, &ei, 1, 1);
+        ggml_moe_direct_release(g1, &ei, 1);
+        ggml_moe_phaseb_graph_end();
+    }
+    const PbCtr c0 = pb_ctr();
+    pb_push_and_settle(req, gep, gseq0, 0, 1, {0,1,2,3,4,5,6,7});   // ★9 graph 지연된 intent
+    const PbCtr c1 = pb_ctr();
+    const uint64_t d_late  = c1.get(GGML_MOE_PB_C_PRE_DROPPED_TOO_LATE) - c0.get(GGML_MOE_PB_C_PRE_DROPPED_TOO_LATE);
+    const uint64_t d_stale = c1.get(GGML_MOE_PB_C_PRE_DROPPED_STALE)    - c0.get(GGML_MOE_PB_C_PRE_DROPPED_STALE);
+    check(d_late == 8 && d_stale == 0,
+          "P18b. ★★9 graph 지연 intent 전건 PRE_TOO_LATE(" + std::to_string(d_late) +
+          "/8) · PRE_STALE 0(" + std::to_string(d_stale) + ") — 고정 링이면 stale 로 왜곡된다");
+    ggml_moe_phaseb_run_end();
+}
