+        const uint64_t poff   = (uint64_t) st.comp.layers[0].parts[0].part_offset;
+        std::vector<bool> touched((size_t) total, false);
+        // The zero-fill is emitted at a SLAB BOUNDARY, not after every expert. The shared
+        // loop both emit surfaces run (ggml-moe-direct.cpp, the emit-slab-helper pinned
+        // region) computes `slab_boundary = (k == n_used - 1) || (used_ids[k + 1] != id + 1)`
+        // and only then emits the bounded tail. For a CONSECUTIVE used set that is exactly one
+        // tail, after the last expert - which is what XBE02 independently measures as zero=1.
+        // Expecting a tail after EVERY expert made the oracle contradict itself: for used
+        // {0,1} it demanded zeros at 65,536..66,047 and, one iteration later, the generator's
+        // bytes at the same addresses, so oracle=0 was structural and no run could have
+        // produced anything else. The rule below is the emit's rule, transcribed - the bytes
+        // checked and the strictness are unchanged.
+        for (size_t k = 0; k < cap.size(); k++) {
+            const int32_t id = cap[k];
+            const uint64_t base = (uint64_t) id * esz;
+            // NO early exit. Breaking at the first mismatch left the rest of this expert's
+            // range with touched=false, and the sentinel pass below then counted those same
+            // bytes as sentinel damage - one payload defect reported as two unrelated ones.
+            // The verdict was honest either way; the DIAGNOSIS was not, and a counter that
+            // misattributes is worse than no counter. Walking the whole range also makes
+            // bad_bytes mean what it says: the number of payload bytes that disagree with the
+            // generator, not the number of experts in which a disagreement was first seen.
+            for (uint64_t j = 0; j < esz && base + j < total; j++) {
+                touched[(size_t)(base + j)] = true;
+                if (dst_tok[(size_t)(base + j)] != bin_hash((uint64_t) id * stride + poff + j)) {
+                    n_bad_bytes++;
+                    oracle_ok = false;
+                }
+            }
+            const bool slab_boundary = (k + 1 == cap.size()) || (cap[k + 1] != id + 1);
+            if (!slab_boundary) continue;
+            const uint64_t slab_end = base + esz;
+            const uint64_t rem = slab_end < total ? total - slab_end : 0;
+            const uint64_t zlen = rem < XBE_ZPAD_MAX ? rem : XBE_ZPAD_MAX;
+            for (uint64_t j = 0; j < zlen; j++) {
+                touched[(size_t)(slab_end + j)] = true;
+                if (dst_tok[(size_t)(slab_end + j)] != 0) { n_bad_zero++; oracle_ok = false; }
+            }
+        }
