+    if (!(only && only[0] == '1' && only[1] == '\0')) {
+        cands.push_back({ L"py.exe -3 ",   "py.exe -3" });
+        cands.push_back({ L"python.exe ",  "python.exe" });
+        cands.push_back({ L"python3.exe ", "python3.exe" });
+    }
+    for (const auto & c : cands) {
+        std::string why;
+        if (sh_probe_interp(c.first, log_path, why)) {
+            g_py_interp = c.first; g_py_interp_src = c.second; g_py_env_state = 1;
+            printf("[P43-ENV] python interpreter OK: %s\n", g_py_interp_src.c_str());
+            return;
+        }
+        if (!g_py_env_diag.empty()) g_py_env_diag += " · ";
+        g_py_env_diag += c.second + " -> " + why;
+    }
+    g_py_env_state = 2;
+    printf("[P43-ENV] python interpreter UNAVAILABLE (%s)\n"
+           "[P43-ENV] ★the P43 production-reader checks cannot run on this host - their failures are an "
+           "ENVIRONMENT SHORTFALL, not a regression. Pin one with MOE_SELFTEST_PYTHON=<path to python.exe>.\n",
+           g_py_env_diag.c_str());
+}
