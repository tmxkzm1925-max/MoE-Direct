+              "각 레코드 SHA 가 .lmtidx 3줄과 seq 순서대로 일치(G-L0 판독기와 같은 규율)");
+        check(externs_ok,
+              "P40p. ★externs 노출 — .lmtidx 전 줄이 externs=0(그래프 밖 참조 없음). "
+              "G-L0 는 대상 프리필 레코드 전건 externs=0 을 fail-close 조건으로 요구한다");
+    }
+
+    // --- ⑨ ★abort 상태 리셋(R13 ③4 REACHABLE 결함 회귀 관문) ---------------
+    //   abort 가 상태기계를 idle 로 되돌리지 않으면, 실패 뒤 도착한 프리필이 이전 요청에
+    //   합쳐져 segments 가 누적된다. 아래는 그 합쳐짐이 일어나지 않음을 값으로 고정한다.
+    {
+        EnvGuard g1("MOE_DIRECT_LMTRACE", "1");
+        EnvGuard g2("MOE_DIRECT_LMTRACE_OUT", wide_to_utf8(dir + L"\\h").c_str());
+        ggml_moe_lmtrace_test_reset();
+
+        ggml_moe_lmtrace_graph_boundary(1, 512);   // 요청 0 개시
+        ggml_moe_lmtrace_graph_boundary(1, 512);   // 요청 0 · 세그먼트 2
+        ggml_moe_lmtrace_request_abort();          // 실패 폐합 + idle 복귀
+        ggml_moe_lmtrace_graph_boundary(1, 512);   // ★새 요청 1 이어야 한다(합쳐지면 결함)
+        ggml_moe_lmtrace_request_finish();
+
+        uint64_t req = 0;
+        ggml_moe_lmtrace_counters(nullptr, nullptr, nullptr, nullptr, &req);
+        check(req == 2, "P40q. abort 후 다음 프리필이 **새 요청**으로 열린다(요청 2건)");
+    }
+    ggml_moe_lmtrace_test_reset();
+    {
+        const std::vector<std::string> lines = lm_s0::read_lines(dir + L"\\h.lmtreq");
+        const bool ok = lines.size() == 2 &&
+                        lines[0].find("\"status\":\"abort\"")  != std::string::npos &&
+                        lines[0].find("\"segments\":2")        != std::string::npos &&
+                        lines[1].find("\"status\":\"finish\"") != std::string::npos &&
+                        lines[1].find("\"segments\":1")        != std::string::npos;
+        check(ok,
+              "P40r. ★abort 회귀 관문 — 1행 status=abort/segments=2, 2행 status=finish/segments=1. "
+              "상태 리셋이 빠지면 2행이 사라지고 1행 segments 가 3으로 합쳐진다");
+    }
+
+    // 다음 suite 에 상태가 새지 않도록 정리(env 는 EnvGuard 가 이미 복원).
+    ggml_moe_lmtrace_test_reset();
+}
