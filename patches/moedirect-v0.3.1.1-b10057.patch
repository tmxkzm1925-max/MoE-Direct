+            for (int32_t e : { 1, 4 }) for (int32_t p : { 0, 1 }) parity = parity && v3_verify_ptr_bytes(fx, 0, p, e);
+            ggml_moe_direct_release(gate0, ids, 2);
+            ggml_moe_direct_test_v3_io_stats(nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, &rows);
+            check(rows == 0 && parity,
+                  "V3g14. ★§5-1 기본 off = **무할당** — IO3 병렬표 원소 " + std::to_string(rows) +
+                  "개(op_row+chan_row) · 소비 경로 바이트는 그대로 정확");
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+
+    // ---- ★R12 ⑥ §3-1 전용 env — precedence·하한·미시공 노브의 fail-close ----
+    //   ★R14 후속(리드 조건 1) — 거부는 **출구를 함께 줘야** 한다: 진단문에 ①요구 하한값
+    //   ②처방(값 상향 / 키 unset → 기본값 경로)이 실제로 들어 있는지를 관문이 직접 잠근다.
