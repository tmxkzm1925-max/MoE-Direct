+
+static const int32_t  PB_HINT_N_EXPERT = 128;                  // 사다리 ③ ⓪gpt-oss 형상(128E·offset 64)
+static const uint64_t PB_FNV_INIT      = 0xcbf29ce484222325ull;
+
+// 오힌트 env 는 **항상 qualifier 와 세트**로 다룬다(§1 qualification-only 결속).
+struct PbHintEnv {
+    EnvGuard hint, qualify;
+    PbHintEnv(const char * hint_v, const char * qualify_v)
+        : hint("MOE_DIRECT_PHASEB_TEST_HINT", hint_v), qualify("MOE_DIRECT_QUALIFY", qualify_v) {}
+};
+
+static json pb_hint_read_header(const std::wstring & path) {
+    std::ifstream ifs(path, std::ios::binary);
+    std::string line;
+    while (std::getline(ifs, line)) {
+        while (!line.empty() && (line.back()=='\r'||line.back()=='\n')) line.pop_back();
+        if (line.empty()) continue;
+        json j = json::parse(line, nullptr, false);
+        if (j.is_object() && j.value("type","") == "header") return j;
+    }
+    return json::object();
+}
+
+static std::vector<json> pb_hint_read_records(const std::wstring & path, const char * type) {
+    std::vector<json> v;
+    std::ifstream ifs(path, std::ios::binary);
+    std::string line;
+    while (std::getline(ifs, line)) {
+        while (!line.empty() && (line.back()=='\r'||line.back()=='\n')) line.pop_back();
+        if (line.empty()) continue;
+        json j = json::parse(line, nullptr, false);
+        if (j.is_object() && j.value("type","") == type) v.push_back(j);
+    }
+    return v;
+}
+
+// x = e_0 · w_l = w_{l+1} = 1 이면 y = x 이고 logit[e] = rt[e][0] 이므로 ordered top-16 을
+// `want` 순서로 정확히 못박을 수 있다(나머지 112개 logit = 0 — 양수 16개가 top-16 독점).
+static void pb_hint_craft_snapshot(int32_t ne, int32_t nx, const std::vector<int32_t> & want,
+                                   std::vector<float> & x) {
+    std::vector<float> w0((size_t)ne, 1.0f), w1((size_t)ne, 1.0f);
+    std::vector<float> rt((size_t)ne * (size_t)nx, 0.0f);
+    for (size_t r = 0; r < want.size(); r++) rt[(size_t)want[r] * (size_t)ne] = 1000.0f - (float)r;
+    ggml_moe_phaseb_test_snapshot_raw(0, nullptr, w0.data());
+    ggml_moe_phaseb_test_snapshot_raw(1, rt.data(), w1.data());
+    ggml_moe_phaseb_snapshot_seal();
+    x.assign((size_t)ne, 0.0f);
+    x[0] = 1.0f;
+}
+
+// intent digest 1스텝 독립 재계산(§8 — re/ge/sl/tl/k/ids[16]).
+static uint64_t pb_hint_digest1(uint32_t re, uint32_t ge, uint16_t sl, uint16_t tl, uint16_t k,
+                                const uint16_t ids[16]) {
+    uint64_t h = PB_FNV_INIT;
+    h = pb_fnv(h, &re, sizeof(re));
+    h = pb_fnv(h, &ge, sizeof(ge));
+    h = pb_fnv(h, &sl, sizeof(sl));
+    h = pb_fnv(h, &tl, sizeof(tl));
+    h = pb_fnv(h, &k,  sizeof(k));
+    h = pb_fnv(h, ids, sizeof(uint16_t) * 16);
+    return h;
+}
+
+static std::string pb_ids_head(const uint16_t * ids, int n) {
+    std::string s = "[";
+    for (int i = 0; i < n; i++) { if (i) s += ","; s += std::to_string((unsigned)ids[i]); }
+    return s + ",...]";
+}
+
+// 배열이 [0,n_expert) 범위 · 16개 전부 유일인가.
+static bool pb_ids_range_unique(const uint16_t * ids, int32_t n_expert) {
+    std::set<uint16_t> seen;
+    for (int i = 0; i < 16; i++) {
+        if (ids[i] >= (uint16_t)n_expert) return false;
+        if (!seen.insert(ids[i]).second) return false;
+    }
+    return true;
+}
+
+// 오힌트 ON/OFF 공통 — 결정론 capture 1건을 밀어 intent 를 **소비 전에** 관측한다.
+//   반환 1 = capture 성사 + worker idle + intent 존재. graph/run 은 호출자가 닫는다.
+static int pb_hint_capture_peek(const std::vector<float> & x, ggml_moe_phaseb_intent & out,
+                                uint32_t * out_req, uint32_t * out_gep, uint32_t * out_gseq) {
+    ggml_moe_direct_test_dispatcher_pause(1);
+    ggml_moe_phaseb_run_begin();
+    ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);
+    uint8_t ph = 0;
+    ggml_moe_phaseb_current_epoch(out_req, out_gep, out_gseq, &ph);
+    const int cap_rc = ggml_moe_phaseb_capture(0, -1, x.data(), (int32_t)GGML_TYPE_F32,
+                                               PB_TEST_N_EMBD, 1, 1, 1);
+    const int idle = ggml_moe_phaseb_test_wait_idle(5000);
+    const int got  = ggml_moe_phaseb_intent_peek(&out);
+    ggml_moe_direct_test_dispatcher_pause(0);
+    return (cap_rc == 1 && idle == 1 && got == 1) ? 1 : 0;
+}
