+        if (!check(rc == 0 && stage == 12 && prc == 0,
+                   "V3d1. A2 자원 확보 완주 + A3 소비자 기동(stage=12·seal 성공) + 자원 스냅샷 취득 [rc=" +
+                   std::to_string(rc) + " stage=" + std::to_string(stage) + " probe=" + std::to_string(prc) + "]")) return;
+
+        // ① 핸들 집합(§3-1) — 수는 sources[] 와 같고, 각 핸들이 본 크기의 합은 manifest 합과 같다.
