+
+
+// no_alloc=true — 모듈 API 직접 호출 경로에서는 텐서에 buffer 가 붙지 않는다(버퍼 NULL 경로도
+// 함께 통과시킨다). 생산 스케줄러 경로에서는 alloc 후 buffer 가 붙어 그쪽도 덮인다.
+static void build_graph(GraphFix & fx, int64_t n, const char * tag) {
+    ggml_init_params ip = {};
+    ip.mem_size   = 16u * 1024u * 1024u;
+    ip.mem_buffer = nullptr;
+    ip.no_alloc   = true;
+    fx.ctx = ggml_init(ip);
+    fx.a = ggml_new_tensor_2d(fx.ctx, GGML_TYPE_F32, n, 4);
+    ggml_set_name(fx.a, "lm_a");
+    ggml_set_input(fx.a);
+    fx.b = ggml_new_tensor_2d(fx.ctx, GGML_TYPE_F32, n, 4);
+    ggml_set_name(fx.b, "lm_b");
+    ggml_set_input(fx.b);
+    ggml_tensor * c = ggml_add(fx.ctx, fx.a, fx.b);
+    ggml_set_name(c, "lm_c");
+    ggml_tensor * d = ggml_mul(fx.ctx, c, fx.a);
+    ggml_set_name(d, tag);
+    fx.gf = ggml_new_graph(fx.ctx);
+    ggml_build_forward_expand(fx.gf, d);
+}
+
+// ★생산 경로 픽스처 — 실제 ggml_backend_sched 를 만들어 ggml_backend_sched_graph_compute() 를
+//   통과시킨다. P40b 가 public capture API 직접 호출이라 "생산 훅 배선"과 "생산 OFF" 를 증명하지
+//   못한다는 지적(R13 ③2)에 대응하는 픽스처다. CPU 백엔드로 충분하다 — 훅은 backend 종류와
+//   무관하게 ggml_backend_sched_graph_compute_async() 안에 있다.
+struct SchedFix {
+    ggml_backend_t       be    = nullptr;
+    ggml_backend_sched_t sched = nullptr;
+    ~SchedFix() {
+        if (sched) ggml_backend_sched_free(sched);
+        if (be)    ggml_backend_free(be);
+    }
+};
+
+static bool sched_init(SchedFix & s) {
+    ggml_backend_load_all();
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (!dev) return false;
+    s.be = ggml_backend_dev_init(dev, nullptr);
+    if (!s.be) return false;
+    ggml_backend_buffer_type_t buft = ggml_backend_get_default_buffer_type(s.be);
+    s.sched = ggml_backend_sched_new(&s.be, &buft, 1, GGML_DEFAULT_GRAPH_SIZE, false, false);
+    return s.sched != nullptr;
+}
+
+// alloc → 입력 0 채움 → compute. compute 안에서 생산 훅이 걸린다.
+static bool sched_run(SchedFix & s, GraphFix & fx) {
+    if (!ggml_backend_sched_alloc_graph(s.sched, fx.gf)) return false;
+    std::vector<float> zeros((size_t) ggml_nelements(fx.a), 0.0f);
+    ggml_backend_tensor_set(fx.a, zeros.data(), 0, ggml_nbytes(fx.a));
+    ggml_backend_tensor_set(fx.b, zeros.data(), 0, ggml_nbytes(fx.b));
+    return ggml_backend_sched_graph_compute(s.sched, fx.gf) == GGML_STATUS_SUCCESS;
+}
+
+// 그래프 전체를 split 1개로 보고 캡처(스케줄러 없이 모듈 계약만 검증한다).
+
+static std::string last_digest() {
+    char buf[65] = {0};
+    if (ggml_moe_lmtrace_last_digest(buf, (int32_t) sizeof(buf)) != 0) return std::string();
+    return std::string(buf);
+}
+
+static std::vector<uint8_t> read_all(const std::wstring & path) {
+    std::ifstream ifs(path, std::ios::binary);
+    if (!ifs.is_open()) return std::vector<uint8_t>();
+    return std::vector<uint8_t>((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
+}
+
+static uint32_t rd_u32le(const std::vector<uint8_t> & b, size_t off) {
+    if (off + 4 > b.size()) return 0;
+    return (uint32_t) b[off] | ((uint32_t) b[off+1] << 8) | ((uint32_t) b[off+2] << 16) | ((uint32_t) b[off+3] << 24);
+}
+
+// ★.lmt 를 rec_bytes 로 **완주** 파싱한다(G-L0 판독기가 하는 것과 같은 규율 — R13 ④7).
+//   반환 false = magic 불일치·길이 모순·trailing bytes 잔존 중 하나.
+static bool parse_records(const std::vector<uint8_t> & raw, std::vector<std::string> & sha_out) {
+    sha_out.clear();
+    size_t off = 0;
+    while (off < raw.size()) {
+        if (off + 12 > raw.size()) return false;
+        if (memcmp(&raw[off], "MOELMT1", 7) != 0 || raw[off + 7] != 0x00) return false;
+        const uint32_t rb = rd_u32le(raw, off + 8);
+        if (rb < 12 || (size_t) rb > raw.size() - off) return false;
+        sha_out.push_back(sha256_hex(std::string((const char *) &raw[off], (size_t) rb)));
+        off += rb;
+    }
+    return off == raw.size();
+}
+
+// .lmtidx 한 줄에서 `key=` 값을 뽑는다(공백/개행 구분).
+static std::string idx_field(const std::string & line, const std::string & key) {
+    const size_t p = line.find(key + "=");
+    if (p == std::string::npos) return std::string();
+    const size_t s = p + key.size() + 1;
+    size_t e = line.find_first_of(" \r\n", s);
+    if (e == std::string::npos) e = line.size();
+    return line.substr(s, e - s);
+}
+
+static std::vector<std::string> read_lines(const std::wstring & path) {
+    const std::vector<uint8_t> raw = read_all(path);
+    std::vector<std::string> out;
+    std::string cur;
+    for (uint8_t c : raw) {
+        if (c == '\n') { if (!cur.empty() && cur.back() == '\r') cur.pop_back(); out.push_back(cur); cur.clear(); }
+        else cur.push_back((char) c);
+    }
+    if (!cur.empty()) out.push_back(cur);
+    return out;
+}
