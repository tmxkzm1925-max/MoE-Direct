+//
+// v2 픽스처(Fixture)와의 결정적 차이: **소스가 실물 GGUF 파일**이다. virtual 소비자는 원본
+// shard 를 직접 열어 헤더를 재파싱하고(§2-5 live 전항 대조) 헤더 영역을 재해시하므로(DF-1),
+// v2 처럼 존재하지 않는 경로 문자열로는 어떤 계약도 행사할 수 없다. 그래서 이 픽스처는 ggml 의
+// gguf writer 로 진짜 GGUF 를 쓰고, 그 파일을 되읽어 얻은 좌표(data_offset + tensor offset)로
+// manifest 를 짓는다 — 실 리패커(`repack_experts.py --mode virtual`)가 하는 일과 같은 순서다.
+//
+// ★GGUF 정렬을 기본값 32 로 두는 것은 의도다: 4096 으로 두면 `abs_offset % A` 가 항상 0 이라
+//   `bracket_head != 0` 경로가 픽스처에서 아예 발화하지 않는다(실 모델도 32 가 통상값).
+// ===========================================================================
+
+struct V3Part {
+    std::string name;             // manifest part name
+    std::string source_tensor;    // GGUF 텐서명(= 등록 키)
+    int32_t     source_index = 0;
+    std::string type;             // 동결 type-trait 표 이름
+    std::vector<int64_t> dims;    // 마지막 축 = expert
+    bool        is_host = true;
+    // ---- build() 산출(§2-4) ----
+    uint64_t abs_offset   = 0;    // shard 내 텐서 데이터 시작 절대 오프셋
+    uint64_t slice_bytes  = 0;    // per-expert per-part
+    uint64_t region       = 0;
+    uint64_t slot_offset  = 0;
+    uint64_t data_offset  = 0;
+    uint64_t bracket_head = 0;    // aligned part 전용(비4K 는 기재 금지)
+    bool     aligned      = false;
+};
+struct V3Layer {
+    int32_t  layer = 0;
+    std::vector<V3Part> parts;
+    uint64_t layer_slot_bytes = 0;
+};
+struct V3Model {
+    std::string arch = "synthv3";
+    int32_t n_expert = 8, n_expert_used = 2, n_layer = 4, n_layer_nextn = 0, n_embd = 0;
+    float   f_norm_rms_eps = 1e-6f;
+    int32_t n_shards = 1;
+    std::vector<V3Layer> layers;
+};
+
+// A=4096 기준 aligned part 2종(slice 8192·4096)을 층마다 둔다 — 크기를 달리 줘야 §2-4 점화식
+// (slot_offset[p+1]=slot_offset[p]+region[p])이 자명하지 않게 돈다.
+static V3Model default_v3_model(int32_t n_shards = 1) {
+    V3Model m;
+    m.n_shards = n_shards;
+    for (int32_t l = 0; l < 4; l++) {
+        V3Layer L;
+        L.layer = l;
+        const std::string b = "blk." + std::to_string(l) + ".";
+        const int32_t si = n_shards > 1 ? (l % n_shards) : 0;
+        L.parts.push_back(V3Part{ "gate", b + "ffn_gate_exps.weight", si, "F32", { 1024, 2, m.n_expert }, true });
+        L.parts.push_back(V3Part{ "up",   b + "ffn_up_exps.weight",   si, "F32", { 1024, 1, m.n_expert }, true });
+        m.layers.push_back(std::move(L));
+    }
+    return m;
+}
+
+// ★§Z-⑥ A4 — **비4K(바운스) part 를 포함한** 혼합 모델. `default_v3_model` 은 전 part 가
+//   A 배수라 바운스 경로가 아예 발화하지 않는다.
+//   part 0 = F32 {1024,2,E} → slice 8192 (A 배수 = aligned · 슬롯 직착지)
+//   part 1 = MXFP4 {32,256,E} → slice 17*256 = **4352**(A 배수 아님 = 바운스)
+//     · region = align_up(4352,4096) = 8192 · staging_bytes = region + A = 12288
+//     · src_head(e) = (abs + e*4352) mod 4096 이 expert 마다 달라져 브라켓 머리가 실제로 움직인다.
+// ★★R11(교차 r5 Y2) — **`read_len > region` 분기를 실제로 밟는** 형상.
+//   비4K 의 제출 길이는 `align_up(src_head + slice, A)` 이고 region 은 `align_up(slice, A)` 다.
+//   둘이 갈리는 조건은 **`src_head > region − slice`**. 구 `bounce_v3_model` 은 slice=4352 라
+//   region−slice = 3840 이고 실 abs 에서 src_head 가 최대 2176 이라 **한 번도 안 갈렸다**
+//   (그래서 Y1 실 결함을 관문이 놓쳤다).
+//   여기서는 MXFP4 {32,240,E} → slice = 17*240 = **4080** · region = 4096 ⇒ region−slice = **16**.
+//   실 abs 의 src_head 는 수백~수천이라 **거의 모든 expert 에서** read_len(8192) ≠ region(4096).
+//   ⇒ 수리 전이면 정상 read 가 실패 latch 로 가고, 수리 후에만 통과한다.
+static V3Model bounce_head_v3_model(int32_t n_shards = 1) {
+    V3Model m;
+    m.n_shards = n_shards;
+    for (int32_t l = 0; l < 2; l++) {
+        V3Layer L;
+        L.layer = l;
+        const std::string b = "blk." + std::to_string(l) + ".";
+        const int32_t si = n_shards > 1 ? (l % n_shards) : 0;
+        L.parts.push_back(V3Part{ "gate", b + "ffn_gate_exps.weight", si, "F32",   { 1024, 2, m.n_expert }, true });
+        L.parts.push_back(V3Part{ "up",   b + "ffn_up_exps.weight",   si, "MXFP4", { 32, 240, m.n_expert }, true });
+        m.layers.push_back(std::move(L));
+    }
+    m.n_layer = 4;
+    return m;
+}
+
+static V3Model bounce_v3_model(int32_t n_shards = 1) {
+    V3Model m;
+    m.n_shards = n_shards;
+    for (int32_t l = 0; l < 2; l++) {
+        V3Layer L;
+        L.layer = l;
+        const std::string b = "blk." + std::to_string(l) + ".";
+        const int32_t si = n_shards > 1 ? (l % n_shards) : 0;
