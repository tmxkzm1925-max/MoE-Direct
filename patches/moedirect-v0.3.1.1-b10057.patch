+static void test_pb_dsv4_router_bf16() {
+    section("P39. ★deepseek4_v1 router BF16(SPEC_FAMILY_SIGNAL v0.3 §1.6 · 부록 DSV4-1 5절) — "
+            "역할×계열 allowlist(전역 완화 없음) · 인벤토리 청크 승격 finite · snapshot 1회 canonical "
+            "F32 승격 · GEMV/wire 불변 · 격리 음성 · host/비-host 두 팔 · 인벤토리 범위 1..42");
+    const int32_t NE = PB_TEST_N_EMBD, NX = PB_TEST_N_EXPERT;
+
+    // ── ①⑦⑨ 양성 3팔: F32 기준팔 / BF16 host / BF16 비-host ─────────────────────────────
+    const Dsv4BfArm a32 = pb_dsv4_bf16_arm("pb_dsv4_bf_f32",   /*router_type=*/0, false, 20260802u);
+    const Dsv4BfArm abf = pb_dsv4_bf16_arm("pb_dsv4_bf_host",  /*router_type=*/1, false, 20260802u);
+    const Dsv4BfArm anh = pb_dsv4_bf16_arm("pb_dsv4_bf_nhost", /*router_type=*/1, true,  20260802u);
+
+    check(a32.resolved && a32.snap_sealed && a32.produced == 8 && a32.matched == 8 &&
+          a32.tie_free == 8 && a32.differ == 8,
+          "P39a. 기준팔(F32 router · 생산 스냅샷 경로) — 8/8 ordered top-16 = 독립 참조(" +
+          std::to_string(a32.matched) + "/" + std::to_string(a32.produced) +
+          ") · 비동률 8/8 · 오산식 대조 8/8 상이 · ids=" + a32.head);
+    check(abf.resolved && abf.snap_sealed && abf.produced == 8 && abf.matched == 8 &&
+          abf.tie_free == 8 && abf.differ == 8,
+          "P39b. ★★게이트① BF16 router 양성(host 팔) — 인벤토리 통과(reason=\"" + abf.reason +
+          "\") → snapshot 승격 → GEMV/TopK 실 생산 경로 산출이 독립 F32 승격 참조와 일치(" +
+          std::to_string(abf.matched) + "/" + std::to_string(abf.produced) + ") · ids=" + abf.head);
+    check(anh.resolved && anh.snap_sealed && anh.produced == 8 && anh.matched == 8 &&
+          anh.tie_free == 8 && anh.differ == 8,
+          "P39c. ★게이트⑦ BF16 router 양성(**비-host 버퍼 팔** — 승격 스캔·snapshot 승격 모두 "
+          "backend get_tensor 경유) — " + std::to_string(anh.matched) + "/" +
+          std::to_string(anh.produced) + " 일치 · ids=" + anh.head);
+    check(!abf.head.empty() && abf.head == a32.head && anh.head == a32.head,
+          "P39d. ★★BF16→F32 무손실 승격 실증 — 세 팔의 ordered top-16 이 byte-equal(F32=" +
+          a32.head + " · BF16 host=" + abf.head + " · BF16 비-host=" + anh.head + ")");
+    {
+        bool acct = (abf.rt_bytes == a32.rt_bytes) && (abf.nm_bytes == a32.nm_bytes) &&
+                    (abf.bias_bytes == a32.bias_bytes) && (anh.rt_bytes == a32.rt_bytes) &&
+                    (abf.threads == a32.threads) &&
+                    (a32.rt_bytes == (uint64_t)(DSV4_N_LAYER - 1) * DSV4_N_EMBD * DSV4_N_EXPERT * sizeof(float));
+        for (int i = 0; i < 9 && acct; i++)
+            if (abf.mem[i] != a32.mem[i] || anh.mem[i] != a32.mem[i]) acct = false;
+        check(acct, "P39e. ★게이트⑨ 회계 불변 — phaseb_mem exact-key 전건이 F32 팔과 동일"
+                    "(router " + std::to_string(abf.rt_bytes) + "B · norm " +
+                    std::to_string(abf.nm_bytes) + "B · bias " + std::to_string(abf.bias_bytes) +
+                    "B) = 인벤토리용 추가 영구 F32 사본 없음(승격본은 청크 scratch·소멸)");
+    }
+    check(abf.mask_ok && anh.mask_ok,
+          "P39f. ★게이트③ BF16 문맥에서도 층 마스크 동일 — first_target_layer=3 · target eligible "
+          "이 정확히 3..42(0·1·2 제외)");
+
+    // ── ②⑥⑧ 음성군 공용 arm ────────────────────────────────────────────────────────────
+    auto arm = [&](const char * tag, const PbDsv4Opt & o, const char * want_reason) {
+        PbEnv env("4", "8", "2", "off", nullptr, nullptr);
+        Fixture fx;
+        pb_setup_dsv4(fx, tag, o);
+        const PbAdObs r = pb_ad_seal_observe(fx);
+        const bool ok = (r.rc == 0) && r.adapter == GGML_MOE_PHASEB_ADAPTER_NONE &&
+                        r.reason == want_reason && !r.pf_on && r.off_reason == "adapter_none" &&
+                        r.width == 0 && r.cap == 0 && r.iq == 0 && r.pw == 0 && r.snap == 0 &&
+                        r.worker == 0 && r.depth == 0;
+        check(ok, std::string("P39. ") + tag + " → adapter=none · reason=\"" + r.reason +
+                  "\"(기대 \"" + want_reason + "\") · B2 자원 0");
+    };
+    auto arm_ok = [&](const char * tag, const PbDsv4Opt & o) {
+        PbEnv env("4", "8", "2", "off", nullptr, nullptr);
+        Fixture fx;
+        pb_setup_dsv4(fx, tag, o);
+        const PbAdObs r = pb_ad_seal_observe(fx);
+        check(r.rc == 0 && r.adapter == GGML_MOE_PHASEB_ADAPTER_DEEPSEEK4 && r.reason.empty() && r.pf_on,
+              std::string("P39+. ") + tag + " → deepseek4_v1 해소 유지 · reason=\"" + r.reason + "\"");
+    };
+
+    // ② dtype 음성 + 비유한 + 기존 검사 보존(계약 회귀 방지)
+    { PbDsv4Opt o; o.router_type = 2; arm("pb_dsv4_router_f16",  o, "inventory_invalid_router_type"); }
+    { PbDsv4Opt o; o.router_type = 3; arm("pb_dsv4_router_q8_0", o, "inventory_invalid_router_type"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_bad_layer = 5; o.router_bad_kind = 1;
+      arm("pb_dsv4_router_bf16_nan",  o, "inventory_invalid_router_nonfinite"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_bad_layer = 5; o.router_bad_kind = 2;
+      arm("pb_dsv4_router_bf16_pinf", o, "inventory_invalid_router_nonfinite"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_bad_layer = 5; o.router_bad_kind = 3;
+      arm("pb_dsv4_router_bf16_ninf", o, "inventory_invalid_router_nonfinite"); }
+    { PbDsv4Opt o; o.router_type = 1; o.buffer_mode = 2; o.router_bad_layer = 5; o.router_bad_kind = 1;
+      arm("pb_dsv4_router_bf16_nan_nhost", o, "inventory_invalid_router_nonfinite"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_misname   = true;
+      arm("pb_dsv4_router_bf16_name",   o, "inventory_invalid_router_name"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_shape_bad = true;
+      arm("pb_dsv4_router_bf16_shape",  o, "inventory_invalid_router_shape"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_noncontig = true;
+      arm("pb_dsv4_router_bf16_contig", o, "inventory_invalid_router_noncontig"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_unalloc   = true;
+      arm("pb_dsv4_router_bf16_unalloc", o, "inventory_invalid_router_unallocated"); }
+
+    // ③ 파티션 — BF16 router 문맥에서도 배타 판정이 그대로 산다(dtype 축과 독립).
+    { PbDsv4Opt o; o.router_type = 1; o.tid_extra_layer = 7;
+      arm("pb_dsv4_bf16_tid_extra", o, "tid2eid_partition_mismatch"); }
+    { PbDsv4Opt o; o.router_type = 1; o.tid_drop_layer  = 1;
+      arm("pb_dsv4_bf16_tid_drop",  o, "tid2eid_partition_mismatch"); }
+    { PbDsv4Opt o; o.router_type = 1; o.ep_extra_layer  = 0;
+      arm("pb_dsv4_bf16_ep_hash0",  o, "exp_probs_b_partition_mismatch"); }
+    { PbDsv4Opt o; o.router_type = 1; o.ep_drop_layer   = 9;
+      arm("pb_dsv4_bf16_ep_drop",   o, "bias_profile_mismatch"); }
+
+    // ⑥ 격리 음성 — 같은 계열이라도 **역할이 다르면** BF16 은 거부다.
+    { PbDsv4Opt o; o.norm_bf16 = true; arm("pb_dsv4_norm_bf16", o, "inventory_invalid_norm_type"); }
+    { PbDsv4Opt o; o.bias_bf16 = true; arm("pb_dsv4_bias_bf16", o, "inventory_invalid_bias_type"); }
+
+    // ⑧ router 인벤토리 범위 = 정확히 1..42(층 0 제외 · hash 층 1·2 포함)
+    { PbDsv4Opt o; o.router_type = 1; o.router_drop_layer = 0; arm_ok("pb_dsv4_bf16_rt_drop_l0", o); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_bad_layer = 0; o.router_bad_kind = 1;
+      arm_ok("pb_dsv4_bf16_rt_nan_l0", o); }   // 층 0 은 **주사 자체를 하지 않는다**
+    { PbDsv4Opt o; o.router_type = 1; o.router_drop_layer = 1;
+      arm("pb_dsv4_bf16_rt_drop_l1",  o, "router_inventory_mismatch"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_drop_layer = 2;
+      arm("pb_dsv4_bf16_rt_drop_l2",  o, "router_inventory_mismatch"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_drop_layer = DSV4_N_LAYER - 1;
+      arm("pb_dsv4_bf16_rt_drop_l42", o, "router_inventory_mismatch"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_bad_layer = 1; o.router_bad_kind = 1;
+      arm("pb_dsv4_bf16_rt_nan_l1",   o, "inventory_invalid_router_nonfinite"); }
+    { PbDsv4Opt o; o.router_type = 1; o.router_bad_layer = DSV4_N_LAYER - 1; o.router_bad_kind = 3;
+      arm("pb_dsv4_bf16_rt_ninf_l42", o, "inventory_invalid_router_nonfinite"); }
+
+    // ── ⑥ 타 계열 격리 — allowlist 가 **계열 축으로도** 갇혔음의 실증 ────────────────────
+    auto fam_arm = [&](const char * tag, const PbInvOpt & o, const char * arch,
+                       const char * want_reason) {
+        PbEnv env("4", "8", "2", "off", nullptr, nullptr);
+        Fixture fx; pb_setup_2layer(fx, tag);
+        PbInvFix F;
+        pb_build_inventory(F, NX, NE, /*n_layer_exec=*/2, /*n_expert_used=*/2, o);
+        F.fam.arch = arch;
+        ggml_moe_phaseb_note_family(&F.fam);
+        const PbAdObs r = pb_ad_seal_observe(fx);
+        check(r.rc == 0 && r.adapter == GGML_MOE_PHASEB_ADAPTER_NONE && r.reason == want_reason &&
+              !r.pf_on && r.off_reason == "adapter_none" && r.cap == 0 && r.pw == 0 && r.snap == 0,
+              std::string("P39. ") + tag + "(arch=" + arch + ") → adapter=none · reason=\"" +
+              r.reason + "\"(기대 \"" + want_reason + "\")");
+    };
+    { PbInvOpt o; o.router_bf16 = true;
+      fam_arm("pb_dsv4_iso_qwen_bf16", o, "qwen35moe", "inventory_invalid_router_type"); }
+    { PbInvOpt o; o.router_bf16 = true; o.bias_gi_named = true;
+      fam_arm("pb_dsv4_iso_gptoss_bf16", o, "gpt-oss", "inventory_invalid_router_type"); }
+    //   deepseek2 는 **미등재 선차단**(registered guard 가 인벤토리 판정보다 앞)이라 dtype 사유가
+    //   표면에 뜨지 않는다 — 관측 가능한 것은 "신호 전면 비활성"이며, allowlist(router_bf16_ok=false)
+    //   는 그 뒤의 두 번째 방벽이다. 사실 그대로 기록한다(과대 주장 금지).
+    { PbInvOpt o; o.router_bf16 = true; o.bias_ep_named = true; o.groups = 1; o.gating = 2;
+      fam_arm("pb_dsv4_iso_ds2_bf16", o, "deepseek2", "adapter_unregistered"); }
+    //   양성 대조 — 같은 계열·같은 픽스처에서 router 만 F32 이면 정상 해소된다(음성이 공허하지 않음).
+    {
+        PbEnv env("4", "8", "2", "off", nullptr, nullptr);
+        Fixture fx; pb_setup_2layer(fx, "pb_dsv4_iso_qwen_f32");
+        PbInvFix F; PbInvOpt o;
+        pb_build_inventory(F, NX, NE, /*n_layer_exec=*/2, /*n_expert_used=*/2, o);
+        ggml_moe_phaseb_note_family(&F.fam);
+        const PbAdObs r = pb_ad_seal_observe(fx);
+        check(r.rc == 0 && r.adapter == GGML_MOE_PHASEB_ADAPTER_QWEN35MOE && r.reason.empty() && r.pf_on,
+              "P39+. 대조군 — 같은 qwen35moe 픽스처에서 router 가 F32 면 정상 해소(BF16 거부가 "
+              "형상·이름 때문이 아니라 **dtype allowlist** 때문임의 대조)");
+    }
+}
