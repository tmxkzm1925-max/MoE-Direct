+                      c1.get(GGML_MOE_PB_C_ADMITTED) == c0.get(GGML_MOE_PB_C_ADMITTED),
+                      "V3P15. ★게이트 A0-4 demand predicate — joined demand waiter 가 붙어 있는 동안 "
+                      "신규 prefetch admission 이 **금지**된다(금지가 이긴다) [" + s1.tag() + "]");
+                // ⑮ joined 보호 — ★★R-5 재설계(교차 r1 F3): **실제 graceful shutdown 을 경유**한다.
+                //   ★구 판의 결손 2가지를 함께 고친다:
+                //     ⓐ shutdown/cancel 을 **한 번도 호출하지 않고** hold 만 풀어 정상 join 으로
+                //        끝냈다 ⇒ "graceful cancel 에서 waiter 붙은 record 는 취소 제외"라는 계약
+                //        (A0-4 joined 보호)의 **cancel 경로를 한 번도 안 탔다**.
+                //     ⓑ `blocked_count` 를 출력만 하고 **assert 하지 않았다**.
+                //   ★순서 구속: shutdown 은 waiter 가 **아직 붙어 있는 동안** 시작해야 그 보호가
+                //     행사된다. 그래서 별도 스레드로 graceful drain 을 띄우고, 그 뒤에 회수를 풀어
+                //     drain 이 진행되게 한다. 회수를 먼저 풀면 join 이 끝난 뒤 shutdown 이 도는
+                //     것이라 보호할 대상이 없다(=구 판과 같아진다).
+                //   ★유계 대기: drain 이 안 끝나도 관문이 **매달리지 않게** 유한 대기 후 실패로
+                //     판정한다(=브리프 V3P17 의 bounded shutdown 취지를 이 자리에서 선반영).
+                // ★★S-2 — **유계 훅**을 쓴다. 구 판은 5s polling 뒤 **무조건 `join()`** 이고
+                //   훅 내부가 INFINITE 라, shutdown 회귀 시 관문이 FAIL 하는 게 아니라 **selftest 가
+                //   교착**했다(r2 F-2). 유계 훅은 timeout 에 **반드시 반환**하므로 스레드가 종료되고
+                //   `join()` 이 안전해진다 — 그래서 이제 **붉은 수치**로 담릴다.
+                // ★★S-5 — **shutdown 진입 barrier**. 구 판은 `Sleep(30)` 뒤 hold 를 풀어, demand 가
+                //   먼저 완주하고 shutdown 이 나중에 시작해도 통과했다(=joined 보호를 안 행사한
+                //   채 녹색). 이제 **shutdown 이 실제로 진입한 것을 확인한 뒤에만** hold 를 푸어,
+                //   waiter 가 붙은 동안 cancel 경로가 돌 수 있는 상태를 보장한다.
+                std::atomic<int> shut_done{0}, shut_rc{-1};
+                std::thread ts([&]() {
+                    shut_rc.store(ggml_moe_direct_test_shutdown_bounded(/*abort_mode=*/0,
+                                                                       /*timeout_ms=*/15000));
+                    shut_done.store(1);
+                });
+                // ★★T-4(교차 r3 S-5 ②) — **진짜 barrier = 엔진이 `q_stopping` 을 게시한 뒤**.
+                //   구 판은 shutdown 함수 **호출 직전**에 테스트가 세운 플래그를 barrier 라 했는데,
+                //   그건 엔진이 정지 국면에 들어갔다는 증거가 아니다(함수 안에서 predictor drain 이
+                //   먼저 돌고, 그 사이 demand 가 선완주하면 joined 보호가 **행사되지 않은 채** 통과).
+                //   엔진측 창구를 폴링해 게시를 확인한 **뒤에만** hold 를 푼다.
+                bool entered_ok = false;
+                for (int i = 0; i < 5000; i++) {
+                    if (ggml_moe_direct_test_q_stopping() == 1) { entered_ok = true; break; }
+                    Sleep(1);
+                }
+                ggml_moe_direct_test_hold_retire(0);    // 회수 재개 — 이제 drain 이 전진한다
+                th.join();                              // demand 완주(취소됐다면 -1 이 온다)
+                ts.join();                              // ★유계 훅이라 반드시 돌아온다
+                const bool shut_ok = (shut_done.load() == 1) && (shut_rc.load() == 1);
+                uint64_t bus = 0, bcnt = 0;
+                ggml_moe_phaseb_blocked_totals(&bus, &bcnt);
+
+                // ★★`demand_blocked` 계수 **정합**의 방향(§3 ⑮) — 처음엔 `bcnt > 0` 으로 세웠다가
+                //   실행에서 0 이 나와 되짚었더니, FROZEN A0-4 가 **명시적으로 반대**를 계약하고
+                //   있었다: "joined demand waiter 존재=predicate-local blocked ⇒ 금지. **단 기존
+                //   telemetry `demand_blocked_by_prefetch_*` 는 자동 증가하지 않는다**(그 카운터의
+                //   기존 정의=총 QD 만석 ∧ prefetch inflight>0 의 실대기 구간만 — 불변·r3 분리)."
+                //   ⇒ 옳은 판정은 "증가한다"가 아니라 **"오염되지 않는다"**(joined episode 를
+                //     통과해도 불변). 그래야 predicate-local blocked 와 legacy 계측축의 분리가
+                //     실제로 지켜지는지 잡는다. 내 최초 기대치가 사양과 어긋났던 자리라 남겨 둔다.
+                check(arc.load() == 0 && shut_ok && entered_ok && bcnt == bcnt0,
+                      "V3P16. ★★게이트 ⑮ joined 보호 **재설계** — waiter 가 붙은 prefetch record 는 "
+                      "**실제 graceful shutdown 경유**에서도 취소 제외이고 demand 가 성공으로 완주하며"
+                      "(`used_join` closure · origin·credit 귀속 prefetch 유지), 그 사이 legacy "
+                      "telemetry `demand_blocked_by_prefetch_*` 는 **불변**이다(A0-4 r3 분리 — "
+                      "predicate-local blocked 가 그 축을 오염시키지 않는다). 구 판은 cancel 을 안 "
+                      "부르고 hold 만 풀어 보호를 행사하지 않았고 이 계수도 assert 하지 않았다(F3). "
+                      "★T-4: barrier 를 **엔진 `q_stopping` 게시 관측**으로 "
+                      "바꿨다(호출 직전 플래그는 barrier 가 아니다 — demand 선완주 반례가 남아 있었다) "
+                      "[acquire=" + std::to_string(arc.load()) +
+                      " q_stopping_barrier=" + std::to_string((int)entered_ok) +
+                      " graceful_shutdown_done=" + std::to_string((int)shut_ok) +
+                      " blocked_count " + std::to_string((unsigned long long)bcnt0) + "→" +
+                      std::to_string((unsigned long long)bcnt) + "]");
+            }
+        }
+        ggml_moe_direct_reset_for_test();
+    }
+}
