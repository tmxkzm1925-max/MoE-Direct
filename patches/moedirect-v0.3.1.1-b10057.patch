+static void test_b1_equivalence() {
+    section("O4. ★legacy ↔ persistent 8단계 동형(같은 바이너리 selector ABBA — QD1·QD8 각각)");
+
+    struct Case { const char * qd; };
+    const Case cases[2] = { {"1"}, {"8"} };
+    for (const auto & cs : cases) {
+        const std::string tagL = std::string("b1_eqL_qd") + cs.qd;
+        const std::string tagP = std::string("b1_eqP_qd") + cs.qd;
+        B1RunState a = b1_run_sequence(tagL.c_str(), cs.qd, "legacy");
+        B1RunState b = b1_run_sequence(tagP.c_str(), cs.qd, "persistent");
+        printf("    (참고) QD%s legacy: persistent=%d demand_cmd=%llu readfile_digest=0x%016llx ops=%llu lru=0x%016llx tick=%llu\n",
+               cs.qd, a.persistent, (unsigned long long)a.demand_cmd,
+               (unsigned long long)a.readfile_digest, (unsigned long long)a.readfile_ops,
+               (unsigned long long)a.lru_digest, (unsigned long long)a.tick_final);
+        printf("    (참고) QD%s persist: persistent=%d demand_cmd=%llu readfile_digest=0x%016llx ops=%llu lru=0x%016llx tick=%llu\n",
+               cs.qd, b.persistent, (unsigned long long)b.demand_cmd,
+               (unsigned long long)b.readfile_digest, (unsigned long long)b.readfile_ops,
+               (unsigned long long)b.lru_digest, (unsigned long long)b.tick_final);
+        fflush(stdout);
+        check(a.persistent == 0 && b.persistent == 1 && b.demand_cmd > 0,
+              std::string("O4a-QD") + cs.qd + ". selector 실적용(legacy=0 / persistent=1 · demand_cmd>0)");
+        check(b1_same_run(a, b),
+              std::string("O4b-QD") + cs.qd + ". ★ordered ReadFile digest·record→slot/LRU digest·"
+              "hit/miss·read bytes·슬롯 상태 전량 완전일치");
+    }
+}
