+                            make_separate_layer(1, 8, "MXFP4", false) };
+        fx.comp = compute_layout(fx.model, 4096);
+        fx.build();
+        const int sr = fx.seal((uint64_t)8 * fx.comp.slot_stride_max, 64);
+        int acq_seen[2] = { -1, -1 };
+        int rel_seen[2] = { -1, -1 };
+        int n_acq = 0, n_rel = 0;
+        if (sr == 0) {
+            ggml_moe_phasea_run_begin();
+            ggml_moe_phasea_graph_begin(0, 1);
+            const int32_t want[2] = { 2, 0 };
+            for (int i = 0; i < 2; i++) {
+                int32_t ids[1] = { (int32_t)(i + 1) };
+                uint64_t t = 0;
+                if (ggml_moe_store_acquire(0, want[i], ids, 1, 1, &t) == 0 && t != 0) {
+                    ggml_moe_store_release(t);
+                }
+            }
+            ggml_moe_phasea_graph_end(10, 2);
+            ggml_moe_phasea_run_end(1, 1);
+            ggml_moe_direct_finalize();
+
+            const PaFile led = pa_read(d + L"\\pa_ledger.pa");
+            if (led.ok) {
+                const size_t n_rec = (size_t)led.h.record_count;
+                for (size_t i = 0; i < n_rec; i++) {
+                    PaLed r{};
+                    std::memcpy(&r, led.payload.data() + i * sizeof(PaLed), sizeof(PaLed));
+                    if (r.kind == 1 && n_acq < 2) acq_seen[n_acq++] = (int)r.part;
+                    if (r.kind == 4 && n_rel < 2) rel_seen[n_rel++] = (int)r.part;
+                }
+            }
+        }
+        check(n_acq == 2 && acq_seen[0] == 2 && acq_seen[1] == 0,
+              "XPART09. the Phase A ACQUIRE ledger carries the caller's own part - two "
+              "acquires taken with 2 then 0 land as 2 then 0 on the LED_ACQ_CALL rows. E-2a "
+              "stamped a literal 0 here for every acquire, which is what collapsed the "
+              "(layer, part) join against the trace stream [rows=" + std::to_string(n_acq) +
+              " parts=" + std::to_string(acq_seen[0]) + "," + std::to_string(acq_seen[1]) + "]");
+        check(n_rel == 2 && rel_seen[0] == 2 && rel_seen[1] == 0,
+              "XPART10. and the RELEASE ledger agrees, which is the token's doing: "
+              "store_release still takes nothing but a handle, so the part on these rows can "
+              "only have come from the capture [rows=" + std::to_string(n_rel) + " parts=" +
+              std::to_string(rel_seen[0]) + "," + std::to_string(rel_seen[1]) + "]");
+    }
+    ggml_moe_direct_reset_for_test();
+    ggml_moe_phasea_reset_for_test();
+
+    // ---- D. pass-through to the lead-time B stream ---------------------------------------
+    // lead-time is armed by the real virtual seal (ggml-moe-direct.cpp seal_virtual_locked),
+    // so this arm needs the V3 live fixture rather than the bin one - the same fixture P46g
+    // uses, for the same reason. The B row is read out of the live ring, not out of a file.
+    {
+        const std::wstring d  = make_case_dir("xpart_leadtime");
+        const std::wstring lt = d + L"\\lt";
