+    // ★[MoE-Direct S2] 층 경계 — 경계를 넘는 것은 이 잔차 스트림 하나뿐이다(SPEC §2).
+    //   동일 backend F32 byte-preserving CPY 로 bank 슬라이스에 쓰고 이 range 는 여기서 끝난다.
+    //   (cast·재연산·host 왕복 없음 — 정체성 계약 §1.)
+    if (has_boundary_out()) {
+        (void) build_out_bank_cpy(cur);
+        return;
+    }
+
     // post-norm hidden state feeds both the LM head and the MTP seed below
     cur = build_norm(cur, model.output_norm, nullptr, LLM_NORM_RMS, -1);
 
