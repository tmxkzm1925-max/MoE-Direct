+// ═══════════════════════════════════════════════════════════════════════════
+// ★DSV4 router BF16 확장(SPEC_FAMILY_SIGNAL v0.3 §1.6 · 부록 DSV4-1 5절)
+//   P39 = **역할×계열 allowlist** 의 전 표면 실증. 게이트 매핑:
+//     ① 양성   = P39a~e(인벤토리 청크 승격 → snapshot 1회 승격 → GEMV/TopK 실 생산 경로가
+//                독립 F32 승격 참조와 일치 · F32 팔과 ordered top-16 byte-equal)
+//     ② 음성   = P39f(F16/Q8_0 거부 · BF16 NaN/±Inf 거부 · name/shape/contiguous/unallocated 보존)
+//     ③ 파티션 = P39g(tid2eid 0..2 · exp_probs_b 3..42 40개 · target mask 3..42 — BF16 문맥에서)
+//     ⑥ 격리   = P39h(DSV4 의 BF16 norm/bias 거부 · qwen35moe/openai_moe/deepseek2 BF16 router 거부)
+//     ⑦ 두 팔 = P39c·P39d(host 직독 팔 / backend get_tensor 팔 각 1 — 승격 스캔·snapshot 승격)
+//     ⑧ 범위   = P39i(router 인벤토리 = 정확히 1..42 · hash 층 1·2 포함 · 층 0 제외)
+//     ⑨ 회계   = P39e(BF16 팔의 phaseb_mem exact-key 전건이 F32 팔과 동일 = 추가 영구 사본 부재)
+//   ④(기존 selftest 전건)·⑤(실물 observe 재자격)은 이 픽스처군 밖이다.
+// ═══════════════════════════════════════════════════════════════════════════
+
+struct Dsv4BfArm {
+    bool     sealed = false, resolved = false, snap_sealed = false;
+    int      produced = 0, matched = 0, tie_free = 0, differ = 0;
+    uint64_t rt_bytes = 0, nm_bytes = 0, bias_bytes = 0;
+    uint64_t mem[10] = {0};
+    uint32_t threads = 0;
+    std::string head;      // 표본 0 의 ordered top-16 앞머리(팔 간 대조 증거)
+    std::string reason;
+    bool     mask_ok = false;   // 게이트 ③ — target eligible 마스크가 정확히 3..42
+};
+
+// router 를 **실 텐서**로 세우고 생산 스냅샷 경로(ggml_moe_phaseb_snapshot_layer)로 적재한 뒤
+// capture→worker→GEMV→TopK 를 돌린다. router_type 0=F32 / 1=BF16, nonhost 로 버퍼 팔을 가른다.
+// 두 팔 모두 **같은 F32 값**(BF16 로 표현 가능한 값)을 싣는다 — BF16 승격이 무손실이면 산출이
+// 바이트 동일해야 한다.
+static Dsv4BfArm pb_dsv4_bf16_arm(const char * tag, int32_t router_type, bool nonhost, uint32_t seed) {
+    Dsv4BfArm R;
+    const int32_t ne = DSV4_N_EMBD, nx = DSV4_N_EXPERT;
+    PbEnv env("4", "8", "2", "trace", nullptr, nullptr);
+    Fixture fx; PbDsv4Opt o;
+    o.router_type = router_type;
+    o.buffer_mode = nonhost ? 2 : 1;   // ★스냅샷 경로는 실 버퍼가 필요하다(양팔 모두 스텁 부착)
+    PbInvFix F;
+    pb_setup_dsv4_tensors(fx, tag, o, F);
+
+    // ── 값 생성 → BF16 표현 가능값으로 정규화(rt_ref) → 텐서 적재(선언 **전**) ──────────────
+    std::vector<float> w0, w1, rt, bias;
+    pb_gen_snapshot_dsv4(seed, w0, w1, rt, bias);
+    std::vector<float> rt_ref(rt.size());
+    for (size_t i = 0; i < rt.size(); i++) rt_ref[i] = dsv4_bf16_to_f32(dsv4_f32_to_bf16(rt[i]));
+    std::memcpy(F.lin[(size_t)(DSV4_HASH - 1)].ffn_norm->data, w0.data(), (size_t)ne * sizeof(float));
+    std::memcpy(F.lin[(size_t)DSV4_HASH].ffn_norm->data,       w1.data(), (size_t)ne * sizeof(float));
+    {
+        void * rd = F.lin[(size_t)DSV4_HASH].ffn_gate_inp->data;
+        if (router_type == 1) {
+            uint16_t * h = (uint16_t *)rd;
+            for (size_t i = 0; i < rt_ref.size(); i++) h[i] = dsv4_f32_to_bf16(rt_ref[i]);
+        } else {
+            std::memcpy(rd, rt_ref.data(), rt_ref.size() * sizeof(float));
+        }
+    }
+    std::memcpy(F.lin[(size_t)DSV4_HASH].ffn_exp_probs_b->data, bias.data(), (size_t)nx * sizeof(float));
+
+    ggml_moe_phaseb_note_family(&F.fam);        // ★인벤토리 주사 = 최종 값 그대로를 본다
+    if (fx.seal((uint64_t)DSV4_N_EXPERT * fx.comp.slot_stride_max, 64) != 0) return R;
+    R.sealed   = true;
+    R.reason   = ggml_moe_phaseb_adapter_reason();
+    R.resolved = (ggml_moe_phaseb_adapter_id() == GGML_MOE_PHASEB_ADAPTER_DEEPSEEK4) && R.reason.empty();
+    if (!R.resolved) return R;
+
+    // 게이트 ③ — target eligible 마스크가 정확히 3..42(전 층 주사).
+    R.mask_ok = (ggml_moe_phaseb_signal_first_target_layer() == DSV4_HASH) &&
+                ggml_moe_phaseb_signal_layer_mask_active();
+    for (int32_t il = 0; il < DSV4_N_LAYER && R.mask_ok; il++)
+        if (ggml_moe_phaseb_signal_target_eligible(il) != (il >= DSV4_HASH)) R.mask_ok = false;
+
+    // ── ★생산 스냅샷 경로(test_snapshot_raw 우회 금지 — 승격이 여기서 일어나야 한다) ────────
+    bool ok = true;
+    for (int32_t il = 0; il < DSV4_N_LAYER && ok; il++) {
+        const bool elig = ggml_moe_phaseb_signal_target_eligible(il);
+        const ggml_tensor * nm = F.lin[(size_t)il].ffn_norm;
+        const ggml_tensor * rr = elig ? F.lin[(size_t)il].ffn_gate_inp : nullptr;
+        if (ggml_moe_phaseb_snapshot_layer(il, rr, nm) != 0) { ok = false; break; }
+        if (elig && ggml_moe_phaseb_snapshot_bias(il, F.lin[(size_t)il].ffn_exp_probs_b) != 0) ok = false;
+    }
+    R.snap_sealed = ok && (ggml_moe_phaseb_snapshot_seal() == 0);
+    R.rt_bytes    = ggml_moe_phaseb_router_snapshot_bytes();
+    R.nm_bytes    = ggml_moe_phaseb_norm_snapshot_bytes();
+    R.bias_bytes  = ggml_moe_phaseb_bias_snapshot_bytes();
+    ggml_moe_phaseb_mem_echo(&R.mem[0], &R.mem[1], &R.mem[2], &R.mem[3], &R.mem[4], &R.mem[5],
+                             &R.threads, &R.mem[6], &R.mem[7], &R.mem[8]);
+    if (!R.snap_sealed) return R;
+
+    ggml_moe_direct_test_dispatcher_pause(1);
+    ggml_moe_phaseb_run_begin();
+    std::mt19937 rng(seed ^ 0x5bd1u);
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+    for (int t = 0; t < 8; t++) {
+        std::vector<float> x((size_t)ne);
+        for (auto & v : x) v = ud(rng);
+        ggml_moe_phaseb_graph_begin(/*phase=*/0, /*n_tokens=*/1, /*n_outputs=*/1);
+        const int rc   = ggml_moe_phaseb_capture(DSV4_HASH - 1, -1, x.data(),
+                                                 (int32_t)GGML_TYPE_F32, ne, 1, 1, 1);
+        const int idle = ggml_moe_phaseb_test_wait_idle(15000);
+        ggml_moe_phaseb_intent it{};
+        const int got = ggml_moe_phaseb_intent_peek(&it);
+        if (got == 1) ggml_moe_phaseb_intent_pop();
+        ggml_moe_phaseb_graph_end();
+        if (rc != 1 || idle != 1 || got != 1 || it.target_layer != (uint16_t)DSV4_HASH) continue;
+        R.produced++;
+        bool tf = false;
+        const std::vector<uint16_t> ref = pb_ref_topk16_dsv4(x, w0, w1, rt_ref, bias, ne, nx,
+                                                             DSV4_F_CORRECT, &tf);
+        if (tf) R.tie_free++;
+        bool same = true;
+        for (int i = 0; i < 16; i++) if (it.ids[i] != ref[(size_t)i]) { same = false; break; }
+        if (same) R.matched++;
+        // 음성 컨트롤 1종(가산 시점 오류)이 실제로 갈리는 픽스처인지도 같이 본다.
+        const std::vector<uint16_t> bad = pb_ref_topk16_dsv4(x, w0, w1, rt_ref, bias, ne, nx,
+                                                             DSV4_F_SQRTSP_OF_SUM);
+        bool eq = true;
+        for (int i = 0; i < 16; i++) if (it.ids[i] != bad[(size_t)i]) { eq = false; break; }
+        if (!eq) R.differ++;
+        if (R.head.empty()) R.head = pb_ids_head(it.ids, 6);
+    }
+    ggml_moe_direct_test_dispatcher_pause(0);
+    ggml_moe_direct_test_pb_quiesce(3000);
+    ggml_moe_phaseb_run_end();
+    return R;
+}
