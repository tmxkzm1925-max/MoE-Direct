+               e.find("unset") != std::string::npos &&
+               (floor_needle.empty() || e.find(floor_needle) != std::string::npos);
+    };
+    {
+        // ⓐ 별칭과 전용 키가 **다른 값**으로 동시에 오면 기동 거부(조용한 우선순위 금지).
+        {
+            EnvGuard t("MOE_DIRECT_IO_QD_TOTAL", "4");
