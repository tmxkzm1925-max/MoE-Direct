+    // metrics descriptor — DSV4 한정 **조건부 12키**(기존 계열 11키 불변).
+    const json h = pb_read_metrics_line(dir + L"\\metrics.jsonl", "header");
+    bool desc_ok = h.value("signal_observe_on", false) && h.contains("observe_descriptor") &&
