+    tw_up.ne[3] = 1;
+    tw_up.nb[0] = sizeof(float);
+    tw_up.nb[1] = tw_up.nb[0] * (size_t) tw_up.ne[0];
+    tw_up.nb[2] = tw_up.nb[1] * (size_t) tw_up.ne[1];
+    tw_up.nb[3] = tw_up.nb[2] * (size_t) tw_up.ne[2];
+
+    ggml_tensor tw_down{};
+    tw_down.type  = GGML_TYPE_F32;
+    tw_down.ne[0] = n_ff;
+    tw_down.ne[1] = n_embd;
+    tw_down.ne[2] = n_expert;
+    tw_down.ne[3] = 1;
+    tw_down.nb[0] = sizeof(float);
+    tw_down.nb[1] = tw_down.nb[0] * (size_t) tw_down.ne[0];
+    tw_down.nb[2] = tw_down.nb[1] * (size_t) tw_down.ne[1];
+    tw_down.nb[3] = tw_down.nb[2] * (size_t) tw_down.ne[2];
