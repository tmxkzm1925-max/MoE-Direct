+                const bool tok = (SetFilePointerEx(ht, li, nullptr, FILE_BEGIN) != 0) && (SetEndOfFile(ht) != 0);
+                CloseHandle(ht);
+                if (!tok) { why = "no_tail_padding: truncate 실패: " + shard_path[(size_t)s]; return false; }
+                shard_bytes[(size_t)s] = v3_file_size(wp);
+                shard_mtime[(size_t)s] = v3_file_mtime_epoch(wp);
+                manifest["sources"][(size_t)s]["bytes"] = shard_bytes[(size_t)s];
+                manifest["sources"][(size_t)s]["mtime"] = shard_mtime[(size_t)s];
+                rewrote = true;
+            }
+        }
+        if (!routed_scope.empty()) { manifest["model"]["routed_scope"] = routed_scope; rewrote = true; }
+        if (mutate_manifest)       { mutate_manifest(manifest);                      rewrote = true; }
+        if (rewrote) write_manifest(dir + L"\\manifest.json", manifest);
+        manifest_file_sha256 = sha256_file_hex(dir + L"\\manifest.json");
+        { std::ifstream ifs(dir + L"\\plan_report.json", std::ios::binary);
+          if (!ifs.good()) { why = "plan_report missing"; return false; }
+          try { ifs >> plan_report; } catch (...) { why = "plan_report parse"; return false; } }
+        if (rewrote) plan_report["manifest_sha256"] = manifest_file_sha256;     // 결속 갱신(구판 ⑥ 동형)
+        // ★C2 — truncate 된 shard 크기는 plan_report 사본에도 같이 옮긴다(사본 드리프트 금지).
+        //   `mutate_report` 보다 **앞**이라 네거티브 훅의 순서 계약(결속 갱신 → report 변형)은 그대로다.
+        if (no_tail_padding && plan_report.contains("sources") &&
+            (int32_t)plan_report["sources"].size() == model.n_shards) {
+            for (int32_t s = 0; s < model.n_shards; s++) {
+                plan_report["sources"][(size_t)s]["bytes"] = shard_bytes[(size_t)s];
+                plan_report["sources"][(size_t)s]["mtime"] = shard_mtime[(size_t)s];
+            }
+        }
+        if (mutate_report) mutate_report(plan_report);
+        if (omit_plan_report) {
+            DeleteFileW((dir + L"\\plan_report.json").c_str());
+        } else if (rewrote || mutate_report) {
+            std::ofstream ofs(dir + L"\\plan_report.json", std::ios::binary | std::ios::trunc);
+            ofs << plan_report.dump(1);
+        }
+        if (tamper_expect_file) {
+            std::ofstream ofs(utf8_to_wide(expects_u8) + L"\\" + utf8_to_wide(ref_profile_id) + L".expect.json",
+                              std::ios::binary | std::ios::app);
+            ofs << "\n// tampered";
+        }
+        if (write_stray_bin) { std::ofstream ofs(dir + L"\\experts.bin", std::ios::binary | std::ios::trunc); ofs << "stray"; }
+
+        // ── 6. 등록(전수 — seal 이 scope 로 선별한다 · 구판 ⑦ 동일) ──
+        for (auto & L : model.layers)
+            for (auto & part : L.parts)
+                ggml_moe_direct_register(find(part.source_tensor), part.source_tensor.c_str(), part.is_host ? 1 : 0);
+        return true;
+    }
+
+    ggml_moe_direct_model model_desc(std::vector<int32_t> & moe_layers_out) {
+        for (auto & L : model.layers) moe_layers_out.push_back(L.layer);
+        std::sort(moe_layers_out.begin(), moe_layers_out.end());
+        ggml_moe_direct_model md{};
+        md.arch           = model.arch.c_str();
+        md.n_layer        = model.n_layer;
+        md.n_expert       = model.n_expert;
+        md.n_expert_used  = model.n_expert_used;
+        md.moe_layers     = moe_layers_out.data();
+        md.n_moe_layers   = (int32_t)moe_layers_out.size();
+        md.n_layer_nextn  = model.n_layer_nextn;
+        md.n_embd         = model.n_embd;
+        md.f_norm_rms_eps = model.f_norm_rms_eps;
+        return md;
+    }
+    std::vector<ggml_moe_direct_source> source_descs() {
+        std::vector<ggml_moe_direct_source> v;
+        for (int32_t s = 0; s < model.n_shards; s++) {
+            ggml_moe_direct_source d{};
+            d.path         = shard_path[(size_t)s].c_str();
+            d.bytes        = shard_bytes[(size_t)s];
+            d.mtime_epoch  = shard_mtime[(size_t)s];
+            d.data_start   = shard_data_start[(size_t)s];
+            d.gguf_version = shard_version[(size_t)s];
+            d.alignment    = shard_alignment[(size_t)s];
+            v.push_back(d);
+        }
+        return v;
+    }
+    // n_slots == n_expert 이 되는 최소 예산(슬롯 용량 불변식 n_slots >= n_expert 의 경계).
+    uint64_t budget() const { return slot_stride_max * (uint64_t)model.n_expert; }
+};
