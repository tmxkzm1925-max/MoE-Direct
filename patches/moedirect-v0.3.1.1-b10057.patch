+// ===========================================================================
+// ★P46 — lead-time 계측 프로브(PROBE_LEADTIME_SPEC_R1 §2 "selftest" 항목 5종:
+//   게이트 3상 · 버퍼 상한 drop · flush 완결 · QPC 단조 · A/B 버퍼 독립).
+//
+//   ★이 그룹은 캐시·플래너·seal 픽스처를 **쓰지 않는다** — 모듈이 moe-direct 상태와 완전히
+//     독립이기 때문이다(그게 이 프로브의 설계 전제이고, 여기서 그 독립성이 실증된다).
+//     프로덕션 스탬프 API 를 그대로 호출하고 실 `flush()` 가 낸 사이드카를 되읽는다.
+// ===========================================================================
+
+#pragma pack(push, 1)
+// 판독기가 하드코딩할 바이트 배치의 **하네스측 사본**. 모듈의 wire 구조체와 폭·오프셋이
+// 어긋나면 아래 static_assert + 왕복 memcmp 검사가 잡는다(사본 드리프트 방지).
+struct LtHdrMirror {
+    char     magic[8];          // @0   "MOELT1\0\0"
+    uint32_t layout_version;    // @8
+    uint32_t file_kind;         // @12
+    uint32_t record_bytes;      // @16
+    uint32_t engine_mode;       // @20
+    uint64_t record_count;      // @24
+    uint64_t payload_digest;    // @32
+    uint64_t qpc_frequency;     // @40
+    uint64_t t0_qpc;            // @48
+    uint32_t pid;               // @56
+    uint32_t complete;          // @60
+    uint32_t n_expert;          // @64
+    uint32_t n_moe_layers;      // @68
+    uint32_t reserved0;         // @72
+    uint32_t reserved1;         // @76
+    uint64_t boot_id;           // @80
+    uint64_t dropped_records;   // @88
+    uint64_t record_capacity;   // @96
+    uint8_t  reserved[24];      // @104
+};
+struct LtAMirror {
+    uint32_t seq;               // @0
+    uint8_t  site;              // @4
+    uint8_t  flags;             // @5
+    uint16_t name_len;          // @6
+    uint64_t qpc;               // @8
+    char     name[48];          // @16
+};
+struct LtBMirror {
+    uint32_t seq;               // @0
+    int16_t  mlpos;             // @4
+    int16_t  part_idx;          // @6
+    uint64_t qpc;               // @8
+    int32_t  n_ids;             // @16
+    uint8_t  flags;             // @20
+    uint8_t  reserved0;         // @21
+    uint16_t reserved1;         // @22
+    uint64_t reserved2;         // @24
+};
+#pragma pack(pop)
+static_assert(sizeof(LtHdrMirror) == GGML_MOE_LEADTIME_HDR_BYTES, "lead 헤더는 128B 고정");
+static_assert(sizeof(LtAMirror)   == GGML_MOE_LEADTIME_A_BYTES,   "lead stamp A 는 64B 고정");
+static_assert(sizeof(LtBMirror)   == GGML_MOE_LEADTIME_B_BYTES,   "lead stamp B 는 32B 고정");
+static_assert(offsetof(LtAMirror, qpc)      ==  8, "LtAMirror.qpc @8");
+static_assert(offsetof(LtAMirror, name)     == 16, "LtAMirror.name @16");
+static_assert(offsetof(LtBMirror, qpc)      ==  8, "LtBMirror.qpc @8");
+static_assert(offsetof(LtBMirror, n_ids)    == 16, "LtBMirror.n_ids @16");
+static_assert(offsetof(LtBMirror, reserved2) == 24, "LtBMirror.reserved2 @24");
+
+struct LtFile {
+    bool        ok = false;
+    std::string why;
+    LtHdrMirror h{};
+    std::vector<uint8_t> payload;
+};
+
+// 사이드카 1개를 읽고 헤더·크기등식·payload digest 를 검증한다(sh_read 관례와 동형).
+static LtFile lt_read(const std::wstring & path) {
+    LtFile f;
+    std::ifstream in(path, std::ios::binary);
+    if (!in) { f.why = "open failed"; return f; }
+    std::vector<uint8_t> blob((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    if (blob.size() < sizeof(LtHdrMirror)) { f.why = "shorter than header"; return f; }
+    if (std::memcmp(blob.data(), "MOELT1\0\0", 8) != 0) { f.why = "magic"; return f; }
+    std::memcpy(&f.h, blob.data(), sizeof(f.h));
+    if (blob.size() != sizeof(LtHdrMirror) + f.h.record_count * f.h.record_bytes) {
+        f.why = "size equation"; return f;
+    }
+    f.payload.assign(blob.begin() + (std::ptrdiff_t)sizeof(LtHdrMirror), blob.end());
+    if (sh_fnv1a64(f.payload.data(), f.payload.size()) != f.h.payload_digest) {
+        f.why = "payload digest"; return f;
+    }
+    f.ok = true;
+    return f;
+}
+
+static bool lt_path_exists(const std::wstring & p) {
+    return GetFileAttributesW(p.c_str()) != INVALID_FILE_ATTRIBUTES;
+}
