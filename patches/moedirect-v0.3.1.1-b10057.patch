+static void test_leadtime_p46() {
+    section("P46. ★lead-time 계측 프로브 — 게이트 3상·상한 drop·flush 완결·QPC 단조·A/B 독립");
+
+    const uint64_t k_mib = 1024ull * 1024ull;
+
+    // ── ⓐ 게이트 3상 ①미설정 = 조용한 OFF · OFF 무흔적 ───────────────────────
+    {
+        EnvGuard g1("MOE_DIRECT_LEADTIME", nullptr);
+        EnvGuard g2("MOE_DIRECT_LEADTIME_OUT", nullptr);
+        EnvGuard g3("MOE_DIRECT_LEADTIME_MAX_MB", nullptr);
+        ggml_moe_leadtime_reset_for_test();
+
+        // ★OFF 계약의 핵심 — `enabled()` 는 **해소를 유발하지 않는다**. 이게 거짓이면 hot hook
+        //   첫 진입이 getenv+VirtualAlloc 을 태우는 경로가 생긴다(사양 §2 "hot hook 내 동적 할당 금지").
+        const uint64_t rc_before = ggml_moe_leadtime_test_resolve_count();
+        bool gate_quiet = true;
+        for (int i = 0; i < 1000; i++) if (ggml_moe_leadtime_enabled()) gate_quiet = false;
+        check(gate_quiet, "P46a1. 미해소 상태에서 게이트는 false(해소 전 hot hook 은 무동작)");
+        check(ggml_moe_leadtime_test_resolve_count() == rc_before,
+              "P46a2. ★enabled() x1000 이 env 해소를 0회 유발 — hot hook 이 getenv/VirtualAlloc 을 "
+              "부를 수 없다는 구조적 근거");
+
+        ggml_moe_leadtime_note_seal(0x1111ull, 2, 128, 48);
+        check(!ggml_moe_leadtime_enabled(), "P46a3. env 미설정 → 게이트 OFF(3상 ①)");
+
+        // OFF 에서 프로덕션 스탬프 API 를 실제로 통과시켜도 흔적 0("훅은 도달하되 무동작").
+        ggml_moe_leadtime_stamp_a(GGML_MOE_LEADTIME_SITE_A1, 1234, "ffn_moe_topk-0");
+        ggml_moe_leadtime_stamp_a(GGML_MOE_LEADTIME_SITE_A2, 1235, "ffn_moe_topk-1");
+        ggml_moe_leadtime_stamp_b(1236, 3, 1, 8, 0);
+        uint64_t na = 9, nb = 9, nd = 9, ca = 9, cb = 9; int32_t comp = -1;
+        ggml_moe_leadtime_test_counts(&na, &nb, &nd, &comp, &ca, &cb);
+        check(na == 0 && nb == 0 && nd == 0 && comp == 1,
+              "P46a4. ★OFF 무흔적 — stamp A/B 를 통과시켜도 행 0·drop 0·complete 훼손 0");
+        check(ca == 0 && cb == 0, "P46a5. ★OFF 에서 선할당 0칸(어떤 버퍼도 만들지 않는다)");
+        check(ggml_moe_leadtime_test_qpc_calls() == 0,
+              "P46a6. ★OFF 에서 모듈이 QPC 를 0회 호출(arm t0 채취는 별 경로라 섞이지 않는다)");
+        check(ggml_moe_leadtime_boot_id() == 0, "P46a7. OFF 에서 boot_id 조회는 0");
+    }
+
+    // ── ⓐ' 게이트 3상 ②무효값 = OFF + 경고(조용히 켜지지 않는다) ─────────────
+    {
+        EnvGuard g1("MOE_DIRECT_LEADTIME", "on");   // ★"1" 만 유효 — `on`/`true` 는 받지 않는다
+        EnvGuard g2("MOE_DIRECT_LEADTIME_OUT", nullptr);
+        ggml_moe_leadtime_reset_for_test();
+        ggml_moe_leadtime_note_seal(0x2222ull, 2, 128, 48);
+        uint64_t ca = 9, cb = 9;
+        ggml_moe_leadtime_test_counts(nullptr, nullptr, nullptr, nullptr, &ca, &cb);
+        check(!ggml_moe_leadtime_enabled() && ca == 0 && cb == 0,
+              "P46a8. ★무효값 `on` → OFF + 경고(3상 ②) · 선할당 0 — 정적 기본값으로 조용히 켜지지 않는다");
+    }
+    {
+        EnvGuard g1("MOE_DIRECT_LEADTIME", "0");
+        ggml_moe_leadtime_reset_for_test();
+        ggml_moe_leadtime_note_seal(0, 2, 0, 0);
+        check(!ggml_moe_leadtime_enabled(), "P46a9. `0` → OFF");
+    }
+
+    // ── ⓐ'' 게이트 3상 ③`1` = ON + 전량 선할당 + 조인 키 채택 ────────────────
+    {
+        EnvGuard g1("MOE_DIRECT_LEADTIME", "1");
+        EnvGuard g2("MOE_DIRECT_LEADTIME_OUT", nullptr);
+        EnvGuard g3("MOE_DIRECT_LEADTIME_MAX_MB", nullptr);   // 기본 64MiB
+        ggml_moe_leadtime_reset_for_test();
+        const uint64_t join = 0x0123456789ABCDEFull;
+        ggml_moe_leadtime_note_seal(join, 2, 128, 48);
+
+        check(ggml_moe_leadtime_enabled(), "P46b1. `1` → 게이트 ON(3상 ③)");
+        uint64_t na = 9, nb = 9, nd = 9, ca = 0, cb = 0; int32_t comp = -1;
+        ggml_moe_leadtime_test_counts(&na, &nb, &nd, &comp, &ca, &cb);
+        // 분할 산술(모듈 주석과 같은 식): B = cap/4 · A = cap − B · 각자 레코드 폭으로 나눈다.
+        const uint64_t cap_bytes = 64ull * k_mib;
+        const uint64_t exp_cb    = (cap_bytes / 4) / GGML_MOE_LEADTIME_B_BYTES;
+        const uint64_t exp_ca    = (cap_bytes - cap_bytes / 4) / GGML_MOE_LEADTIME_A_BYTES;
+        check(ca == exp_ca && cb == exp_cb,
+              "P46b2. ★기본 64MiB 전량 선할당 — A " + std::to_string(ca) + "칸(기대 " +
+              std::to_string(exp_ca) + ") · B " + std::to_string(cb) + "칸(기대 " +
+              std::to_string(exp_cb) + ") · 여유는 A 쪽(split 당 generic 복사가 층보다 많다)");
+        check(na == 0 && nb == 0 && nd == 0 && comp == 1, "P46b3. arm 직후 행 0·drop 0·complete=1");
+        check(ggml_moe_leadtime_boot_id() == join,
+              "P46b4. ★IO3 boot_id 채택 — 조인 키가 주어진 값과 정확히 같다");
+
+        // 재해소 없음 — 무장 후에도 게이트는 캐시된 값 1회 로드다.
+        const uint64_t rc = ggml_moe_leadtime_test_resolve_count();
+        for (int i = 0; i < 1000; i++) (void) ggml_moe_leadtime_enabled();
+        check(ggml_moe_leadtime_test_resolve_count() == rc,
+              "P46b5. ★무장 후 enabled() x1000 도 재해소 0 — env 는 프로세스당 1회만 읽힌다");
+
+        // 멱등: 스탬프가 흐른 뒤의 note_seal 은 조인 키를 바꾸지 않는다.
+        ggml_moe_leadtime_stamp_b(10, 0, 0, 4, 0);
+        ggml_moe_leadtime_note_seal(0xDEADBEEFull, 2, 1, 1);
+        check(ggml_moe_leadtime_boot_id() == join,
+              "P46b6. ★스탬프 개시 후 note_seal 재호출은 조인 키를 덮지 않는다(한 파일에 두 도메인 금지)");
+    }
+
+    // ── ⓑ 버퍼 상한 drop + latch + ⓒ A/B 버퍼 독립 ───────────────────────────
+    {
+        EnvGuard g1("MOE_DIRECT_LEADTIME", "1");
+        EnvGuard g2("MOE_DIRECT_LEADTIME_OUT", nullptr);
+        EnvGuard g3("MOE_DIRECT_LEADTIME_MAX_MB", "1");       // 1MiB → A 12,288칸 · B 8,192칸
+        ggml_moe_leadtime_reset_for_test();
+        ggml_moe_leadtime_note_seal(0x3333ull, 2, 8, 2);
+
+        uint64_t ca = 0, cb = 0;
+        ggml_moe_leadtime_test_counts(nullptr, nullptr, nullptr, nullptr, &ca, &cb);
+        const bool caps_ok = (ca == (1ull * k_mib - 1ull * k_mib / 4) / GGML_MOE_LEADTIME_A_BYTES) &&
+                             (cb == (1ull * k_mib / 4) / GGML_MOE_LEADTIME_B_BYTES);
+        check(caps_ok, "P46c1. MAX_MB=1 → A " + std::to_string(ca) + "칸 · B " +
+                       std::to_string(cb) + "칸(env 상한이 실제로 칸 수를 정한다)");
+
+        // A 를 정확히 상한까지 채운다 — 여기까지는 결손 0 이어야 한다.
+        for (uint64_t i = 0; i < ca; i++) {
+            ggml_moe_leadtime_stamp_a(GGML_MOE_LEADTIME_SITE_A1, 1000 + i, "ffn_moe_topk-1");
+        }
+        uint64_t na = 0, nb = 0, nd = 9; int32_t comp = -1;
+        ggml_moe_leadtime_test_counts(&na, &nb, &nd, &comp, nullptr, nullptr);
+        check(na == ca && nd == 0 && comp == 1,
+              "P46c2. 상한까지는 무결 — A " + std::to_string(na) + "/" + std::to_string(ca) +
+              "행 · drop 0 · complete=1");
+
+        // 상한 초과 1건 → drop + complete=0(정직 강하).
+        ggml_moe_leadtime_stamp_a(GGML_MOE_LEADTIME_SITE_A1, 999999, "ffn_moe_topk-2");
+        ggml_moe_leadtime_test_counts(&na, &nb, &nd, &comp, nullptr, nullptr);
+        check(na == ca && nd == 1 && comp == 0,
+              "P46c3. ★상한 초과 1건 → 행 수 불변·drop=1·complete=0(사양 §4b: lead 는 한 행 결손도 "
+              "지표 무효 — 부분 기록을 유효한 것처럼 두지 않는다)");
+
+        // latch — 이후 스탬프도 계속 drop 이고 기록된 행은 손대지 않는다.
+        for (int i = 0; i < 10; i++) {
+            ggml_moe_leadtime_stamp_a(GGML_MOE_LEADTIME_SITE_A1, 888888, "ffn_moe_topk-3");
+        }
+        ggml_moe_leadtime_test_counts(&na, &nb, &nd, &comp, nullptr, nullptr);
+        check(na == ca && nd == 11 && comp == 0,
+              "P46c4. ★drop latch — 초과분 11건 전량 drop · 기록된 " + std::to_string(na) +
+              "행은 불변(넘친 예약을 되감지 않아 '얼마나 모자랐나'가 계수에 남는다)");
+
+        // ★A/B 독립 — A 가 넘쳐도 B 칸은 그대로 살아 있다.
+        for (uint64_t i = 0; i < cb; i++) ggml_moe_leadtime_stamp_b(2000 + i, (int32_t)(i % 48), (int32_t)(i % 3), 4, 0);
+        ggml_moe_leadtime_test_counts(&na, &nb, &nd, &comp, nullptr, nullptr);
+        check(nb == cb && na == ca,
+              "P46c5. ★A/B 버퍼 독립 — A 가 상한을 넘긴 뒤에도 B 는 자기 상한 " +
+              std::to_string(cb) + "행을 전량 기록(공용 버퍼면 여기서 모자란다)");
+        // B 도 넘겨서 계수가 합산되는지(모듈 단일 drop 회계)
+        ggml_moe_leadtime_stamp_b(3000, 1, 1, 4, 1);
+        ggml_moe_leadtime_test_counts(&na, &nb, &nd, &comp, nullptr, nullptr);
+        check(nb == cb && nd == 12,
+              "P46c6. B 상한 초과도 같은 회계에 합산(drop=12) — complete 는 축이 아니라 런 단위다");
+    }
+
+    // ── ⓓ flush 완결 · 실 emitter → 하네스 왕복 · 음성 대조 · once 래치 ───────
+    {
+        const std::wstring dir = make_case_dir("leadtime_wire");
+        const std::wstring pfx = dir + L"\\lt";
+        const std::wstring pa  = pfx + L"_lead_a.lt";
+        const std::wstring pb  = pfx + L"_lead_b.lt";
+
+        EnvGuard g1("MOE_DIRECT_LEADTIME", "1");
+        EnvGuard g2("MOE_DIRECT_LEADTIME_OUT", wide_to_utf8(pfx).c_str());
+        EnvGuard g3("MOE_DIRECT_LEADTIME_MAX_MB", "1");
+        ggml_moe_leadtime_reset_for_test();
+        const uint64_t join = 0x0F1E2D3C4B5A6978ull;
